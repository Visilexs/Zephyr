// Zide - the Zephyr IDE, phase 1: a real Win32 text editor written in Zephyr.
//
// A double-buffered GDI window (the cube3d/fluid pattern), a list-of-line-strings
// buffer, a full editing surface: typing, backspace/delete, enter with auto-indent,
// arrows/home/end/pgup/pgdn, mouse click-to-place, shift-selection, ctrl+A,
// clipboard cut/copy/paste, mouse-wheel scroll, ctrl+S save, ctrl+Z undo.
// Reads keyboard/mouse straight from PeekMessage (DefWindowProcA is the class proc,
// so no callback is needed). Talks to user32/gdi32/kernel32 through the win() FFI.
//
//   zc.exe --rt zide/zide.zeph zide/zide.exe
//   zide.exe [file]                  (opens an existing file, or an empty buffer)
//
// ponytail: no LSP protocol, no threads, no gap buffer, no file-open dialog yet
// (those are phases 2-4). A line is a whole str; edits rebuild the affected lines.

struct Snap { rows: [str], cl: int, cc: int }
struct ChatMsg { role: int, text: str }     // role 0=you, 1=Claude, 2=system

// --- editor state (globals: visible to every function below, and GC roots) ---
var lines: [str] = []     // the buffer, one str per line (always >= 1 line)
var cl = 0                // cursor line
var cc = 0                // cursor column (byte index into lines[cl])
var top = 0               // first visible line (vertical scroll)
var leftcol = 0           // first visible column (horizontal scroll)
var sel = false           // is there an active selection?
var al = 0                // selection anchor line
var ac = 0                // selection anchor column
var g_sl = 0              // normalized selection start line
var g_sc = 0              // normalized selection start col
var g_el = 0              // normalized selection end line
var g_ec = 0              // normalized selection end col
var g_modified = false
var g_path = ""
var g_undo: [Snap] = []

var g_dirty = true
var g_hwnd = 0
var g_font = 0
var g_char_w = 8          // measured monospace cell width
var g_line_h = 18         // measured line height
var g_client_w = 1000
var g_client_h = 700
var g_vis_lines = 40      // recomputed each draw
var g_vis_cols = 100

// scratch native buffers (payload pointers kept in globals => GC keeps them alive)
let g_msg = mem(48)       // MSG
let g_rc = mem(16)        // RECT for GetClientRect
let g_rc2 = mem(16)       // RECT for FillRect
let g_size = mem(16)      // SIZE for GetTextExtentPoint32A

// theme colors — all set by apply_theme(); light (Apple) is the default, Ctrl+T toggles dark
var g_dark = false
var g_bg = 0            // editor background
var g_chrome = 0        // gutter / status / panel chrome
var g_text = 0
var g_gutter_text = 0
var g_sel = 0
var g_cursor = 0
var g_status_bg = 0
var g_status_text = 0
var g_hair = 0          // hairline separators (#D2D2D7 light)

// syntax-highlight token colors (set per theme)
var C_KW = 0
var C_TY = 0
var C_STR = 0
var C_NUM = 0
var C_COMMENT = 0
var C_BUILTIN = 0
var C_OP = 0

// token classes (Zephyr has no multi-line tokens, so per-line lexing is exact)
let g_kw = build_set("fn let var if else while for in return struct enum import as and or not break continue true false none")
let g_ty = build_set("int float bool str")
let g_builtin = build_set("print panic sqrt emit chr bits args read_file write_file zeros assert abs min max pow len push pop byte sub join contains index_of starts_with ends_with split replace upper lower trim repeat sort has remove keys values get or has load64 load8 store64 store32 store8 addr stackptr win frombits")
let g_docs = build_docs()
let g_methods = "len push pop byte sub join contains index_of starts_with ends_with split replace upper lower trim repeat sort has remove keys values get reverse slice map filter fold any all first last count".split(" ")

var g_bg_brush = 0
var g_sel_brush = 0
var g_cursor_brush = 0
var g_status_brush = 0
var g_chrome_brush = 0
var g_tip_brush = 0
var g_facename = 0
var g_uiface = 0
var g_clsname = 0
var g_ui_font = 0        // proportional chrome font (Segoe UI)
var g_ui_cw = 7          // measured average ui char width

var C_ERR = 0            // diagnostic squiggle / message (Apple red)
var C_TIP_BG = 0         // tooltip / completion / panel background
var C_TIP_TEXT = 0
var C_TIP_DIM = 0
var C_ROLE_YOU = 0       // chat role label colors
var C_ROLE_AI = 0

// Apply a full color theme and (re)create the solid brushes. light = Apple default.
fn apply_theme(dark: bool) {
    g_dark = dark
    if dark {
        g_bg = rgb(30, 30, 30)
        g_chrome = rgb(37, 37, 38)
        g_text = rgb(212, 212, 212)
        g_gutter_text = rgb(128, 128, 132)
        g_sel = rgb(38, 79, 120)
        g_cursor = rgb(0, 122, 204)
        g_status_bg = rgb(37, 37, 38)
        g_status_text = rgb(170, 170, 175)
        g_hair = rgb(58, 58, 60)
        C_KW = rgb(86, 156, 214)
        C_TY = rgb(78, 201, 176)
        C_STR = rgb(206, 145, 120)
        C_NUM = rgb(181, 206, 168)
        C_COMMENT = rgb(106, 153, 85)
        C_BUILTIN = rgb(220, 220, 170)
        C_OP = rgb(190, 190, 195)
        C_TIP_BG = rgb(45, 45, 48)
        C_TIP_TEXT = rgb(222, 222, 222)
        C_TIP_DIM = rgb(150, 150, 150)
        C_ROLE_YOU = rgb(90, 170, 255)
        C_ROLE_AI = rgb(120, 200, 150)
    } else {
        g_bg = rgb(255, 255, 255)         // white editor
        g_chrome = rgb(245, 245, 247)     // #F5F5F7 chrome
        g_text = rgb(29, 29, 31)          // #1D1D1F
        g_gutter_text = rgb(174, 174, 180)
        g_sel = rgb(180, 213, 255)        // soft Apple selection
        g_cursor = rgb(0, 113, 227)       // #0071E3
        g_status_bg = rgb(245, 245, 247)
        g_status_text = rgb(110, 110, 115)
        g_hair = rgb(210, 210, 215)       // #D2D2D7
        C_KW = rgb(155, 35, 147)          // Xcode-ish magenta
        C_TY = rgb(11, 79, 121)
        C_STR = rgb(196, 26, 22)          // red string
        C_NUM = rgb(28, 0, 207)           // blue number
        C_COMMENT = rgb(112, 127, 140)    // gray-green
        C_BUILTIN = rgb(15, 104, 55)      // green builtin
        C_OP = rgb(90, 90, 95)
        C_TIP_BG = rgb(255, 255, 255)
        C_TIP_TEXT = rgb(29, 29, 31)
        C_TIP_DIM = rgb(140, 140, 145)
        C_ROLE_YOU = rgb(0, 113, 227)
        C_ROLE_AI = rgb(40, 150, 90)
    }
    C_ERR = rgb(255, 59, 48)              // Apple red, both themes
    if g_bg_brush != 0 {
        win("gdi32!DeleteObject", g_bg_brush)
        win("gdi32!DeleteObject", g_sel_brush)
        win("gdi32!DeleteObject", g_cursor_brush)
        win("gdi32!DeleteObject", g_status_brush)
        win("gdi32!DeleteObject", g_chrome_brush)
        win("gdi32!DeleteObject", g_tip_brush)
    }
    g_bg_brush = win("gdi32!CreateSolidBrush", g_bg)
    g_sel_brush = win("gdi32!CreateSolidBrush", g_sel)
    g_cursor_brush = win("gdi32!CreateSolidBrush", g_cursor)
    g_status_brush = win("gdi32!CreateSolidBrush", g_status_bg)
    g_chrome_brush = win("gdi32!CreateSolidBrush", g_chrome)
    g_tip_brush = win("gdi32!CreateSolidBrush", C_TIP_BG)
}

// --- language-services state (diagnostics, hover, completion) ---
var g_diag_line = -1      // 1-based buffer line with the current error, or -1
var g_diag_msg = ""
var g_edit_seq = 0        // bumped on every edit; drives debounced re-check
var g_diag_seq = -1       // last edit-seq we ran diagnostics for
var g_last_edit = 0       // GetTickCount at last edit
var g_zc = ""             // resolved path to zc.exe (the compiler)

var g_hover_word = ""     // builtin currently hovered (for the doc tooltip)
var g_hover_doc = ""
var g_hover_px = 0
var g_hover_py = 0

var g_comp_on = false     // completion popup visible?
var g_comp_items: [str] = []
var g_comp_sel = 0
var g_comp_dot = false    // triggered by '.' (methods) vs identifier prefix

var g_show_out = false    // bottom output panel (F5 run) visible?
var g_out = ""

var g_pool: [str] = []    // completion candidate pool (keywords+builtins+buffer idents)
var g_pool_seq = -1       // edit-seq the pool was built for

// --- Claude chat panel ---
var g_chat_on = false     // right-side panel visible?
var g_focus = 0           // 0 = editor, 1 = chat input
var g_chat_w = 470        // panel width in px
var g_edit_w = 800        // editor area width (updated each draw)
var g_msgs: [ChatMsg] = []
var g_chat_input = ""
var g_chat_scroll = 0     // first visible transcript line
var g_claude = ""         // resolved path to claude.exe
var g_ai_running = false  // a claude -p child is in flight
var g_ai_rd = 0           // its pipe read handle
var g_ai_proc = 0
var g_ai_thread = 0
var g_ai_partial = ""     // assistant text accumulated so far

// --- low-level helpers ---
fn rgb(r: int, g: int, b: int) -> int { return r + g * 256 + b * 65536 }

fn mem(nbytes: int) -> int {
    var b = zeros(nbytes / 8 + 2)
    return load64(addr(b) + 16)          // the list's data pointer (never freed)
}
fn cstr(s: str) -> int {
    let n = s.len()
    let p = mem(n + 1)
    for i in 0..n { store8(p + i, s.byte(i)) }
    store8(p + n, 0)
    return p
}
fn sword(v: int) -> int {                 // sign-extend a 16-bit field
    let w = v & 65535
    if w >= 32768 { return w - 65536 }
    return w
}
fn key_down(vk: int) -> bool {
    return (win("user32!GetKeyState", vk) & 32768) != 0
}
fn tick() -> int { return win("GetTickCount") & 4294967295 }
fn read_cstr(p: int) -> str {
    var chars: [str] = []
    var i = 0
    var b = load8(p + i)
    while b != 0 {
        chars.push(chr(b))
        i += 1
        b = load8(p + i)
    }
    return chars.join()
}
fn dirname(p: str) -> str {              // returns the directory WITH its trailing separator
    var i = p.len() - 1
    while i >= 0 {
        let c = p.byte(i)
        if c == 47 or c == 92 { return p.sub(0, i + 1) }
        i -= 1
    }
    return ""
}
fn parent_of(d: str) -> str {            // parent of a dir given with a trailing separator
    if d.len() == 0 { return "" }
    return dirname(d.sub(0, d.len() - 1))
}
fn exe_dir() -> str {
    let buf = mem(600)
    win("GetModuleFileNameA", 0, buf, 512)
    return dirname(read_cstr(buf))
}
fn path_exists(path: str) -> bool {
    let attr = win("GetFileAttributesA", cstr(path))
    return (attr & 4294967295) != 4294967295
}
fn find_zc() -> str {
    let ed = exe_dir()
    if path_exists(ed + "zc.exe") { return ed + "zc.exe" }
    let par = parent_of(ed)
    if path_exists(par + "zc.exe") { return par + "zc.exe" }
    return "zc.exe"
}
fn getenv(name: str) -> str {
    let buf = mem(600)
    let n = win("GetEnvironmentVariableA", cstr(name), buf, 512)
    if (n & 4294967295) == 0 { return "" }
    return read_cstr(buf)
}
// claude.exe lives in %APPDATA%\Claude\claude-code\<version>\claude.exe; pick the
// highest version directory that actually contains the exe.
fn find_claude() -> str {
    let base = getenv("APPDATA") + "\\Claude\\claude-code\\"
    let wfd = mem(400)
    let hfind = win("FindFirstFileA", cstr(base + "*"), wfd)
    if hfind == -1 { return "" }
    var best = ""
    var bestname = ""
    var more = 1
    while more != 0 {
        let attr = load64(wfd) & 4294967295
        if (attr & 16) != 0 {                    // FILE_ATTRIBUTE_DIRECTORY
            let name = read_cstr(wfd + 44)        // cFileName
            if name != "." and name != ".." {
                let cand = base + name + "\\claude.exe"
                if path_exists(cand) and name > bestname {
                    bestname = name
                    best = cand
                }
            }
        }
        more = win("FindNextFileA", hfind, wfd)
    }
    win("FindClose", hfind)
    return best
}

// Spawn a child with stdout+stderr piped back. Fills h: [0]=readEnd [8]=hProcess
// [16]=hThread. Returns 1 on success. kernel32-only (CreatePipe/CreateProcessA).
fn spawn(cmdline: str, cwd: str, h: int) -> int {
    let sa = mem(24)
    store32(sa + 0, 24)                  // nLength
    store32(sa + 16, 1)                  // bInheritHandle
    let hp = mem(16)
    win("CreatePipe", hp, hp + 8, sa, 0)
    let rd = load64(hp)
    let wr = load64(hp + 8)
    win("SetHandleInformation", rd, 1, 0)   // read end NOT inherited
    let nul = win("CreateFileA", cstr("NUL"), 2147483648, 3, sa, 3, 0, 0)   // empty stdin
    let si = mem(104)
    store32(si + 0, 104)                 // cb
    store32(si + 60, 257)                // dwFlags = USESTDHANDLES|USESHOWWINDOW
    store64(si + 80, nul)                // hStdInput = NUL (child sees EOF, never blocks)
    store64(si + 88, wr)                 // hStdOutput
    store64(si + 96, wr)                 // hStdError
    let pi = mem(24)
    var cwdp = 0
    if cwd != "" { cwdp = cstr(cwd) }
    let ok = win("CreateProcessA", 0, cstr(cmdline), 0, 0, 1, 134217728, 0, cwdp, si, pi)
    win("CloseHandle", wr)               // parent drops its write end
    win("CloseHandle", nul)
    if ok == 0 {
        win("CloseHandle", rd)
        return 0
    }
    store64(h + 0, rd)
    store64(h + 8, load64(pi + 0))
    store64(h + 16, load64(pi + 8))
    return 1
}
// Blocking capture — for the compiler, which always terminates quickly.
// ponytail: byte-at-a-time into a [str] then join; fine for short error output.
fn run_capture(cmdline: str, cwd: str) -> str {
    let h = mem(24)
    if spawn(cmdline, cwd, h) == 0 { return "" }
    let rd = load64(h + 0)
    let buf = mem(4096)
    let np = mem(8)
    var chunks: [str] = []
    var reading = true
    while reading {
        let r = win("ReadFile", rd, buf, 4096, np, 0)
        let got = load64(np) & 4294967295
        if r == 0 or got == 0 {
            reading = false
        } else {
            var k = 0
            while k < got {
                chunks.push(chr(load8(buf + k)))
                k += 1
            }
        }
    }
    win("WaitForSingleObject", load64(h + 8), 4294967295)
    win("CloseHandle", load64(h + 0))
    win("CloseHandle", load64(h + 8))
    win("CloseHandle", load64(h + 16))
    return chunks.join()
}
// Non-blocking capture with a wall-clock cap — for F5. A GUI/never-ending program
// is terminated after timeout_ms instead of hanging the editor.
fn run_program(cmdline: str, cwd: str, timeout_ms: int) -> str {
    let h = mem(24)
    if spawn(cmdline, cwd, h) == 0 { return "(could not start process)" }
    let rd = load64(h + 0)
    let proc = load64(h + 8)
    let buf = mem(4096)
    let np = mem(8)
    let avail = mem(8)
    var chunks: [str] = []
    let start = tick()
    var done = false
    while not done {
        win("PeekNamedPipe", rd, 0, 0, 0, avail, 0)
        let a = load64(avail) & 4294967295
        if a > 0 {
            let r = win("ReadFile", rd, buf, 4096, np, 0)
            let got = load64(np) & 4294967295
            var k = 0
            while k < got {
                chunks.push(chr(load8(buf + k)))
                k += 1
            }
            if r == 0 { done = true }
        } else if (win("WaitForSingleObject", proc, 0) & 4294967295) == 0 {
            done = true                  // process exited; final drain below
        } else if tick() - start > timeout_ms {
            win("TerminateProcess", proc, 1)
            chunks.push("\n(terminated after timeout)")
            done = true
        } else {
            win("Sleep", 10)
        }
    }
    var draining = true
    while draining {
        win("PeekNamedPipe", rd, 0, 0, 0, avail, 0)
        if (load64(avail) & 4294967295) == 0 {
            draining = false
        } else {
            win("ReadFile", rd, buf, 4096, np, 0)
            let got = load64(np) & 4294967295
            if got == 0 {
                draining = false
            } else {
                var k = 0
                while k < got {
                    chunks.push(chr(load8(buf + k)))
                    k += 1
                }
            }
        }
    }
    win("CloseHandle", load64(h + 0))
    win("CloseHandle", load64(h + 8))
    win("CloseHandle", load64(h + 16))
    return chunks.join()
}

fn mark_edit() {
    g_modified = true
    g_edit_seq += 1
    g_last_edit = tick()
}
// Compile the current buffer with the real zc.exe and surface its first error.
fn parse_diag(outp: str) {
    g_diag_line = -1
    g_diag_msg = ""
    let key = ": error: "
    let idx = outp.index_of(key)
    if idx < 0 { return }
    var e = idx + key.len()
    var me = e
    while me < outp.len() and outp.byte(me) != 10 { me += 1 }
    g_diag_msg = outp.sub(e, me)
    var startd = idx
    var k = idx - 1
    while k >= 0 and outp.byte(k) >= 48 and outp.byte(k) <= 57 {
        startd = k
        k -= 1
    }
    if startd < idx { g_diag_line = outp.sub(startd, idx) as int }
}
fn run_diagnostics() {
    if g_zc == "" { return }
    let dir = dirname(g_path)                 // "" when untitled
    let tmp = dir + ".zide_check.zeph"
    let tmpout = dir + ".zide_check.s"
    write_file(tmp, join_lines())
    let cmd = "\"" + g_zc + "\" --rt \"" + tmp + "\" \"" + tmpout + "\""
    let outp = run_capture(cmd, dir)
    win("DeleteFileA", cstr(tmp))
    win("DeleteFileA", cstr(tmpout))
    parse_diag(outp)
    g_diag_seq = g_edit_seq
}

// --- buffer structure edits ---
fn insert_line(k: int, s: str) {
    lines.push("")
    var i = lines.len() - 1
    while i > k {
        lines[i] = lines[i - 1]
        i -= 1
    }
    lines[k] = s
}
fn delete_line(k: int) {
    if lines.len() <= 1 {
        lines[0] = ""
        return
    }
    var i = k
    while i < lines.len() - 1 {
        lines[i] = lines[i + 1]
        i += 1
    }
    let d = lines.pop()
}
fn copy_lines(src: [str]) -> [str] {
    var d: [str] = []
    for s in src { d.push(s) }
    return d
}

// --- selection ---
fn norm_sel() {
    if al < cl or (al == cl and ac <= cc) {
        g_sl = al
        g_sc = ac
        g_el = cl
        g_ec = cc
    } else {
        g_sl = cl
        g_sc = cc
        g_el = al
        g_ec = ac
    }
}
fn del_sel() {
    norm_sel()
    if g_sl == g_el {
        let s = lines[g_sl]
        lines[g_sl] = s.sub(0, g_sc) + s.sub(g_ec, s.len())
    } else {
        let first = lines[g_sl].sub(0, g_sc)
        let lastline = lines[g_el]
        let last = lastline.sub(g_ec, lastline.len())
        lines[g_sl] = first + last
        let cnt = g_el - g_sl
        var i = 0
        while i < cnt {
            delete_line(g_sl + 1)
            i += 1
        }
    }
    cl = g_sl
    cc = g_sc
    sel = false
}
fn sel_text() -> str {
    norm_sel()
    if g_sl == g_el { return lines[g_sl].sub(g_sc, g_ec) }
    var parts: [str] = []
    parts.push(lines[g_sl].sub(g_sc, lines[g_sl].len()))
    var k = g_sl + 1
    while k < g_el {
        parts.push("\n")
        parts.push(lines[k])
        k += 1
    }
    parts.push("\n")
    parts.push(lines[g_el].sub(0, g_ec))
    return parts.join()
}

// --- undo (full snapshot per edit; ponytail: coalesce/diff later if memory bites) ---
fn push_undo() {
    if g_undo.len() >= 300 {
        var i = 0
        while i < g_undo.len() - 1 {
            g_undo[i] = g_undo[i + 1]
            i += 1
        }
        let d = g_undo.pop()
    }
    g_undo.push(Snap{rows: copy_lines(lines), cl: cl, cc: cc})
}
fn do_undo() {
    if g_undo.len() == 0 { return }
    let snap = g_undo.pop()
    lines = snap.rows
    cl = snap.cl
    cc = snap.cc
    if cl > lines.len() - 1 { cl = lines.len() - 1 }
    clamp_col()
    sel = false
    mark_edit()
    ensure_visible()
}

// --- text insertion ---
fn strip_cr(s: str) -> str {
    if s.len() > 0 and s.byte(s.len() - 1) == 13 { return s.sub(0, s.len() - 1) }
    return s
}
fn do_insert_str(s: str) {
    push_undo()
    if sel { del_sel() }
    let cur = lines[cl]
    lines[cl] = cur.sub(0, cc) + s + cur.sub(cc, cur.len())
    cc += s.len()
    mark_edit()
    ensure_visible()
}
fn insert_text(t: str) {                  // multi-line insert (paste)
    if sel { del_sel() }
    let parts = t.split("\n")
    if parts.len() == 1 {
        let seg = strip_cr(parts[0])
        let cur = lines[cl]
        lines[cl] = cur.sub(0, cc) + seg + cur.sub(cc, cur.len())
        cc += seg.len()
    } else {
        let cur = lines[cl]
        let tail = cur.sub(cc, cur.len())
        lines[cl] = cur.sub(0, cc) + strip_cr(parts[0])
        var i = 1
        while i < parts.len() {
            let seg = strip_cr(parts[i])
            if i == parts.len() - 1 {
                insert_line(cl + i, seg + tail)
                cc = seg.len()
            } else {
                insert_line(cl + i, seg)
            }
            i += 1
        }
        cl = cl + parts.len() - 1
    }
    mark_edit()
    ensure_visible()
}
fn do_enter() {
    push_undo()
    if sel { del_sel() }
    let cur = lines[cl]
    var ind = 0
    while ind < cur.len() and (cur.byte(ind) == 32 or cur.byte(ind) == 9) { ind += 1 }
    let indent = cur.sub(0, ind)
    let tail = cur.sub(cc, cur.len())
    lines[cl] = cur.sub(0, cc)
    insert_line(cl + 1, indent + tail)
    cl += 1
    cc = indent.len()
    mark_edit()
    ensure_visible()
}
fn do_backspace() {
    push_undo()
    if sel {
        del_sel()
        mark_edit()
        ensure_visible()
        return
    }
    if cc > 0 {
        let cur = lines[cl]
        lines[cl] = cur.sub(0, cc - 1) + cur.sub(cc, cur.len())
        cc -= 1
    } else if cl > 0 {
        let prev = lines[cl - 1]
        let pl = prev.len()
        lines[cl - 1] = prev + lines[cl]
        delete_line(cl)
        cl -= 1
        cc = pl
    }
    mark_edit()
    ensure_visible()
}
fn do_delete() {
    push_undo()
    if sel {
        del_sel()
        mark_edit()
        ensure_visible()
        return
    }
    let cur = lines[cl]
    if cc < cur.len() {
        lines[cl] = cur.sub(0, cc) + cur.sub(cc + 1, cur.len())
    } else if cl < lines.len() - 1 {
        lines[cl] = cur + lines[cl + 1]
        delete_line(cl + 1)
    }
    mark_edit()
    ensure_visible()
}

// --- cursor movement ---
fn clamp_col() {
    if cc > lines[cl].len() { cc = lines[cl].len() }
}
fn move_left() {
    if cc > 0 {
        cc -= 1
    } else if cl > 0 {
        cl -= 1
        cc = lines[cl].len()
    }
    ensure_visible()
}
fn move_right() {
    if cc < lines[cl].len() {
        cc += 1
    } else if cl < lines.len() - 1 {
        cl += 1
        cc = 0
    }
    ensure_visible()
}
fn move_up() {
    if cl > 0 {
        cl -= 1
        clamp_col()
    }
    ensure_visible()
}
fn move_down() {
    if cl < lines.len() - 1 {
        cl += 1
        clamp_col()
    }
    ensure_visible()
}
fn page(dir: int) {
    cl += dir * g_vis_lines
    if cl < 0 { cl = 0 }
    if cl > lines.len() - 1 { cl = lines.len() - 1 }
    clamp_col()
    ensure_visible()
}
fn begin_move(shift: bool) {
    if shift {
        if not sel {
            al = cl
            ac = cc
            sel = true
        }
    } else {
        sel = false
    }
}
fn ensure_visible() {
    var vis = g_vis_lines
    if vis < 1 { vis = 1 }
    if cl < top { top = cl }
    if cl >= top + vis { top = cl - vis + 1 }
    if top < 0 { top = 0 }
    var visc = g_vis_cols
    if visc < 1 { visc = 1 }
    if cc < leftcol { leftcol = cc }
    if cc >= leftcol + visc { leftcol = cc - visc + 1 }
    if leftcol < 0 { leftcol = 0 }
}
fn do_select_all() {
    al = 0
    ac = 0
    cl = lines.len() - 1
    cc = lines[cl].len()
    sel = true
    ensure_visible()
}

// --- clipboard (CF_TEXT via user32/kernel32) ---
fn set_clipboard(t: str) {
    if win("user32!OpenClipboard", g_hwnd) == 0 { return }
    win("user32!EmptyClipboard")
    let n = t.len()
    let h = win("GlobalAlloc", 2, n + 1)          // GMEM_MOVEABLE
    let p = win("GlobalLock", h)
    for i in 0..n { store8(p + i, t.byte(i)) }
    store8(p + n, 0)
    win("GlobalUnlock", h)
    win("user32!SetClipboardData", 1, h)          // CF_TEXT
    win("user32!CloseClipboard")
}
fn get_clipboard() -> str {
    if win("user32!OpenClipboard", g_hwnd) == 0 { return "" }
    let h = win("user32!GetClipboardData", 1)     // CF_TEXT
    if h == 0 {
        win("user32!CloseClipboard")
        return ""
    }
    let p = win("GlobalLock", h)
    var chars: [str] = []
    var i = 0
    var b = load8(p + i)
    while b != 0 {
        chars.push(chr(b))
        i += 1
        b = load8(p + i)
    }
    win("GlobalUnlock", h)
    win("user32!CloseClipboard")
    return chars.join()
}
fn do_copy() {
    if sel { set_clipboard(sel_text()) }
}
fn do_cut() {
    if not sel { return }
    push_undo()
    set_clipboard(sel_text())
    del_sel()
    mark_edit()
    ensure_visible()
}
fn do_paste() {
    let t = get_clipboard()
    if t.len() > 0 {
        push_undo()
        insert_text(t)
    }
}

// --- files ---
fn set_content(content: str) {
    var nl: [str] = []
    let raw = content.split("\n")
    var i = 0
    while i < raw.len() {
        nl.push(strip_cr(raw[i]))
        i += 1
    }
    if nl.len() == 0 { nl.push("") }
    lines = nl
    cl = 0
    cc = 0
    top = 0
    leftcol = 0
    sel = false
}
fn load_file(path: str) {
    set_content(read_file(path))
    g_path = path
    g_modified = false
}
fn join_lines() -> str {
    var parts: [str] = []
    var i = 0
    while i < lines.len() {
        parts.push(lines[i])
        if i < lines.len() - 1 { parts.push("\n") }
        i += 1
    }
    return parts.join()
}
fn do_save() {
    if g_path == "" { g_path = "untitled.zeph" }
    write_file(g_path, join_lines())
    g_modified = false
}
fn do_run() {
    if g_zc == "" { return }
    do_save()
    if g_path == "" { return }
    let dir = dirname(g_path)
    let outexe = dir + ".zide_run.exe"
    let cres = run_capture("\"" + g_zc + "\" --rt \"" + g_path + "\" \"" + outexe + "\"", dir)
    if cres.index_of(" error: ") >= 0 {
        g_out = "compile error:\n" + cres
    } else {
        var rres = run_program("\"" + outexe + "\"", dir, 5000)
        win("DeleteFileA", cstr(outexe))
        if rres == "" { rres = "(program exited with no output)" }
        g_out = rres
    }
    g_show_out = true
}
fn def_here(s: str, kw: str, name: str) -> bool {
    let idx = s.index_of(kw + name)
    if idx < 0 { return false }
    let after = idx + kw.len() + name.len()
    if after < s.len() and is_alnum(s.byte(after)) { return false }   // word boundary
    return true
}
fn find_def(name: str) -> int {
    if name == "" { return -1 }
    var li = 0
    while li < lines.len() {
        let s = lines[li]
        if def_here(s, "fn ", name) or def_here(s, "let ", name) or def_here(s, "var ", name) or def_here(s, "struct ", name) or def_here(s, "enum ", name) {
            return li
        }
        li += 1
    }
    return -1
}

// --- completion (intellisense popup) ---
fn comp_hide() {
    g_comp_on = false
    var e: [str] = []
    g_comp_items = e
    g_comp_sel = 0
}
fn cur_word_start() -> int {
    let s = lines[cl]
    var a = cc
    while a > 0 and is_alnum(s.byte(a - 1)) { a -= 1 }
    return a
}
fn rebuild_pool() {
    if g_pool_seq == g_edit_seq { return }
    var seen: [str: bool] = [:]
    var out: [str] = []
    for w in g_kw.keys() {
        if not seen.has(w) {
            seen[w] = true
            out.push(w)
        }
    }
    for w in g_ty.keys() {
        if not seen.has(w) {
            seen[w] = true
            out.push(w)
        }
    }
    for w in g_builtin.keys() {
        if not seen.has(w) {
            seen[w] = true
            out.push(w)
        }
    }
    var li = 0
    while li < lines.len() {
        let s = lines[li]
        let n = s.len()
        var i = 0
        while i < n {
            let c = s.byte(i)
            if is_alpha(c) {
                var j = i + 1
                while j < n and is_alnum(s.byte(j)) { j += 1 }
                let w = s.sub(i, j)
                if not seen.has(w) {
                    seen[w] = true
                    out.push(w)
                }
                i = j
            } else if c == 34 {                       // skip string bodies
                var j = i + 1
                while j < n {
                    let cj = s.byte(j)
                    if cj == 92 {
                        j += 2
                        continue
                    }
                    if cj == 34 {
                        j += 1
                        break
                    }
                    j += 1
                }
                i = j
            } else if c == 47 and i + 1 < n and s.byte(i + 1) == 47 {
                i = n                                 // rest of line is a comment
            } else {
                i += 1
            }
        }
        li += 1
    }
    g_pool = out
    g_pool_seq = g_edit_seq
}
fn update_completion() {
    let s = lines[cl]
    let ws = cur_word_start()
    let prefix = s.sub(ws, cc)
    var dot = false
    if ws > 0 and s.byte(ws - 1) == 46 { dot = true }
    var items: [str] = []
    if dot {
        for m in g_methods {
            if m.starts_with(prefix) { items.push(m) }
        }
    } else {
        if prefix.len() < 1 {
            comp_hide()
            return
        }
        rebuild_pool()
        for w in g_pool {
            if w.starts_with(prefix) and w != prefix { items.push(w) }
        }
    }
    if items.len() == 0 {
        comp_hide()
        return
    }
    g_comp_items = items
    g_comp_sel = 0
    g_comp_dot = dot
    g_comp_on = true
}
fn comp_accept() {
    if not g_comp_on { return }
    let item = g_comp_items[g_comp_sel]
    let s = lines[cl]
    let ws = cur_word_start()
    lines[cl] = s.sub(0, ws) + item + s.sub(cc, s.len())
    cc = ws + item.len()
    comp_hide()
    mark_edit()
    ensure_visible()
}

// --- Claude chat (async: spawn claude -p, poll its pipe from the timer) ---
fn esc_arg(s: str) -> str {
    var r = s.replace("\"", "'")         // dodge Windows command-line quoting
    r = r.replace("\n", " ")
    r = r.replace(chr(13), " ")
    return r
}
fn wrap(text: str, cols0: int) -> [str] {
    var out: [str] = []
    var cols = cols0
    if cols < 8 { cols = 8 }
    for para in text.split("\n") {
        var line = ""
        for word in para.split(" ") {
            if line == "" {
                line = word
            } else if line.len() + 1 + word.len() <= cols {
                line = line + " " + word
            } else {
                out.push(line)
                line = word
            }
            while line.len() > cols {
                out.push(line.sub(0, cols))
                line = line.sub(cols, line.len())
            }
        }
        out.push(line)
    }
    return out
}
fn chat_note(role: int, text: str) {
    g_msgs.push(ChatMsg{role: role, text: text})
    g_chat_scroll = 1000000                       // stick to bottom
    g_dirty = true
}
fn chat_submit() {
    if g_ai_running { return }
    let prompt = g_chat_input.trim()
    if prompt == "" { return }
    g_chat_input = ""
    chat_note(0, prompt)
    if g_claude == "" {
        chat_note(2, "claude.exe not found under %APPDATA%\\Claude.")
        return
    }
    if g_path != "" and g_modified { do_save() }
    var ctx = ""
    if g_path != "" { ctx = "The file open in my editor is " + g_path + ". " }
    let cmd = "\"" + g_claude + "\" -p \"" + esc_arg(ctx + prompt) + "\" --output-format text --permission-mode acceptEdits"
    let h = mem(24)
    if spawn(cmd, dirname(g_path), h) == 0 {
        chat_note(2, "could not start claude.exe")
        return
    }
    g_ai_rd = load64(h + 0)
    g_ai_proc = load64(h + 8)
    g_ai_thread = load64(h + 16)
    g_ai_running = true
    g_ai_partial = ""
    chat_note(1, "...")                           // placeholder, filled in as output streams
}
fn ai_drain() -> bool {                           // read all currently-available bytes
    let buf = mem(4096)
    let np = mem(8)
    let avail = mem(8)
    var changed = false
    win("PeekNamedPipe", g_ai_rd, 0, 0, 0, avail, 0)
    var a = load64(avail) & 4294967295
    while a > 0 {
        let r = win("ReadFile", g_ai_rd, buf, 4096, np, 0)
        let got = load64(np) & 4294967295
        if got == 0 { break }
        var chunk: [str] = []
        var k = 0
        while k < got {
            let b = load8(buf + k)
            if b != 13 { chunk.push(chr(b)) }
            k += 1
        }
        g_ai_partial = g_ai_partial + chunk.join()
        changed = true
        if r == 0 { break }
        win("PeekNamedPipe", g_ai_rd, 0, 0, 0, avail, 0)
        a = load64(avail) & 4294967295
    }
    return changed
}
fn poll_ai() {
    if not g_ai_running { return }
    if ai_drain() {
        g_msgs[g_msgs.len() - 1] = ChatMsg{role: 1, text: g_ai_partial}
        g_chat_scroll = 1000000
        g_dirty = true
    }
    if (win("WaitForSingleObject", g_ai_proc, 0) & 4294967295) == 0 {
        ai_drain()                                // final flush after exit
        win("CloseHandle", g_ai_rd)
        win("CloseHandle", g_ai_proc)
        win("CloseHandle", g_ai_thread)
        g_ai_running = false
        var final = g_ai_partial.trim()
        if final == "" { final = "(no response)" }
        g_msgs[g_msgs.len() - 1] = ChatMsg{role: 1, text: final}
        g_chat_scroll = 1000000
        // reflect any edits Claude made to the open file
        if g_path != "" {
            let disk = read_file(g_path)
            if disk != join_lines() {
                set_content(disk)
                g_modified = false
                chat_note(2, "(reloaded " + g_path + " - Claude edited it)")
                run_diagnostics()
            }
        }
        g_dirty = true
    }
}
fn chat_char(c: int) {
    if c == 13 {
        chat_submit()
        return
    }
    if c == 8 {
        if g_chat_input.len() > 0 { g_chat_input = g_chat_input.sub(0, g_chat_input.len() - 1) }
        g_dirty = true
        return
    }
    if c < 32 or c == 127 { return }
    g_chat_input = g_chat_input + chr(c)
    g_dirty = true
}
fn chat_keydown(vk: int) {
    if vk == 27 {                                 // Esc -> back to editor
        g_focus = 0
        g_dirty = true
        return
    }
    if vk == 33 {                                 // PgUp
        g_chat_scroll -= 6
        if g_chat_scroll < 0 { g_chat_scroll = 0 }
        g_dirty = true
        return
    }
    if vk == 34 {                                 // PgDn
        g_chat_scroll += 6
        g_dirty = true
        return
    }
}

// --- input dispatch ---
fn on_char(c: int) {
    if g_focus == 1 {                       // chat input has focus
        chat_char(c)
        return
    }
    if g_comp_on and (c == 13 or c == 9) {  // Enter/Tab accept the selection
        comp_accept()
        return
    }
    if c == 8 {
        do_backspace()
        update_completion()
        return
    }
    if c == 13 {
        do_enter()
        comp_hide()
        return
    }
    if c == 9 {
        do_insert_str("    ")               // tab -> 4 spaces
        comp_hide()
        return
    }
    if c < 32 { return }                    // other control codes
    if c == 127 { return }
    do_insert_str(chr(c))
    update_completion()
}
fn on_keydown(vk: int) {
    let ctrl = key_down(17)
    let shift = key_down(16)
    if (ctrl and vk == 76) or vk == 113 {   // Ctrl+L or F2: toggle the Claude panel + focus
        g_chat_on = not g_chat_on
        if g_chat_on { g_focus = 1 } else { g_focus = 0 }
        g_dirty = true
        return
    }
    if vk == 114 or (ctrl and vk == 84) {   // F3 or Ctrl+T: toggle light/dark theme (any focus)
        apply_theme(not g_dark)
        g_dirty = true
        return
    }
    if g_focus == 1 {                       // chat input owns the keyboard
        chat_keydown(vk)
        return
    }
    if g_comp_on {
        if vk == 38 {                       // Up
            if g_comp_sel > 0 { g_comp_sel -= 1 }
            g_dirty = true
            return
        }
        if vk == 40 {                       // Down
            if g_comp_sel < g_comp_items.len() - 1 { g_comp_sel += 1 }
            g_dirty = true
            return
        }
        if vk == 27 {                       // Esc dismisses
            comp_hide()
            g_dirty = true
            return
        }
        if vk == 37 or vk == 39 or vk == 36 or vk == 35 or vk == 33 or vk == 34 or vk == 46 {
            comp_hide()                     // cursor movement dismisses, then falls through
        }
    }
    if g_show_out and vk == 27 {            // Esc closes the output panel
        g_show_out = false
        g_dirty = true
        return
    }
    if vk == 116 {                          // F5: build + run, show output
        do_run()
        g_dirty = true
        return
    }
    if ctrl {
        if vk == 83 {
            do_save()
            return
        }
        if vk == 90 {
            do_undo()
            return
        }
        if vk == 65 {
            do_select_all()
            return
        }
        if vk == 67 {
            do_copy()
            return
        }
        if vk == 88 {
            do_cut()
            return
        }
        if vk == 86 {
            do_paste()
            return
        }
        if vk == 69 {                       // Ctrl+E: ask Claude to fix the current error
            if g_diag_line >= 0 {
                g_chat_on = true
                g_focus = 1
                g_chat_input = "Fix this compiler error on line {g_diag_line}: {g_diag_msg}"
                chat_submit()
            }
            return
        }
        if vk == 36 {
            begin_move(shift)
            cl = 0
            cc = 0
            ensure_visible()
            return
        }
        if vk == 35 {
            begin_move(shift)
            cl = lines.len() - 1
            cc = lines[cl].len()
            ensure_visible()
            return
        }
        return
    }
    if vk == 37 {
        begin_move(shift)
        move_left()
        return
    }
    if vk == 39 {
        begin_move(shift)
        move_right()
        return
    }
    if vk == 38 {
        begin_move(shift)
        move_up()
        return
    }
    if vk == 40 {
        begin_move(shift)
        move_down()
        return
    }
    if vk == 36 {
        begin_move(shift)
        cc = 0
        ensure_visible()
        return
    }
    if vk == 35 {
        begin_move(shift)
        cc = lines[cl].len()
        ensure_visible()
        return
    }
    if vk == 33 {
        begin_move(shift)
        page(-1)
        return
    }
    if vk == 34 {
        begin_move(shift)
        page(1)
        return
    }
    if vk == 46 {
        do_delete()
        return
    }
}
fn on_mouse(mx: int, my: int, shift: bool) {
    if g_chat_on and mx >= g_edit_w {       // click in the Claude column focuses it
        g_focus = 1
        g_dirty = true
        return
    }
    g_focus = 0
    let status_h = g_line_h + 12
    if my >= g_client_h - status_h { return }
    let digits = (lines.len() as str).len()
    let gutter = (digits + 3) * g_char_w
    var li = top + my / g_line_h
    if li > lines.len() - 1 { li = lines.len() - 1 }
    if li < 0 { li = 0 }
    var col = leftcol + (mx - gutter + g_char_w / 2) / g_char_w
    if col < 0 { col = 0 }
    if col > lines[li].len() { col = lines[li].len() }
    if key_down(17) {                       // Ctrl+click -> go to definition
        let dl = find_def(word_at(li, col))
        if dl >= 0 {
            comp_hide()
            sel = false
            cl = dl
            cc = 0
            ensure_visible()
            return
        }
    }
    begin_move(shift)
    cl = li
    cc = col
    comp_hide()
    ensure_visible()
}
fn word_at(li: int, col: int) -> str {
    if li < 0 or li >= lines.len() { return "" }
    let s = lines[li]
    if col < 0 or col >= s.len() { return "" }
    if not is_alnum(s.byte(col)) { return "" }
    var a = col
    while a > 0 and is_alnum(s.byte(a - 1)) { a -= 1 }
    var b = col
    while b < s.len() and is_alnum(s.byte(b)) { b += 1 }
    return s.sub(a, b)
}
fn on_hover(px: int, py: int) {
    let status_h = g_line_h + 12
    var word = ""
    if py < g_client_h - status_h {
        let digits = (lines.len() as str).len()
        let gutter = (digits + 3) * g_char_w
        if px >= gutter {
            let li = top + py / g_line_h
            let col = leftcol + (px - gutter) / g_char_w
            word = word_at(li, col)
        }
    }
    if g_docs.has(word) {
        if word != g_hover_word {
            g_hover_word = word
            g_hover_doc = g_docs[word]
            g_hover_px = px
            g_hover_py = py
            g_dirty = true
        }
    } else if g_hover_word != "" {
        g_hover_word = ""
        g_dirty = true
    }
}
fn on_wheel(delta: int) {
    if g_chat_on and g_focus == 1 {         // scroll the transcript
        if delta > 0 {
            g_chat_scroll -= 3
        } else {
            g_chat_scroll += 3
        }
        if g_chat_scroll < 0 { g_chat_scroll = 0 }
        return
    }
    if delta > 0 {
        top -= 3
    } else {
        top += 3
    }
    if top < 0 { top = 0 }
    if top > lines.len() - 1 { top = lines.len() - 1 }
}
fn dispatch(m: int, wp: int, lp: int) {
    if m == 258 {                           // WM_CHAR
        on_char(wp & 4294967295)
        g_dirty = true
        return
    }
    if m == 256 {                           // WM_KEYDOWN
        on_keydown(wp & 4294967295)
        g_dirty = true
        return
    }
    if m == 513 {                           // WM_LBUTTONDOWN
        on_mouse(sword(lp & 65535), sword((lp >> 16) & 65535), key_down(16))
        g_dirty = true
        return
    }
    if m == 512 {                           // WM_MOUSEMOVE: builtin hover-docs
        on_hover(sword(lp & 65535), sword((lp >> 16) & 65535))
        return
    }
    if m == 522 {                           // WM_MOUSEWHEEL
        on_wheel(sword((wp >> 16) & 65535))
        g_dirty = true
        return
    }
    if m == 275 {                           // WM_TIMER: poll Claude + debounced diagnostics
        poll_ai()
        if g_edit_seq != g_diag_seq and tick() - g_last_edit >= 250 {
            run_diagnostics()
            g_dirty = true
        }
        return
    }
    if m == 15 {                            // WM_PAINT
        g_dirty = true
        return
    }
    if m == 5 {                             // WM_SIZE
        g_dirty = true
        return
    }
}

// --- syntax highlighting (per-line lexer, fused with rendering) ---
fn build_set(words: str) -> [str: bool] {
    var m: [str: bool] = [:]
    for w in words.split(" ") { m[w] = true }
    return m
}
fn build_docs() -> [str: str] {
    var d: [str: str] = [:]
    d["print"] = "print(v: any)\nFormat v and append a newline."
    d["emit"] = "emit(s: str)\nWrite s to stdout with no trailing newline."
    d["panic"] = "panic(msg: str)\nPrint 'panic: msg' to stderr and exit 1. Not catchable."
    d["assert"] = "assert(cond: bool, msg: str?)\nPanic with msg if cond is false."
    d["sqrt"] = "sqrt(x: float) -> float\nSquare root; an int argument widens."
    d["abs"] = "abs(x) -> x\nAbsolute value, int or float."
    d["min"] = "min(a, b) -> number\nSmaller of a and b (widens if mixed)."
    d["max"] = "max(a, b) -> number\nLarger of a and b (widens if mixed)."
    d["pow"] = "pow(b: int, e: int) -> int\nFast exponentiation; e < 0 gives 0."
    d["chr"] = "chr(code: int) -> str\nOne-byte string for a 0..255 code."
    d["bits"] = "bits(x: float) -> int\nIEEE-754 bit pattern of x, zero cost."
    d["frombits"] = "frombits(i: int) -> float\nReinterpret a bit pattern as a float."
    d["zeros"] = "zeros(n: int) -> [int]\nA preallocated list of n zeros."
    d["args"] = "args() -> [str]\nCommand-line arguments; args()[0] is the program."
    d["read_file"] = "read_file(path: str) -> str\nWhole file as a string; panics if unreadable."
    d["write_file"] = "write_file(path: str, data: str)\nCreate or overwrite a file; panics on failure."
    d["len"] = ".len() -> int\nElements in a list, or bytes in a string."
    d["push"] = ".push(v)\nAppend v to a list (amortized O(1))."
    d["pop"] = ".pop() -> T\nRemove and return the last element; panics when empty."
    d["byte"] = "s.byte(i: int) -> int\nByte value 0..255 at i, bounds-checked."
    d["sub"] = "s.sub(lo: int, hi: int) -> str\nHalf-open [lo, hi) byte range."
    d["join"] = "l.join() -> str\nConcatenate a [str] in a single pass."
    d["split"] = "s.split(sep: str) -> [str]\nSplit on sep; empty sep splits into bytes."
    d["contains"] = ".contains(x) -> bool\nSubstring test (str) or membership (list)."
    d["index_of"] = ".index_of(x) -> int\nFirst index of x, or -1."
    d["starts_with"] = "s.starts_with(t: str) -> bool\nPrefix test."
    d["ends_with"] = "s.ends_with(t: str) -> bool\nSuffix test."
    d["replace"] = "s.replace(old: str, new: str) -> str\nReplace all non-overlapping occurrences."
    d["upper"] = "s.upper() -> str\nASCII uppercase."
    d["lower"] = "s.lower() -> str\nASCII lowercase."
    d["trim"] = "s.trim() -> str\nStrip leading/trailing ASCII whitespace."
    d["repeat"] = "s.repeat(n: int) -> str\nn concatenated copies."
    d["sort"] = "l.sort()\nSort a list in place, ascending (native introsort)."
    d["has"] = "m.has(k) -> bool\nWhether the map contains key k."
    d["remove"] = "m.remove(k)\nDelete key k from the map."
    d["keys"] = "m.keys() -> [K]\nThe map's keys (order unspecified)."
    d["values"] = "m.values() -> [V]\nThe map's values (order unspecified)."
    d["get"] = "m.get(k) -> V?\nSafe lookup: the value, or none."
    d["win"] = "win(\"dll!Func\", args...) -> int\nCall a Win32 export (kernel32/user32/gdi32)."
    d["load64"] = "load64(addr: int) -> int\nRead 8 bytes at a raw address (unsafe)."
    d["load8"] = "load8(addr: int) -> int\nRead 1 byte at a raw address (unsafe)."
    d["store64"] = "store64(addr: int, v: int)\nWrite 8 bytes at a raw address (unsafe)."
    d["store32"] = "store32(addr: int, v: int)\nWrite 4 bytes at a raw address (unsafe)."
    d["store8"] = "store8(addr: int, v: int)\nWrite 1 byte at a raw address (unsafe)."
    d["addr"] = "addr(x) -> int\nRaw address of a heap object (unsafe)."
    d["stackptr"] = "stackptr() -> int\nCurrent stack pointer (unsafe)."
    return d
}
fn is_alpha(c: int) -> bool {
    return (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95
}
fn is_digit(c: int) -> bool { return c >= 48 and c <= 57 }
fn is_alnum(c: int) -> bool { return is_alpha(c) or is_digit(c) }
fn word_color(w: str) -> int {
    if g_kw.has(w) { return C_KW }
    if g_ty.has(w) { return C_TY }
    if g_builtin.has(w) { return C_BUILTIN }
    return g_text
}
fn draw_run(dc: int, x0: int, y: int, off: int, s: str) {
    win("gdi32!TextOutA", dc, x0 + off * g_char_w, y, cstr(s), s.len())
}
fn draw_code_line(dc: int, x0: int, y: int, s: str) {
    let n = s.len()
    var i = 0
    while i < n {
        let c = s.byte(i)
        if c == 32 or c == 9 {
            i += 1
            continue
        }
        if c == 47 and i + 1 < n and s.byte(i + 1) == 47 {   // // comment: rest of line
            win("gdi32!SetTextColor", dc, C_COMMENT)
            draw_run(dc, x0, y, i, s.sub(i, n))
            return
        }
        if c == 34 {                                          // "string" (single-line)
            var j = i + 1
            while j < n {
                let cj = s.byte(j)
                if cj == 92 {
                    j += 2
                    continue
                }
                if cj == 34 {
                    j += 1
                    break
                }
                j += 1
            }
            if j > n { j = n }
            win("gdi32!SetTextColor", dc, C_STR)
            draw_run(dc, x0, y, i, s.sub(i, j))
            i = j
            continue
        }
        if is_digit(c) {                                      // number
            var j = i + 1
            while j < n and (is_digit(s.byte(j)) or s.byte(j) == 46) { j += 1 }
            win("gdi32!SetTextColor", dc, C_NUM)
            draw_run(dc, x0, y, i, s.sub(i, j))
            i = j
            continue
        }
        if is_alpha(c) {                                      // identifier / keyword / builtin
            var j = i + 1
            while j < n and is_alnum(s.byte(j)) { j += 1 }
            let w = s.sub(i, j)
            win("gdi32!SetTextColor", dc, word_color(w))
            draw_run(dc, x0, y, i, w)
            i = j
            continue
        }
        win("gdi32!SetTextColor", dc, C_OP)                   // operator / punctuation
        draw_run(dc, x0, y, i, s.sub(i, i + 1))
        i += 1
    }
}

fn draw_squiggle(dc: int, x0: int, ybase: int, wpx: int) {
    var w = wpx
    if w < g_char_w { w = g_char_w * 2 }
    let pen = win("gdi32!CreatePen", 0, 1, C_ERR)
    let oldp = win("gdi32!SelectObject", dc, pen)
    win("gdi32!MoveToEx", dc, x0, ybase, 0)
    var x = x0
    var up = false
    while x < x0 + w {
        var ny = ybase
        if up { ny = ybase - 2 }
        win("gdi32!LineTo", dc, x, ny)
        up = not up
        x += 3
    }
    win("gdi32!SelectObject", dc, oldp)
    win("gdi32!DeleteObject", pen)
}

// --- rendering ---
fn fill(dc: int, x: int, y: int, w: int, h: int, brush: int) {
    store32(g_rc2 + 0, x)
    store32(g_rc2 + 4, y)
    store32(g_rc2 + 8, x + w)
    store32(g_rc2 + 12, y + h)
    win("user32!FillRect", dc, g_rc2, brush)
}
fn draw_text(dc: int, x: int, y: int, s: str) {
    if s.len() == 0 { return }
    win("gdi32!TextOutA", dc, x, y, cstr(s), s.len())
}
fn frame(dc: int, x: int, y: int, w: int, h: int, color: int) {
    let pen = win("gdi32!CreatePen", 0, 1, color)
    let oldp = win("gdi32!SelectObject", dc, pen)
    let oldb = win("gdi32!SelectObject", dc, win("gdi32!GetStockObject", 5))   // NULL_BRUSH
    win("gdi32!Rectangle", dc, x, y, x + w, y + h)
    win("gdi32!SelectObject", dc, oldb)
    win("gdi32!SelectObject", dc, oldp)
    win("gdi32!DeleteObject", pen)
}
fn rounded_box(dc: int, x: int, y: int, w: int, h: int, r: int, brush: int, border: int) {
    let pen = win("gdi32!CreatePen", 0, 1, border)
    let oldp = win("gdi32!SelectObject", dc, pen)
    let oldb = win("gdi32!SelectObject", dc, brush)
    win("gdi32!RoundRect", dc, x, y, x + w, y + h, r, r)
    win("gdi32!SelectObject", dc, oldb)
    win("gdi32!SelectObject", dc, oldp)
    win("gdi32!DeleteObject", pen)
}
fn text_w(dc: int, s: str) -> int {
    if s.len() == 0 { return 0 }
    win("gdi32!GetTextExtentPoint32A", dc, cstr(s), s.len(), g_size)
    return load64(g_size) & 4294967295
}
fn draw_completion(dc: int, gutter: int) {
    let n = g_comp_items.len()
    var shown = n
    if shown > 10 { shown = 10 }
    var maxw = 4
    var i = 0
    while i < n {
        if g_comp_items[i].len() > maxw { maxw = g_comp_items[i].len() }
        i += 1
    }
    let boxw = maxw * g_char_w + 16
    let boxh = shown * g_line_h + 4
    var bx = gutter + (cc - leftcol) * g_char_w
    var by = (cl - top) * g_line_h + g_line_h
    if bx + boxw > g_client_w { bx = g_client_w - boxw - 4 }
    if bx < 0 { bx = 0 }
    rounded_box(dc, bx, by, boxw, boxh, 10, g_tip_brush, g_hair)
    var start = 0
    if g_comp_sel >= shown { start = g_comp_sel - shown + 1 }
    var r = 0
    while r < shown {
        let idx = start + r
        if idx >= n { break }
        let ry = by + 2 + r * g_line_h
        if idx == g_comp_sel { fill(dc, bx + 4, ry, boxw - 8, g_line_h, g_sel_brush) }
        win("gdi32!SetTextColor", dc, C_TIP_TEXT)
        draw_text(dc, bx + 10, ry, g_comp_items[idx])
        r += 1
    }
}
fn draw_tooltip(dc: int, px: int, py: int, doc: str) {
    let dl = doc.split("\n")
    var maxw = 0
    for l in dl {
        if l.len() > maxw { maxw = l.len() }
    }
    let pad = 12
    let boxw = maxw * g_char_w + pad * 2
    let boxh = dl.len() * g_line_h + pad * 2
    var bx = px + 12
    var by = py + 20
    if bx + boxw > g_client_w { bx = g_client_w - boxw - 4 }
    if bx < 0 { bx = 0 }
    if by + boxh > g_client_h { by = py - boxh - 4 }
    rounded_box(dc, bx, by, boxw, boxh, 12, g_tip_brush, g_hair)
    var i = 0
    while i < dl.len() {
        var col = C_TIP_TEXT
        if i > 0 { col = C_TIP_DIM }
        win("gdi32!SetTextColor", dc, col)
        draw_text(dc, bx + pad, by + pad + i * g_line_h, dl[i])
        i += 1
    }
}
fn draw_selection(dc: int, text_x: int, vis: int) {
    norm_sel()
    var row = 0
    while row < vis {
        let li = top + row
        if li >= lines.len() { break }
        if li >= g_sl and li <= g_el {
            var a = 0
            var b = lines[li].len()
            if li == g_sl { a = g_sc }
            if li == g_el { b = g_ec }
            if b < a { b = a }
            let x1 = text_x + (a - leftcol) * g_char_w
            let x2 = text_x + (b - leftcol) * g_char_w
            var w = x2 - x1
            if li < g_el and w < g_char_w { w = g_char_w }   // show the selected newline
            fill(dc, x1, row * g_line_h, w, g_line_h, g_sel_brush)
        }
        row += 1
    }
}
fn draw_chat(dc: int, x0: int, w: int, ch: int) {
    fill(dc, x0, 0, w, ch, g_chrome_brush)           // panel background (chrome)
    fill(dc, x0, 0, 1, ch, g_hair)                   // hairline divider
    let hh = g_line_h + 12
    win("gdi32!SetTextColor", dc, g_text)
    var title = "Claude"
    if g_ai_running { title = "Claude  ·  working..." }
    draw_text(dc, x0 + 16, 8, title)
    fill(dc, x0, hh, w, 1, g_hair)                   // hairline under header

    let pad = 16
    var cols = (w - pad * 2) / g_ui_cw
    if cols < 8 { cols = 8 }
    let input_h = g_line_h * 3 + 8
    let iy = ch - input_h - 8

    var disp: [str] = []
    var dcol: [int] = []
    var mi = 0
    while mi < g_msgs.len() {
        let m = g_msgs[mi]
        var label = "You"
        var lc = C_ROLE_YOU
        if m.role == 1 {
            label = "Claude"
            lc = C_ROLE_AI
        }
        if m.role == 2 {
            label = "System"
            lc = C_TIP_DIM
        }
        disp.push(label)
        dcol.push(lc)
        for wl in wrap(m.text, cols) {
            disp.push(wl)
            dcol.push(g_text)
        }
        disp.push("")
        dcol.push(g_text)
        mi += 1
    }
    let vis = (iy - hh - 8) / g_line_h
    var start = g_chat_scroll
    if start > disp.len() - vis { start = disp.len() - vis }
    if start < 0 { start = 0 }
    g_chat_scroll = start
    var r = 0
    while r < vis and start + r < disp.len() {
        win("gdi32!SetTextColor", dc, dcol[start + r])
        draw_text(dc, x0 + pad, hh + 10 + r * g_line_h, disp[start + r])
        r += 1
    }

    var bcol = g_hair
    if g_focus == 1 { bcol = g_cursor }
    rounded_box(dc, x0 + 10, iy, w - 20, input_h, 10, g_bg_brush, bcol)
    if g_chat_input == "" and g_focus != 1 {
        win("gdi32!SetTextColor", dc, C_TIP_DIM)
        draw_text(dc, x0 + pad, iy + 8, "Ask Claude about this file...")
    } else {
        win("gdi32!SetTextColor", dc, g_text)
        var shown = g_chat_input
        if g_focus == 1 { shown = g_chat_input + "_" }
        var il = 0
        for wl in wrap(shown, cols) {
            if il < 2 { draw_text(dc, x0 + pad, iy + 8 + il * g_line_h, wl) }
            il += 1
        }
    }
}
fn draw() {
    let hdc = win("user32!GetDC", g_hwnd)
    win("user32!GetClientRect", g_hwnd, g_rc)
    let cw = load64(g_rc + 8) & 4294967295
    let ch = load64(g_rc + 12) & 4294967295
    if cw < 4 or ch < 4 {
        win("user32!ReleaseDC", g_hwnd, hdc)
        return
    }
    g_client_w = cw
    g_client_h = ch
    g_edit_w = cw
    if g_chat_on {
        g_edit_w = cw - g_chat_w
        if g_edit_w < 300 { g_edit_w = 300 }
    }

    let mdc = win("gdi32!CreateCompatibleDC", hdc)
    let bmp = win("gdi32!CreateCompatibleBitmap", hdc, cw, ch)
    let oldbmp = win("gdi32!SelectObject", mdc, bmp)
    let oldfont = win("gdi32!SelectObject", mdc, g_font)
    win("gdi32!SetBkMode", mdc, 1)          // TRANSPARENT
    fill(mdc, 0, 0, cw, ch, g_bg_brush)

    let status_h = g_line_h + 12
    let digits = (lines.len() as str).len()
    let gutter = (digits + 3) * g_char_w
    let vis = (ch - status_h) / g_line_h
    g_vis_lines = vis
    g_vis_cols = (g_edit_w - gutter) / g_char_w
    if g_vis_cols < 1 { g_vis_cols = 1 }

    if sel { draw_selection(mdc, gutter, vis) }

    var row = 0
    while row < vis {
        let li = top + row
        if li >= lines.len() { break }
        let y = row * g_line_h
        let numstr = (li + 1) as str
        win("gdi32!SetTextColor", mdc, g_gutter_text)
        draw_text(mdc, gutter - g_char_w - numstr.len() * g_char_w, y, numstr)
        draw_code_line(mdc, gutter - leftcol * g_char_w, y, lines[li])
        if li + 1 == g_diag_line {
            draw_squiggle(mdc, gutter - leftcol * g_char_w, y + g_line_h - 2, lines[li].len() * g_char_w)
        }
        row += 1
    }

    if cl >= top and cl < top + vis {
        fill(mdc, gutter + (cc - leftcol) * g_char_w, (cl - top) * g_line_h, 2, g_line_h, g_cursor_brush)
    }

    if g_show_out {
        let ph = 12 * g_line_h
        var py0 = ch - status_h - ph
        if py0 < g_line_h * 2 { py0 = g_line_h * 2 }
        let realh = ch - status_h - py0
        fill(mdc, 0, py0, g_edit_w, realh, g_tip_brush)
        frame(mdc, 0, py0, g_edit_w, realh, g_hair)
        win("gdi32!SetTextColor", mdc, C_TIP_DIM)
        draw_text(mdc, 8, py0 + 2, "OUTPUT  (Esc to close, F5 to re-run)")
        let ol = g_out.split("\n")
        let cap = (realh - g_line_h) / g_line_h
        var oi = 0
        while oi < ol.len() and oi < cap {
            win("gdi32!SetTextColor", mdc, C_TIP_TEXT)
            draw_text(mdc, 8, py0 + g_line_h + 2 + oi * g_line_h, ol[oi])
            oi += 1
        }
    }

    win("gdi32!SelectObject", mdc, g_ui_font)             // chrome uses the proportional font
    let sy = ch - status_h
    fill(mdc, 0, sy, g_edit_w, status_h, g_status_brush)
    fill(mdc, 0, sy, g_edit_w, 1, g_hair)                 // hairline above the status bar
    win("gdi32!SetTextColor", mdc, g_status_text)
    var name = g_path
    if name == "" { name = "untitled" }
    var mark = ""
    if g_modified { mark = "  ·  edited" }
    let ty = sy + (status_h - g_line_h) / 2 + 1
    let base = "  {name}{mark}      Ln {cl + 1}, Col {cc + 1}      {lines.len()} lines"
    draw_text(mdc, 12, ty, base)
    if g_diag_line >= 0 {
        win("gdi32!SetTextColor", mdc, C_ERR)
        draw_text(mdc, 12 + text_w(mdc, base) + 16, ty, "error {g_diag_line}: {g_diag_msg}")
    }

    if g_chat_on {
        draw_chat(mdc, g_edit_w, cw - g_edit_w, ch)
    }

    win("gdi32!SelectObject", mdc, g_font)                // popups use the code font
    if g_comp_on {
        draw_completion(mdc, gutter)
    } else if g_hover_word != "" {
        draw_tooltip(mdc, g_hover_px, g_hover_py, g_hover_doc)
    }

    win("gdi32!BitBlt", hdc, 0, 0, cw, ch, mdc, 0, 0, 13369376)   // SRCCOPY
    win("gdi32!SelectObject", mdc, oldfont)
    win("gdi32!SelectObject", mdc, oldbmp)
    win("gdi32!DeleteObject", bmp)
    win("gdi32!DeleteDC", mdc)
    win("user32!ReleaseDC", g_hwnd, hdc)
}
fn measure_font() {
    let hdc = win("user32!GetDC", g_hwnd)
    let oldf = win("gdi32!SelectObject", hdc, g_font)
    win("gdi32!GetTextExtentPoint32A", hdc, cstr("M"), 1, g_size)
    let packed = load64(g_size)
    g_char_w = packed & 4294967295
    g_line_h = ((packed >> 32) & 4294967295) + 5      // airier line spacing (8pt-ish grid)
    win("gdi32!SelectObject", hdc, oldf)
    win("user32!ReleaseDC", g_hwnd, hdc)
    if g_char_w < 1 { g_char_w = 8 }
    if g_line_h < 4 { g_line_h = 18 }
}
fn measure_ui() {
    let hdc = win("user32!GetDC", g_hwnd)
    let oldf = win("gdi32!SelectObject", hdc, g_ui_font)
    let sample = "abcdefghijklmnopqrstuvwxyz ABCDEFGHIJKLMNOP"
    let wpx = text_w(hdc, sample)
    g_ui_cw = wpx / sample.len()
    if g_ui_cw < 4 { g_ui_cw = 7 }
    win("gdi32!SelectObject", hdc, oldf)
    win("user32!ReleaseDC", g_hwnd, hdc)
}

// --- headless self-test of the editing engine (no window/GDI) ---
fn selftest() {
    set_content("hello\nworld")
    assert(lines.len() == 2, "load 2 lines")
    assert(lines[0] == "hello", "line0")

    cl = 0
    cc = 5
    do_insert_str("!")
    assert(lines[0] == "hello!", "insert char")

    set_content("    abc")
    cl = 0
    cc = 7
    do_enter()
    assert(lines.len() == 2, "enter splits")
    assert(lines[1] == "    ", "auto-indent carried")

    set_content("ab\ncd")
    cl = 1
    cc = 0
    do_backspace()
    assert(lines.len() == 1, "backspace joins lines")
    assert(lines[0] == "abcd", "join text")
    assert(cl == 0 and cc == 2, "cursor after join")

    set_content("ab\ncd")
    cl = 0
    cc = 2
    do_delete()
    assert(lines[0] == "abcd", "delete-forward joins")

    set_content("hello world")
    al = 0
    ac = 0
    sel = true
    cl = 0
    cc = 6
    del_sel()
    assert(lines[0] == "world", "selection delete")

    set_content("x")
    cl = 0
    cc = 1
    do_insert_str("y")
    assert(lines[0] == "xy", "pre-undo state")
    do_undo()
    assert(lines[0] == "x", "undo restores")

    set_content("a\nb\nc")
    assert(join_lines() == "a\nb\nc", "save round-trip")
    set_content("a\nb\n")
    assert(lines.len() == 3, "trailing newline is an empty last line")
    assert(join_lines() == "a\nb\n", "trailing-newline round-trip")

    // go-to-definition scan
    set_content("let foo = 1\nfn bar()\nfoo")
    assert(find_def("foo") == 0, "find let definition")
    assert(find_def("bar") == 1, "find fn definition")
    assert(find_def("nope") == -1, "no definition")
    assert(def_here("var foobar = 1", "var ", "foo") == false, "definition word boundary")

    // diagnostic parsing
    parse_diag("panic: x.zeph:42: error: something bad\n")
    assert(g_diag_line == 42, "parse diagnostic line")
    assert(g_diag_msg == "something bad", "parse diagnostic message")
    parse_diag("panic: usage: zc ...\n")
    assert(g_diag_line == -1, "no diagnostic without ': error:'")

    print("selftest ok")
}

if args().len() > 1 and args()[1] == "--selftest" {
    selftest()
    win("ExitProcess", 0)
}

// --- entry: build the window and pump messages ---
g_facename = cstr("Consolas")
g_uiface = cstr("Segoe UI")
apply_theme(false)                                       // Apple light theme by default

let hInst = win("GetModuleHandleA", 0)
let u32 = win("GetModuleHandleA", cstr("user32.dll"))
let defwp = win("GetProcAddress", u32, cstr("DefWindowProcA"))
g_clsname = cstr("ZideWindow")

let wc = mem(72)
store32(wc + 0, 3)                                        // CS_HREDRAW|CS_VREDRAW
store64(wc + 8, defwp)
store64(wc + 24, hInst)
store64(wc + 40, win("user32!LoadCursorA", 0, 32513))    // IDC_IBEAM
store64(wc + 48, g_bg_brush)
store64(wc + 64, g_clsname)
win("user32!RegisterClassA", wc)

g_hwnd = win("user32!CreateWindowExA", 0, g_clsname, cstr("Zide - Zephyr IDE"),
    282001408, 120, 80, 1160, 820, 0, 0, hInst, 0)      // WS_OVERLAPPEDWINDOW|WS_VISIBLE
win("user32!ShowWindow", g_hwnd, 5)
win("user32!UpdateWindow", g_hwnd)

g_font = win("gdi32!CreateFontA", 0 - 16, 0, 0, 0, 400, 0, 0, 0, 0, 0, 0, 5, 49, g_facename)
g_ui_font = win("gdi32!CreateFontA", 0 - 15, 0, 0, 0, 400, 0, 0, 0, 0, 0, 0, 5, 34, g_uiface)  // Segoe UI, cleartype, variable pitch
measure_font()
measure_ui()

if args().len() > 1 { load_file(args()[1]) } else { lines.push("") }

g_zc = find_zc()
g_claude = find_claude()
win("user32!SetTimer", g_hwnd, 1, 200, 0)     // drives diagnostics + Claude polling
run_diagnostics()

draw()
var running = 1
while running == 1 {
    win("user32!WaitMessage")
    while win("user32!PeekMessageA", g_msg, 0, 0, 0, 1) != 0 {
        dispatch(load64(g_msg + 8) & 4294967295, load64(g_msg + 16), load64(g_msg + 24))
        win("user32!TranslateMessage", g_msg)
        win("user32!DispatchMessageA", g_msg)
    }
    if win("user32!IsWindow", g_hwnd) == 0 { running = 0 }
    if g_dirty {
        draw()
        g_dirty = false
    }
}
