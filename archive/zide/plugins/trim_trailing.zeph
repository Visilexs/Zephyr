// Zide plugin: strip trailing whitespace from every line.
let text = read_file(args()[1])
var out: [str] = []
for line in text.split("\n") {
    var s = line
    while s.len() > 0 and (s.byte(s.len() - 1) == 32 or s.byte(s.len() - 1) == 9) {
        s = s.sub(0, s.len() - 1)
    }
    out.push(s)
}
var res: [str] = []
var i = 0
while i < out.len() {
    res.push(out[i])
    if i < out.len() - 1 { res.push("\n") }
    i += 1
}
emit(res.join())
