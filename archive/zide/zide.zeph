    assert(z_lines[0] == "", "undo removes the whole burst at once")
    do_insert_str("x")
    do_backspace()
    do_backspace()
    assert(z_undo.len() == 2, "backspace starts its own group, then coalesces")
    // redo: undo/redo round-trip; a fresh edit kills the redo chain
