// Zide - the Zephyr IDE, rebuilt on the Zephyr UI toolkit (ui/ui.zeph).
//
// The immediate-mode toolkit owns the window, fonts, double-buffering and
// per-frame input; Zide adds a real editable code editor (buffer/cursor/
// selection/undo), syntax highlighting via ui_run, live diagnostics from the
// real zc.exe, F5 run, and an async Claude Code chat panel. Editor keys the
// toolkit doesn't map (arrows, Ctrl combos, Delete/Home/End, F-keys) are read
// straight from GetAsyncKeyState each frame. Imports only kernel32/user32/gdi32.
//
//   zc.exe --rt zide/zide.zeph zide/zide.exe
//   zide.exe [file]
//
// The standard OS title bar is stripped (SetWindowLong) so the toolbar is the top
// of the window, JetBrains-style, with custom min/max/close and drag-to-move.
import "../ui/ui.zeph"

struct Snap { rows: [str], cl: int, cc: int }
struct ChatMsg { role: int, text: str }
// a document tab owns its per-document state (IntelliJ's per-Document model):
// buffer + caret + undo/redo/folds/selection all travel with the tab
struct TabS { path: str, rows: [str], cl: int, cc: int, off: int, mod: bool, undo: [Snap], redo: [Snap], folds: [int], sel: [int] }
impl TabS {
    // fresh tab: the associated constructor hides the typed-empty-collection
    // boilerplate that a struct literal can't express (empty lists don't infer)
    fn new(path: str, rows: [str]) -> TabS {
        var u: [Snap] = []
        var r: [Snap] = []
        var f: [int] = []
        var s: [int] = []
        return TabS{path: path, rows: rows, cl: 0, cc: 0, off: 0, mod: false, undo: u, redo: r, folds: f, sel: s}
    }
}
struct Hist { path: str, ts: str, body: str }
struct Tok { kind: int, a: int, b: int }    // lexer token: kind + [a,b) byte span
struct PsiNode { kind: int, name: str, line: int, depth: int }  // parsed declaration
struct Diag { line: int, msg: str, sev: int }  // PSI diagnostic: sev 0 error, 1 warning

