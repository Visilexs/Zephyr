    assert(nat_cmp("a", "a") == 0, "equal strings compare equal")
    var ns = ["file10.zeph", "file2.zeph", "file1.zeph"]
    nat_sort(ns)
    assert(ns[0] == "file1.zeph" and ns[1] == "file2.zeph" and ns[2] == "file10.zeph", "nat_sort orders numerically")
    // common prefix (ported StringUtil.commonPrefixLength) for completion
    assert(common_prefix_len("format", "forge") == 3, "shared prefix length is 3")
    assert(common_prefix_len("abc", "xyz") == 0, "no shared prefix")
    z_comp_items = ["format", "forge", "forward"]
    assert(comp_common_prefix() == "for", "common prefix across candidates")
    let ce: [str] = []
    z_comp_items = ce
    // newline normalization (ported LineTokenizer): CRLF and lone CR -> LF
    assert(normalize_newlines("a" + chr(13) + chr(10) + "b") == "a\nb", "CRLF becomes LF")
    assert(normalize_newlines("a" + chr(13) + "b") == "a\nb", "lone CR becomes LF")
    set_content("x" + chr(13) + chr(10) + "y")
    assert(z_lines.len() == 2 and z_lines[0] == "x" and z_lines[1] == "y", "load splits CRLF without stray CR")
    z_cl = 0
    z_cc = 0
    // trim trailing (ported StringUtil.trimTrailing), keep the caret line
    assert(trim_trailing("foo   ") == "foo", "trailing spaces removed")
    assert(trim_trailing("bar") == "bar", "no-op when clean")
    set_content("a  \nb  \nc  ")
    z_cl = 1
    z_cc = 1
    strip_trailing_ws()
    assert(z_lines[0] == "a", "other lines trimmed on save")
    assert(z_lines[1] == "b  ", "caret line kept intact")
    z_cl = 0
    z_cc = 0
    // tab-expanded visual column (ported EditorUtil.calcColumnNumber)
    assert(vis_col(chr(9) + "x", 1) == 4, "tab advances to next stop")
    assert(vis_col("ab" + chr(9), 3) == 4, "tab from col 2 rounds to 4")
    assert(vis_col("abc", 2) == 2, "plain chars are 1 column each")
    assert(vis_to_col(chr(9) + "x", 4) == 1, "visual col 4 maps back past the tab")
    // lexer token stream (IntelliJ Lexer analogue)
    let lx = lex_line("x = 1 // c")
    assert(lx.len() == 7, "lexer splits into 7 tokens")
    assert(lx[0].kind == TK_WORD and lx[0].a == 0 and lx[0].b == 1, "first token is the identifier x")
    assert(lx[2].kind == TK_OP, "= lexes as an operator")
    assert(lx[4].kind == TK_NUMBER, "1 lexes as a number")
    assert(lx[6].kind == TK_COMMENT and lx[6].b == 10, "trailing // comment spans to EOL")
    let ls = lex_line("\"a\" + b")
    assert(ls[0].kind == TK_STRING and ls[0].b == 3, "string token covers the quotes")
    // parser: declarations from the token stream (PSI analogue)
    set_content("fn foo() \{\n\}\nstruct Bar \{\n\}")
    var decls = parse_decls()
    assert(decls.len() == 2, "parser finds two declarations")
    assert(decls[0].kind == 1 and decls[0].name == "foo" and decls[0].line == 0, "fn foo parsed with name")
    assert(decls[1].kind == 2 and decls[1].name == "Bar" and decls[1].line == 2, "struct Bar parsed with name")
    // a keyword inside a comment must not be mistaken for a declaration
    set_content("// fn ghost\nfn real() \{\}")
    decls = parse_decls()
    assert(decls.len() == 1 and decls[0].name == "real", "commented-out fn is ignored by the parser")
    // PSI consumer: folding derives its ranges from the parse tree
    set_content("fn a() \{\n  x\n\}\nfn b() \{\n  y\n\}")
    fold_all()
    assert(z_folds.len() == 2, "fold_all folds both parsed declarations")
    assert(z_folds[0] == 0 and z_folds[1] == 3, "fold headers match declaration lines")
    let ef: [int] = []
    z_folds = ef
    // PSI consumer: progressive select gains a syntax-block level from the parse tree
    set_content("fn a() \{\n  x\n\}")
    z_cl = 1
    z_cc = 2
    z_sel = false
    z_sw_level = 0
    select_word_expand()               // word
    select_word_expand()               // line
    select_word_expand()               // enclosing declaration
    assert(z_al == 0 and z_cl == 2, "extend selects the whole enclosing fn")
    assert(z_sw_level == 3, "reached the syntax-block level")
    z_sel = false
    z_sw_level = 0
    // PSI consumer: nav-bar symbol is the enclosing declaration, not the nearest header above
    set_content("fn a() \{\n  x\n\}\nY")
    z_cl = 1
    compute_navsym()
    assert(z_navsym != "", "inside fn a: nav shows the enclosing declaration")
    z_cl = 3
    compute_navsym()
    assert(z_navsym == "", "outside any declaration: nav shows nothing")
    // error-tolerant structural analysis (PSI error element): brace balance
    set_content("fn a() \{\n  x\n\}")
    var lint = lint_structure()
    assert(diag_errs(lint) == 0, "balanced braces report no error")
    set_content("fn a() \{\n  x")
    lint = lint_structure()
    assert(diag_errs(lint) == 1 and lint[0].msg == "unclosed '\{'", "missing closer flagged as unclosed")
    set_content("  x\n\}")
    lint = lint_structure()
    assert(diag_errs(lint) == 1 and lint[0].line == 1 and lint[0].msg == "unmatched '\}'", "stray closer flagged")
    // a brace inside a string must not trip the analyzer
    set_content("s = \"\{\"")
    lint = lint_structure()
    assert(diag_errs(lint) == 0, "brace inside a string is not a structural error")
    // malformed declaration: keyword without a name
    set_content("fn () \{\n\}")
    lint = lint_structure()
    assert(diag_errs(lint) == 1 and lint[0].msg == "function needs a name", "nameless fn is flagged")
    set_content("struct \{\n\}")
    lint = lint_structure()
    assert(diag_errs(lint) == 1 and lint[0].msg == "struct needs a name", "nameless struct is flagged")
    // multi-diagnostic store: every flagged line is rendered, not just the first
    set_content("fn a() \{\nfn b() \{")
    z_diag_line = -1
    apply_structural_diag()
    assert(diag_errs(z_sdiag) == 2, "both unclosed braces stored")
    assert(line_has_sdiag(0) and line_has_sdiag(1), "each flagged line is marked")
    let esd: [Diag] = []
    z_sdiag = esd
    z_diag_line = -1
    // toolbar strip allocator (UI layout system, replaces magic-number offsets)
    ui_strip_begin(100)
    assert(ui_strip_slot(28, 2) == 70, "first slot reserved right-to-left")
    assert(ui_strip_slot(28, 2) == 40, "second slot continues leftward")
    assert(ui_strip_sep(14) == 33, "separator returns its centre x")
    assert(ui_strip_slot(88, 32) == 0 - 94, "wide slot with big gap")
    // left-to-right strip (mirror): matches the old hand-computed toolbar offsets
    ui_lstrip_begin(6)
    assert(ui_lstrip_slot(28, 8) == 6, "burger at x=6")
    assert(ui_lstrip_slot(22, 6) == 42, "logo at x=42")
    assert(ui_lstrip_slot(0, 0) == 70, "project chip starts at x=70")
    // vertical rail strip: matches the old ay += 42 stacking (36 high, 6 gap)
    ui_vstrip_begin(100)
    assert(ui_vstrip_slot(36, 6) == 100, "first rail button at top")
    assert(ui_vstrip_slot(36, 6) == 142, "second rail button 42px down")
    // parser extension: top-level variables in the Structure view, locals excluded
    set_content("let G = 3\nfn f() \{\n  let x = 1\n\}")
    var pd = parse_decls()
    assert(pd.len() == 3, "parser sees global, fn, and the local let")
    assert(pd[0].kind == 4 and pd[0].name == "G" and pd[0].depth == 0, "top-level let parsed as a variable")
    assert(pd[2].depth == 1, "the local let is at brace depth 1")
    z_sym_seq = -1
    scan_symbols()
    assert(z_sym_kinds.len() == 2, "structure view shows global + fn, not the local")
    // parser: struct fields become nested member nodes (kind 5)
    set_content("struct P \{\n  x: int\n  y: int\n\}")
    var sp = parse_decls()
    assert(sp.len() == 3, "struct + two field members parsed")
    assert(sp[0].kind == 2 and sp[0].name == "P", "the struct itself")
    assert(sp[1].kind == 5 and sp[1].name == "x", "first field is a member")
    assert(sp[2].kind == 5 and sp[2].name == "y", "second field is a member")
    z_cl = 0
    z_cc = 0
    // svg loader: <circle>/<rect> elements parse (search's magnifier circle was skipped before)
    svg_load("t_search", exe_dir() + "assets\\icons\\search.svg")
    if z_svg_idx.has("t_search") {
        let sv = z_svg[z_svg_idx["t_search"]]
        assert(sv.len() > 40, "search.svg yields circle arcs + handle path, not handle only")
    }
    // recursive tree: stable ids per path (open-state must survive re-layout)
    assert(path_id("a\\b.zeph") == path_id("a\\b.zeph"), "path id is stable")
    assert(path_id("a\\b.zeph") != path_id("a\\c.zeph"), "different paths get different ids")
    // find toggles (IntelliJ FindModel: ignore-case default, Cc + W options)
    z_find_q = "foo"
    z_find_case = false
    z_find_words = false
    assert(find_in("xxFOOxx", 0) == 2, "ignore-case matches FOO by default")
    z_find_case = true
    assert(find_in("xxFOOxx", 0) < 0, "Match Case rejects FOO")
    assert(find_in("xxfooxx", 0) == 2, "Match Case accepts exact foo")
    z_find_case = false
    z_find_words = true
    assert(find_in("food foo", 0) == 5, "Words skips the food prefix match")
    z_find_q = ""
    z_find_words = false
    // regex mode (find bar .*): quantifiers, classes, anchors, variable-length matches
    z_find_regex = true
    z_find_q = "fo+"
    assert(find_in("xfoo", 0) == 1 and z_find_mlen == 3, "fo+ matches foo greedily")
    z_find_q = "[0-9]+"
    assert(find_in("ab123c", 0) == 2 and z_find_mlen == 3, "digit class run")
    z_find_q = "^ab"
    assert(find_in("abc", 0) == 0, "anchored ^ab matches at 0")
    assert(find_in("xabc", 0) < 0, "^ab does not match mid-string")
    z_find_q = "a.c$"
    assert(find_in("xxabc", 0) == 2 and z_find_mlen == 3, "dot + end anchor")
    z_find_q = "[^a]x"
    assert(find_in("axbx", 0) == 2, "negated class skips ax, matches bx")
    z_find_q = "*bad"
    assert(find_in("anything", 0) < 0, "leading quantifier is a rejected pattern")
    z_find_q = "colou?r"
    assert(find_in("color", 0) == 0 and z_find_mlen == 5, "optional u matches color")
    assert(find_in("colour", 0) == 0 and z_find_mlen == 6, "optional u matches colour")
    // capture groups + $N replace
    z_find_q = "(\\w+)\\.(\\w+)"
    assert(find_in("see ab.cd here", 0) == 4 and z_find_mlen == 5, "grouped pattern matches ab.cd")
    assert(rx_expand("$2_$1") == "cd_ab", "captures expand in order $2_$1")
    assert(rx_expand("$$$1") == "$ab", "$$ is a literal dollar")
    z_find_q = "(ab)+"
    assert(find_in("ababab", 0) < 0, "quantified group is a rejected pattern (named ceiling)")
    z_find_regex = false
    z_find_q = ""
    z_rx_src = "\n"
    // find in files: toggle-aware result cache signature; empty query -> no scan
    z_fif_for = "\n"
    fif_scan()
    assert(z_fif_res.len() == 0, "empty query yields no FIF results")
    z_find_q = "abc"
    z_find_case = true
    assert(fif_sig() == "abc|c", "FIF cache signature encodes query + toggles")
    z_find_case = false
    z_find_q = ""
    // bookmarks popup: "path:line" splits at the LAST colon (drive letters contain one)
    z_bookmarks = ["C:\\x\\a.zeph:4"]
    bm_build()
    assert(z_bm_paths.len() == 1, "one bookmark row built")
    assert(z_bm_paths[0] == "C:\\x\\a.zeph" and z_bm_lines[0] == 4, "path keeps its drive colon, line parses")
    var ebm: [str] = []
    z_bookmarks = ebm
    // unused-declaration inspection: only the unreferenced top-level fn is flagged, as a warning
    set_content("fn used() \{\n\}\nfn lonely() \{\n\}\nfn main() \{\n  used()\n\}")
    var ilint = lint_structure()
    assert(diag_errs(ilint) == 0, "inspection sample has no structural errors")
    assert(ilint.len() == 1 and ilint[0].sev == 1, "one warning: the unreferenced fn")
    assert(ilint[0].line == 2 and ilint[0].msg == "fn 'lonely' is never used", "lonely flagged; used + main are not")
    // duplicate top-level declarations: second definition is a live error
    set_content("fn dup() \{\n\}\nfn dup() \{\n\}\nfn main() \{\n  dup()\n\}")
    ilint = lint_structure()
    assert(diag_errs(ilint) == 1, "one error: the duplicate definition")
    assert(ilint[0].line == 2 and ilint[0].msg == "duplicate definition of 'dup'", "flagged on the second definition")
    // unused inspection covers structs too (used-as-type is a use)
    set_content("struct Ghost \{\n\}\nstruct P \{\n\}\nfn main() \{\n  var q: P\n\}")
    ilint = lint_structure()
    assert(ilint.len() == 1 and ilint[0].msg == "struct 'Ghost' is never used", "unused struct flagged; P used as a type is not")
    // unreachable-code inspection: a statement after return in the same block
    set_content("fn main() \{\n    return 1\n    print(2)\n\}")
    ilint = lint_structure()
    var unreach = 0
    for d in ilint {
        if d.msg == "unreachable code" and d.line == 2 { unreach = 1 }
    }
    assert(unreach == 1, "code after return is flagged unreachable")
    set_content("fn main() \{\n    return 1\n\}")
    ilint = lint_structure()
    for d in ilint {
        assert(d.msg != "unreachable code", "return as the last statement is not flagged")
    }
    // self-assignment inspection: x = x flagged; x = y and x == x are not
    set_content("fn main() \{\n    total = total\n\}")
    ilint = lint_structure()
    var selfassign = 0
    for d in ilint {
        if d.msg == "'total' is assigned to itself" { selfassign = 1 }
    }
    assert(selfassign == 1, "x = x flagged as self-assignment")
    set_content("fn main() \{\n    a = b\n    c == c\n\}")
    ilint = lint_structure()
    for d in ilint {
        assert(d.line != 1 and d.line != 2, "x = y and x == x are not self-assignments")
    }
    // Alt+Enter quick-fix: an intention is offered on a flagged line, not a clean one
    set_content("fn main() \{\n    total = total\n\}")
    z_sdiag = lint_structure()
    assert(qf_label_for(1) == "Remove redundant assignment", "self-assignment offers a fix")
    assert(qf_label_for(0) == "", "a clean line offers no fix")
    // quick-fix name extraction + unused-declaration Safe delete fix
    assert(qf_diag_name("fn 'lonely' is never used") == "lonely", "name parsed from the diagnostic")
    set_content("fn lonely() \{\n\}\nfn main() \{\n\}")
    z_sdiag = lint_structure()
    assert(qf_label_for(0) == "Safe delete 'lonely'", "unused fn offers Safe delete")
    z_cl = 0
    z_qf_label = qf_label_for(0)
    qf_apply()
    assert(z_lines.len() == 2 and z_lines[0] == "fn main() \{", "Safe delete removed the whole unused fn")
    // completion pool is lex-aware: identifiers in code, not those buried in strings/comments
    set_content("realvar = 1\ns = \"stringword\" // commentword")
    z_pool_seq = -1
    rebuild_pool()
    var hasReal = false
    var hasStr = false
    var hasCmt = false
    for w in z_pool {
        if w == "realvar" { hasReal = true }
        if w == "stringword" { hasStr = true }
        if w == "commentword" { hasCmt = true }
    }
    assert(hasReal, "code identifier is in the completion pool")
    assert(not hasStr and not hasCmt, "words inside a string/comment are not completed")
    // camel-hump completion (IntelliJ minuscule matcher)
    assert(hump_sig("fooBar") == "fb" and hump_sig("sort_lines") == "sl", "hump signature")
    assert(hump_match("fb", "fooBar") and hump_match("sl", "sort_lines"), "hump prefix matches")
    assert(not hump_match("fx", "fooBar") and not hump_match("f", "fooBar"), "non-hump and 1-char do not match")
    // completion inserts () when accepting a function name, caret inside
    set_content("fn greet() \{\n\}\ngr")
    z_cl = 2
    z_cc = 2
    var ci9: [str] = []
    ci9.push("greet")
    z_comp_items = ci9
    z_comp_sel = 0
    z_comp_on = true
    comp_accept()
    assert(z_lines[2] == "greet()" and z_cc == 6, "function completion inserts () with caret inside")
    // fn-declaration name coloured DEFAULT_FUNCTION_DECLARATION blue (New UI)
    let dtoks = lex_line("fn foo()")
    var namecol = 0
    var kwcol = 0
    for t in dtoks {
        let w = "fn foo()".sub(t.a, t.b)
        if w == "foo" { namecol = tok_color(t, "fn foo()") }
        if w == "fn" { kwcol = tok_color(t, "fn foo()") }
    }
    assert(namecol == C_BUILTIN, "fn declaration name is coloured blue")
    assert(kwcol == C_KW, "the fn keyword itself stays keyword-coloured")
    let ctoks = lex_line("foo()")
    for t in ctoks {
        if "foo()".sub(t.a, t.b) == "foo" { assert(tok_color(t, "foo()") != C_BUILTIN, "a call site is not the declaration colour") }
    }
    // ALL_CAPS constants coloured DEFAULT_CONSTANT (New UI)
    assert(word_color("SE_NOMATCH") == C_CONST and word_color("TOP") == C_CONST, "ALL_CAPS names are constants")
    assert(word_color("total") == C_OP and word_color("fooBar") == C_OP and word_color("x") == C_OP, "mixed-case and single-char names are not constants")
    // token-aware rename: code identifiers only; strings/comments/partials survive
    assert(rename_line("count = count + 1", "count", "total") == "total = total + 1", "both code uses renamed")
    assert(rename_line("s = \"count\" // count", "count", "total") == "s = \"count\" // count", "string + comment untouched")
    assert(rename_line("counter = 1", "count", "total") == "counter = 1", "partial identifier not renamed")
    // F2 error navigation: hops between diagnostic lines, wraps both ways
    set_content("a\nb\nc\nd\ne")
    var nds: [Diag] = []
    nds.push(Diag{line: 1, msg: "x", sev: 0})
    nds.push(Diag{line: 3, msg: "y", sev: 0})
    z_sdiag = nds
    z_diag_line = -1
    z_cl = 0
    goto_error(1)
    assert(z_cl == 1, "next error from top lands on line 1")
    goto_error(1)
    assert(z_cl == 3, "next again lands on line 3")
    goto_error(1)
    assert(z_cl == 1, "next wraps back to the first error")
    goto_error(0 - 1)
    assert(z_cl == 3, "prev wraps to the last error")
    var eds: [Diag] = []
    z_sdiag = eds
    z_cl = 0
    z_cc = 0
    print("selftest ok")
}

// an activity-bar icon button (left rail), Material glyph.
// New-UI active style: filled rounded square, not an edge bar.
fn z_ab2(id: int, x: int, y: int, cp: int, active: bool) -> bool {
    let clicked = ui_flat(id, x, y, 36, 36, "", COL_ITEM)
    if active { fill_rr(x, y, 36, 36, 10, COL_ACCENT) }
    var c = COL_DIM
    if active { c = rgb(255, 255, 255) }
    zicon_cp(cp, x + 10, y + 10, c)  // (36-16)/2 = 10: icon dead-centre in the button
    return clicked
}
fn z_ab(id: int, y: int, cp: int, active: bool) -> bool { return z_ab2(id, 5, y, cp, active) }


// transition OR held-repeat (380ms delay, ~33ms rate). One caller per vk per frame.
fn z_rep(vk: int) -> bool {
    let now = z_key(vk)
    let was = load8(z_nav + vk) != 0
    if now { store8(z_nav + vk, 1) } else { store8(z_nav + vk, 0) }
    if now and not was {
        store64(z_navt + vk * 8, tick())
        store64(z_navr + vk * 8, tick())
        return true
    }
    if now and was {
        let t = tick()
        if t - load64(z_navt + vk * 8) > 380 and t - load64(z_navr + vk * 8) >= 33 {
            store64(z_navr + vk * 8, t)
            return true
        }
    }
    return false
}
fn notify(s: str) {
    if z_notifs.len() >= 8 {
        var i = 0
        while i < z_notifs.len() - 1 {
            z_notifs[i] = z_notifs[i + 1]
            i += 1
        }
        let d = z_notifs.pop()
    }
    z_notifs.push(s)
    z_notif_unread = true
}
// jump to the next occurrence of z_find_q from the caret (wraps); selects the match
// Highlight Usages (HighlightUsagesHandler port): pin the caret word so every
// whole-word occurrence stays highlighted; F3/Shift+F3 cycle through them.
fn word_col_in(s: str, w: str, from: int) -> int {
    if w == "" { return 0 - 1 }
    var i = from
    while i + w.len() <= s.len() {
        if s.sub(i, i + w.len()) == w {
            var bok = i == 0
            if not bok { bok = not is_alnum(s.byte(i - 1)) }
            var aok = i + w.len() >= s.len()
            if not aok { aok = not is_alnum(s.byte(i + w.len())) }
            if bok and aok { return i }
        }
        i += 1
    }
    return 0 - 1
}
fn hl_set() {
    let w = caret_word()
    if w == "" { return }
    z_hl_word = w
    var cnt = 0
    var li = 0
    while li < z_lines.len() {
        if has_word(z_lines[li], w) { cnt += 1 }
        li += 1
    }
    notify("{cnt} usage(s) of '{w}' - F3 / Shift+F3 to cycle, Esc to clear")
}
// Add Selection for Next Occurrence (SelectNextOccurrenceAction port): place a
// caret at the next occurrence of the caret word past all existing carets, and
// pin the word as a Highlight-Usages highlight. One caret per line (model cap).
fn add_next_occurrence() {
    let w = caret_word()
    if w == "" { return }
    z_hl_word = w
    // align the main caret to its word start and select the word (type-to-replace)
    var ws = z_cc
    while ws > 0 and is_alnum(z_lines[z_cl].byte(ws - 1)) { ws -= 1 }
    z_cc = ws
    z_sel = false
    z_mc_sellen = w.len()
    var frontier = z_cl * 1000000 + (z_cc + w.len())   // scan past the current word
    for c in z_carets {
        if c + w.len() > frontier { frontier = c + w.len() }
    }
    let fl = frontier / 1000000
    let fc = frontier % 1000000
    var li = fl
    var from = fc + 1
    while li < z_lines.len() {
        let f = word_col_in(z_lines[li], w, from)
        if f >= 0 {
            mc_add(li, f)
            ensure_caret()
            return
        }
        li += 1
        from = 0
    }
    notify("No more occurrences of '{w}'")
}
// Select All Occurrences (SelectAllOccurrencesAction port): a caret at every
// occurrence of the caret word (one per line), main caret on the first.
fn select_all_occurrences() {
    let w = caret_word()
    if w == "" { return }
    z_hl_word = w
    mc_clear()
    var first = 0 - 1
    var firstc = 0
    var li = 0
    while li < z_lines.len() {
        let f = word_col_in(z_lines[li], w, 0)
        if f >= 0 {
            if first < 0 {
                first = li
                firstc = f
            } else {
                mc_add(li, f)
            }
        }
        li += 1
    }
    if first >= 0 {
        z_cl = first
        z_cc = firstc
        z_sel = false
        z_mc_sellen = w.len()                // every occurrence selected: type to replace all
        ensure_caret()
    }
}
fn hl_jump(dir: int) {
    if z_hl_word == "" {
        find_next()                          // F3 falls back to Find Next when nothing pinned
        return
    }
    let w = z_hl_word
    let n = z_lines.len()
    if dir > 0 {
        var k = 0
        var from = z_cc + 1
        while k <= n {
            let li = (z_cl + k) % n
            let f = word_col_in(z_lines[li], w, from)
            if f >= 0 {
                z_cl = li
                z_cc = f
                z_al = li
                z_ac = f
                z_sel = false
                ensure_caret()
                return
            }
            k += 1
            from = 0
        }
    } else {
        var k = 0
        while k <= n {
            let li = (z_cl - k + n) % n
            var best = 0 - 1
            var lim = z_lines[li].len()
            if k == 0 { lim = z_cc - 1 }
            var c = 0
            while c <= lim {
                let f = word_col_in(z_lines[li], w, c)
                if f < 0 or f > lim {
                    c = lim + 1
                } else {
                    best = f
                    c = f + 1
                }
            }
            if best >= 0 {
                z_cl = li
                z_cc = best
                z_al = li
                z_ac = best
                z_sel = false
                ensure_caret()
                return
            }
            k += 1
        }
    }
}
fn find_next() {
    if z_find_q == "" { return }
    let n = z_lines.len()
    var k = 0
    var col0 = z_cc
    while k <= n {
        let li = (z_cl + k) % n
        let f = find_in(z_lines[li], col0)
        if f >= 0 {
            z_al = li
            z_ac = f
            z_cl = li
            z_cc = f + z_find_mlen
            z_sel = true
            ensure_caret()
            return
        }
        k += 1
        col0 = 0
    }
}
// ---- Find in Files (Ctrl+Shift+F): project-wide search over the same find_in ----
fn fif_sig() -> str {
    var s = z_find_q + "|"
    if z_find_case { s = s + "c" }
    if z_find_words { s = s + "w" }
    if z_find_regex { s = s + "r" }
    return s
}
fn fif_searchable(nm: str) -> bool {
    return nm.ends_with(".zeph") or nm.ends_with(".md") or nm.ends_with(".txt")
}
fn fif_walk(abs: str, rel: str, res: [str], depth: int) {
    if depth > 8 or res.len() >= 200 { return }
    let ents = dir_entries(abs)
    var i = 0
    while i < ents.len() and res.len() < 200 {
        let e = ents[i]
        let nm = e.sub(1, e.len())
        if e.starts_with("D") {
            fif_walk(abs + nm + "\\", rel + nm + "\\", res, depth + 1)
        } else if fif_searchable(nm) {
            let body = normalize_newlines(read_file(abs + nm))
            let ls = body.split("\n")
            var li = 0
            while li < ls.len() and res.len() < 200 {
                if find_in(ls[li], 0) >= 0 {
                    var prev = ls[li].trim()
                    if prev.len() > 80 { prev = prev.sub(0, 80) }
                    res.push(rel + nm + "|" + ((li + 1) as str) + "|" + prev)
                }
                li += 1
            }
        }
        i += 1
    }
}
fn fif_scan() {
    if fif_sig() == z_fif_for { return }        // results cached per query+toggles
    var res: [str] = []
    if z_find_q != "" { fif_walk(dirname(z_path), "", res, 0) }
    z_fif_res = res
    z_fif_sel = 0
    z_fif_for = fif_sig()
}
fn find_count() -> int {
    if z_find_q == "" { return 0 }
    var tot = 0
    for l in z_lines {
        var f = find_in(l, 0)
        while f >= 0 {
            tot += 1
            var ml = z_find_mlen
            if ml < 1 { ml = 1 }
            f = find_in(l, f + ml)
        }
    }
    return tot
}
fn open_find() {
    z_find_on = true
    z_focus = 2
    if z_sel {
        norm_sel()
        if z_nsl == z_nel { z_find_q = z_lines[z_nsl].sub(z_nsc, z_nec) }
    }
}
fn set_font_px(px: int) {
    var p = px
    if p < 12 { p = 12 }
    if p > 22 { p = 22 }
    if p == z_fontpx { return }
    z_fontpx = p
    win("gdi32!DeleteObject", g_fontm)
    g_fontm = win("gdi32!CreateFontA", 0 - p, 0, 0, 0, 400, 0, 0, 0, 0, 0, 0, 49, 0, z_cstr(z_monoface, z_pathbuf))
    z_lh = p + 6
    z_cw = 0                  // remeasure next frame
}
// natural-order string comparison, ported from NaturalComparator (likeFileNames):
// digit runs compare by value so file2 sorts before file10.
fn nat_lower(c: int) -> int {
    if c >= 65 and c <= 90 { return c + 32 }
    return c
}
fn nat_cmp_chars(c1: int, c2: int) -> int {
    if c1 == 32 and c2 > 32 and c2 < 48 { return 1 }
    if c2 == 32 and c1 > 32 and c1 < 48 { return 0 - 1 }
    return nat_lower(c1) - nat_lower(c2)
}
fn nat_skip_char(s: str, start: int, end: int, c: int) -> int {
    var k = start
    while k < end and s.byte(k) == c { k += 1 }
    return k
}
fn nat_skip_digits(s: str, start: int, end: int) -> int {
    var k = start
    while k < end and is_digit(s.byte(k)) { k += 1 }
    return k
}
fn nat_range_cmp(s1: str, s2: str, o1: int, o2: int, end1: int) -> int {
    var i = o1
    var j = o2
    while i < end1 {
        let d = s1.byte(i) - s2.byte(j)
        if d != 0 { return d }
        i += 1
        j += 1
    }
    return 0
}
fn nat_cmp(s1: str, s2: str) -> int {
    let l1 = s1.len()
    let l2 = s2.len()
    var i = 0
    var j = 0
    while i < l1 and j < l2 {
        let ch1 = s1.byte(i)
        let ch2 = s2.byte(j)
        if (is_digit(ch1) or ch1 == 32) and (is_digit(ch2) or ch2 == 32) {
            let start1 = nat_skip_char(s1, nat_skip_char(s1, i, l1, 32), l1, 48)
            let start2 = nat_skip_char(s2, nat_skip_char(s2, j, l2, 32), l2, 48)
            let end1 = nat_skip_digits(s1, start1, l1)
            let end2 = nat_skip_digits(s2, start2, l2)
            let lengthDiff = (end1 - start1) - (end2 - start2)
            if lengthDiff != 0 { return lengthDiff }
            let numberDiff = nat_range_cmp(s1, s2, start1, start2, end1)
            if numberDiff != 0 { return numberDiff }
            let fullLengthDiff = (end1 - i) - (end2 - j)
            if fullLengthDiff != 0 { return fullLengthDiff }
            let leadingDiff = nat_range_cmp(s1, s2, i, j, start1)
            if leadingDiff != 0 { return leadingDiff }
            i = end1 - 1
            j = end2 - 1
        } else {
            if ch1 != ch2 {
                var diff = 0
                if ch1 == 45 and ch2 != 95 {
                    diff = nat_cmp_chars(95, ch2)
                } else if ch2 == 45 and ch1 != 95 {
                    diff = nat_cmp_chars(ch1, 95)
                } else {
                    diff = nat_cmp_chars(ch1, ch2)
                }
                if diff != 0 { return diff }
            }
        }
        i += 1
        j += 1
    }
    if i < l1 { return 1 }
    if j < l2 { return 0 - 1 }
    return l1 - l2
}
fn nat_sort(list: [str]) {
    var ii = 0
    while ii < list.len() {
        var mn = ii
        var jj = ii + 1
        while jj < list.len() {
            if nat_cmp(list[jj], list[mn]) < 0 { mn = jj }
            jj += 1
        }
        if mn != ii {
            let tmp = list[ii]
            list[ii] = list[mn]
            list[mn] = tmp
        }
        ii += 1
    }
}
// list one directory, cached: "D name" for subdirs, "F name" for files
fn dir_entries(dir: str) -> [str] {
    var ci = 0
    while ci < z_dk.len() {
        if z_dk[ci] == dir { return z_dv[ci] }
        ci += 1
    }
    var dirs: [str] = []
    var files: [str] = []
    let wfd = ualloc(400)
    let hfind = win("FindFirstFileA", z_cstr(dir + "*", z_cmd), wfd)
    if hfind != -1 {
        var more = 1
        while more != 0 {
            let attr = load64(wfd) & 4294967295
            let name = read_cstr(wfd + 44)
            if (attr & 16) != 0 {
                if name != "." and name != ".." and name != ".git" { dirs.push(name) }
            } else {
                if not name.starts_with(".zide_") { files.push(name) }
            }
            more = win("FindNextFileA", hfind, wfd)
        }
        win("FindClose", hfind)
    }
    nat_sort(dirs)
    nat_sort(files)
    var out: [str] = []
    for d in dirs { out.push("D" + d) }
    for f in files { out.push("F" + f) }
    z_dk.push(dir)
    z_dv.push(out)
    return out
}
// stable widget id from a path (tree open/selection state must survive re-layout)
fn path_id(p: str) -> int {
    var h = 5381
    var i = 0
    while i < p.len() {
        h = (h * 33 + p.byte(i)) % 100000000
        i += 1
    }
    return 200000000 + h
}
// recursive Project tree (IntelliJ-style nested directories), rel is the path
// under the project root; rows record id/path/y for click + context hit tests
fn draw_tree_dir(abs: str, rel: str, depth: int) {
    if depth > 8 { return }
    let ents = dir_entries(abs)
    var i = 0
    while i < ents.len() {
        let e = ents[i]
        let nm = e.sub(1, e.len())
        if e.starts_with("D") {
            let id = path_id(rel + nm + "\\")
            let open = ui_tree_row(id, depth, nm, true, 0)
            let ds = draw_svg("folder", g_row_ix - 8, g_row_iy - 8, 16, -1)
            z_trow_ids.push(id)
            z_trow_paths.push(rel + nm + "\\")   // trailing sep marks a directory row
            z_trow_ys.push(g_row_iy)
            if open { draw_tree_dir(abs + nm + "\\", rel + nm + "\\", depth + 1) }
        } else {
            let id = path_id(rel + nm)
            let rr = ui_tree_row(id, depth, nm, false, 0)
            if not draw_svg(ftype_icon(nm), g_row_ix - 8, g_row_iy - 8, 16, -1) {
                zicon_cp(MI_FILE, g_row_ix - 8, g_row_iy - 7, rgb(140, 149, 165))
            }
            z_trow_ids.push(id)
            z_trow_paths.push(rel + nm)
            z_trow_ys.push(g_row_iy)
        }
        i += 1
    }
}
fn scan_dir() {
    var out: [str] = []
    let dir = dirname(z_path)
    let wfd = ualloc(400)
    let hfind = win("FindFirstFileA", z_cstr(dir + "*", z_cmd), wfd)
    if hfind != -1 {
        var more = 1
        while more != 0 {
            let attr = load64(wfd) & 4294967295
            if (attr & 16) == 0 {
                let name = read_cstr(wfd + 44)
                if not name.starts_with(".zide_") and out.len() < 60 { out.push(name) }
            }
            more = win("FindNextFileA", hfind, wfd)
        }
        win("FindClose", hfind)
    }
    nat_sort(out)
    z_files = out
    var ek: [str] = []            // invalidate the recursive tree cache too
    z_dk = ek
    var ev: [[str]] = []
    z_dv = ev
}

var z_maxed = false
fn z_toggle_max() {
    if z_maxed {
        win("user32!ShowWindow", g_hwnd, 9)      // SW_RESTORE
        z_maxed = false
    } else {
        win("user32!ShowWindow", g_hwnd, 3)      // SW_MAXIMIZE
        z_maxed = true
    }
}
fn z_close_glyph(x: int, y: int, c: int) {
    var i = 0
    while i < 9 {
        fill(x + i, y + i, 1, 1, c)
        fill(x + 8 - i, y + i, 1, 1, c)
        i += 1
    }
}
// custom window controls at the top-right of the toolbar; returns the x to their left
fn z_winctl(cw: int, top: int) -> int {
    let bw = 46
    if ui_flat(9701, cw - bw, 0, bw, top, "", rgb(196, 43, 28)) {
        win("user32!PostMessageA", g_hwnd, 16, 0, 0)    // WM_CLOSE
    }
    var xc = cw - bw
    var cc = COL_DIM
    if g_hot == 9701 { cc = COL_TEXT }
    z_close_glyph(xc + bw / 2 - 4, top / 2 - 4, cc)
    if ui_flat(9702, cw - bw * 2, 0, bw, top, "", COL_ITEM) { z_toggle_max() }
    frame(cw - bw * 2 + bw / 2 - 5, top / 2 - 5, 10, 10, COL_DIM)
    if ui_flat(9703, cw - bw * 3, 0, bw, top, "", COL_ITEM) {
        win("user32!ShowWindow", g_hwnd, 6)             // SW_MINIMIZE
    }
    fill(cw - bw * 3 + bw / 2 - 5, top / 2, 10, 1, COL_DIM)
    return cw - bw * 3
}

// ---- editor tabs (each open file keeps its own buffer/caret/scroll) ----
// per-document undo (IntelliJ UndoManager is per-Document): each tab keeps its
// own undo/redo stacks, saved and restored across switches instead of reset
fn tab_store() {
    if z_tabs.len() == 0 { return }
    var sl: [int] = []                       // pack selection + extra carets
    var sf = 0
    if z_sel { sf = 1 }
    sl.push(sf)
    sl.push(z_al)
    sl.push(z_ac)
    for c in z_carets { sl.push(c) }
    z_tabs[z_tab] = TabS{path: z_path, rows: z_lines, cl: z_cl, cc: z_cc, off: z_ed_off, mod: z_modified, undo: z_undo, redo: z_redo, folds: z_folds, sel: sl}
}
fn mru_touch(p: str) {
    var n: [str] = []
    n.push(p)
    for m in z_mru {
        if m != p { n.push(m) }
    }
    z_mru = n
}
fn switcher_list() -> [int] {               // tab indexes in MRU order
    var out: [int] = []
    for m in z_mru {
        var ti = 0
        while ti < z_tabs.len() {
            if z_tabs[ti].path == m {
                var seen = false
                for o in out {
                    if o == ti { seen = true }
                }
                if not seen { out.push(ti) }
            }
            ti += 1
        }
    }
    var t2 = 0
    while t2 < z_tabs.len() {               // tabs never touched yet go last
        var seen2 = false
        for o in out {
            if o == t2 { seen2 = true }
        }
        if not seen2 { out.push(t2) }
        t2 += 1
    }
    return out
}
fn switcher_commit() {
    let lst = switcher_list()
    if lst.len() == 0 { return }
    var k = z_swi_sel % lst.len()
    if k < 0 { k += lst.len() }
    let target = lst[k]
    if target != z_tab {
        tab_store()
        tab_load(target)
        run_diagnostics()
    }
}
// record the current caret position (called BEFORE a navigation jump)
fn push_loc() {
    if z_path == "" { return }
    var txt = ""
    if z_cl < z_lines.len() { txt = z_lines[z_cl].trim() }
    if txt.len() > 52 { txt = txt.sub(0, 52) + "..." }
    var np: [str] = []
    var nl: [int] = []
    var nv: [str] = []
    np.push(z_path)
    nl.push(z_cl)
    nv.push(txt)
    var i = 0
    while i < z_locs_path.len() and np.len() < 20 {
        if not (z_locs_path[i] == z_path and z_locs_line[i] == z_cl) {
            np.push(z_locs_path[i])
            nl.push(z_locs_line[i])
            nv.push(z_locs_prev[i])
        }
        i += 1
    }
    z_locs_path = np
    z_locs_line = nl
    z_locs_prev = nv
}
fn push_recent(path: str) {
    if path == "" { return }
    var n: [str] = []
    n.push(path)
    for r in z_recent {
        if r != path and n.len() < 15 { n.push(r) }
    }
    z_recent = n
}
// New Scratch File (NewScratchFileAction port): an untitled buffer as a tab
fn scratch_new() {
    tab_store()
    z_tabs.push(TabS.new("", [""]))
    tab_load(z_tabs.len() - 1)
    notify("New scratch buffer")
}
fn tab_load(i: int) {
    z_tab = i
    let t = z_tabs[i]
    push_recent(t.path)
    mru_touch(t.path)
    z_path = t.path
    z_lines = t.rows
    z_cl = t.cl
    z_cc = t.cc
    z_ed_off = t.off
    z_modified = t.mod
    z_undo = t.undo           // per-document state now travels with the tab
    z_redo = t.redo
    z_folds = t.folds
    let sl = t.sel
    var nc: [int] = []
    z_sel = false
    if sl.len() >= 3 {
        z_sel = sl[0] == 1
        z_al = sl[1]
        z_ac = sl[2]
        var ci = 3
        while ci < sl.len() {
            nc.push(sl[ci])
            ci += 1
        }
    }
    z_carets = nc
    build_vis()
    comp_hide()
}
// ---- session persistence (IntelliJ reopens your workspace): tabs + carets +
// bookmarks + breakpoints, saved on every workspace change, restored on bare launch
fn session_path() -> str { return exe_dir() + ".zide_session" }
fn session_save() {
    var out: [str] = []
    tab_store()
    var i = 0
    while i < z_tabs.len() {
        let t = z_tabs[i]
        if t.path != "" and not t.path.starts_with("remote:") {
            out.push("tab|" + t.path + "|" + (t.cl as str) + "|" + (t.cc as str))
        }
        i += 1
    }
    out.push("active|" + (z_tab as str))
    for b in z_bookmarks { out.push("bm|" + b) }
    for b2 in z_breaks { out.push("bp|" + b2) }
    write_file(session_path(), join_nl(out))
}
fn session_restore() -> bool {
    if not path_exists(session_path()) { return false }
    let body = normalize_newlines(read_file(session_path()))
    var act = 0
    var count = 0
    for ln in body.split("\n") {
        if ln.starts_with("tab|") {
            let ps = ln.split("|")
            if ps.len() == 4 and path_exists(ps[1]) {
                var rows2: [str] = []
                for rl in normalize_newlines(read_file(ps[1])).split("\n") { rows2.push(rl) }
                if rows2.len() == 0 { rows2.push("") }
                var scl = ps[2] as int
                if scl > rows2.len() - 1 { scl = rows2.len() - 1 }
                if scl < 0 { scl = 0 }
                var rt = TabS.new(ps[1], rows2)
                rt.cl = scl
                rt.cc = ps[3] as int
                z_tabs.push(rt)
                count += 1
            }
        } else if ln.starts_with("active|") {
            act = ln.sub(7, ln.len()) as int
        } else if ln.starts_with("bm|") {
            z_bookmarks.push(ln.sub(3, ln.len()))
        } else if ln.starts_with("bp|") {
            z_breaks.push(ln.sub(3, ln.len()))
        }
    }
    if count == 0 { return false }
    if act > count - 1 { act = 0 }
    if act < 0 { act = 0 }
    tab_load(act)
    clamp_col()
    return true
}
fn open_file(path: str) {
    var i = 0
    while i < z_tabs.len() {
        if z_tabs[i].path == path {
            tab_store()
            tab_load(i)
            run_diagnostics()
            session_save()
            return
        }
        i += 1
    }
    tab_store()
    z_tabs.push(TabS.new(path, [""]))
    tab_load(z_tabs.len() - 1)
    set_content(read_file(path))
    z_path = path
    z_modified = false
    scan_dir()
    run_diagnostics()
    session_save()
}
fn close_tab(i: int) {
    tab_store()
    var n: [TabS] = []
    var k = 0
    while k < z_tabs.len() {
        if k != i { n.push(z_tabs[k]) }
        k += 1
    }
    z_tabs = n
    if z_tabs.len() == 0 {
        z_tabs.push(TabS.new("", [""]))
    }
    var j = z_tab
    if i < j { j -= 1 }
    if j > z_tabs.len() - 1 { j = z_tabs.len() - 1 }
    tab_load(j)
    run_diagnostics()
    session_save()
}

// ---- buffer symbols (Structure tool window + Search Everywhere) ----
// ---- parser: recursive-descent over the lexer's token stream (PSI analogue) ----
fn kw_kind(w: str) -> int {
    if w == "fn" { return 1 }
    if w == "struct" { return 2 }
    if w == "enum" { return 3 }
    if w == "let" or w == "var" or w == "const" { return 4 }
    return 0
}
// build the declaration tree from tokens: real fn/struct/enum nodes with brace
// depth. Braces inside strings/comments are lexed as STRING/COMMENT, so depth is
// accurate and a keyword inside a literal is never mistaken for a declaration.
var z_psi_cache: [PsiNode] = []
var z_psi_seq = 0 - 2
// PSI tree, cached per edit — this runs from per-frame consumers (nav bar,
// folding, structure), so an uncached full-buffer lex here OOMs on big files
fn parse_decls() -> [PsiNode] {
    if z_psi_seq == z_edit_seq { return z_psi_cache }
    var nodes: [PsiNode] = []
    var depth = 0
    var struct_field_depth = 0 - 1     // brace depth at which struct fields live, or -1
    var li = 0
    while li < z_lines.len() {
        let s = z_lines[li]
        let toks = lex_line(s)
        var fi = 0
        while fi < toks.len() and toks[fi].kind == TK_WS { fi += 1 }
        var emitted_struct = false
        if fi < toks.len() and toks[fi].kind == TK_WORD {
            let w0 = s.sub(toks[fi].a, toks[fi].b)
            let k = kw_kind(w0)
            if k != 0 {
                var ni = fi + 1
                while ni < toks.len() and toks[ni].kind == TK_WS { ni += 1 }
                var nm = ""
                if ni < toks.len() and toks[ni].kind == TK_WORD { nm = s.sub(toks[ni].a, toks[ni].b) }
                nodes.push(PsiNode{kind: k, name: nm, line: li, depth: depth})
                if k == 2 { emitted_struct = true }
            } else if struct_field_depth >= 0 and depth == struct_field_depth {
                // inside a struct body: `ident : type` is a field member
                var ni = fi + 1
                while ni < toks.len() and toks[ni].kind == TK_WS { ni += 1 }
                if ni < toks.len() and toks[ni].kind == TK_OP and s.byte(toks[ni].a) == 58 {
                    nodes.push(PsiNode{kind: 5, name: w0, line: li, depth: depth})
                }
            }
        }
        var ti = 0
        while ti < toks.len() {
            let t = toks[ti]
            if t.kind == TK_OP {
                let c = s.byte(t.a)
                if c == 123 { depth += 1 }
                if c == 125 { depth -= 1 }
            }
            ti += 1
        }
        if emitted_struct {
            struct_field_depth = depth                 // body depth after the opening brace
        } else if struct_field_depth >= 0 and depth < struct_field_depth {
            struct_field_depth = 0 - 1                  // struct body closed
        }
        li += 1
    }
    z_psi_cache = nodes
    z_psi_seq = z_edit_seq
    return nodes
}
// error-tolerant structural analysis (PSI error-element analogue): report brace
// imbalance from the token stream, live, without waiting on the compiler. Braces
// inside strings/comments are lexed away, so they never produce false errors.
fn lint_structure() -> [Diag] {
    var diags: [Diag] = []
    var stack: [int] = []                   // lines of currently-open '{'
    var idc: [str: int] = [:]               // identifier occurrence counts (one pass)
    var li = 0
    while li < z_lines.len() {
        let s = z_lines[li]
        let toks = lex_line(s)
        var ti = 0
        while ti < toks.len() {
            let t = toks[ti]
            if t.kind == TK_OP {
                let c = s.byte(t.a)
                if c == 123 {
                    stack.push(li)
                } else if c == 125 {
                    if stack.len() == 0 {
                        diags.push(Diag{line: li, msg: "unmatched '\}'", sev: 0})
                    } else {
                        let _pop = stack.pop()
                    }
                }
            } else if t.kind == TK_WORD {
                let w = s.sub(t.a, t.b)
                if idc.has(w) { idc[w] = idc[w] + 1 } else { idc[w] = 1 }
            }
            ti += 1
        }
        li += 1
    }
    var k = 0
    while k < stack.len() {
        diags.push(Diag{line: stack[k], msg: "unclosed '\{'", sev: 0})
        k += 1
    }
    // malformed declarations: a fn/struct/enum keyword with no name after it
    let nodes = parse_decls()
    var di = 0
    while di < nodes.len() {
        if nodes[di].name == "" {
            var what = "declaration"
            if nodes[di].kind == 1 { what = "function" }
            if nodes[di].kind == 2 { what = "struct" }
            if nodes[di].kind == 3 { what = "enum" }
            diags.push(Diag{line: nodes[di].line, msg: what + " needs a name", sev: 0})
        }
        di += 1
    }
    // unused-declaration inspection (file-local, IntelliJ unused-symbol analogue):
    // a top-level fn/variable whose name appears only at its own declaration
    var du = 0
    while du < nodes.len() {
        let nd = nodes[du]
        if nd.depth == 0 and nd.name != "" and nd.kind >= 1 and nd.kind <= 4 {
            if nd.name != "main" and not nd.name.starts_with("_") {
                var uses = 0
                if idc.has(nd.name) { uses = idc[nd.name] }
                if uses <= 1 {
                    var what2 = "fn"
                    if nd.kind == 2 { what2 = "struct" }
                    if nd.kind == 3 { what2 = "enum" }
                    if nd.kind == 4 { what2 = "variable" }
                    diags.push(Diag{line: nd.line, msg: what2 + " '" + nd.name + "' is never used", sev: 1})
                }
            }
        }
        du += 1
    }
    // duplicate top-level declarations: the second definition is an error, live
    var seen: [str: int] = [:]
    var dd = 0
    while dd < nodes.len() {
        let nd2 = nodes[dd]
        if nd2.depth == 0 and nd2.name != "" {
            if seen.has(nd2.name) {
                diags.push(Diag{line: nd2.line, msg: "duplicate definition of '" + nd2.name + "'", sev: 0})
            } else {
                seen[nd2.name] = 1
            }
        }
        dd += 1
    }
    // unreachable code after return (IntelliJ UnreachableCode analogue): the
    // first statement following a `return` in the same block never executes
    var ur = 0
    while ur < z_lines.len() {
        let rt = z_lines[ur].trim()
        if rt == "return" or rt.starts_with("return ") {
            var ind = 0
            while ind < z_lines[ur].len() and z_lines[ur].byte(ind) == 32 { ind += 1 }
            var nx = ur + 1
            while nx < z_lines.len() and z_lines[nx].trim() == "" { nx += 1 }
            if nx < z_lines.len() {
                let nt = z_lines[nx].trim()
                var nind = 0
                while nind < z_lines[nx].len() and z_lines[nx].byte(nind) == 32 { nind += 1 }
                if not nt.starts_with("\}") and nind >= ind {
                    diags.push(Diag{line: nx, msg: "unreachable code", sev: 1})
                }
            }
        }
        ur += 1
    }
    // self-assignment (IntelliJ SillyAssignmentInspection): `x = x` has no effect
    var sa = 0
    while sa < z_lines.len() {
        let stoks = lex_line(z_lines[sa])
        var nz: [Tok] = []                   // non-whitespace tokens only
        for t2 in stoks {
            if t2.kind != TK_WS { nz.push(t2) }
        }
        if nz.len() == 3 and nz[0].kind == TK_WORD and nz[2].kind == TK_WORD and nz[1].kind == TK_OP {
            let op = z_lines[sa].sub(nz[1].a, nz[1].b)
            let lhs = z_lines[sa].sub(nz[0].a, nz[0].b)
            let rhs = z_lines[sa].sub(nz[2].a, nz[2].b)
            if op == "=" and lhs == rhs {
                diags.push(Diag{line: sa, msg: "'" + lhs + "' is assigned to itself", sev: 1})
            }
        }
        sa += 1
    }
    return diags
}
fn scan_symbols() {
    if z_sym_seq == z_edit_seq { return }
    var names: [str] = []
    var lns: [int] = []
    var kinds: [int] = []
    let nodes = parse_decls()
    var i = 0
    while i < nodes.len() {
        let nd = nodes[i]
        // top-level variables only (kind 4); locals inside a function stay out
        if nd.kind == 4 and nd.depth > 0 {
            i += 1
            continue
        }
        var sig = z_lines[nd.line].trim()
        let brace = sig.index_of("\{")
        if brace > 0 { sig = sig.sub(0, brace).trim() }
        if sig.len() > 46 { sig = sig.sub(0, 46) + "..." }
        if nd.kind == 5 { sig = "    " + sig }        // struct field: nested under its struct
        names.push(sig)
        lns.push(nd.line)
        kinds.push(nd.kind)
        i += 1
    }
    z_sym_names = names
    z_sym_lines = lns
    z_sym_kinds = kinds
    z_sym_seq = z_edit_seq
}
fn sym_icon(kind: int) -> int {
    if kind == 1 { return ui_icon(5, rgb(86, 168, 245)) }     // fn: blue dot
    if kind == 2 { return ui_icon(5, rgb(152, 118, 170)) }    // struct: purple
    if kind == 4 { return ui_icon(5, rgb(150, 130, 90)) }     // top-level var: gold field dot
    if kind == 5 { return ui_icon(5, rgb(130, 150, 175)) }    // struct field: slate dot
    return ui_icon(5, rgb(66, 177, 164))                      // enum: teal
}

// ---- Search Everywhere (double-Shift) ----
fn se_open() {
    z_popup = 8
    z_popup_frame = g_frame
    z_se_q = ""
    z_se_sel = 0
    z_se_tab = 0
    scan_symbols()
}
// camel-hump word start, ported from IntelliJ NameUtilCore.isWordStart
fn is_word_start(name: str, i: int) -> bool {
    if i == 0 { return true }
    let cur = name.byte(i)
    let prev = name.byte(i - 1)
    if is_alnum(cur) and not is_alnum(prev) { return true }
    if cur >= 65 and cur <= 90 and prev >= 97 and prev <= 122 { return true }   // aB hump
    if cur >= 48 and cur <= 57 and not (prev >= 48 and prev <= 57) { return true } // digit start
    return false
}
// port of MinusculeMatcher: subsequence match preferring word starts, IntelliJ scoring weights
fn se_score(hay: str) -> int {
    if z_se_q == "" { return 0 }
    let h = hay.lower()
    let q = z_se_q.lower()
    var matched: [int] = []
    var j = 0
    var qi = 0
    while qi < q.len() {
        let pc = q.byte(qi)
        var best = -1
        var anyp = -1
        var k = j
        while k < h.len() {
            if h.byte(k) == pc {
                if anyp < 0 { anyp = k }
                if is_word_start(hay, k) {
                    best = k
                    k = h.len()
                } else {
                    k += 1
                }
            } else {
                k += 1
            }
        }
        var pos = best
        if pos < 0 { pos = anyp }
        if pos < 0 { return SE_NOMATCH }
        matched.push(pos)
        j = pos + 1
        qi += 1
    }
    let first = matched[0]
    let last = matched[matched.len() - 1]
    var score = 0
    if first == 0 or (is_word_start(hay, first) and not is_word_start(hay, first - 1)) { score += 1000 }
    var frags = 1
    var m = 1
    while m < matched.len() {
        if matched[m] != matched[m - 1] + 1 { frags += 1 }
        m += 1
    }
    score -= frags
    var ci = 0
    while ci < matched.len() {
        let ni = matched[ci]
        let pcu = z_se_q.byte(ci)
        let ncu = hay.byte(ni)
        let hump = is_word_start(hay, ni)
        if pcu >= 65 and pcu <= 90 and pcu == ncu {
            if ni == 0 { score += 150 } else { score += 50 }
        } else if hump {
            score += 1
        }
        ci += 1
    }
    var skipped = 0
    var s = first
    while s <= last {
        if is_word_start(hay, s) {
            var found = false
            var t = 0
            while t < matched.len() {
                if matched[t] == s { found = true }
                t += 1
            }
            if not found { skipped += 1 }
        }
        s += 1
    }
    score -= skipped * 10
    if first == 0 { score += 1 }
    if last == hay.len() - 1 { score += 1 }
    var sep = false
    var u = 0
    while u < first {
        let cc = hay.byte(u)
        if cc == 32 or cc == 47 or cc == 92 or cc == 46 or cc == 95 { sep = true }
        u += 1
    }
    if not sep { score += 2 }
    return score
}
fn se_match(hay: str) -> bool { return se_score(hay) > SE_NOMATCH }
fn se_exec(kind: int, val: int) {
    z_popup = 0
    if kind == 1 {
        let f = z_files[val]
        if f.ends_with(".zeph") {
            open_file(dirname(z_path) + f)
        } else {
            notify("Only .zeph files open in the editor")
        }
    }
    if kind == 2 {
        push_loc()
        z_cl = z_sym_lines[val]
        z_cc = 0
        ensure_caret()
    }
    if kind == 3 { act_exec(val) }
    if kind == 4 { run_plugin(z_plugins[val]) }   // plugin action
}
// dispatch one Find Action registry entry (indexes match SE_ACTIONS)
fn act_exec(val: int) {
    if val == 0 {
        do_save()
        notify("Saved " + z_path)
    }
    if val == 1 { do_run() }
    if val == 2 { dbg_start() }
    if val == 3 {
        open_find()
        z_replace_on = false
    }
    if val == 4 {
        open_find()
        z_replace_on = true
        z_find_field = 0
    }
    if val == 5 {
        z_popup = 16
        z_popup_frame = g_frame
        z_fif_for = "\n"
        z_focus = 0
    }
    if val == 6 {
        z_new_parent = ""
        open_dialog(1, "", "")
    }
    if val == 7 { open_dialog(4, "", "") }
    if val == 8 {
        let w = caret_word()
        if w != "" { open_dialog(5, w, w) }
    }
    if val == 9 { goto_decl(caret_word()) }
    if val == 10 { find_usages(caret_word()) }
    if val == 11 {
        z_popup = 9
        z_popup_frame = g_frame
        z_recent_sel = 0
    }
    if val == 12 { toggle_bookmark() }
    if val == 13 { goto_error(1) }
    if val == 14 { goto_error(0 - 1) }
    if val == 15 { dup_line() }
    if val == 16 { del_line() }
    if val == 17 { toggle_comment() }
    if val == 18 { move_line(0 - 1) }
    if val == 19 { move_line(1) }
    if val == 20 { join_lines_action() }
    if val == 21 { toggle_case() }
    if val == 22 { fold_all() }
    if val == 23 { unfold_all() }
    if val == 24 { reformat() }
    if val == 25 { select_word_expand() }
    if val == 26 { do_undo() }
    if val == 27 { do_select_all() }
    if val == 28 {
        z_qdoc_word = caret_word()
        z_qdoc = qdoc_for(z_qdoc_word)
        z_popup = 11
        z_popup_frame = g_frame
    }
    if val == 29 { show_dock(3) }
    if val == 30 { show_dock(4) }
    if val == 31 {
        z_chat_on = true
        z_focus = 1
    }
    if val == 32 { z_popup_toggle(2) }
    if val == 33 { z_popup_toggle(3) }
    if val == 34 { win("user32!DestroyWindow", g_hwnd) }
    if val == 35 { z_pinfo = true }
    if val == 36 {
        z_popup = 19
        z_popup_frame = g_frame
        z_locs_sel = 0
    }
    if val == 37 {
        se_open()
        z_se_tab = 1
    }
    if val == 38 {
        se_open()
        z_se_tab = 2
    }
    if val == 39 {
        z_proj_on = true
        z_left_mode = 0
    }
    if val == 40 {
        z_proj_on = true
        z_left_mode = 1
    }
    if val == 41 { hide_all_toggle() }
    if val == 42 {                           // Split Right: MRU-previous tab beside this one
        var pick = 0 - 1
        let lst = switcher_list()
        var k = 0
        while k < lst.len() {
            if lst[k] != z_tab and pick < 0 { pick = lst[k] }
            k += 1
        }
        if pick >= 0 {
            z_split = pick
            z_split_off = 0
            z_pane = 0
        } else {
            notify("Open a second file to split")
        }
    }
    if val == 43 { z_split = -1 }            // Unsplit
    if val == 44 { do_redo() }
    if val == 45 {
        if z_sel and z_al == z_cl {
            open_dialog(8, sel_text(), "value")
        } else {
            notify("Select an expression on one line first")
        }
    }
    if val == 46 { inline_var() }
    if val == 47 { safe_delete() }
    if val == 48 {
        if z_sel {
            open_dialog(9, "", "extracted")
        } else {
            notify("Select the lines to extract first")
        }
    }
    if val == 49 {
        if z_sel {
            z_popup = 21
            z_popup_frame = g_frame
        } else {
            notify("Select the lines to surround first")
        }
    }
    if val == 50 {
        set_clipboard(shownname() + ":" + ((z_cl + 1) as str))
        notify("Copied reference " + shownname() + ":" + ((z_cl + 1) as str))
    }
    if val == 51 { move_statement(0 - 1) }
    if val == 52 { move_statement(1) }
    if val == 53 { close_tab(z_tab) }
    if val == 54 {
        if z_tabs.len() > 1 {
            tab_store()
            tab_load((z_tab + 1) % z_tabs.len())
            run_diagnostics()
        }
    }
    if val == 55 {
        if z_tabs.len() > 1 {
            tab_store()
            tab_load((z_tab + z_tabs.len() - 1) % z_tabs.len())
            run_diagnostics()
        }
    }
    if val == 56 { rollback_lines() }
    if val == 57 {
        if z_base.len() > 0 {
            open_diff(z_base, "Changes vs HEAD")
        } else {
            notify("No VCS baseline for this file")
        }
    }
    if val == 58 {
        if z_clips.len() > 0 {
            z_popup = 22
            z_popup_frame = g_frame
            z_clip_sel = 0
        } else {
            notify("Clipboard history is empty")
        }
    }
    if val == 59 {
        if z_lastedit_l >= 0 {
            push_loc()
            if z_lastedit_path != z_path and z_lastedit_path != "" { open_file(z_lastedit_path) }
            z_cl = z_lastedit_l
            if z_cl > z_lines.len() - 1 { z_cl = z_lines.len() - 1 }
            z_cc = z_lastedit_c
            clamp_col()
            ensure_caret()
        }
    }
    if val == 60 {
        set_clipboard(z_path)
        notify("Copied path " + z_path)
    }
    if val == 61 { scratch_new() }
    if val == 62 { smart_enter() }
    if val == 63 { unwrap_block() }
    if val == 64 { quick_def() }
    if val == 65 {
        let clip = get_clipboard()
        if clip.len() > 0 {
            open_diff(normalize_newlines(clip).split("\n"), "vs Clipboard")
        } else {
            notify("Clipboard is empty")
        }
    }
    if val == 66 {
        z_show_ws = not z_show_ws
        if z_show_ws { notify("Whitespaces shown") } else { notify("Whitespaces hidden") }
    }
    if val == 67 {
        se_open()
        z_se_tab = 2
    }
    if val == 68 { hl_set() }
    if val == 69 { add_next_occurrence() }
    if val == 70 { select_all_occurrences() }
    if val == 71 { optimize_imports() }
    if val == 72 { code_block_nav(false) }
    if val == 73 { code_block_nav(true) }
    if val == 74 { nav_back() }
    if val == 75 { nav_forward() }
    if val == 76 {
        if z_sel and z_al == z_cl {
            open_dialog(11, "", "CONST")
        } else {
            notify("Select an expression on one line first")
        }
    }
    if val == 77 { qf_open() }
}

// commit the active file dialog (popup 7): create / rename / delete
fn input_commit() {
    let base2 = dirname(z_path)
    if z_input_mode == 1 {
        let nm = z_input_q.trim()
        if nm != "" {
            write_file(base2 + z_new_parent + nm, "")
            notify("Created " + z_new_parent + nm)
            scan_dir()
            if nm.ends_with(".zeph") { open_file(base2 + z_new_parent + nm) }
        }
    }
    if z_input_mode == 10 {                  // New Folder
        let nm = z_input_q.trim()
        if nm != "" {
            win("CreateDirectoryA", z_cstr(base2 + z_new_parent + nm, z_pathbuf), 0)
            notify("Created folder " + z_new_parent + nm)
            scan_dir()
        }
    }
    if z_input_mode == 2 {
        let nm = z_input_q.trim()
        var tp = z_input_target             // preserve the containing folder on rename
        if tp.ends_with("\\") { tp = tp.sub(0, tp.len() - 1) }
        let pdir = dirname(tp)
        if nm != "" and nm != reltail(z_input_target) {
            win("MoveFileA", z_cstr(base2 + tp, z_cmd), z_cstr(base2 + pdir + nm, z_cwd))
            if z_path == base2 + tp { z_path = base2 + pdir + nm }
            notify("Renamed to " + nm)
            scan_dir()
        }
    }
    if z_input_mode == 3 {
        if z_input_target.ends_with("\\") {
            let dp = z_input_target.sub(0, z_input_target.len() - 1)
            win("RemoveDirectoryA", z_cstr(base2 + dp, z_pathbuf))   // empty dirs only
        } else {
            win("DeleteFileA", z_cstr(base2 + z_input_target, z_pathbuf))
            if z_path == base2 + z_input_target {
                set_content("")
                z_path = ""
            }
        }
        notify("Deleted " + z_input_target)
        scan_dir()
    }
    if z_input_mode == 5 {                   // Rename symbol (Shift+F6)
        rename_scoped(z_input_target, z_input_q.trim())
    }
    if z_input_mode == 6 {                   // Remote host  (user@host:dir)
        let v = z_input_q.trim()
        let ci = v.index_of(":")
        if ci > 0 {
            z_remote = v.sub(0, ci)
            z_remote_dir = v.sub(ci + 1, v.len())
        } else {
            z_remote = v
            z_remote_dir = "."
        }
        notify("Remote host set: " + z_remote)
    }
    if z_input_mode == 7 {                   // Open remote file
        remote_open(z_input_q.trim())
    }
    if z_input_mode == 8 {                   // Introduce Variable (Ctrl+Alt+V)
        introduce_var(z_input_target, z_input_q.trim())
    }
    if z_input_mode == 9 {                   // Extract Function (Ctrl+Alt+M)
        extract_fn(z_input_q.trim())
    }
    if z_input_mode == 11 {                  // Extract Constant (Ctrl+Alt+C)
        extract_const(z_input_q.trim())
    }
    if z_input_mode == 4 {                   // Go to Line[:Column] (IntelliJ accepts 12:5)
        var lpart = z_input_q.trim()
        var cpart = ""
        let ci = lpart.index_of(":")
        if ci >= 0 {
            cpart = lpart.sub(ci + 1, lpart.len())
            lpart = lpart.sub(0, ci)
        }
        var ok2 = lpart.len() > 0
        var vi = 0
        while vi < lpart.len() {
            if not is_digit(lpart.byte(vi)) { ok2 = false }
            vi += 1
        }
        vi = 0
        while vi < cpart.len() {
            if not is_digit(cpart.byte(vi)) { ok2 = false }
            vi += 1
        }
        if ok2 {
            var ln2 = lpart as int - 1
            if ln2 < 0 { ln2 = 0 }
            if ln2 > z_lines.len() - 1 { ln2 = z_lines.len() - 1 }
            z_cl = ln2
            z_cc = 0
            if cpart.len() > 0 {
                z_cc = cpart as int - 1
                if z_cc < 0 { z_cc = 0 }
            }
            clamp_col()
            ensure_caret()
        }
    }
    z_input_mode = 0
    z_popup = 0
}
fn open_dialog(mode: int, target: str, prefill: str) {
    z_input_mode = mode
    z_input_target = target
    z_input_q = prefill
    z_popup = 7
    z_popup_frame = g_frame
}

fn z_popup_toggle(k: int) {
    if z_popup == k {
        z_popup = 0
    } else {
        z_popup = k
        z_popup_frame = g_frame
        if k == 4 { z_notif_unread = false }
    }
}

// ---- popups (immediate-mode overlays; drawn last, closed by Esc / outside click) ----
// menu row with an optional leading action icon (JetBrains menus show one per item)
fn menu_row_i(id: int, x: int, y: int, w: int, label: str, hint: str, cp: int) -> bool {
    let clicked = ui_flat(id, x + 4, y, w - 8, 26, "", COL_ITEM)
    var lx = x + 14
    if cp != 0 {
        zicon_cp(cp, x + 12, y + 5, COL_DIM)
        lx = x + 38
    }
    dtext_v(lx, y, 26, label, COL_TEXT)
    if hint.len() > 0 {
        dtext(x + w - 14 - text_w(hint), y + 6, hint, COL_FAINT)
    }
    return clicked
}
// ActionGroup analogue: a menu is DATA (parallel label/hint/icon lists, "-" =
// separator), rendered by one builder that returns the clicked index or -1.
fn menu_group_h(labels: [str]) -> int {
    var h = 12
    for l in labels {
        if l == "-" { h += 9 } else { h += 28 }
    }
    return h
}
fn menu_group(idbase: int, x: int, y: int, w: int, labels: [str], keys: [str], icons: [int]) -> int {
    ui_vstrip_begin(y + 6)
    var hit = 0 - 1
    var i = 0
    while i < labels.len() {
        if labels[i] == "-" {
            let sy = ui_vstrip_slot(9, 0)
            fill(x + 10, sy + 4, w - 20, 1, COL_BORDER)
        } else {
            if menu_row_i(idbase + i, x, ui_vstrip_slot(28, 0), w, labels[i], keys[i], icons[i]) { hit = i }
        }
        i += 1
    }
    return hit
}
fn menu_row(id: int, x: int, y: int, w: int, label: str, hint: str) -> bool {
    return menu_row_i(id, x, y, w, label, hint, 0)
}
// popup styling tokens (named once; radius + shadow offset)
let POP_R = 14
let POP_SHADOW = rgb(20, 21, 23)
fn popup_frame(x: int, y: int, w: int, h: int) {
    fill_rr(x + 3, y + 4, w, h, POP_R, POP_SHADOW)        // soft shadow
    fill_rr(x, y, w, h, POP_R, COL_PANEL)
    frame_rr(x, y, w, h, POP_R, COL_OUTLINE)
}
fn close_outside(x: int, y: int, w: int, h: int) {
    if g_press and g_frame != z_popup_frame and not hit(x, y, w, h) { z_popup = 0 }
}
fn draw_popups(cw: int, ch: int) {
    if z_popup == 1 {                       // main menu (burger / more-dots)
        let mw = 230
        let mx = 8
        let my = 40
        let mh = 12 * 28 + 12
        popup_frame(mx, my, mw, mh)
        ui_vstrip_begin(my + 6)
        if menu_row_i(9701, mx, ui_vstrip_slot(28, 0), mw, "New File", "", MI_FILE) {
            set_content("")
            z_path = ""
            z_modified = false
            scan_dir()
            z_popup = 0
        }
        if menu_row_i(9702, mx, ui_vstrip_slot(28, 0), mw, "Save", "Ctrl+S", MI_CHECK) {
            do_save()
            notify("Saved " + z_path)
            scan_dir()
            z_popup = 0
        }
        if menu_row_i(9703, mx, ui_vstrip_slot(28, 0), mw, "Find", "Ctrl+F", MI_SEARCH) {
            open_find()
            z_popup = 0
        }
        if menu_row_i(9704, mx, ui_vstrip_slot(28, 0), mw, "Run", "F5", MI_PLAY) {
            z_popup = 0
            do_run()
        }
        if menu_row_i(9705, mx, ui_vstrip_slot(28, 0), mw, "Claude Chat", "F2", MI_BOT) {
            z_chat_on = not z_chat_on
            if z_chat_on { z_focus = 1 }
            z_popup = 0
        }
        if menu_row_i(9707, mx, ui_vstrip_slot(28, 0), mw, "Local History", "", MI_COMMIT) {
            z_hist_sel = 0
            z_popup = 13
            z_popup_frame = g_frame
        }
        if menu_row(9708, mx, ui_vstrip_slot(28, 0), mw, "Diff with Saved", "") {
            z_popup = 0
            if z_path != "" and path_exists(z_path) {
                var ref: [str] = []
                for rl in read_file(z_path).split("\n") { ref.push(strip_cr(rl)) }
                open_diff(ref, "Saved on disk")
            }
        }
        if menu_row(9709, mx, ui_vstrip_slot(28, 0), mw, "Profile", "") {
            z_popup = 0
            prof_start()
        }
        if menu_row(9710, mx, ui_vstrip_slot(28, 0), mw, "Plugins", "") {
            scan_plugins()
            z_popup = 15
            z_popup_frame = g_frame
        }
        if menu_row(9711, mx, ui_vstrip_slot(28, 0), mw, "Remote Host", "") {
            open_dialog(6, "", z_remote)
        }
        if menu_row(9712, mx, ui_vstrip_slot(28, 0), mw, "Open Remote File", "") {
            if z_remote == "" { open_dialog(6, "", "") } else { open_dialog(7, "", "") }
        }
        if menu_row(9706, mx, ui_vstrip_slot(28, 0), mw, "Exit", "") {
            win("user32!DestroyWindow", g_hwnd)
        }
        close_outside(mx, my, mw, mh)
    }
    if z_popup == 2 {                       // settings
        let sw = 340
        let sh = 150
        let sx = (cw - sw) / 2
        let sy = (ch - sh) / 2
        popup_frame(sx, sy, sw, sh)
        let sb = ui_selectb()
        dtext(sx + 16, sy + 12, "Settings", COL_TEXT)
        ui_selectn()
        dtext(sx + 16, sy + 48, "Editor font size", COL_DIM)
        if ui_abtn(9711, sx + 190, sy + 42, 30, 26, "-") { set_font_px(z_fontpx - 1) }
        dtext_c(sx + 224, sy + 42, 40, 26, "{z_fontpx}", COL_TEXT)
        if ui_abtn(9712, sx + 268, sy + 42, 30, 26, "+") { set_font_px(z_fontpx + 1) }
        dtext(sx + 16, sy + 84, "Theme", COL_DIM)
        dtext(sx + 190, sy + 84, "Dark (New UI)", COL_TEXT)
        dtext(sx + 16, sy + 116, "Font", COL_DIM)
        dtext(sx + 190, sy + 116, z_monoface, COL_TEXT)
        close_outside(sx, sy, sw, sh)
    }
    if z_popup == 3 {                       // about
        let aw = 380
        let ah = 168
        let ax = (cw - aw) / 2
        let ay = (ch - ah) / 2
        popup_frame(ax, ay, aw, ah)
        fill_rr(ax + 16, ay + 16, 34, 34, 10, rgb(90, 120, 220))
        dtext_c(ax + 16, ay + 16, 34, 34, "Z", COL_TEXT)
        let sb = ui_selectb()
        dtext(ax + 62, ay + 18, "Zide 1.0", COL_TEXT)
        ui_selectn()
        dtext(ax + 62, ay + 38, "The Zephyr IDE, written in Zephyr", COL_DIM)
        dtext(ax + 16, ay + 70, "Compiler", COL_FAINT)
        dtext(ax + 100, ay + 70, z_zc, COL_DIM)
        dtext(ax + 16, ay + 92, "Claude", COL_FAINT)
        var cst = "not found"
        if z_claude != "" { cst = "connected" }
        dtext(ax + 100, ay + 92, cst, COL_DIM)
        dtext(ax + 16, ay + 114, "Imports", COL_FAINT)
        dtext(ax + 100, ay + 114, "kernel32, user32, gdi32 - no C runtime", COL_DIM)
        dtext(ax + 16, ay + 140, "Shortcuts", COL_FAINT)
        dtext(ax + 100, ay + 140, "Ctrl+S save  Ctrl+F find  F5 run  F2 Claude", COL_DIM)
        close_outside(ax, ay, aw, ah)
    }
    if z_popup == 11 { draw_qdoc(cw, ch) }  // quick documentation (Ctrl+Q)
    if z_popup == 15 {                      // Plugins
        let sw = 380
        let sx = (cw - sw) / 2
        let sy = 100
        var pn = z_plugins.len()
        if pn == 0 { pn = 1 }
        let phh = 40 + pn * 26 + 10
        popup_frame(sx, sy, sw, phh)
        let sb = ui_selectb()
        dtext(sx + 16, sy + 10, "Plugins", COL_TEXT)
        ui_selectn()
        var ry = sy + 36
        var i = 0
        while i < z_plugins.len() {
            if ui_flat(9880 + i, sx + 6, ry, sw - 12, 26, "", COL_ITEM) {
                z_popup = 0
                run_plugin(z_plugins[i])
            }
            zicon_cp(MI_GEAR, sx + 16, ry + 5, rgb(150, 180, 220))
            dtext(sx + 40, ry + 5, z_plugins[i], COL_TEXT)
            ry += 26
            i += 1
        }
        if z_plugins.len() == 0 { dtext(sx + 16, ry, "Drop .zeph scripts in the plugins/ folder", COL_FAINT) }
        close_outside(sx, sy, sw, phh)
    }
    if z_popup == 13 {                      // Local History
        let sw = 420
        let sx = (cw - sw) / 2
        let sy = 90
        var idx: [int] = []
        var hh = z_hist.len() - 1
        while hh >= 0 {
            if z_hist[hh].path == z_path { idx.push(hh) }
            hh -= 1
        }
        var rn = idx.len()
        if rn == 0 { rn = 1 }
        let shh = 40 + rn * 26 + 10
        popup_frame(sx, sy, sw, shh)
        let sb = ui_selectb()
        dtext(sx + 16, sy + 10, "Local History", COL_TEXT)
        ui_selectn()
        if z_hist_sel > idx.len() - 1 { z_hist_sel = idx.len() - 1 }
        if z_hist_sel < 0 { z_hist_sel = 0 }
        var ry = sy + 36
        var i = 0
        while i < idx.len() {
            if i == z_hist_sel { fill_rr(sx + 6, ry, sw - 12, 26, 8, COL_ACTIVE) }
            let clicked = ui_flat(9820 + i, sx + 6, ry, sw - 120, 26, "", COL_ITEM)
            let snap = z_hist[idx[i]]
            fill_rr(sx + 16, ry + 8, 8, 8, 8, COL_DIM)
            dtext(sx + 32, ry + 5, snap.ts, COL_TEXT)
            dtext(sx + 120, ry + 5, "({snap.body.split(chr(10)).len()} lines)", COL_FAINT)
            if ui_abtn(9840 + i, sx + sw - 106, ry, 46, 22, "Diff") {
                var ref: [str] = []
                for rl in snap.body.split("\n") { ref.push(strip_cr(rl)) }
                open_diff(ref, "History " + snap.ts)
            }
            if ui_abtn(9860 + i, sx + sw - 56, ry, 48, 22, "Load") {
                hist_push()
                set_content(snap.body)
                z_modified = true
                z_popup = 0
                run_diagnostics()
            }
            if clicked or (z_hist_enter and i == z_hist_sel) {
                z_hist_enter = false
                hist_push()
                set_content(snap.body)
                z_modified = true
                z_popup = 0
                run_diagnostics()
            }
            ry += 26
            i += 1
        }
        if idx.len() == 0 { dtext(sx + 16, ry, "No snapshots yet - saving the file creates them", COL_FAINT) }
        z_hist_enter = false
        close_outside(sx, sy, sw, shh)
    }
    if z_popup == 14 {                      // Diff viewer (side-by-side line diff)
        let mw = cw - 80
        let mh = ch - 120
        let mx = 40
        let my = 60
        popup_frame(mx, my, mw, mh)
        let sb = ui_selectb()
        dtext(mx + 16, my + 8, "Diff:  " + z_diff_title + "   vs   current buffer", COL_TEXT)
        ui_selectn()
        if hit(mx, my, mw, mh) { z_diff_off -= g_wheelf * 3 }
        let topY = my + 38
        let rowsH = mh - 48
        let vis = rowsH / 16
        if z_diff_off > z_diff_l.len() - vis { z_diff_off = z_diff_l.len() - vis }
        if z_diff_off < 0 { z_diff_off = 0 }
        let colw = (mw - 30) / 2
        let lx = mx + 12
        let rx3 = mx + 18 + colw
        fill(mx + 15 + colw, topY - 4, 1, rowsH, COL_BORDER)
        ui_mono()
        var r = 0
        while r < vis and z_diff_off + r < z_diff_l.len() {
            let row = z_diff_off + r
            let yy = topY + r * 16
            let kd = z_diff_k[row]
            let ldl = z_diff_l[row]
            let rdl = z_diff_r[row]
            if kd == 2 { fill(lx - 4, yy - 1, colw, 16, rgb(64, 42, 42)) }
            if kd == 1 { fill(rx3 - 4, yy - 1, colw, 16, rgb(40, 58, 42)) }
            if ldl >= 0 and ldl < z_diff_ref.len() { dtext(lx, yy, z_diff_ref[ldl], COL_TEXT) }
            if rdl >= 0 and rdl < z_lines.len() { dtext(rx3, yy, z_lines[rdl], COL_TEXT) }
            r += 1
        }
        ui_ui()
        close_outside(mx, my, mw, mh)
    }
    if z_popup == 16 {                      // Find in Files (Ctrl+Shift+F)
        fif_scan()
        // display rows: file header ("H"+rel) then its matches ("M"+idx), IntelliJ grouping
        var drows: [str] = []
        var prevRel = "\n"
        var i2 = 0
        while i2 < z_fif_res.len() {
            let rr2 = z_fif_res[i2]
            let rel2 = rr2.sub(0, rr2.index_of("|"))
            if rel2 != prevRel {
                drows.push("H" + rel2)
                prevRel = rel2
            }
            drows.push("M" + (i2 as str))
            i2 += 1
        }
        let sw = 640
        let sx = (cw - sw) / 2
        let sy = 70
        var shown = drows.len()
        if shown > 16 { shown = 16 }
        let sh = 104 + shown * 26 + 26
        popup_frame(sx, sy, sw, sh)
        let sb = ui_selectb()
        dtext(sx + 16, sy + 10, "Find in Files", COL_TEXT)
        ui_selectn()
        ui_field(sx + 12, sy + 34, sw - 24, 30, z_find_q, true)
        if z_fif_sel > z_fif_res.len() - 1 { z_fif_sel = z_fif_res.len() - 1 }
        if z_fif_sel < 0 { z_fif_sel = 0 }
        var selPos = 0
        var dp = 0
        while dp < drows.len() {
            if drows[dp] == "M" + (z_fif_sel as str) { selPos = dp }
            dp += 1
        }
        var start = 0
        if selPos >= 16 { start = selPos - 15 }
        var ry = sy + 76
        var i = start
        while i < drows.len() and i < start + 16 {
            let dr = drows[i]
            if dr.starts_with("H") {
                let rel = dr.sub(1, dr.len())
                if not draw_svg(ftype_icon(rel), sx + 14, ry + 5, 16, -1) {
                    zicon_cp(MI_FILE, sx + 14, ry + 5, COL_DIM)
                }
                let sb2 = ui_selectb()
                dtext(sx + 36, ry + 6, rel, COL_TEXT)
                ui_selectn()
            } else {
                let mi = dr.sub(1, dr.len()) as int
                let row = z_fif_res[mi]
                let r1 = row.index_of("|")
                let rest1 = row.sub(r1 + 1, row.len())
                let r2 = rest1.index_of("|")
                let rel = row.sub(0, r1)
                let lineS = rest1.sub(0, r2)
                let prev = rest1.sub(r2 + 1, rest1.len())
                if mi == z_fif_sel { fill_rr(sx + 6, ry, sw - 12, 26, 8, COL_ACTIVE) }
                var open2 = false
                if ui_flat(9900 + (i - start), sx + 6, ry, sw - 12, 26, "", COL_ITEM) { open2 = true }
                dtext(sx + 40, ry + 6, lineS, COL_DIM)
                dtext(sx + 52 + text_w(lineS), ry + 6, prev, COL_TEXT)
                if open2 or (z_fif_enter and mi == z_fif_sel) {
                    z_fif_enter = false
                    z_popup = 0
                    let tgt = dirname(z_path) + rel
                    if rel.ends_with(".zeph") {
                        if tgt != z_path { open_file(tgt) }
                        z_cl = (lineS as int) - 1
                        if z_cl > z_lines.len() - 1 { z_cl = z_lines.len() - 1 }
                        if z_cl < 0 { z_cl = 0 }
                        z_cc = 0
                        z_sel = false
                        ensure_caret()
                        z_find_on = true      // keep matches highlighted after the jump
                    } else {
                        notify("Only .zeph files open in the editor")
                    }
                }
            }
            ry += 26
            i += 1
        }
        if z_fif_res.len() == 0 {
            dtext(sx + 16, ry + 2, "No results", COL_FAINT)
            ry += 26
        }
        var cnt2 = "{z_fif_res.len()} results"
        if z_fif_res.len() >= 200 { cnt2 = "200+ results (capped)" }
        dtext(sx + 16, ry + 4, cnt2, COL_FAINT)
        z_fif_enter = false
        close_outside(sx, sy, sw, sh)
    }
    if z_popup == 18 {                      // bookmarks list (Shift+F11)
        let sw = 560
        let sx = (cw - sw) / 2
        let sy = 80
        let n2 = z_bm_paths.len()
        var sh = 46 + n2 * 26 + 26
        if n2 == 0 { sh = 96 }
        popup_frame(sx, sy, sw, sh)
        let sb = ui_selectb()
        dtext(sx + 16, sy + 10, "Bookmarks", COL_TEXT)
        ui_selectn()
        if z_bm_sel > n2 - 1 { z_bm_sel = n2 - 1 }
        if z_bm_sel < 0 { z_bm_sel = 0 }
        var ry = sy + 38
        var i = 0
        while i < n2 {
            let p = z_bm_paths[i]
            let nm = p.sub(dirname(p).len(), p.len())
            if i == z_bm_sel { fill_rr(sx + 6, ry, sw - 12, 26, 8, COL_ACTIVE) }
            var go = false
            if ui_flat(9970 + i, sx + 6, ry, sw - 12, 26, "", COL_ITEM) { go = true }
            if not draw_svg(ftype_icon(nm), sx + 14, ry + 5, 16, -1) {
                zicon_cp(MI_FILE, sx + 14, ry + 5, COL_DIM)
            }
            let loc = nm + ":" + ((z_bm_lines[i] + 1) as str)
            dtext(sx + 38, ry + 6, loc, COL_DIM)
            dtext(sx + 52 + text_w(loc), ry + 6, z_bm_prev[i], COL_TEXT)
            if go or (z_bm_enter and i == z_bm_sel) {
                z_bm_enter = false
                z_popup = 0
                if p != z_path { open_file(p) }
                z_cl = z_bm_lines[i]
                if z_cl > z_lines.len() - 1 { z_cl = z_lines.len() - 1 }
                z_cc = 0
                z_sel = false
                ensure_caret()
            }
            ry += 26
            i += 1
        }
        if n2 == 0 {
            dtext(sx + 16, ry + 2, "No bookmarks - F11 toggles one on the caret line", COL_FAINT)
            ry += 26
        }
        dtext(sx + 16, ry + 4, "Enter opens   Del removes   F11 toggles", COL_FAINT)
        z_bm_enter = false
        close_outside(sx, sy, sw, sh)
    }
    if z_popup == 17 {                      // tab-overflow dropdown: all open tabs
        let mw = 280
        let mh = z_tabs.len() * 28 + 12
        let mx = cw - mw - 60
        let my = 74
        popup_frame(mx, my, mw, mh)
        ui_vstrip_begin(my + 6)
        var ti2 = 0
        while ti2 < z_tabs.len() {
            var tnm = z_tabs[ti2].path
            tnm = tnm.sub(dirname(tnm).len(), tnm.len())
            if tnm == "" { tnm = "untitled" }
            let rowy = ui_vstrip_slot(28, 0)
            if ui_flat(9950 + ti2, mx + 4, rowy, mw - 8, 26, "", COL_ITEM) {
                if ti2 != z_tab {
                    tab_store()
                    tab_load(ti2)
                    run_diagnostics()
                }
                z_popup = 0
            }
            if not draw_svg(ftype_icon(tnm), mx + 12, rowy + 5, 16, -1) {
                zicon_cp(MI_FILE, mx + 12, rowy + 5, COL_DIM)
            }
            var tc3 = COL_TEXT
            if ti2 == z_tab { tc3 = COL_ACCENT }
            dtext_v(mx + 36, rowy, 26, tnm, tc3)
            var md2 = z_tabs[ti2].mod
            if ti2 == z_tab { md2 = z_modified }
            if md2 { fill_rr(mx + mw - 20, rowy + 9, 8, 8, 8, COL_TEXT) }
            ti2 += 1
        }
        close_outside(mx, my, mw, mh)
    }
    if z_popup == 10 {                      // run configuration dropdown
        let mw = 240
        let mx = z_runchip_x
        let my = 40
        let mh = 4 * 28 + 12
        popup_frame(mx, my, mw, mh)
        ui_vstrip_begin(my + 6)
        if menu_row_i(9750, mx, ui_vstrip_slot(28, 0), mw, "Run 'zide'", "F5", MI_PLAY) {
            z_popup = 0
            do_run()
        }
        if menu_row_i(9751, mx, ui_vstrip_slot(28, 0), mw, "Debug 'zide'", "", MI_BUG) {
            z_popup = 0
            dbg_start()
        }
        if menu_row(9752, mx, ui_vstrip_slot(28, 0), mw, "Stop", "") {
            z_popup = 0
            notify("Nothing running")
        }
        if menu_row(9753, mx, ui_vstrip_slot(28, 0), mw, "Edit Configurations...", "") {
            z_popup = 0
            notify("Only 'zide' (current file) is configured")
        }
        close_outside(mx, my, mw, mh)
    }
    if z_popup == 12 {                      // Find Usages
        let sw = 560
        let sx = (cw - sw) / 2
        let sy = 80
        var un = z_usages.len()
        if un == 0 { un = 1 }
        if un > 14 { un = 14 }
        let sh = 42 + un * 24 + 10
        popup_frame(sx, sy, sw, sh)
        let sb = ui_selectb()
        dtext(sx + 16, sy + 10, "Usages of '" + z_usage_word + "'  ({z_usages.len()})", COL_TEXT)
        ui_selectn()
        if z_usage_sel > z_usages.len() - 1 { z_usage_sel = z_usages.len() - 1 }
        if z_usage_sel < 0 { z_usage_sel = 0 }
        var ry = sy + 38
        var i = 0
        while i < z_usages.len() and i < 14 {
            if i == z_usage_sel { fill_rr(sx + 6, ry, sw - 12, 24, 8, COL_ACTIVE) }
            let clicked = ui_flat(9790 + i, sx + 6, ry, sw - 12, 24, "", COL_ITEM)
            let parts = z_usages[i].split("|")
            dtext(sx + 16, ry + 5, ":" + ((parts[0] as int) + 1) as str, COL_FAINT)
            ui_mono()
            if parts.len() > 1 { dtext(sx + 70, ry + 5, parts[1], COL_TEXT) }
            ui_ui()
            if clicked or (z_usage_enter and i == z_usage_sel) {
                z_usage_enter = false
                z_popup = 0
                z_cl = parts[0] as int
                z_cc = 0
                ensure_caret()
            }
            ry += 24
            i += 1
        }
        if z_usages.len() == 0 { dtext(sx + 16, ry, "No usages found", COL_FAINT) }
        z_usage_enter = false
        close_outside(sx, sy, sw, sh)
    }
    if z_popup == 9 {                       // Recent Files (Ctrl+E)
        let sw = 460
        let sx = (cw - sw) / 2
        let sy = 90
        var rn = z_recent.len()
        if rn == 0 { rn = 1 }
        let sh = 40 + rn * 26 + 10
        popup_frame(sx, sy, sw, sh)
        let sb = ui_selectb()
        dtext(sx + 16, sy + 10, "Recent Files", COL_TEXT)
        ui_selectn()
        if z_recent_sel > z_recent.len() - 1 { z_recent_sel = z_recent.len() - 1 }
        if z_recent_sel < 0 { z_recent_sel = 0 }
        var ry = sy + 36
        var i = 0
        while i < z_recent.len() {
            if i == z_recent_sel { fill_rr(sx + 6, ry, sw - 12, 26, 8, COL_ACTIVE) }
            let clicked = ui_flat(9780 + i, sx + 6, ry, sw - 12, 26, "", COL_ITEM)
            zicon_cp(MI_FILE, sx + 16, ry + 5, rgb(222, 165, 132))
            let rp = z_recent[i]
            dtext_v(sx + 40, ry, 26, rp.sub(dirname(rp).len(), rp.len()), COL_TEXT)
            if clicked or (z_recent_enter and i == z_recent_sel) {
                z_recent_enter = false
                z_popup = 0
                if rp != z_path { open_file(rp) }
            }
            ry += 26
            i += 1
        }
        if z_recent.len() == 0 { dtext(sx + 16, ry, "No recent files", COL_FAINT) }
        z_recent_enter = false
        close_outside(sx, sy, sw, sh)
    }
    if z_popup == 19 {                      // Recent Locations (Ctrl+Shift+E)
        let sw = 560
        let sx = (cw - sw) / 2
        let sy = 90
        var rn = z_locs_path.len()
        if rn == 0 { rn = 1 }
        let sh = 40 + rn * 26 + 10
        popup_frame(sx, sy, sw, sh)
        let sb = ui_selectb()
        dtext(sx + 16, sy + 10, "Recent Locations", COL_TEXT)
        ui_selectn()
        if z_locs_sel > z_locs_path.len() - 1 { z_locs_sel = z_locs_path.len() - 1 }
        if z_locs_sel < 0 { z_locs_sel = 0 }
        var ry = sy + 36
        var i = 0
        while i < z_locs_path.len() {
            if i == z_locs_sel { fill_rr(sx + 6, ry, sw - 12, 26, 8, COL_ACTIVE) }
            let clicked = ui_flat(9880 + i, sx + 6, ry, sw - 12, 26, "", COL_ITEM)
            let lp = z_locs_path[i]
            let tag = lp.sub(dirname(lp).len(), lp.len()) + ":" + ((z_locs_line[i] + 1) as str)
            dtext_v(sx + 16, ry, 26, tag, COL_TEXT)
            ui_mono()
            dtext_v(sx + 170, ry, 26, z_locs_prev[i], COL_DIM)   // code preview, IntelliJ-style
            ui_ui()
            if clicked or (z_locs_enter and i == z_locs_sel) {
                z_locs_enter = false
                z_popup = 0
                push_loc()                   // the jump itself becomes a location
                if lp != z_path { open_file(lp) }
                z_cl = z_locs_line[i]
                if z_cl > z_lines.len() - 1 { z_cl = z_lines.len() - 1 }
                z_cc = 0
                ensure_caret()
            }
            ry += 26
            i += 1
        }
        if z_locs_path.len() == 0 { dtext(sx + 16, ry, "No locations yet - navigate somewhere first", COL_FAINT) }
        z_locs_enter = false
        close_outside(sx, sy, sw, sh)
    }
    if z_popup == 20 {                      // Switcher (Ctrl+Tab, MRU tabs)
        let lst = switcher_list()
        let sw = 380
        let sx = (cw - sw) / 2
        let sy = 120
        var rn = lst.len()
        if rn == 0 { rn = 1 }
        let sh = 40 + rn * 26 + 10
        popup_frame(sx, sy, sw, sh)
        let sb = ui_selectb()
        dtext(sx + 16, sy + 10, "Switcher", COL_TEXT)
        ui_selectn()
        var sel = 0
        if lst.len() > 0 {
            sel = z_swi_sel % lst.len()
            if sel < 0 { sel += lst.len() }
        }
        var ry = sy + 36
        var i = 0
        while i < lst.len() {
            if i == sel { fill_rr(sx + 6, ry, sw - 12, 26, 8, COL_ACTIVE) }
            if ui_flat(9920 + i, sx + 6, ry, sw - 12, 26, "", COL_ITEM) {
                z_swi_sel = i
                z_popup = 0
                switcher_commit()
            }
            var tn = z_tabs[lst[i]].path
            tn = tn.sub(dirname(tn).len(), tn.len())
            if tn == "" { tn = "untitled" }
            if not draw_svg(ftype_icon(tn), sx + 14, ry + 5, 16, -1) {
                zicon_cp(MI_FILE, sx + 14, ry + 5, rgb(222, 165, 132))
            }
            dtext_v(sx + 40, ry, 26, tn, COL_TEXT)
            ry += 26
            i += 1
        }
        close_outside(sx, sy, sw, sh)
    }
    if z_popup == 22 {                      // Paste from History (Ctrl+Shift+V)
        let sw = 520
        let sx = (cw - sw) / 2
        let sy = 110
        var rn = z_clips.len()
        if rn == 0 { rn = 1 }
        let sh = 40 + rn * 26 + 10
        popup_frame(sx, sy, sw, sh)
        let sb = ui_selectb()
        dtext(sx + 16, sy + 10, "Clipboard History", COL_TEXT)
        ui_selectn()
        if z_clip_sel > z_clips.len() - 1 { z_clip_sel = z_clips.len() - 1 }
        if z_clip_sel < 0 { z_clip_sel = 0 }
        var ry = sy + 36
        var i = 0
        while i < z_clips.len() {
            if i == z_clip_sel { fill_rr(sx + 6, ry, sw - 12, 26, 8, COL_ACTIVE) }
            let clicked = ui_flat(9960 + i, sx + 6, ry, sw - 12, 26, "", COL_ITEM)
            var pv = z_clips[i].split("\n")[0]
            if pv.len() > 58 { pv = pv.sub(0, 58) + "..." }
            if z_clips[i].contains("\n") { pv = pv + "  [multiline]" }
            ui_mono()
            dtext_v(sx + 16, ry, 26, pv, COL_TEXT)
            ui_ui()
            if clicked or (z_clip_enter and i == z_clip_sel) {
                z_clip_enter = false
                z_popup = 0
                set_clipboard(z_clips[i])    // chosen item moves to front (IntelliJ)
                do_paste()
                ensure_caret()
            }
            ry += 26
            i += 1
        }
        z_clip_enter = false
        close_outside(sx, sy, sw, sh)
    }
    if z_popup == 23 {                      // Quick Definition (Ctrl+Shift+I)
        var maxw = 20
        for l in z_qdef {
            if l.len() > maxw { maxw = l.len() }
        }
        let dw = maxw * z_cw + 28
        let dh = 34 + z_qdef.len() * z_lh + 8
        var dx = z_caret_px
        var dy = z_caret_py + 22
        if dx + dw > cw { dx = cw - dw - 6 }
        if dx < 4 { dx = 4 }
        if dy + dh > ch { dy = z_caret_py - dh - 6 }
        popup_frame(dx, dy, dw, dh)
        let sb = ui_selectb()
        dtext(dx + 12, dy + 8, z_qdef_word, rgb(86, 168, 245))
        ui_selectn()
        ui_mono()
        var qi = 0
        while qi < z_qdef.len() {
            draw_code_line(dx + 14, dy + 34 + qi * z_lh, z_qdef[qi])
            qi += 1
        }
        ui_ui()
        close_outside(dx, dy, dw, dh)
    }
    if z_popup == 21 {                      // Surround With (Ctrl+Alt+T)
        let ml = "if|while".split("|")
        let mk = "|".split("|")
        var mi: [int] = []
        mi.push(0)
        mi.push(0)
        let mw = 170
        let mh = menu_group_h(ml) + 26
        var mx = z_caret_px
        var my = z_caret_py + 22
        if mx + mw > cw { mx = cw - mw - 4 }
        if my + mh > ch { my = ch - mh - 4 }
        popup_frame(mx, my, mw, mh)
        let sb = ui_selectb()
        dtext(mx + 14, my + 8, "Surround With", COL_TEXT)
        ui_selectn()
        let hit = menu_group(9990, mx, my + 26, mw, ml, mk, mi)
        if hit == 0 {
            z_popup = 0
            surround_with("if true")
        }
        if hit == 1 {
            z_popup = 0
            surround_with("while true")
        }
        close_outside(mx, my, mw, mh)
    }
    if z_popup == 24 {                      // Quick-fix intentions (Alt+Enter)
        let iw = text_w(z_qf_label) + 56
        var ix = z_caret_px
        var iy = z_caret_py + 22
        if ix + iw > cw { ix = cw - iw - 4 }
        if iy + 60 > ch { iy = z_caret_py - 60 }
        popup_frame(ix, iy, iw, 56)
        let sb = ui_selectb()
        dtext(ix + 12, iy + 8, "Intentions", COL_DIM)
        ui_selectn()
        fill_rr(ix + 6, iy + 26, iw - 12, 24, 8, COL_ACTIVE)
        if ui_flat(9994, ix + 6, iy + 26, iw - 12, 24, "", COL_ITEM) { qf_apply() }
        zicon_cp(MI_CHECK, ix + 12, iy + 30, rgb(95, 190, 110))
        dtext(ix + 34, iy + 30, z_qf_label, COL_TEXT)
        close_outside(ix, iy, iw, 56)
    }
    if z_popup == 8 {                       // Search Everywhere (double-Shift)
        scan_symbols()
        let sw = 640
        let sx = (cw - sw) / 2
        let sy = 70
        // build the result list for the active category
        var rl: [str] = []
        var rk: [int] = []
        var rv: [int] = []
        var rs: [int] = []
        if z_se_tab == 0 or z_se_tab == 1 {
            var i = 0
            while i < z_files.len() {
                let sc = se_score(z_files[i])
                if sc > SE_NOMATCH {
                    rl.push(z_files[i])
                    rk.push(1)
                    rv.push(i)
                    rs.push(sc)
                }
                i += 1
            }
        }
        if z_se_tab == 0 or z_se_tab == 2 {
            var i = 0
            while i < z_sym_names.len() {
                let sc = se_score(z_sym_names[i])
                if sc > SE_NOMATCH {
                    rl.push(z_sym_names[i] + "   :{z_sym_lines[i] + 1}")
                    rk.push(2)
                    rv.push(i)
                    rs.push(sc)
                }
                i += 1
            }
        }
        if z_se_tab == 0 or z_se_tab == 3 {
            var i = 0
            while i < SE_ACTIONS.len() {
                let sc = se_score(SE_ACTIONS[i])
                if sc > SE_NOMATCH {
                    rl.push(SE_ACTIONS[i])
                    rk.push(3)
                    rv.push(i)
                    rs.push(sc)
                }
                i += 1
            }
            // plugins are first-class actions (IntelliJ's unified action system):
            // a plugin contributes an action findable by name in Find Action
            var pi = 0
            while pi < z_plugins.len() {
                let sc2 = se_score(plugin_label(z_plugins[pi]))
                if sc2 > SE_NOMATCH {
                    rl.push(plugin_label(z_plugins[pi]))
                    rk.push(4)
                    rv.push(pi)
                    rs.push(sc2)
                }
                pi += 1
            }
        }
        // rank by IntelliJ matching score: selection-sort the top 12 to the front
        var top = rl.len()
        if top > 12 { top = 12 }
        var a = 0
        while a < top {
            var bi = a
            var b = a + 1
            while b < rl.len() {
                if rs[b] > rs[bi] { bi = b }
                b += 1
            }
            if bi != a {
                let tl = rl[a]
                rl[a] = rl[bi]
                rl[bi] = tl
                let tk = rk[a]
                rk[a] = rk[bi]
                rk[bi] = tk
                let tv = rv[a]
                rv[a] = rv[bi]
                rv[bi] = tv
                let tsc = rs[a]
                rs[a] = rs[bi]
                rs[bi] = tsc
            }
            a += 1
        }
        while rl.len() > top {
            let _p1 = rl.pop()
            let _p2 = rk.pop()
            let _p3 = rv.pop()
            let _p4 = rs.pop()
        }
        if z_se_sel > rl.len() - 1 { z_se_sel = rl.len() - 1 }
        if z_se_sel < 0 { z_se_sel = 0 }
        let sh = 84 + rl.len() * 26 + 30
        popup_frame(sx, sy, sw, sh)
        // category tabs
        var tx2 = sx + 10
        var ci = 0
        let cats = "All|Files|Symbols|Actions".split("|")
        while ci < 4 {
            let cwid = text_w(cats[ci]) + 22
            if ui_flat(9760 + ci, tx2, sy + 8, cwid, 24, "", COL_ITEM) {
                z_se_tab = ci
                z_se_sel = 0
            }
            var cc2 = COL_DIM
            if z_se_tab == ci { cc2 = COL_TEXT }
            dtext_c(tx2, sy + 8, cwid, 24, cats[ci], cc2)
            if z_se_tab == ci { fill_rr(tx2 + 4, sy + 30, cwid - 8, 3, 3, COL_ACCENT) }
            tx2 += cwid
            ci += 1
        }
        // query field
        fill_rr(sx + 10, sy + 40, sw - 20, 30, 8, COL_FIELD)
        zicon_cp(MI_SEARCH, sx + 16, sy + 45, COL_FAINT)
        var qs = z_se_q
        if (g_frame / 15) % 2 == 0 { qs = qs + "_" }
        dtext(sx + 40, sy + 47, qs, COL_TEXT)
        // results
        var ry = sy + 80
        var i = 0
        while i < rl.len() {
            if i == z_se_sel { fill_rr(sx + 6, ry, sw - 12, 26, 8, COL_ACTIVE) }
            if ui_flat(9770 + i, sx + 6, ry, sw - 12, 26, "", COL_ITEM) { se_exec(rk[i], rv[i]) }
            var icon = ui_icon(2, rgb(222, 165, 132))
            if rk[i] == 2 { icon = sym_icon(z_sym_kinds[rv[i]]) }
            if rk[i] == 3 { icon = ui_icon(5, rgb(95, 190, 110)) }
            if rk[i] == 4 { icon = ui_icon(5, rgb(180, 140, 220)) }
            draw_icon(icon / 16777216, icon % 16777216, sx + 18, ry + 13)
            dtext_v(sx + 40, ry, 26, rl[i], COL_TEXT)
            var tag = "file"
            if rk[i] == 2 { tag = "symbol" }
            if rk[i] == 3 { tag = SE_ACTKEYS[rv[i]] }   // shortcut hint, IntelliJ-style
            if rk[i] == 4 { tag = "plugin" }
            dtext(sx + sw - 24 - text_w(tag), ry + 6, tag, COL_FAINT)
            ry += 26
            i += 1
        }
        if rl.len() == 0 {
            dtext(sx + 16, ry + 2, "Nothing found", COL_FAINT)
            ry += 26
        }
        dtext(sx + 16, ry + 6, "Tab switches category   Enter opens   Esc closes", COL_FAINT)
        if z_se_enter {
            z_se_enter = false
            if rl.len() > 0 { se_exec(rk[z_se_sel], rv[z_se_sel]) }
        }
        close_outside(sx, sy, sw, sh)
    }
    if z_popup == 5 {                       // editor context menu (ActionGroup data)
        var clabel = "Ask Claude"
        if z_diag_line >= 0 { clabel = "Fix error with Claude" }
        let ml = ("Cut|Copy|Paste|-|Go to Declaration|Find Usages|Rename|Quick Documentation|-|Select All|Find|Run File|" + clabel).split("|")
        let mk = "Ctrl+X|Ctrl+C|Ctrl+V||Ctrl+B|Alt+F7|Shift+F6|Ctrl+Q||Ctrl+A|Ctrl+F|F5|".split("|")
        var mi: [int] = []
        mi.push(MI_CUT)
        mi.push(MI_COPY)
        mi.push(MI_PASTE)
        mi.push(0)
        mi.push(MI_FILE)
        mi.push(MI_SEARCH)
        mi.push(MI_MORE)
        mi.push(MI_FILE)
        mi.push(0)
        mi.push(MI_SELALL)
        mi.push(MI_SEARCH)
        mi.push(MI_PLAY)
        mi.push(MI_BOT)
        let mw = 250
        let mh = menu_group_h(ml)
        var mx = z_ctx_x
        var my = z_ctx_y
        if mx + mw > cw { mx = cw - mw - 4 }
        if my + mh > ch { my = ch - mh - 4 }
        popup_frame(mx, my, mw, mh)
        let hit = menu_group(9721, mx, my, mw, ml, mk, mi)
        if hit >= 0 { z_popup = 0 }
        if hit == 0 { do_cut() }
        if hit == 1 { do_copy() }
        if hit == 2 {
            do_paste()
            ensure_caret()
        }
        if hit == 4 { goto_decl(caret_word()) }
        if hit == 5 { find_usages(caret_word()) }
        if hit == 6 {
            let rw = caret_word()
            if rw != "" { open_dialog(5, rw, rw) }
        }
        if hit == 7 {
            z_qdoc_word = caret_word()
            z_qdoc = qdoc_for(z_qdoc_word)
            z_popup = 11
            z_popup_frame = g_frame
        }
        if hit == 9 { do_select_all() }
        if hit == 10 { open_find() }
        if hit == 11 { do_run() }
        if hit == 12 {
            if z_diag_line >= 0 {
                z_fix_error()
            } else {
                z_chat_on = true
                z_focus = 1
            }
        }
        close_outside(mx, my, mw, mh)
    }
    if z_popup == 6 {                       // project-tree context menu
        let isdir = z_ctx_file.ends_with("\\")
        let isfile = z_ctx_file != "" and not isdir
        // creation happens inside the clicked folder, or its parent if a file, else root
        var parent = ""
        if isdir { parent = z_ctx_file }
        if isfile {
            let sl = z_ctx_file.index_of("\\")
            if sl >= 0 { parent = z_ctx_file.sub(0, z_ctx_file.len() - reltail(z_ctx_file).len()) }
        }
        let mw = 210
        var rows = 3                         // background: New File, New Folder, Refresh
        if isdir { rows = 5 }                // + Rename, Delete
        if isfile { rows = 6 }               // + Open, Rename, Delete
        var mh = rows * 28 + 12
        var mx = z_ctx_x
        var my = z_ctx_y
        if mx + mw > cw { mx = cw - mw - 4 }
        if my + mh > ch { my = ch - mh - 4 }
        popup_frame(mx, my, mw, mh)
        var yy = my + 6
        if isfile {
            if menu_row(9731, mx, yy, mw, "Open", "") {
                if z_ctx_file.ends_with(".zeph") {
                    open_file(dirname(z_path) + z_ctx_file)
                } else {
                    notify("Only .zeph files open in the editor")
                }
                z_popup = 0
            }
            yy += 28
        }
        if menu_row(9734, mx, yy, mw, "New File...", "") {
            z_new_parent = parent
            open_dialog(1, "", "")
        }
        yy += 28
        if menu_row(9736, mx, yy, mw, "New Folder...", "") {
            z_new_parent = parent
            open_dialog(10, "", "")
        }
        yy += 28
        if z_ctx_file != "" {
            if menu_row(9732, mx, yy, mw, "Rename...", "") {
                open_dialog(2, z_ctx_file, reltail(z_ctx_file))
            }
            yy += 28
            if menu_row(9733, mx, yy, mw, "Delete...", "") {
                open_dialog(3, z_ctx_file, "")
            }
            yy += 28
        }
        if menu_row(9735, mx, yy, mw, "Refresh", "") {
            scan_dir()
            notify("Project refreshed")
            z_popup = 0
        }
        close_outside(mx, my, mw, mh)
    }
    if z_popup == 7 {                       // file dialog: new / rename / delete
        let dw = 380
        let dh = 128
        let dx = (cw - dw) / 2
        let dy = (ch - dh) / 2
        popup_frame(dx, dy, dw, dh)
        var title = "New File"
        if z_input_mode == 1 and z_new_parent != "" { title = "New File in " + z_new_parent }
        if z_input_mode == 10 { title = "New Folder" }
        if z_input_mode == 10 and z_new_parent != "" { title = "New Folder in " + z_new_parent }
        if z_input_mode == 2 { title = "Rename " + z_input_target }
        if z_input_mode == 3 { title = "Delete " + z_input_target + "?" }
        if z_input_mode == 4 { title = "Go to Line" }
        if z_input_mode == 5 { title = "Rename '" + z_input_target + "'" }
        if z_input_mode == 8 { title = "Introduce Variable" }
        if z_input_mode == 11 { title = "Extract Constant" }
        if z_input_mode == 9 { title = "Extract Function" }
        if z_input_mode == 6 { title = "Remote Host  (user@host:/path)" }
        if z_input_mode == 7 { title = "Open Remote File  (name in " + z_remote_dir + ")" }
        let sb = ui_selectb()
        dtext(dx + 16, dy + 12, title, COL_TEXT)
        ui_selectn()
        if z_input_mode == 3 {
            dtext(dx + 16, dy + 46, "This permanently deletes the file from disk.", COL_DIM)
        } else {
            ui_field(dx + 16, dy + 42, dw - 32, 30, z_input_q, true)
        }
        var okLabel = "Create"
        if z_input_mode == 2 { okLabel = "Rename" }
        if z_input_mode == 3 { okLabel = "Delete" }
        if z_input_mode == 4 { okLabel = "Go" }
        if z_input_mode == 5 { okLabel = "Rename" }
        if z_input_mode == 6 { okLabel = "Connect" }
        if z_input_mode == 7 { okLabel = "Open" }
        if ui_abtn(9741, dx + dw - 190, dy + dh - 42, 84, 28, okLabel) { input_commit() }
        if ui_abtn(9742, dx + dw - 98, dy + dh - 42, 84, 28, "Cancel") {
            z_popup = 0
            z_input_mode = 0
        }
        close_outside(dx, dy, dw, dh)
    }
    if z_popup == 4 {                       // notifications
        let nw = 300
        var nh = z_notifs.len() * 24 + 40
        if z_notifs.len() == 0 { nh = 64 }
        let nx = cw - 46 - nw - 8       // beside the right rail's bell
        let ny = 46
        popup_frame(nx, ny, nw, nh)
        let sb = ui_selectb()
        dtext(nx + 14, ny + 8, "Notifications", COL_TEXT)
        ui_selectn()
        if z_notifs.len() == 0 {
            dtext(nx + 14, ny + 34, "No new notifications", COL_FAINT)
        } else {
            var i = z_notifs.len() - 1
            var yy = ny + 32
            while i >= 0 {
                dtext(nx + 14, yy, z_notifs[i], COL_DIM)
                yy += 24
                i -= 1
            }
        }
        close_outside(nx, ny, nw, nh)
    }
}
fn draw_qdoc(cw: int, ch: int) {
    ui_selectn()                             // measure in the draw font (proportional)
    let maxdw = 460
    var ppc = text_w("the quick brown fox jumps") / 25   // avg char width, incl spaces
    if ppc < 6 { ppc = 6 }
    var cols = (maxdw - 28) / (ppc + 1)      // wrap conservatively so lines fit the box
    if cols < 12 { cols = 12 }
    let lines2 = wrap(z_qdoc, cols)
    var contentw = text_w(z_qdoc_word)       // size the box to the widest ACTUAL line
    for l in lines2 {
        let lw = text_w(l)
        if lw > contentw { contentw = lw }
    }
    var dw = contentw + 28
    if dw > maxdw { dw = maxdw }
    if dw < 160 { dw = 160 }
    var dx = z_caret_px
    if dx + dw > cw { dx = cw - dw - 8 }
    if dx < 8 { dx = 8 }
    var dy = z_caret_py + 24
    let dh = 40 + lines2.len() * 18 + 8
    if dy + dh > ch { dy = z_caret_py - dh - 6 }
    popup_frame(dx, dy, dw, dh)
    let sb = ui_selectb()
    dtext(dx + 14, dy + 10, z_qdoc_word, rgb(86, 168, 245))
    ui_selectn()
    var i = 0
    while i < lines2.len() {
        dtext(dx + 14, dy + 34 + i * 18, lines2[i], COL_TEXT)
        i += 1
    }
    close_outside(dx, dy, dw, dh)
}
// Welcome screen shown when no file is open
fn draw_welcome(x: int, y: int, w: int, h: int) {
    fill(x, y, w, h, COL_BG)
    let cx = x + w / 2
    fill_rr(cx - 32, y + 70, 64, 64, 16, rgb(90, 120, 220))
    let sb = ui_selectb()
    dtext_c(cx - 32, y + 82, 64, 40, "Z", COL_TEXT)
    dtext_c(x, y + 150, w, 24, "Zide", COL_TEXT)
    ui_selectn()
    dtext_c(x, y + 178, w, 20, "The Zephyr IDE - written in Zephyr, compiled by zc.exe", COL_DIM)
    if ui_abtn(9530, cx - 154, y + 214, 148, 34, "New File...") {
        z_new_parent = ""
        open_dialog(1, "", "")
    }
    if ui_abtn(9531, cx + 6, y + 214, 148, 34, "Open Project") {
        z_proj_on = true
        z_left_mode = 0
    }
    dtext(cx - 154, y + 272, "RECENT FILES", COL_FAINT)
    var i = 0
    while i < z_recent.len() and i < 8 {
        let rp = z_recent[i]
        if ui_flat(9540 + i, cx - 158, y + 294 + i * 26, 320, 24, "", COL_ITEM) { open_file(rp) }
        zicon_cp(MI_FILE, cx - 152, y + 299 + i * 26, rgb(222, 165, 132))
        dtext(cx - 126, y + 296 + i * 26, rp.sub(dirname(rp).len(), rp.len()), COL_TEXT)
        i += 1
    }
    if z_recent.len() == 0 { dtext(cx - 154, y + 296, "No recent files yet - open one from the Project tree", COL_DIM) }
}
// the inline find / replace bar, top-right of the editor (JetBrains style)
fn draw_find(edx: int, edw: int, ty: int) {
    var rows = 1
    if z_replace_on { rows = 2 }
    let fw = 400
    let fx = edx + edw - fw - 16
    let fy = ty + 6
    let bh = rows * 32 + 6
    fill_rr(fx, fy, fw, bh, 8, COL_PANEL)
    frame_rr(fx, fy, fw, bh, 8, COL_OUTLINE)
    let fieldw = fw - 116
    z_find_total = find_count()
    // query field
    var qc = COL_OUTLINE
    if z_focus == 2 and z_find_field == 0 { qc = COL_ACCENT }
    fill_rr(fx + 8, fy + 5, fieldw, 24, 6, COL_FIELD)
    frame_rr(fx + 8, fy + 5, fieldw, 24, 6, qc)
    if ui_flat(9496, fx + 8, fy + 5, fieldw, 24, "", COL_FIELD) {
        z_focus = 2
        z_find_field = 0
    }
    zicon_cp(MI_SEARCH, fx + 12, fy + 7, COL_FAINT)
    if z_find_q == "" and not (z_focus == 2 and z_find_field == 0) {
        dtext(fx + 34, fy + 8, "Find", COL_FAINT)
    } else {
        var qs = z_find_q
        if z_focus == 2 and z_find_field == 0 and (g_frame / 15) % 2 == 0 { qs = z_find_q + "_" }
        dtext(fx + 34, fy + 8, qs, COL_TEXT)
        dtext(fx + fieldw - 114, fy + 8, "{z_find_total}", COL_FAINT)
    }
    // Match Case / Words / Regex toggles inside the field (IntelliJ Cc / W / .* chips)
    var ccc = COL_FAINT
    if z_find_case { ccc = COL_ACCENT }
    if ui_flat(9498, fx + fieldw - 84, fy + 7, 24, 20, "", COL_ITEM) { z_find_case = not z_find_case }
    dtext(fx + fieldw - 80, fy + 8, "Cc", ccc)
    var wcc = COL_FAINT
    if z_find_words { wcc = COL_ACCENT }
    if ui_flat(9499, fx + fieldw - 58, fy + 7, 20, 20, "", COL_ITEM) { z_find_words = not z_find_words }
    dtext(fx + fieldw - 53, fy + 8, "W", wcc)
    var rcc = COL_FAINT
    if z_find_regex {
        rcc = COL_ACCENT
        rx_prepare()
        if not z_rx_ok and z_find_q != "" { rcc = C_ERR }   // bad pattern, IntelliJ-style
    }
    if ui_flat(9489, fx + fieldw - 34, fy + 7, 24, 20, "", COL_ITEM) { z_find_regex = not z_find_regex }
    dtext(fx + fieldw - 30, fy + 8, ".*", rcc)
    if ui_abtn(9490, fx + fw - 98, fy + 4, 90, 26, "Next") { find_next() }
    // replace row
    if z_replace_on {
        var rc = COL_OUTLINE
        if z_focus == 2 and z_find_field == 1 { rc = COL_ACCENT }
        fill_rr(fx + 8, fy + 33, fieldw, 24, 6, COL_FIELD)
        frame_rr(fx + 8, fy + 33, fieldw, 24, 6, rc)
        if ui_flat(9497, fx + 8, fy + 33, fieldw, 24, "", COL_FIELD) {
            z_focus = 2
            z_find_field = 1
        }
        if z_replace_q == "" and not (z_focus == 2 and z_find_field == 1) {
            dtext(fx + 16, fy + 36, "Replace", COL_FAINT)
        } else {
            var rs = z_replace_q
            if z_focus == 2 and z_find_field == 1 and (g_frame / 15) % 2 == 0 { rs = z_replace_q + "_" }
            dtext(fx + 16, fy + 36, rs, COL_TEXT)
        }
        if ui_abtn(9494, fx + fw - 98, fy + 32, 42, 26, "One") { replace_one() }
        if ui_abtn(9495, fx + fw - 52, fy + 32, 44, 26, "All") { replace_all() }
    }
}

// ---- setup + main ----
fn z_setup() {
    // strip the standard title bar -> our own chrome is the top of the window
    // WS_VISIBLE|SYSMENU|MINIMIZEBOX|MAXIMIZEBOX, no WS_CAPTION and no
    // THICKFRAME: the OS resize loop is modal (frame loop freezes -> exposed
    // area flashes and content only rescales on release). All four edges are
    // handled by our own in-loop grips instead, so resizing rescales live.
    win("user32!SetWindowLongA", g_hwnd, 0 - 16, 269156352)
    win("user32!SetWindowPos", g_hwnd, 0, 0, 0, 0, 0, 55)     // SWP_FRAMECHANGED|NOMOVE|NOSIZE|NOZORDER|NOACTIVATE
    var fpath = exe_dir() + "assets\\MaterialIcons-Regular.ttf"
    if not path_exists(fpath) { fpath = "assets\\MaterialIcons-Regular.ttf" }
    let fok = ui_icon_font(fpath, 18)
    // the real JetBrains editor font, loaded privately; falls back to Consolas
    var mpath = exe_dir() + "assets\\JetBrainsMono-Regular.ttf"
    if not path_exists(mpath) { mpath = "assets\\JetBrainsMono-Regular.ttf" }
    if path_exists(mpath) {
        if win("gdi32!AddFontResourceExA", z_cstr(mpath, z_cmd), 16, 0) != 0 {
            z_monoface = "JetBrains Mono"
            g_fontm = win("gdi32!CreateFontA", 0 - 15, 0, 0, 0, 400, 0, 0, 0, 0, 0, 0, 49, 0, z_cstr("JetBrains Mono", z_pathbuf))
        }
    }
    // Inter, the actual New UI interface font (bundled in intellij-community, OFL);
    // semibold (600) for headings, matching IntelliJ's title weight
    var ipath = exe_dir() + "assets\\Inter-Regular.ttf"
    if not path_exists(ipath) { ipath = "assets\\Inter-Regular.ttf" }
    var ibpath = exe_dir() + "assets\\Inter-SemiBold.ttf"
    if not path_exists(ibpath) { ibpath = "assets\\Inter-SemiBold.ttf" }
    if path_exists(ipath) {
        if win("gdi32!AddFontResourceExA", z_cstr(ipath, z_cmd), 16, 0) != 0 {
            if path_exists(ibpath) {
                let ibok = win("gdi32!AddFontResourceExA", z_cstr(ibpath, z_cmd), 16, 0)
            }
            g_font = win("gdi32!CreateFontA", 0 - 15, 0, 0, 0, 400, 0, 0, 0, 0, 0, 0, 5, 0, z_cstr("Inter", z_pathbuf))
            g_fontb = win("gdi32!CreateFontA", 0 - 15, 0, 0, 0, 600, 0, 0, 0, 0, 0, 0, 5, 0, z_cstr("Inter", z_pathbuf))
        }
    }
    let icdir = exe_dir() + "assets\\icons\\"
    svg_load("settings", icdir + "settings.svg")
    svg_load("search", icdir + "search.svg")
    svg_load("add", icdir + "add.svg")
    svg_load("close", icdir + "close.svg")
    svg_load("run", icdir + "run.svg")
    svg_load("folder", icdir + "folder.svg")
    svg_load("file", icdir + "file.svg")
    svg_load("user", icdir + "user.svg")
    svg_load("bell", icdir + "bell.svg")
    svg_load("vcs", icdir + "vcs.svg")
    svg_load("structure", icdir + "projectStructure.svg")
    svg_load("menu", icdir + "menu.svg")
    svg_load("more", icdir + "more.svg")
    svg_load("structure2", icdir + "structure2.svg")
    svg_load("commit", icdir + "commit.svg")
    svg_load("debug", icdir + "debug.svg")
    svg_load("ok", icdir + "ok.svg")
    svg_load("err", icdir + "err.svg")
    svg_load("warn", icdir + "warn.svg")
    svg_load("project", icdir + "project.svg")
    var fti = 0
    let ftn = ["text", "config", "json", "xml", "archive", "image", "css", "html", "javaScript", "java", "markdown", "properties", "shell", "yaml", "c", "cpp", "unknown"]
    while fti < ftn.len() {
        svg_load("ft_" + ftn[fti], icdir + "ft_" + ftn[fti] + ".svg")
        fti += 1
    }
    z_zc = find_zc()
    z_claude = find_claude()
    var first = ""
    if args().len() > 1 { first = args()[1] }
    var restored = false
    if first == "" { restored = session_restore() }   // bare launch reopens the workspace
    if not restored {
        z_tabs.push(TabS.new(first, [""]))
        tab_load(0)
    }
    if first != "" {
        set_content(read_file(first))
        z_path = first
        z_modified = false
    }
    // real git branch if this is a repo; VCS chrome hides otherwise (like JetBrains)
    let gb = run_capture("git rev-parse --abbrev-ref HEAD", dirname(z_path)).trim()
    if gb.len() > 0 and gb.len() < 40 and not gb.contains("fatal") and not gb.contains("not ") {
        z_branch = gb
    }
    scan_dir()
    scan_plugins()
    set_open(9310, true)
    run_diagnostics()
}

if args().len() > 1 and args()[1] == "--selftest" {
    selftest()
    win("ExitProcess", 0)
}

ui_init("Zide - Zephyr IDE", 1280, 820)
z_setup()

while ui_running() {
    ui_begin()
    let cw = ui_w()
    let ch = ui_h()
    let TOP = 38
    let STATUS = 24
    let AB = 46
    fill(0, 0, cw, ch, COL_PANEL)

    z_frame_input()
    poll_ai()
    poll_dbg()
    poll_diag()
    if z_edit_seq != z_lst_seq { lst_refresh() }   // VCS gutter stripes track edits
    if z_edit_seq != z_diag_seq and tick() - z_last_edit >= 350 {
        run_diagnostics()
    }

    let base = dirname(z_path)
    let fname = z_path.sub(base.len(), z_path.len())
    var shownName = fname
    if shownName == "" { shownName = "untitled" }

    // ---- toolbar (JetBrains New UI: burger, logo, project + branch chips left;
    //      run config, debug, dots | user, search, settings, bell right) ----
    fill(0, 0, cw, TOP, COL_TITLE)
    // left cluster, laid out left-to-right by the strip allocator (mirror of the right)
    ui_lstrip_begin(6)
    let burx = ui_lstrip_slot(TB_BW, 8)
    if z_iconbtn(9010, burx, MI_MENU, COL_DIM) { z_popup_toggle(1) }
    let logox = ui_lstrip_slot(22, 8)
    fill_rr(logox, 8, 22, 22, 7, rgb(90, 120, 220))
    dtext_c(logox, 8, 22, 22, "Z", COL_TEXT)
    let sb = ui_selectb()
    let pw = text_w("zephyr")                // measure with the BOLD font it draws in
    ui_selectn()
    let projx = ui_lstrip_slot(pw + 36, 8)
    if ui_flat(9003, projx, TB_BY, pw + 36, TB_BH, "", COL_ITEM) { z_proj_on = not z_proj_on }
    let sb2 = ui_selectb()
    dtext(projx + 8, TB_BY + 8, "zephyr", COL_TEXT)
    ui_selectn()
    chev_down(projx + 24 + pw, TOP / 2, COL_DIM)   // left edge = text end + 12
    if z_branch != "" {                     // VCS chrome only inside a git repo
        let bw = text_w(z_branch)
        let brx = ui_lstrip_slot(bw + 50, 8)
        if ui_flat(9004, brx, TB_BY, bw + 50, TB_BH, "", COL_ITEM) { notify("On branch " + z_branch) }
        zicon_cp(MI_BRANCH, brx + 6, TB_ICOY, COL_DIM)
        dtext(brx + 26, TB_BY + 8, z_branch, COL_DIM)
        chev_down(brx + 40 + bw, TOP / 2, COL_DIM)   // left edge = text end + 10
    }
    // right cluster, laid out right-to-left by the strip allocator (no magic offsets)
    ui_strip_begin(z_winctl(cw, TOP) - 8)
    let gearx = ui_strip_slot(TB_BW, 4)
    if z_iconbtn(9002, gearx, MI_GEAR, COL_DIM) { z_popup_toggle(2) }
    let srchx = ui_strip_slot(TB_BW, 4)
    if z_iconbtn(9006, srchx, MI_SEARCH, COL_DIM) { se_open() }
    let userx = ui_strip_slot(TB_BW, 4)
    if z_iconbtn(9007, userx, MI_USER, COL_DIM) { z_popup_toggle(3) }
    let sepx = ui_strip_sep(16)
    fill(sepx, 12, 1, 14, COL_BORDER)
    // run group, IntelliJ order: [config chip v] [run] [debug]
    let bugx = ui_strip_slot(TB_BW, 4)
    if z_iconbtn(9009, bugx, MI_BUG, rgb(95, 190, 110)) { dbg_start() }   // Debug (trace)
    let playx = ui_strip_slot(TB_BW, 4)
    if z_iconbtn(9001, playx, MI_PLAY, rgb(95, 190, 110)) { do_run() }
    let chipw = text_w("zide") + 40
    let chipx = ui_strip_slot(chipw, 6)
    z_runchip_x = chipx
    if ui_flat(9013, chipx, TB_BY, chipw, TB_BH, "", COL_ITEM) { z_popup_toggle(10) }
    dtext(chipx + 10, TB_BY + 8, "zide", COL_TEXT)
    chev_down(chipx + chipw - 14, TOP / 2, COL_DIM)
    fill(0, TOP - 1, cw, 1, COL_BORDER)
    // drag the window by the toolbar (there is no OS title bar now);
    // the top 4px belong to the resize grip, not the caption drag
    if g_press and g_my >= 4 and g_my < TOP and g_hot == 0 and z_rs_mode == 0 {
        win("user32!ReleaseCapture")
        win("user32!SendMessageA", g_hwnd, 161, 2, 0)      // WM_NCLBUTTONDOWN, HTCAPTION
    }
    // live edge resize on ALL four edges (the OS thickframe is gone; every
    // resize runs through this loop, so the whole UI re-lays-out per frame)
    var rz = 0
    if g_mx >= cw - 7 { rz += 1 }               // right
    if g_my >= ch - 7 { rz += 2 }               // bottom
    if g_mx < 5 { rz += 4 }                     // left (rail buttons start at x=5)
    if g_my < 4 { rz += 8 }                     // top (toolbar buttons start at y=4)
    if z_rs_mode == 0 and g_press and rz != 0 and g_hot == 0 and g_active == 0 {
        z_rs_mode = rz
        win("user32!GetCursorPos", g_pt)
        let pv0 = load64(g_pt)
        z_rs_x = s32(pv0 & 4294967295)
        z_rs_y = s32((pv0 / 4294967296) & 4294967295)
        win("user32!GetWindowRect", g_hwnd, g_rect)
        let rv0 = load64(g_rect)
        let rv1 = load64(g_rect + 8)
        z_rs_wx = s32(rv0 & 4294967295)
        z_rs_wy = s32((rv0 / 4294967296) & 4294967295)
        z_rs_w = s32(rv1 & 4294967295) - z_rs_wx
        z_rs_h = s32((rv1 / 4294967296) & 4294967295) - z_rs_wy
    }
    if z_rs_mode != 0 {
        if not g_mdown {
            z_rs_mode = 0
        } else {
            win("user32!GetCursorPos", g_pt)
            let pv = load64(g_pt)
            let smx = s32(pv & 4294967295)
            let smy = s32((pv / 4294967296) & 4294967295)
            let dx = smx - z_rs_x
            let dy = smy - z_rs_y
            var nx = z_rs_wx
            var ny = z_rs_wy
            var nw = z_rs_w
            var nh = z_rs_h
            if (z_rs_mode & 1) != 0 { nw = z_rs_w + dx }
            if (z_rs_mode & 2) != 0 { nh = z_rs_h + dy }
            if (z_rs_mode & 4) != 0 {           // left edge: right edge stays pinned
                nw = z_rs_w - dx
                if nw < 700 { nw = 700 }
                nx = z_rs_wx + z_rs_w - nw
            }
            if (z_rs_mode & 8) != 0 {           // top edge: bottom edge stays pinned
                nh = z_rs_h - dy
                if nh < 450 { nh = 450 }
                ny = z_rs_wy + z_rs_h - nh
            }
            if nw < 700 { nw = 700 }
            if nh < 450 { nh = 450 }
            win("user32!SetWindowPos", g_hwnd, 0, nx, ny, nw, nh, 20)   // NOZORDER|NOACTIVATE
        }
    }
    if rz != 0 or z_rs_mode != 0 {
        var m = rz
        if z_rs_mode != 0 { m = z_rs_mode }
        var cur = 32644                          // IDC_SIZEWE (left/right)
        if m == 2 or m == 8 { cur = 32645 }      // IDC_SIZENS
        if m == 3 or m == 12 { cur = 32642 }     // IDC_SIZENWSE (BR / TL corner)
        if m == 6 or m == 9 { cur = 32643 }      // IDC_SIZENESW (BL / TR corner)
        win("user32!SetCursor", win("user32!LoadCursorA", 0, cur))
    }

    // New UI: no navigation-bar row under the toolbar — the breadcrumb lives in
    // the status bar (bottom), where compute_navsym()'s symbol is appended.
    compute_navsym()
    let workTop = TOP
    let workBot = ch - STATUS
    var chatW = 0
    if z_chat_on { chatW = z_chatW }
    if z_leftW < 150 { z_leftW = 150 }

    // ---- activity rail ----
    fill(0, workTop, AB, workBot - workTop, COL_TITLE)
    fill(AB - 1, workTop, 1, workBot - workTop, COL_BORDER)
    // tool-window toggles only (global actions live in the toolbar - no duplicates)
    // tool-window rail, stacked top-to-bottom by the vertical strip allocator
    ui_vstrip_begin(workTop + 8)
    if z_ab(9601, ui_vstrip_slot(36, 6), MI_FOLDER, z_proj_on and z_left_mode == 0) {
        if z_proj_on and z_left_mode == 0 {
            z_proj_on = false
        } else {
            z_proj_on = true
            z_left_mode = 0
        }
    }
    if z_ab(9609, ui_vstrip_slot(36, 6), MI_TREE, z_proj_on and z_left_mode == 1) {
        if z_proj_on and z_left_mode == 1 {
            z_proj_on = false
        } else {
            z_proj_on = true
            z_left_mode = 1
        }
    }
    if z_branch != "" {
        if z_ab(9606, ui_vstrip_slot(36, 6), MI_COMMIT, z_show_out and z_bottom == 4) {
            if z_show_out and z_bottom == 4 { z_show_out = false } else { show_dock(4) }
        }
    }
    // bottom-anchored rail group (IntelliJ keeps Terminal/Problems in a lower group)
    var rly = workBot - 8 - 36
    if z_ab(9607, rly, MI_TERM, z_show_out and z_bottom == 3) {
        if z_show_out and z_bottom == 3 { z_show_out = false } else { show_dock(3) }
    }
    // ---- right rail (IntelliJ: notifications + AI assistant on the right edge) ----
    fill(cw - AB, workTop, AB, workBot - workTop, COL_TITLE)
    fill(cw - AB, workTop, 1, workBot - workTop, COL_BORDER)
    var rry = workTop + 8
    if z_ab2(9005, cw - AB + 5, rry, MI_BELL, false) { z_popup_toggle(4) }
    if z_notif_unread { fill_rr(cw - AB + 27, rry + 4, 7, 7, 7, rgb(95, 190, 110)) }
    rry += 42
    if z_ab2(9604, cw - AB + 5, rry, MI_BOT, z_chat_on) {
        z_chat_on = not z_chat_on
        if z_chat_on { z_focus = 1 } else { z_focus = 0 }
    }

    let px = AB
    var edx = AB + z_leftW
    if not z_proj_on { edx = AB }
    let edw = cw - edx - chatW - AB
    var outH = 0
    if z_show_out { outH = 190 }
    let edAreaBot = workBot - outH

    var rootName = "zephyr"
    if base.len() > 1 {
        let trimmed = base.sub(0, base.len() - 1)
        rootName = trimmed.sub(dirname(trimmed).len(), trimmed.len())
    }
    // ---- left tool window: Project tree, or Structure (ported from IntelliJ) ----
    if z_proj_on and z_left_mode == 0 {
        fill(px, workTop, z_leftW, workBot - workTop, COL_PANEL)
        let sb3 = ui_selectb()
        let prw = text_w("Project")          // bold width, so the chevron clears the text
        dtext(px + 14, workTop + 8, "Project", COL_TEXT)
        ui_selectn()
        chev_down(px + 28 + prw, workTop + 16, COL_DIM)   // left edge = text end + 10
        // tool-window header actions, right-aligned (IntelliJ: more + hide)
        if ui_flat(9531, px + z_leftW - 52, workTop + 6, 22, 22, "", COL_ITEM) {
            z_ctx_file = ""
            z_ctx_x = px + z_leftW - 52
            z_ctx_y = workTop + 30
            z_popup = 6
            z_popup_frame = g_frame
        }
        zicon_cp(MI_MORE, px + z_leftW - 49, workTop + 9, COL_DIM)
        if ui_flat(9530, px + z_leftW - 28, workTop + 6, 22, 22, "", COL_ITEM) { z_proj_on = false }
        fill(px + z_leftW - 22, workTop + 16, 10, 1, COL_DIM)
        let ltY = workTop + 32
        z_tree_off = ui_scroll_begin(9300, px, ltY, z_leftW, workBot - ltY, z_tree_h, z_tree_off)
        var eti: [int] = []
        z_trow_ids = eti
        var etp: [str] = []
        z_trow_paths = etp
        var ety: [int] = []
        z_trow_ys = ety
        let rootopen = ui_tree_row(9310, 0, rootName, true, 0)
        if not draw_svg("folder", g_row_ix - 8, g_row_iy - 8, 16, -1) {
            zicon_cp(MI_FOLDER, g_row_ix - 8, g_row_iy - 7, rgb(120, 160, 210))
        }
        if rootopen { draw_tree_dir(base, "", 1) }
        z_tree_h = ui_scroll_end()
        let tsel = ui_tree_selected()
        if tsel != z_tree_prev {
            var ri = 0
            while ri < z_trow_ids.len() {
                if z_trow_ids[ri] == tsel and z_trow_paths[ri] != "" {
                    let pick = z_trow_paths[ri]
                    if pick.ends_with(".zeph") and base + pick != z_path {
                        open_file(base + pick)
                    }
                    ri = z_trow_ids.len()
                } else {
                    ri += 1
                }
            }
        }
        z_tree_prev = tsel
    }
    if z_proj_on and z_left_mode == 1 {
        fill(px, workTop, z_leftW, workBot - workTop, COL_PANEL)
        let sb3 = ui_selectb()
        dtext(px + 14, workTop + 8, "Structure", COL_TEXT)
        ui_selectn()
        scan_symbols()
        let ltY = workTop + 32
        z_tree_off = ui_scroll_begin(9300, px, ltY, z_leftW, workBot - ltY, z_tree_h, z_tree_off)
        var si = 0
        while si < z_sym_names.len() {
            let rr = ui_tree_row(9800 + si, 0, z_sym_names[si], false, sym_icon(z_sym_kinds[si]))
            si += 1
        }
        if z_sym_names.len() == 0 {
            let rr = ui_tree_row(9799, 0, "(no symbols)", false, 0)
        }
        z_tree_h = ui_scroll_end()
        let ssel = ui_tree_selected()
        if ssel != z_struct_prev and ssel >= 9800 and ssel < 9800 + z_sym_names.len() {
            z_cl = z_sym_lines[ssel - 9800]
            z_cc = 0
            ensure_caret()
        }
        z_struct_prev = ssel
    }

    // ---- welcome screen when no file is open ----
    let welcome = z_path == "" and z_lines.len() == 1 and z_lines[0] == "" and not z_modified
    if welcome {
        draw_welcome(edx, workTop, edw, workBot - workTop)
    }
    if not welcome {
    // ---- editor tab BAR (multiple open files, per-tab state) ----
    let TABH = 34
    fill(edx, workTop, edw, TABH, COL_BG)
    fill(edx, workTop + TABH - 1, edw, 1, COL_ITEM)   // EditorTabs.underTabsBorderColor Gray3
    z_tab_switch = -1
    z_tab_close = -1
    var tbx = edx + 6
    var ti = 0
    var hidden = 0
    while ti < z_tabs.len() {
        var tnm = z_tabs[ti].path
        tnm = tnm.sub(dirname(tnm).len(), tnm.len())
        if tnm == "" { tnm = "untitled" }
        let tw = text_w(tnm) + 66
        if tbx + tw > edx + edw - 60 {                // overflow: rest go to the dropdown
            hidden = z_tabs.len() - ti
            break
        }
        let act = ti == z_tab
        if ui_abtn_flat(9400 + ti, tbx, workTop, tw, TABH, "", act) {
            if not act { z_tab_switch = ti }
        }
        if not draw_svg(ftype_icon(tnm), tbx + 10, workTop + 9, 16, -1) {
            zicon_cp(MI_FILE, tbx + 10, workTop + 9, rgb(222, 165, 132))
        }
        var tc2 = COL_DIM
        if act { tc2 = COL_TEXT }
        dtext_v(tbx + 32, workTop, TABH, tnm, tc2)
        var md = z_tabs[ti].mod
        if act { md = z_modified }
        if md {
            fill_rr(tbx + tw - 16, workTop + 13, 8, 8, 8, COL_TEXT)
        } else {
            if ui_flat(9430 + ti, tbx + tw - 20, workTop + 8, 18, 18, "", COL_ITEM) { z_tab_close = ti }
            zicon_cp(MI_CLOSE, tbx + tw - 19, workTop + 9, COL_DIM)
        }
        if act { fill_rr(tbx + 8, workTop + TABH - 4, tw - 16, 4, 4, COL_ACCENT) }
        tbx += tw
        ti += 1
    }
    if hidden > 0 {                       // overflow chevron: lists all tabs (IntelliJ style)
        if ui_flat(9440, edx + edw - 54, workTop + 6, 24, 22, "", COL_ITEM) { z_popup_toggle(17) }
        dtext(edx + edw - 66, workTop + 8, hidden as str, COL_FAINT)
        chev_down(edx + edw - 46, workTop + 17, COL_DIM)
    }
    if z_tab_switch >= 0 {
        tab_store()
        tab_load(z_tab_switch)
        run_diagnostics()
    }
    if z_tab_close >= 0 { close_tab(z_tab_close) }
    // Inspections Widget (New UI): error + warning counts, click steps to next (F2)
    var iwErr = 0
    var iwWarn = 0
    var di9 = 0
    while di9 < z_sdiag.len() {
        if z_sdiag[di9].sev == 0 { iwErr += 1 } else { iwWarn += 1 }
        di9 += 1
    }
    if z_diag_line >= 0 and iwErr == 0 { iwErr = 1 }   // compiler error counts too
    if iwErr > 0 or iwWarn > 0 {
        var iwx = edx + edw - 30
        if iwWarn > 0 {
            let wtx = iwWarn as str
            iwx -= text_w(wtx) + 4
            dtext(iwx, workTop + 10, wtx, rgb(242, 197, 92))   // #F2C55C, the triangle's yellow
            iwx -= 18
            if not draw_svg("warn", iwx, workTop + 9, 16, -1) {
                zicon_cp(MI_ERROR, iwx, workTop + 9, rgb(242, 197, 92))
            }
            iwx -= 8
        }
        if iwErr > 0 {
            let etx = iwErr as str
            iwx -= text_w(etx) + 4
            dtext(iwx, workTop + 10, etx, C_ERR)
            iwx -= 18
            zicon_cp(MI_ERROR, iwx, workTop + 9, C_ERR)
        }
        if ui_flat(9955, iwx - 4, workTop + 5, edx + edw - 24 - iwx, 24, "", COL_ITEM) {
            goto_error(1)                    // click steps through problems
        }
    } else {
        zicon_cp(MI_CHECK, edx + edw - 28, workTop + 9, rgb(95, 190, 110))
    }
    // editor split (IntelliJ Split Right): active editor left, a second tab's
    // pane right; clicking the right pane swaps focus through the tab model
    // two-pane focus model: each file keeps its side; the live editor renders
    // on z_pane's side, the other side shows its tab statically. Clicking the
    // inactive side moves FOCUS there (IntelliJ: one focused caret at a time).
    var edwL = edw
    var edxL = edx
    if z_split >= 0 and z_split < z_tabs.len() and z_split != z_tab {
        edwL = edw / 2
        if z_pane == 0 {
            draw_split_pane(edx + edwL, workTop, edw - edwL, edAreaBot - workTop)
        } else {
            draw_split_pane(edx, workTop, edwL, edAreaBot - workTop)
            edxL = edx + edwL
        }
    } else {
        z_split = -1
        z_pane = 0
    }
    draw_editor(edxL, workTop + TABH, edwL, edAreaBot - workTop - TABH)
    // scrollbar error stripe (proportional red mark, JetBrains-style)
    if z_diag_line >= 0 {
        let contentH2 = z_lines.len() * z_lh + 40
        let areaH = edAreaBot - workTop - TABH
        var smy = workTop + TABH + (z_diag_line - 1) * z_lh * areaH / contentH2
        if smy > edAreaBot - 4 { smy = edAreaBot - 4 }
        fill(edx + edw - 9, smy, 7, 3, C_ERR)
    }
    if z_find_on { draw_find(edx, edw, workTop + TABH) }
    compute_hover()
    }

    // ---- bottom tool window dock: Run | Problems | TODO | Terminal | Commit ----
    if z_show_out {
        let oy = edAreaBot
        fill(edx, oy, edw, outH, COL_PANEL)
        fill(edx, oy, edw, 1, COL_BORDER)
        var btabs = "Run|Problems|TODO|Terminal|Commit".split("|")
        var ntabs = 5
        if z_dbg_on {
            btabs = "Run|Problems|TODO|Terminal|Commit|Debug".split("|")
            ntabs = 6
        }
        var btx = edx + 8
        var bi = 0
        while bi < ntabs {
            let bw = text_w(btabs[bi]) + 20
            if ui_flat(9440 + bi, btx, oy + 4, bw, 24, "", COL_ITEM) {
                z_bottom = bi
                if bi == 2 { scan_todos() }
                if bi == 4 { git_refresh() }
            }
            var bc = COL_DIM
            if z_bottom == bi { bc = COL_TEXT }
            dtext_c(btx, oy + 4, bw, 24, btabs[bi], bc)
            if z_bottom == bi { fill_rr(btx + 4, oy + 28, bw - 8, 3, 3, COL_ACCENT) }
            btx += bw
            bi += 1
        }
        if ui_flat(9410, edx + edw - 26, oy + 5, 22, 22, "", COL_ITEM) { z_show_out = false }
        zicon_cp(MI_CLOSE, edx + edw - 24, oy + 7, COL_DIM)
        let bodyY = oy + 33
        let bodyH = outH - 33
        fill(edx, bodyY, edw, bodyH, COL_BG)
        if z_bottom == 0 {                  // Run
            ui_mono()
            let ol = z_out.split("\n")
            var oi = 0
            while oi < ol.len() and oi < bodyH / 18 {
                dtext(edx + 12, bodyY + 6 + oi * 18, ol[oi], COL_TEXT)
                oi += 1
            }
            ui_ui()
        }
        if z_bottom == 1 {                  // Problems: every diagnostic, click to jump
            var pry = bodyY + 4
            var prow = 0
            let prmax = (bodyH - 8) / 22
            // compiler error first (red), if the structural list doesn't already carry it
            var compdup = false
            var pi = 0
            while pi < z_sdiag.len() {
                if z_sdiag[pi].line == z_diag_line - 1 { compdup = true }
                pi += 1
            }
            if z_diag_line >= 1 and not compdup and prow < prmax {
                if ui_flat(9450, edx + 6, pry, edw - 12, 22, "", COL_ITEM) {
                    z_cl = z_diag_line - 1
                    clamp_col()
                    ensure_caret()
                }
                zicon_cp(MI_ERROR, edx + 12, pry + 1, C_ERR)
                dtext(edx + 34, pry + 2, z_diag_msg, COL_TEXT)
                dtext(edx + 40 + text_w(z_diag_msg), pry + 2, ":{z_diag_line}", COL_FAINT)
                pry += 22
                prow += 1
            }
            pi = 0
            while pi < z_sdiag.len() and prow < prmax {
                let pd = z_sdiag[pi]
                if ui_flat(9451 + pi, edx + 6, pry, edw - 12, 22, "", COL_ITEM) {
                    z_cl = pd.line
                    clamp_col()
                    ensure_caret()
                }
                var pcol = C_ERR
                if pd.sev == 1 { pcol = rgb(122, 126, 133) }
                zicon_cp(MI_ERROR, edx + 12, pry + 1, pcol)
                var ptc = COL_TEXT
                if pd.sev == 1 { ptc = COL_DIM }
                dtext(edx + 34, pry + 2, pd.msg, ptc)
                dtext(edx + 40 + text_w(pd.msg), pry + 2, ":{pd.line + 1}", COL_FAINT)
                pry += 22
                prow += 1
            }
            if prow == 0 {
                zicon_cp(MI_CHECK, edx + 12, pry + 1, rgb(95, 190, 110))
                dtext(edx + 34, pry + 2, "No problems found", COL_DIM)
            }
        }
        if z_bottom == 2 {                  // TODO
            var t2 = 0
            while t2 < z_todo.len() and t2 < bodyH / 22 {
                let parts = z_todo[t2].split("|")
                if ui_flat(9460 + t2, edx + 6, bodyY + 2 + t2 * 22, edw - 12, 20, "", COL_ITEM) {
                    let lc = parts[0].split(":")
                    if lc.len() > 1 {
                        z_cl = (lc[1] as int) - 1
                        clamp_col()
                        ensure_caret()
                    }
                }
                dtext(edx + 12, bodyY + 4 + t2 * 22, parts[0], COL_FAINT)
                if parts.len() > 1 {
                    dtext(edx + 24 + text_w(parts[0]), bodyY + 4 + t2 * 22, parts[1], rgb(210, 180, 90))
                }
                t2 += 1
            }
            if z_todo.len() == 0 { dtext(edx + 12, bodyY + 6, "No TODO or FIXME comments", COL_DIM) }
        }
        if z_bottom == 3 {                  // Terminal
            if ui_flat(9470, edx, bodyY, edw, bodyH, "", COL_BG) { z_focus = 3 }
            ui_mono()
            let ol = z_term_out.split("\n")
            let vis = (bodyH - 22) / 16
            var start = ol.len() - vis
            if start < 0 { start = 0 }
            var oi = 0
            while oi < vis and start + oi < ol.len() {
                dtext(edx + 10, bodyY + 4 + oi * 16, ol[start + oi], COL_TEXT)
                oi += 1
            }
            var pshow = "> " + z_term_in
            if z_focus == 3 and (g_frame / 15) % 2 == 0 { pshow = pshow + "_" }
            var pcol = COL_FAINT
            if z_focus == 3 { pcol = rgb(95, 190, 110) }
            dtext(edx + 10, bodyY + bodyH - 18, pshow, pcol)
            ui_ui()
        }
        if z_bottom == 4 {                  // Commit
            if ui_flat(9480, edx + 8, bodyY + 6, edw - 16, 44, "", COL_FIELD) { z_focus = 4 }
            fill_rr(edx + 8, bodyY + 6, edw - 16, 44, 8, COL_FIELD)
            var mcol = COL_OUTLINE
            if z_focus == 4 { mcol = COL_ACCENT }
            frame_rr(edx + 8, bodyY + 6, edw - 16, 44, 8, mcol)
            var cmshow = z_commit_msg
            if z_commit_msg == "" and z_focus != 4 {
                dtext(edx + 16, bodyY + 16, "Commit message", COL_FAINT)
            } else {
                if z_focus == 4 and (g_frame / 15) % 2 == 0 { cmshow = z_commit_msg + "_" }
                dtext(edx + 16, bodyY + 16, cmshow, COL_TEXT)
            }
            if ui_abtn(9481, edx + 8, bodyY + 58, 100, 28, "Commit") { git_commit() }
            var gi = 0
            while gi < z_git.len() and gi < (bodyH - 100) / 20 {
                let gl = z_git[gi]
                var gcol = rgb(95, 190, 110)
                let st = gl.trim()
                if st.starts_with("M") { gcol = rgb(110, 170, 240) }
                if st.starts_with("D") { gcol = C_ERR }
                dtext(edx + 14, bodyY + 96 + gi * 20, gl.trim(), gcol)
                gi += 1
            }
            if z_git.len() == 0 { dtext(edx + 14, bodyY + 96, "Working tree clean", COL_DIM) }
        }
        if z_bottom == 5 {                  // Debugger (live, halts at breakpoints)
            if ui_abtn(9600, edx + 10, bodyY + 6, 78, 26, "Step F8") { dbg_step() }
            if ui_abtn(9601, edx + 94, bodyY + 6, 90, 26, "Resume F9") { dbg_resume() }
            if ui_abtn(9602, edx + 190, bodyY + 6, 66, 26, "Stop") { dbg_stop() }
            if z_dbg_paused {
                dtext(edx + 266, bodyY + 12, "Paused at line {z_dbg_line}", rgb(230, 200, 90))
            } else if z_dbg_running {
                dtext(edx + 266, bodyY + 12, "Running...", rgb(95, 190, 110))
            } else {
                dtext(edx + 266, bodyY + 12, "Finished", COL_DIM)
            }
            // Variables (watches) column | program output column
            let colx = edx + edw / 2
            fill(colx, bodyY + 38, 1, bodyH - 44, COL_BORDER)
            dtext(edx + 12, bodyY + 40, "Variables", COL_FAINT)
            if ui_flat(9605, edx + edw / 2 - 60, bodyY + 38, 56, 20, "+ Watch", COL_ITEM) {
                z_focus = 6
                z_dbg_wq = ""
            }
            dtext(edx + edw / 2 - 60, bodyY + 40, "+ Watch", COL_ACCENT)
            ui_mono()
            var vi = 0
            while vi < z_dbg_vars.len() and vi < (bodyH - 64) / 16 {
                dtext(edx + 12, bodyY + 60 + vi * 16, z_dbg_vars[vi], COL_TEXT)
                vi += 1
            }
            if z_focus == 6 {
                var wshow = "watch: " + z_dbg_wq
                if (g_frame / 15) % 2 == 0 { wshow = wshow + "_" }
                dtext(edx + 12, bodyY + bodyH - 18, wshow, rgb(120, 200, 150))
            }
            dtext(colx + 12, bodyY + 40, "Console", COL_FAINT)
            var di = 0
            while di < z_dbg_out.len() and di < (bodyH - 64) / 16 {
                dtext(colx + 12, bodyY + 60 + di * 16, z_dbg_out[di], COL_TEXT)
                di += 1
            }
            ui_ui()
        }
    }

    // ---- chat panel ----
    if z_chat_on {
        draw_chat(cw - AB - chatW, workTop, chatW, workBot - workTop)
    }

    // ---- left splitter (only when the Project panel is open) ----
    if z_proj_on {
        z_leftW = ui_vsplit(9500, edx, workTop, workBot - workTop, AB + 150, cw / 2) - AB
    }

    // ---- status bar + breadcrumb (JetBrains right side: pos LF UTF-8 spaces) ----
    fill(0, ch - STATUS, cw, STATUS, COL_TITLE)
    fill(0, ch - STATUS, cw, 1, COL_BORDER)
    let by = ch - STATUS + 4
    dtext(14, by, rootName, COL_DIM)
    var bx = 14 + text_w(rootName)
    dtext(bx + 8, by, ">", COL_FAINT)
    dtext(bx + 22, by, shownName, COL_DIM)
    var bx2 = bx + 22 + text_w(shownName)
    if z_navsym != "" {                      // New UI: enclosing symbol in the status breadcrumb
        dtext(bx2 + 8, by, ">", COL_FAINT)
        dtext(bx2 + 22, by, z_navsym, COL_DIM)
        bx2 += 22 + text_w(z_navsym)
    }
    if z_diag_line >= 0 {
        dtext(bx2 + 16, by, "error {z_diag_line}: {z_diag_msg}", C_ERR)
    }
    var ex = cw - 14
    ex = status_seg(ex, "4 spaces", COL_DIM)
    ex = status_seg(ex, "UTF-8", COL_DIM)
    ex = status_seg(ex, "LF", COL_DIM)
    ex = status_seg(ex, "{z_cl + 1}:{z_cc + 1}", COL_DIM)
    var chkTxt = "Zephyr Check"
    if z_diag_running { chkTxt = "Analyzing..." }   // background compile in flight
    dtext(ex - text_w(chkTxt) - 10, by, chkTxt, COL_DIM)

    // overlays (topmost, unclipped)
    if z_pinfo { draw_pinfo() }              // non-modal: typing continues under it
    if z_comp_on {
        draw_comp()
    } else if z_hover_word != "" {
        draw_tooltip()
    }
    draw_popups(cw, ch)

    ui_end()
    let s = win("Sleep", 12)
}
