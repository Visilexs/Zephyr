// Hide All Tool Windows (Ctrl+Shift+F12): saves which panels were open and
// restores that exact layout on the second press, like IntelliJ.
var z_hideall = 0             // 0 = normal; else 8 + packed prev layout bits
fn hide_all_toggle() {
    if z_hideall == 0 {
        z_hideall = 8
        if z_proj_on { z_hideall += 1 }
        if z_show_out { z_hideall += 2 }
        if z_chat_on { z_hideall += 4 }
        z_proj_on = false
        z_show_out = false
        z_chat_on = false
    } else {
        z_proj_on = (z_hideall % 2) == 1
        z_show_out = ((z_hideall / 2) % 2) == 1
        z_chat_on = ((z_hideall / 4) % 2) == 1
        z_hideall = 0
    }
}

