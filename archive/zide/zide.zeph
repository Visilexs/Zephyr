    add_next_occurrence()
    assert(z_carets.len() == 2 and z_carets[1] / 1000000 == 2, "Alt+J advances to the following occurrence")
    select_all_occurrences()
    assert(z_cl == 0 and z_carets.len() == 2, "Select All: main on first, carets on the other two lines")
    assert(z_hl_word == "foo" and z_mc_sellen == 3, "occurrences highlighted and selected (len 3)")
