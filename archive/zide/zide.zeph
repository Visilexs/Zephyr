// ---- real JetBrains SVG icons (parsed from intellij-community, rendered via GDI paths) ----
var z_svg: [[int]] = []           // per-icon command stream (op + fixed-point coords *256)
var z_svg_idx: [str: int] = [:]   // icon name -> index
let z_svgpts = ualloc(64)         // POINT buffer for PolyBezierTo

fn svg_is_cmd(c: int) -> bool {
    return (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
}
fn svg_tokens(d: str) -> [str] {
    var toks: [str] = []
    var i = 0
    let n = d.len()
    while i < n {
        let c = d.byte(i)
        if c == 32 or c == 44 or c == 9 or c == 10 or c == 13 {
            i += 1
        } else if svg_is_cmd(c) {
            toks.push(chr(c))
            i += 1
        } else {
            var j = i
            if d.byte(j) == 45 { j += 1 }              // leading minus
            var dot = false
            while j < n {
                let cj = d.byte(j)
                if cj >= 48 and cj <= 57 {
                    j += 1
                } else if cj == 46 and not dot {
                    dot = true
                    j += 1
                } else {
                    j = j
                    break
                }
            }
            toks.push(d.sub(i, j))
            i = j
        }
    }
    return toks
}
fn svg_fp(f: float) -> int { return (f * 256.0 + 0.5) as int }
// parse `attr="#rrggbb"` from an element string -> GDI COLORREF (BGR), or -1
fn svg_hex(elem: str, attr: str) -> int {
    let k = elem.index_of(attr + "=\"#")
    if k < 0 { return -1 }
    let h = elem.sub(k + attr.len() + 3, elem.len())
    if h.len() < 6 { return -1 }
    var v = 0
    var i = 0
    while i < 6 {
        let c = h.byte(i)
        var d = 0
        if c >= 48 and c <= 57 { d = c - 48 }
        else if c >= 97 and c <= 102 { d = c - 87 }
        else if c >= 65 and c <= 70 { d = c - 55 }
        v = v * 16 + d
        i += 1
    }
    let r = v / 65536
    let g = (v / 256) % 256
    let b = v % 256
    return b * 65536 + g * 256 + r
}
fn svg_build(d: str, mode: int, fillc: int, strokec: int, out: [int]) {
    out.push(4)
    out.push(mode)
    out.push(fillc)
    out.push(strokec)
    let t = svg_tokens(d)
    var i = 0
    var cx = 0.0
    var cy = 0.0
    var cmd = "M"
    while i < t.len() {
        if t[i].len() > 0 and svg_is_cmd(t[i].byte(0)) {
            cmd = t[i]
            i += 1
            if cmd == "Z" or cmd == "z" { out.push(3) }
        } else {
            if cmd == "M" or cmd == "m" or cmd == "L" or cmd == "l" {
                cx = t[i] as float
                cy = t[i + 1] as float
                i += 2
                if cmd == "M" or cmd == "m" {
                    out.push(0)
                    cmd = "L"
                } else {
                    out.push(1)
                }
                out.push(svg_fp(cx))
                out.push(svg_fp(cy))
            } else if cmd == "H" or cmd == "h" {
                cx = t[i] as float
                i += 1
                out.push(1)
                out.push(svg_fp(cx))
                out.push(svg_fp(cy))
            } else if cmd == "V" or cmd == "v" {
                cy = t[i] as float
                i += 1
                out.push(1)
                out.push(svg_fp(cx))
                out.push(svg_fp(cy))
            } else if cmd == "C" or cmd == "c" {
                let x1 = t[i] as float
                let y1 = t[i + 1] as float
                let x2 = t[i + 2] as float
                let y2 = t[i + 3] as float
                let x3 = t[i + 4] as float
                let y3 = t[i + 5] as float
                i += 6
                cx = x3
                cy = y3
                out.push(2)
                out.push(svg_fp(x1))
                out.push(svg_fp(y1))
                out.push(svg_fp(x2))
                out.push(svg_fp(y2))
                out.push(svg_fp(x3))
                out.push(svg_fp(y3))
            } else {
                i += 1
            }
        }
    }
}
// parse ` attr="12.5"` from an element -> fixed-point *256, or -1000000 if absent.
// The leading space stops ` x="` matching inside `rx="`.
fn svg_attrf(elem: str, attr: str) -> int {
    let k = elem.index_of(" " + attr + "=\"")
    if k < 0 { return 0 - 1000000 }
    var i = k + attr.len() + 3
    var whole = 0
    while i < elem.len() and is_digit(elem.byte(i)) {
        whole = whole * 10 + (elem.byte(i) - 48)
        i += 1
    }
    var fp = whole * 256
    if i < elem.len() and elem.byte(i) == 46 {
        i += 1
        var frac = 0
        var fdiv = 1
        while i < elem.len() and is_digit(elem.byte(i)) {
            frac = frac * 10 + (elem.byte(i) - 48)
            fdiv = fdiv * 10
            i += 1
        }
        fp += frac * 256 / fdiv
    }
    return fp
}
fn svg_mode(elem: str) -> int {
    var mode = 0
    if svg_hex(elem, "fill") >= 0 { mode = mode + 1 }
    if svg_hex(elem, "stroke") >= 0 { mode = mode + 2 }
    if mode == 0 { mode = 1 }
    return mode
}
// <circle> as four cubic arcs (kappa = 0.5523 * r)
fn svg_emit_circle(cx: int, cy: int, r: int, mode: int, fc: int, sc: int, out: [int]) {
    let k = r * 5523 / 10000
    out.push(4)
    out.push(mode)
    out.push(fc)
    out.push(sc)
    out.push(0)
    out.push(cx + r)
    out.push(cy)
    out.push(2)
    out.push(cx + r)
    out.push(cy + k)
    out.push(cx + k)
    out.push(cy + r)
    out.push(cx)
    out.push(cy + r)
    out.push(2)
    out.push(cx - k)
    out.push(cy + r)
    out.push(cx - r)
    out.push(cy + k)
    out.push(cx - r)
    out.push(cy)
    out.push(2)
    out.push(cx - r)
    out.push(cy - k)
    out.push(cx - k)
    out.push(cy - r)
    out.push(cx)
    out.push(cy - r)
    out.push(2)
    out.push(cx + k)
    out.push(cy - r)
    out.push(cx + r)
    out.push(cy - k)
    out.push(cx + r)
    out.push(cy)
    out.push(3)
}
fn svg_emit_rect(x: int, y: int, w: int, h: int, mode: int, fc: int, sc: int, out: [int]) {
    out.push(4)
    out.push(mode)
    out.push(fc)
    out.push(sc)
    out.push(0)
    out.push(x)
    out.push(y)
    out.push(1)
    out.push(x + w)
    out.push(y)
    out.push(1)
    out.push(x + w)
    out.push(y + h)
    out.push(1)
    out.push(x)
    out.push(y + h)
    out.push(3)
}
fn svg_load(name: str, path: str) {
    if not path_exists(path) { return }
    let text = read_file(path)
    var out: [int] = []
    let segs = text.split("<")
    var si = 0
    while si < segs.len() {
        let elem = segs[si]
        if elem.starts_with("path") {
            let dk = elem.index_of("d=\"")
            if dk >= 0 {
                let rest = elem.sub(dk + 3, elem.len())
                let de = rest.index_of("\"")
                if de >= 0 {
                    let d = rest.sub(0, de)
                    svg_build(d, svg_mode(elem), svg_hex(elem, "fill"), svg_hex(elem, "stroke"), out)
                }
            }
        } else if elem.starts_with("circle") {
            let cx = svg_attrf(elem, "cx")
            let cy = svg_attrf(elem, "cy")
            let r = svg_attrf(elem, "r")
            if cx > 0 - 999999 and cy > 0 - 999999 and r > 0 - 999999 {
                svg_emit_circle(cx, cy, r, svg_mode(elem), svg_hex(elem, "fill"), svg_hex(elem, "stroke"), out)
            }
        } else if elem.starts_with("rect") {
            var rx0 = svg_attrf(elem, "x")
            var ry0 = svg_attrf(elem, "y")
            if rx0 < 0 - 999999 { rx0 = 0 }
            if ry0 < 0 - 999999 { ry0 = 0 }
            let rw = svg_attrf(elem, "width")
            let rh = svg_attrf(elem, "height")
            if rw > 0 and rh > 0 {
                svg_emit_rect(rx0, ry0, rw, rh, svg_mode(elem), svg_hex(elem, "fill"), svg_hex(elem, "stroke"), out)
            }
        }
        si += 1
    }
    out.push(5)
    z_svg_idx[name] = z_svg.len()
    z_svg.push(out)
}
var z_ss_dc = 0                  // 3x supersample DC: paths render big, HALFTONE-downscale = smooth
var z_ss_bmp = 0
fn draw_svg(name: str, x: int, y: int, size: int, col: int) -> bool {
    if not z_svg_idx.has(name) { return false }
    let cmds = z_svg[z_svg_idx[name]]
    let native = col < 0                 // -1 => use each path's own SVG colors
    if z_ss_dc == 0 {
        z_ss_dc = win("gdi32!CreateCompatibleDC", g_mdc)
        z_ss_bmp = win("gdi32!CreateCompatibleBitmap", g_mdc, 96, 96)
        let sb0 = win("gdi32!SelectObject", z_ss_dc, z_ss_bmp)
    }
    let big = size * 3
    // flat UI colors roundtrip the up/down scale losslessly, so copy the dest
    // background up, draw the icon at 3x, and halftone-average back down
    let up = win("gdi32!StretchBlt", z_ss_dc, 0, 0, big, big, g_mdc, x, y, size, size, 13369376)
    var pw = big / 14
    if pw < 2 { pw = 2 }
    let pf = win("gdi32!SetPolyFillMode", z_ss_dc, 1)
    var i = 0
    while i < cmds.len() {
        if cmds[i] == 4 {
            i += 1
            let mode = cmds[i]
            i += 1
            let fillc = cmds[i]
            i += 1
            let strokec = cmds[i]
            i += 1
            var bcol = col
            var pcol = col
            if native {
                bcol = fillc
                pcol = strokec
                if bcol < 0 { bcol = strokec }
                if pcol < 0 { pcol = fillc }
            }
            let br = win("gdi32!CreateSolidBrush", bcol)
            let pen = win("gdi32!CreatePen", 0, pw, pcol)
            let ob = win("gdi32!SelectObject", z_ss_dc, br)
            let op2 = win("gdi32!SelectObject", z_ss_dc, pen)
            let bp = win("gdi32!BeginPath", z_ss_dc)
            while i < cmds.len() and cmds[i] != 4 and cmds[i] != 5 {
                let o = cmds[i]
                if o == 0 {
                    let mv = win("gdi32!MoveToEx", z_ss_dc, cmds[i + 1] * big / 4096, cmds[i + 2] * big / 4096, 0)
                    i += 3
                } else if o == 1 {
                    let ln = win("gdi32!LineTo", z_ss_dc, cmds[i + 1] * big / 4096, cmds[i + 2] * big / 4096)
                    i += 3
                } else if o == 2 {
                    store32(z_svgpts + 0, cmds[i + 1] * big / 4096)
                    store32(z_svgpts + 4, cmds[i + 2] * big / 4096)
                    store32(z_svgpts + 8, cmds[i + 3] * big / 4096)
                    store32(z_svgpts + 12, cmds[i + 4] * big / 4096)
                    store32(z_svgpts + 16, cmds[i + 5] * big / 4096)
                    store32(z_svgpts + 20, cmds[i + 6] * big / 4096)
                    let pb = win("gdi32!PolyBezierTo", z_ss_dc, z_svgpts, 3)
                    i += 7
                } else if o == 3 {
                    let cf = win("gdi32!CloseFigure", z_ss_dc)
                    i += 1
                } else {
                    i += 1
                }
            }
            let ep = win("gdi32!EndPath", z_ss_dc)
            if mode == 1 {
                let fp2 = win("gdi32!FillPath", z_ss_dc)
            } else if mode == 2 {
                let sp = win("gdi32!StrokePath", z_ss_dc)
            } else {
                let sf = win("gdi32!StrokeAndFillPath", z_ss_dc)
            }
            let r1 = win("gdi32!SelectObject", z_ss_dc, ob)
            let r2 = win("gdi32!SelectObject", z_ss_dc, op2)
            let d1 = win("gdi32!DeleteObject", br)
            let d2 = win("gdi32!DeleteObject", pen)
        } else {
            i += 1
        }
    }
    let hm = win("gdi32!SetStretchBltMode", g_mdc, 4)      // HALFTONE
    let bo = win("gdi32!SetBrushOrgEx", g_mdc, 0, 0, 0)
    let dn = win("gdi32!StretchBlt", g_mdc, x, y, size, size, z_ss_dc, 0, 0, big, big, 13369376)
    return true
}
// unified chrome icon: map a Material codepoint to the real JetBrains SVG, else fall back
fn zicon_cp(cp: int, x: int, y: int, col: int) {
    var nm = ""
    if cp == MI_GEAR { nm = "settings" }
    if cp == MI_SEARCH { nm = "search" }
    if cp == MI_USER { nm = "user" }
    if cp == MI_BELL { nm = "bell" }
    if cp == MI_PLAY { nm = "run" }
    if cp == MI_FOLDER { nm = "folder" }
    if cp == MI_FILE { nm = "file" }
    if cp == MI_COMMIT { nm = "commit" }
    if cp == MI_MENU { nm = "menu" }
    if cp == MI_MORE { nm = "more" }
    if cp == MI_TREE { nm = "structure2" }
    if cp == MI_CLOSE { nm = "close" }
    if cp == MI_BUG { nm = "debug" }
    if cp == MI_CHECK { nm = "ok" }
    if cp == MI_ERROR { nm = "err" }
    if nm != "" and draw_svg(nm, x - 1, y - 1, 16, col) { return }
    ui_micon(cp, x, y, col)
}
// toolbar icon-button metrics (named once; icon insets COMPUTED so icons centre)
let TB_BW = 30       // button width  (IntelliJ ActionButton 30x30)
let TB_BH = 30       // button height
let TB_BY = 4        // button top y (toolbar is 38 tall)
let TB_ICO = 7       // (TB_BW - 16) / 2
let TB_ICOY = 11     // TB_BY + (TB_BH - 16) / 2
// one component: flat hover region + centred icon (ActionButton analogue)
fn z_iconbtn(id: int, x: int, cp: int, col: int) -> bool {
    let clicked = ui_flat(id, x, TB_BY, TB_BW, TB_BH, "", COL_ITEM)
    zicon_cp(cp, x + TB_ICO, TB_ICOY, col)
    return clicked
}
// pick a real JetBrains filetype icon name from a filename's extension
fn ftype_icon(name: str) -> str {
    if name.ends_with(".zeph") { return "ft_text" }
    if name.ends_with(".json") { return "ft_json" }
    if name.ends_with(".xml") { return "ft_xml" }
    if name.ends_with(".md") { return "ft_markdown" }
    if name.ends_with(".yaml") or name.ends_with(".yml") { return "ft_yaml" }
    if name.ends_with(".html") or name.ends_with(".htm") { return "ft_html" }
    if name.ends_with(".css") { return "ft_css" }
    if name.ends_with(".js") or name.ends_with(".ts") { return "ft_javaScript" }
    if name.ends_with(".java") { return "ft_java" }
    if name.ends_with(".c") or name.ends_with(".h") { return "ft_c" }
    if name.ends_with(".cpp") or name.ends_with(".cc") or name.ends_with(".hpp") { return "ft_cpp" }
    if name.ends_with(".sh") or name.ends_with(".bat") or name.ends_with(".ps1") { return "ft_shell" }
    if name.ends_with(".zip") or name.ends_with(".jar") or name.ends_with(".gz") { return "ft_archive" }
    if name.ends_with(".png") or name.ends_with(".jpg") or name.ends_with(".ico") or name.ends_with(".svg") { return "ft_image" }
    if name.ends_with(".properties") or name.ends_with(".ini") { return "ft_properties" }
    if name.ends_with(".cfg") or name.ends_with(".conf") or name.ends_with(".toml") { return "ft_config" }
    if name.ends_with(".txt") { return "ft_text" }
    return "ft_unknown"
}
fn draw_split_pane(x: int, y: int, w: int, h: int) {
    let t = z_tabs[z_split]
    fill(x, y, w, h, COL_BG)
    fill(x, y, 1, h, COL_BORDER)
    var tn = t.path
    tn = tn.sub(dirname(tn).len(), tn.len())
    if tn == "" { tn = "untitled" }
    fill(x + 1, y + 33, w - 1, 1, COL_ITEM)
    if not draw_svg(ftype_icon(tn), x + 12, y + 9, 16, -1) {
        zicon_cp(MI_FILE, x + 12, y + 9, rgb(222, 165, 132))
    }
    dtext_v(x + 34, y, 34, tn, COL_DIM)
    if ui_flat(9950, x + w - 26, y + 8, 18, 18, "", COL_ITEM) {
        z_split = -1
        return
    }
    zicon_cp(MI_CLOSE, x + w - 25, y + 9, COL_DIM)
    ui_clip(x + 1, y + 34, w - 1, h - 34)
    ui_mono()
    var r = z_split_off / z_lh
    if r < 0 { r = 0 }
    var yy = y + 38 - (z_split_off % z_lh)
    while r < t.rows.len() and yy < y + h {
        draw_code_line(x + 10, yy, t.rows[r])
        r += 1
        yy += z_lh
    }
    ui_ui()
    ui_clip_off()
    if g_mx >= x and g_mx < x + w and g_my >= y and g_my < y + h {
        z_split_off -= g_wheelf * 46
        var maxo = t.rows.len() * z_lh - (h - 60)
        if maxo < 0 { maxo = 0 }
        if z_split_off > maxo { z_split_off = maxo }
        if z_split_off < 0 { z_split_off = 0 }
        if g_press and g_my > y + 34 {       // click -> this pane becomes the live buffer,
            let prev = z_tab                 //   caret on the clicked line (real-pane feel)
            let crow = (g_my - (y + 38) + z_split_off) / z_lh
            tab_store()
            tab_load(z_split)
            run_diagnostics()
            z_split = prev
            z_pane = 1 - z_pane              // focus moves; files keep their sides
            if crow >= 0 {
                z_cl = crow
                if z_cl > z_lines.len() - 1 { z_cl = z_lines.len() - 1 }
                z_cc = 0
                ensure_caret()
            }
        }
    }
}

// ---- small helpers ----
fn z_cstr(s: str, buf: int) -> int {
    let n = s.len()
    var i = 0
    while i < n {
        store8(buf + i, s.byte(i))
        i += 1
    }
    store8(buf + n, 0)
    return buf
}
fn read_cstr(p: int) -> str {
    var chars: [str] = []
    var i = 0
    var b = load8(p + i)
    while b != 0 {
        chars.push(chr(b))
        i += 1
        b = load8(p + i)
    }
    return chars.join()
}
fn tick() -> int { return win("GetTickCount") & 4294967295 }
fn z_key(vk: int) -> bool { return win("user32!GetAsyncKeyState", vk) & 32768 != 0 }
fn z_pressed(vk: int) -> bool {
    let now = z_key(vk)
    let was = load8(z_nav + vk) != 0
    if now { store8(z_nav + vk, 1) } else { store8(z_nav + vk, 0) }
    return now and not was
}

fn is_alpha(c: int) -> bool { return (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95 }
fn is_digit(c: int) -> bool { return c >= 48 and c <= 57 }
fn is_alnum(c: int) -> bool { return is_alpha(c) or is_digit(c) }

// ---- buffer structure edits ----
fn insert_line(k: int, s: str) {
    z_lines.push("")
    var i = z_lines.len() - 1
    while i > k {
        z_lines[i] = z_lines[i - 1]
        i -= 1
    }
    z_lines[k] = s
}
fn delete_line(k: int) {
    if z_lines.len() <= 1 {
        z_lines[0] = ""
        return
    }
    var i = k
    while i < z_lines.len() - 1 {
        z_lines[i] = z_lines[i + 1]
        i += 1
    }
    let d = z_lines.pop()
}
fn copy_lines(src: [str]) -> [str] {
    var d: [str] = []
    for s in src { d.push(s) }
    return d
}

// ---- selection ----
fn norm_sel() {
    if z_al < z_cl or (z_al == z_cl and z_ac <= z_cc) {
        z_nsl = z_al
        z_nsc = z_ac
        z_nel = z_cl
        z_nec = z_cc
    } else {
        z_nsl = z_cl
        z_nsc = z_cc
        z_nel = z_al
        z_nec = z_ac
    }
}
fn del_sel() {
    norm_sel()
    if z_nsl == z_nel {
        let s = z_lines[z_nsl]
        z_lines[z_nsl] = s.sub(0, z_nsc) + s.sub(z_nec, s.len())
    } else {
        let first = z_lines[z_nsl].sub(0, z_nsc)
        let lastline = z_lines[z_nel]
        let last = lastline.sub(z_nec, lastline.len())
        z_lines[z_nsl] = first + last
        let cnt = z_nel - z_nsl
        var i = 0
        while i < cnt {
            delete_line(z_nsl + 1)
            i += 1
        }
    }
    z_cl = z_nsl
    z_cc = z_nsc
    z_sel = false
}
fn sel_text() -> str {
    norm_sel()
    if z_nsl == z_nel { return z_lines[z_nsl].sub(z_nsc, z_nec) }
    var parts: [str] = []
    parts.push(z_lines[z_nsl].sub(z_nsc, z_lines[z_nsl].len()))
    var k = z_nsl + 1
    while k < z_nel {
        parts.push("\n")
        parts.push(z_lines[k])
        k += 1
    }
    parts.push("\n")
    parts.push(z_lines[z_nel].sub(0, z_nec))
    return parts.join()
}

// ---- undo ----
var z_undo_kind = 0           // 0 command, 1 typing, 2 backspace, 3 delete
var z_undo_t = 0
fn push_undo() {
    if z_undo.len() >= 300 {
        var i = 0
        while i < z_undo.len() - 1 {
            z_undo[i] = z_undo[i + 1]
            i += 1
        }
        let d = z_undo.pop()
    }
    z_undo.push(Snap{rows: copy_lines(z_lines), cl: z_cl, cc: z_cc})
    z_undo_kind = 0
    var er: [Snap] = []                      // a fresh edit invalidates the redo chain
    z_redo = er
}
// UndoManager-style command merging: a burst of same-kind edits within 800ms
// is ONE undo step (Ctrl+Z removes the word you typed, not one character)
fn push_undo_kind(kind: int) {
    if z_undo_kind == kind and tick() - z_undo_t < 800 and z_undo.len() > 0 {
        z_undo_t = tick()
        return                               // keep the snapshot from the burst start
    }
    push_undo()
    z_undo_kind = kind
    z_undo_t = tick()
}
fn do_undo() {
    z_undo_kind = 0                          // typing after undo starts a fresh group
    if z_undo.len() == 0 { return }
    z_redo.push(Snap{rows: copy_lines(z_lines), cl: z_cl, cc: z_cc})
    let snap = z_undo.pop()
    z_lines = snap.rows
    z_cl = snap.cl
    z_cc = snap.cc
    if z_cl > z_lines.len() - 1 { z_cl = z_lines.len() - 1 }
    clamp_col()
    z_sel = false
    mark_edit()
}
fn do_redo() {
    if z_redo.len() == 0 { return }
    // manual push: push_undo() would clear the redo chain we are walking
    z_undo.push(Snap{rows: copy_lines(z_lines), cl: z_cl, cc: z_cc})
    z_undo_kind = 0
    let snap = z_redo.pop()
    z_lines = snap.rows
    z_cl = snap.cl
    z_cc = snap.cc
    if z_cl > z_lines.len() - 1 { z_cl = z_lines.len() - 1 }
    clamp_col()
    z_sel = false
    mark_edit()
}

// ---- text insertion ----
fn strip_cr(s: str) -> str {
    if s.len() > 0 and s.byte(s.len() - 1) == 13 { return s.sub(0, s.len() - 1) }
    return s
}
// drop a single trailing newline (CRLF or LF) — a shell filter usually appends
// one, but replacing a selection should not gain a stray line break
fn strip_nl_tail(s: str) -> str {
    var e = s.len()
    if e > 0 and s.byte(e - 1) == 10 { e -= 1 }
    if e > 0 and s.byte(e - 1) == 13 { e -= 1 }
    return s.sub(0, e)
}
// normalize line endings to \n, ported from LineTokenizer: CRLF and lone CR -> LF.
fn normalize_newlines(s: str) -> str {
    // built from split pieces; rt_str_replace re-concats the whole prefix per
    // match (quadratic — OOMs on a ~270KB CRLF buffer against the 1GiB heap)
    var out: [str] = []
    let crlf = s.split(chr(13) + chr(10))
    var i = 0
    while i < crlf.len() {
        if i > 0 { out.push(chr(10)) }
        let lone = crlf[i].split(chr(13))
        var j = 0
        while j < lone.len() {
            if j > 0 { out.push(chr(10)) }
            out.push(lone[j])
            j += 1
        }
        i += 1
    }
    return out.join()
}
// Quick Definition (ShowImplementationsAction port): peek at the symbol's
// source block in a caret-anchored popup without moving the caret. Popup 23.
var z_qdef: [str] = []
var z_qdef_word = ""
fn quick_def() {
    let w = caret_word()
    var eqd: [str] = []
    z_qdef = eqd
    if w == "" { return }
    let nodes = parse_decls()
    var i = 0
    while i < nodes.len() {
        if nodes[i].name == w {
            let dl = nodes[i].line
            var e = fold_end(dl)
            if e < dl { e = dl }
            var truncated = false
            if e > dl + 11 {
                e = dl + 11
                truncated = true
            }
            var k = dl
            while k <= e {
                z_qdef.push(z_lines[k])
                k += 1
            }
            if truncated { z_qdef.push("...") }
            z_qdef_word = w
            z_popup = 23
            z_popup_frame = g_frame
            return
        }
        i += 1
    }
    notify("No definition of '{w}' found")
}
// Complete Current Statement (SmartEnterProcessor port): a block header
// missing its brace gets " {", an indented body line, and the closing brace,
// caret inside; anything else becomes end-of-line + Enter.
fn smart_enter() {
    let t = z_lines[z_cl].trim()
    let hdr = t.starts_with("fn ") or t.starts_with("if ") or t.starts_with("while ") or t.starts_with("for ") or t.starts_with("struct ") or t.starts_with("enum ")
    if hdr and not t.ends_with("\{") {
        push_undo()
        let s0 = z_lines[z_cl]
        var ind = 0
        while ind < s0.len() and s0.byte(ind) == 32 { ind += 1 }
        z_lines[z_cl] = s0 + " \{"
        insert_line(z_cl + 1, " ".repeat(ind) + "\}")
        insert_line(z_cl + 1, " ".repeat(ind + 4))
        z_cl += 1
        z_cc = ind + 4
        z_sel = false
        mark_edit()
    } else {
        z_cc = z_lines[z_cl].len()
        do_enter()
    }
}
// TypedHandler pair completion: ( [ " auto-close when the caret sits before
// nothing/space/closer; typing a closer over an identical one skips instead.
// { stays with the EnterHandler, which already closes blocks on Enter.
fn typed_with_pairs(s: str) {
    if s.len() != 1 or z_sel {
        do_insert_str(s)
        return
    }
    let c = s.byte(0)
    let line = z_lines[z_cl]
    var nxt = 0
    if z_cc < line.len() { nxt = line.byte(z_cc) }
    if (c == 41 or c == 93 or c == 34) and nxt == c {
        z_cc += 1                            // type-over the existing closer
        return
    }
    if c == 40 or c == 91 or c == 34 {
        if nxt == 0 or nxt == 32 or nxt == 41 or nxt == 93 or nxt == 44 {
            var close = ")"
            if c == 91 { close = "]" }
            if c == 34 { close = "\"" }
            do_insert_str(s + close)
            z_cc -= 1
            return
        }
    }
    do_insert_str(s)
}
fn do_insert_str(s: str) {
    if s.len() == 1 and not z_sel { push_undo_kind(1) } else { push_undo() }
    if z_sel { del_sel() }
    let cur = z_lines[z_cl]
    z_lines[z_cl] = cur.sub(0, z_cc) + s + cur.sub(z_cc, cur.len())
    z_cc += s.len()
    mark_edit()
}
fn insert_text(t: str) {
    if z_sel { del_sel() }
    let parts = t.split("\n")
    if parts.len() == 1 {
        let seg = strip_cr(parts[0])
        let cur = z_lines[z_cl]
        z_lines[z_cl] = cur.sub(0, z_cc) + seg + cur.sub(z_cc, cur.len())
        z_cc += seg.len()
    } else {
        let cur = z_lines[z_cl]
        let tail = cur.sub(z_cc, cur.len())
        z_lines[z_cl] = cur.sub(0, z_cc) + strip_cr(parts[0])
        var i = 1
        while i < parts.len() {
            let seg = strip_cr(parts[i])
            if i == parts.len() - 1 {
                insert_line(z_cl + i, seg + tail)
                z_cc = seg.len()
            } else {
                insert_line(z_cl + i, seg)
            }
            i += 1
        }
        z_cl = z_cl + parts.len() - 1
    }
    mark_edit()
}
// Enter handling ported from IntelliJ EnterHandler: keep block indent, add a
// level after an opening bracket, and split a brace pair onto its own lines.
fn do_enter() {
    push_undo()
    if z_sel { del_sel() }
    let cur = z_lines[z_cl]
    var ind = 0
    while ind < cur.len() and (cur.byte(ind) == 32 or cur.byte(ind) == 9) { ind += 1 }
    let base = cur.sub(0, ind)
    let head = cur.sub(0, z_cc)
    let tail = cur.sub(z_cc, cur.len())
    // last non-whitespace char before the caret
    var lc = 0
    var i = head.len() - 1
    while i >= 0 {
        let c = head.byte(i)
        if c != 32 and c != 9 {
            lc = c
            i = 0 - 1
        } else {
            i -= 1
        }
    }
    // first non-whitespace char after the caret (and its index)
    var fc = 0
    var fidx = tail.len()
    var j = 0
    while j < tail.len() {
        let c = tail.byte(j)
        if c != 32 and c != 9 {
            fc = c
            fidx = j
            j = tail.len()
        } else {
            j += 1
        }
    }
    let opener = lc == 123 or lc == 40 or lc == 91
    var indent = base
    if opener { indent = base + "    " }
    z_lines[z_cl] = head
    let pair = (lc == 123 and fc == 125) or (lc == 40 and fc == 41) or (lc == 91 and fc == 93)
    if pair {
        // { | }  ->  put the closer on its own line at the base indent
        insert_line(z_cl + 1, base + tail.sub(fidx, tail.len()))
        insert_line(z_cl + 1, indent)
        z_cl += 1
        z_cc = indent.len()
    } else {
        insert_line(z_cl + 1, indent + tail)
        z_cl += 1
        z_cc = indent.len()
    }
    mark_edit()
}
fn do_backspace() {
    if z_sel {
        push_undo()
        del_sel()
        mark_edit()
        return
    }
    push_undo_kind(2)
    // pair deletion (BackspaceHandler): backspacing between an empty auto-pair
    // — ()  []  ""  — removes both characters, mirroring the auto-close on type
    if z_cc > 0 and z_cc < z_lines[z_cl].len() {
        let cur0 = z_lines[z_cl]
        let lft = cur0.byte(z_cc - 1)
        let rgt = cur0.byte(z_cc)
        let pair = (lft == 40 and rgt == 41) or (lft == 91 and rgt == 93) or (lft == 34 and rgt == 34)
        if pair {
            z_lines[z_cl] = cur0.sub(0, z_cc - 1) + cur0.sub(z_cc + 1, cur0.len())
            z_cc -= 1
            mark_edit()
            return
        }
    }
    if z_cc > 0 {
        let cur = z_lines[z_cl]
        z_lines[z_cl] = cur.sub(0, z_cc - 1) + cur.sub(z_cc, cur.len())
        z_cc -= 1
    } else if z_cl > 0 {
        let prev = z_lines[z_cl - 1]
        let pl = prev.len()
        z_lines[z_cl - 1] = prev + z_lines[z_cl]
        delete_line(z_cl)
        z_cl -= 1
        z_cc = pl
    }
    mark_edit()
}
fn do_delete() {
    if z_sel {
        push_undo()
        del_sel()
        mark_edit()
        return
    }
    push_undo_kind(3)
    let cur = z_lines[z_cl]
    if z_cc < cur.len() {
        z_lines[z_cl] = cur.sub(0, z_cc) + cur.sub(z_cc + 1, cur.len())
    } else if z_cl < z_lines.len() - 1 {
        z_lines[z_cl] = cur + z_lines[z_cl + 1]
        delete_line(z_cl + 1)
    }
    mark_edit()
}

// ---- movement ----
fn clamp_col() {
    if z_cc > z_lines[z_cl].len() { z_cc = z_lines[z_cl].len() }
}
fn move_left() {
    if z_cc > 0 {
        z_cc -= 1
    } else if z_cl > 0 {
        z_cl -= 1
        z_cc = z_lines[z_cl].len()
    }
}
fn move_right() {
    if z_cc < z_lines[z_cl].len() {
        z_cc += 1
    } else if z_cl < z_lines.len() - 1 {
        z_cl += 1
        z_cc = 0
    }
}
fn move_up() {
    let vi = vis_index_of(z_cl)
    if vi > 0 {
        z_cl = z_vis[vi - 1]
        clamp_col()
    }
}
fn move_down() {
    let vi = vis_index_of(z_cl)
    if vi < z_vis.len() - 1 {
        z_cl = z_vis[vi + 1]
        clamp_col()
    }
}
fn page(dir: int) {
    let n = z_ed_h / z_lh
    var vi = vis_index_of(z_cl) + dir * n
    if vi < 0 { vi = 0 }
    if vi > z_vis.len() - 1 { vi = z_vis.len() - 1 }
    z_cl = z_vis[vi]
    clamp_col()
}
fn begin_move(shift: bool) {
    z_sw_level = 0                 // any caret movement restarts SelectWord extension
    if shift {
        if not z_sel {
            z_al = z_cl
            z_ac = z_cc
            z_sel = true
        }
    } else {
        z_sel = false
    }
}
fn do_select_all() {
    z_al = 0
    z_ac = 0
    z_cl = z_lines.len() - 1
    z_cc = z_lines[z_cl].len()
    z_sel = true
}
// keep the caret visible by nudging the pixel scroll offset
fn ensure_caret() {
    let cy = vis_index_of(z_cl) * z_lh      // visual row, fold-aware
    if cy < z_ed_off { z_ed_off = cy }
    if cy + z_lh > z_ed_off + z_ed_h { z_ed_off = cy + z_lh - z_ed_h }
    if z_ed_off < 0 { z_ed_off = 0 }
    nav_maybe_record()
}
// record a navigation stop for Back/Forward: only significant jumps (file
// change or >1 line), never arrow drift or Back/Forward's own motion
fn nav_maybe_record() {
    if z_nav_guard or z_drag or z_path == "" { return }
    if z_navh_pos >= 0 and z_navh_pos < z_navh_path.len() {
        let lp = z_navh_path[z_navh_pos]
        let ll = z_navh_line[z_navh_pos]
        var dl = ll - z_cl
        if dl < 0 { dl = 0 - dl }
        if lp == z_path and dl <= 1 {
            z_navh_line[z_navh_pos] = z_cl   // small move: keep the current slot fresh
            return
        }
    }
    var np: [str] = []                       // significant jump: truncate forward, append
    var nl: [int] = []
    var k = 0
    while k <= z_navh_pos and k < z_navh_path.len() {
        np.push(z_navh_path[k])
        nl.push(z_navh_line[k])
        k += 1
    }
    np.push(z_path)
    nl.push(z_cl)
    if np.len() > 50 {                        // cap history
        var tp: [str] = []
        var tl: [int] = []
        var s = np.len() - 50
        while s < np.len() {
            tp.push(np[s])
            tl.push(nl[s])
            s += 1
        }
        np = tp
        nl = tl
    }
    z_navh_path = np
    z_navh_line = nl
    z_navh_pos = np.len() - 1
}
fn nav_jump_to(p: str, ln: int) {
    z_nav_guard = true
    if p != z_path { open_file(p) }
    z_cl = ln
    if z_cl > z_lines.len() - 1 { z_cl = z_lines.len() - 1 }
    if z_cl < 0 { z_cl = 0 }
    z_cc = 0
    z_sel = false
    ensure_caret()
    z_nav_guard = false
}
fn nav_back() {
    if z_navh_pos > 0 {
        z_navh_pos -= 1
        nav_jump_to(z_navh_path[z_navh_pos], z_navh_line[z_navh_pos])
    }
}
fn nav_forward() {
    if z_navh_pos < z_navh_path.len() - 1 {
        z_navh_pos += 1
        nav_jump_to(z_navh_path[z_navh_pos], z_navh_line[z_navh_pos])
    }
}

// ---- clipboard (CF_TEXT) ----
fn set_clipboard(t: str) {
    // clipboard ring for Paste from History (dedupe to front, cap 10)
    if t.len() > 0 {
        var nr: [str] = []
        nr.push(t)
        for c in z_clips {
            if c != t and nr.len() < 10 { nr.push(c) }
        }
        z_clips = nr
    }
    if win("user32!OpenClipboard", g_hwnd) == 0 { return }
    win("user32!EmptyClipboard")
    let n = t.len()
    let h = win("GlobalAlloc", 2, n + 1)
    let p = win("GlobalLock", h)
    for i in 0..n { store8(p + i, t.byte(i)) }
    store8(p + n, 0)
    win("GlobalUnlock", h)
    win("user32!SetClipboardData", 1, h)
    win("user32!CloseClipboard")
}
fn get_clipboard() -> str {
    if win("user32!OpenClipboard", g_hwnd) == 0 { return "" }
    let h = win("user32!GetClipboardData", 1)
    if h == 0 {
        win("user32!CloseClipboard")
        return ""
    }
    let p = win("GlobalLock", h)
    var chars: [str] = []
    var i = 0
    var b = load8(p + i)
    while b != 0 {
        chars.push(chr(b))
        i += 1
        b = load8(p + i)
    }
    win("GlobalUnlock", h)
    win("user32!CloseClipboard")
    return chars.join()
}
fn do_copy() {
    if z_sel { set_clipboard(sel_text()) }
}
fn do_cut() {
    if not z_sel { return }
    push_undo()
    set_clipboard(sel_text())
    del_sel()
    mark_edit()
}
fn do_paste() {
    let t = normalize_newlines(get_clipboard())
    if t.len() > 0 {
        push_undo()
        insert_text(t)
    }
}

// ---- files ----
fn set_content(content: str) {
    var nl: [str] = []
    // split + strip_cr handles CRLF; rt_str_replace is quadratic on match-heavy
    // strings (grows past the 1GiB heap on a ~270KB CRLF file), so avoid it here
    let raw = content.split("\n")
    var i = 0
    while i < raw.len() {
        nl.push(strip_cr(raw[i]))
        i += 1
    }
    if nl.len() == 0 { nl.push("") }
    z_lines = nl
    z_cl = 0
    z_cc = 0
    z_ed_off = 0
    z_sel = false
    z_edit_seq += 1        // new content invalidates every seq-guarded cache (PSI, symbols)
}
fn load_file(path: str) {
    set_content(read_file(path))
    z_path = path
    z_modified = false
}
fn join_lines() -> str {
    var parts: [str] = []
    var i = 0
    while i < z_lines.len() {
        parts.push(z_lines[i])
        if i < z_lines.len() - 1 { parts.push("\n") }
        i += 1
    }
    return parts.join()
}
fn pad2(n: int) -> str {
    if n < 10 { return "0" + (n as str) }
    return n as str
}
fn now_ts() -> str {
    let st = ualloc(16)
    win("GetLocalTime", st)                 // SYSTEMTIME: wHour@8 wMinute@10 wSecond@12 (WORDs)
    let hh = load64(st + 8) & 65535
    let mm = load64(st + 10) & 65535
    let ss = load64(st + 12) & 65535
    return pad2(hh) + ":" + pad2(mm) + ":" + pad2(ss)
}
fn hist_push() {
    if z_path == "" { return }
    if z_hist.len() >= 60 {
        var n: [Hist] = []
        var i = 1
        while i < z_hist.len() {
            n.push(z_hist[i])
            i += 1
        }
        z_hist = n
    }
    z_hist.push(Hist{path: z_path, ts: now_ts(), body: join_lines()})
}
// trimTrailing, ported from StringUtil: drop trailing spaces/tabs.
fn trim_trailing(s: str) -> str {
    var e = s.len()
    while e > 0 and (s.byte(e - 1) == 32 or s.byte(e - 1) == 9) { e -= 1 }
    return s.sub(0, e)
}
// strip trailing whitespace on save (IntelliJ default), keeping the caret line intact
fn strip_trailing_ws() {
    var i = 0
    while i < z_lines.len() {
        if i != z_cl { z_lines[i] = trim_trailing(z_lines[i]) }
        i += 1
    }
}
fn do_save() {
    if z_path == "" { z_path = "untitled.zeph" }
    strip_trailing_ws()
    if z_path.starts_with("remote:") {
        hist_push()
        remote_save()
        return
    }
    hist_push()                             // snapshot into Local History before overwriting
    write_file(z_path, join_lines())
    z_modified = false
    session_save()
}

// ---- word classification / highlighter ----
fn build_set(words: str) -> [str: bool] {
    var m: [str: bool] = [:]
    for w in words.split(" ") { m[w] = true }
    return m
}
// an ALL_CAPS identifier (>=2 chars, no lowercase, at least one letter) reads as
// a constant — New UI colours these DEFAULT_CONSTANT purple
fn is_const_word(w: str) -> bool {
    if w.len() < 2 { return false }
    var hasletter = false
    var i = 0
    while i < w.len() {
        let c = w.byte(i)
        if c >= 97 and c <= 122 { return false }
        if c >= 65 and c <= 90 { hasletter = true }
        i += 1
    }
    return hasletter
}
fn word_color(w: str) -> int {
    if z_kw.has(w) { return C_KW }
    if z_ty.has(w) { return C_TY }
    if z_builtin.has(w) { return C_BUILTIN }
    if is_const_word(w) { return C_CONST }
    return C_OP
}
// ---- lexer: token stream foundation (IntelliJ Lexer/FlexAdapter analogue) ----
// Zephyr comments are line-based and strings single-line, so per-line lexing is
// complete (no cross-line lexer state needed).
let TK_WS = 0
let TK_COMMENT = 1
let TK_STRING = 2
let TK_NUMBER = 3
let TK_WORD = 4      // identifier / keyword / type / builtin (classified at colour time)
let TK_OP = 5
fn lex_line(s: str) -> [Tok] {
    var toks: [Tok] = []
    let n = s.len()
    var i = 0
    while i < n {
        let c = s.byte(i)
        if c == 32 or c == 9 {
            var j = i
            while j < n and (s.byte(j) == 32 or s.byte(j) == 9) { j += 1 }
            toks.push(Tok{kind: TK_WS, a: i, b: j})
            i = j
        } else if c == 47 and i + 1 < n and s.byte(i + 1) == 47 {
            toks.push(Tok{kind: TK_COMMENT, a: i, b: n})
            i = n
        } else if c == 34 {
            var j = i + 1
            while j < n {
                let cj = s.byte(j)
                if cj == 92 {
                    j += 2
                    continue
                }
                if cj == 34 {
                    j += 1
                    break
                }
                j += 1
            }
            if j > n { j = n }
            toks.push(Tok{kind: TK_STRING, a: i, b: j})
            i = j
        } else if is_digit(c) {
            var j = i + 1
            while j < n and (is_digit(s.byte(j)) or s.byte(j) == 46) { j += 1 }
            toks.push(Tok{kind: TK_NUMBER, a: i, b: j})
            i = j
        } else if is_alpha(c) {
            var j = i + 1
            while j < n and is_alnum(s.byte(j)) { j += 1 }
            toks.push(Tok{kind: TK_WORD, a: i, b: j})
            i = j
        } else {
            toks.push(Tok{kind: TK_OP, a: i, b: i + 1})
            i += 1
        }
    }
    return toks
}
// the identifier right after the `fn` keyword is a function-declaration name,
// coloured DEFAULT_FUNCTION_DECLARATION blue (#56a8f5) like New UI
fn is_decl_name(t: Tok, s: str) -> bool {
    var e = t.a                              // right-trim the text before the token
    while e > 0 and s.byte(e - 1) == 32 { e -= 1 }
    if e < 2 { return false }
    if not (s.byte(e - 1) == 110 and s.byte(e - 2) == 102) { return false }   // ends "fn"
    if e == 2 { return true }                // line begins with "fn "
    return s.byte(e - 3) == 32               // "fn" is a whole keyword (space before)
}
fn tok_color(t: Tok, s: str) -> int {
    if t.kind == TK_COMMENT { return C_CMT }
    if t.kind == TK_STRING { return C_STR }
    if t.kind == TK_NUMBER { return C_NUM }
    if t.kind == TK_WORD {
        if is_decl_name(t, s) { return C_BUILTIN }   // #56a8f5 fn-declaration blue
        return word_color(s.sub(t.a, t.b))
    }
    return C_OP
}
// draw one code line by colouring the lexer's token stream
// render a string literal with escape sequences (\n \t \" \{ ...) in the
// DEFAULT_VALID_STRING_ESCAPE colour (#cf8e6d), the rest in the string colour
fn draw_string_token(cx: int, y: int, s: str, a: int, b: int) -> int {
    var x = cx
    var i = a
    while i < b {
        if s.byte(i) == 92 and i + 1 < b {   // '\' escape -> two chars in escape colour
            let we = ui_run(x, y, s.sub(i, i + 2), C_KW)
            x += we
            i += 2
        } else {
            var j = i
            while j < b and not (s.byte(j) == 92 and j + 1 < b) { j += 1 }
            let wn = ui_run(x, y, s.sub(i, j), C_STR)
            x += wn
            i = j
        }
    }
    return x - cx
}
fn draw_code_line(x0: int, y: int, s: str) {
    let toks = lex_line(s)
    var cx = x0
    var ti = 0
    while ti < toks.len() {
        let t = toks[ti]
        if t.kind == TK_WS {
            if z_show_ws {                   // Show Whitespaces: middle dots, #6f737a
                var dts = ""
                var dk = t.a
                while dk < t.b {
                    dts = dts + chr(183)
                    dk += 1
                }
                let dw = ui_run(cx, y, dts, rgb(111, 115, 122))
            }
            cx += (t.b - t.a) * z_cw
        } else if t.kind == TK_STRING {
            cx += draw_string_token(cx, y, s, t.a, t.b)
        } else {
            let w = ui_run(cx, y, s.sub(t.a, t.b), tok_color(t, s))
            cx += w
        }
        ti += 1
    }
}

// ---- completion + hover-docs ----
fn build_docs() -> [str: str] {
    var d: [str: str] = [:]
    d["print"] = "print(v: any)\nFormat v and append a newline."
    d["emit"] = "emit(s: str)\nWrite s to stdout with no newline."
    d["panic"] = "panic(msg: str)\nPrint to stderr and exit 1."
    d["assert"] = "assert(cond: bool, msg: str?)\nPanic with msg if cond is false."
    d["sqrt"] = "sqrt(x: float) -> float\nSquare root; int widens."
    d["abs"] = "abs(x) -> x\nAbsolute value, int or float."
    d["min"] = "min(a, b) -> number\nSmaller of a and b."
    d["max"] = "max(a, b) -> number\nLarger of a and b."
    d["pow"] = "pow(b: int, e: int) -> int\nFast exponentiation."
    d["chr"] = "chr(code: int) -> str\nOne-byte string for 0..255."
    d["bits"] = "bits(x: float) -> int\nIEEE-754 bit pattern."
    d["frombits"] = "frombits(i: int) -> float\nReinterpret bits as a float."
    d["zeros"] = "zeros(n: int) -> [int]\nList of n zeros."
    d["args"] = "args() -> [str]\nCommand-line arguments."
    d["read_file"] = "read_file(path: str) -> str\nWhole file; panics if unreadable."
    d["write_file"] = "write_file(path: str, data: str)\nCreate/overwrite a file."
    d["len"] = ".len() -> int\nElements in a list or bytes in a string."
    d["push"] = ".push(v)\nAppend v to a list."
    d["pop"] = ".pop() -> T\nRemove/return the last element."
    d["byte"] = "s.byte(i: int) -> int\nByte value at i, bounds-checked."
    d["sub"] = "s.sub(lo: int, hi: int) -> str\nHalf-open [lo, hi) range."
    d["join"] = "l.join() -> str\nConcatenate a [str] in one pass."
    d["split"] = "s.split(sep: str) -> [str]\nSplit on sep."
    d["contains"] = ".contains(x) -> bool\nSubstring or membership test."
    d["index_of"] = ".index_of(x) -> int\nFirst index, or -1."
    d["starts_with"] = "s.starts_with(t) -> bool\nPrefix test."
    d["ends_with"] = "s.ends_with(t) -> bool\nSuffix test."
    d["replace"] = "s.replace(old, new) -> str\nReplace all occurrences."
    d["upper"] = "s.upper() -> str\nASCII uppercase."
    d["lower"] = "s.lower() -> str\nASCII lowercase."
    d["trim"] = "s.trim() -> str\nStrip surrounding whitespace."
    d["repeat"] = "s.repeat(n: int) -> str\nn copies."
    d["sort"] = "l.sort()\nSort in place, ascending."
    d["has"] = "m.has(k) -> bool\nWhether the map has key k."
    d["get"] = "m.get(k) -> V?\nSafe lookup: value or none."
    d["win"] = "win(\"dll!Func\", args...) -> int\nCall a Win32 export."
    d["load64"] = "load64(addr: int) -> int\nRead 8 bytes (unsafe)."
    d["store64"] = "store64(addr, v)\nWrite 8 bytes (unsafe)."
    d["addr"] = "addr(x) -> int\nRaw address of an object (unsafe)."
    return d
}
fn cur_word_start() -> int {
    let s = z_lines[z_cl]
    var a = z_cc
    while a > 0 and is_alnum(s.byte(a - 1)) { a -= 1 }
    return a
}
fn word_at(li: int, col: int) -> str {
    if li < 0 or li >= z_lines.len() { return "" }
    let s = z_lines[li]
    if col < 0 or col >= s.len() { return "" }
    if not is_alnum(s.byte(col)) { return "" }
    var a = col
    while a > 0 and is_alnum(s.byte(a - 1)) { a -= 1 }
    var b = col
    while b < s.len() and is_alnum(s.byte(b)) { b += 1 }
    return s.sub(a, b)
}
fn comp_hide() {
    z_comp_on = false
    var e: [str] = []
    z_comp_items = e
    z_comp_sel = 0
}
fn rebuild_pool() {
    if z_pool_seq == z_edit_seq { return }
    var seen: [str: bool] = [:]
    var out: [str] = []
    for w in z_kw.keys() {
        if not seen.has(w) {
            seen[w] = true
            out.push(w)
        }
    }
    for w in z_ty.keys() {
        if not seen.has(w) {
            seen[w] = true
            out.push(w)
        }
    }
    for w in z_builtin.keys() {
        if not seen.has(w) {
            seen[w] = true
            out.push(w)
        }
    }
    var li = 0
    while li < z_lines.len() {
        let s = z_lines[li]
        for t in lex_line(s) {               // lex-aware: identifiers only, not words
            if t.kind == TK_WORD {           // buried in strings/comments (TK_STRING/TK_COMMENT)
                let w = s.sub(t.a, t.b)
                if is_alpha(s.byte(t.a)) and not seen.has(w) {
                    seen[w] = true
                    out.push(w)
                }
            }
        }
        li += 1
    }
    z_pool = out
    z_pool_seq = z_edit_seq
}
// camel-hump signature of an identifier: first letter + each uppercase letter
// and each letter after '_', lowercased. "fooBar"->"fb", "sort_lines"->"sl"
fn hump_sig(w: str) -> str {
    var out = ""
    var i = 0
    while i < w.len() {
        let c = w.byte(i)
        var take = i == 0
        if not take and c >= 65 and c <= 90 { take = true }          // uppercase hump
        if not take and i > 0 and w.byte(i - 1) == 95 and c != 95 { take = true }  // after '_'
        if take {
            var lc = c
            if lc >= 65 and lc <= 90 { lc = lc + 32 }
            out = out + chr(lc)
        }
        i += 1
    }
    return out
}
// camel-hump completion match (IntelliJ minuscule): query is a prefix of the
// candidate's hump signature — "fb" matches "fooBar", "sl" matches "sort_lines"
fn hump_match(query: str, cand: str) -> bool {
    if query.len() < 2 { return false }      // 1-char humps are too noisy
    return hump_sig(cand).starts_with(query.lower())
}
fn update_comp() {
    let s = z_lines[z_cl]
    let ws = cur_word_start()
    let prefix = s.sub(ws, z_cc)
    var dot = false
    if ws > 0 and s.byte(ws - 1) == 46 { dot = true }
    var items: [str] = []
    if dot {
        for m in z_methods {
            if m.starts_with(prefix) { items.push(m) }
        }
    } else {
        if prefix.len() < 1 {
            comp_hide()
            return
        }
        rebuild_pool()
        for w in z_pool {
            if w.starts_with(prefix) and w != prefix { items.push(w) }
        }
        if prefix.len() >= 2 {               // camel-hump matches after the prefix matches
            for w in z_pool {
                if not w.starts_with(prefix) and hump_match(prefix, w) { items.push(w) }
            }
        }
    }
    if items.len() == 0 {
        comp_hide()
        return
    }
    z_comp_items = items
    z_comp_sel = 0
    z_comp_on = true
}
// commonPrefixLength, ported from StringUtil: length of the shared leading run.
fn common_prefix_len(a: str, b: str) -> int {
    var m = a.len()
    if b.len() < m { m = b.len() }
    var i = 0
    while i < m and a.byte(i) == b.byte(i) { i += 1 }
    return i
}
// shared prefix across all current completion items
fn comp_common_prefix() -> str {
    if z_comp_items.len() == 0 { return "" }
    var pfx = z_comp_items[0]
    var i = 1
    while i < z_comp_items.len() {
        let n = common_prefix_len(pfx, z_comp_items[i])
        pfx = pfx.sub(0, n)
        i += 1
    }
    return pfx
}
// Tab: fill the shared prefix first (IntelliJ completion) if it extends past what's typed
fn comp_fill_common() -> bool {
    let s = z_lines[z_cl]
    let ws = cur_word_start()
    let typed = s.sub(ws, z_cc)
    let pfx = comp_common_prefix()
    if pfx.len() > typed.len() {
        z_lines[z_cl] = s.sub(0, ws) + pfx + s.sub(z_cc, s.len())
        z_cc = ws + pfx.len()
        mark_edit()
        return true
    }
    return false
}
// is `w` a user-declared function? (PSI, for completion's paren insertion)
fn comp_is_fn(w: str) -> bool {
    for nd in parse_decls() {
        if nd.name == w and nd.kind == 1 { return true }
    }
    return false
}
fn comp_accept() {
    if not z_comp_on { return }
    let item = z_comp_items[z_comp_sel]
    let s = z_lines[z_cl]
    let ws = cur_word_start()
    // completing a function inserts () and drops the caret inside (IntelliJ),
    // unless a '(' already follows the caret
    var ins = item
    var back = 0
    var nxt = 0
    if z_cc < s.len() { nxt = s.byte(z_cc) }
    if comp_is_fn(item) and nxt != 40 {
        ins = item + "()"
        back = 1
    }
    z_lines[z_cl] = s.sub(0, ws) + ins + s.sub(z_cc, s.len())
    z_cc = ws + ins.len() - back
    comp_hide()
    mark_edit()
}
fn draw_comp() {
    let n = z_comp_items.len()
    var shown = n
    if shown > 9 { shown = 9 }
    var maxw = 6
    var i = 0
    while i < n {
        if z_comp_items[i].len() > maxw { maxw = z_comp_items[i].len() }
        i += 1
    }
    let boxw = maxw * z_cw + 24
    let boxh = shown * 22 + 8
    var bx = z_caret_px
    var by = z_caret_py + z_lh
    if bx + boxw > ui_w() { bx = ui_w() - boxw - 6 }
    fill_rr(bx, by, boxw, boxh, 10, COL_ITEM)
    frame_rr(bx, by, boxw, boxh, 10, COL_OUTLINE)
    var start = 0
    if z_comp_sel >= shown { start = z_comp_sel - shown + 1 }
    var r = 0
    ui_mono()
    while r < shown {
        let idx = start + r
        if idx >= n { break }
        let ry = by + 4 + r * 22
        if idx == z_comp_sel { fill_rr(bx + 4, ry, boxw - 8, 22, 6, COL_ACTIVE) }
        dtext(bx + 12, ry + 3, z_comp_items[idx], COL_TEXT)
        r += 1
    }
    ui_ui()
}
fn draw_tooltip() {
    let dl = z_hover_doc.split("\n")
    ui_selectn()                             // measure in the same font dtext draws
    var maxw = 0
    for l in dl {
        let lw = text_w(l)                   // real pixel width, not chars*7 (proportional font)
        if lw > maxw { maxw = lw }
    }
    let boxw = maxw + 24
    let boxh = dl.len() * 19 + 20
    var bx = g_mx + 14
    var by = g_my + 20
    if bx + boxw > ui_w() { bx = ui_w() - boxw - 6 }
    if by + boxh > ui_h() { by = g_my - boxh - 8 }
    fill_rr(bx, by, boxw, boxh, 10, COL_TITLE)
    frame_rr(bx, by, boxw, boxh, 10, COL_OUTLINE)
    var i = 0
    while i < dl.len() {
        var c = COL_TEXT
        if i > 0 { c = COL_DIM }
        dtext(bx + 12, by + 10 + i * 19, dl[i], c)
        i += 1
    }
}
// quick-doc text for a word (ShowQuickDocInfoAction port): builtin docs from
// z_docs; else a user symbol's declaration line plus its leading // comment
// block — the same content IntelliJ renders for a source-commented symbol.
fn qdoc_for(w: str) -> str {
    if z_docs.has(w) { return z_docs[w] }
    let nodes = parse_decls()               // PSI consumer: bare declaration names
    var i = 0
    while i < nodes.len() {
        if nodes[i].name == w {
            let dl = nodes[i].line
            var txt = z_lines[dl].trim()
            var c = dl - 1
            while c >= 0 and z_lines[c].trim().starts_with("//") {
                txt = z_lines[c].trim() + "\n" + txt
                c -= 1
            }
            return txt
        }
        i += 1
    }
    return "No quick documentation available."
}
// Parameter Info (ShowParameterInfoHandler port): the enclosing call at the
// caret + which argument the caret is in, token-aware (parens/commas inside
// strings and comments are lexed away). Sets z_pinfo_arg; "" = not in a call.
// ponytail: single-line calls only; track open parens across lines if needed
fn pinfo_find() -> str {
    let s = z_lines[z_cl]
    let toks = lex_line(s)
    var names: [str] = []
    var argcs: [int] = []
    var prevw = ""
    var ti = 0
    while ti < toks.len() {
        let t = toks[ti]
        if t.a >= z_cc { break }
        if t.kind == TK_OP {
            var k = t.a
            while k < t.b and k < z_cc {
                let c = s.byte(k)
                if c == 40 {
                    names.push(prevw)
                    argcs.push(0)
                    prevw = ""
                } else if c == 41 {
                    if names.len() > 0 {
                        let _n = names.pop()
                        let _a = argcs.pop()
                    }
                } else if c == 44 {
                    if names.len() > 0 { argcs[argcs.len() - 1] += 1 }
                }
                k += 1
            }
        } else if t.kind == TK_WORD {
            if t.b <= z_cc { prevw = s.sub(t.a, t.b) }
        } else if t.kind != TK_WS {
            if t.b <= z_cc { prevw = "" }
        }
        ti += 1
    }
    if names.len() == 0 { return "" }
    z_pinfo_arg = argcs[argcs.len() - 1]
    let nm = names[names.len() - 1]
    if nm == "" { return "" }
    if z_docs.has(nm) { return z_docs[nm].split("\n")[0] }
    let nodes = parse_decls()
    var i = 0
    while i < nodes.len() {
        if nodes[i].name == nm and nodes[i].kind == 1 {
            var sig = z_lines[nodes[i].line].trim()
            let br = sig.index_of("\{")
            if br > 0 { sig = sig.sub(0, br).trim() }
            return sig
        }
        i += 1
    }
    return ""
}
// overlay above the caret line; the active parameter draws in blue (IntelliJ bolds)
fn draw_pinfo() {
    let sig = pinfo_find()
    if sig == "" {
        z_pinfo = false
        return
    }
    let boxw = sig.len() * z_cw + 24         // mono font: exact width is len * measured char width
    let boxh = 26
    var bx = z_caret_px
    var by = z_caret_py - boxh - 8
    if by < 0 { by = z_caret_py + z_lh + 6 }
    if bx + boxw > ui_w() { bx = ui_w() - boxw - 6 }
    fill_rr(bx, by, boxw, boxh, 8, COL_TITLE)
    frame_rr(bx, by, boxw, boxh, 8, COL_OUTLINE)
    ui_mono()
    var x = bx + 12
    let y = by + 5
    let op = sig.index_of("(")
    if op < 0 {
        let w0 = ui_run(x, y, sig, COL_TEXT)
    } else {
        x += ui_run(x, y, sig.sub(0, op + 1), COL_TEXT)
        let cp = sig.index_of(")")
        var inner = sig.sub(op + 1, sig.len())
        var suffix = ""
        if cp > op {
            inner = sig.sub(op + 1, cp)
            suffix = sig.sub(cp, sig.len())
        }
        let parts = inner.split(",")
        var i = 0
        while i < parts.len() {
            if i > 0 { x += ui_run(x, y, ",", COL_DIM) }
            var c = COL_DIM
            if i == z_pinfo_arg { c = rgb(86, 168, 245) }
            x += ui_run(x, y, parts[i], c)
            i += 1
        }
        let w1 = ui_run(x, y, suffix, COL_TEXT)
    }
    ui_ui()
}
fn compute_hover() {
    z_hover_word = ""
    if z_comp_on { return }
    if g_mx < z_ed_x or g_mx >= z_ed_x + z_ed_w { return }
    if g_my < z_ed_y or g_my >= z_ed_y + z_ed_h { return }
    let li = (g_my - z_ed_y + z_ed_off) / z_lh
    let col = (g_mx - z_gutx) / z_cw
    let w = word_at(li, col)
    if z_docs.has(w) {
        z_hover_word = w
        z_hover_doc = z_docs[w]
    }
}

// ---- process spine (kernel32 pipes) ----
fn dirname(p: str) -> str {
    var i = p.len() - 1
    while i >= 0 {
        let c = p.byte(i)
        if c == 47 or c == 92 { return p.sub(0, i + 1) }
        i -= 1
    }
    return ""
}
// last path component: "src\sub\" -> "sub", "src\a.zeph" -> "a.zeph"
fn reltail(p: str) -> str {
    var e = p.len()
    if e > 0 and (p.byte(e - 1) == 92 or p.byte(e - 1) == 47) { e -= 1 }
    var i = e - 1
    while i >= 0 {
        let c = p.byte(i)
        if c == 47 or c == 92 { return p.sub(i + 1, e) }
        i -= 1
    }
    return p.sub(0, e)
}
fn parent_of(d: str) -> str {
    if d.len() == 0 { return "" }
    return dirname(d.sub(0, d.len() - 1))
}
fn exe_dir() -> str {
    win("GetModuleFileNameA", 0, z_pathbuf, 512)
    return dirname(read_cstr(z_pathbuf))
}
fn path_exists(path: str) -> bool {
    let attr = win("GetFileAttributesA", z_cstr(path, z_pathbuf))
    return (attr & 4294967295) != 4294967295
}
fn getenv(name: str) -> str {
    let n = win("GetEnvironmentVariableA", z_cstr(name, z_pathbuf), z_io, 512)
    if (n & 4294967295) == 0 { return "" }
    return read_cstr(z_io)
}
fn find_zc() -> str {
    let ed = exe_dir()
    if path_exists(ed + "zc.exe") { return ed + "zc.exe" }
    let par = parent_of(ed)
    if path_exists(par + "zc.exe") { return par + "zc.exe" }
    return "zc.exe"
}
fn find_claude() -> str {
    let base = getenv("APPDATA") + "\\Claude\\claude-code\\"
    let wfd = ualloc(400)
    let hfind = win("FindFirstFileA", z_cstr(base + "*", z_cmd), wfd)
    if hfind == -1 { return "" }
    var best = ""
    var bestname = ""
    var more = 1
    while more != 0 {
        let attr = load64(wfd) & 4294967295
        if (attr & 16) != 0 {
            let name = read_cstr(wfd + 44)
            if name != "." and name != ".." {
                let cand = base + name + "\\claude.exe"
                if path_exists(cand) and name > bestname {
                    bestname = name
                    best = cand
                }
            }
        }
        more = win("FindNextFileA", hfind, wfd)
    }
    win("FindClose", hfind)
    return best
}
// spawn a child, stdout+stderr piped to h[0]; h[8]=proc h[16]=thread. 1 on success.
fn spawn(cmdline: str, cwd: str, h: int) -> int {
    let sa = ualloc(24)
    store32(sa + 0, 24)
    store32(sa + 16, 1)
    let hp = ualloc(16)
    win("CreatePipe", hp, hp + 8, sa, 0)
    let rd = load64(hp)
    let wr = load64(hp + 8)
    win("SetHandleInformation", rd, 1, 0)
    let nul = win("CreateFileA", z_cstr("NUL", z_nulbuf), 2147483648, 3, sa, 3, 0, 0)
    let si = ualloc(104)
    store32(si + 0, 104)
    store32(si + 60, 257)
    store64(si + 80, nul)
    store64(si + 88, wr)
    store64(si + 96, wr)
    let pi = ualloc(24)
    var cwdp = 0
    if cwd != "" { cwdp = z_cstr(cwd, z_cwd) }
    let ok = win("CreateProcessA", 0, z_cstr(cmdline, z_cmd), 0, 0, 1, 134217728, 0, cwdp, si, pi)
    win("CloseHandle", wr)
    win("CloseHandle", nul)
    if ok == 0 {
        win("CloseHandle", rd)
        return 0
    }
    store64(h + 0, rd)
    store64(h + 8, load64(pi + 0))
    store64(h + 16, load64(pi + 8))
    return 1
}
fn run_capture(cmdline: str, cwd: str) -> str {
    if spawn(cmdline, cwd, z_hbuf) == 0 { return "" }
    let rd = load64(z_hbuf + 0)
    var chunks: [str] = []
    var reading = true
    while reading {
        let r = win("ReadFile", rd, z_io, 4096, z_np, 0)
        let got = load64(z_np) & 4294967295
        if r == 0 or got == 0 {
            reading = false
        } else {
            var k = 0
            while k < got {
                chunks.push(chr(load8(z_io + k)))
                k += 1
            }
        }
    }
    win("WaitForSingleObject", load64(z_hbuf + 8), 4294967295)
    win("CloseHandle", load64(z_hbuf + 0))
    win("CloseHandle", load64(z_hbuf + 8))
    win("CloseHandle", load64(z_hbuf + 16))
    return chunks.join()
}
fn run_program(cmdline: str, cwd: str, timeout_ms: int) -> str {
    let h = ualloc(24)
    if spawn(cmdline, cwd, h) == 0 { return "(could not start process)" }
    let rd = load64(h + 0)
    let proc = load64(h + 8)
    var chunks: [str] = []
    let start = tick()
    var done = false
    while not done {
        win("PeekNamedPipe", rd, 0, 0, 0, z_avail, 0)
        let a = load64(z_avail) & 4294967295
        if a > 0 {
            let r = win("ReadFile", rd, z_io, 4096, z_np, 0)
            let got = load64(z_np) & 4294967295
            var k = 0
            while k < got {
                chunks.push(chr(load8(z_io + k)))
                k += 1
            }
            if r == 0 { done = true }
        } else if (win("WaitForSingleObject", proc, 0) & 4294967295) == 0 {
            done = true
        } else if tick() - start > timeout_ms {
            win("TerminateProcess", proc, 1)
            chunks.push("\n(terminated after timeout)")
            done = true
        } else {
            win("Sleep", 8)
        }
    }
    var draining = true
    while draining {
        win("PeekNamedPipe", rd, 0, 0, 0, z_avail, 0)
        if (load64(z_avail) & 4294967295) == 0 {
            draining = false
        } else {
            win("ReadFile", rd, z_io, 4096, z_np, 0)
            let got = load64(z_np) & 4294967295
            if got == 0 {
                draining = false
            } else {
                var k = 0
                while k < got {
                    chunks.push(chr(load8(z_io + k)))
                    k += 1
                }
            }
        }
    }
    win("CloseHandle", load64(h + 0))
    win("CloseHandle", load64(h + 8))
    win("CloseHandle", load64(h + 16))
    return chunks.join()
}
fn mark_edit() {
    z_modified = true
    z_edit_seq += 1
    z_last_edit = tick()
    z_sw_level = 0                 // edits restart SelectWord extension
    z_lastedit_path = z_path       // JumpToLastChangeAction target
    z_lastedit_l = z_cl
    z_lastedit_c = z_cc
}
fn parse_diag(outp: str) {
    z_diag_line = -1
    z_diag_msg = ""
    let key = ": error: "
    let idx = outp.index_of(key)
    if idx < 0 { return }
    var e = idx + key.len()
    var me = e
    while me < outp.len() and outp.byte(me) != 10 { me += 1 }
    z_diag_msg = outp.sub(e, me)
    var startd = idx
    var k = idx - 1
    while k >= 0 and outp.byte(k) >= 48 and outp.byte(k) <= 57 {
        startd = k
        k -= 1
    }
    if startd < idx { z_diag_line = outp.sub(startd, idx) as int }
}
// compute all structural diagnostics; surface the first unless the compiler reported one
fn apply_structural_diag() {
    z_sdiag = lint_structure()
    if z_diag_line >= 0 { return }
    var ai = 0
    while ai < z_sdiag.len() {              // status bar surfaces the first ERROR only;
        if z_sdiag[ai].sev == 0 {           // warnings stay visual (squiggle/stripe/F2)
            z_diag_line = z_sdiag[ai].line + 1
            z_diag_msg = z_sdiag[ai].msg
            return
        }
        ai += 1
    }
}
fn diag_errs(ds: [Diag]) -> int {
    var n = 0
    for d in ds {
        if d.sev == 0 { n += 1 }
    }
    return n
}
// worst severity on a line: 0 error beats 1 warning; -1 = clean
fn line_sdiag_sev(li: int) -> int {
    var sev = 0 - 1
    var i = 0
    while i < z_sdiag.len() {
        if z_sdiag[i].line == li {
            if z_sdiag[i].sev == 0 { return 0 }
            sev = 1
        }
        i += 1
    }
    return sev
}
// F2 / Shift+F2: hop between all diagnostic lines (structural + compiler), wrapping
fn goto_error(dir: int) {
    push_loc()
    var lines2: [int] = []
    var i = 0
    while i < z_sdiag.len() {
        lines2.push(z_sdiag[i].line)
        i += 1
    }
    if z_diag_line >= 1 {
        var dup = false
        for l2 in lines2 {
            if l2 == z_diag_line - 1 { dup = true }
        }
        if not dup { lines2.push(z_diag_line - 1) }
    }
    if lines2.len() == 0 {
        notify("No errors")
        return
    }
    lines2.sort()
    var pick = 0 - 1
    if dir > 0 {
        for l2 in lines2 {
            if l2 > z_cl and pick < 0 { pick = l2 }
        }
        if pick < 0 { pick = lines2[0] }                    // wrap to the first
    } else {
        for l2 in lines2 {
            if l2 < z_cl { pick = l2 }
        }
        if pick < 0 { pick = lines2[lines2.len() - 1] }     // wrap to the last
    }
    z_cl = pick
    if z_cl > z_lines.len() - 1 { z_cl = z_lines.len() - 1 }
    if z_cl < 0 { z_cl = 0 }
    z_cc = 0
    z_sel = false
    ensure_caret()
}
fn line_has_sdiag(li: int) -> bool {
    var i = 0
    while i < z_sdiag.len() {
        if z_sdiag[i].line == li { return true }
        i += 1
    }
    return false
}
// diagnostics run ASYNC (like the Claude and debugger pipes): the compile is
// kicked off here and poll_diag() ingests it from the frame loop, so the UI
// never blocks — IntelliJ's open-instantly, analyze-in-background behavior.
var z_diag_running = false
var z_diag_for = 0            // edit seq this compile represents
var z_diag_tmp = ""
var z_diag_tmpout = ""
var z_diag_acc: [str] = []
let z_dgh = ualloc(24)
fn run_diagnostics() {
    if z_zc == "" {
        z_diag_line = -1
        z_diag_msg = ""
        apply_structural_diag()             // still lint structure without a compiler
        z_diag_seq = z_edit_seq
        return
    }
    if z_diag_running { return }            // one at a time; seq mismatch reschedules
    let dir = dirname(z_path)
    z_diag_tmp = dir + ".zide_check.zeph"
    z_diag_tmpout = dir + ".zide_check.s"
    write_file(z_diag_tmp, join_lines())
    let cmd = "\"" + z_zc + "\" --rt \"" + z_diag_tmp + "\" \"" + z_diag_tmpout + "\""
    if spawn(cmd, dir, z_dgh) == 0 { return }
    var ea: [str] = []
    z_diag_acc = ea
    z_diag_for = z_edit_seq
    z_diag_running = true
}
fn poll_diag() {
    if not z_diag_running { return }
    let rd = load64(z_dgh + 0)
    var more = true
    while more {
        win("PeekNamedPipe", rd, 0, 0, 0, z_avail, 0)
        let a = load64(z_avail) & 4294967295
        if a > 0 {
            let r = win("ReadFile", rd, z_io, 4096, z_np, 0)
            let got = load64(z_np) & 4294967295
            var k = 0
            while k < got {
                z_diag_acc.push(chr(load8(z_io + k)))
                k += 1
            }
            if r == 0 or got == 0 { more = false }
        } else {
            more = false
        }
    }
    if (win("WaitForSingleObject", load64(z_dgh + 8), 0) & 4294967295) != 0 { return }
    win("PeekNamedPipe", rd, 0, 0, 0, z_avail, 0)    // final drain after exit
    if (load64(z_avail) & 4294967295) > 0 { return }
    win("CloseHandle", load64(z_dgh + 0))
    win("CloseHandle", load64(z_dgh + 8))
    win("CloseHandle", load64(z_dgh + 16))
    z_diag_running = false
    win("DeleteFileA", z_cstr(z_diag_tmp, z_pathbuf))
    win("DeleteFileA", z_cstr(z_diag_tmpout, z_pathbuf))
    parse_diag(z_diag_acc.join())
    apply_structural_diag()                 // structural lint when the compiler is clean
    z_diag_seq = z_diag_for
}
fn do_run() {
    if z_zc == "" { return }
    do_save()
    if z_path == "" { return }
    let dir = dirname(z_path)
    let outexe = dir + ".zide_run.exe"
    let cres = run_capture("\"" + z_zc + "\" --rt \"" + z_path + "\" \"" + outexe + "\"", dir)
    if cres.index_of(" error: ") >= 0 {
        z_out = "compile error:\n" + cres
    } else {
        var rres = run_program("\"" + outexe + "\"", dir, 5000)
        win("DeleteFileA", z_cstr(outexe, z_pathbuf))
        if rres == "" { rres = "(program exited with no output)" }
        z_out = rres
    }
    z_show_out = true
    z_bottom = 0
}

// ---- line diff (LCS) for the diff viewer & local history ----
fn diff_compute(a: [str], b: [str]) {
    var l: [int] = []
    var r: [int] = []
    var k: [int] = []
    let n = a.len()
    let m = b.len()
    if n * m > 4000000 or n * m == 0 {       // too big for the DP table -> block diff
        var i0 = 0
        while i0 < n {
            l.push(i0)
            r.push(0 - 1)
            k.push(2)
            i0 += 1
        }
        var j0 = 0
        while j0 < m {
            l.push(0 - 1)
            r.push(j0)
            k.push(1)
            j0 += 1
        }
        z_diff_l = l
        z_diff_r = r
        z_diff_k = k
        return
    }
    let w = m + 1
    let dp = zeros((n + 1) * w)
    var i = n - 1
    while i >= 0 {
        var j = m - 1
        while j >= 0 {
            if a[i] == b[j] {
                dp[i * w + j] = dp[(i + 1) * w + (j + 1)] + 1
            } else {
                let d1 = dp[(i + 1) * w + j]
                let d2 = dp[i * w + (j + 1)]
                if d1 >= d2 { dp[i * w + j] = d1 } else { dp[i * w + j] = d2 }
            }
            j -= 1
        }
        i -= 1
    }
    var ii = 0
    var jj = 0
    while ii < n and jj < m {
        if a[ii] == b[jj] {
            l.push(ii)
            r.push(jj)
            k.push(0)
            ii += 1
            jj += 1
        } else if dp[(ii + 1) * w + jj] >= dp[ii * w + (jj + 1)] {
            l.push(ii)
            r.push(0 - 1)
            k.push(2)
            ii += 1
        } else {
            l.push(0 - 1)
            r.push(jj)
            k.push(1)
            jj += 1
        }
    }
    while ii < n {
        l.push(ii)
        r.push(0 - 1)
        k.push(2)
        ii += 1
    }
    while jj < m {
        l.push(0 - 1)
        r.push(jj)
        k.push(1)
        jj += 1
    }
    z_diff_l = l
    z_diff_r = r
    z_diff_k = k
}
fn open_diff(ref: [str], title: str) {
    z_diff_ref = ref
    z_diff_title = title
    z_diff_off = 0
    diff_compute(ref, z_lines)
    z_popup = 14
    z_popup_frame = g_frame
}

// ---- multiple carets (one per line; Alt+click / Ctrl+Alt+Up-Down) ----
fn mc_clear() {
    var e: [int] = []
    z_carets = e
    z_mc_sellen = 0
}
fn mc_add(li: int, col: int) {
    if li == z_cl { return }
    var hit = false
    for c in z_carets {
        if c / 1000000 == li { hit = true }  // one caret per line
    }
    if hit {                                 // IntelliJ gesture TOGGLES: re-click removes
        var n: [int] = []
        for c in z_carets {
            if c / 1000000 != li { n.push(c) }
        }
        z_carets = n
        return
    }
    z_carets.push(li * 1000000 + col)
}
fn mc_insert(s: str) {
    push_undo()
    let sel = z_mc_sellen                    // same word-selection under every caret
    z_mc_sellen = 0                          // consumed by this edit (select-to-replace)
    let cur = z_lines[z_cl]
    var mend = z_cc + sel
    if mend > cur.len() { mend = cur.len() }
    z_lines[z_cl] = cur.sub(0, z_cc) + s + cur.sub(mend, cur.len())
    z_cc += s.len()
    var i = 0
    while i < z_carets.len() {
        let l = z_carets[i] / 1000000
        var c = z_carets[i] % 1000000
        if l < z_lines.len() and c <= z_lines[l].len() {
            let ls = z_lines[l]
            var e = c + sel
            if e > ls.len() { e = ls.len() }
            z_lines[l] = ls.sub(0, c) + s + ls.sub(e, ls.len())
            z_carets[i] = l * 1000000 + (c + s.len())
        }
        i += 1
    }
    mark_edit()
}
fn mc_backspace() {
    if z_mc_sellen > 0 {                     // selection present: delete it, don't backspace
        mc_insert("")
        return
    }
    push_undo()
    if z_cc > 0 {
        let cur = z_lines[z_cl]
        z_lines[z_cl] = cur.sub(0, z_cc - 1) + cur.sub(z_cc, cur.len())
        z_cc -= 1
    }
    var i = 0
    while i < z_carets.len() {
        let l = z_carets[i] / 1000000
        var c = z_carets[i] % 1000000
        if l < z_lines.len() and c > 0 and c <= z_lines[l].len() {
            let ls = z_lines[l]
            z_lines[l] = ls.sub(0, c - 1) + ls.sub(c, ls.len())
            z_carets[i] = l * 1000000 + (c - 1)
        }
        i += 1
    }
    mark_edit()
}
fn add_caret_below() {
    if z_cl < z_lines.len() - 1 {
        z_carets.push(z_cl * 1000000 + z_cc)
        z_cl += 1
        clamp_col()
    }
}
fn add_caret_above() {
    if z_cl > 0 {
        z_carets.push(z_cl * 1000000 + z_cc)
        z_cl -= 1
        clamp_col()
    }
}

// ---- debugger: instrument breakpoints, run, replay the execution trace ----
fn is_bp_here(li: int) -> bool {
    let key = z_path + ":" + (li as str)
    for b in z_breaks {
        if b == key { return true }
    }
    return false
}
// build the injected wait-helper (fwd-slash resume path, so no backslash escaping)
fn dbg_helper(resume: str) -> [str] {
    var h: [str] = []
    h.push("fn __zdw_cstr(s: str) -> int \{")
    h.push("    let b = zeros(s.len() / 8 + 2)")
    h.push("    let d = load64(addr(b) + 16)")
    h.push("    var i = 0")
    h.push("    while i < s.len() \{")
    h.push("        store8(d + i, s.byte(i))")
    h.push("        i += 1")
    h.push("    \}")
    h.push("    store8(d + s.len(), 0)")
    h.push("    return d")
    h.push("\}")
    h.push("let __ZDW_P = __zdw_cstr(\"" + resume + "\")")
    h.push("fn __zdw() \{")
    h.push("    while true \{")
    h.push("        let a = win(\"GetFileAttributesA\", __ZDW_P)")
    h.push("        if (a & 4294967295) != 4294967295 \{")
    h.push("            let dd = win(\"DeleteFileA\", __ZDW_P)")
    h.push("            return")
    h.push("        \}")
    h.push("        let s = win(\"Sleep\", 12)")
    h.push("    \}")
    h.push("\}")
    return h
}
fn join_nl(lst: [str]) -> str {
    var parts: [str] = []
    var i = 0
    while i < lst.len() {
        parts.push(lst[i])
        if i < lst.len() - 1 { parts.push("\n") }
        i += 1
    }
    return parts.join()
}
fn dbg_start() {
    if z_zc == "" { return }
    if z_dbg_running { dbg_stop() }
    do_save()
    var any = false
    var li = 0
    while li < z_lines.len() {
        if is_bp_here(li) { any = true }
        li += 1
    }
    if not any {
        notify("Set a breakpoint first (click the gutter)")
        return
    }
    let dir = dirname(z_path)
    z_dbg_dir = dir
    let resume = (dir + ".zide_go").replace(chr(92), "/")
    win("DeleteFileA", z_cstr((dir + ".zide_go"), z_pathbuf))   // clear any stale signal
    // instrument: prepend the wait-helper; at each breakpoint emit marker + watches, then wait
    var out: [str] = []
    for hl in dbg_helper(resume) { out.push(hl) }
    li = 0
    while li < z_lines.len() {
        if is_bp_here(li) {
            out.push("emit(\"~ZBP~" + ((li + 1) as str) + "\\n\")")
            var wi = 0
            while wi < z_dbg_watches.len() {
                let w = z_dbg_watches[wi]
                out.push("emit(\"~ZW~" + w + "=\" + ((" + w + ") as str) + \"\\n\")")
                wi += 1
            }
            out.push("__zdw()")
        }
        out.push(z_lines[li])
        li += 1
    }
    let tmp = dir + ".zide_dbg.zeph"
    let tmpexe = dir + ".zide_dbg.exe"
    write_file(tmp, join_nl(out))
    let cres = run_capture("\"" + z_zc + "\" --rt \"" + tmp + "\" \"" + tmpexe + "\"", dir)
    win("DeleteFileA", z_cstr(tmp, z_pathbuf))
    if cres.index_of(" error: ") >= 0 {
        z_out = "cannot debug - the file (or a watch) has a compile error:\n" + cres
        show_dock(0)
        win("DeleteFileA", z_cstr(tmpexe, z_pathbuf))
        return
    }
    // launch ASYNC and keep the pipe; the child halts at breakpoints on the resume file
    if spawn("\"" + tmpexe + "\"", dir, z_hbuf) == 0 {
        notify("could not start debug process")
        return
    }
    z_dbg_rd = load64(z_hbuf + 0)
    z_dbg_proc = load64(z_hbuf + 8)
    z_dbg_thread = load64(z_hbuf + 16)
    z_dbg_running = true
    z_dbg_paused = false
    z_dbg_on = true
    z_dbg_partial = ""
    var eo: [str] = []
    z_dbg_out = eo
    var ev: [str] = []
    z_dbg_vars = ev
    show_dock(5)
    notify("Debugging - running to first breakpoint")
}
fn dbg_resume() {                           // let the halted child continue
    if not z_dbg_paused { return }
    write_file(z_dbg_dir + ".zide_go", "1")
    z_dbg_paused = false
}
fn dbg_step() { dbg_resume() }              // step = run to the next breakpoint hit
fn poll_dbg() {
    if not z_dbg_running { return }
    // drain the pipe
    let buf = ualloc(4096)
    let np = ualloc(8)
    let avail = ualloc(8)
    win("PeekNamedPipe", z_dbg_rd, 0, 0, 0, avail, 0)
    var a = load64(avail) & 4294967295
    while a > 0 {
        let rr = win("ReadFile", z_dbg_rd, buf, 4096, np, 0)
        let got = load64(np) & 4294967295
        if got == 0 { break }
        var chunk: [str] = []
        var k = 0
        while k < got {
            let bb = load8(buf + k)
            if bb != 13 { chunk.push(chr(bb)) }
            k += 1
        }
        z_dbg_partial = z_dbg_partial + chunk.join()
        win("PeekNamedPipe", z_dbg_rd, 0, 0, 0, avail, 0)
        a = load64(avail) & 4294967295
    }
    // consume complete lines
    var nl = z_dbg_partial.index_of("\n")
    while nl >= 0 {
        let ln = z_dbg_partial.sub(0, nl)
        z_dbg_partial = z_dbg_partial.sub(nl + 1, z_dbg_partial.len())
        if ln.starts_with("~ZBP~") {
            z_dbg_line = ln.sub(5, ln.len()).trim() as int
            z_dbg_paused = true
            z_dbg_pos += 1
            var ev2: [str] = []
            z_dbg_vars = ev2                // fresh watch values for this stop
            z_cl = z_dbg_line - 1
            clamp_col()
            ensure_caret()
        } else if ln.starts_with("~ZW~") {
            z_dbg_vars.push(ln.sub(4, ln.len()))
        } else {
            z_dbg_out.push(ln)
        }
        nl = z_dbg_partial.index_of("\n")
    }
    // finished?
    if (win("WaitForSingleObject", z_dbg_proc, 0) & 4294967295) == 0 {
        win("CloseHandle", z_dbg_rd)
        win("CloseHandle", z_dbg_proc)
        win("CloseHandle", z_dbg_thread)
        z_dbg_running = false
        z_dbg_paused = false
        notify("Debug session finished")
    }
}
fn dbg_stop() {
    if z_dbg_running {
        win("TerminateProcess", z_dbg_proc, 1)
        win("CloseHandle", z_dbg_rd)
        win("CloseHandle", z_dbg_proc)
        win("CloseHandle", z_dbg_thread)
    }
    win("DeleteFileA", z_cstr((z_dbg_dir + ".zide_dbg.exe"), z_pathbuf))
    z_dbg_running = false
    z_dbg_paused = false
    z_dbg_on = false
}

// ---- profiler: instrument every line, run, tally execution counts ----
fn prof_start() {
    if z_zc == "" { return }
    do_save()
    let dir = dirname(z_path)
    var out: [str] = []
    var li = 0
    while li < z_lines.len() {
        let t = z_lines[li].trim()
        // only instrument executable statements (skip blanks, comments, braces, decls of fn/struct)
        if t != "" and not t.starts_with("//") and not t.starts_with("fn ") and not t.starts_with("struct ") and not t.starts_with("enum ") and t != "\}" and t != "\{" {
            out.push("emit(\"~ZP~" + ((li + 1) as str) + "\\n\")")
        }
        out.push(z_lines[li])
        li += 1
    }
    let tmp = dir + ".zide_prof.zeph"
    let tmpexe = dir + ".zide_prof.exe"
    write_file(tmp, join_nl(out))
    let cres = run_capture("\"" + z_zc + "\" --rt \"" + tmp + "\" \"" + tmpexe + "\"", dir)
    win("DeleteFileA", z_cstr(tmp, z_pathbuf))
    if cres.index_of(" error: ") >= 0 {
        z_out = "cannot profile - compile error:\n" + cres
        show_dock(0)
        return
    }
    let trace = run_program("\"" + tmpexe + "\"", dir, 8000)
    win("DeleteFileA", z_cstr(tmpexe, z_pathbuf))
    var counts = zeros(z_lines.len() + 2)
    var mx = 0
    for ln in trace.split("\n") {
        if ln.starts_with("~ZP~") {
            let li2 = ln.sub(4, ln.len()).trim() as int
            if li2 >= 1 and li2 <= z_lines.len() {
                counts[li2] = counts[li2] + 1
                if counts[li2] > mx { mx = counts[li2] }
            }
        }
    }
    z_prof = counts
    z_prof_max = mx
    z_prof_on = true
    notify("Profiled - hottest line ran {mx} times")
}

// ---- plugin system (external Zephyr scripts that transform the buffer) ----
fn scan_plugins() {
    var out: [str] = []
    let base = exe_dir() + "plugins\\"
    let wfd = ualloc(400)
    let hfind = win("FindFirstFileA", z_cstr(base + "*.zeph", z_cmd), wfd)
    if hfind != -1 {
        var more = 1
        while more != 0 {
            let name = read_cstr(wfd + 44)
            if name.ends_with(".zeph") and out.len() < 30 { out.push(name) }
            more = win("FindNextFileA", hfind, wfd)
        }
        win("FindClose", hfind)
    }
    z_plugins = out
}
// a plugin reads args()[1] (the file), transforms it, and emits the result to stdout
// a plugin's action label: "sort_lines.zeph" -> "Sort Lines" (filename only, no
// per-frame file read since Search Everywhere rebuilds results every frame)
fn plugin_label(name: str) -> str {
    var base = name
    if base.ends_with(".zeph") { base = base.sub(0, base.len() - 5) }
    var out = ""
    var cap = true
    var i = 0
    while i < base.len() {
        let c = base.byte(i)
        if c == 95 {                         // '_' -> space
            out = out + " "
            cap = true
        } else if cap and c >= 97 and c <= 122 {
            out = out + chr(c - 32)          // capitalise word starts
            cap = false
        } else {
            out = out + chr(c)
            cap = false
        }
        i += 1
    }
    return out
}
fn run_plugin(name: str) {
    if z_zc == "" { return }
    do_save()
    let base = exe_dir() + "plugins\\"
    let pexe = base + ".zide_plugin.exe"
    let cres = run_capture("\"" + z_zc + "\" --rt \"" + base + name + "\" \"" + pexe + "\"", exe_dir())
    if cres.index_of(" error: ") >= 0 {
        z_out = "plugin '" + name + "' failed to compile:\n" + cres
        show_dock(0)
        return
    }
    // selection-aware (IntelliJ text actions transform the selection): with a
    // selection, feed the plugin only the selected text and replace just that;
    // otherwise transform the whole file as before
    if z_sel {
        let sel = sel_text()
        let seltmp = base + ".zide_plugin_sel.txt"
        write_file(seltmp, sel)
        let selout = run_program("\"" + pexe + "\" \"" + seltmp + "\"", exe_dir(), 8000)
        win("DeleteFileA", z_cstr(pexe, z_pathbuf))
        win("DeleteFileA", z_cstr(seltmp, z_pathbuf))
        if selout == "" {
            notify("Plugin produced no output")
            return
        }
        push_undo()
        del_sel()
        insert_text(strip_nl_tail(selout))
        mark_edit()
        run_diagnostics()
        notify("Applied plugin to selection: " + name)
        return
    }
    let outp = run_program("\"" + pexe + "\" \"" + z_path + "\"", dirname(z_path), 8000)
    win("DeleteFileA", z_cstr(pexe, z_pathbuf))
    if outp.trim() == "" {
        notify("Plugin produced no output")
        return
    }
    hist_push()
    set_content(outp)
    z_modified = true
    run_diagnostics()
    notify("Applied plugin: " + name)
}

// ---- remote development over SSH ----
fn remote_run(cmd: str) -> str {
    if z_remote == "" { return "" }
    return run_capture("ssh " + z_remote + " \"cd " + z_remote_dir + " && " + esc_arg(cmd) + "\"", "")
}
fn remote_open(name: str) {
    if z_remote == "" { return }
    let body = run_capture("ssh " + z_remote + " \"cat " + z_remote_dir + "/" + name + "\"", "")
    tab_store()
    z_tabs.push(TabS.new("remote:" + name, [""]))
    tab_load(z_tabs.len() - 1)
    set_content(body)
    z_path = "remote:" + name
    z_modified = false
    notify("Opened " + z_remote + ":" + name)
}
fn remote_save() {
    if z_remote == "" { return }
    let name = z_path.sub(7, z_path.len())   // strip "remote:"
    let tmp = z_zc                            // reuse a scratch dir? write local temp then scp
    let ltmp = dirname(z_zc) + ".zide_remote_tmp"
    write_file(ltmp, join_lines())
    run_capture("scp \"" + ltmp + "\" " + z_remote + ":" + z_remote_dir + "/" + name, "")
    win("DeleteFileA", z_cstr(ltmp, z_pathbuf))
    z_modified = false
    notify("Saved to " + z_remote + ":" + name)
}

// ---- Terminal tool window (real command runner) ----
fn term_run() {
    let cmd = z_term_in.trim()
    z_term_in = ""
    if cmd == "" { return }
    if cmd == "clear" or cmd == "cls" {
        z_term_out = ""
        return
    }
    z_term_out = z_term_out + "> " + cmd + "\n"
    var outp = ""
    if z_remote != "" {
        outp = remote_run(cmd)              // run on the remote host over SSH
    } else {
        outp = run_capture("cmd /c " + cmd, dirname(z_path))   // shell builtins + pipes
    }
    z_term_out = z_term_out + outp
    if not z_term_out.ends_with("\n") { z_term_out = z_term_out + "\n" }
    z_term_off = 1000000
}
// ---- Commit / Version Control tool window (git) ----
fn git_refresh() {
    let outp = run_capture("git status --porcelain", dirname(z_path))
    var g: [str] = []
    for l in outp.split("\n") {
        if l.trim() != "" and g.len() < 40 { g.push(l) }
    }
    z_git = g
}
fn git_commit() {
    if z_commit_msg.trim() == "" {
        notify("Enter a commit message")
        return
    }
    run_capture("git add -A", dirname(z_path))
    run_capture("git commit -m \"" + esc_arg(z_commit_msg) + "\"", dirname(z_path))
    notify("Committed: " + z_commit_msg)
    z_commit_msg = ""
    git_refresh()
    z_lst_path = ""                          // HEAD moved: refetch the gutter baseline
    z_lst_seq = -1
}
fn show_dock(tab: int) {
    z_show_out = true
    z_bottom = tab
    if tab == 2 { scan_todos() }
    if tab == 4 { git_refresh() }
}

// ---- Claude chat (async) ----
fn esc_arg(s: str) -> str {
    var r = s.replace("\"", "'")
    r = r.replace("\n", " ")
    r = r.replace(chr(13), " ")
    return r
}
fn wrap(text: str, cols0: int) -> [str] {
    var out: [str] = []
    var cols = cols0
    if cols < 8 { cols = 8 }
    for para in text.split("\n") {
        var line = ""
        for word in para.split(" ") {
            if line == "" {
                line = word
            } else if line.len() + 1 + word.len() <= cols {
                line = line + " " + word
            } else {
                out.push(line)
                line = word
            }
            while line.len() > cols {
                out.push(line.sub(0, cols))
                line = line.sub(cols, line.len())
            }
        }
        out.push(line)
    }
    return out
}
fn chat_note(role: int, text: str) {
    z_msgs.push(ChatMsg{role: role, text: text})
    z_chat_off = 1000000
}
fn chat_submit() {
    if z_ai_running { return }
    let prompt = z_chat_input.trim()
    if prompt == "" { return }
    z_chat_input = ""
    chat_note(0, prompt)
    if z_claude == "" {
        chat_note(2, "claude.exe not found under %APPDATA%\\Claude.")
        return
    }
    if z_path != "" and z_modified { do_save() }
    var ctx = ""
    if z_path != "" { ctx = "The file open in my editor is " + z_path + ". " }
    let cmd = "\"" + z_claude + "\" -p \"" + esc_arg(ctx + prompt) + "\" --output-format text --permission-mode acceptEdits"
    if spawn(cmd, dirname(z_path), z_hbuf) == 0 {
        chat_note(2, "could not start claude.exe")
        return
    }
    z_ai_rd = load64(z_hbuf + 0)
    z_ai_proc = load64(z_hbuf + 8)
    z_ai_thread = load64(z_hbuf + 16)
    z_ai_running = true
    z_ai_partial = ""
    chat_note(1, "...")
}
fn ai_drain() -> bool {
    var changed = false
    win("PeekNamedPipe", z_ai_rd, 0, 0, 0, z_avail, 0)
    var a = load64(z_avail) & 4294967295
    while a > 0 {
        let r = win("ReadFile", z_ai_rd, z_io, 4096, z_np, 0)
        let got = load64(z_np) & 4294967295
        if got == 0 { break }
        var chunk: [str] = []
        var k = 0
        while k < got {
            let b = load8(z_io + k)
            if b != 13 { chunk.push(chr(b)) }
            k += 1
        }
        z_ai_partial = z_ai_partial + chunk.join()
        changed = true
        if r == 0 { break }
        win("PeekNamedPipe", z_ai_rd, 0, 0, 0, z_avail, 0)
        a = load64(z_avail) & 4294967295
    }
    return changed
}
fn poll_ai() {
    if not z_ai_running { return }
    if ai_drain() {
        z_msgs[z_msgs.len() - 1] = ChatMsg{role: 1, text: z_ai_partial}
        z_chat_off = 1000000
    }
    if (win("WaitForSingleObject", z_ai_proc, 0) & 4294967295) == 0 {
        ai_drain()
        win("CloseHandle", z_ai_rd)
        win("CloseHandle", z_ai_proc)
        win("CloseHandle", z_ai_thread)
        z_ai_running = false
        var final = z_ai_partial.trim()
        if final == "" { final = "(no response)" }
        z_msgs[z_msgs.len() - 1] = ChatMsg{role: 1, text: final}
        z_chat_off = 1000000
        if z_path != "" {
            let disk = read_file(z_path)
            if disk != join_lines() {
                set_content(disk)
                z_modified = false
                chat_note(2, "(reloaded " + z_path + " - Claude edited it)")
                run_diagnostics()
            }
        }
    }
}
// JetBrains keymap actions (from $default.xml): Ctrl+D / Ctrl+Y / Ctrl+Slash
// Ctrl+D duplicate, ported from DuplicateAction: with a selection, insert the copy
// after it and re-select the duplicate; otherwise clone the line below, caret follows.
fn dup_line() {
    push_undo()
    if z_sel {
        let t = sel_text()
        norm_sel()
        z_cl = z_nel
        z_cc = z_nec
        z_sel = false
        let sl = z_cl
        let sc = z_cc
        insert_text(t)
        z_al = sl
        z_ac = sc
        z_sel = true              // setSelection(end, end+len): the new copy stays selected
    } else {
        insert_line(z_cl + 1, z_lines[z_cl])
        z_cl += 1
    }
    mark_edit()
}
// Show Intention Actions (Alt+Enter): a quick-fix for the diagnostic under the
// caret. Single-line statement warnings offer a "delete" fix; ceiling is these
// two — extend as more inspections gain fixes.
// the name inside single quotes in a diagnostic message ("... 'foo' ..."), or ""
fn qf_diag_name(msg: str) -> str {
    let a = msg.index_of("'")
    if a < 0 { return "" }
    let rest = msg.sub(a + 1, msg.len())
    let b = rest.index_of("'")
    if b < 0 { return "" }
    return rest.sub(0, b)
}
fn qf_label_for(li: int) -> str {
    for d in z_sdiag {
        if d.line == li {
            if d.msg == "unreachable code" { return "Remove unreachable code" }
            if d.msg.contains("assigned to itself") { return "Remove redundant assignment" }
            if d.msg.contains("is never used") { return "Safe delete '" + qf_diag_name(d.msg) + "'" }
        }
    }
    return ""
}
fn qf_open() {
    z_qf_label = qf_label_for(z_cl)
    if z_qf_label == "" {
        notify("No quick-fixes at the caret")
        return
    }
    z_popup = 24
    z_popup_frame = g_frame
}
fn qf_apply() {
    z_popup = 0
    if z_qf_label == "" { return }
    if z_qf_label.starts_with("Safe delete") {   // unused-declaration fix removes the whole span
        for d in z_sdiag {
            if d.line == z_cl and d.msg.contains("is never used") {
                safe_delete_named(qf_diag_name(d.msg))
                return
            }
        }
    }
    del_line()                               // unreachable / self-assignment: drop the line
}
fn del_line() {
    push_undo()
    delete_line(z_cl)
    if z_cl > z_lines.len() - 1 { z_cl = z_lines.len() - 1 }
    clamp_col()
    z_sel = false
    mark_edit()
}
// Ctrl+/ : toggle line comment; works across a multi-line selection
fn toggle_comment() {
    push_undo()
    var a = z_cl
    var b = z_cl
    if z_sel {
        norm_sel()
        a = z_nsl
        b = z_nel
    }
    var allc = true
    var li = a
    while li <= b {
        let t = z_lines[li].trim()
        if t != "" and not t.starts_with("//") { allc = false }
        li += 1
    }
    // IntelliJ CommentByLineCommentHandler: align markers to the block's min indent
    var minind = 1000000
    li = a
    while li <= b {
        let s = z_lines[li]
        if s.trim() != "" {
            var ind0 = 0
            while ind0 < s.len() and s.byte(ind0) == 32 { ind0 += 1 }
            if ind0 < minind { minind = ind0 }
        }
        li += 1
    }
    if minind == 1000000 { minind = 0 }
    li = a
    while li <= b {
        let s = z_lines[li]
        var ind = 0
        while ind < s.len() and s.byte(ind) == 32 { ind += 1 }
        let rest = s.sub(ind, s.len())
        if allc {
            if rest.starts_with("// ") {
                z_lines[li] = s.sub(0, ind) + rest.sub(3, rest.len())
            } else if rest.starts_with("//") {
                z_lines[li] = s.sub(0, ind) + rest.sub(2, rest.len())
            }
        } else {
            if s.trim() != "" {
                z_lines[li] = s.sub(0, minind) + "// " + s.sub(minind, s.len())
            }
        }
        li += 1
    }
    clamp_col()
    mark_edit()
}
// Ctrl+Shift+J join lines, ported from JoinLinesHandler: strip trailing ws of the
// upper line and leading ws of the next, insert one space (none if next is blank).
fn z_rstrip(s: str) -> str {
    var e = s.len()
    while e > 0 and (s.byte(e - 1) == 32 or s.byte(e - 1) == 9) { e -= 1 }
    return s.sub(0, e)
}
fn z_lstrip(s: str) -> str {
    var b = 0
    while b < s.len() and (s.byte(b) == 32 or s.byte(b) == 9) { b += 1 }
    return s.sub(b, s.len())
}
fn join_once(li: int) {
    if li >= z_lines.len() - 1 { return }
    let l1 = z_rstrip(z_lines[li])
    let l2 = z_lstrip(z_lines[li + 1])
    var joined = l1
    if l2 != "" { joined = l1 + " " + l2 }
    z_lines[li] = joined
    delete_line(li + 1)
    z_cl = li
    z_cc = l1.len()
}
fn join_lines_action() {
    push_undo()
    var a = z_cl
    var b = z_cl
    if z_sel {
        norm_sel()
        a = z_nsl
        b = z_nel
    }
    var n = b - a
    if n < 1 { n = 1 }
    var k = 0
    while k < n and a < z_lines.len() - 1 {
        join_once(a)
        k += 1
    }
    z_sel = false
    mark_edit()
}
// smart Home, ported from EditorActionUtil.moveCaretToLineStart: toggle the
// caret between the first non-whitespace column and column 0.
fn smart_home_col(line: str, cc: int) -> int {
    var fnw = 0
    while fnw < line.len() and (line.byte(fnw) == 32 or line.byte(fnw) == 9) { fnw += 1 }
    if fnw == line.len() { fnw = 0 }
    if cc == fnw { return 0 }
    return fnw
}
// Tab / Shift+Tab block indent, ported from Indent/UnindentSelectionAction:
// shift every line in the block one level; unindent rounds back to a tab stop.
fn indent_block(dir: int) {
    push_undo()
    var a = z_cl
    var b = z_cl
    if z_sel {
        norm_sel()
        a = z_nsl
        b = z_nel
        if z_nec == 0 and b > a { b -= 1 }
    }
    var li = a
    while li <= b {
        let s = z_lines[li]
        if dir > 0 {
            if s != "" { z_lines[li] = "    " + s }
        } else {
            var r = 0
            while r < 4 and r < s.len() and s.byte(r) == 32 { r += 1 }
            z_lines[li] = s.sub(r, s.len())
        }
        li += 1
    }
    if dir > 0 {
        z_cc += 4
        if z_sel { z_ac += 4 }
    } else {
        if z_cc >= 4 { z_cc -= 4 } else { z_cc = 0 }
        if z_sel {
            if z_ac >= 4 { z_ac -= 4 } else { z_ac = 0 }
        }
    }
    clamp_col()
    mark_edit()
}
// Ctrl+Shift+U toggle case, ported from ToggleCaseAction: if the text is already
// all-lowercase, upper-case it; otherwise lower-case it. Acts on the word if no selection.
fn toggle_case() {
    if not z_sel {
        let s0 = z_lines[z_cl]
        var a = z_cc
        while a > 0 and ea_id_part(s0.byte(a - 1)) { a -= 1 }
        var b = z_cc
        while b < s0.len() and ea_id_part(s0.byte(b)) { b += 1 }
        if b == a { return }
        z_al = z_cl
        z_ac = a
        z_cc = b
        z_sel = true
    }
    push_undo()
    let t = sel_text()
    var out = t.lower()
    if t == t.lower() { out = t.upper() }
    del_sel()
    insert_text(out)
    mark_edit()
}
// FoldingBuilder analogue: fold every declaration the parser found (shares the
// parse tree with the Structure view instead of re-scanning line prefixes).
fn fold_all() {
    var f: [int] = []
    let nodes = parse_decls()
    var i = 0
    while i < nodes.len() {
        let li = nodes[i].line
        if foldable(li) { f.push(li) }
        i += 1
    }
    z_folds = f
    notify("Collapsed all")
}
fn unfold_all() {
    var e: [int] = []
    z_folds = e
    notify("Expanded all")
}
// replace all whole-word occurrences of `old` with `nw` in a line
// rename one line's identifier TOKENS only — strings and comments are lexed
// away, so "old" inside a literal or comment survives (IntelliJ rename default)
fn rename_line(s: str, old: str, nw: str) -> str {
    let toks = lex_line(s)
    var out = ""
    var pos = 0
    var ti = 0
    while ti < toks.len() {
        let t = toks[ti]
        if t.kind == TK_WORD and s.sub(t.a, t.b) == old {
            out = out + s.sub(pos, t.a) + nw
            pos = t.b
        }
        ti += 1
    }
    if pos == 0 { return s }
    return out + s.sub(pos, s.len())
}
fn rename_symbol(old: str, nw: str) {
    if old == "" or nw == "" or old == nw { return }
    push_undo()
    var cnt = 0
    var li = 0
    while li < z_lines.len() {
        let r = rename_line(z_lines[li], old, nw)
        if r != z_lines[li] {
            z_lines[li] = r
            cnt += 1
        }
        li += 1
    }
    clamp_col()
    mark_edit()
    notify("Renamed " + old + " to " + nw + " on {cnt} lines")
}
// project-wide rename (RenameProcessor port, IntelliJ's default scope): the open
// buffer renames through the undo stack; every other .zeph file in the project
// is rewritten on disk with the same token-aware pass (strings/comments survive)
// LineStatusTracker port: VCS gutter stripes for lines that differ from the
// git HEAD baseline. ponytail: prefix/suffix trim marks ONE contiguous span
// (an LCS per edit would be O(n^2) on big files); exact spans if needed later
fn lst_refresh() {
    if z_lst_path != z_path {
        z_lst_path = z_path
        var eb: [str] = []
        z_base = eb
        if z_branch != "" and z_path != "" {
            let rel = z_path.sub(dirname(z_path).len(), z_path.len())
            let out = run_capture("git show HEAD:./" + rel, dirname(z_path))
            if not out.contains("fatal") and out.len() > 0 {
                z_base = normalize_newlines(out).split("\n")
                if z_base.len() > 0 and z_base[z_base.len() - 1] == "" { let _d = z_base.pop() }
            }
        }
    }
    z_lst_seq = z_edit_seq
    z_lst_a = 0
    z_lst_b = 0
    if z_base.len() == 0 { return }
    let n = z_lines.len()
    let m = z_base.len()
    var p = 0
    while p < n and p < m and z_lines[p] == z_base[p] { p += 1 }
    var s = 0
    while s < n - p and s < m - p and z_lines[n - 1 - s] == z_base[m - 1 - s] { s += 1 }
    z_lst_a = p
    z_lst_b = n - s
    z_lst_add = m - p - s <= 0
}
// Rollback (RollbackLinesAction port): revert the tracked change span back to
// the git HEAD baseline. With the single-span tracker, prefix+suffix already
// equal the baseline, so restoring the baseline restores exactly the span.
fn rollback_lines() {
    if z_base.len() == 0 or z_lst_b <= z_lst_a {   // empty span = no tracked change
        notify("No changes to roll back")
        return
    }
    push_undo()
    z_lines = copy_lines(z_base)
    if z_cl > z_lines.len() - 1 { z_cl = z_lines.len() - 1 }
    clamp_col()
    z_sel = false
    mark_edit()
    notify("Rolled back to HEAD")
}
// Move Statement (MoveStatementUpDownHandler port): a fn/struct/enum header
// moves with its WHOLE block, hopping over the neighbouring statement's block;
// non-declaration lines fall back to the plain line mover.
fn move_statement(dir: int) {
    let t = z_lines[z_cl].trim()
    let a = z_cl
    if not (t.starts_with("fn ") or t.starts_with("struct ") or t.starts_with("enum ")) {
        move_line(dir)
        return
    }
    let b = fold_end(a)
    if b < a {
        move_line(dir)
        return
    }
    if dir < 0 and a == 0 { return }
    if dir > 0 and b >= z_lines.len() - 1 { return }
    push_undo()
    var block: [str] = []
    var i = a
    while i <= b {
        block.push(z_lines[i])
        i += 1
    }
    if dir < 0 {
        var p = a - 1
        while p > 0 and z_lines[p].trim().len() == 0 { p -= 1 }
        var start = p
        if z_lines[p].trim() == "\}" {
            var h = p - 1
            var found = 0 - 1
            while h >= 0 and found < 0 {
                if foldable(h) and fold_end(h) == p { found = h }
                h -= 1
            }
            if found >= 0 { start = found }
        }
        var n = b
        while n >= a {
            delete_line(n)
            n -= 1
        }
        i = 0
        while i < block.len() {
            insert_line(start + i, block[i])
            i += 1
        }
        z_cl = start
    } else {
        var q = b + 1
        while q < z_lines.len() and z_lines[q].trim().len() == 0 { q += 1 }
        if q >= z_lines.len() { q = z_lines.len() - 1 }
        var after = q
        let qt = z_lines[q].trim()
        if qt.starts_with("fn ") or qt.starts_with("struct ") or qt.starts_with("enum ") {
            let e = fold_end(q)
            if e >= q { after = e }
        }
        var n2 = b
        while n2 >= a {
            delete_line(n2)
            n2 -= 1
        }
        let dst = after - (b - a + 1) + 1
        i = 0
        while i < block.len() {
            insert_line(dst + i, block[i])
            i += 1
        }
        z_cl = dst
    }
    z_sel = false
    clamp_col()
    mark_edit()
}
// Unwrap (UnwrapHandler port): remove the enclosing block's header and closing
// brace, dedenting the body one level — the inverse of Surround With
fn unwrap_block() {
    let h = enclosing_fold(z_cl)
    if h < 0 {
        notify("No enclosing block to unwrap")
        return
    }
    let e = fold_end(h)
    if e <= h {
        notify("No enclosing block to unwrap")
        return
    }
    push_undo()
    var i = h + 1
    while i < e {
        let s = z_lines[i]
        if s.starts_with("    ") { z_lines[i] = s.sub(4, s.len()) }
        i += 1
    }
    delete_line(e)
    delete_line(h)
    z_cl = h
    if z_cl > z_lines.len() - 1 { z_cl = z_lines.len() - 1 }
    clamp_col()
    z_sel = false
    mark_edit()
    notify("Unwrapped block")
}
// Surround With (SurroundWithHandler port): wrap the selected lines in a
// construct — header at the selection's indent, body indented one level
fn surround_with(header: str) {
    if not z_sel { return }
    var a = z_al
    var b = z_cl
    if b < a {
        a = z_cl
        b = z_al
    }
    push_undo()
    let s0 = z_lines[a]
    var ind = 0
    while ind < s0.len() and s0.byte(ind) == 32 { ind += 1 }
    insert_line(a, " ".repeat(ind) + header + " \{")
    var i = a + 1
    while i <= b + 1 {
        if z_lines[i].trim().len() > 0 { z_lines[i] = "    " + z_lines[i] }
        i += 1
    }
    insert_line(b + 2, " ".repeat(ind) + "\}")
    z_cl = a
    z_cc = z_lines[a].len()
    z_sel = false
    mark_edit()
    notify("Surrounded with " + header)
}
// Extract Function (ExtractMethodHandler port): move the selected whole lines
// into a new fn appended at the end of the file, re-indented to body level;
// the selection is replaced by the call at the original indent.
// ponytail: extracts a zero-arg procedure; no parameter/return dataflow analysis
var z_extract_ext: [str] = []  // locals the last extraction reads from outside
// dataflow scan (ExtractMethodHandler conflicts): locals declared above the
// selection inside the enclosing fn that the selection reads — IntelliJ would
// make these parameters; Zephyr types are not inferable here, so we warn.
fn extract_scan_ext(a: int, b: int) {
    var ee: [str] = []
    z_extract_ext = ee
    var fs = a - 1
    while fs >= 0 and not z_lines[fs].trim().starts_with("fn ") { fs -= 1 }
    if fs < 0 { return }
    var names: [str] = []
    var li = fs + 1
    while li < a {
        let t = z_lines[li].trim()
        if t.starts_with("let ") or t.starts_with("var ") {
            let rest = t.sub(4, t.len())
            var e2 = 0
            while e2 < rest.len() and is_alnum(rest.byte(e2)) { e2 += 1 }
            if e2 > 0 { names.push(rest.sub(0, e2)) }
        }
        li += 1
    }
    li = a
    while li <= b {
        for nm in names {
            var seen = false
            for x in z_extract_ext {
                if x == nm { seen = true }
            }
            if not seen and has_word(z_lines[li], nm) { z_extract_ext.push(nm) }
        }
        li += 1
    }
}
fn extract_fn(name: str) {
    if name == "" or not z_sel { return }
    var a = z_al
    var b = z_cl
    if b < a {
        a = z_cl
        b = z_al
    }
    extract_scan_ext(a, b)
    if z_extract_ext.len() > 0 {
        var lst = ""
        for x in z_extract_ext {
            if lst != "" { lst = lst + ", " }
            lst = lst + x
        }
        notify("Note: reads outer locals ({lst}) - pass them in manually")
    }
    push_undo()
    var ind = 999
    var i = a
    while i <= b {
        let s = z_lines[i]
        if s.trim().len() > 0 {
            var k = 0
            while k < s.len() and s.byte(k) == 32 { k += 1 }
            if k < ind { ind = k }
        }
        i += 1
    }
    if ind == 999 { ind = 0 }
    var body: [str] = []
    i = a
    while i <= b {
        let s = z_lines[i]
        if s.trim().len() == 0 {
            body.push("")
        } else {
            body.push("    " + s.sub(ind, s.len()))
        }
        i += 1
    }
    var n = b
    while n >= a {
        delete_line(n)
        n -= 1
    }
    insert_line(a, " ".repeat(ind) + name + "()")
    z_lines.push("")
    z_lines.push("fn " + name + "() \{")
    for l in body { z_lines.push(l) }
    z_lines.push("\}")
    z_cl = a
    z_cc = 0
    z_sel = false
    mark_edit()
    notify("Extracted fn " + name + "()")
}
// Safe Delete (SafeDeleteHandler port): delete a declaration only when nothing
// still uses it; otherwise refuse and show the usages (IntelliJ's conflicts view)
fn safe_delete() {
    let w = caret_word()
    if w == "" {
        notify("Place the caret on a declaration")
        return
    }
    safe_delete_named(w)
}
fn safe_delete_named(w: str) {
    let nodes = parse_decls()
    var dl = 0 - 1
    var dk = 0
    var i = 0
    while i < nodes.len() {
        if nodes[i].name == w {
            dl = nodes[i].line
            dk = nodes[i].kind
        }
        i += 1
    }
    if dl < 0 {
        notify("No declaration of '{w}' found")
        return
    }
    var last = dl
    if dk == 1 or dk == 2 or dk == 3 { last = fold_end(dl) }   // fn/struct/enum body
    if last < dl { last = dl }
    var uses = 0
    var li = 0
    while li < z_lines.len() {
        if (li < dl or li > last) and has_word(z_lines[li], w) { uses += 1 }
        li += 1
    }
    if uses > 0 {
        find_usages(w)
        notify("Cannot safe-delete: {uses} usage(s) of '{w}'")
        return
    }
    push_undo()
    var n = last
    while n >= dl {
        delete_line(n)
        n -= 1
    }
    if z_cl > z_lines.len() - 1 { z_cl = z_lines.len() - 1 }
    clamp_col()
    z_sel = false
    mark_edit()
    notify("Safe-deleted '{w}'")
}
// Inline Variable (InlineLocalHandler port): replace every use of the variable
// with its initializer (token-aware) and delete the declaration.
// ponytail: assumes single assignment; no reassignment/escape analysis
fn inline_var() {
    let w = caret_word()
    if w == "" {
        notify("Place the caret on a variable")
        return
    }
    var dl = 0 - 1
    var li = z_cl
    while li >= 0 and dl < 0 {
        let t = z_lines[li].trim()
        if t.starts_with("let " + w + " ") or t.starts_with("var " + w + " ") {
            if z_lines[li].index_of("=") > 0 { dl = li }
        }
        li -= 1
    }
    if dl < 0 {
        notify("No declaration of '" + w + "' above the caret")
        return
    }
    let eq = z_lines[dl].index_of("=")
    let expr = z_lines[dl].sub(eq + 1, z_lines[dl].len()).trim()
    if expr == "" { return }
    // dataflow conflicts check (InlineLocalHandler): a reassigned variable
    // cannot be inlined — its value differs between uses
    var wr = 0
    var wk = 0
    while wk < z_lines.len() {
        if wk != dl {
            let wt = z_lines[wk].trim()
            if wt.starts_with(w + " =") or wt.starts_with(w + " +=") or wt.starts_with(w + " -=") {
                if not wt.starts_with(w + " ==") { wr += 1 }
            }
        }
        wk += 1
    }
    if wr > 0 {
        notify("Cannot inline '{w}': it is reassigned on {wr} line(s)")
        return
    }
    push_undo()
    var cnt = 0
    var k = 0
    while k < z_lines.len() {
        if k != dl {
            let r = rename_line(z_lines[k], w, expr)
            if r != z_lines[k] {
                z_lines[k] = r
                cnt += 1
            }
        }
        k += 1
    }
    delete_line(dl)
    if z_cl > dl { z_cl -= 1 }
    if z_cl > z_lines.len() - 1 { z_cl = z_lines.len() - 1 }
    clamp_col()
    z_sel = false
    mark_edit()
    notify("Inlined '" + w + "' into {cnt} line(s)")
}
// Introduce Variable (IntroduceVariableHandler port): replace the selected
// expression with a name and declare `let name = expr` above, same indent
// Extract Constant (IntroduceConstantHandler port): hoist the selected single-
// line expression to a top-level `let NAME = expr` (after the import/comment
// header) and replace the selection with NAME.
// ponytail: replaces the one selected occurrence, not every textual match
fn extract_const(name: str) {
    if name == "" or not z_sel or z_al != z_cl { return }
    var a = z_ac
    var b = z_cc
    if b < a {
        a = z_cc
        b = z_ac
    }
    let expr = z_lines[z_cl].sub(a, b)
    if expr == "" { return }
    push_undo()
    let s = z_lines[z_cl]
    z_lines[z_cl] = s.sub(0, a) + name + s.sub(b, s.len())
    var ins = 0                              // insertion point: past the header block
    var li = 0
    while li < z_lines.len() {
        let t = z_lines[li].trim()
        if t.starts_with("import ") or t.starts_with("//") or t == "" {
            ins = li + 1
            li += 1
        } else {
            li = z_lines.len()
        }
    }
    insert_line(ins, "let " + name + " = " + expr)
    if ins <= z_cl { z_cl += 1 }             // a line appeared above the caret
    z_cc = a + name.len()
    z_sel = false
    mark_edit()
    notify("Extracted constant " + name)
}
fn introduce_var(expr: str, name: str) {
    if expr == "" or name == "" { return }
    push_undo()
    var a = z_ac
    var b = z_cc
    if b < a {
        a = z_cc
        b = z_ac
    }
    let s = z_lines[z_cl]
    z_lines[z_cl] = s.sub(0, a) + name + s.sub(b, s.len())
    var ind = 0
    while ind < s.len() and s.byte(ind) == 32 { ind += 1 }
    insert_line(z_cl, s.sub(0, ind) + "let " + name + " = " + expr)
    z_cl += 1
    z_cc = a + name.len()
    z_sel = false
    mark_edit()
    notify("Introduced " + name)
}
// scope-aware rename (RenameProcessor): a fn parameter or local renames only
// inside its enclosing fn; anything else renames project-wide
fn rename_scoped(old: str, nw: str) {
    if old == "" or nw == "" or old == nw { return }
    var fs = z_cl
    while fs >= 0 and not z_lines[fs].trim().starts_with("fn ") { fs -= 1 }
    if fs >= 0 {
        let fe = fold_end(fs)
        if fe >= z_cl {
            var local = has_word(z_lines[fs], old)   // parameter in the header
            var li = fs + 1
            while li <= fe and not local {
                let t = z_lines[li].trim()
                if t.starts_with("let " + old + " ") or t.starts_with("var " + old + " ") { local = true }
                li += 1
            }
            if local {
                push_undo()
                var cnt = 0
                var k = fs
                while k <= fe {
                    let r = rename_line(z_lines[k], old, nw)
                    if r != z_lines[k] {
                        z_lines[k] = r
                        cnt += 1
                    }
                    k += 1
                }
                clamp_col()
                mark_edit()
                notify("Renamed local '{old}' on {cnt} line(s)")
                return
            }
        }
    }
    rename_project(old, nw)
}
fn rename_project(old: str, nw: str) {
    if old == "" or nw == "" or old == nw { return }
    rename_symbol(old, nw)
    let dir = dirname(z_path)
    let cur = z_path.sub(dir.len(), z_path.len())
    var files = 0
    var fi = 0
    while fi < z_files.len() {
        let nm = z_files[fi]
        if nm.ends_with(".zeph") and nm != cur {
            let p = dir + nm
            let rows = normalize_newlines(read_file(p)).split("\n")
            var parts: [str] = []
            var changed = false
            var li = 0
            while li < rows.len() {
                let r = rename_line(rows[li], old, nw)
                if r != rows[li] { changed = true }
                if li > 0 { parts.push("\n") }
                parts.push(r)
                li += 1
            }
            if changed {
                write_file(p, parts.join())
                files += 1
            }
        }
        fi += 1
    }
    if files > 0 { notify("Renamed in {files} other project file(s)") }
}
// ---- regex engine (find bar .* mode): backtracking matcher over compiled nodes.
// Supports literals, ., * + ? (greedy), [...] with ranges/negation, \d \w \s, ^ $.
// ponytail: no groups/alternation — add if a real query needs them.
fn rx_cls_new() -> int {
    let base = z_rx_cls.len()
    var i = 0
    while i < 256 {
        z_rx_cls.push(0)
        i += 1
    }
    return base
}
fn rx_cls_range(base: int, a: int, b: int) {
    var c = a
    while c <= b {
        z_rx_cls[base + c] = 1
        c += 1
    }
}
// \d \w \s inside/outside classes; returns false if ch is not a preset
fn rx_cls_preset(base: int, ch: int) -> bool {
    if ch == 100 {
        rx_cls_range(base, 48, 57)
        return true
    }
    if ch == 119 {
        rx_cls_range(base, 48, 57)
        rx_cls_range(base, 65, 90)
        rx_cls_range(base, 97, 122)
        z_rx_cls[base + 95] = 1
        return true
    }
    if ch == 115 {
        z_rx_cls[base + 32] = 1
        z_rx_cls[base + 9] = 1
        return true
    }
    return false
}
fn rx_cls_invert(base: int) {
    var i = 0
    while i < 256 {
        z_rx_cls[base + i] = 1 - z_rx_cls[base + i]
        i += 1
    }
}
fn rx_push(t: int, a: int) {
    z_rx_t.push(t)
    z_rx_a.push(a)
    z_rx_q.push(0)
}
fn rx_compile(p: str) {
    var et: [int] = []
    z_rx_t = et
    var ea: [int] = []
    z_rx_a = ea
    var eq: [int] = []
    z_rx_q = eq
    var ec: [int] = []
    z_rx_cls = ec
    var gstk: [int] = []
    var gcount = 0
    var ok = true
    let n = p.len()
    var i = 0
    while i < n {
        let c = p.byte(i)
        var emitted = false
        if c == 94 and i == 0 {
            rx_push(3, 0)
        } else if c == 36 and i == n - 1 {
            rx_push(4, 0)
        } else if c == 40 {              // ( capture group open (zero-width marker)
            rx_push(5, gcount)
            gstk.push(gcount)
            gcount += 1
        } else if c == 41 {              // ) close; a quantifier after it is rejected
            if gstk.len() == 0 {
                ok = false
            } else {
                rx_push(6, gstk.pop())
            }
        } else if c == 46 {
            rx_push(1, 0)
            emitted = true
        } else if c == 92 {
            i += 1
            if i >= n {
                ok = false
            } else {
                let e2 = p.byte(i)
                var lower2 = e2
                if e2 >= 65 and e2 <= 90 { lower2 = e2 + 32 }
                let base = rx_cls_new()
                if rx_cls_preset(base, lower2) {
                    if e2 >= 65 and e2 <= 90 { rx_cls_invert(base) }   // \D \W \S
                    rx_push(2, base)
                } else {
                    rx_push(0, e2)                                     // escaped literal
                }
                emitted = true
            }
        } else if c == 91 {
            let base = rx_cls_new()
            i += 1
            var neg = false
            if i < n and p.byte(i) == 94 {
                neg = true
                i += 1
            }
            var closed = false
            while i < n and not closed {
                let cc2 = p.byte(i)
                if cc2 == 93 {
                    closed = true
                } else if cc2 == 92 and i + 1 < n {
                    i += 1
                    if not rx_cls_preset(base, p.byte(i)) { z_rx_cls[base + p.byte(i)] = 1 }
                    i += 1
                } else if i + 2 < n and p.byte(i + 1) == 45 and p.byte(i + 2) != 93 {
                    rx_cls_range(base, cc2, p.byte(i + 2))
                    i += 3
                } else {
                    z_rx_cls[base + cc2] = 1
                    i += 1
                }
            }
            if not closed { ok = false }
            if neg { rx_cls_invert(base) }
            rx_push(2, base)
            emitted = true               // i rests on ']'; shared i += 1 moves past it
        } else if c == 42 or c == 43 or c == 63 {
            ok = false                   // quantifier with nothing to repeat
        } else {
            rx_push(0, c)
            emitted = true
        }
        if emitted and i + 1 < n {
            let qc2 = p.byte(i + 1)
            var qv = 0
            if qc2 == 42 { qv = 1 }
            if qc2 == 43 { qv = 2 }
            if qc2 == 63 { qv = 3 }
            if qv != 0 {
                z_rx_q[z_rx_q.len() - 1] = qv
                i += 1
            }
        }
        i += 1
    }
    if gstk.len() > 0 { ok = false }     // unclosed (
    z_rx_gn = gcount
    var gs0: [int] = []
    z_rx_gs = gs0
    var ge0: [int] = []
    z_rx_ge = ge0
    var gi = 0
    while gi < gcount {
        z_rx_gs.push(0 - 1)
        z_rx_ge.push(0 - 1)
        gi += 1
    }
    z_rx_ok = ok and z_rx_t.len() > 0
}
fn rx_one(ni: int, s: str, pos: int) -> bool {
    if pos >= s.len() { return false }
    let t = z_rx_t[ni]
    let c = s.byte(pos)
    if t == 0 { return c == z_rx_a[ni] }
    if t == 1 { return true }
    if t == 2 { return z_rx_cls[z_rx_a[ni] + c] == 1 }
    return false
}
fn rx_here(ni: int, s: str, pos: int) -> int {
    if ni >= z_rx_t.len() { return pos }
    let t = z_rx_t[ni]
    if t == 5 {                          // group open: record, consume nothing
        z_rx_gs[z_rx_a[ni]] = pos
        return rx_here(ni + 1, s, pos)
    }
    if t == 6 {                          // group close
        z_rx_ge[z_rx_a[ni]] = pos
        return rx_here(ni + 1, s, pos)
    }
    if t == 3 {
        if pos == 0 { return rx_here(ni + 1, s, pos) }
        return 0 - 1
    }
    if t == 4 {
        if pos == s.len() { return rx_here(ni + 1, s, pos) }
        return 0 - 1
    }
    let quant = z_rx_q[ni]
    if quant == 0 {
        if rx_one(ni, s, pos) { return rx_here(ni + 1, s, pos + 1) }
        return 0 - 1
    }
    var k = 0
    while rx_one(ni, s, pos + k) { k += 1 }
    if quant == 3 and k > 1 { k = 1 }
    var kmin = 0
    if quant == 2 { kmin = 1 }
    while k >= kmin {
        let e = rx_here(ni + 1, s, pos + k)
        if e >= 0 { return e }
        k -= 1
    }
    return 0 - 1
}
fn rx_prepare() {
    var pat = z_find_q
    if not z_find_case { pat = pat.lower() }
    if pat != z_rx_src {
        rx_compile(pat)
        z_rx_src = pat
    }
}
fn rx_find(s: str, from: int) -> int {
    rx_prepare()
    if not z_rx_ok { return 0 - 1 }
    var hay = s
    if not z_find_case { hay = s.lower() }
    var pos = from
    while pos <= hay.len() {
        var gr = 0                       // fresh group state per attempt
        while gr < z_rx_gn {
            z_rx_gs[gr] = 0 - 1
            z_rx_ge[gr] = 0 - 1
            gr += 1
        }
        let e = rx_here(0, hay, pos)
        if e > pos {                     // zero-length matches are skipped
            var accept = true
            if z_find_words {
                var bok = pos == 0
                if not bok { bok = not is_alnum(s.byte(pos - 1)) }
                var aok = e >= s.len()
                if not aok { aok = not is_alnum(s.byte(e)) }
                accept = bok and aok
            }
            if accept {
                z_find_mlen = e - pos
                var gt: [str] = []       // capture from the original (case-preserved) string
                var gi2 = 0
                while gi2 < z_rx_gn {
                    if z_rx_gs[gi2] >= 0 and z_rx_ge[gi2] >= z_rx_gs[gi2] {
                        gt.push(s.sub(z_rx_gs[gi2], z_rx_ge[gi2]))
                    } else {
                        gt.push("")
                    }
                    gi2 += 1
                }
                z_rx_gtxt = gt
                return pos
            }
        }
        pos += 1
    }
    return 0 - 1
}
// expand $1..$9 (and $$) in a replacement using the last match's captures
fn rx_expand(rep: str) -> str {
    var out = ""
    var i = 0
    while i < rep.len() {
        let c = rep.byte(i)
        if c == 36 and i + 1 < rep.len() {
            let d = rep.byte(i + 1)
            if d >= 49 and d <= 57 {
                let gi = d - 49
                if gi < z_rx_gtxt.len() { out = out + z_rx_gtxt[gi] }
                i += 2
                continue
            }
            if d == 36 {
                out = out + "$"
                i += 2
                continue
            }
        }
        out = out + chr(c)
        i += 1
    }
    return out
}
// first find-match in s at/after `from`, honoring the Match Case / Words / Regex
// toggles (IntelliJ FindModel semantics); -1 if none. Sets z_find_mlen.
fn find_in(s: str, from: int) -> int {
    z_find_mlen = z_find_q.len()
    if z_find_q == "" { return 0 - 1 }
    if z_find_regex { return rx_find(s, from) }
    var hay = s
    var needle = z_find_q
    if not z_find_case {
        hay = s.lower()
        needle = needle.lower()
    }
    var base = from
    while base + needle.len() <= hay.len() {
        let f = hay.sub(base, hay.len()).index_of(needle)
        if f < 0 { return 0 - 1 }
        let p = base + f
        if not z_find_words { return p }
        var bok = p == 0
        if not bok { bok = not is_alnum(s.byte(p - 1)) }
        var aok = p + needle.len() >= s.len()
        if not aok { aok = not is_alnum(s.byte(p + needle.len())) }
        if bok and aok { return p }
        base = p + 1
    }
    return 0 - 1
}
fn replace_all() {
    if z_find_q == "" { return }
    push_undo()
    var cnt = 0
    var li = 0
    while li < z_lines.len() {
        let src = z_lines[li]
        var out = ""
        var pos = 0
        var f = find_in(src, 0)
        while f >= 0 {
            var ml = z_find_mlen
            if ml < 1 { ml = 1 }
            var rep = z_replace_q
            if z_find_regex { rep = rx_expand(z_replace_q) }   // $1..$9 from this match
            out = out + src.sub(pos, f) + rep
            pos = f + ml
            cnt += 1
            f = find_in(src, pos)
        }
        if pos > 0 { z_lines[li] = out + src.sub(pos, src.len()) }
        li += 1
    }
    clamp_col()
    mark_edit()
    notify("Replaced {cnt} occurrences")
}
fn replace_one() {
    if z_sel {
        norm_sel()
        var selraw = ""
        if z_nsl == z_nel { selraw = z_lines[z_nsl].sub(z_nsc, z_nec) }
        var matched = false
        if selraw != "" {
            if z_find_regex {
                matched = rx_find(selraw, 0) == 0 and z_find_mlen == selraw.len()
            } else {
                var selq = selraw
                var fq = z_find_q
                if not z_find_case {
                    selq = selq.lower()
                    fq = fq.lower()
                }
                matched = selq == fq
            }
        }
        if matched {
            push_undo()
            var rep = z_replace_q
            if z_find_regex { rep = rx_expand(z_replace_q) }   // captures fresh from the match check
            let s = z_lines[z_nsl]
            z_lines[z_nsl] = s.sub(0, z_nsc) + rep + s.sub(z_nec, s.len())
            z_cl = z_nsl
            z_cc = z_nsc + rep.len()
            z_sel = false
            mark_edit()
        }
    }
    find_next()
}
// whole-word presence
fn has_word(s: str, w: str) -> bool {
    if w == "" { return false }
    var i = 0
    while i + w.len() <= s.len() {
        if s.sub(i, i + w.len()) == w {
            var bok = i == 0
            if not bok { bok = not is_alnum(s.byte(i - 1)) }
            var aok = i + w.len() >= s.len()
            if not aok { aok = not is_alnum(s.byte(i + w.len())) }
            if bok and aok { return true }
        }
        i += 1
    }
    return false
}
fn decl_here(s: str, kw: str, name: str) -> bool {
    let idx = s.index_of(kw + name)
    if idx < 0 { return false }
    let after = idx + kw.len() + name.len()
    if after < s.len() and is_alnum(s.byte(after)) { return false }
    return true
}
// Ctrl+B / Ctrl+click: jump to the fn/struct/enum/let/var declaration
fn goto_decl(word: str) {
    if word == "" { return }
    push_loc()
    var li = 0
    while li < z_lines.len() {
        let s = z_lines[li]
        if decl_here(s, "fn ", word) or decl_here(s, "struct ", word) or decl_here(s, "enum ", word) or decl_here(s, "let ", word) or decl_here(s, "var ", word) {
            z_cl = li
            z_cc = 0
            z_sel = false
            ensure_caret()
            return
        }
        li += 1
    }
    notify("No declaration of '" + word + "'")
}
// Alt+F7: find all whole-word usages
fn find_usages(word: str) {
    if word == "" { return }
    var out: [str] = []
    var li = 0
    while li < z_lines.len() {
        if has_word(z_lines[li], word) { out.push((li as str) + "|" + z_lines[li].trim()) }
        li += 1
    }
    z_usages = out
    z_usage_word = word
    z_usage_sel = 0
    z_popup = 12
    z_popup_frame = g_frame
}
// Ctrl+Alt+L: reformat (trim trailing whitespace)
// Optimize Imports (OptimizeImportsAction port): dedupe + sort the file's
// `import "..."` lines, rewriting them contiguously where the first one sat.
fn optimize_imports() {
    var idx: [int] = []
    var uniq: [str] = []
    var li = 0
    while li < z_lines.len() {
        if z_lines[li].trim().starts_with("import ") {
            idx.push(li)
            let t = z_lines[li].trim()
            var seen = false
            for u in uniq {
                if u == t { seen = true }
            }
            if not seen { uniq.push(t) }
        }
        li += 1
    }
    if idx.len() == 0 {
        notify("No imports to optimize")
        return
    }
    nat_sort(uniq)
    let at = idx[0]
    if idx.len() == uniq.len() {
        var same = true                      // already deduped + sorted? no-op
        var k = 0
        while k < uniq.len() {
            if z_lines[idx[k]].trim() != uniq[k] { same = false }
            k += 1
        }
        if same and idx[idx.len() - 1] - idx[0] + 1 == idx.len() {
            notify("Imports already optimized")
            return
        }
    }
    push_undo()
    var r = idx.len() - 1                     // remove from the bottom up (stable indices)
    while r >= 0 {
        delete_line(idx[r])
        r -= 1
    }
    var i = 0
    while i < uniq.len() {
        insert_line(at + i, uniq[i])
        i += 1
    }
    if z_cl > z_lines.len() - 1 { z_cl = z_lines.len() - 1 }
    clamp_col()
    mark_edit()
    notify("Optimized {uniq.len()} import(s)")
}
fn reformat() {
    push_undo()
    var li = 0
    while li < z_lines.len() {
        var s = z_lines[li]
        while s.len() > 0 and (s.byte(s.len() - 1) == 32 or s.byte(s.len() - 1) == 9) {
            s = s.sub(0, s.len() - 1)
        }
        z_lines[li] = s
        li += 1
    }
    mark_edit()
    notify("Reformatted file")
}
fn bp_key(li: int) -> str { return z_path + ":" + (li as str) }
fn toggle_break(li: int) {
    let key = z_path + ":" + (li as str)
    var n: [str] = []
    var found = false
    for b in z_breaks {
        if b == key { found = true } else { n.push(b) }
    }
    if not found { n.push(key) }
    z_breaks = n
    session_save()
}
fn line_break(li: int) -> bool {
    let key = z_path + ":" + (li as str)
    for b in z_breaks {
        if b == key { return true }
    }
    return false
}
// ---- code folding (visual-line model; identical to no-fold when z_folds empty) ----
fn foldable(li: int) -> bool {
    if li < 0 or li > z_lines.len() - 1 { return false }
    let bp = z_lines[li].index_of("\{")
    if bp < 0 { return false }
    let m = find_match(li, bp)
    return m >= 0 and m / 1000000 > li
}
fn fold_end(hdr: int) -> int {
    let bp = z_lines[hdr].index_of("\{")
    if bp < 0 { return hdr }
    let m = find_match(hdr, bp)
    if m < 0 { return hdr }
    return m / 1000000
}
fn is_folded(hdr: int) -> bool {
    for f in z_folds {
        if f == hdr { return true }
    }
    return false
}
fn toggle_fold(hdr: int) {
    if not foldable(hdr) { return }
    var n: [int] = []
    var found = false
    for f in z_folds {
        if f == hdr { found = true } else { n.push(f) }
    }
    if not found { n.push(hdr) }
    z_folds = n
}
// the enclosing foldable header at/above a line (for Ctrl+.)
fn enclosing_fold(li: int) -> int {
    if foldable(li) { return li }
    var h = li - 1
    while h >= 0 {
        if foldable(h) and fold_end(h) >= li { return h }
        h -= 1
    }
    return 0 - 1
}
// Move to Code Block Start/End (EditorCodeBlockStart/End port): jump the caret
// to the enclosing declaration's opening or closing line.
fn code_block_nav(to_end: bool) {
    let h = enclosing_fold(z_cl)
    if h < 0 { return }
    if to_end {
        let e = fold_end(h)
        if e > z_cl {
            z_cl = e
            z_cc = z_lines[e].len()
            clamp_col()
            ensure_caret()
        }
        return
    }
    var dst = h                              // start of the enclosing block
    if h == z_cl {                           // already on the header: go to the block above
        dst = 0 - 1
        var p = z_cl - 1
        while p >= 0 and dst < 0 {
            if foldable(p) and fold_end(p) >= z_cl { dst = p }
            p -= 1
        }
    }
    if dst < 0 or dst == z_cl { return }
    z_cl = dst
    z_cc = 0
    clamp_col()
    ensure_caret()
}
fn build_vis() {
    var v: [int] = []
    var i = 0
    while i < z_lines.len() {
        v.push(i)
        if is_folded(i) { i = fold_end(i) + 1 } else { i += 1 }
    }
    z_vis = v
}
fn vis_index_of(li: int) -> int {
    var best = 0
    var r = 0
    while r < z_vis.len() {
        if z_vis[r] <= li { best = r }
        r += 1
    }
    return best
}
// move the current line up/down (Alt+Shift+Up/Down)
// Alt+Shift+Up/Down move lines, ported from LineMover: move the whole selected
// line block (selection ending at column 0 excludes that last line, per IntelliJ).
fn move_line(dir: int) {
    var a = z_cl
    var b = z_cl
    let hadsel = z_sel
    if z_sel {
        norm_sel()
        a = z_nsl
        b = z_nel
        if z_nec == 0 and b > a { b -= 1 }
    }
    if dir < 0 {
        if a == 0 { return }
        push_undo()
        let moved = z_lines[a - 1]
        delete_line(a - 1)
        insert_line(b, moved)
    } else {
        if b >= z_lines.len() - 1 { return }
        push_undo()
        let moved = z_lines[b + 1]
        delete_line(b + 1)
        insert_line(a, moved)
    }
    z_cl += dir
    if hadsel { z_al += dir }
    clamp_col()
    mark_edit()
}
// the identifier under the caret (for occurrence highlighting); "" if too short
fn caret_word() -> str {
    if z_cl > z_lines.len() - 1 { return "" }
    let s = z_lines[z_cl]
    if z_cc > s.len() { return "" }
    var a = z_cc
    while a > 0 and is_alnum(s.byte(a - 1)) { a -= 1 }
    var b = z_cc
    while b < s.len() and is_alnum(s.byte(b)) { b += 1 }
    if b - a < 2 { return "" }
    return s.sub(a, b)
}
// ---- camel-aware word boundaries, ported from EditorActionUtil ----
fn ea_id_part(c: int) -> bool { return is_alnum(c) or c == 95 }   // 95 = '_'
fn ea_punct(c: int) -> bool { return c != 0 and not ea_id_part(c) and c != 32 and c != 9 }
fn ea_upper(c: int) -> bool { return c >= 65 and c <= 90 }
fn ea_lower(c: int) -> bool { return c >= 97 and c <= 122 }
// isHumpBound: lower/digit->UPPER, '_' boundary, UPPER-UPPER-lower run
fn ea_hump(line: str, off: int, is_start: bool) -> bool {
    if off <= 0 or off >= line.len() { return false }
    let prev = line.byte(off - 1)
    let curr = line.byte(off)
    var nxt = 0
    if off + 1 < line.len() { nxt = line.byte(off + 1) }
    var hump = prev
    var neighbor = curr
    if is_start {
        hump = curr
        neighbor = prev
    }
    if (ea_lower(prev) or is_digit(prev)) and ea_upper(curr) { return true }
    if neighbor == 95 and hump != 95 { return true }
    if ea_upper(prev) and ea_upper(curr) and ea_lower(nxt) { return true }
    return false
}
// isWordStart(camel): a word boundary starting at off
fn ea_word_start(line: str, off: int) -> bool {
    if off < 0 or off > line.len() { return false }
    var prev = 0
    if off > 0 { prev = line.byte(off - 1) }
    var curr = 0
    if off < line.len() { curr = line.byte(off) }
    if ea_id_part(curr) {
        if not ea_id_part(prev) { return true }
        if ea_hump(line, off, true) { return true }
    }
    if ea_punct(curr) and not ea_punct(prev) { return true }
    return false
}
// Ctrl+Left/Right: move caret one word (camel-aware), wrapping across lines
fn move_word(dir: int) {
    let line = z_lines[z_cl]
    if dir > 0 {
        if z_cc >= line.len() {
            if z_cl < z_lines.len() - 1 {
                z_cl += 1
                z_cc = 0
            }
            return
        }
        var o = z_cc + 1
        while o < line.len() and not ea_word_start(line, o) { o += 1 }
        z_cc = o
    } else {
        if z_cc <= 0 {
            if z_cl > 0 {
                z_cl -= 1
                z_cc = z_lines[z_cl].len()
            }
            return
        }
        var o = z_cc - 1
        while o > 0 and not ea_word_start(line, o) { o -= 1 }
        z_cc = o
    }
}
// Ctrl+W / Ctrl+Shift+W progressive selection, ported from SelectWordHandler:
// extend caret -> word -> line -> whole buffer; shrink walks back down.
// innermost declaration (fn/struct/enum) whose brace range encloses line li, or -1.
// Walks the parse tree so the extend step matches the Structure view / folding.
fn enclosing_decl_line(li: int) -> int {
    let nodes = parse_decls()
    var best = 0 - 1
    var i = 0
    while i < nodes.len() {
        let h = nodes[i].line
        if h <= li and foldable(h) and fold_end(h) >= li {
            if h > best { best = h }
        }
        i += 1
    }
    return best
}
fn sw_apply(lv: int) {
    if lv <= 0 {
        z_sel = false
        z_sw_level = 0
        return
    }
    let s = z_lines[z_sw_l]
    if lv == 1 {
        var a = z_sw_c
        while a > 0 and ea_id_part(s.byte(a - 1)) { a -= 1 }
        var b = z_sw_c
        while b < s.len() and ea_id_part(s.byte(b)) { b += 1 }
        if b == a {
            b = a + 1
            if b > s.len() { b = s.len() }
        }
        z_cl = z_sw_l
        z_al = z_sw_l
        z_ac = a
        z_cc = b
        z_sel = true
    } else if lv == 2 {
        z_cl = z_sw_l
        z_al = z_sw_l
        z_ac = 0
        z_cc = s.len()
        z_sel = true
    } else if lv == 3 and enclosing_decl_line(z_sw_l) >= 0 {
        let h = enclosing_decl_line(z_sw_l)
        let e = fold_end(h)
        z_al = h
        z_ac = 0
        z_cl = e
        z_cc = z_lines[e].len()
        z_sel = true
    } else {
        z_al = 0
        z_ac = 0
        z_cl = z_lines.len() - 1
        z_cc = z_lines[z_cl].len()
        z_sel = true
    }
    z_sw_level = lv
}
fn select_word_expand() {
    if z_sw_level == 0 {
        z_sw_l = z_cl
        z_sw_c = z_cc
    }
    var lv = z_sw_level + 1
    if lv > 4 { lv = 4 }
    sw_apply(lv)
}
fn select_word_shrink() {
    var lv = z_sw_level - 1
    if lv < 0 { lv = 0 }
    sw_apply(lv)
}
// Ctrl+Backspace delete-to-word-start, ported from DeleteToWordStartAction:
// remove from the previous camel word boundary up to the caret.
fn delete_word_left() {
    if z_sel {
        del_sel()
        return
    }
    if z_cc == 0 {
        do_backspace()          // at line start: fall back to joining the line above
        return
    }
    let line = z_lines[z_cl]
    var o = z_cc - 1
    while o > 0 and not ea_word_start(line, o) { o -= 1 }
    push_undo()
    z_lines[z_cl] = line.sub(0, o) + line.sub(z_cc, line.len())
    z_cc = o
    mark_edit()
}
// Ctrl+Delete delete-to-word-end, ported from DeleteToWordEndAction: remove from
// the caret up to the next camel word boundary.
fn delete_word_right() {
    if z_sel {
        del_sel()
        return
    }
    let line = z_lines[z_cl]
    if z_cc >= line.len() {
        do_delete()             // at line end: fall back to pulling up the next line
        return
    }
    var o = z_cc + 1
    while o < line.len() and not ea_word_start(line, o) { o += 1 }
    push_undo()
    z_lines[z_cl] = line.sub(0, z_cc) + line.sub(o, line.len())
    mark_edit()
}
fn bracket_at(li: int, col: int) -> int {
    if li < 0 or li > z_lines.len() - 1 { return 0 }
    if col < 0 or col > z_lines[li].len() - 1 { return 0 }
    return z_lines[li].byte(col)
}
// per-column lexical mask: false where a char is inside a string or // comment.
// Ported from BraceMatchingUtil's token-awareness: braces in literals don't count.
fn line_code_mask(line: str) -> [bool] {
    var mask: [bool] = []
    let n = line.len()
    var i = 0
    while i < n {
        mask.push(true)
        i += 1
    }
    var instr = false
    var j = 0
    while j < n {
        let c = line.byte(j)
        if instr {
            mask[j] = false
            if c == 92 and j + 1 < n {          // backslash escape
                mask[j + 1] = false
                j += 2
            } else if c == 34 {                  // closing quote
                instr = false
                j += 1
            } else {
                j += 1
            }
        } else if c == 34 {                      // opening quote
            mask[j] = false
            instr = true
            j += 1
        } else if c == 47 and j + 1 < n and line.byte(j + 1) == 47 {
            while j < n {                        // // comment to end of line
                mask[j] = false
                j += 1
            }
        } else {
            j += 1
        }
    }
    return mask
}
// match the bracket at (li,col); returns li*1000000+col of the pair, or -1
fn find_match(li: int, col: int) -> int {
    let c = bracket_at(li, col)
    var dir = 0
    var opench = 0
    var closech = 0
    if c == 40 or c == 41 {
        opench = 40
        closech = 41
    }
    if c == 91 or c == 93 {
        opench = 91
        closech = 93
    }
    if c == 123 or c == 125 {
        opench = 123
        closech = 125
    }
    if opench == 0 { return -1 }
    if c == opench { dir = 1 } else { dir = 0 - 1 }
    var depth = 0
    var l = li
    var k = col
    var mask = line_code_mask(z_lines[l])
    while l >= 0 and l < z_lines.len() {
        let line = z_lines[l]
        while k >= 0 and k < line.len() {
            if mask[k] {                          // only structural (code) brackets count
                let ch2 = line.byte(k)
                if ch2 == opench { depth += 1 }
                if ch2 == closech { depth -= 1 }
                if depth == 0 { return l * 1000000 + k }
            }
            k += dir
        }
        l += dir
        if l >= 0 and l < z_lines.len() {
            mask = line_code_mask(z_lines[l])
            if dir == 1 { k = 0 } else { k = z_lines[l].len() - 1 }
        }
    }
    return -1
}
// Ctrl+Shift+M jump to matching brace, ported from CodeBlockUtil: if the caret is
// on a bracket, jump to its pair; else find the enclosing opener and jump to it.
fn is_bracket(c: int) -> bool {
    return c == 40 or c == 41 or c == 91 or c == 93 or c == 123 or c == 125
}
fn jump_matching_brace() {
    var bpos = 0 - 1
    if is_bracket(bracket_at(z_cl, z_cc)) {
        bpos = z_cl * 1000000 + z_cc
    } else if is_bracket(bracket_at(z_cl, z_cc - 1)) {
        bpos = z_cl * 1000000 + (z_cc - 1)
    }
    if bpos < 0 {
        var l = z_cl
        var k = z_cc - 1
        var depth = 0
        while l >= 0 and bpos < 0 {
            let line = z_lines[l]
            let mask = line_code_mask(line)
            while k >= 0 and k < line.len() and bpos < 0 {
                if mask[k] {
                    let c = line.byte(k)
                    if c == 41 or c == 93 or c == 125 {
                        depth += 1
                    } else if c == 40 or c == 91 or c == 123 {
                        if depth == 0 { bpos = l * 1000000 + k } else { depth -= 1 }
                    }
                }
                k -= 1
            }
            l -= 1
            if l >= 0 { k = z_lines[l].len() - 1 }
        }
    }
    if bpos < 0 { return }
    let m = find_match(bpos / 1000000, bpos % 1000000)
    if m >= 0 {
        z_cl = m / 1000000
        z_cc = m % 1000000
        z_sel = false
        ensure_caret()
    }
}
fn bm_key() -> str { return z_path + ":" + (z_cl as str) }
fn toggle_bookmark() {
    let key = bm_key()
    var n: [str] = []
    var found = false
    for b in z_bookmarks {
        if b == key { found = true } else { n.push(b) }
    }
    if not found {
        n.push(key)
        notify("Bookmark added at line {z_cl + 1}")
    }
    z_bookmarks = n
    session_save()
}
// build the bookmarks-popup rows; split each "path:line" at the LAST colon
// (paths contain a drive colon), preview from the buffer or disk
fn bm_build() {
    var ps: [str] = []
    var ls2: [int] = []
    var pv: [str] = []
    for b in z_bookmarks {
        var ci = b.len() - 1
        while ci >= 0 and b.byte(ci) != 58 { ci -= 1 }
        if ci > 0 {
            let p = b.sub(0, ci)
            let ln = b.sub(ci + 1, b.len()) as int
            var prev = ""
            if p == z_path {
                if ln < z_lines.len() { prev = z_lines[ln].trim() }
            } else if path_exists(p) {
                let ls3 = normalize_newlines(read_file(p)).split("\n")
                if ln < ls3.len() { prev = ls3[ln].trim() }
            }
            if prev.len() > 60 { prev = prev.sub(0, 60) }
            ps.push(p)
            ls2.push(ln)
            pv.push(prev)
        }
    }
    z_bm_paths = ps
    z_bm_lines = ls2
    z_bm_prev = pv
}
fn line_bookmarked(li: int) -> bool {
    let key = z_path + ":" + (li as str)
    for b in z_bookmarks {
        if b == key { return true }
    }
    return false
}
// enclosing fn/struct/enum for the navigation bar
// nav-bar enclosing symbol: the declaration whose brace range contains the caret
// (parse-tree driven), not merely the nearest header above it.
fn compute_navsym() {
    scan_symbols()
    z_navsym = ""
    let h = enclosing_decl_line(z_cl)
    if h < 0 { return }
    var i = 0
    while i < z_sym_lines.len() {
        if z_sym_lines[i] == h { z_navsym = z_sym_names[i] }
        i += 1
    }
}
// scan the buffer + project files for TODO / FIXME comments
fn scan_todos() {
    var out: [str] = []
    // current buffer
    var li = 0
    while li < z_lines.len() {
        let s = z_lines[li]
        let t = s.index_of("TODO")
        let f = s.index_of("FIXME")
        if t >= 0 or f >= 0 {
            var at = t
            if at < 0 { at = f }
            out.push(shownname() + ":" + ((li + 1) as str) + "|" + s.sub(at, s.len()).trim())
        }
        li += 1
    }
    z_todo = out
}
fn shownname() -> str {
    if z_path == "" { return "untitled" }
    return z_path.sub(dirname(z_path).len(), z_path.len())
}

fn z_fix_error() {
    if z_diag_line < 0 { return }
    z_chat_on = true
    z_focus = 1
    z_chat_input = "Fix this compiler error on line {z_diag_line}: {z_diag_msg}"
    chat_submit()
}

// ---- per-frame input ----
fn z_measure() {
    ui_mono()
    z_cw = text_w("M")
    ui_ui()
    if z_cw < 1 { z_cw = 9 }
}
// visual column of a logical column, ported from EditorUtil.calcColumnNumber:
// tabs advance to the next multiple of the tab size (4).
fn vis_col(line: str, col: int) -> int {
    var v = 0
    var i = 0
    var n = col
    if n > line.len() { n = line.len() }
    while i < n {
        if line.byte(i) == 9 { v = (v / 4 + 1) * 4 } else { v += 1 }
        i += 1
    }
    if col > line.len() { v += col - line.len() }   // past EOL: virtual single columns
    return v
}
// inverse: logical column nearest a visual column (for mouse hit-testing)
fn vis_to_col(line: str, vcol: int) -> int {
    var v = 0
    var i = 0
    while i < line.len() {
        var w = 1
        if line.byte(i) == 9 { w = (v / 4 + 1) * 4 - v }
        if v + w > vcol {
            if (vcol - v) * 2 >= w { return i + 1 }
            return i
        }
        v += w
        i += 1
    }
    return line.len() + (vcol - v)
}
fn z_mouse_to_pos(clampy: bool) -> int {     // returns li*1000000+col at the mouse
    var my = g_my
    if clampy {
        if my < z_ed_y { my = z_ed_y }
        if my > z_ed_y + z_ed_h - 1 { my = z_ed_y + z_ed_h - 1 }
    }
    var row = (my - z_ed_y + z_ed_off) / z_lh
    if row < 0 { row = 0 }
    if row > z_vis.len() - 1 { row = z_vis.len() - 1 }
    var li = z_vis[row]
    var vcol = (g_mx - z_gutx + z_cw / 2) / z_cw
    if vcol < 0 { vcol = 0 }
    var col = vis_to_col(z_lines[li], vcol)
    if col > z_lines[li].len() { col = z_lines[li].len() }
    return li * 1000000 + col
}
fn z_click_editor() {
    if z_drag and g_mdown {                  // drag: caret follows, selection extends
        let p = z_mouse_to_pos(true)
        z_cl = p / 1000000
        z_cc = p % 1000000
        if z_cl != z_al or z_cc != z_ac { z_sel = true }
        ensure_caret()
        return
    }
    if not g_mdown { z_drag = false }
    if not g_press { return }
    if g_mx < z_ed_x or g_mx >= z_ed_x + z_ed_w { return }
    if g_my < z_ed_y or g_my >= z_ed_y + z_ed_h { return }
    if g_mx < z_gutx - 8 {                   // click in the gutter
        var brow = (g_my - z_ed_y + z_ed_off) / z_lh
        if brow >= 0 and brow < z_vis.len() {
            let bl = z_vis[brow]
            if g_mx >= z_gutx - 20 and foldable(bl) {
                toggle_fold(bl)              // fold chevron zone
            } else {
                toggle_break(bl)             // breakpoint zone (far left)
            }
        }
        return
    }
    if g_mx < z_gutx - 1 {                   // VCS stripe column: click opens the diff
        let srow = (g_my - z_ed_y + z_ed_off) / z_lh
        if srow >= 0 and srow < z_vis.len() {
            let sl = z_vis[srow]
            if sl >= z_lst_a and sl < z_lst_b and z_base.len() > 0 {
                open_diff(z_base, "Changes vs HEAD")
                return
            }
        }
    }
    z_mc_sellen = 0                          // a click drops the armed multi-cursor selection
    let p = z_mouse_to_pos(false)
    let li = p / 1000000
    let col = p % 1000000
    if z_key(18) {                           // Alt+click -> add a caret
        let pl = z_cl
        let pc = z_cc
        z_cl = li
        z_cc = col
        mc_add(pl, pc)
        z_focus = 0
        return
    }
    begin_move(z_key(16))
    z_cl = li
    z_cc = col
    if z_key(17) {                           // Ctrl+click -> go to declaration
        z_focus = 0
        goto_decl(caret_word())
        return
    }
    let nowt = tick()
    if nowt - z_clk_t < 350 and li == z_clk_l and col >= z_clk_c - 1 and col <= z_clk_c + 1 {
        z_clk_n += 1
    } else {
        z_clk_n = 1
    }
    z_clk_t = nowt
    z_clk_l = li
    z_clk_c = col
    if z_clk_n >= 3 {                        // triple-click: select the line (IntelliJ)
        z_clk_n = 0
        z_al = li
        z_ac = 0
        z_cl = li
        z_cc = z_lines[li].len()
        z_sel = true
        z_sw_level = 2                       // Ctrl+W continues line -> declaration
        z_sw_l = li
        z_sw_c = col
        z_drag = false
        z_focus = 0
        ensure_caret()
        return
    }
    if z_clk_n == 2 {
        let s2 = z_lines[li]                 // double-click: select the word (IntelliJ gesture)
        var a2 = col
        while a2 > 0 and ea_id_part(s2.byte(a2 - 1)) { a2 -= 1 }
        var b2 = col
        while b2 < s2.len() and ea_id_part(s2.byte(b2)) { b2 += 1 }
        if b2 > a2 {
            z_al = li
            z_ac = a2
            z_cl = li
            z_cc = b2
            z_sel = true
            z_sw_level = 1                   // Ctrl+W keeps extending from the word
            z_sw_l = li
            z_sw_c = col
            z_drag = false
            z_focus = 0
            ensure_caret()
            return
        }
    }
    if not z_key(16) {                       // fresh press anchors the selection
        z_al = li
        z_ac = col
        z_sel = false
    }
    z_drag = true
    z_focus = 0
    comp_hide()
    ensure_caret()
}
fn z_frame_input() {
    if z_cw == 0 { z_measure() }
    build_vis()                             // visible-line map (code folding)
    let ctrl = z_key(17)
    let shift = z_key(16)
    // transitions we always sample (keeps prev-state fresh)
    let pF2 = z_pressed(113)
    let pF3 = z_pressed(114)
    let pF7 = z_pressed(118)
    let pJ = z_pressed(74)      // shared: Ctrl+Shift+J join / Alt+J next-occ / Ctrl+Alt+Shift+J all-occ
    let pL = z_pressed(76)
    let pLeft = z_rep(37)
    let pRight = z_rep(39)
    let pUp = z_rep(38)
    let pDown = z_rep(40)
    let pHome = z_pressed(36)
    let pEnd = z_pressed(35)
    let pPgUp = z_rep(33)
    let pPgDn = z_rep(34)
    let pDel = z_rep(46)
    let pBS = z_rep(8)
    let pEsc = z_pressed(27)
    if pEsc and z_hl_word != "" { z_hl_word = "" }   // Esc clears Highlight Usages
    let pF5 = z_pressed(116)
    let pS = z_pressed(83)
    let pZ = z_pressed(90)
    let pA = z_pressed(65)
    let pC = z_pressed(67)
    let pX = z_pressed(88)
    let pV = z_pressed(86)
    let pE = z_pressed(69)
    let pF = z_pressed(70)
    let pD2 = z_pressed(68)
    let pY2 = z_pressed(89)
    let pSl = z_pressed(191)
    let pTab = z_pressed(9)
    let alt = z_key(18)
    let pF11 = z_pressed(122)

    // Ctrl+scroll -> zoom font (consume the wheel so the editor doesn't scroll)
    if ctrl and g_wheelf != 0 {
        set_font_px(z_fontpx + g_wheelf)
        g_wheelf = 0
    }

    // double-Shift -> Search Everywhere (the IntelliJ gesture)
    if z_pressed(16) and not ctrl {
        let ts = tick()
        if ts - z_se_shift_t < 350 and z_popup == 0 and z_focus == 0 { se_open() }
        z_se_shift_t = ts
    }
    if z_popup == 8 {                       // Search Everywhere owns the keyboard
        if pEsc { z_popup = 0 }
        if pBS and z_se_q.len() > 0 {
            z_se_q = z_se_q.sub(0, z_se_q.len() - 1)
            z_se_sel = 0
        }
        if not ctrl and g_typed.len() > 0 {
            z_se_q = z_se_q + g_typed
            z_se_sel = 0
        }
        if pTab {
            z_se_tab = (z_se_tab + 1) % 4
            z_se_sel = 0
        }
        if pUp and z_se_sel > 0 { z_se_sel -= 1 }
        if pDown { z_se_sel += 1 }
        if g_enter { z_se_enter = true }    // executed by the results renderer
        return
    }
    if z_popup == 9 {                       // Recent Files (Ctrl+E)
        if pEsc { z_popup = 0 }
        if pUp and z_recent_sel > 0 { z_recent_sel -= 1 }
        if pDown { z_recent_sel += 1 }
        if g_enter { z_recent_enter = true }
        return
    }
    if z_popup == 19 {                      // Recent Locations (Ctrl+Shift+E)
        if pEsc { z_popup = 0 }
        if pUp and z_locs_sel > 0 { z_locs_sel -= 1 }
        if pDown { z_locs_sel += 1 }
        if g_enter { z_locs_enter = true }
        return
    }
    if z_popup == 23 {                      // Quick Definition: Esc closes
        if pEsc { z_popup = 0 }
        return
    }
    if z_popup == 22 {                      // Paste from History
        if pEsc { z_popup = 0 }
        if pUp and z_clip_sel > 0 { z_clip_sel -= 1 }
        if pDown { z_clip_sel += 1 }
        if g_enter { z_clip_enter = true }
        return
    }
    if z_popup == 24 {                      // Quick-fix (Alt+Enter intentions)
        if pEsc { z_popup = 0 }
        if g_enter { qf_apply() }
        return
    }
    if z_popup == 20 {                      // Switcher: cycle on Tab while Ctrl held
        if pTab {
            if shift { z_swi_sel -= 1 } else { z_swi_sel += 1 }
        }
        if pEsc {
            z_popup = 0
            return
        }
        if not ctrl {                       // releasing Ctrl commits (IntelliJ Switcher)
            z_popup = 0
            switcher_commit()
        }
        return
    }
    if z_popup == 18 {                      // Bookmarks list owns the keyboard
        if pEsc { z_popup = 0 }
        if pUp and z_bm_sel > 0 { z_bm_sel -= 1 }
        if pDown { z_bm_sel += 1 }
        if pDel and z_bm_sel < z_bm_paths.len() {
            let key = z_bm_paths[z_bm_sel] + ":" + (z_bm_lines[z_bm_sel] as str)
            var nb: [str] = []
            for b in z_bookmarks {
                if b != key { nb.push(b) }
            }
            z_bookmarks = nb
            bm_build()
        }
        if g_enter { z_bm_enter = true }
        return
    }
    if z_popup == 16 {                      // Find in Files owns the keyboard
        if pEsc { z_popup = 0 }
        if pBS and z_find_q.len() > 0 { z_find_q = z_find_q.sub(0, z_find_q.len() - 1) }
        if not ctrl and g_typed.len() > 0 { z_find_q = z_find_q + g_typed }
        if pUp and z_fif_sel > 0 { z_fif_sel -= 1 }
        if pDown { z_fif_sel += 1 }
        if g_enter { z_fif_enter = true }   // executed by the renderer (rows live there)
        return
    }
    if z_popup == 12 {                      // Find Usages
        if pEsc { z_popup = 0 }
        if pUp and z_usage_sel > 0 { z_usage_sel -= 1 }
        if pDown { z_usage_sel += 1 }
        if g_enter { z_usage_enter = true }
        return
    }
    if z_popup == 13 {                      // Local History
        if pEsc { z_popup = 0 }
        if pUp and z_hist_sel > 0 { z_hist_sel -= 1 }
        if pDown { z_hist_sel += 1 }
        if g_enter { z_hist_enter = true }
        return
    }
    if z_popup == 14 {                      // Diff viewer
        if pEsc { z_popup = 0 }
        if pPgUp { z_diff_off -= 12 }
        if pPgDn { z_diff_off += 12 }
        if pUp { z_diff_off -= 1 }
        if pDown { z_diff_off += 1 }
        if z_diff_off < 0 { z_diff_off = 0 }
        return
    }
    // right-click -> context menu (the toolkit only tracks the left button)
    if z_pressed(2) {
        z_popup = 0
        if g_mx >= z_ed_x and g_mx < z_ed_x + z_ed_w and g_my >= z_ed_y and g_my < z_ed_y + z_ed_h {
            if not z_sel {                  // no selection: caret follows the right-click
                let pp = z_mouse_to_pos(false)
                z_cl = pp / 1000000
                z_cc = pp % 1000000
            }
            z_ctx_x = g_mx
            z_ctx_y = g_my
            z_popup = 5
            z_popup_frame = g_frame
        } else if z_proj_on and g_mx >= 46 and g_mx < 46 + z_leftW and g_my >= 70 and g_my < ui_h() - 24 {
            z_ctx_file = ""
            var ri = 0
            var bestdy = 16                                  // nearest row within half-pitch
            while ri < z_trow_ys.len() {                     // rows recorded at their drawn y
                var dy = g_my - z_trow_ys[ri]
                if dy < 0 { dy = 0 - dy }
                if dy < bestdy and z_trow_paths[ri] != "" {
                    z_ctx_file = z_trow_paths[ri]
                    bestdy = dy
                }
                ri += 1
            }
            z_ctx_x = g_mx
            z_ctx_y = g_my
            z_popup = 6
            z_popup_frame = g_frame
        }
    }
    if z_popup == 7 {                       // file dialog owns the keyboard
        if pEsc {
            z_popup = 0
            z_input_mode = 0
        }
        if z_input_mode != 3 {
            if pBS and z_input_q.len() > 0 { z_input_q = z_input_q.sub(0, z_input_q.len() - 1) }
            if g_typed.len() > 0 { z_input_q = z_input_q + g_typed }
        }
        if g_enter { input_commit() }
        return
    }
    if z_popup != 0 {
        if pEsc { z_popup = 0 }
        return                              // popups own the keyboard
    }
    if ctrl and pL and not alt {            // Ctrl+L chat (Ctrl+Alt+L is reformat)
        z_chat_on = not z_chat_on
        if z_chat_on { z_focus = 1 } else { z_focus = 0 }
        return
    }
    if pF2 {                                // F2 / Shift+F2: next / previous error (IntelliJ)
        if shift { goto_error(0 - 1) } else { goto_error(1) }
        return
    }
    if pF3 {                                // F3 / Shift+F3: next / previous usage or match
        if shift { hl_jump(0 - 1) } else { hl_jump(1) }
        return
    }
    if pF7 and ctrl and shift {             // Ctrl+Shift+F7: Highlight Usages in File
        hl_set()
        return
    }
    if ctrl and pF {
        if shift {                               // Ctrl+Shift+F: Find in Files
            z_popup = 16
            z_popup_frame = g_frame
            z_fif_for = "\n"
            z_focus = 0
        } else {
            open_find()
            z_replace_on = false
        }
        return
    }
    if ctrl and z_pressed(82) {              // Ctrl+R: find & replace
        open_find()
        z_replace_on = true
        z_find_field = 0
        return
    }
    if shift and z_pressed(117) {           // Shift+F6: rename symbol
        let w = caret_word()
        if w != "" { open_dialog(5, w, w) }
        return
    }
    if alt and not ctrl and z_pressed(49) { // Alt+1: Project tool window (IntelliJ)
        if z_proj_on and z_left_mode == 0 {
            z_proj_on = false
        } else {
            z_proj_on = true
            z_left_mode = 0
        }
        return
    }
    if alt and not ctrl and z_pressed(55) { // Alt+7: Structure tool window (IntelliJ)
        if z_proj_on and z_left_mode == 1 {
            z_proj_on = false
        } else {
            z_proj_on = true
            z_left_mode = 1
        }
        return
    }
    if pF7 and alt {                        // Alt+F7: find usages
        find_usages(caret_word())
        return
    }
    if pJ and alt and not ctrl {            // Alt+J: Add Selection for Next Occurrence
        add_next_occurrence()
        return
    }
    z_click_editor()

    if z_focus == 2 {                       // find / replace bar owns the keyboard
        if pEsc {
            z_find_on = false
            z_replace_on = false
            z_focus = 0
            return
        }
        if pTab and z_replace_on { z_find_field = 1 - z_find_field }
        if z_find_field == 0 {
            if pBS and z_find_q.len() > 0 { z_find_q = z_find_q.sub(0, z_find_q.len() - 1) }
            if not ctrl and g_typed.len() > 0 { z_find_q = z_find_q + g_typed }
            if g_enter { find_next() }
        } else {
            if pBS and z_replace_q.len() > 0 { z_replace_q = z_replace_q.sub(0, z_replace_q.len() - 1) }
            if not ctrl and g_typed.len() > 0 { z_replace_q = z_replace_q + g_typed }
            if g_enter { replace_one() }
        }
        return
    }
    if z_focus == 1 {
        if pEsc { z_focus = 0 }
        if pBS and z_chat_input.len() > 0 {
            z_chat_input = z_chat_input.sub(0, z_chat_input.len() - 1)
        }
        if not ctrl and g_typed.len() > 0 { z_chat_input = z_chat_input + g_typed }
        if g_enter { chat_submit() }
        if pPgUp { z_chat_off -= 6 * z_lh }
        if pPgDn { z_chat_off += 6 * z_lh }
        return
    }
    if z_focus == 3 {                       // terminal
        if pEsc { z_focus = 0 }
        if pBS and z_term_in.len() > 0 { z_term_in = z_term_in.sub(0, z_term_in.len() - 1) }
        if not ctrl and g_typed.len() > 0 { z_term_in = z_term_in + g_typed }
        if g_enter { term_run() }
        return
    }
    if z_focus == 4 {                       // commit message
        if pEsc { z_focus = 0 }
        if pBS and z_commit_msg.len() > 0 { z_commit_msg = z_commit_msg.sub(0, z_commit_msg.len() - 1) }
        if not ctrl and g_typed.len() > 0 { z_commit_msg = z_commit_msg + g_typed }
        if ctrl and g_enter { git_commit() }   // Ctrl+Enter commits (IntelliJ)
        return
    }
    if z_focus == 6 {                       // add-watch expression
        if pEsc { z_focus = 0 }
        if pBS and z_dbg_wq.len() > 0 { z_dbg_wq = z_dbg_wq.sub(0, z_dbg_wq.len() - 1) }
        if not ctrl and g_typed.len() > 0 { z_dbg_wq = z_dbg_wq + g_typed }
        if g_enter {
            if z_dbg_wq.trim() != "" {
                z_dbg_watches.push(z_dbg_wq.trim())
                z_dbg_wq = ""
                z_focus = 0
                dbg_start()                 // restart with the new watch
            }
        }
        return
    }
    if z_find_on and pEsc {
        z_find_on = false
        z_find_q = ""
    }

    if z_comp_on {
        if pEsc {
            comp_hide()
            return
        }
        if pUp {
            if z_comp_sel > 0 { z_comp_sel -= 1 }
            return
        }
        if pDown {
            if z_comp_sel < z_comp_items.len() - 1 { z_comp_sel += 1 }
            return
        }
        if pTab {
            if not comp_fill_common() { comp_accept() }  // Tab: shared prefix first, else accept
            return
        }
        if g_enter {
            comp_accept()
            return
        }
    }
    var moved = false                       // only re-anchor the scroll on caret motion
    if ctrl {
        if pS {
            do_save()
            notify("Saved " + z_path)
        }
        if pZ {
            if alt {
                rollback_lines()             // Ctrl+Alt+Z: Rollback changed lines
            } else if shift {
                do_redo()                    // Ctrl+Shift+Z: Redo
            } else {
                do_undo()
            }
            moved = true
        }
        if pA {
            if shift {                      // Ctrl+Shift+A: Find Action (GotoActionAction)
                se_open()
                z_se_tab = 3
            } else {
                do_select_all()
            }
        }
        if shift and z_pressed(78) {        // Ctrl+Shift+N: Go to File (GotoFileAction)
            se_open()
            if alt { z_se_tab = 2 } else { z_se_tab = 1 }   // +Alt = Go to Symbol
        }
        if alt and not shift and z_pressed(78) { inline_var() }   // Ctrl+Alt+N: Inline
        if pC {
            if alt and shift {              // Ctrl+Alt+Shift+C: Copy Reference
                set_clipboard(shownname() + ":" + ((z_cl + 1) as str))
                notify("Copied reference " + shownname() + ":" + ((z_cl + 1) as str))
            } else if alt {                 // Ctrl+Alt+C: Extract Constant
                if z_sel and z_al == z_cl {
                    open_dialog(11, "", "CONST")
                } else {
                    notify("Select an expression on one line first")
                }
            } else if shift {               // Ctrl+Shift+C: Copy Path
                set_clipboard(z_path)
                notify("Copied path " + z_path)
            } else {
                do_copy()
            }
        }
        if pX {
            do_cut()
            moved = true
        }
        if pV {
            if alt {                        // Ctrl+Alt+V: Introduce Variable
                if z_sel and z_al == z_cl {
                    open_dialog(8, sel_text(), "value")
                } else {
                    notify("Select an expression on one line first")
                }
            } else if shift {               // Ctrl+Shift+V: Paste from History
                if z_clips.len() > 0 {
                    z_popup = 22
                    z_popup_frame = g_frame
                    z_clip_sel = 0
                } else {
                    notify("Clipboard history is empty")
                }
            } else {
                do_paste()
                moved = true
            }
        }
        if pE {
            if shift {                      // Ctrl+Shift+E: Recent Locations
                z_popup = 19
                z_popup_frame = g_frame
                z_locs_sel = 0
            } else {                        // Ctrl+E: Recent Files
                z_popup = 9
                z_popup_frame = g_frame
                z_recent_sel = 0
            }
        }
        if z_pressed(66) { goto_decl(caret_word()) }   // Ctrl+B: go to declaration
        if shift and z_pressed(73) { quick_def() }     // Ctrl+Shift+I: Quick Definition
        if z_pressed(80) { z_pinfo = not z_pinfo }     // Ctrl+P: Parameter Info
        if alt and z_pressed(84) {                     // Ctrl+Alt+T: Surround With
            if z_sel {
                z_popup = 21
                z_popup_frame = g_frame
            } else {
                notify("Select the lines to surround first")
            }
        }
        if alt and z_pressed(77) {                     // Ctrl+Alt+M: Extract Function
            if z_sel {
                open_dialog(9, "", "extracted")
            } else {
                notify("Select the lines to extract first")
            }
        }
        if z_pressed(75) and z_branch != "" {          // Ctrl+K: Commit (CheckinAction)
            show_dock(4)
            z_focus = 4
        }
        if z_pressed(219) { code_block_nav(false) }    // Ctrl+[: move to block start
        if z_pressed(221) { code_block_nav(true) }     // Ctrl+]: move to block end
        if shift and z_pressed(123) { hide_all_toggle() }   // Ctrl+Shift+F12
        if not shift and z_pressed(123) {              // Ctrl+F12: File Structure popup
            se_open()
            z_se_tab = 2
        }
        if shift and z_pressed(13) { smart_enter() }   // Ctrl+Shift+Enter: Complete Statement
        if z_pressed(115) { close_tab(z_tab) }         // Ctrl+F4: Close Tab
        if pTab and z_tabs.len() > 1 {                 // Ctrl+Tab: Switcher (MRU tabs)
            z_popup = 20
            z_popup_frame = g_frame
            z_swi_sel = 1
        }
        if alt and pL { reformat() }                   // Ctrl+Alt+L: reformat
        if alt and z_pressed(79) { optimize_imports() } // Ctrl+Alt+O: Optimize Imports
        if pD2 {                            // Ctrl+D: duplicate line
            dup_line()
            moved = true
        }
        if pY2 {                            // Ctrl+Y: delete line
            del_line()
            moved = true
        }
        if pSl {                            // Ctrl+/: toggle line comment
            toggle_comment()
            moved = true
        }
        if pJ and shift and alt {           // Ctrl+Alt+Shift+J: Select All Occurrences
            select_all_occurrences()
        } else if pJ and shift {            // Ctrl+Shift+J: join lines
            join_lines_action()
            moved = true
        }
        if z_pressed(190) {                 // Ctrl+.: fold / unfold at caret
            let hf = enclosing_fold(z_cl)
            if hf >= 0 {
                toggle_fold(hf)
                if is_folded(hf) { z_cl = hf }
            }
        }
        if shift and z_pressed(189) { fold_all() }     // Ctrl+Shift+- : collapse all
        if shift and z_pressed(187) { unfold_all() }   // Ctrl+Shift+= : expand all
        if z_pressed(71) { open_dialog(4, "", "") }   // Ctrl+G: go to line
        if z_pressed(81) {                  // Ctrl+Q: quick documentation
            let w = caret_word()
            z_qdoc_word = w
            z_qdoc = qdoc_for(w)            // builtins, else declaration + comments
            z_popup = 11
            z_popup_frame = g_frame
        }
        if z_pressed(87) {                  // Ctrl+W / Ctrl+Shift+W: extend / shrink selection
            if shift { select_word_shrink() } else { select_word_expand() }
        }
        if shift and z_pressed(77) {        // Ctrl+Shift+M: jump to matching brace
            jump_matching_brace()
            moved = true
        }
        if shift and z_pressed(85) {        // Ctrl+Shift+U: toggle case
            toggle_case()
            moved = true
        }
    } else {
        if pBS {
            if ctrl and shift {              // Ctrl+Shift+Backspace: Jump to Last Change
                if z_lastedit_l >= 0 {
                    push_loc()
                    if z_lastedit_path != z_path and z_lastedit_path != "" { open_file(z_lastedit_path) }
                    z_cl = z_lastedit_l
                    if z_cl > z_lines.len() - 1 { z_cl = z_lines.len() - 1 }
                    z_cc = z_lastedit_c
                    clamp_col()
                    ensure_caret()
                }
            } else if z_carets.len() > 0 {
                mc_backspace()
            } else if ctrl {
                delete_word_left()
                update_comp()
            } else {
                do_backspace()
                update_comp()
            }
            moved = true
        }
        if pTab and not ctrl {
            if z_sel {
                if shift { indent_block(0 - 1) } else { indent_block(1) }
            } else if shift {
                indent_block(0 - 1)
            } else {
                let n = 4 - (z_cc % 4)
                do_insert_str(" ".repeat(n))    // insert to the next tab stop
            }
            moved = true
        }
        if g_typed.len() > 0 {
            if z_carets.len() > 0 or z_mc_sellen > 0 {
                mc_insert(g_typed)           // replaces the armed same-word selection
            } else {
                typed_with_pairs(g_typed)
                update_comp()
            }
            moved = true
        }
        if g_enter and alt {                 // Alt+Enter: Show Intention Actions
            qf_open()
        } else if g_enter {
            mc_clear()
            do_enter()
            comp_hide()
            moved = true
        }
    }
    if pEsc and z_carets.len() > 0 { mc_clear() }
    if z_dbg_on {
        if z_pressed(119) { dbg_step() }               // F8 step -> next breakpoint
        if z_pressed(120) { dbg_resume() }             // F9 resume
        if pEsc { dbg_stop() }
    }
    if pF5 { do_run() }
    if shift and z_pressed(120) and not z_dbg_on { dbg_start() }   // Shift+F9: debug
    if pF11 {
        if shift {                           // Shift+F11: bookmarks list (IntelliJ)
            bm_build()
            z_bm_sel = 0
            z_popup = 18
            z_popup_frame = g_frame
        } else {
            toggle_bookmark()
        }
    }
    if pLeft or pRight or pUp or pDown or pHome or pEnd or pPgUp or pPgDn {
        z_mc_sellen = 0                      // any caret move drops the armed selection
    }
    if pLeft {
        if ctrl and alt {                    // Ctrl+Alt+Left: Navigate Back
            nav_back()
        } else if alt {                      // Alt+Left: previous tab (IntelliJ)
            if z_tabs.len() > 1 {
                tab_store()
                tab_load((z_tab + z_tabs.len() - 1) % z_tabs.len())
                run_diagnostics()
            }
        } else {
            begin_move(shift)
            if ctrl { move_word(0 - 1) } else { move_left() }
            moved = true
        }
    }
    if pRight {
        if ctrl and alt {                    // Ctrl+Alt+Right: Navigate Forward
            nav_forward()
        } else if alt {                      // Alt+Right: next tab
            if z_tabs.len() > 1 {
                tab_store()
                tab_load((z_tab + 1) % z_tabs.len())
                run_diagnostics()
            }
        } else {
            begin_move(shift)
            if ctrl { move_word(1) } else { move_right() }
            moved = true
        }
    }
    if pUp {
        if ctrl and alt {
            add_caret_above()
        } else if ctrl and shift {
            move_statement(0 - 1)            // Ctrl+Shift+Up: Move Statement Up
        } else if alt and shift {
            move_line(0 - 1)
        } else {
            begin_move(shift)
            move_up()
        }
        moved = true
    }
    if pDown {
        if ctrl and alt {
            add_caret_below()
        } else if ctrl and shift {
            move_statement(1)                // Ctrl+Shift+Down: Move Statement Down
        } else if alt and shift {
            move_line(1)
        } else {
            begin_move(shift)
            move_down()
        }
        moved = true
    }
    if pHome {
        begin_move(shift)
        if ctrl {                            // Ctrl+Home: document start (IntelliJ)
            z_cl = 0
            z_cc = 0
        } else {
            z_cc = smart_home_col(z_lines[z_cl], z_cc)
        }
        moved = true
    }
    if pEnd {
        begin_move(shift)
        if ctrl {                            // Ctrl+End: document end
            z_cl = z_lines.len() - 1
        }
        z_cc = z_lines[z_cl].len()
        moved = true
    }
    if pPgUp {
        begin_move(shift)
        page(-1)
        moved = true
    }
    if pPgDn {
        begin_move(shift)
        page(1)
        moved = true
    }
    if pDel {
        if alt {
            safe_delete()                    // Alt+Delete: Safe Delete
        } else if ctrl and shift {
            unwrap_block()                   // Ctrl+Shift+Delete: Unwrap
        } else if ctrl {
            delete_word_right()
            moved = true
        } else {
            do_delete()
            moved = true
        }
    }
    if moved { ensure_caret() }
}

// ---- rendering ----
fn draw_editor(x: int, y: int, w: int, h: int) {
    fill(x, y, w, h, COL_BG)
    z_ed_x = x
    z_ed_y = y
    z_ed_w = w
    z_ed_h = h
    let digits = (z_lines.len() as str).len()
    z_gutx = x + (digits + 1) * 9 + 26      // extra left margin for breakpoint/bookmark marks
    let content_h = z_vis.len() * z_lh + 40
    z_ed_off = ui_scroll_begin(9100, x, y, w, h, content_h, z_ed_off)
    ui_mono()
    // occurrence highlight: pinned Highlight-Usages word wins; else the
    // identifier under the caret (when nothing selected)
    var occ = ""
    if z_hl_word != "" { occ = z_hl_word } else if not z_sel { occ = caret_word() }
    // bracket matching: the bracket at/just-before the caret and its pair
    var bml1 = 0 - 1
    var bmc1 = 0
    var bml2 = 0 - 1
    var bmc2 = 0
    var bpos = 0 - 1
    if bracket_at(z_cl, z_cc) != 0 {
        bpos = z_cl * 1000000 + z_cc
    } else if bracket_at(z_cl, z_cc - 1) != 0 {
        bpos = z_cl * 1000000 + (z_cc - 1)
    }
    if bpos >= 0 {
        let m = find_match(bpos / 1000000, bpos % 1000000)
        if m >= 0 {
            bml1 = bpos / 1000000
            bmc1 = bpos % 1000000
            bml2 = m / 1000000
            bmc2 = m % 1000000
        }
    }
    let first_row = z_ed_off / z_lh
    var first = 0
    if first_row < z_vis.len() { first = z_vis[first_row] }
    var r = first_row
    while r < z_vis.len() {
        let i = z_vis[r]
        let yy = y + 4 - z_ed_off + r * z_lh
        if yy > y + h { break }
        // method separator (#43454a New UI METHOD_SEPARATORS_COLOR): above a declaration,
        // but not between consecutive one-line declarations (no stacked underlines)
        if i > 0 {
            let ts2 = z_lines[i].trim()
            if ts2.starts_with("fn ") or ts2.starts_with("struct ") or ts2.starts_with("enum ") {
                let tsp = z_lines[i - 1].trim()
                if not (tsp.starts_with("fn ") or tsp.starts_with("struct ") or tsp.starts_with("enum ")) {
                    fill(z_gutx, yy - 3, w - (z_gutx - x) - 8, 1, rgb(67, 69, 74))
                }
            }
        }
        if z_dbg_on and z_dbg_hits.len() > 0 and i == z_dbg_hits[z_dbg_pos] - 1 {
            fill(x, yy - 2, w, z_lh, rgb(62, 57, 28))          // current execution line (debugger)
        }
        if i == z_cl {
            fill(x, yy - 2, w, z_lh, rgb(38, 40, 46))          // #26282e New UI CARET_ROW_COLOR
        }
        if i >= z_lst_a and i < z_lst_b {                      // VCS change stripe
            var lc = rgb(55, 95, 173)                          // #375fad MODIFIED_LINES_COLOR
            if z_lst_add { lc = rgb(84, 145, 89) }             // #549159 ADDED_LINES_COLOR
            fill(z_gutx - 5, yy - 2, 3, z_lh, lc)
        }
        // occurrence highlight (identifier under caret, whole-word); selection
        // blue when a multi-cursor same-word selection is armed (type to replace)
        if occ != "" {
            var occol = rgb(55, 59, 57)      // #373b39 IDENTIFIER_UNDER_CARET
            if z_mc_sellen > 0 { occol = COL_ACTIVE }
            let ls = z_lines[i]
            var oo = 0
            while occ.len() > 0 and oo + occ.len() <= ls.len() {
                if ls.sub(oo, oo + occ.len()) == occ {
                    var bok = oo == 0
                    if not bok { bok = not is_alnum(ls.byte(oo - 1)) }
                    var aok = oo + occ.len() >= ls.len()
                    if not aok { aok = not is_alnum(ls.byte(oo + occ.len())) }
                    if bok and aok {
                        fill(z_gutx + oo * z_cw, yy - 2, occ.len() * z_cw, z_lh, occol)
                        oo += occ.len()
                    } else {
                        oo += 1
                    }
                } else {
                    oo += 1
                }
            }
        }
        // find-match highlights (dim green, JetBrains search style), toggle-aware
        if z_find_on and z_find_q != "" {
            var fm = find_in(z_lines[i], 0)
            while fm >= 0 {
                var fml = z_find_mlen
                if fml < 1 { fml = 1 }
                fill(z_gutx + fm * z_cw, yy - 2, fml * z_cw, z_lh, rgb(50, 89, 61))
                fm = find_in(z_lines[i], fm + fml)
            }
        }
        // selection on this line
        if z_sel {
            norm_sel()
            if i >= z_nsl and i <= z_nel {
                var a = 0
                var b = z_lines[i].len()
                if i == z_nsl { a = z_nsc }
                if i == z_nel { b = z_nec }
                if b < a { b = a }
                var sw = (b - a) * z_cw
                if i < z_nel and sw < z_cw { sw = z_cw }
                fill(z_gutx + a * z_cw, yy - 2, sw, z_lh, rgb(33, 66, 131))   // #214283 SELECTION_BACKGROUND
            }
        }
        let num = (i + 1) as str
        var nc = rgb(75, 80, 89)                      // #4b5059 New UI LINE_NUMBERS_COLOR
        if i == z_cl { nc = rgb(161, 163, 171) }      // #a1a3ab LINE_NUMBER_ON_CARET_ROW_COLOR
        dtext(z_gutx - 10 - num.len() * 9, yy, num, nc)
        // indent guides (#313438, New UI INDENT_GUIDE): one per 4-space level
        var gind = 0
        let gs = z_lines[i]
        while gind < gs.len() and gs.byte(gind) == 32 { gind += 1 }
        if gind == gs.len() { gind = 0 }              // blank lines draw no guides
        var glv = 1
        while glv * 4 < gind {
            fill(z_gutx + glv * 4 * z_cw, yy - 2, 1, z_lh, rgb(49, 52, 56))
            glv += 1
        }
        // matched-bracket outline (#3B6B5F, IntelliJ MATCHED_BRACE)
        if i == bml1 { frame(z_gutx + bmc1 * z_cw, yy - 2, z_cw, z_lh, rgb(61, 107, 95)) }
        if i == bml2 { frame(z_gutx + bmc2 * z_cw, yy - 2, z_cw, z_lh, rgb(61, 107, 95)) }
        // profiler heat strip (cold blue -> hot red), proportional to run count
        if z_prof_on and i + 1 < z_prof.len() and z_prof[i + 1] > 0 and z_prof_max > 0 {
            let pc = z_prof[i + 1] * 100 / z_prof_max
            fill(x, yy - 2, 4, z_lh, rgb(70 + pc * 175 / 100, 90 - pc * 40 / 100, 120 - pc * 70 / 100))
            dtext(z_gutx - 10 - ((i + 1) as str).len() * 9 - 4, yy, "", COL_FAINT)
        }
        // breakpoint dot (red) + bookmark strip (blue), IntelliJ gutter marks
        if line_break(i) { fill_rr(x + 3, yy, z_lh - 5, z_lh - 5, z_lh, rgb(219, 88, 96)) }
        if line_bookmarked(i) { fill(z_gutx - 6, yy - 1, 3, z_lh - 2, rgb(88, 157, 246)) }
        draw_code_line(z_gutx, yy, z_lines[i])
        if i + 1 == z_diag_line or line_has_sdiag(i) {
            var sqc = C_ERR                             // warnings squiggle gray (IntelliJ weak)
            if i + 1 != z_diag_line and line_sdiag_sev(i) == 1 { sqc = rgb(122, 126, 133) }
            let ln = z_lines[i].len()
            var ux = z_gutx
            var seg = 0
            while seg * 3 < ln * z_cw + z_cw {
                let yb = yy + z_lh - 3
                var yo = yb
                if seg % 2 == 1 { yo = yb - 2 }
                fill(z_gutx + seg * 3, yo, 2, 1, sqc)
                seg += 1
            }
        }
        // fold chevron in the gutter + collapsed "{...}" marker
        if foldable(i) {
            if is_folded(i) {
                chev_right(z_gutx - 18, yy + z_lh / 2 - 2, COL_DIM)
                let mx2 = z_gutx + (z_lines[i].len() + 1) * z_cw
                fill_rr(mx2, yy, 22, z_lh - 3, 6, rgb(60, 63, 68))
                dtext(mx2 + 4, yy, "...", COL_DIM)
            } else {
                chev_down(z_gutx - 20, yy + z_lh / 2 - 1, COL_FAINT)
            }
        }
        // caret
        if i == z_cl {
            let cvx = z_gutx + vis_col(z_lines[i], z_cc) * z_cw
            z_caret_px = cvx
            z_caret_py = yy
            if z_focus == 0 and (g_frame / 15) % 2 == 0 {
                fill(cvx, yy - 1, 2, z_lh - 2, COL_TEXT)
            }
        }
        // extra carets (multiple carets)
        var mci = 0
        while mci < z_carets.len() {
            if z_carets[mci] / 1000000 == i and (g_frame / 15) % 2 == 0 {
                fill(z_gutx + (z_carets[mci] % 1000000) * z_cw, yy - 1, 2, z_lh - 2, rgb(180, 200, 120))
            }
            mci += 1
        }
        r += 1
    }
    // sticky scroll: pin the enclosing fn/struct header at the top when scrolled into its body
    if first > 0 {
        scan_symbols()
        var stickyLine = 0 - 1
        var sk = 0
        while sk < z_sym_lines.len() {
            if z_sym_lines[sk] < first { stickyLine = z_sym_lines[sk] }
            sk += 1
        }
        var ind0 = 0
        let fl = z_lines[first]
        while ind0 < fl.len() and fl.byte(ind0) == 32 { ind0 += 1 }
        if stickyLine >= 0 and ind0 > 0 {
            fill(x, y, w, z_lh + 1, COL_PANEL)
            let num = (stickyLine + 1) as str
            dtext(z_gutx - 10 - num.len() * 9, y + 2, num, COL_FAINT)
            draw_code_line(z_gutx, y + 2, z_lines[stickyLine])
            fill(x, y + z_lh, w, 1, COL_BORDER)
        }
    }
    ui_ui()
    let em = ui_scroll_end()      // editor content height is computed, not measured
    // error stripe (IntelliJ analysis stripe): a proportional mark per diagnostic
    // on the right edge, over the scrollbar track
    if z_lines.len() > 0 {
        var si = 0
        while si < z_sdiag.len() {
            let sy2 = y + z_sdiag[si].line * (h - 8) / z_lines.len()
            var sc2 = C_ERR
            if z_sdiag[si].sev == 1 { sc2 = rgb(122, 126, 133) }
            fill(x + w - 6, sy2, 4, 3, sc2)
            si += 1
        }
        if z_diag_line >= 1 {
            let sy3 = y + (z_diag_line - 1) * (h - 8) / z_lines.len()
            fill(x + w - 6, sy3, 4, 3, C_ERR)
        }
    }
}
fn draw_chat(x: int, y: int, w: int, h: int) {
    fill(x, y, w, h, COL_PANEL)
    fill(x, y, 1, h, COL_BORDER)
    let sb = ui_selectb()
    zicon_cp(MI_BOT, x + 14, y + 6, COL_ACCENT)
    dtext(x + 38, y + 8, "Claude", COL_TEXT)
    ui_selectn()
    if z_ai_running { dtext(x + 38 + text_w("Claude") + 12, y + 8, "working...", COL_ACCENT) }
    let hy = y + 34
    fill(x, hy, w, 1, COL_BORDER)

    let input_h = 74
    let iy = y + h - input_h
    let cols = (w - 32) / 7
    // transcript
    var disp: [str] = []
    var dcol: [int] = []
    var mi = 0
    while mi < z_msgs.len() {
        let m = z_msgs[mi]
        var label = "You"
        var lc = rgb(90, 170, 255)
        if m.role == 1 {
            label = "Claude"
            lc = rgb(120, 200, 150)
        }
        if m.role == 2 {
            label = "System"
            lc = COL_FAINT
        }
        disp.push(label)
        dcol.push(lc)
        for wl in wrap(m.text, cols) {
            disp.push(wl)
            dcol.push(COL_TEXT)
        }
        disp.push("")
        dcol.push(COL_TEXT)
        mi += 1
    }
    let th = iy - hy - 8
    z_chat_off = ui_scroll_begin(9200, x, hy + 4, w, th, disp.len() * 19 + 8, z_chat_off)
    let voff = z_chat_off
    var r = 0
    while r < disp.len() {
        let yy = hy + 8 - voff + r * 19
        if yy > hy + th { break }
        if yy >= hy - 19 { dtext(x + 16, yy, disp[r], dcol[r]) }
        r += 1
    }
    let mm = ui_scroll_end()
    // input box
    var bcol = COL_OUTLINE
    if z_focus == 1 { bcol = COL_ACCENT }
    fill_rr(x + 10, iy, w - 20, input_h - 10, 10, COL_FIELD)
    frame_rr(x + 10, iy, w - 20, input_h - 10, 10, bcol)
    if z_chat_input == "" and z_focus != 1 {
        dtext(x + 18, iy + 8, "Ask Claude about this file...  (F2)", COL_FAINT)
    } else {
        var shown = z_chat_input
        if z_focus == 1 and (g_frame / 15) % 2 == 0 { shown = z_chat_input + "_" }
        var il = 0
        for wl in wrap(shown, cols) {
            if il < 2 { dtext(x + 18, iy + 8 + il * 19, wl, COL_TEXT) }
            il += 1
        }
    }
}
fn status_seg(ex: int, s: str, col: int) -> int {
    let w = text_w(s)
    dtext(ex - w, ui_h() - 20, s, col)
    return ex - w - 20
}

// ---- headless engine self-test ----
fn selftest() {
    set_content("hello\nworld")
    assert(z_lines.len() == 2, "load 2 lines")
    z_cl = 0
    z_cc = 5
    do_insert_str("!")
    assert(z_lines[0] == "hello!", "insert char")
    set_content("    abc")
    z_cl = 0
    z_cc = 7
    do_enter()
    assert(z_lines.len() == 2, "enter splits")
    assert(z_lines[1] == "    ", "auto-indent")
    set_content("ab\ncd")
    z_cl = 1
    z_cc = 0
    do_backspace()
    assert(z_lines.len() == 1, "backspace joins")
    assert(z_lines[0] == "abcd", "join text")
    set_content("hello world")
    z_al = 0
    z_ac = 0
    z_sel = true
    z_cl = 0
    z_cc = 6
    del_sel()
    assert(z_lines[0] == "world", "selection delete")
    set_content("x")
    z_cl = 0
    z_cc = 1
    do_insert_str("y")
    assert(z_lines[0] == "xy", "pre-undo")
    do_undo()
    assert(z_lines[0] == "x", "undo restores")
    set_content("a\nb\n")
    assert(z_lines.len() == 3, "trailing newline")
    assert(join_lines() == "a\nb\n", "round-trip")
    parse_diag("panic: x.zeph:42: error: bad thing\n")
    assert(z_diag_line == 42, "diag line")
    assert(z_diag_msg == "bad thing", "diag msg")
    // JetBrains keymap actions
    set_content("aaa\nbbb")
    z_cl = 0
    z_cc = 1
    dup_line()
    assert(z_lines.len() == 3, "dup adds a line")
    assert(z_lines[1] == "aaa", "dup copies")
    assert(z_cl == 1, "dup moves caret down")
    del_line()
    assert(z_lines.len() == 2, "del removes")
    set_content("    code here")
    z_cl = 0
    toggle_comment()
    assert(z_lines[0] == "    // code here", "comment adds after indent")
    toggle_comment()
    assert(z_lines[0] == "    code here", "comment round-trips")
    // find engine
    set_content("one two one\nthree one")
    z_find_q = "one"
    assert(find_count() == 3, "find counts")
    z_cl = 0
    z_cc = 0
    find_next()
    assert(z_cl == 0 and z_cc == 3, "find first")
    find_next()
    assert(z_cc == 11, "find second")
    find_next()
    assert(z_cl == 1, "find wraps to line 2")
    z_find_q = ""
    // diff engine
    var da: [str] = []
    da.push("a")
    da.push("b")
    da.push("c")
    diff_compute(da, da)
    assert(z_diff_k.len() == 3, "identical diff has 3 rows")
    var allsame = true
    for kk in z_diff_k { if kk != 0 { allsame = false } }
    assert(allsame, "identical diff all-same")
    var alll = true
    for rr in z_diff_r { if rr < 0 { alll = false } }
    assert(alll, "identical diff right side populated")
    var db2: [str] = []
    db2.push("a")
    db2.push("X")
    db2.push("c")
    diff_compute(da, db2)
    var changed = false
    for kk2 in z_diff_k { if kk2 != 0 { changed = true } }
    assert(changed, "changed diff has non-same rows")
    // multi-caret insert
    set_content("aa\nbb\ncc")
    z_cl = 0
    z_cc = 2
    var mcs: [int] = []
    mcs.push(1 * 1000000 + 2)
    mcs.push(2 * 1000000 + 2)
    z_carets = mcs
    mc_insert("!")
    assert(z_lines[0] == "aa!", "mc line 0")
    assert(z_lines[1] == "bb!", "mc line 1")
    assert(z_lines[2] == "cc!", "mc line 2")
    var ec: [int] = []
    z_carets = ec
    // folding brace match
    set_content("fn f() \{\n  x\n\}")
    assert(foldable(0), "fn is foldable")
    assert(fold_end(0) == 2, "fold end at brace")
    // fuzzy matcher (ported MinusculeMatcher): word-start > scattered, prefix > mid
    z_se_q = "fb"
    assert(se_score("fooBar") > se_score("affodbar"), "hump match ranks above scattered")
    assert(se_score("fooBar") > SE_NOMATCH, "fb matches fooBar")
    z_se_q = "open"
    assert(se_score("open_file") > se_score("reopened"), "prefix ranks above mid-word")
    z_se_q = "xyz"
    assert(se_score("abcdef") == SE_NOMATCH, "no match returns sentinel")
    // Find Action registry (GotoActionAction port)
    assert(SE_ACTIONS.len() == SE_ACTKEYS.len(), "every action has a shortcut-hint slot")
    assert(SE_ACTIONS.len() >= 30, "full action registry, not the stub")
    z_se_q = "dupl"
    assert(se_score("Duplicate Line") > SE_NOMATCH, "find-action matches Duplicate Line")
    z_se_q = ""
    // Quick Documentation (ShowQuickDocInfoAction port): comment block + declaration
    set_content("// adds one\nfn addone() \{\n\}")
    let qd = qdoc_for("addone")
    assert(qd.contains("adds one") and qd.contains("fn addone"), "quick doc = leading comment + declaration")
    assert(qdoc_for("push").contains("Append"), "builtin doc still served")
    // Parameter Info (ShowParameterInfoHandler port): call + active argument
    set_content("fn foo(a: int, b: str) \{\n\}\nfoo(1, 2)")
    z_cl = 2
    z_cc = 8
    let ps = pinfo_find()
    assert(ps.contains("fn foo(a: int, b: str)"), "parameter info finds the signature")
    assert(z_pinfo_arg == 1, "caret is in the second argument")
    z_cc = 4
    let ps2 = pinfo_find()
    assert(z_pinfo_arg == 0, "caret in the first argument")
    set_content("x = \"foo(\"")
    z_cl = 0
    z_cc = 9
    assert(pinfo_find() == "", "paren inside a string literal is not a call")
    // Recent Locations (RecentLocationsAction port): dedupe + preview capture
    set_content("aaa\nbbb")
    z_path = "t.zeph"
    z_cl = 0
    push_loc()
    push_loc()
    assert(z_locs_path.len() == 1, "duplicate location deduped")
    z_cl = 1
    push_loc()
    assert(z_locs_path.len() == 2 and z_locs_line[0] == 1, "new location prepended")
    assert(z_locs_prev[0] == "bbb", "preview captures the source line")
    z_path = ""
    // Alt+Click caret gesture toggles (IntelliJ Add-or-Remove Caret)
    set_content("a\nb\nc")
    z_cl = 0
    var ec9: [int] = []
    z_carets = ec9
    mc_add(1, 0)
    assert(z_carets.len() == 1, "alt-click adds a caret")
    mc_add(1, 0)
    assert(z_carets.len() == 0, "alt-click on an existing caret removes it")
    // Switcher MRU (Ctrl+Tab): touch dedupes and moves to front
    var em9: [str] = []
    z_mru = em9
    mru_touch("a.zeph")
    mru_touch("b.zeph")
    mru_touch("a.zeph")
    assert(z_mru.len() == 2 and z_mru[0] == "a.zeph" and z_mru[1] == "b.zeph", "MRU fronts the latest, dedupes")
    // Hide All Tool Windows: second press restores the exact prior layout
    z_proj_on = true
    z_show_out = false
    z_chat_on = true
    z_hideall = 0
    hide_all_toggle()
    assert(not z_proj_on and not z_chat_on and not z_show_out, "hide-all hides every panel")
    hide_all_toggle()
    assert(z_proj_on and z_chat_on and not z_show_out, "hide-all restores the saved layout")
    z_chat_on = false
    z_proj_on = true
    // project-wide rename: other files rewritten on disk, token-aware
    let rpd = exe_dir()
    write_file(rpd + ".rn_a.zeph", "count = 1\ns = \"count\"")
    z_path = rpd + ".rn_cur.zeph"
    set_content("count = 2")
    var zf9: [str] = []
    zf9.push(".rn_a.zeph")
