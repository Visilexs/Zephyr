    z_cc = 0
    hl_jump(1)
    assert(z_cl == 0 and z_cc == 4, "F3 skips 'xy' (whole-word) to the next 'x'")
    hl_jump(1)
    assert(z_cl == 1 and z_cc == 6, "F3 advances to the usage on the next line")
    hl_jump(1)
    assert(z_cl == 0 and z_cc == 0, "F3 wraps to the first usage")
    hl_jump(0 - 1)
    assert(z_cl == 1 and z_cc == 6, "Shift+F3 wraps backward to the last usage")
