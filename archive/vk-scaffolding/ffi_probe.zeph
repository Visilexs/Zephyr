// Stage 0/1 foundation probe: runtime DLL loading, Win64 calls through a
// resolved address, and a real call into vulkan-1.dll.

fn ualloc(n: int) -> int { return win("VirtualAlloc", 0, n, 12288, 4) }

fn cstrp(s: str) -> int {
    let n = s.len()
    let p = ualloc(n + 1)
    var i = 0
    while i < n {
        store8(p + i, s.byte(i))
        i += 1
    }
    store8(p + n, 0)
    return p
}

fn dlopen(dll: str) -> int {
    let h = win("LoadLibraryA", cstrp(dll))
    if h == 0 { panic("LoadLibraryA failed: {dll}") }
    return h
}

fn dlsym(h: int, dll: str, name: str) -> int {
    let p = win("GetProcAddress", h, cstrp(name))
    if p == 0 { panic("GetProcAddress failed: {dll}!{name}") }
    return p
}

// ---- acceptance 1: GetTickCount64 returns a plausible uptime ----
let k32 = dlopen("kernel32.dll")
let tick = callptr(dlsym(k32, "kernel32.dll", "GetTickCount64"))
print("uptime_ms = {tick}")
print("uptime_hours = {tick / 3600000}")
assert(tick > 1000, "uptime implausibly small")

// ---- acceptance 2: a call with arguments (Beep 750Hz for 300ms) ----
let beep = callptr(dlsym(k32, "kernel32.dll", "Beep"), 750, 300)
print("Beep returned {beep}")

// ---- stack args: >4 params exercises shadow space + stack marshalling ----
// GetSystemTime(&SYSTEMTIME) fills 8 u16 fields; read year/month/day back.
let buf = ualloc(16)
let st = callptr(dlsym(k32, "kernel32.dll", "GetSystemTime"), buf)
let year = load8(buf) + load8(buf + 1) * 256
let month = load8(buf + 2) + load8(buf + 3) * 256
let day = load8(buf + 6) + load8(buf + 7) * 256
print("date = {year}-{month}-{day}")
assert(year > 2000 and year < 3000, "year out of range")

// ---- acceptance 3: real Vulkan ----
let vk = dlopen("vulkan-1.dll")
let pver = ualloc(8)
let r = callptr(dlsym(vk, "vulkan-1.dll", "vkEnumerateInstanceVersion"), pver)
let v = load8(pver) + load8(pver + 1) * 256 + load8(pver + 2) * 65536 + load8(pver + 3) * 16777216
print("vkEnumerateInstanceVersion -> {r}")
print("vulkan {v / 4194304}.{(v / 4096) % 1024}.{v % 4096}")
assert(r == 0, "vkEnumerateInstanceVersion failed")

// count instance extensions (two-call idiom: query count, then fill)
let pcount = ualloc(8)
let r2 = callptr(dlsym(vk, "vulkan-1.dll", "vkEnumerateInstanceExtensionProperties"), 0, pcount, 0)
let next = load8(pcount) + load8(pcount + 1) * 256 + load8(pcount + 2) * 65536
print("instance extensions = {next}")
assert(r2 == 0 and next > 0, "extension enumeration failed")

print("OK")
