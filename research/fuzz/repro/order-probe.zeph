// research/fuzz/repro: evaluation-order probes (M57). Left-to-right expects 1 100 1000 1 1 1 1 1 1 1
struct P { a: int }
var g = 1
var xs: [int] = [1, 2, 3]
var p = P{a: 1}
fn bump() -> int { g = 100
    return 0 }
fn bumpx() -> int { xs[0] = 100
    return 0 }
fn bumpp() -> int { p.a = 100
    return 0 }
fn two(a: int, b: int) -> int { return a * 1000 + b }
fn main() {
    g = 1
    print(g + bump())            // global, binary op: LTR gives 1
    g = 1
    print(bump() + g)            // LTR gives 100
    g = 1
    print(two(g, bump()))        // call args: LTR gives 1000
    g = 1
    let l = [g, bump()]
    print(l[0])                  // list literal: LTR gives 1
    xs[0] = 1
    print(xs[0] + bumpx())       // element read: LTR gives 1
    p.a = 1
    print(p.a + bumpp())         // field read: LTR gives 1
    g = 1
    g = g + bump()               // compound: LTR gives 1
    print(g)
    g = 1
    g += bump()                  // += : LTR gives 1
    print(g)
    g = 1
    print(g * 1 + bump())        // nested: LTR gives 1
    g = 1
    let t = g
    print(t + bump())            // via let: 1 in any order
}
