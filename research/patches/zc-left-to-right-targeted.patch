+// research experiment (cycle 84): a leaf that may be read after `other` is
+// evaluated. A call in `other` may write a global, so a global leaf only
+// qualifies when `other` makes no call.
+fn isLeafAfter(expression: Node, other: Node) -> bool {
+    if not isLeaf(expression) { return false }
+    return expression.auxiliary != identifierKindGlobal or expression.nodeKind != nodeIdentifier or not hasCall(other)
