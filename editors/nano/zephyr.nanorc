## Zephyr (.zeph)
syntax zephyr "\.zeph$"
comment "//"

color brightcyan "\<[A-Z][A-Za-z0-9_]*\>"
color yellow "\<[A-Z][A-Z0-9_]+\>"
color brightwhite "\<[a-z_][A-Za-z0-9_]*[[:space:]]*\("
color brightblue "\<(fn|let|var|const|struct|enum|impl|interface|type|private|test|extern|import|as|from|if|else|match|while|for|in|step|break|continue|return|defer|self)\>"
color blue "\<(and|or|not)\>|->|\.\.|\?"
color cyan "\<(int|float|bool|str|void|i32|u8|f32|f64)\>"
color magenta "\<(print|panic|sqrt|emit|chr|bits|floatFromBits|args|readFile|writeFile|zeros|assert|abs|min|max|pow|syscall|addr|load8|load16|load32|load64|store8|store16|store32|store64|callPointer|callSysV|callSysVFloat|dynamicImport|stackPointer|spawnThread|parallelFor|cpuCount)\>"
color yellow "\<(true|false|none)\>"
color yellow "\<(0x[0-9A-Fa-f_]+|0b[01_]+|0o[0-7_]+|[0-9][0-9_]*(\.[0-9][0-9_]*)?([eE][+-]?[0-9]+)?)\>"
color green "'(\\x[0-9A-Fa-f]{2}|\\.|[^\\'])'"
color green ""([^"\\]|\\.)*""
color brightmagenta "\\([ntr0\\"'{}]|x[0-9A-Fa-f]{2})"
color green "r"[^"]*""
color green start="""" end=""""
color brightblack "//.*"
color brightblack start="/\*" end="\*/"
color brightwhite,red "TODO|FIXME|XXX"
