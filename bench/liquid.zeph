// Benchmark: particle-based viscoelastic fluid (Clavet et al. 2005).
// Neighbour-heavy float workload -- a uniform grid rebuilt twice per step,
// then two passes of irregular gather/scatter over each particle's neighbours.
// Same algorithm as examples/liquid.zeph with the rendering and input removed.
// Usage: liquid <steps>   (prints one checksum line)

let W = 320
let H = 240
let N = 6000
let RADIUS = 7.0
let DT = 1.0
let GRAV = 0.09
let REST = 4.5
let K = 0.055
let KNEAR = 0.28
let SIGMA = 0.03
let BETA = 0.06
let GW = W / 7 + 1
let GH = H / 7 + 1
let CELLS = GW * GH
let CAP = 40

fn fzeros(n: int) -> [float] {
    var a: [float] = []
    var i = 0
    while i < n {
        a.push(0.0)
        i += 1
    }
    return a
}
fn clampi(v: int, lo: int, hi: int) -> int {
    if v < lo { return lo }
    if v > hi { return hi }
    return v
}

var px = fzeros(N)
var py = fzeros(N)
var ox = fzeros(N)
var oy = fzeros(N)
var vx = fzeros(N)
var vy = fzeros(N)

var cnt = zeros(CELLS)
var bucket = zeros(CELLS * CAP)
var nbr = zeros(256)
var nd = fzeros(256)

fn build_grid() {
    var c = 0
    while c < CELLS {
        cnt[c] = 0
        c += 1
    }
    var i = 0
    while i < N {
        let cx = clampi((px[i] / RADIUS) as int, 0, GW - 1)
        let cy = clampi((py[i] / RADIUS) as int, 0, GH - 1)
        let k = cy * GW + cx
        let n = cnt[k]
        if n < CAP {
            bucket[k * CAP + n] = i
            cnt[k] = n + 1
        }
        i += 1
    }
}

fn neighbours(i: int) -> int {
    let xi = px[i]
    let yi = py[i]
    let cx = clampi((xi / RADIUS) as int, 0, GW - 1)
    let cy = clampi((yi / RADIUS) as int, 0, GH - 1)
    var n = 0
    var gy = cy - 1
    while gy <= cy + 1 {
        if gy >= 0 and gy < GH {
            var gx = cx - 1
            while gx <= cx + 1 {
                if gx >= 0 and gx < GW {
                    let k = gy * GW + gx
                    let m = cnt[k]
                    var s = 0
                    while s < m {
                        let j = bucket[k * CAP + s]
                        if j != i and n < 256 {
                            let dx = px[j] - xi
                            let dy = py[j] - yi
                            let d2 = dx * dx + dy * dy
                            if d2 < RADIUS * RADIUS {
                                nbr[n] = j
                                nd[n] = 1.0 - sqrt(d2) / RADIUS
                                n += 1
                            }
                        }
                        s += 1
                    }
                }
                gx += 1
            }
        }
        gy += 1
    }
    return n
}

fn viscosity() {
    var i = 0
    while i < N {
        let n = neighbours(i)
        var s = 0
        while s < n {
            let j = nbr[s]
            if j > i {
                let q = nd[s]
                var dx = px[j] - px[i]
                var dy = py[j] - py[i]
                let dist = sqrt(dx * dx + dy * dy)
                if dist > 0.0001 {
                    dx = dx / dist
                    dy = dy / dist
                    let u = (vx[i] - vx[j]) * dx + (vy[i] - vy[j]) * dy
                    if u > 0.0 {
                        var im = DT * q * (SIGMA * u + BETA * u * u) * 0.5
                        if im > u * 0.5 { im = u * 0.5 }
                        vx[i] -= dx * im
                        vy[i] -= dy * im
                        vx[j] += dx * im
                        vy[j] += dy * im
                    }
                }
            }
            s += 1
        }
        i += 1
    }
}

fn relax() {
    var i = 0
    while i < N {
        let n = neighbours(i)
        var rho = 0.0
        var rho_near = 0.0
        var s = 0
        while s < n {
            let q = nd[s]
            rho += q * q
            rho_near += q * q * q
            s += 1
        }
        let pres = K * (rho - REST)
        let pres_near = KNEAR * rho_near
        var dxi = 0.0
        var dyi = 0.0
        s = 0
        while s < n {
            let j = nbr[s]
            let q = nd[s]
            var dx = px[j] - px[i]
            var dy = py[j] - py[i]
            let dist = sqrt(dx * dx + dy * dy)
            if dist > 0.0001 {
                dx = dx / dist
                dy = dy / dist
                let d = DT * DT * (pres * q + pres_near * q * q) * 0.5
                px[j] += dx * d
                py[j] += dy * d
                dxi -= dx * d
                dyi -= dy * d
            }
            s += 1
        }
        px[i] += dxi
        py[i] += dyi
        i += 1
    }
}

fn step() {
    let wf = W as float
    let hf = H as float
    var i = 0
    while i < N {
        vy[i] += GRAV * DT
        i += 1
    }
    build_grid()
    viscosity()
    i = 0
    while i < N {
        ox[i] = px[i]
        oy[i] = py[i]
        px[i] += vx[i] * DT
        py[i] += vy[i] * DT
        i += 1
    }
    build_grid()
    relax()
    i = 0
    while i < N {
        if px[i] < 1.0 { px[i] = 1.0 }
        if px[i] > wf - 2.0 { px[i] = wf - 2.0 }
        if py[i] < 1.0 { py[i] = 1.0 }
        if py[i] > hf - 2.0 { py[i] = hf - 2.0 }
        vx[i] = (px[i] - ox[i]) / DT
        vy[i] = (py[i] - oy[i]) / DT
        i += 1
    }
}

var steps = 400
if args().len() > 1 { steps = args()[1] as int }

let cols = 46
var i = 0
while i < N {
    px[i] = 4.0 + ((i % cols) as float) * 1.72
    py[i] = 236.0 - ((i / cols) as float) * 1.72
    i += 1
}

var s = 0
while s < steps {
    step()
    s += 1
}

var chk = 0
i = 0
while i < N {
    chk += ((px[i] * 1000.0) as int) * 3 + ((py[i] * 1000.0) as int) * 7
    chk += ((vx[i] * 1000.0) as int) * 11 + ((vy[i] * 1000.0) as int) * 13
    i += 1
}
print(chk)
