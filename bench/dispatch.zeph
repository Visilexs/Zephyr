// Megamorphic dispatch benchmark: one interface with two methods and eight
// implementing structs (more receiver types than a small inline cache or a
// 4-way devirtualization guard can cover). A list of randomly mixed objects is
// walked for many rounds; each object transforms a running 20-bit value and
// reports a weight, both through the interface.
// C uses vtables of function pointers, Rust uses Vec<Box<dyn Transform>>.
// Usage: dispatch [count]   (default 1000000)

var rngState = 12345

fn nextRandom() -> int {
    rngState = rngState * 6364136223846793005 + 1442695040888963407
    return (rngState >> 33) & 2147483647
}

const valueMask = 1048575

interface Transform {
    fn apply(self, value: int) -> int
    fn weight(self) -> int
}

struct Adder { amount: int }
impl Adder {
    fn apply(self, value: int) -> int { return (value + self.amount) & valueMask }
    fn weight(self) -> int { return self.amount & 7 }
}

struct Multiplier { factor: int }
impl Multiplier {
    fn apply(self, value: int) -> int { return (value * self.factor) & valueMask }
    fn weight(self) -> int { return 1 }
}

struct XorMasker { key: int }
impl XorMasker {
    fn apply(self, value: int) -> int { return value ^ self.key }
    fn weight(self) -> int { return 2 }
}

struct Rotator { shift: int }
impl Rotator {
    fn apply(self, value: int) -> int { return ((value << self.shift) | (value >> (20 - self.shift))) & valueMask }
    fn weight(self) -> int { return self.shift }
}

struct Clamper { low: int, high: int }
impl Clamper {
    fn apply(self, value: int) -> int {
        if value < self.low { return self.low }
        if value > self.high { return self.high }
        return value
    }
    fn weight(self) -> int { return 3 }
}

struct AffineMixer { scale: int, offset: int }
impl AffineMixer {
    fn apply(self, value: int) -> int { return (value * self.scale + self.offset) & valueMask }
    fn weight(self) -> int { return 4 }
}

struct Divider { divisor: int }
impl Divider {
    fn apply(self, value: int) -> int { return value / self.divisor + self.divisor * 1000 }
    fn weight(self) -> int { return self.divisor }
}

struct Complementer { bias: int }
impl Complementer {
    fn apply(self, value: int) -> int { return (valueMask - value + self.bias) & valueMask }
    fn weight(self) -> int { return 5 }
}

fn makeTransform() -> Transform {
    let kind = nextRandom() % 8
    if kind == 0 { return Adder{amount: nextRandom() % 1000} }
    if kind == 1 { return Multiplier{factor: nextRandom() % 64 + 1} }
    if kind == 2 { return XorMasker{key: nextRandom() & valueMask} }
    if kind == 3 { return Rotator{shift: nextRandom() % 19 + 1} }
    if kind == 4 {
        let low = nextRandom() % 100000
        let high = low + nextRandom() % 900000
        return Clamper{low: low, high: high}
    }
    if kind == 5 {
        let scale = nextRandom() % 32 + 1
        let offset = nextRandom() % 1000
        return AffineMixer{scale: scale, offset: offset}
    }
    if kind == 6 { return Divider{divisor: nextRandom() % 16 + 1} }
    return Complementer{bias: nextRandom() % 1000}
}

var count = 1000000
if args().len() > 1 { count = args()[1] as int }
let rounds = 20

var transforms: [Transform] = []
for i in 0..count { transforms.push(makeTransform()) }

var checksum = 0
for round in 0..rounds {
    var value = round
    var weightTotal = 0
    for transform in transforms {
        value = transform.apply(value)
        weightTotal += transform.weight()
    }
    checksum = checksum * 31 + value
    checksum = checksum * 31 + weightTotal
}
print(checksum)
