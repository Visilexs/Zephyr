// Binary-trees benchmark (benchmarks game): allocate, walk and free perfect
// binary trees. One stretch tree of depth maxDepth + 1, one long-lived tree of
// depth maxDepth kept alive throughout, and for each depth from 4 to maxDepth
// in steps of 2, 2^(maxDepth - depth + 4) short-lived trees. Checks are
// recursive node counts; the checksum combines all of them.
// C uses malloc/free per node, Rust uses Option<Box<Node>>.
// Usage: bintrees [maxDepth]   (default 16)

struct Node { left: Node?, right: Node? }

fn bottomUpTree(depth: int) -> Node {
    if depth > 0 { return Node{left: bottomUpTree(depth - 1), right: bottomUpTree(depth - 1)} }
    return Node{left: none, right: none}
}

fn itemCheck(node: Node) -> int {
    var total = 1
    if let left = node.left { total += itemCheck(left) }
    if let right = node.right { total += itemCheck(right) }
    return total
}

const minimumDepth = 4

var maximumDepth = 16
if args().len() > 1 { maximumDepth = args()[1] as int }
if maximumDepth < minimumDepth + 2 { maximumDepth = minimumDepth + 2 }

var checksum = itemCheck(bottomUpTree(maximumDepth + 1))
let longLivedTree = bottomUpTree(maximumDepth)

var depth = minimumDepth
while depth <= maximumDepth {
    let iterations = 1 << (maximumDepth - depth + minimumDepth)
    var check = 0
    for i in 0..iterations { check += itemCheck(bottomUpTree(depth)) }
    checksum = checksum * 31 + check
    depth += 2
}
checksum = checksum * 31 + itemCheck(longLivedTree)
print(checksum)
