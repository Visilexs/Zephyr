var shared = [1, 2, 3, 4, 5, 6, 7, 8]
let alias = shared
axpy(shared, alias, 1, 0, 0, 7, 2)
assert(shared == [1, 4, 11, 26, 57, 120, 247, 502], "shifted aliases need scalar order")
var same = [1, 2, 3, 4, 5]
let sameAlias = same
axpy(same, sameAlias, 0, 0, 0, 5, 3)
assert(same == [4, 8, 12, 16, 20])
var negative = zeros(5)
axpy(negative, [1, 2, 3, 4, 5], -1, -1, 1, 6, 2)
assert(negative == [2, 4, 6, 8, 10])
var wrapped = zeros(4)
axpy(wrapped, [1, 2, 3, 4], 0x8000000000000000, 0x8000000000000000, 0x8000000000000000, -9223372036854775804, 3)
assert(wrapped == [3, 6, 9, 12], "wrapped index arithmetic needs scalar fallback")
var untouched = [9, 8, 7]
axpy(untouched, [1, 2, 3], 0, 0, 5, 5, 2)
axpy(untouched, [1, 2, 3], 0, 0, 5, 2, 2)
assert(untouched == [9, 8, 7])
var calls = 0
fn nextFactor() -> int { calls += 1
    return calls }
var output = zeros(5)
let input = [2, 2, 2, 2, 2]
let base = 0
for j in 0..5 { output[base + j] += nextFactor() * input[base + j] }
assert(calls == 5 and output == [2, 4, 6, 8, 10], "calls must not be hoisted")
var packed: [u8] = [1, 2, 3, 4, 5, 6] as [u8]
let packedInput: [u8] = [6, 5, 4, 3, 2, 1] as [u8]
let factor = 3
for j in 0..6 { packed[base + j] += factor * packedInput[base + j] }
assert(packed == ([19, 17, 15, 13, 11, 9] as [u8]), "packed lists use byte access")
print("axpy: 126 arithmetic cases and alias/empty/overflow/side-effect/packed checks passed")
