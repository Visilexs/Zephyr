// Native int64 bulk-loop regressions: independent wrapping arithmetic goldens.
fn axpy(output: [int], input: [int], outputBase: int, inputBase: int, low: int, high: int, factor: int) {
    for j in low..high { output[outputBase + j] += factor * input[inputBase + j] }
}
fn checkCase(input: [int], expected: [int], n: int, factor: int) {
    var output = zeros(n + 4)
    for i in 0..output.len() { output[i] = i - 7 }
    axpy(output, input, 2, 3, 0, n, factor)
    assert(output == expected, "wrapping arithmetic or tail handling")
}
