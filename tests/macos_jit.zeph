// Transition while recursive frames are live, keeping mutable globals shared.
var visits = 0
fn fib(n: int) -> int {
    visits += 1
    if n < 2 { return n }
    return fib(n - 1) + fib(n - 2)
}
assert(fib(20) == 6765)
assert(visits == 21891)

// Captured references and code pointers created before their function is hot.
var history: [str] = []
let prefix = "item"
let append = fn(n: int) -> str {
    let value = "{prefix}-{n}"
    history.push(value)
    return value
}
for i in 0..20 { assert(append(i) == "item-{i}") }
assert(history.len() == 20 and history[0] == "item-0")

// More than four arguments retain the stack calling convention across tiers.
fn wide(a: int, b: int, c: int, d: int, e: int, f: int) -> int {
    var result = 0
    for i in 0..a { result += b * c + d * e + f + i }
    return result
}
for i in 1..20 { assert(wide(i, 2, 3, 4, 5, 6) == i * 32 + i * (i - 1) / 2) }

// Double arguments, including negative zero, cross the profiling callback.
fn floating(x: float, y: float) -> float {
    var result = x
    for i in 0..4 { result = result * y + 0.25 }
    return result
}
for i in 0..12 { assert(floating(1.0, 2.0) == 19.75) }
assert(floating(-0.0, 1.0) == 1.0)

// Objects allocated in either generation can enter the original runtime.
interface Value { fn value(self) -> int }
struct Box { number: int }
impl Box { fn value(self) -> int { return self.number } }
var boxes: [Value] = []
for i in 0..20 { boxes.push(Box{number: i}) }
var total = 0
for box in boxes { total += box.value() }
assert(total == 190)
print("jit ok")
