// -O2 parity for builtins the optimizing tier lowers itself: string
// interpolation, print, pop, zeros, join and chr.

struct Point { x: int, y: float }

fn describe(point: Point, label: str) -> str { return "{label}: ({point.x}, {point.y}) {[1, 2, 3]} {true}" }

var total = 0
var saved: [str] = []
var stack: [Point] = []
var floats: [float] = []
for i in 0..3000 {
    let text = describe(Point{x: i, y: i as float / 4.0}, "p{i % 7}")
    total += text.len()
    if i % 700 == 0 { saved.push("{i}:{text}") }
    stack.push(Point{x: i, y: 0.5})
    floats.push(i as float * 1.5)
    if i % 3 == 0 {
        let top = stack.pop()
        total += top.x
        total += floats.pop() as int
    }
    var counts = zeros(i % 5 + 1)
    counts[i % counts.len()] += i
    total += counts[0]
    let letters = [chr(97 + i % 26), chr(65 + i % 26), "{i % 10}"]
    total += letters.join().len() + letters.join().byte(0)
}
print(total, stack.len(), floats.len())
for line in saved { print(line) }
print("nested {"inner {total % 10}"} done")
print(1.25)
print(stack.pop().x)

// casts through the runtime: to str, and str to int / float
enum Mood { Calm, Loud }
var castTotal = 0
var castFloats = 0.0
for i in 0..500 {
    let text = i as str
    castTotal += text.len() + (text as int)
    castFloats += ("{i}.25" as float) + ((i as float / 8.0) as str).len() as float
    let mood = if i % 2 == 0 { Mood.Calm } else { Mood.Loud }
    castTotal += (mood as str).len() + ((i % 2 == 0) as str).len()
}
print(castTotal, castFloats)

// a temporary string's length, used past a branch: the length load must not
// sink below the temporary's release
let pieces = ["aa", "bb", "ccc"]
var pieceTotal = 0
var pieceCount = 0
for i in 0..600 {
    pieceTotal += pieces[i % 3].sub(0, 1 + i % 2).len()
    if i % 2 == 0 { pieceCount += 3 } else { pieceCount += 4 }
}
print(pieceTotal, pieceCount)
