// Floats print like C's %.15g: 15 significant digits, correctly rounded,
// exponent form below 1e-4 and from 1e15, and -0.0 keeps its sign.
let zero = 0.0
print(0.0, -zero, 1.0, 0.1, 2.5, 1.0 / 3.0, 2.0 / 3.0)
print(1e-16, 0.0 - 2.5e-20, 0.0001, 0.00001, 0.000123456)
print(1e14, 1e15, 123456789012345.6, 999999999999999.9, 1e20, 1e300)
print(5e-324, 1.7976931348623157e308, 0.30000000000000004, 9.5)
print(zero / zero, 1.0 / zero, 0.0 - 1.0 / zero)
print("{-zero} {1e-7} {12345.678}")
