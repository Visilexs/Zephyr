// -O2 parity cases for scalar replacement: struct values the optimizer may
// keep in registers, and ones that must stay in memory.

struct Point { x: int, y: int }
struct Pair { left: float, right: float }
struct Named { label: str, value: int }

fn add(a: Point, b: Point) -> Point { return Point{x: a.x + b.x, y: a.y + b.y} }
fn swap(pair: Pair) -> Pair { return Pair{left: pair.right, right: pair.left} }

// too big to inline: the struct escapes into a real call
fn describe(point: Point) -> int {
    var total = 0
    for i in 0..3 {
        total += point.x * i + point.y
        if total > 1000 { total = total % 1000 }
        if total < 0 { total = 0 - total }
    }
    return total
}

let labels = ["a", "bb", "ccc", "dddd"]
var kept: [Point] = []
var checksum = 0
for i in 0..200 {
    // replaced: temporaries whose fields are only read
    let sum = add(Point{x: i, y: 2 * i}, Point{x: 3, y: 4})
    checksum = checksum * 7 + sum.x - sum.y
    let pair = swap(Pair{left: i as float, right: 0.5})
    checksum += (pair.left * 10.0) as int + (pair.right) as int

    // mutated after creation: stays in memory
    var moving = Point{x: i, y: i}
    moving.x = moving.x + 5
    checksum += moving.x * 3 + moving.y

    // chosen through a branch
    var chosen = Point{x: 1, y: 1}
    if i % 3 == 0 { chosen = Point{x: i, y: 0} }
    checksum += chosen.x + chosen.y

    // escapes: into a list, into a call, printed
    let stored = Point{x: i, y: i + 1}
    if i % 50 == 0 { kept.push(stored) }
    checksum += describe(Point{x: i, y: 7})

    // a reference field: never replaced
    let named = Named{label: labels[i % 4], value: i}
    checksum += named.label.len() + named.value
    checksum = checksum % 1000000007
}
print(checksum)
for point in kept { print(point.x, point.y) }

// element stores: a unique old element is overwritten in place, a shared one never
var grid: [Point] = []
for i in 0..6 { grid.push(Point{x: i, y: -i}) }
let held = grid[2]
for round in 0..3 {
    for i in 0..6 {
        let current = grid[i]
        grid[i] = Point{x: current.x + round, y: current.y * 2}
    }
}
grid[4] = grid[5]
grid[5] = Point{x: 500, y: 501}
print(held.x, held.y)
for point in grid { print(point.x, point.y) }
print(add(Point{x: 1, y: 2}, Point{x: 3, y: 4}).x)

// Top-level ordinary objects carry the baseline descriptor.
let replacementRounds = args().len()
var ordinaryPoints = [Point{x: 10, y: 20}, Point{x: 30, y: 40}]
let heldOrdinary = ordinaryPoints[1]
for replacementRound in 0..replacementRounds {
    ordinaryPoints[0] = Point{x: 50, y: 60}
    ordinaryPoints[1] = Point{x: 70, y: 80}
}
print("ordinary", ordinaryPoints[0].x, ordinaryPoints[0].y, ordinaryPoints[1].x, ordinaryPoints[1].y, heldOrdinary.x, heldOrdinary.y)

struct EmptyRecord { }
var emptyRecords = [EmptyRecord{}, EmptyRecord{}]
let heldEmptyRecord = emptyRecords[0]
for replacementRound in 0..replacementRounds {
    emptyRecords[0] = EmptyRecord{}
    emptyRecords[1] = EmptyRecord{}
}
print("empty", emptyRecords.len(), heldEmptyRecord)

enum StoredVariant {
    Text(str)
    Number(int)
    Empty
}

fn variantText(value: StoredVariant) -> str {
    return match value {
        Text(text) { text }
        Number(number) { "number{number}" }
        else { "empty" }
    }
}

let variantNumber = args().len()
var storedVariants = [StoredVariant.Text("old{variantNumber}"), StoredVariant.Text("unique{variantNumber}")]
let heldVariant = storedVariants[0]
for replacementRound in 0..replacementRounds {
    storedVariants[0] = StoredVariant.Number(12)
    storedVariants[1] = StoredVariant.Number(34)
}
print("variant", variantText(heldVariant), variantText(storedVariants[0]), variantText(storedVariants[1]))
for replacementRound in 0..replacementRounds {
    storedVariants[0] = StoredVariant.Text("new{variantNumber}")
    storedVariants[1] = StoredVariant.Empty
}
print("variant", variantText(heldVariant), variantText(storedVariants[0]), variantText(storedVariants[1]))

// Empty variants must not be reused as a larger payload variant.
var storedEmptyVariants = [StoredVariant.Empty]
for replacementRound in 0..replacementRounds { storedEmptyVariants[0] = StoredVariant.Empty }
for replacementRound in 0..replacementRounds { storedEmptyVariants[0] = StoredVariant.Number(71) }
print("emptyVariant", variantText(storedEmptyVariants[0]))
