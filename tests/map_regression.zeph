// Map ownership, tombstone churn, and integer key extremes.
var words: [str: [int]] = [:]
let key = "item-{7}"
let original = [10, 20]
words[key] = original
words["item-" + (7 as str)] = [30, 40]
original.push(50)
assert(words.len() == 1)
assert(words.has(key))
assert(words.get(key).get()[0] == 30)
assert(words.get("missing").or([-1])[0] == -1)
assert(original[0] == 10 and original.len() == 3)
print(original)
print(words[key])

let retained_keys = words.keys()
let retained_values = words.values()
words.remove("missing")
words.remove("item-" + (7 as str))
assert(words.len() == 0 and not words.has(key))
assert(retained_keys[0] == key)
assert(retained_values[0][0] == 30 and retained_values[0][1] == 40)
print(retained_values)
words["item-{7}"] = [60, 70]
let keys = words.keys()
keys.sort()
print(keys)

// Identifier defaults exercise fused get_or and retain both result aliases.
let fallback = [-1]
let hit = words.get(key).or(fallback)
let miss = words.get("absent").or(fallback)
words[key] = [61, 71]
assert(hit[0] == 60 and hit[1] == 70)
fallback.push(-2)
assert(miss.len() == 2 and miss[1] == -2)
words[key] = hit

// Keep 97 live entries while replacing thousands of distinct heap keys/values.
for i in 0..4096 {
    if i >= 97 { words.remove("churn-{i - 97}") }
    words["churn-{i}"] = [i, i + 1]
}
assert(words.len() == 98)
var checksum = 0
for i in 3999..4096 {
    let value = words.get("churn-{i}").get()
    checksum += value[0] + value[1]
}
assert(checksum == 785215)
print(checksum)
for i in 3999..4096 { words.remove("churn-{i}") }
assert(words.len() == 1 and words[key][0] == 60)
print(words.len())
print(words.get(key).or([0]))
print(words.get("missing").or([-1]))

let smallest = -9223372036854775807 - 1
let largest = 9223372036854775807
var numbers: [int: int] = [:]
numbers[smallest] = 1
numbers[0] = 2
numbers[-1] = 3
numbers[largest] = 4
numbers.remove(-1)
numbers.remove(42)
assert(not numbers.has(-1))
numbers[-1] = 30
assert(numbers.len() == 4)
assert(numbers.get(smallest).or(0) + numbers[0] + numbers[-1] + numbers[largest] == 37)
let number_keys = numbers.keys()
number_keys.sort()
print(number_keys)
print(numbers.get(42).or(-1))

var flags: [bool: int] = [:]
flags[false] = 10
flags[true] = 20
assert(flags.get(false).or(-1) == 10)
flags.remove(true)
assert(flags.get(true).or(-1) == -1)

var integer_values: [int: [int]] = [:]
integer_values[7] = original
integer_values[7] = [8, 9]
let integer_aliases = integer_values.values()
integer_values.remove(7)
assert(integer_values.len() == 0 and integer_aliases[0][1] == 9)
assert(original.len() == 3 and original[2] == 50)
print(integer_aliases)
let single = ["only": 7]
assert("{single}" == chr(123) + "\"only\": 7" + chr(125))
print(single)
print("map regression ok")
