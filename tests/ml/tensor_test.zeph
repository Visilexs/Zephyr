// Positive-path regression for lib/ml/tensor.zeph -- acceptance A02 and A03.
// The cases that must FAIL are separate one-line programs driven by
// tests/run_tests.ps1, because a rejection here is a panic and takes the
// process with it.
import "ml/tensor.zeph"

fn ck(cond: bool, name: str) -> int {
    assert(cond, name)
    return 1
}

// A view created inside a function outlives the owner handle: the counted
// heap keeps the Storage alive because the view still references it.
fn make_orphan_view() -> Tensor {
    let owner = tensorZeros(DType.F64, [3, 4])
    tensorSet(owner, [2, 3], 9.75)
    return tensorSlice(owner, 0, 1, 3)
}

var n = 0

// ---- A02: dtype and size contracts
n += ck(dtypeSize(DType.F32) == 4, "f32 is 4 bytes")
n += ck(dtypeSize(DType.F64) == 8, "f64 is 8 bytes")
n += ck(dtypeSize(DType.C32) == 8, "c32 is two f32 components")
n += ck(dtypeSize(DType.C64) == 16, "c64 is two f64 components")
n += ck(dtypeName(DType.C32) == "c32_components", "c32 name is unambiguous")
n += ck(dtypeName(DType.C64) == "c64_components", "c64 name is unambiguous")
n += ck(dtypeIsComplex(DType.C32), "c32 is complex")
n += ck(not dtypeIsComplex(DType.F64), "f64 is not complex")
n += ck(dtypeComponent(DType.C32) == DType.F32, "c32 component is f32")
n += ck(dtypeComponent(DType.C64) == DType.F64, "c64 component is f64")

// ---- A02: shape, stride, scalar and empty
n += ck(shapeElementCount([]) == 1, "rank zero holds one element")
n += ck(shapeElementCount([0]) == 0, "empty dimension holds none")
n += ck(shapeElementCount([2, 3, 4]) == 24, "numel is the product")
n += ck(shapeElementCount([5, 0, 3]) == 0, "any zero dimension empties the tensor")

let cs = contiguousStrides([2, 3, 4])
n += ck(cs[0] == 12 and cs[1] == 4 and cs[2] == 1, "row-major strides")
let cs1 = contiguousStrides([7])
n += ck(cs1[0] == 1, "rank one stride is 1")
n += ck(contiguousStrides([]).len() == 0, "rank zero has no strides")

let sc = tensorZeros(DType.F64, [])
n += ck(tensorRank(sc) == 0, "scalar has rank zero")
n += ck(tensorElementCount(sc) == 1, "scalar holds one element")
tensorSet(sc, [], 2.5)
n += ck(tensorGet(sc, []) == 2.5, "scalar round trip")

let emp = tensorZeros(DType.F64, [0, 4])
n += ck(tensorElementCount(emp) == 0, "empty tensor holds none")
n += ck(tensorIsContiguous(emp), "empty tensor is contiguous")

// ---- A02: broadcasting
n += ck(shapesEqual(broadcastShape([2, 1, 3], [1, 4, 1]), [2, 4, 3]), "broadcast [2,1,3]+[1,4,1]")
n += ck(shapesEqual(broadcastShape([3], [2, 3]), [2, 3]), "broadcast aligns from the right")
n += ck(shapesEqual(broadcastShape([], [2, 2]), [2, 2]), "scalar broadcasts to anything")
n += ck(shapesEqual(broadcastShape([1], [0]), [0]), "1 against 0 gives 0")
n += ck(shapesEqual(broadcastShape([5, 1], [5, 9]), [5, 9]), "broadcast keeps the non-unit size")
n += ck(shapesEqual(broadcastShape([4, 4], [4, 4]), [4, 4]), "equal shapes are unchanged")

// ---- A02: indexing and layout
let a = tensorZeros(DType.F64, [2, 3])
n += ck(tensorIsContiguous(a), "fresh tensor is contiguous")
n += ck(mlLiveBytes() > 0, "allocation is accounted")
tensorSet(a, [0, 0], 1.0)
tensorSet(a, [1, 2], 6.0)
n += ck(tensorGet(a, [0, 0]) == 1.0, "write then read [0,0]")
n += ck(tensorGet(a, [1, 2]) == 6.0, "write then read [1,2]")
n += ck(tensorGet(a, [0, 1]) == 0.0, "untouched element is zero")

// ---- A03: views share storage, and see each other's writes
let tr = tensorTranspose(a, 0, 1)
n += ck(tensorRank(tr) == 2, "transpose keeps rank")
n += ck(tr.shape[0] == 3 and tr.shape[1] == 2, "transpose swaps extents")
n += ck(tensorGet(tr, [2, 1]) == 6.0, "transposed view reads the same element")
n += ck(not tensorIsContiguous(tr), "transpose of a 2x3 is not contiguous")
tensorSet(tr, [0, 0], 42.0)
n += ck(tensorGet(a, [0, 0]) == 42.0, "write through a view is visible in the owner")

let sl = tensorSlice(a, 1, 1, 3)
n += ck(sl.shape[0] == 2 and sl.shape[1] == 2, "slice narrows one dimension")
n += ck(tensorGet(sl, [1, 1]) == 6.0, "slice offsets correctly")
tensorSet(sl, [0, 0], 7.5)
n += ck(tensorGet(a, [0, 1]) == 7.5, "write through a slice reaches the owner")

let rs = tensorReshape(a, [3, 2])
n += ck(rs.shape[0] == 3 and rs.shape[1] == 2, "reshape changes extents")
n += ck(tensorElementCount(rs) == tensorElementCount(a), "reshape preserves element count")
n += ck(tensorGet(rs, [0, 1]) == 7.5, "reshape aliases the same bytes")

// a length-1 dimension may carry any stride and still be contiguous
let one = tensorZeros(DType.F64, [1, 5])
n += ck(tensorIsContiguous(tensorTranspose(one, 0, 1)), "transposing a unit axis stays contiguous")

// ---- A03: a view keeps its storage alive after the owner handle is gone
let orph = make_orphan_view()
n += ck(orph.shape[0] == 2 and orph.shape[1] == 4, "orphan view has the sliced shape")
n += ck(tensorGet(orph, [1, 3]) == 9.75, "orphan view still reads valid memory")
tensorSet(orph, [0, 0], 1.25)
n += ck(tensorGet(orph, [0, 0]) == 1.25, "orphan view is still writable")

// ---- A03: mutation versions and stale saved tensors
let m = tensorZeros(DType.F64, [2, 2])
let v0 = tensorVersion(m)
let saved = tensorSave(m)
n += ck(not savedIsStale(saved), "freshly saved tensor is current")
n += ck(tensorVersion(savedGet(saved)) == v0, "saved_get returns the tensor while current")
tensorSet(m, [0, 0], 1.0)
n += ck(tensorVersion(m) == v0 + 1, "a write bumps the version")
n += ck(savedIsStale(saved), "the save is stale after a write")

// a write through a VIEW must invalidate a save taken on the owner
let m2 = tensorZeros(DType.F64, [2, 2])
let saved2 = tensorSave(m2)
let view2 = tensorTranspose(m2, 0, 1)
tensorSet(view2, [1, 0], 3.0)
n += ck(saved2.tensor.storage.version != saved2.version, "a write through a view staleness the owner's save")
n += ck(tensorGet(m2, [0, 1]) == 3.0, "and the write landed")

// ---- A03: repeated allocation returns to a baseline
mlResetAccounting()
n += ck(mlLiveBytes() == 0, "accounting resets to zero")
var loops = 0
while loops < 50 {
    let tmp = tensorZeros(DType.F64, [16, 16])
    tensorSet(tmp, [0, 0], 1.0)
    storageRelease(tmp.storage)
    loops += 1
}
n += ck(mlLiveBytes() == 0, "50 allocate/release cycles return to baseline")
n += ck(mlAllocations() == 50, "every allocation was counted")
n += ck(mlReleases() == 50, "every release was counted")
n += ck(mlPeakBytes() == 2048, "peak is one 16x16 f64 buffer, not fifty")

// ---- complex layout: interleaved, real then imaginary
let c = tensorZeros(DType.C32, [3])
tensorSetComplex(c, [0], 1.5, 0.0 - 2.25)
tensorSetComplex(c, [2], 0.0 - 0.5, 4.0)
n += ck(tensorGetReal(c, [0]) == 1.5, "c32 real component")
n += ck(tensorGetImaginary(c, [0]) == 0.0 - 2.25, "c32 imaginary component")
n += ck(tensorGetReal(c, [2]) == 0.0 - 0.5, "c32 real at another index")
n += ck(tensorGetImaginary(c, [2]) == 4.0, "c32 imaginary at another index")
n += ck(tensorGetReal(c, [1]) == 0.0 and tensorGetImaginary(c, [1]) == 0.0, "untouched complex is zero")

let c64 = tensorZeros(DType.C64, [2])
tensorSetComplex(c64, [1], 0.125, 0.0 - 0.375)
n += ck(tensorGetReal(c64, [1]) == 0.125, "c64 real component")
n += ck(tensorGetImaginary(c64, [1]) == 0.0 - 0.375, "c64 imaginary component")
n += ck(c64.storage.byteCount == 32, "c64[2] occupies 32 bytes")

// ---- integer and bool dtypes
let ii = tensorZeros(DType.I64, [3])
tensorSetInt(ii, [1], 0 - 7)
n += ck(tensorGetInt(ii, [1]) == 0 - 7, "i64 round trip including sign")
let bb = tensorZeros(DType.Bool, [2])
tensorSetInt(bb, [0], 1)
n += ck(tensorGetInt(bb, [0]) == 1, "bool true")
n += ck(tensorGetInt(bb, [1]) == 0, "bool false")
n += ck(bb.storage.byteCount == 2, "bool is one byte per element")

// f32 rounds at the store, and the rounding is visible rather than hidden
let f = tensorZeros(DType.F32, [1])
tensorSet(f, [0], 0.1)
n += ck(tensorGet(f, [0]) != 0.1, "f32 store rounds, and we do not pretend otherwise")
n += ck(tensorGet(f, [0]) > 0.09999 and tensorGet(f, [0]) < 0.10001, "f32 store is still close")

print("tensor: {n} checks passed")
