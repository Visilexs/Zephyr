// A41: the whole model lifecycle, natively, with no Python anywhere.
//
// "Native training/eval/checkpoint/resume/generation with PyTorch absent;
// optional oracle still works; project op-coverage ledger complete."
//
// This binary trains a causal model, evaluates it, checkpoints it, resumes
// from the checkpoint and generates from it, in one process, linked against
// kernel32 only. The claim "PyTorch absent" is not something a test can
// assert about the world, so it is arranged to be true by construction and
// checked the only way that means anything: the executable that produces
// these numbers imports nothing but kernel32, and nothing in this file or
// anything it imports shells out.
//
// The load-bearing check is resume equivalence, and it is exact. Twenty
// steps, checkpoint, twenty more gives bit-identical parameters to twenty
// steps, checkpoint, RESTORE, twenty more -- including both AdamW moment
// buffers and the step counter, because a resume that drops the moments
// still trains and still looks fine, just differently. Generation after the
// resume must also emit the identical token sequence, since a model that is
// numerically restored but generates differently has a broken generation
// path rather than a broken checkpoint.
import "ml/causal.zeph"
import "ml/optim.zeph"
import "ml/checkpoint.zeph"

var passed = 0
var failed = 0
fn chk(c: bool, what: str) {
    if c { passed = passed + 1 } else {
        failed = failed + 1
        print("FAIL: {what}")
    }
}

var SEED = 20260921
fn rnd() -> float {
    SEED = (SEED * 1103515245 + 12345) % 2147483648
    return ((SEED % 2001) as float) / 1000.0 - 1.0
}
fn fill(t: Tensor) {
    var idx = indexZeros(t.shape.len())
    var more = tensorElementCount(t) > 0
    while more {
        if dtypeIsComplex(t.dtype) { tensorSetComplex(t, idx, 0.3 * rnd(), 0.3 * rnd()) } else { tensorSet(t, idx, 0.3 * rnd()) }
        more = indexNext(idx, t.shape)
    }
}

let V = 7
let D = 6
let E = 4
let H = 8
let CFG = PhaseConfig{inputVocab: V, outputVocab: V, stateDimension: D, embeddingDimension: E, hiddenDimension: H, thinkSteps: 1, padToken: 0, epsilon: 0.00000001}

fn build() -> PhaseParams {
    SEED = 424242
    let ps = [tensorZeros(DType.F64, [V, E]), tensorZeros(DType.F64, [E]), tensorZeros(DType.F64, [H, E + 3 * D]),
              tensorZeros(DType.F64, [H]), tensorZeros(DType.F64, [3 * D, H]), tensorZeros(DType.F64, [3 * D])]
    for i in 0..ps.len() { fill(ps[i]) }
    let zi = tensorZeros(DType.C64, [D])
    let Mo = tensorZeros(DType.C64, [V, D])
    fill(zi)
    fill(Mo)
    return PhaseParams{config: CFG, embedding: ps[0], think: ps[1], hiddenWeight: ps[2], hiddenBias: ps[3],
                       angleWeight: ps[4], angleBias: ps[5], initialState: zi, readoutMatrix: Mo}
}
fn plist(p: PhaseParams) -> [Tensor] {
    return [p.embedding, p.think, p.hiddenWeight, p.hiddenBias, p.angleWeight, p.angleBias, p.initialState, p.readoutMatrix]
}

let DATA = tensorZeros(DType.I64, [2, 6])
for r in 0..2 {
    for c in 0..6 { tensorSetInt(DATA, [r, c], 1 + (r * 3 + c) % 6) }
}
let RST = tensorZeros(DType.I64, [2, 6])

fn train_steps(p: PhaseParams, o: Optim, n: int) -> float {
    let ts = plist(p)
    var last = 0.0
    for stp in 0..n {
        autogradReset()
        let m = phaseAutogradParameters(p, true)
        let lo = causalLoss(m, DATA, RST, 0 - 1)
        autogradBackward(lo)
        let hs = [m.embedding, m.think, m.hiddenWeight, m.hiddenBias, m.angleWeight, m.angleBias, m.initialState, m.readoutMatrix]
        var gs: [Tensor] = []
        for i in 0..hs.len() { gs.push(tensorCopy(autogradGradient(hs[i]))) }
        clipGradientNorm(gs, 5.0)
        optimizerStep(o, ts, gs)
        last = tensorGet(autogradValue(lo), [0])
    }
    return last
}

fn copy_into(dst: [Tensor], src: [Tensor]) {
    for i in 0..dst.len() {
        var idx = indexZeros(dst[i].shape.len())
        var more = tensorElementCount(dst[i]) > 0
        while more {
            if dtypeIsComplex(dst[i].dtype) {
                tensorSetComplex(dst[i], idx, tensorGetReal(src[i], idx), tensorGetImaginary(src[i], idx))
            } else {
                tensorSet(dst[i], idx, tensorGet(src[i], idx))
            }
            more = indexNext(idx, dst[i].shape)
        }
    }
}

// Relative, matching the convention in optim_test.zeph: the suites run
// from the repository root.
let CKPT = "lifecycle.ckpt"

// ---- train, evaluate, checkpoint ---------------------------------------------
let A = build()
let optA = newAdamW(plist(A), 0.03, 0.9, 0.999, 0.00000001, 0.01)
let l0 = train_steps(A, optA, 20)
let ppl_before = causalPerplexity(A, DATA, RST)
print("after 20 steps: loss {l0}, perplexity {ppl_before}")
chk(l0 == l0 and l0 > 0.0, "training produced a finite loss ({l0})")
chk(ppl_before > 1.0, "perplexity is above one ({ppl_before})")

checkpointSave(CKPT, plist(A), optA)

// The generation the checkpointed model produces, for comparison after the
// resume.
autogradReset()
let gen_before = causalGenerate(phaseAutogradParameters(A, false), [1, 2, 3], 6)

// ---- continue without restoring ------------------------------------------------
let l1 = train_steps(A, optA, 20)
var contin: [Tensor] = []
for i in 0..plist(A).len() { contin.push(tensorCopy(plist(A)[i])) }
let steps_continued = optA.step
autogradReset()
let gen_continued = causalGenerate(phaseAutogradParameters(A, false), [1, 2, 3], 6)

// ---- restore and redo the same twenty steps ---------------------------------------
let ck = checkpointLoad(CKPT)
chk(ck.params.len() == 8, "the checkpoint holds eight parameter tensors ({ck.params.len()})")
chk(ck.optimizer.step == 20, "the checkpoint remembers the optimizer step count ({ck.optimizer.step})")

let B = build()
copy_into(plist(B), ck.params)
// Restoring the parameters is not enough and the test has to prove it: the
// optimizer state comes back too, from the same file.
let optB = ck.optimizer
let l2 = train_steps(B, optB, 20)

var same = 0
for i in 0..contin.len() {
    if tensorHex(contin[i]) == tensorHex(plist(B)[i]) { same = same + 1 }
}
chk(same == 8, "resume is bit-exact: all eight parameters match the uninterrupted run ({same} of 8)")
chk(tensorHex(tensorFull(DType.F64, [1], l1)) == tensorHex(tensorFull(DType.F64, [1], l2)),
    "and the loss at the same step is bit-identical ({l1} against {l2})")
chk(optB.step == steps_continued, "the step counter matches ({optB.step} against {steps_continued})")

// Evaluation after the resume agrees, and generation emits the same tokens.
let ppl_after = causalPerplexity(B, DATA, RST)
autogradReset()
let gen_after = causalGenerate(phaseAutogradParameters(B, false), [1, 2, 3], 6)
var gsame = true
if gen_after.len() != gen_continued.len() { gsame = false } else {
    for i in 0..gen_after.len() {
        if gen_after[i] != gen_continued[i] { gsame = false }
    }
}
chk(gsame, "generation after the resume emits the identical token sequence")
var gstr = ""
for i in 0..gen_after.len() { gstr = gstr + " {gen_after[i]}" }
print("generation after resume:{gstr}")

// A model that had NOT been trained on must generate something else, or the
// comparison above is vacuous.
var moved = false
if gen_before.len() == gen_continued.len() {
    for i in 0..gen_before.len() {
        if gen_before[i] != gen_continued[i] { moved = true }
    }
} else { moved = true }
chk(moved or ppl_after != ppl_before,
    "twenty more steps changed the model, so the resume comparison is not comparing two identical things")

// ---- the checkpoint file itself -------------------------------------------------
let raw1 = checkpointRead(CKPT)
checkpointSave(CKPT, plist(B), optB)
let raw2 = checkpointRead(CKPT)
// The second save holds different parameters, so the payload must differ.
// Written as a real comparison: the first version of this check ended in
// "or true", which cannot fail and was therefore worth nothing.
var payload_differs = raw1.size != raw2.size
if not payload_differs {
    for i in 32..raw1.size {
        if raw1.get8(i) != raw2.get8(i) { payload_differs = true }
    }
}
chk(payload_differs, "re-saving a trained-on model writes different bytes, so the file tracks the model")
let ck2 = checkpointLoad(CKPT)
var rt = 0
for i in 0..ck2.params.len() {
    if tensorHex(ck2.params[i]) == tensorHex(plist(B)[i]) { rt = rt + 1 }
}
chk(rt == 8, "a second save/load round trip is bit-exact ({rt} of 8)")

print("lifecycle: train, evaluate, checkpoint, resume and generate all completed natively")
print("perplexity {ppl_before} before the checkpoint, {ppl_after} after resuming and training on")

if failed == 0 {
    print("lifecycle: {passed} checks passed")
} else {
    print("lifecycle: {failed} FAILED, {passed} passed")
    panic("lifecycle tests failed")
}
