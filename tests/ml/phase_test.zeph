// Standalone M3 invariants, including isolated child-process panic checks.
import "ml/phase.zeph"

fn ck(cond: bool, name: str) -> int {
    assert(cond, name)
    return 1
}

fn near(a: float, b: float) -> bool { return fabs(a - b) <= 0.000000000001 * (1.0 + fabs(b)) }

// Nonzero, nonuniform fixtures keep phase and both mixing stages observable.
fn test_params(d: int, k: int) -> PhaseParams {
    let c = PhaseConfig{inputVocab: 7, outputVocab: 3, stateDimension: d, embeddingDimension: 3, hiddenDimension: 5, thinkSteps: k, padToken: 0, epsilon: 0.00000001}
    let embedding = tensorZeros(DType.F64, [7, 3])
    let think = tensorZeros(DType.F64, [3])
    let w1 = tensorZeros(DType.F64, [5, 3 + 3 * d])
    let b1 = tensorFull(DType.F64, [5], 0.02)
    let w2 = tensorZeros(DType.F64, [3 * d, 5])
    let b2 = tensorZeros(DType.F64, [3 * d])
    let init = tensorZeros(DType.C64, [d])
    let matrix = tensorZeros(DType.C64, [3, d])
    let real = [embedding, think, w1, w2, b2]
    var serial = 1
    for t in real {
        var idx = indexZeros(t.shape.len())
        var more = true
        while more {
            tensorSet(t, idx, ((serial % 17) as float) / 100.0 - 0.08)
            serial += 1
            more = indexNext(idx, t.shape)
        }
    }
    for j in 0..d {
        tensorSetComplex(init, [j], 0.1 + (j as float) / (d as float), 0.2 - (j as float) / (2 * d) as float)
        for row in 0..3 { tensorSetComplex(matrix, [row, j], ((j + row + 1) as float) / (d as float), ((j * row + 2) as float) / (2 * d) as float) }
    }
    return PhaseParams{config: c, embedding: embedding, think: think, hiddenWeight: w1, hiddenBias: b1, angleWeight: w2, angleBias: b2, initialState: init, readoutMatrix: matrix}
}

fn test_tokens() -> Tensor {
    let tokens = tensorZeros(DType.I64, [3, 4])
    let values = [[1, 2, 3, 4], [5, 6, 0, 0], [0, 0, 0, 0]]
    for row in 0..3 {
        for step in 0..4 { tensorSetInt(tokens, [row, step], values[row][step]) }
    }
    return tokens
}

// Compare tensors over logical indices, including non-contiguous row slices.
fn tensor_near(a: Tensor, b: Tensor) -> bool {
    if a.dtype != b.dtype or not shapesEqual(a.shape, b.shape) { return false }
    var idx = indexZeros(a.shape.len())
    var more = tensorElementCount(a) > 0
    while more {
        if dtypeIsComplex(a.dtype) {
            if not near(tensorGetReal(a, idx), tensorGetReal(b, idx)) or not near(tensorGetImaginary(a, idx), tensorGetImaginary(b, idx)) { return false }
        } else {
            if not near(tensorGet(a, idx), tensorGet(b, idx)) { return false }
        }
        more = indexNext(idx, a.shape)
    }
    return true
}

// Panics are uncatchable: launch this executable in a single rejection mode.
fn rejects(mode: str) -> bool {
    let command = cString("\"{args()[0]}\" {mode}")
    let startup = Bytes.new(104)
    startup.put32(0, 104)
    let process = Bytes.new(24)
    let started = win("CreateProcessA", 0, command.address, 0, 0, 0, 134217728, 0, 0, startup.address, process.address)
    assert(started != 0, "start rejection child")
    let waited = win("WaitForSingleObject", process.get64(0), 30000)
    assert(waited == 0, "wait rejection child")
    let status = Bytes.new(4)
    let got = win("GetExitCodeProcess", process.get64(0), status.address)
    assert(got != 0, "read rejection status")
    let closed_process = win("CloseHandle", process.get64(0))
    let closed_thread = win("CloseHandle", process.get64(8))
    return status.get32(0) == 1
}

// A mistakenly accepted invalid call exits zero, so the parent fails its check.
if args().len() > 1 {
    let mode = args()[1]
    let bad = test_params(4, 0)
    let bad_tokens = test_tokens()
    if mode == "zero" { bad.initialState = tensorZeros(DType.C64, [4]) }
    if mode == "nonfinite" { tensorSetComplex(bad.initialState, [0], infinity, 0.0) }
    if mode == "overflow_norm" { tensorSetComplex(bad.initialState, [0], floatFromBits(2046 << 52), 0.0) }
    if mode == "token" { tensorSetInt(bad_tokens, [0, 0], 7) }
    if mode == "negative_token" { tensorSetInt(bad_tokens, [0, 0], 0 - 1) }
    if mode == "odd" { bad.config.stateDimension = 3 }
    if mode == "amplitude" {
        let state = phaseInitial(bad, 1)
        tensorSetComplex(state, [0, 0], infinity, 0.0)
        let ignored_readout = phaseReadout(bad, state)
    } else {
        let ignored_forward = phaseForward(bad, bad_tokens, false)
    }
    let accepted = win("ExitProcess", 0)
}

var n = 0
let tokens = test_tokens()
for dimension in [4, 8, 128] {
    let p = test_params(dimension, 4)
    let result = phaseForward(p, tokens, true)
    for state in result.trajectory {
        let norms = tensorSumDimension(tensorAbs2(state), 1)
        for row in 0..3 { n += ck(near(tensorGet(norms, [row, 0]), 1.0), "norm after full update, no renormalization") }
    }
    let rotated = tensorMultiply(result.state, tensorExpImaginary(tensorFull(DType.F64, [], 0.73), DType.C64))
    n += ck(tensor_near(phaseFeatures(result.state), phaseFeatures(rotated)), "global phase invariant features")
    n += ck(tensor_near(result.probabilities, phaseReadout(p, rotated)), "global phase invariant probabilities")
    let embedding = tensorExpand(p.think, [3, 3])
    let updated_rotated = phaseUpdate(p, rotated, embedding)
    let rotated_updated = tensorMultiply(phaseUpdate(p, result.state, embedding), tensorExpImaginary(tensorFull(DType.F64, [], 0.73), DType.C64))
    n += ck(tensor_near(updated_rotated, rotated_updated), "global phase equivariant update")
    let changed = tensorCopy(result.initial)
    tensorSetComplex(changed, [0, 0], 0.0 - tensorGetImaginary(changed, [0, 0]), tensorGetReal(changed, [0, 0]))
    n += ck(not tensor_near(phaseFeatures(changed), phaseFeatures(result.initial)), "relative phase changes features")
    for step in 0..4 {
        let before = tensorCopy(tensorSlice(result.trajectory[step], 0, 2, 3))
        let after = tensorCopy(tensorSlice(result.trajectory[step + 1], 0, 2, 3))
        n += ck(tensorHex(before) == tensorHex(after), "all-PAD row bit-identical")
        if step >= 2 {
            let padded_before = tensorCopy(tensorSlice(result.trajectory[step], 0, 1, 2))
            let padded_after = tensorCopy(tensorSlice(result.trajectory[step + 1], 0, 1, 2))
            n += ck(tensorHex(padded_before) == tensorHex(padded_after), "PAD suffix bit-identical")
        }
    }
    for row in 0..3 {
        let alone = phaseForward(p, tensorSlice(tokens, 0, row, row + 1), false)
        n += ck(tensor_near(alone.state, tensorSlice(result.state, 0, row, row + 1)), "batch-independent state")
        n += ck(tensor_near(alone.probabilities, tensorSlice(result.probabilities, 0, row, row + 1)), "batch-independent probabilities")
    }
    // Count active updates and independently compose exactly K THINK updates.
    for k in [0, 1, 4] {
        p.config.thinkSteps = k
        let counted = phaseForward(p, tokens, true)
        n += ck(counted.steps.len() == 4 + k, "exact sequence plus THINK step count")
        for row in 0..3 {
            var count = 0
            for step in counted.steps {
                for active_row in step.active {
                    if active_row == row { count += 1 }
                }
            }
            let valid = [4, 2, 0]
            n += ck(count == valid[row] + k, "exact per-row non-PAD plus THINK update count")
        }
        var expected = counted.trajectory[4]
        for repeat in 0..k { expected = phaseUpdate(p, expected, tensorExpand(p.think, [3, 3])) }
        n += ck(tensor_near(expected, counted.state), "exactly K THINK applications")
    }
}

// INTERFERENCE.md's constructed example, per DESIGN.md D16. The document
// specifies the normalized row (1,1)/sqrt(2) and then states the squared
// amplitude is 1+cos(delta) ranging 0 to 2. Both cannot hold: with that row
// the value is (1+cos(delta))/2. Assert what each row actually produces
// rather than carrying a bare factor of two that hides the discrepancy.
let unit = 1.0 / sqrt(2.0)
let norm_row = tensorZeros(DType.C64, [1, 2])
tensorSetComplex(norm_row, [0, 0], unit, 0.0)
tensorSetComplex(norm_row, [0, 1], unit, 0.0)
let raw_row = tensorZeros(DType.C64, [1, 2])
tensorSetComplex(raw_row, [0, 0], 1.0, 0.0)
tensorSetComplex(raw_row, [0, 1], 1.0, 0.0)
// the second orthonormal row, which is what makes the paragraph's real claim
let other_row = tensorZeros(DType.C64, [1, 2])
tensorSetComplex(other_row, [0, 0], unit, 0.0)
tensorSetComplex(other_row, [0, 1], 0.0 - unit, 0.0)
let want_first = [1.0, 0.5, 0.0]
var di = 0
for delta in [0.0, halfPi, pi] {
    let state = tensorZeros(DType.C64, [1, 2])
    tensorSetComplex(state, [0, 0], unit, 0.0)
    tensorSetComplex(state, [0, 1], unit * fcos(delta), unit * fsin(delta))
    let normalized = tensorAbs2(tensorMatmul(state, tensorTranspose(norm_row, 0, 1)))
    n += ck(near(tensorGet(normalized, [0, 0]), (1.0 + fcos(delta)) / 2.0), "normalized row gives (1+cos(delta))/2")
    let unnormalized = tensorAbs2(tensorMatmul(state, tensorTranspose(raw_row, 0, 1)))
    n += ck(near(tensorGet(unnormalized, [0, 0]), 1.0 + fcos(delta)), "unnormalized row gives 1+cos(delta)")
    // two orthonormal rows sweep constructive to destructive and sum to one
    let w0 = tensorGet(normalized, [0, 0])
    let w1 = tensorGet(tensorAbs2(tensorMatmul(state, tensorTranspose(other_row, 0, 1))), [0, 0])
    n += ck(near(w0 + w1, 1.0), "orthonormal rows conserve the total weight")
    n += ck(near(w0, want_first[di]), "interference sweeps constructive to destructive")
    // global phase moves neither weight
    let turned = tensorMultiply(state, tensorExpImaginary(tensorFull(DType.F64, [], 0.9), DType.C64))
    let g0 = tensorGet(tensorAbs2(tensorMatmul(turned, tensorTranspose(norm_row, 0, 1))), [0, 0])
    let g1 = tensorGet(tensorAbs2(tensorMatmul(turned, tensorTranspose(other_row, 0, 1))), [0, 0])
    n += ck(near(g0, w0) and near(g1, w1), "global phase leaves both weights unchanged")
    di += 1
}

// Readout includes one epsilon per class; zero amplitudes must be uniform.
let readout_params = test_params(4, 0)
let readout_state = phaseInitial(readout_params, 1)
readout_params.readoutMatrix = tensorZeros(DType.C64, [3, 4])
let uniform = phaseReadout(readout_params, readout_state)
for j in 0..3 { n += ck(near(tensorGet(uniform, [0, j]), 1.0 / 3.0), "zero amplitudes uniform") }
let basis = tensorZeros(DType.C64, [1, 4])
tensorSetComplex(basis, [0, 0], 1.0, 0.0)
tensorSetComplex(readout_params.readoutMatrix, [0, 0], sqrt(readout_params.config.epsilon), 0.0)
let smoothed = phaseReadout(readout_params, basis)
n += ck(near(tensorGet(smoothed, [0, 0]), 0.5), "denominator sum(w) + V*eps")
n += ck(near(tensorGet(smoothed, [0, 1]), 0.25), "epsilon included for zero class")
tensorSetComplex(readout_params.readoutMatrix, [0, 0], floatFromBits(1800 << 52), floatFromBits(1800 << 52))
let saturated = phaseReadout(readout_params, basis)
n += ck(near(tensorSumAll(saturated), 1.0) and near(tensorGet(saturated, [0, 0]), 1.0), "large finite amplitudes do not overflow abs2")
tensorSetComplex(readout_params.readoutMatrix, [0, 0], floatFromBits(1), floatFromBits(1))
let tiny = phaseReadout(readout_params, basis)
n += ck(near(tensorGet(tiny, [0, 0]), 1.0 / 3.0), "subnormal amplitude stability")
let empty_sequence = phaseForward(readout_params, tensorZeros(DType.I64, [1, 0]), true)
n += ck(empty_sequence.steps.len() == 0 and tensor_near(empty_sequence.initial, empty_sequence.state), "empty sequence K=0")
let all_pad = phaseForward(readout_params, tensorZeros(DType.I64, [1, 2]), true)
n += ck(all_pad.steps[0].active.len() == 0 and tensorHex(all_pad.initial) == tensorHex(all_pad.state), "empty active batch leaves state identical")

for mode in ["zero", "nonfinite", "overflow_norm", "token", "negative_token", "odd", "amplitude"] {
    n += ck(rejects(mode), "reject {mode}")
}
print("phase: {n} checks passed")
