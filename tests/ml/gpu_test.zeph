// A20: a tiny real and complex forward and backward on the device, checked
// against the CPU implementations that are themselves checked against numpy
// and PyTorch, plus the unavailable-backend message.
//
// The backward check is deliberately not "GPU formula against CPU formula" --
// that would compare gpuMatmulBackward to a copy of itself. It runs the
// autograd tape, whose matmul VJP is verified against finite differences in
// autograd_test.zeph, and compares the tape's gradients to the device's.
import "ml/gpu.zeph"
import "ml/autograd.zeph"

var passed = 0
var failed = 0
fn chk(c: bool, what: str) {
    if c { passed = passed + 1 } else {
        failed = failed + 1
        print("FAIL: {what}")
    }
}
fn near(a: float, b: float, tol: float, what: str) {
    let d = fabs(a - b) / (1.0 + fabs(b))
    if d <= tol { passed = passed + 1 } else {
        failed = failed + 1
        print("FAIL: {what}: got {a} want {b} rel {d}")
    }
}

// ---- the unavailable-backend message -------------------------------------
// Checked on a path that really is absent, so the branch is exercised rather
// than assumed. An unavailable backend that has a fixable cause must say so.
let msg = gpuKernelMissing("examples/shaders/no_such_kernel.comp.spv")
chk(msg != "", "missing kernel is reported")
chk(msg.contains("no_such_kernel.comp.spv"), "message names the missing file")
chk(msg.contains("build-compute-shaders.ps1"), "message names the fix")
chk(msg.contains("glslc"), "message names the tool the fix needs")
chk(gpuUnavailable() == "", "backend is available here")

let m = gpuInitialize()
print("device: {gpuDeviceName(m)}")

// ---- the optional device features the kernels rely on --------------------
// Every f64 kernel needs shaderFloat64 and scatter_add_f64 needs 64-bit
// buffer atomics. Both are optional in Vulkan and using one unenabled is
// undefined behaviour, so assert they really were enabled: a regression that
// silently stops requesting them would otherwise keep passing here by luck.
chk(m.g.hasFloat64, "shaderFloat64 is enabled on this device")
chk(m.g.hasInt64Atomics, "shaderBufferInt64Atomics is enabled on this device")

var SEED = 20260921
fn rnd() -> float {
    SEED = (SEED * 1103515245 + 12345) % 2147483648
    return ((SEED % 2001) as float) / 1000.0 - 1.0
}

let M = 5
let K = 7
let N = 4
// Deliberately not square and not multiples of the 16x16 workgroup, so the
// bounds guard in the shader is load-bearing. A kernel that ignored it would
// write outside the logical matrix and the comparison below would catch it.
chk(M % 16 != 0 and N % 16 != 0, "shapes are not workgroup multiples")

// ---- real float64 forward -------------------------------------------------
let A = tensorZeros(DType.F64, [M, K])
let B = tensorZeros(DType.F64, [K, N])
for i in 0..M {
    for j in 0..K { tensorSet(A, [i, j], rnd()) }
}
for i in 0..K {
    for j in 0..N { tensorSet(B, [i, j], rnd()) }
}
let C_cpu = tensorMatmul(A, B)
let C_gpu = gpuMatmul(m, A, B)
chk(tensorRank(C_gpu) == 2 and C_gpu.shape[0] == M and C_gpu.shape[1] == N, "real result shape")
for i in 0..M {
    for j in 0..N { near(tensorGet(C_gpu, [i, j]), tensorGet(C_cpu, [i, j]), 0.000000000001, "real forward [{i},{j}]") }
}

// ---- real backward, against the tape --------------------------------------
// loss = sum(A @ B), so dL/dC is all ones and the tape's gradients are the
// two matmuls gpuMatmulBackward should reproduce.
autogradReset()
let ia = autogradLeaf(A, true)
let ib = autogradLeaf(B, true)
autogradBackward(autogradSumAll(autogradMatmul(ia, ib)))
let gA_cpu = autogradGradient(ia)
let gB_cpu = autogradGradient(ib)
let gr = gpuMatmulBackward(m, A, B, tensorOnes(DType.F64, [M, N]))
for i in 0..M {
    for j in 0..K { near(tensorGet(gr[0], [i, j]), tensorGet(gA_cpu, [i, j]), 0.000000000001, "real dA [{i},{j}]") }
}
for i in 0..K {
    for j in 0..N { near(tensorGet(gr[1], [i, j]), tensorGet(gB_cpu, [i, j]), 0.000000000001, "real dB [{i},{j}]") }
}

// ---- complex float64 forward ----------------------------------------------
let cA = tensorZeros(DType.C64, [M, K])
let cB = tensorZeros(DType.C64, [K, N])
for i in 0..M {
    for j in 0..K { tensorSetComplex(cA, [i, j], rnd(), rnd()) }
}
for i in 0..K {
    for j in 0..N { tensorSetComplex(cB, [i, j], rnd(), rnd()) }
}
let cC_cpu = tensorMatmul(cA, cB)
let cC_gpu = gpuMatmul(m, cA, cB)
var any_im = false
for i in 0..M {
    for j in 0..N {
        near(tensorGetReal(cC_gpu, [i, j]), tensorGetReal(cC_cpu, [i, j]), 0.000000000001, "complex forward re [{i},{j}]")
        near(tensorGetImaginary(cC_gpu, [i, j]), tensorGetImaginary(cC_cpu, [i, j]), 0.000000000001, "complex forward im [{i},{j}]")
        if fabs(tensorGetImaginary(cC_cpu, [i, j])) > 0.01 { any_im = true }
    }
}
// Without this the imaginary comparisons above could all be passing on zeros,
// which a kernel that dropped the cross terms would also produce.
chk(any_im, "complex result has a non-trivial imaginary part")

// ---- complex backward, against the tape ------------------------------------
// loss = sum(abs2(A @ B)) is real, and under the dL = Re(sum(conj(g) dz))
// convention its gradient with respect to C is exactly 2C -- so the conjugate
// transposes in gpuMatmulBackward are exercised, not bypassed.
autogradReset()
let ica = autogradLeaf(cA, true)
let icb = autogradLeaf(cB, true)
autogradBackward(autogradSumAll(autogradAbs2(autogradMatmul(ica, icb))))
let cgA_cpu = autogradGradient(ica)
let cgB_cpu = autogradGradient(icb)
let gc = tensorAdd(cC_cpu, cC_cpu)
let cgr = gpuMatmulBackward(m, cA, cB, gc)
for i in 0..M {
    for j in 0..K {
        near(tensorGetReal(cgr[0], [i, j]), tensorGetReal(cgA_cpu, [i, j]), 0.000000000001, "complex dA re [{i},{j}]")
        near(tensorGetImaginary(cgr[0], [i, j]), tensorGetImaginary(cgA_cpu, [i, j]), 0.000000000001, "complex dA im [{i},{j}]")
    }
}
for i in 0..K {
    for j in 0..N {
        near(tensorGetReal(cgr[1], [i, j]), tensorGetReal(cgB_cpu, [i, j]), 0.000000000001, "complex dB re [{i},{j}]")
        near(tensorGetImaginary(cgr[1], [i, j]), tensorGetImaginary(cgB_cpu, [i, j]), 0.000000000001, "complex dB im [{i},{j}]")
    }
}

// ---- non-contiguous operands ----------------------------------------------
// gpuUpload reads through tensorGet, so a transposed view must upload correctly
// without being made contiguous first. This is exactly the shape the backward
// pass feeds it, so a repack bug here would corrupt every gradient.
let Bt = tensorTranspose(B, 0, 1)
let D_cpu = tensorMatmul(Bt, tensorTranspose(A, 0, 1))
let D_gpu = gpuMatmul(m, Bt, tensorTranspose(A, 0, 1))
for i in 0..N {
    for j in 0..M { near(tensorGet(D_gpu, [i, j]), tensorGet(D_cpu, [i, j]), 0.000000000001, "transposed view [{i},{j}]") }
}

gpuShutdown(m)

if failed == 0 {
    print("gpu: {passed} checks passed")
} else {
    print("gpu: {failed} FAILED, {passed} passed")
    panic("gpu tests failed")
}
