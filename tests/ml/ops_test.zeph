// Regression for lib/ml/ops.zeph -- acceptance A04 and A05.
// Analytic cases, identities, and the same operator run through
// non-contiguous views to prove the stride path agrees with the packed one.
// Values are also cross-checked against numpy from tools/ml_reference; this
// file is what runs without Python.
// Rejections live in tests/run_tests.ps1, one process each.
import "ml/ops.zeph"

fn ck(cond: bool, name: str) -> int {
    assert(cond, name)
    return 1
}

fn near(a: float, b: float, tol: float) -> bool {
    return fabs(a - b) <= tol * (1.0 + fabs(b))
}

let TOL = 0.0000000000001

var n = 0

// ---- A04: elementwise on a known matrix
let a = tensorZeros(DType.F64, [2, 3])
var v = 1.0
var i0 = 0
while i0 < 2 {
    var j0 = 0
    while j0 < 3 {
        tensorSet(a, [i0, j0], v)
        v += 1.0
        j0 += 1
    }
    i0 += 1
}
n += ck(tensorGet(a, [1, 2]) == 6.0, "fill by index")
n += ck(tensorSumAll(a) == 21.0, "sum of 1..6")
n += ck(tensorMeanAll(a) == 3.5, "mean of 1..6")

let two = tensorFull(DType.F64, [2, 3], 2.0)
n += ck(tensorGet(tensorAdd(a, two), [1, 2]) == 8.0, "add")
n += ck(tensorGet(tensorSubtract(a, two), [1, 2]) == 4.0, "sub")
n += ck(tensorGet(tensorMultiply(a, two), [1, 2]) == 12.0, "mul")
n += ck(tensorGet(tensorDivide(a, two), [1, 2]) == 3.0, "div")
n += ck(tensorGet(tensorNegate(a), [0, 0]) == 0.0 - 1.0, "neg")

// ---- A04: broadcasting, including rank extension
let row = tensorZeros(DType.F64, [1, 3])
tensorSet(row, [0, 0], 10.0)
tensorSet(row, [0, 1], 20.0)
tensorSet(row, [0, 2], 30.0)
let br = tensorAdd(a, row)
n += ck(br.shape[0] == 2 and br.shape[1] == 3, "broadcast keeps the wider shape")
n += ck(tensorGet(br, [0, 0]) == 11.0, "broadcast row over rank 0")
n += ck(tensorGet(br, [1, 2]) == 36.0, "broadcast row over rank 1")

let col = tensorZeros(DType.F64, [2, 1])
tensorSet(col, [0, 0], 100.0)
tensorSet(col, [1, 0], 200.0)
n += ck(tensorGet(tensorAdd(a, col), [1, 1]) == 205.0, "broadcast a column")
n += ck(tensorGet(tensorAdd(col, row), [1, 2]) == 230.0, "broadcast column against row")

let scal = tensorFull(DType.F64, [], 7.0)
n += ck(tensorGet(tensorAdd(a, scal), [0, 0]) == 8.0, "a rank-zero scalar broadcasts")

// a broadcast view is read-only, and expansion does not copy
let ex = tensorExpand(row, [4, 3])
n += ck(ex.readOnly, "expanded view is read-only")
n += ck(ex.stride[0] == 0, "expanded axis has stride zero")
n += ck(tensorGet(ex, [3, 1]) == 20.0, "every expanded row reads the source")

// ---- A04: the same operators through NON-CONTIGUOUS views
let tr = tensorTranspose(a, 0, 1)
n += ck(not tensorIsContiguous(tr), "transposed input is not contiguous")
let trsum = tensorSumAll(tr)
n += ck(trsum == 21.0, "sum over a transposed view matches")
let trdoub = tensorMultiply(tr, tensorFull(DType.F64, [3, 2], 2.0))
n += ck(tensorGet(trdoub, [2, 1]) == 12.0, "mul through a transposed view")
n += ck(tensorGet(trdoub, [0, 1]) == 8.0, "mul through a transposed view, again")

// a is [[1,2,3],[4,5,6]], so this slice is [[2,3],[5,6]]
let sl = tensorSlice(a, 1, 1, 3)
n += ck(tensorSumAll(sl) == 16.0, "sum over a slice: 2+3+5+6")
n += ck(tensorGet(sl, [1, 1]) == 6.0, "slice indexes through the offset")
n += ck(tensorGet(tensorAdd(sl, tensorFull(DType.F64, [2, 2], 2.0)), [1, 1]) == 8.0, "add through a slice")

// copying a non-contiguous view produces a contiguous one with equal values
let cp = tensorCopy(tr)
n += ck(tensorIsContiguous(cp), "copy of a view is contiguous")
n += ck(tensorSumAll(cp) == 21.0, "copy preserves values")
n += ck(tensorGet(cp, [2, 1]) == tensorGet(tr, [2, 1]), "copy agrees elementwise")

// ---- A04: matmul
let m = tensorZeros(DType.F64, [3, 2])
tensorSet(m, [0, 0], 1.0)
tensorSet(m, [1, 0], 0.0)
tensorSet(m, [2, 0], 1.0)
tensorSet(m, [0, 1], 0.0)
tensorSet(m, [1, 1], 1.0)
tensorSet(m, [2, 1], 1.0)
let p = tensorMatmul(a, m)
n += ck(p.shape[0] == 2 and p.shape[1] == 2, "matmul shape")
n += ck(tensorGet(p, [0, 0]) == 4.0, "matmul 0,0 = 1*1+2*0+3*1")
n += ck(tensorGet(p, [0, 1]) == 5.0, "matmul 0,1 = 1*0+2*1+3*1")
n += ck(tensorGet(p, [1, 0]) == 10.0, "matmul 1,0 = 4*1+5*0+6*1")
n += ck(tensorGet(p, [1, 1]) == 11.0, "matmul 1,1 = 4*0+5*1+6*1")

// identity, and matmul against a non-contiguous operand
let eye = tensorZeros(DType.F64, [3, 3])
tensorSet(eye, [0, 0], 1.0)
tensorSet(eye, [1, 1], 1.0)
tensorSet(eye, [2, 2], 1.0)
n += ck(tensorGet(tensorMatmul(a, eye), [1, 2]) == 6.0, "matmul by the identity is the input")
let mt = tensorTranspose(m, 0, 1)
n += ck(tensorGet(tensorMatmul(mt, tensorTranspose(a, 0, 1)), [1, 1]) == 11.0, "matmul of two transposed views")

// ---- A05: complex arithmetic, analytic cases
let c = tensorZeros(DType.C64, [2])
tensorSetComplex(c, [0], 3.0, 4.0)
tensorSetComplex(c, [1], 1.0, 0.0 - 1.0)
let d = tensorZeros(DType.C64, [2])
tensorSetComplex(d, [0], 1.0, 2.0)
tensorSetComplex(d, [1], 0.0, 1.0)

let cm = tensorMultiply(c, d)
n += ck(near(tensorGetReal(cm, [0]), 0.0 - 5.0, TOL), "(3+4i)(1+2i) real is -5")
n += ck(near(tensorGetImaginary(cm, [0]), 10.0, TOL), "(3+4i)(1+2i) imag is 10")
let cd = tensorDivide(c, d)
n += ck(near(tensorGetReal(cd, [0]), 2.2, TOL), "(3+4i)/(1+2i) real is 2.2")
n += ck(near(tensorGetImaginary(cd, [0]), 0.0 - 0.4, TOL), "(3+4i)/(1+2i) imag is -0.4")

// division is the inverse of multiplication
let rt = tensorDivide(tensorMultiply(c, d), d)
n += ck(near(tensorGetReal(rt, [0]), 3.0, TOL), "div undoes mul, real")
n += ck(near(tensorGetImaginary(rt, [0]), 4.0, TOL), "div undoes mul, imag")

n += ck(tensorGet(tensorAbs2(c), [0]) == 25.0, "abs2(3+4i) is 25")
n += ck(tensorGet(tensorAbs2(c), [1]) == 2.0, "abs2(1-i) is 2")
n += ck(tensorGetImaginary(tensorConjugate(c), [0]) == 0.0 - 4.0, "conj flips the imaginary sign")
n += ck(tensorGetReal(tensorConjugate(c), [0]) == 3.0, "conj leaves the real part")
n += ck(tensorGetImaginary(tensorConjugate(tensorConjugate(c)), [0]) == 4.0, "conj is an involution")
n += ck(tensorGet(tensorReal(c), [0]) == 3.0, "real part")
n += ck(tensorGet(tensorImaginary(c), [0]) == 4.0, "imag part")

// z * conj(z) is abs2, with a zero imaginary part
let zz = tensorMultiply(c, tensorConjugate(c))
n += ck(near(tensorGetReal(zz, [0]), 25.0, TOL), "z conj(z) real is abs2")
n += ck(near(tensorGetImaginary(zz, [0]), 0.0, TOL), "z conj(z) imag is zero")

// expi has unit modulus, and hits the analytic angles
let ang = tensorZeros(DType.F64, [3])
tensorSet(ang, [0], 0.0)
tensorSet(ang, [1], pi / 3.0)
tensorSet(ang, [2], halfPi)
let ep = tensorExpImaginary(ang, DType.C64)
n += ck(near(tensorGetReal(ep, [0]), 1.0, TOL), "expi(0) real is 1")
n += ck(near(tensorGetImaginary(ep, [0]), 0.0, TOL), "expi(0) imag is 0")
n += ck(near(tensorGetReal(ep, [1]), 0.5, TOL), "expi(pi/3) real is 1/2")
n += ck(near(tensorGetImaginary(ep, [1]), sqrt3 / 2.0, TOL), "expi(pi/3) imag is sqrt3/2")
n += ck(near(tensorGetImaginary(ep, [2]), 1.0, TOL), "expi(pi/2) imag is 1")
n += ck(near(tensorGet(tensorAbs2(ep), [1]), 1.0, TOL), "expi has unit modulus")

// complex matmul, against the hand-computed product
let ca = tensorZeros(DType.C64, [1, 2])
tensorSetComplex(ca, [0, 0], 1.0, 1.0)
tensorSetComplex(ca, [0, 1], 2.0, 0.0)
let cb = tensorZeros(DType.C64, [2, 1])
tensorSetComplex(cb, [0, 0], 0.0, 1.0)
tensorSetComplex(cb, [1, 0], 1.0, 0.0 - 1.0)
// (1+i)(i) + (2)(1-i) = (-1+i) + (2-2i) = 1 - i
let cp2 = tensorMatmul(ca, cb)
n += ck(near(tensorGetReal(cp2, [0, 0]), 1.0, TOL), "complex matmul real")
n += ck(near(tensorGetImaginary(cp2, [0, 0]), 0.0 - 1.0, TOL), "complex matmul imag")

// conjugate transpose is transpose plus conjugation
let ch = tensorConjugateTranspose(ca)
n += ck(ch.shape[0] == 2 and ch.shape[1] == 1, "conj transpose swaps extents")
n += ck(tensorGetImaginary(ch, [0, 0]) == 0.0 - 1.0, "conj transpose conjugates")

// ---- A05: byte layout, real then imaginary, little endian
let h32 = tensorZeros(DType.C32, [1])
tensorSetComplex(h32, [0], 1.5, 0.0 - 2.25)
n += ck(tensorHex(h32) == "0000c03f000010c0", "c32 layout matches numpy complex64")
let h64 = tensorZeros(DType.C64, [1])
tensorSetComplex(h64, [0], 0.125, 0.0 - 0.375)
n += ck(tensorHex(h64) == "000000000000c03f000000000000d8bf", "c64 layout matches numpy complex128")
n += ck(h32.storage.byteCount == 8, "one c32 element is 8 bytes")
n += ck(h64.storage.byteCount == 16, "one c64 element is 16 bytes")

// ---- reductions along an axis, and the empty cases
let sd0 = tensorSumDimension(a, 0)
n += ck(sd0.shape[0] == 1 and sd0.shape[1] == 3, "sum_dim keeps rank")
n += ck(tensorGet(sd0, [0, 0]) == 5.0, "column sum 1+4")
n += ck(tensorGet(sd0, [0, 2]) == 9.0, "column sum 3+6")
let sd1 = tensorSumDimension(a, 1)
n += ck(tensorGet(sd1, [0, 0]) == 6.0, "row sum 1+2+3")
n += ck(tensorGet(sd1, [1, 0]) == 15.0, "row sum 4+5+6")

let empt = tensorZeros(DType.F64, [0, 3])
n += ck(tensorSumAll(empt) == 0.0, "sum over no elements is zero")
n += ck(tensorElementCount(tensorAdd(empt, tensorFull(DType.F64, [1, 3], 1.0))) == 0, "empty broadcasts to empty")

let csum = tensorSumDimension(c, 0)
n += ck(near(tensorGetReal(csum, [0]), 4.0, TOL), "complex axis sum, real")
n += ck(near(tensorGetImaginary(csum, [0]), 3.0, TOL), "complex axis sum, imag")

// ---- f32 storage rounds at the store, and we say so rather than hide it
let f = tensorZeros(DType.F32, [2])
tensorSet(f, [0], 1.0)
tensorSet(f, [1], 3.0)
let fq = tensorDivide(f, tensorFull(DType.F32, [2], 3.0))
n += ck(near(tensorGet(fq, [0]), 1.0 / 3.0, 0.0000001), "f32 divide is close")
n += ck(tensorGet(fq, [0]) != 1.0 / 3.0, "f32 divide is not the f64 value, by construction")

// ---- real unary maps, gather/scatter, roll, concat (M3 prerequisites) ------

let x_um = tensorZeros(DType.F64, [2, 3])
for umi in 0..2 {
    for umj in 0..3 {
        tensorSet(x_um, [umi, umj], (umi * 3 + umj) as float * 0.25 - 0.5)
    }
}
let x_umt = tensorTanh(x_um)
n += ck(near(tensorGet(x_umt, [0, 0]), tanh(0.0 - 0.5), TOL), "tanh maps elementwise")
n += ck(near(tensorGet(x_umt, [1, 2]), tanh(0.75), TOL), "tanh reaches the last element")
n += ck(shapesEqual(x_umt.shape, x_um.shape), "tanh preserves shape")
n += ck(near(tensorGet(tensorCos(x_um), [0, 1]), fcos(0.0 - 0.25), TOL), "cos maps elementwise")
n += ck(near(tensorGet(tensorSin(x_um), [0, 1]), fsin(0.0 - 0.25), TOL), "sin maps elementwise")
n += ck(near(tensorGet(tensorExp(x_um), [1, 1]), fexp(0.5), TOL), "exp maps elementwise")
n += ck(near(tensorGet(tensorLn(tensorExp(x_um)), [1, 2]), 0.75, TOL), "ln undoes exp")

// the maps must also work through a non-contiguous view
let x_umv = tensorTranspose(x_um, 0, 1)
n += ck(near(tensorGet(tensorTanh(x_umv), [2, 1]), tanh(0.75), TOL), "tanh through a transposed view")

let x_e4 = tensorZeros(DType.F64, [2, 2])
tensorSet(x_e4, [0, 0], 1.0)
tensorSet(x_e4, [0, 1], 2.0)
tensorSet(x_e4, [1, 0], 3.0)
tensorSet(x_e4, [1, 1], 4.0)

let x_gsel = tensorIndexSelect(x_e4, 0, [1, 0, 1])
n += ck(x_gsel.shape[0] == 3 and x_gsel.shape[1] == 2, "index_select resizes only the indexed dim")
n += ck(tensorGet(x_gsel, [0, 0]) == 3.0 and tensorGet(x_gsel, [0, 1]) == 4.0, "index_select takes the right row")
n += ck(tensorGet(x_gsel, [1, 0]) == 1.0, "index_select reorders")
n += ck(tensorGet(x_gsel, [2, 1]) == 4.0, "index_select repeats a row")
let x_gcol = tensorIndexSelect(x_e4, 1, [1])
n += ck(x_gcol.shape[1] == 1 and tensorGet(x_gcol, [1, 0]) == 4.0, "index_select on dim 1")
let x_gempty = tensorIndexSelect(x_e4, 0, [])
n += ck(tensorElementCount(x_gempty) == 0 and x_gempty.shape[0] == 0, "index_select with no indices is empty")

// select must read through strides, not assume a packed buffer
let x_e4t = tensorTranspose(x_e4, 0, 1)
n += ck(tensorGet(tensorIndexSelect(x_e4t, 0, [1]), [0, 0]) == 2.0, "index_select through a transposed view")

// gather then scatter back by the same indices is the identity
let rtrip = tensorZeros(DType.F64, [2, 2])
tensorIndexCopy(rtrip, 0, [1, 0], tensorIndexSelect(x_e4, 0, [1, 0]))
n += ck(tensorGet(rtrip, [0, 0]) == 1.0 and tensorGet(rtrip, [1, 1]) == 4.0, "index_copy inverts index_select")

let x_cdst = tensorZeros(DType.C64, [3, 1])
let x_csrc = tensorZeros(DType.C64, [2, 1])
tensorSetComplex(x_csrc, [0, 0], 1.5, 0.0 - 2.5)
tensorSetComplex(x_csrc, [1, 0], 3.0, 4.0)
tensorIndexCopy(x_cdst, 0, [2, 0], x_csrc)
n += ck(tensorGetReal(x_cdst, [2, 0]) == 1.5 and tensorGetImaginary(x_cdst, [2, 0]) == 0.0 - 2.5, "index_copy carries both complex components")
n += ck(tensorGetReal(x_cdst, [0, 0]) == 3.0, "index_copy scatters out of order")
n += ck(tensorGetReal(x_cdst, [1, 0]) == 0.0, "index_copy leaves untouched rows alone")

// roll matches numpy: roll(x, -1)[i] == x[i+1] cyclically
let x_rv = tensorZeros(DType.F64, [1, 4])
for rvi in 0..4 { tensorSet(x_rv, [0, rvi], rvi as float) }
let x_rfwd = tensorRoll(x_rv, 1, 0 - 1)
n += ck(tensorGet(x_rfwd, [0, 0]) == 1.0, "roll -1 brings the next element back")
n += ck(tensorGet(x_rfwd, [0, 3]) == 0.0, "roll -1 wraps the last element round")
let x_rback = tensorRoll(x_rv, 1, 1)
n += ck(tensorGet(x_rback, [0, 0]) == 3.0 and tensorGet(x_rback, [0, 1]) == 0.0, "roll +1 shifts the other way")
n += ck(tensorGet(tensorRoll(x_rv, 1, 4), [0, 2]) == 2.0, "roll by the full extent is the identity")
n += ck(tensorGet(tensorRoll(x_rv, 1, 0 - 5), [0, 0]) == 1.0, "roll normalises a shift beyond one period")
n += ck(tensorGet(tensorRoll(tensorRoll(x_rv, 1, 0 - 1), 1, 1), [0, 2]) == 2.0, "roll then unroll is the identity")

let x_ca = tensorConcat(x_e4, x_e4, 1)
n += ck(x_ca.shape[0] == 2 and x_ca.shape[1] == 4, "concat adds along the joined dim")
n += ck(tensorGet(x_ca, [1, 1]) == 4.0 and tensorGet(x_ca, [1, 3]) == 4.0, "concat copies both operands")
let x_cb = tensorConcat(x_e4, x_e4, 0)
n += ck(x_cb.shape[0] == 4 and tensorGet(x_cb, [3, 0]) == 3.0, "concat on dim 0")
let x_cmix = tensorConcat(tensorFull(DType.F64, [2, 1], 9.0), x_e4, 1)
n += ck(tensorGet(x_cmix, [0, 0]) == 9.0 and tensorGet(x_cmix, [0, 1]) == 1.0, "concat joins unequal extents")
n += ck(tensorElementCount(tensorConcat(tensorZeros(DType.F64, [2, 0]), x_e4, 1)) == 4, "concat with an empty operand")
let x_cvw = tensorConcat(x_e4t, x_e4, 1)
n += ck(tensorGet(x_cvw, [0, 1]) == 3.0, "concat reads a non-contiguous operand")

// this is the exact feature-map shape the phase controller needs
let x_fz = tensorZeros(DType.F64, [1, 4])
for fzi in 0..4 { tensorSet(x_fz, [0, fzi], (fzi + 1) as float) }
let x_fcat = tensorConcat(tensorConcat(x_fz, tensorRoll(x_fz, 1, 0 - 1), 1), x_fz, 1)
n += ck(x_fcat.shape[1] == 12, "three-way feature concat has width 3D")
n += ck(tensorGet(x_fcat, [0, 4]) == 2.0 and tensorGet(x_fcat, [0, 7]) == 1.0, "feature concat holds the cyclic neighbour")

print("ops: {n} checks passed")
