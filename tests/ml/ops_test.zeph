// Regression for lib/ml/ops.zeph -- acceptance A04 and A05.
// Analytic cases, identities, and the same operator run through
// non-contiguous views to prove the stride path agrees with the packed one.
// Values are also cross-checked against numpy from tools/ml_reference; this
// file is what runs without Python.
// Rejections live in tests/run_tests.ps1, one process each.
import "ml/ops.zeph"

fn ck(cond: bool, name: str) -> int {
    assert(cond, name)
    return 1
}

fn near(a: float, b: float, tol: float) -> bool {
    return fabs(a - b) <= tol * (1.0 + fabs(b))
}

let TOL = 0.0000000000001

var n = 0

// ---- A04: elementwise on a known matrix
let a = t_zeros(DType.F64, [2, 3])
var v = 1.0
var i0 = 0
while i0 < 2 {
    var j0 = 0
    while j0 < 3 {
        t_set(a, [i0, j0], v)
        v += 1.0
        j0 += 1
    }
    i0 += 1
}
n += ck(t_get(a, [1, 2]) == 6.0, "fill by index")
n += ck(t_sum_all(a) == 21.0, "sum of 1..6")
n += ck(t_mean_all(a) == 3.5, "mean of 1..6")

let two = t_full(DType.F64, [2, 3], 2.0)
n += ck(t_get(t_add(a, two), [1, 2]) == 8.0, "add")
n += ck(t_get(t_sub(a, two), [1, 2]) == 4.0, "sub")
n += ck(t_get(t_mul(a, two), [1, 2]) == 12.0, "mul")
n += ck(t_get(t_div(a, two), [1, 2]) == 3.0, "div")
n += ck(t_get(t_neg(a), [0, 0]) == 0.0 - 1.0, "neg")

// ---- A04: broadcasting, including rank extension
let row = t_zeros(DType.F64, [1, 3])
t_set(row, [0, 0], 10.0)
t_set(row, [0, 1], 20.0)
t_set(row, [0, 2], 30.0)
let br = t_add(a, row)
n += ck(br.shape[0] == 2 and br.shape[1] == 3, "broadcast keeps the wider shape")
n += ck(t_get(br, [0, 0]) == 11.0, "broadcast row over rank 0")
n += ck(t_get(br, [1, 2]) == 36.0, "broadcast row over rank 1")

let col = t_zeros(DType.F64, [2, 1])
t_set(col, [0, 0], 100.0)
t_set(col, [1, 0], 200.0)
n += ck(t_get(t_add(a, col), [1, 1]) == 205.0, "broadcast a column")
n += ck(t_get(t_add(col, row), [1, 2]) == 230.0, "broadcast column against row")

let scal = t_full(DType.F64, [], 7.0)
n += ck(t_get(t_add(a, scal), [0, 0]) == 8.0, "a rank-zero scalar broadcasts")

// a broadcast view is read-only, and expansion does not copy
let ex = t_expand(row, [4, 3])
n += ck(ex.ro, "expanded view is read-only")
n += ck(ex.stride[0] == 0, "expanded axis has stride zero")
n += ck(t_get(ex, [3, 1]) == 20.0, "every expanded row reads the source")

// ---- A04: the same operators through NON-CONTIGUOUS views
let tr = t_transpose(a, 0, 1)
n += ck(not t_is_contiguous(tr), "transposed input is not contiguous")
let trsum = t_sum_all(tr)
n += ck(trsum == 21.0, "sum over a transposed view matches")
let trdoub = t_mul(tr, t_full(DType.F64, [3, 2], 2.0))
n += ck(t_get(trdoub, [2, 1]) == 12.0, "mul through a transposed view")
n += ck(t_get(trdoub, [0, 1]) == 8.0, "mul through a transposed view, again")

// a is [[1,2,3],[4,5,6]], so this slice is [[2,3],[5,6]]
let sl = t_slice(a, 1, 1, 3)
n += ck(t_sum_all(sl) == 16.0, "sum over a slice: 2+3+5+6")
n += ck(t_get(sl, [1, 1]) == 6.0, "slice indexes through the offset")
n += ck(t_get(t_add(sl, t_full(DType.F64, [2, 2], 2.0)), [1, 1]) == 8.0, "add through a slice")

// copying a non-contiguous view produces a contiguous one with equal values
let cp = t_copy(tr)
n += ck(t_is_contiguous(cp), "copy of a view is contiguous")
n += ck(t_sum_all(cp) == 21.0, "copy preserves values")
n += ck(t_get(cp, [2, 1]) == t_get(tr, [2, 1]), "copy agrees elementwise")

// ---- A04: matmul
let m = t_zeros(DType.F64, [3, 2])
t_set(m, [0, 0], 1.0)
t_set(m, [1, 0], 0.0)
t_set(m, [2, 0], 1.0)
t_set(m, [0, 1], 0.0)
t_set(m, [1, 1], 1.0)
t_set(m, [2, 1], 1.0)
let p = t_matmul(a, m)
n += ck(p.shape[0] == 2 and p.shape[1] == 2, "matmul shape")
n += ck(t_get(p, [0, 0]) == 4.0, "matmul 0,0 = 1*1+2*0+3*1")
n += ck(t_get(p, [0, 1]) == 5.0, "matmul 0,1 = 1*0+2*1+3*1")
n += ck(t_get(p, [1, 0]) == 10.0, "matmul 1,0 = 4*1+5*0+6*1")
n += ck(t_get(p, [1, 1]) == 11.0, "matmul 1,1 = 4*0+5*1+6*1")

// identity, and matmul against a non-contiguous operand
let eye = t_zeros(DType.F64, [3, 3])
t_set(eye, [0, 0], 1.0)
t_set(eye, [1, 1], 1.0)
t_set(eye, [2, 2], 1.0)
n += ck(t_get(t_matmul(a, eye), [1, 2]) == 6.0, "matmul by the identity is the input")
let mt = t_transpose(m, 0, 1)
n += ck(t_get(t_matmul(mt, t_transpose(a, 0, 1)), [1, 1]) == 11.0, "matmul of two transposed views")

// ---- A05: complex arithmetic, analytic cases
let c = t_zeros(DType.C64, [2])
t_set_c(c, [0], 3.0, 4.0)
t_set_c(c, [1], 1.0, 0.0 - 1.0)
let d = t_zeros(DType.C64, [2])
t_set_c(d, [0], 1.0, 2.0)
t_set_c(d, [1], 0.0, 1.0)

let cm = t_mul(c, d)
n += ck(near(t_get_re(cm, [0]), 0.0 - 5.0, TOL), "(3+4i)(1+2i) real is -5")
n += ck(near(t_get_im(cm, [0]), 10.0, TOL), "(3+4i)(1+2i) imag is 10")
let cd = t_div(c, d)
n += ck(near(t_get_re(cd, [0]), 2.2, TOL), "(3+4i)/(1+2i) real is 2.2")
n += ck(near(t_get_im(cd, [0]), 0.0 - 0.4, TOL), "(3+4i)/(1+2i) imag is -0.4")

// division is the inverse of multiplication
let rt = t_div(t_mul(c, d), d)
n += ck(near(t_get_re(rt, [0]), 3.0, TOL), "div undoes mul, real")
n += ck(near(t_get_im(rt, [0]), 4.0, TOL), "div undoes mul, imag")

n += ck(t_get(t_abs2(c), [0]) == 25.0, "abs2(3+4i) is 25")
n += ck(t_get(t_abs2(c), [1]) == 2.0, "abs2(1-i) is 2")
n += ck(t_get_im(t_conj(c), [0]) == 0.0 - 4.0, "conj flips the imaginary sign")
n += ck(t_get_re(t_conj(c), [0]) == 3.0, "conj leaves the real part")
n += ck(t_get_im(t_conj(t_conj(c)), [0]) == 4.0, "conj is an involution")
n += ck(t_get(t_real(c), [0]) == 3.0, "real part")
n += ck(t_get(t_imag(c), [0]) == 4.0, "imag part")

// z * conj(z) is abs2, with a zero imaginary part
let zz = t_mul(c, t_conj(c))
n += ck(near(t_get_re(zz, [0]), 25.0, TOL), "z conj(z) real is abs2")
n += ck(near(t_get_im(zz, [0]), 0.0, TOL), "z conj(z) imag is zero")

// expi has unit modulus, and hits the analytic angles
let ang = t_zeros(DType.F64, [3])
t_set(ang, [0], 0.0)
t_set(ang, [1], PI / 3.0)
t_set(ang, [2], HALF_PI)
let ep = t_expi(ang, DType.C64)
n += ck(near(t_get_re(ep, [0]), 1.0, TOL), "expi(0) real is 1")
n += ck(near(t_get_im(ep, [0]), 0.0, TOL), "expi(0) imag is 0")
n += ck(near(t_get_re(ep, [1]), 0.5, TOL), "expi(pi/3) real is 1/2")
n += ck(near(t_get_im(ep, [1]), SQRT3 / 2.0, TOL), "expi(pi/3) imag is sqrt3/2")
n += ck(near(t_get_im(ep, [2]), 1.0, TOL), "expi(pi/2) imag is 1")
n += ck(near(t_get(t_abs2(ep), [1]), 1.0, TOL), "expi has unit modulus")

// complex matmul, against the hand-computed product
let ca = t_zeros(DType.C64, [1, 2])
t_set_c(ca, [0, 0], 1.0, 1.0)
t_set_c(ca, [0, 1], 2.0, 0.0)
let cb = t_zeros(DType.C64, [2, 1])
t_set_c(cb, [0, 0], 0.0, 1.0)
t_set_c(cb, [1, 0], 1.0, 0.0 - 1.0)
// (1+i)(i) + (2)(1-i) = (-1+i) + (2-2i) = 1 - i
let cp2 = t_matmul(ca, cb)
n += ck(near(t_get_re(cp2, [0, 0]), 1.0, TOL), "complex matmul real")
n += ck(near(t_get_im(cp2, [0, 0]), 0.0 - 1.0, TOL), "complex matmul imag")

// conjugate transpose is transpose plus conjugation
let ch = t_conj_transpose(ca)
n += ck(ch.shape[0] == 2 and ch.shape[1] == 1, "conj transpose swaps extents")
n += ck(t_get_im(ch, [0, 0]) == 0.0 - 1.0, "conj transpose conjugates")

// ---- A05: byte layout, real then imaginary, little endian
let h32 = t_zeros(DType.C32, [1])
t_set_c(h32, [0], 1.5, 0.0 - 2.25)
n += ck(t_hex(h32) == "0000c03f000010c0", "c32 layout matches numpy complex64")
let h64 = t_zeros(DType.C64, [1])
t_set_c(h64, [0], 0.125, 0.0 - 0.375)
n += ck(t_hex(h64) == "000000000000c03f000000000000d8bf", "c64 layout matches numpy complex128")
n += ck(h32.st.nbytes == 8, "one c32 element is 8 bytes")
n += ck(h64.st.nbytes == 16, "one c64 element is 16 bytes")

// ---- reductions along an axis, and the empty cases
let sd0 = t_sum_dim(a, 0)
n += ck(sd0.shape[0] == 1 and sd0.shape[1] == 3, "sum_dim keeps rank")
n += ck(t_get(sd0, [0, 0]) == 5.0, "column sum 1+4")
n += ck(t_get(sd0, [0, 2]) == 9.0, "column sum 3+6")
let sd1 = t_sum_dim(a, 1)
n += ck(t_get(sd1, [0, 0]) == 6.0, "row sum 1+2+3")
n += ck(t_get(sd1, [1, 0]) == 15.0, "row sum 4+5+6")

let empt = t_zeros(DType.F64, [0, 3])
n += ck(t_sum_all(empt) == 0.0, "sum over no elements is zero")
n += ck(t_numel(t_add(empt, t_full(DType.F64, [1, 3], 1.0))) == 0, "empty broadcasts to empty")

let csum = t_sum_dim(c, 0)
n += ck(near(t_get_re(csum, [0]), 4.0, TOL), "complex axis sum, real")
n += ck(near(t_get_im(csum, [0]), 3.0, TOL), "complex axis sum, imag")

// ---- f32 storage rounds at the store, and we say so rather than hide it
let f = t_zeros(DType.F32, [2])
t_set(f, [0], 1.0)
t_set(f, [1], 3.0)
let fq = t_div(f, t_full(DType.F32, [2], 3.0))
n += ck(near(t_get(fq, [0]), 1.0 / 3.0, 0.0000001), "f32 divide is close")
n += ck(t_get(fq, [0]) != 1.0 / 3.0, "f32 divide is not the f64 value, by construction")

print("ops: {n} checks passed")
