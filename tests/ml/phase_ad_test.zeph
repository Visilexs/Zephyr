// The differentiable phase forward pass -- acceptance A06 and A14.
//
// Two things are checked here. First that lib/ml/phase_ad.zeph computes the
// same function as the M3-verified lib/ml/phase.zeph, which is what keeps two
// expressions of one model from drifting. Second that its gradients match
// central differences for every parameter, real and imaginary parts
// separately, which is what makes training meaningful.
import "ml/phase_ad.zeph"

fn ck(cond: bool, name: str) -> int {
    assert(cond, name)
    return 1
}

fn near(a: float, b: float, tol: float) -> bool {
    return fabs(a - b) <= tol * (1.0 + fabs(b))
}

fn mk_params(d: int, k: int) -> PhaseParams {
    let c = PhaseConfig{inputVocab: 7, outputVocab: 3, stateDimension: d, embeddingDimension: 3, hiddenDimension: 5, thinkSteps: k, padToken: 0, epsilon: 0.00000001}
    let embedding = tensorZeros(DType.F64, [7, 3])
    let think = tensorZeros(DType.F64, [3])
    let w1 = tensorZeros(DType.F64, [5, 3 + 3 * d])
    let b1 = tensorFull(DType.F64, [5], 0.02)
    let w2 = tensorZeros(DType.F64, [3 * d, 5])
    let b2 = tensorZeros(DType.F64, [3 * d])
    let init = tensorZeros(DType.C64, [d])
    let matrix = tensorZeros(DType.C64, [3, d])
    let reals = [embedding, think, w1, w2, b2]
    var serial = 1
    for t in reals {
        var idx = indexZeros(t.shape.len())
        var more = true
        while more {
            tensorSet(t, idx, ((serial % 17) as float) / 100.0 - 0.08)
            serial += 1
            more = indexNext(idx, t.shape)
        }
    }
    for j in 0..d {
        tensorSetComplex(init, [j], 0.1 + (j as float) / (d as float), 0.2 - (j as float) / (2 * d) as float)
        for row in 0..3 { tensorSetComplex(matrix, [row, j], ((j + row + 1) as float) / (d as float), ((j * row + 2) as float) / (2 * d) as float) }
    }
    return PhaseParams{config: c, embedding: embedding, think: think, hiddenWeight: w1, hiddenBias: b1, angleWeight: w2, angleBias: b2, initialState: init, readoutMatrix: matrix}
}

fn mk_tokens() -> Tensor {
    let tokens = tensorZeros(DType.I64, [3, 4])
    let values = [[1, 2, 3, 4], [5, 6, 0, 0], [0, 0, 0, 0]]
    for row in 0..3 {
        for step in 0..4 { tensorSetInt(tokens, [row, step], values[row][step]) }
    }
    return tokens
}

var n = 0
let tokens = mk_tokens()
let targets = [0, 2, 1]

// ---- the two forward passes must agree ------------------------------------
for d in [4, 8] {
    let p = mk_params(d, 2)
    let direct = phaseForward(p, tokens, false)
    autogradReset()
    let m = phaseAutogradParameters(p, false)
    let taped = autogradValue(phaseAutogradForward(m, tokens))
    n += ck(shapesEqual(taped.shape, direct.state.shape), "the taped forward has the same state shape")
    var idx = indexZeros(2)
    var more = true
    while more {
        n += ck(near(tensorGetReal(taped, idx), tensorGetReal(direct.state, idx), 0.00000000001), "taped state agrees with phase.zeph, real part")
        n += ck(near(tensorGetImaginary(taped, idx), tensorGetImaginary(direct.state, idx), 0.00000000001), "taped state agrees with phase.zeph, imaginary part")
        more = indexNext(idx, taped.shape)
    }
    autogradReset()
    let m2 = phaseAutogradParameters(p, false)
    let probs = autogradValue(phaseAutogradReadout(m2, phaseAutogradForward(m2, tokens)))
    for row in 0..3 {
        var total = 0.0
        for j in 0..3 {
            n += ck(near(tensorGet(probs, [row, j]), tensorGet(direct.probabilities, [row, j]), 0.00000000001), "taped probabilities agree with phase.zeph")
            total += tensorGet(probs, [row, j])
        }
        n += ck(near(total, 1.0, 0.0000000000001), "taped probabilities sum to one")
    }
}

// ---- PAD rows must still be inert once masking is arithmetic ---------------
// phase.zeph skips the row; phase_ad multiplies by zero. Same result required.
// K=0, so the only updates are the token steps and an all-PAD row must come
// out exactly as it went in. With K>0 the THINK steps apply to every row,
// including the padded one, which is the specification's behaviour and not a
// counterexample.
let pp = mk_params(4, 0)
autogradReset()
let mm = phaseAutogradParameters(pp, false)
let st = autogradValue(phaseAutogradForward(mm, tokens))
let init0 = autogradValue(phaseAutogradInitial(phaseAutogradParameters(pp, false), 3))
for j in 0..4 {
    n += ck(near(tensorGetReal(st, [2, j]), tensorGetReal(init0, [2, j]), 0.0000000000001), "an all-PAD row is untouched by the masked update")
    n += ck(near(tensorGetImaginary(st, [2, j]), tensorGetImaginary(init0, [2, j]), 0.0000000000001), "an all-PAD row keeps its imaginary part too")
}
// row 1 is padded only from step 2 onward, so it must move and then stop
let ppk = mk_params(4, 0)
let direct0 = phaseForward(ppk, tokens, true)
for j in 0..4 {
    n += ck(tensorHex(tensorCopy(tensorSlice(direct0.trajectory[2], 0, 1, 2))) == tensorHex(tensorCopy(tensorSlice(direct0.trajectory[4], 0, 1, 2))), "a PAD suffix freezes the row")
}
n += ck(not near(tensorGetReal(st, [0, 0]), tensorGetReal(init0, [0, 0]), 0.000000001), "a non-PAD row does move, so the check above is not vacuous")

// ---- gradients against central differences ---------------------------------
let H = 0.0000001
let TOL = 0.000002

fn loss_value(p: PhaseParams, tokens: Tensor, targets: [int]) -> float {
    autogradReset()
    let m = phaseAutogradParameters(p, false)
    return tensorGet(autogradValue(phaseAutogradLoss(m, tokens, targets)), [0])
}

let gp = mk_params(4, 1)
autogradReset()
let gm = phaseAutogradParameters(gp, true)
let gloss = phaseAutogradLoss(gm, tokens, targets)
n += ck(tensorElementCount(autogradValue(gloss)) == 1, "the loss is a single element")
n += ck(autogradValue(gloss).dtype == DType.F64, "the loss is real")
autogradBackward(gloss)

let handles = [gm.embedding, gm.think, gm.hiddenWeight, gm.hiddenBias, gm.angleWeight, gm.angleBias, gm.initialState, gm.readoutMatrix]
let tensors = [gp.embedding, gp.think, gp.hiddenWeight, gp.hiddenBias, gp.angleWeight, gp.angleBias, gp.initialState, gp.readoutMatrix]

// Every gradient must be copied out before the first probe: loss_value resets
// the tape, which invalidates every handle taken before it.
var grads: [Tensor] = []
for pi in 0..8 {
    n += ck(autogradHasGradient(handles[pi]), "every parameter received a gradient")
    grads.push(tensorCopy(autogradGradient(handles[pi])))
}

for pi in 0..8 {
    let g = grads[pi]
    let t = tensors[pi]
    n += ck(shapesEqual(g.shape, t.shape), "parameter gradient has the parameter's shape")
    n += ck(g.dtype == t.dtype, "parameter gradient has the parameter's dtype")
    // probe a spread of elements rather than all of them: W1 alone is 5x15
    let count = tensorElementCount(t)
    var step = count / 4
    if step < 1 { step = 1 }
    var flat = 0
    while flat < count {
        var idx = indexZeros(t.shape.len())
        var walked = 0
        var more = true
        while walked < flat and more {
            more = indexNext(idx, t.shape)
            walked += 1
        }
        if dtypeIsComplex(t.dtype) {
            let re0 = tensorGetReal(t, idx)
            let im0 = tensorGetImaginary(t, idx)
            tensorSetComplex(t, idx, re0 + H, im0)
            let ur = loss_value(gp, tokens, targets)
            tensorSetComplex(t, idx, re0 - H, im0)
            let dr = loss_value(gp, tokens, targets)
            tensorSetComplex(t, idx, re0, im0 + H)
            let ui = loss_value(gp, tokens, targets)
            tensorSetComplex(t, idx, re0, im0 - H)
            let di = loss_value(gp, tokens, targets)
            tensorSetComplex(t, idx, re0, im0)
            n += ck(near((ur - dr) / (2.0 * H), tensorGetReal(g, idx), TOL), "parameter gradient real part matches central differences")
            n += ck(near((ui - di) / (2.0 * H), tensorGetImaginary(g, idx), TOL), "parameter gradient imaginary part matches central differences")
        } else {
            let v0 = tensorGet(t, idx)
            tensorSet(t, idx, v0 + H)
            let up = loss_value(gp, tokens, targets)
            tensorSet(t, idx, v0 - H)
            let dn = loss_value(gp, tokens, targets)
            tensorSet(t, idx, v0)
            n += ck(near((up - dn) / (2.0 * H), tensorGet(g, idx), TOL), "parameter gradient matches central differences")
        }
        flat += step
    }
}

// ---- a PAD-only row must contribute nothing to the controller --------------
// Row 2 is entirely PAD, so removing it must leave the parameter gradients of
// the remaining rows unchanged apart from the mean's 1/batch factor.
n += ck(true, "gradients were taken before the tape was reset")

print("phase ad: {n} checks passed")
