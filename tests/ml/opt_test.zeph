// A25: the acceptance gate every optimization has to pass before it is
// allowed to be on.
//
// The specification states it as a list: "same input/checkpoint; forward and
// all parameter gradients within registered tolerance; identical
// invalid-input behavior; no peak-memory regression beyond a recorded
// tradeoff; cold and warm latency separately; benchmark artifacts. A slower
// optimization remains disabled."
//
// This suite implements that list for the optimizations currently present.
// The tolerance here is not a tolerance: the fast matmul computes the same
// sums in the same order as the reference, so the two must agree BIT FOR BIT
// via tensorHex. A tolerance would hide exactly the reassociation the strict
// numeric policy forbids, and a kernel that reordered its accumulation would
// pass a 1e-12 gate while violating the policy it is supposed to obey.
import "ml/phase_ad.zeph"
import "ml/optim.zeph"

var passed = 0
var failed = 0
fn chk(c: bool, what: str) {
    if c { passed = passed + 1 } else {
        failed = failed + 1
        print("FAIL: {what}")
    }
}

extern fn QueryPerformanceCounter(p: int) -> i32 from "kernel32.dll"
extern fn QueryPerformanceFrequency(p: int) -> i32 from "kernel32.dll"
var qpf = Bytes.new(8)
QueryPerformanceFrequency(qpf.addr())
let FREQ = (qpf.get64(0)) as float
var qtmp = Bytes.new(8)
fn now_ms() -> float {
    QueryPerformanceCounter(qtmp.addr())
    return ((qtmp.get64(0)) as float) * 1000.0 / FREQ
}

var SEED = 20260921
fn rnd() -> float {
    SEED = (SEED * 1103515245 + 12345) % 2147483648
    return ((SEED % 2001) as float) / 1000.0 - 1.0
}
fn rndi(n: int) -> int {
    SEED = (SEED * 1103515245 + 12345) % 2147483648
    return SEED % n
}
fn fill_random(t: Tensor) {
    var idx = indexZeros(t.shape.len())
    var more = tensorElementCount(t) > 0
    while more {
        let re = rnd()
        if dtypeIsComplex(t.dtype) { tensorSetComplex(t, idx, re, rnd()) } else { tensorSet(t, idx, re) }
        more = indexNext(idx, t.shape)
    }
}

// ---- identical invalid-input behaviour, in children ------------------------
// An optimization that skipped a validation would be faster and wrong, and
// the failure would only show on input nobody tests. Each case runs with the
// fast path on and off and both must fail the same way.
if args().len() > 2 {
    matmulFastPath = args()[2] == "fast"
    let case = args()[1]
    if case == "inner" {
        tensorMatmul(tensorOnes(DType.F64, [2, 3]), tensorOnes(DType.F64, [4, 5]))
    }
    if case == "rank" {
        tensorMatmul(tensorOnes(DType.F64, [2, 3, 4]), tensorOnes(DType.F64, [4, 5]))
    }
    if case == "dtype" {
        tensorMatmul(tensorOnes(DType.F64, [2, 3]), tensorOnes(DType.C64, [3, 5]))
    }
    print("UNREACHABLE: {case} was accepted")
}
let IS_CHILD = args().len() > 2

fn child(case: str, mode: str) -> int {
    var cmd = cString("\"{args()[0]}\" {case} {mode}")
    let startup = Bytes.new(104)
    startup.put32(0, 104)
    let process = Bytes.new(24)
    let started = win("CreateProcessA", 0, cmd.addr(), 0, 0, 1, 134217728, 0, 0, startup.addr(), process.addr())
    if started == 0 { return 0 - 1 }
    win("WaitForSingleObject", process.get64(0), 30000)
    let status = Bytes.new(8)
    win("GetExitCodeProcess", process.get64(0), status.addr())
    let code = status.get32(0)
    win("CloseHandle", process.get64(0))
    win("CloseHandle", process.get64(8))
    return code
}

// ===========================================================================
// Same input, same checkpoint: forward, all gradients, and the update
// ===========================================================================
let D = 16
let E = 8
let H = 32
let K = 1
let IV = 6
let OV = 3
let NB = 8
let T = 3

fn build() -> PhaseParams {
    let cfg = PhaseConfig{inputVocab: IV, outputVocab: OV, stateDimension: D, embeddingDimension: E, hiddenDimension: H, thinkSteps: K, padToken: 0, epsilon: 0.00000001}
    let ps = [tensorZeros(DType.F64, [IV, E]), tensorZeros(DType.F64, [E]), tensorZeros(DType.F64, [H, E + 3 * D]),
              tensorZeros(DType.F64, [H]), tensorZeros(DType.F64, [3 * D, H]), tensorZeros(DType.F64, [3 * D])]
    for i in 0..ps.len() { fill_random(ps[i]) }
    let zi = tensorZeros(DType.C64, [D])
    let Mo = tensorZeros(DType.C64, [OV, D])
    fill_random(zi)
    fill_random(Mo)
    return PhaseParams{config: cfg, embedding: ps[0], think: ps[1], hiddenWeight: ps[2], hiddenBias: ps[3],
                       angleWeight: ps[4], angleBias: ps[5], initialState: zi, readoutMatrix: Mo}
}
fn params_of(p: PhaseParams) -> [Tensor] {
    return [p.embedding, p.think, p.hiddenWeight, p.hiddenBias, p.angleWeight, p.angleBias, p.initialState, p.readoutMatrix]
}

let save = SEED
let p_ref = build()
SEED = save
let p_opt = build()

let tokens = tensorZeros(DType.I64, [NB, T])
var targets: [int] = []
for row in 0..NB {
    for st in 0..T { tensorSetInt(tokens, [row, st], 1 + rndi(IV - 1)) }
    targets.push(rndi(OV))
}

fn step(p: PhaseParams, opt: Optim, out: [Tensor]) -> float {
    autogradReset()
    let m = phaseAutogradParameters(p, true)
    let loss = phaseAutogradLoss(m, tokens, targets)
    autogradBackward(loss)
    let handles = [m.embedding, m.think, m.hiddenWeight, m.hiddenBias, m.angleWeight, m.angleBias, m.initialState, m.readoutMatrix]
    var grads: [Tensor] = []
    for i in 0..handles.len() { grads.push(tensorCopy(autogradGradient(handles[i]))) }
    clipGradientNorm(grads, 5.0)
    optimizerStep(opt, params_of(p), grads)
    for i in 0..grads.len() { out.push(grads[i]) }
    return tensorGet(autogradValue(loss), [0])
}

if not IS_CHILD {
    matmulFastPath = false
    var g_ref: [Tensor] = []
    let loss_ref = step(p_ref, newAdamW(params_of(p_ref), 0.02, 0.9, 0.999, 0.00000001, 0.01), g_ref)

    matmulFastPath = true
    var g_opt: [Tensor] = []
    let loss_opt = step(p_opt, newAdamW(params_of(p_opt), 0.02, 0.9, 0.999, 0.00000001, 0.01), g_opt)

    // Bit-exact, not within a tolerance. The kernel accumulates in the same
    // order as the reference, so anything less than equality means it did not.
    chk(tensorHex(tensorFull(DType.F64, [1], loss_ref)) == tensorHex(tensorFull(DType.F64, [1], loss_opt)),
        "forward loss is bit-identical: {loss_ref} against {loss_opt}")
    chk(loss_ref == loss_ref and loss_ref > 0.0, "the loss is finite and positive, so the comparison is not on NaN")

    chk(g_ref.len() == 8 and g_opt.len() == 8, "both paths produced eight gradients")
    var gsame = 0
    for i in 0..g_ref.len() {
        if tensorHex(g_ref[i]) == tensorHex(g_opt[i]) { gsame = gsame + 1 }
    }
    chk(gsame == 8, "all eight parameter gradients are bit-identical ({gsame} of 8)")

    var psame = 0
    let pr = params_of(p_ref)
    let po = params_of(p_opt)
    for i in 0..pr.len() {
        if tensorHex(pr[i]) == tensorHex(po[i]) { psame = psame + 1 }
    }
    chk(psame == 8, "all eight parameters after an AdamW step are bit-identical ({psame} of 8)")

    // Non-vacuity: the gradients have to be non-trivial, or eight equal
    // all-zero tensors would pass every check above.
    var moved = 0
    for i in 0..g_ref.len() {
        var idx = indexZeros(g_ref[i].shape.len())
        var more = tensorElementCount(g_ref[i]) > 0
        while more {
            if dtypeIsComplex(g_ref[i].dtype) {
                if fabs(tensorGetReal(g_ref[i], idx)) > 0.0001 { moved = moved + 1 }
            } else {
                if fabs(tensorGet(g_ref[i], idx)) > 0.0001 { moved = moved + 1 }
            }
            more = indexNext(idx, g_ref[i].shape)
        }
    }
    chk(moved > 100, "the gradients are non-trivial ({moved} components above 1e-4)")

    // ---- strided and transposed operands ----------------------------------
    // The kernel reads strides directly rather than requiring contiguity, so
    // a view has to give the same answer as the reference on the same view.
    let sa = tensorZeros(DType.F64, [6, 5])
    let sb = tensorZeros(DType.F64, [5, 4])
    fill_random(sa)
    fill_random(sb)
    let ta = tensorTranspose(sa, 0, 1)                 // [5,6], swapped strides
    let sl = tensorSlice(sb, 0, 1, 5)                  // [4,4], offset
    matmulFastPath = false
    let r1 = tensorMatmul(ta, tensorZeros(DType.F64, [6, 3]))
    let r3 = tensorMatmul(tensorSlice(sa, 1, 1, 5), sl)
    matmulFastPath = true
    let r2 = tensorMatmul(ta, tensorZeros(DType.F64, [6, 3]))
    let r4 = tensorMatmul(tensorSlice(sa, 1, 1, 5), sl)
    chk(tensorHex(r1) == tensorHex(r2), "a transposed operand gives a bit-identical result")
    chk(tensorHex(r3) == tensorHex(r4), "sliced and offset operands give a bit-identical result")

    let ca = tensorZeros(DType.C64, [4, 5])
    let cb = tensorZeros(DType.C64, [5, 3])
    fill_random(ca)
    fill_random(cb)
    matmulFastPath = false
    let c1 = tensorMatmul(ca, cb)
    let c2 = tensorMatmul(tensorConjugateTranspose(ca), tensorZeros(DType.C64, [4, 2]))
    matmulFastPath = true
    chk(tensorHex(tensorMatmul(ca, cb)) == tensorHex(c1), "complex matmul is bit-identical")
    chk(tensorHex(tensorMatmul(tensorConjugateTranspose(ca), tensorZeros(DType.C64, [4, 2]))) == tensorHex(c2),
        "complex matmul over a conjugate-transposed operand is bit-identical")

    // ---- identical invalid-input behaviour --------------------------------
    let cases = ["inner", "rank", "dtype"]
    for i in 0..cases.len() {
        let slow = child(cases[i], "ref")
        let fast = child(cases[i], "fast")
        chk(slow != 0, "{cases[i]}: the reference path rejects it (exit {slow})")
        chk(fast != 0, "{cases[i]}: the fast path rejects it too (exit {fast})")
        chk(slow == fast, "{cases[i]}: both paths fail identically ({slow} against {fast})")
    }

    // ---- peak memory -------------------------------------------------------
    // The kernel allocates exactly the output and nothing else: no packing
    // buffer, no transposed copy, no workspace. The reference allocates the
    // same output plus a two-element index list per element read, which the
    // collector reclaims but which is still traffic. So the fast path cannot
    // regress peak memory, and the check is that its result storage is the
    // same size rather than a measurement of an allocator this library does
    // not expose.
    let mm_a = tensorZeros(DType.F64, [40, 40])
    let mm_b = tensorZeros(DType.F64, [40, 40])
    fill_random(mm_a)
    fill_random(mm_b)
    matmulFastPath = false
    let mr = tensorMatmul(mm_a, mm_b)
    matmulFastPath = true
    let mo = tensorMatmul(mm_a, mm_b)
    chk(mr.storage.byteCount == mo.storage.byteCount, "the optimized path allocates the same output storage, {mo.storage.byteCount} bytes")
    chk(tensorHex(mr) == tensorHex(mo), "and the same bytes in it")

    // ---- cold and warm latency, separately ---------------------------------
    // Reported separately because the specification asks for that, and
    // because the first call pays for page faults on freshly allocated
    // storage that later calls do not.
    let ba = tensorZeros(DType.F64, [64, 256])
    let bb = tensorZeros(DType.F64, [256, 128])
    fill_random(ba)
    fill_random(bb)

    matmulFastPath = false
    let rc0 = now_ms()
    tensorMatmul(ba, bb)
    let ref_cold = now_ms() - rc0
    var ref_warm = 0.0
    for r in 0..3 {
        let a0 = now_ms()
        tensorMatmul(ba, bb)
        ref_warm = ref_warm + (now_ms() - a0)
    }
    ref_warm = ref_warm / 3.0

    matmulFastPath = true
    let fc0 = now_ms()
    tensorMatmul(ba, bb)
    let fast_cold = now_ms() - fc0
    var fast_warm = 0.0
    for r in 0..3 {
        let a0 = now_ms()
        tensorMatmul(ba, bb)
        fast_warm = fast_warm + (now_ms() - a0)
    }
    fast_warm = fast_warm / 3.0

    print("matmul [64,256]x[256,128]  cold: reference {ref_cold} ms, fast {fast_cold} ms")
    print("                           warm: reference {ref_warm} ms, fast {fast_warm} ms, speedup {ref_warm / fast_warm}x")

    // "A slower optimization remains disabled." This is the check that
    // enforces it, and it is the reason matmulFastPath is a variable at all.
    chk(fast_warm < ref_warm, "the optimization is faster warm, so it is allowed to be on ({ref_warm} against {fast_warm})")
    chk(fast_cold < ref_cold, "and faster cold")

    if failed == 0 {
        print("opt: {passed} checks passed")
    } else {
        print("opt: {failed} FAILED, {passed} passed")
        panic("opt tests failed")
    }
}
