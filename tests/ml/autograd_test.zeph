// Reverse-mode AD checks for lib/ml/autograd.zeph -- acceptance A06 and A07.
//
// Every VJP is checked against central differences on the same graph, with
// real and imaginary parts perturbed separately. Zephyr has no closures, so a
// case is an integer and build() is the dispatch: the same function builds the
// graph for the analytic pass and for each finite-difference probe, which
// means the two cannot silently drift apart.
import "ml/autograd.zeph"

fn ck(cond: bool, name: str) -> int {
    assert(cond, name)
    return 1
}

let H = 0.000001
let FD_TOL = 0.0000002

fn rel_close(a: float, b: float, tol: float) -> bool {
    return fabs(a - b) <= tol * (1.0 + fabs(b))
}

// ---- case definitions ------------------------------------------------------
// 0..15 real, 16..27 complex in x.

fn case_complex(c: int) -> bool { return c >= 16 and c <= 27 }

fn shape_x(c: int) -> [int] {
    if c == 12 { return [2, 3] }
    return [3, 4]
}

fn shape_y(c: int) -> [int] {
    if c == 6 { return [4, 2] }
    if c == 15 { return [1, 4] }
    if c == 12 { return [2, 3] }
    return [3, 4]
}

// Deterministic, nonzero, and away from the poles of the operations used.
fn fill(t: Tensor, seed: int) -> Tensor {
    var s = seed
    var idx = indexZeros(t.shape.len())
    var more = tensorElementCount(t) > 0
    while more {
        s = (s * 1103515245 + 12345) % 2147483648
        let a = ((s % 1201) as float) / 1000.0 + 0.35
        s = (s * 1103515245 + 12345) % 2147483648
        let b = ((s % 1201) as float) / 1000.0 + 0.35
        if dtypeIsComplex(t.dtype) {
            tensorSetComplex(t, idx, a, b)
        } else {
            tensorSet(t, idx, a)
        }
        more = indexNext(idx, t.shape)
    }
    return t
}

fn make_x(c: int) -> Tensor {
    if case_complex(c) { return fill(tensorZeros(DType.C64, shape_x(c)), 7 + c) }
    return fill(tensorZeros(DType.F64, shape_x(c)), 7 + c)
}

fn make_y(c: int) -> Tensor {
    if case_complex(c) { return fill(tensorZeros(DType.C64, shape_y(c)), 991 + c) }
    return fill(tensorZeros(DType.F64, shape_y(c)), 991 + c)
}

// Builds the graph for one case and returns the scalar loss handle. Complex
// cases end in abs2 so the loss is real, which is what a loss has to be.
fn build(c: int, x: int, y: int) -> int {
    if c == 0 { return autogradSumAll(autogradAdd(x, y)) }
    if c == 1 { return autogradSumAll(autogradSubtract(x, y)) }
    if c == 2 { return autogradSumAll(autogradMultiply(x, y)) }
    if c == 3 { return autogradSumAll(autogradDivide(x, y)) }
    if c == 4 { return autogradSumAll(autogradNegate(x)) }
    if c == 5 { return autogradSumAll(autogradTanh(x)) }
    if c == 6 { return autogradSumAll(autogradMatmul(x, y)) }
    if c == 7 { return autogradMeanAll(autogradMultiply(x, x)) }
    if c == 8 { return autogradSumAll(autogradSumDimension(x, 0)) }
    if c == 9 { return autogradSumAll(autogradConcat(x, y, 1)) }
    if c == 10 { return autogradSumAll(autogradIndexSelect(x, 0, [1, 0, 1])) }
    if c == 11 { return autogradSumAll(autogradMultiply(autogradRoll(x, 1, 0 - 1), y)) }
    if c == 12 { return autogradSumAll(autogradMultiply(autogradTranspose(x, 0, 1), autogradTranspose(y, 0, 1))) }
    if c == 13 { return autogradSumAll(autogradMultiply(autogradReshape(x, [4, 3]), autogradReshape(y, [4, 3]))) }
    if c == 14 { return autogradSumAll(autogradSlice(x, 1, 1, 3)) }
    // broadcasting: y is a single row reused across every row of x
    if c == 15 { return autogradSumAll(autogradMultiply(x, y)) }
    if c == 28 { return autogradSumAll(autogradCos(x)) }
    if c == 29 { return autogradSumAll(autogradSin(x)) }
    if c == 30 { return autogradSumAll(autogradMultiply(autogradCos(x), autogradSin(x))) }
    if c == 31 { return autogradSumAll(autogradLn(x)) }
    if c == 32 { return autogradSumAll(autogradMultiply(autogradLn(x), autogradLn(y))) }
    if c == 33 { return autogradSumAll(autogradNegate(autogradLn(autogradDivide(x, autogradSumDimension(x, 1))))) }
    if c == 34 { return autogradSumAll(autogradExp(x)) }
    if c == 35 { return autogradSumAll(autogradExp(autogradMultiply(autogradLn(x), y))) }

    if c == 16 { return autogradSumAll(autogradAbs2(x)) }
    if c == 17 { return autogradSumAll(autogradAbs2(autogradConjugate(x))) }
    if c == 18 { return autogradSumAll(autogradAbs2(autogradAdd(x, y))) }
    if c == 19 { return autogradSumAll(autogradAbs2(autogradMultiply(x, y))) }
    if c == 20 { return autogradSumAll(autogradAbs2(autogradDivide(x, y))) }
    if c == 21 { return autogradSumAll(autogradReal(x)) }
    if c == 22 { return autogradSumAll(autogradImaginary(x)) }
    if c == 23 { return autogradSumAll(autogradMultiply(autogradReal(x), autogradImaginary(x))) }
    if c == 24 { return autogradSumAll(autogradAbs2(autogradExpImaginary(autogradReal(x), DType.C64))) }
    if c == 25 { return autogradSumAll(autogradMultiply(autogradReal(autogradExpImaginary(autogradImaginary(x), DType.C64)), autogradReal(x))) }
    if c == 26 { return autogradSumAll(autogradAbs2(autogradComplex(autogradReal(x), autogradImaginary(x), DType.C64))) }
    if c == 27 { return autogradSumAll(autogradAbs2(autogradNegate(autogradConjugate(autogradMultiply(x, y))))) }
    panic("unknown case")
    return 0
}

// The loss alone, with nothing recorded, for a finite-difference probe.
fn loss_of(c: int, xt: Tensor, yt: Tensor) -> float {
    autogradReset()
    let x = autogradLeaf(xt, false)
    let y = autogradLeaf(yt, false)
    let l = build(c, x, y)
    return tensorGet(autogradValue(l), [0])
}

var n = 0

// ---- every VJP against central differences --------------------------------
for c in 0..36 {
    let xt = make_x(c)
    let yt = make_y(c)

    autogradReset()
    let x = autogradLeaf(xt, true)
    let y = autogradLeaf(yt, true)
    let loss = build(c, x, y)
    autogradBackward(loss)
    let gx = autogradGradient(x)

    n += ck(shapesEqual(gx.shape, xt.shape), "gradient has the shape of its input")
    n += ck(gx.dtype == xt.dtype, "gradient has the dtype of its input")

    var idx = indexZeros(xt.shape.len())
    var more = true
    while more {
        if dtypeIsComplex(xt.dtype) {
            let re0 = tensorGetReal(xt, idx)
            let im0 = tensorGetImaginary(xt, idx)
            tensorSetComplex(xt, idx, re0 + H, im0)
            let up_re = loss_of(c, xt, yt)
            tensorSetComplex(xt, idx, re0 - H, im0)
            let dn_re = loss_of(c, xt, yt)
            tensorSetComplex(xt, idx, re0, im0 + H)
            let up_im = loss_of(c, xt, yt)
            tensorSetComplex(xt, idx, re0, im0 - H)
            let dn_im = loss_of(c, xt, yt)
            tensorSetComplex(xt, idx, re0, im0)
            n += ck(rel_close((up_re - dn_re) / (2.0 * H), tensorGetReal(gx, idx), FD_TOL), "real part matches central differences")
            n += ck(rel_close((up_im - dn_im) / (2.0 * H), tensorGetImaginary(gx, idx), FD_TOL), "imaginary part matches central differences")
        } else {
            let v0 = tensorGet(xt, idx)
            tensorSet(xt, idx, v0 + H)
            let up = loss_of(c, xt, yt)
            tensorSet(xt, idx, v0 - H)
            let dn = loss_of(c, xt, yt)
            tensorSet(xt, idx, v0)
            n += ck(rel_close((up - dn) / (2.0 * H), tensorGet(gx, idx), FD_TOL), "gradient matches central differences")
        }
        more = indexNext(idx, xt.shape)
    }
}

// ---- the convention's defining case: grad(abs2(z)) is exactly 2z -----------
autogradReset()
let z2 = fill(tensorZeros(DType.C64, [2, 3]), 31)
let zh = autogradLeaf(z2, true)
autogradBackward(autogradSumAll(autogradAbs2(zh)))
let g2 = autogradGradient(zh)
var i2 = indexZeros(2)
var more2 = true
while more2 {
    n += ck(tensorGetReal(g2, i2) == 2.0 * tensorGetReal(z2, i2), "abs2 gradient is exactly 2z, real part")
    n += ck(tensorGetImaginary(g2, i2) == 2.0 * tensorGetImaginary(z2, i2), "abs2 gradient is exactly 2z, imaginary part")
    more2 = indexNext(i2, [2, 3])
}

// ---- broadcast and shared-parameter contributions --------------------------
// A row reused across four rows must receive four contributions, not one.
autogradReset()
let base = tensorFull(DType.F64, [4, 3], 2.0)
let row = tensorFull(DType.F64, [1, 3], 5.0)
let bh = autogradLeaf(base, true)
let rh = autogradLeaf(row, true)
autogradBackward(autogradSumAll(autogradMultiply(bh, rh)))
let grow = autogradGradient(rh)
n += ck(shapesEqual(grow.shape, [1, 3]), "broadcast gradient is reduced back to the input shape")
for j in 0..3 { n += ck(tensorGet(grow, [0, j]) == 8.0, "every broadcast contribution is summed") }
let gbase = autogradGradient(bh)
for j in 0..3 { n += ck(tensorGet(gbase, [0, j]) == 5.0, "the broadcast operand's own gradient is unreduced") }

// the same handle used twice must accumulate both paths
autogradReset()
let s1 = autogradLeaf(tensorFull(DType.F64, [2], 3.0), true)
autogradBackward(autogradSumAll(autogradAdd(s1, s1)))
n += ck(tensorGet(autogradGradient(s1), [0]) == 2.0, "a variable used twice accumulates both contributions")

autogradReset()
let s2 = autogradLeaf(tensorFull(DType.F64, [2], 3.0), true)
autogradBackward(autogradSumAll(autogradMultiply(s2, s2)))
n += ck(tensorGet(autogradGradient(s2), [0]) == 6.0, "x*x differentiates to 2x through accumulation")

// ---- A07: tape semantics ---------------------------------------------------

// consumed tape
autogradReset()
let c1 = autogradLeaf(tensorFull(DType.F64, [2], 1.5), true)
let l1 = autogradSumAll(autogradMultiply(c1, c1))
autogradBackward(l1)
n += ck(autogradIsConsumed(), "backward marks the tape consumed")

// detach cuts the history
autogradReset()
let d1 = autogradLeaf(tensorFull(DType.F64, [2], 1.5), true)
let d2 = autogradMultiply(d1, d1)
let d3 = autogradDetach(d2)
n += ck(not autogradRequiresGradient(d3), "a detached variable requires no gradient")
n += ck(tensorGet(autogradValue(d3), [0]) == tensorGet(autogradValue(d2), [0]), "detach preserves the value")

// no_grad records nothing
autogradReset()
let ng = autogradLeaf(tensorFull(DType.F64, [2], 1.5), true)
let before_nodes = autogradNodeCount()
autogradNoGradient(true)
let ng2 = autogradMultiply(ng, ng)
n += ck(autogradNodeCount() == before_nodes, "no_grad records no node")
n += ck(not autogradRequiresGradient(ng2), "a no_grad result requires no gradient")
autogradNoGradient(false)
let ng3 = autogradMultiply(ng, ng)
n += ck(autogradNodeCount() == before_nodes + 1, "recording resumes after no_grad")
n += ck(autogradRequiresGradient(ng3), "a recorded result requires a gradient")

// a constant leaf contributes no node and no gradient
autogradReset()
let k1 = autogradLeaf(tensorFull(DType.F64, [2], 2.0), false)
let k2 = autogradLeaf(tensorFull(DType.F64, [2], 3.0), false)
let k3 = autogradMultiply(k1, k2)
n += ck(autogradNodeCount() == 0, "an operation on constants records nothing")
n += ck(not autogradHasGradient(k1), "a constant never receives a gradient")

// the tape does not grow across repeated steps
autogradReset()
var peak = 0
for step in 0..25 {
    autogradReset()
    let p = autogradLeaf(tensorFull(DType.F64, [4], 1.25), true)
    autogradBackward(autogradSumAll(autogradTanh(autogradMultiply(p, p))))
    if autogradNodeCount() > peak { peak = autogradNodeCount() }
}
n += ck(peak == 3, "one step records exactly three nodes")
n += ck(autogradNodeCount() == 3, "25 steps leave the tape the size of one step")

print("autograd: {n} checks passed")
