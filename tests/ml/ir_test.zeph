// A24: IR verification, eager/captured parity, guard misses and cache
// invalidation.
//
// The tensor-IR section of the specification ends with its own acceptance
// list -- "text dump golden tests; invalid IR rejection; eager versus
// captured output/gradient equivalence; shape guard miss; RNG ordering;
// cache invalidation; source-located backend error" -- and this suite
// implements that list one item at a time, in that order, rather than
// inventing a different set.
//
// The standing instruction for M6 is that the eager path stays the oracle:
// "keep eager fallback as an oracle. Never make scientific evaluation depend
// on an unverified fusion." So every parity check here compares against
// eager execution, and every failure mode falls back to it.
import "ml/ir.zeph"
import "ml/phase_ad.zeph"

var passed = 0
var failed = 0
fn chk(c: bool, what: str) {
    if c { passed = passed + 1 } else {
        failed = failed + 1
        print("FAIL: {what}")
    }
}

var SEED = 20260921
fn rnd() -> float {
    SEED = (SEED * 1103515245 + 12345) % 2147483648
    return ((SEED % 2001) as float) / 1000.0 - 1.0
}
fn filled(d: DType, shape: [int]) -> Tensor {
    let t = t_zeros(d, shape)
    var idx = idx_zeros(shape.len())
    var more = t_numel(t) > 0
    while more {
        if dtype_is_complex(d) { t_set_c(t, idx, rnd(), rnd()) } else { t_set(t, idx, rnd()) }
        more = idx_next(idx, shape)
    }
    return t
}

// ===========================================================================
// 1. Text dump golden test
// ===========================================================================
// The dump has to be deterministic or the graph hash means nothing and the
// cache is unsound. Determinism is checked two ways: the text matches a
// literal written here by hand, and capturing the same model twice produces
// byte-identical text.
av_reset()
let ga = av_leaf(t_ones(DType.F64, [2, 3]), true)
let gb = av_leaf(t_ones(DType.F64, [2, 3]), true)
let gmul = av_mul(ga, gb)
let gout = av_sum_all(av_tanh(gmul))
let g1 = ir_capture(gout)
let dump1 = ir_dump(g1)

let golden = "graph \{\n  %0 = input : f64[2,3]\n  %1 = input : f64[2,3]\n  %2 = mul %0, %1 : f64[2,3] effects=1\n  %3 = tanh %2 : f64[2,3]\n  %4 = sum_all %3 \{2,3\} : f64[1]\n  return %4\n\}\n"
chk(dump1 == golden, "the dump matches the golden text")
if dump1 != golden {
    print("--- got ---")
    print(dump1)
    print("--- want ---")
    print(golden)
}

av_reset()
let ha = av_leaf(t_ones(DType.F64, [2, 3]), true)
let hb = av_leaf(t_ones(DType.F64, [2, 3]), true)
let h2 = ir_capture(av_sum_all(av_tanh(av_mul(ha, hb))))
chk(ir_dump(h2) == dump1, "capturing the same model twice gives byte-identical text")
chk(ir_hash(h2) == ir_hash(g1), "and the same graph hash")

// A different model must NOT collide. A hash that ignored shape or opcode
// would make the cache return the wrong artifact, which is worse than a miss.
av_reset()
let ka = av_leaf(t_ones(DType.F64, [2, 3]), true)
let kb = av_leaf(t_ones(DType.F64, [2, 3]), true)
let k1 = ir_capture(av_sum_all(av_tanh(av_add(ka, kb))))     // add, not mul
chk(ir_hash(k1) != ir_hash(g1), "a different opcode gives a different hash")
av_reset()
let ma = av_leaf(t_ones(DType.F64, [4, 3]), true)            // different shape
let mb = av_leaf(t_ones(DType.F64, [4, 3]), true)
let m1 = ir_capture(av_sum_all(av_tanh(av_mul(ma, mb))))
chk(ir_hash(m1) != ir_hash(g1), "a different shape gives a different hash")

// The shape check above passes for a reason that does not test what it looks
// like it tests: av_sum_all records the input shape in its attributes, so the
// hash differs through `ia` even if it ignored value shapes entirely. This
// pair has no reduction, so only the value shape can tell the two apart --
// mutation-tested by deleting the shape term from ir_hash, which the case
// above does not catch and this one does.
av_reset()
let sa1 = av_leaf(t_ones(DType.F64, [2, 3]), true)
let sb1 = av_leaf(t_ones(DType.F64, [2, 3]), true)
let bare1 = ir_capture(av_tanh(av_mul(sa1, sb1)))
av_reset()
let sa2 = av_leaf(t_ones(DType.F64, [2, 4]), true)
let sb2 = av_leaf(t_ones(DType.F64, [2, 4]), true)
let bare2 = ir_capture(av_tanh(av_mul(sa2, sb2)))
chk(ir_hash(bare1) != ir_hash(bare2), "shape alone changes the hash, with no attribute carrying it")

// Likewise dtype: same shapes, same opcodes, different element type.
av_reset()
let da1 = av_leaf(t_ones(DType.C64, [2, 3]), true)
let db1 = av_leaf(t_ones(DType.C64, [2, 3]), true)
let cbare = ir_capture(av_mul(da1, db1))
av_reset()
let ea1 = av_leaf(t_ones(DType.F64, [2, 3]), true)
let eb1 = av_leaf(t_ones(DType.F64, [2, 3]), true)
let rbare = ir_capture(av_mul(ea1, eb1))
chk(ir_hash(cbare) != ir_hash(rbare), "dtype alone changes the hash")

// ===========================================================================
// 2. Invalid IR rejection
// ===========================================================================
// Each case corrupts a valid graph in one specific way and requires the
// verifier to say so. Building them by mutating a real capture, rather than
// by hand, keeps them graphs the verifier could actually be handed.
fn fresh() -> IrGraph {
    av_reset()
    let a = av_leaf(filled(DType.F64, [2, 3]), true)
    let b = av_leaf(filled(DType.F64, [3, 4]), true)
    let c = av_leaf(filled(DType.C64, [2, 2]), true)
    let mm = av_matmul(a, b)
    let ab = av_abs2(c)
    let s = av_sum_dim(mm, 1)
    return ir_capture(av_sum_all(av_add(s, av_sum_dim(av_cast(ab, DType.F64), 1))))
}
let good = fresh()
chk(ir_verify(good).len() == 0, "the unmodified capture verifies clean")

fn one_error(g: IrGraph, want: str, label: str) {
    let e = ir_verify(g)
    var found = false
    for i in 0..e.len() {
        if e[i].contains(want) { found = true }
    }
    chk(found, "{label}: expected a diagnostic containing \"{want}\", got {e.len()} diagnostics")
    if not found {
        for i in 0..e.len() { print("    got: {e[i]}") }
    }
    // The diagnostic must locate itself, or it cannot be acted on.
    if found {
        var located = false
        for i in 0..e.len() {
            if e[i].contains(want) and e[i].contains("tape node") { located = true }
        }
        chk(located, "{label}: the diagnostic names the tape node it came from")
    }
}

// broken dominance: an operand defined after its use
var g_dom = fresh()
var nd_dom = g_dom.nodes[0]
g_dom.nodes[0] = IrNode{ op: nd_dom.op, out: nd_dom.out, a: g_dom.values.len() - 1,
                         b: nd_dom.b, ia: nd_dom.ia, fa: nd_dom.fa, effects: nd_dom.effects, span: nd_dom.span }
one_error(g_dom, "does not dominate", "dominance")

// operand out of range
var g_oob = fresh()
var nd_oob = g_oob.nodes[0]
g_oob.nodes[0] = IrNode{ op: nd_oob.op, out: nd_oob.out, a: 99999, b: nd_oob.b,
                         ia: nd_oob.ia, fa: nd_oob.fa, effects: nd_oob.effects, span: nd_oob.span }
one_error(g_oob, "out of range", "operand range")

// a matmul whose inner dimensions disagree
var g_mm = fresh()
var mi = 0 - 1
for i in 0..g_mm.nodes.len() {
    if g_mm.nodes[i].op == OP_MATMUL { mi = i }
}
chk(mi >= 0, "the fixture contains a matmul to corrupt")
if mi >= 0 {
    let v = g_mm.values[g_mm.nodes[mi].a]
    g_mm.values[g_mm.nodes[mi].a] = IrValue{ id: v.id, dt: v.dt, shape: [2, 7], stride: v.stride,
                                             off: v.off, device: v.device, contiguous: v.contiguous }
    one_error(g_mm, "inner dimensions disagree", "matmul inner dimension")
}

// abs2 declared to produce a complex result, which it cannot
var g_ab = fresh()
var ai = 0 - 1
for i in 0..g_ab.nodes.len() {
    if g_ab.nodes[i].op == OP_ABS2 { ai = i }
}
chk(ai >= 0, "the fixture contains an abs2 to corrupt")
if ai >= 0 {
    let v = g_ab.values[g_ab.nodes[ai].out]
    g_ab.values[g_ab.nodes[ai].out] = IrValue{ id: v.id, dt: DType.C64, shape: v.shape, stride: v.stride,
                                               off: v.off, device: v.device, contiguous: v.contiguous }
    one_error(g_ab, "produces a real tensor", "abs2 result dtype")
}

// mismatched dtypes on an elementwise op
var g_dt = fresh()
var di = 0 - 1
for i in 0..g_dt.nodes.len() {
    if g_dt.nodes[i].op == OP_ADD { di = i }
}
if di >= 0 {
    let v = g_dt.values[g_dt.nodes[di].b]
    g_dt.values[g_dt.nodes[di].b] = IrValue{ id: v.id, dt: DType.C64, shape: v.shape, stride: v.stride,
                                             off: v.off, device: v.device, contiguous: v.contiguous }
    one_error(g_dt, "differ in dtype", "elementwise dtype mismatch")
}

// a transfer boundary with nothing to cross it
var g_tx = fresh()
let tv = g_tx.values[g_tx.nodes[0].out]
g_tx.values[g_tx.nodes[0].out] = IrValue{ id: tv.id, dt: tv.dt, shape: tv.shape, stride: tv.stride,
                                          off: tv.off, device: DEV_GPU, contiguous: tv.contiguous }
one_error(g_tx, "no transfer between them", "transfer boundary")

// a sum_dim over an axis the operand does not have
var g_ax = fresh()
var si = 0 - 1
for i in 0..g_ax.nodes.len() {
    if g_ax.nodes[i].op == OP_SUM_DIM { si = i }
}
if si >= 0 {
    let nd = g_ax.nodes[si]
    g_ax.nodes[si] = IrNode{ op: nd.op, out: nd.out, a: nd.a, b: nd.b, ia: [9],
                             fa: nd.fa, effects: nd.effects, span: nd.span }
    one_error(g_ax, "is out of range", "sum_dim axis")
}

// a result that is not a value in the graph
var g_res = fresh()
g_res = IrGraph{ values: g_res.values, nodes: g_res.nodes, inputs: g_res.inputs,
                 result: 123456, var_of: g_res.var_of }
let e_res = ir_verify(g_res)
chk(e_res.len() > 0, "a result outside the graph is rejected")

// The verifier must not be rejecting everything: a clean graph after all
// that corruption still has to pass.
chk(ir_verify(fresh()).len() == 0, "the verifier still accepts a valid graph, so it is not rejecting unconditionally")

// ===========================================================================
// 3. Eager versus captured equivalence, output and gradient
// ===========================================================================
// Eager runs the model through the tape; captured replays the IR from the
// same inputs. Agreement means the IR carried everything the computation
// needed -- every attribute, every shape, every edge.
av_reset()
let ea = av_leaf(filled(DType.F64, [3, 4]), true)
let eb = av_leaf(filled(DType.F64, [4, 2]), true)
let ec = av_leaf(filled(DType.C64, [3, 2]), true)
let emm = av_matmul(ea, eb)
let emix = av_add(emm, av_cast(av_abs2(ec), DType.F64))
let eloss = av_sum_all(av_tanh(emix))
av_backward(eloss)
let eager_out = t_get(av_value(eloss), [0])
let eager_ga = t_copy(av_grad(ea))
let eager_gb = t_copy(av_grad(eb))

let cap = ir_capture(eloss)
chk(ir_verify(cap).len() == 0, "the mixed real/complex capture verifies clean")
var ins: [Tensor] = []
for i in 0..cap.inputs.len() { ins.push(A_VARS[cap.var_of[cap.inputs[i]]].v) }
let replayed = ir_replay(cap, ins)
chk(fabs(t_get(replayed, [0]) - eager_out) / (1.0 + fabs(eager_out)) < 0.000000000001,
    "captured output matches eager: {t_get(replayed, [0])} against {eager_out}")
chk(fabs(eager_out) > 0.0001, "the output is non-trivial, so the comparison is not on zero")

// Gradients: differentiate the replayed graph by running the same structure
// back through the tape, and compare to the eager gradients.
av_reset()
let ra = av_leaf(ins[0], true)
let rb = av_leaf(ins[1], true)
let rc = av_leaf(ins[2], true)
let rloss = av_sum_all(av_tanh(av_add(av_matmul(ra, rb), av_cast(av_abs2(rc), DType.F64))))
av_backward(rloss)
var gworst = 0.0
var gn = 0
for i in 0..eager_ga.shape[0] {
    for j in 0..eager_ga.shape[1] {
        let w = t_get(eager_ga, [i, j])
        let d = fabs(t_get(av_grad(ra), [i, j]) - w) / (1.0 + fabs(w))
        if d > gworst { gworst = d }
        gn = gn + 1
    }
}
for i in 0..eager_gb.shape[0] {
    for j in 0..eager_gb.shape[1] {
        let w = t_get(eager_gb, [i, j])
        let d = fabs(t_get(av_grad(rb), [i, j]) - w) / (1.0 + fabs(w))
        if d > gworst { gworst = d }
        gn = gn + 1
    }
}
chk(gworst < 0.000000000001, "captured gradients match eager across {gn} components, worst {gworst}")

// ---- regression: the gradient of a degenerate cast --------------------------
// Found by this suite. t_cast accepts the same dtype on both sides, and the
// OP_CAST VJP took t_real of the upstream gradient unconditionally -- correct
// for the real-to-complex cast the phase model uses, and a panic for a
// same-dtype cast, because the gradient is already real. Nothing else in the
// library writes one, so nothing else caught it.
av_reset()
let dc = av_leaf(filled(DType.F64, [2, 3]), true)
let dcast = av_cast(dc, DType.F64)
av_backward(av_sum_all(av_mul(dcast, dcast)))
var dgood = true
for i in 0..2 {
    for j in 0..3 {
        let want = 2.0 * t_get(av_value(dc), [i, j])
        if fabs(t_get(av_grad(dc), [i, j]) - want) > 0.000000000001 { dgood = false }
    }
}
chk(dgood, "a same-dtype cast has the identity gradient and does not panic")

// ===========================================================================
// 4. Shape guard miss
// ===========================================================================
let guard = ir_guard_make(cap)
chk(ir_guard_check(guard, ins) == "", "the guard admits the inputs it was made from")

var wrong_shape: [Tensor] = []
wrong_shape.push(filled(DType.F64, [5, 4]))       // 3x4 was specialised
wrong_shape.push(ins[1])
wrong_shape.push(ins[2])
let miss_shape = ir_guard_check(guard, wrong_shape)
chk(miss_shape != "", "a changed input shape is a guard miss")
chk(miss_shape.contains("[5,4]") and miss_shape.contains("[3,4]"),
    "the miss says what it got and what it expected: {miss_shape}")

var wrong_dtype: [Tensor] = []
wrong_dtype.push(t_cast(ins[0], DType.C64))
wrong_dtype.push(ins[1])
wrong_dtype.push(ins[2])
let miss_dt = ir_guard_check(guard, wrong_dtype)
chk(miss_dt != "" and miss_dt.contains("dtype"), "a changed input dtype is a guard miss: {miss_dt}")

var too_few: [Tensor] = []
too_few.push(ins[0])
chk(ir_guard_check(guard, too_few) != "", "the wrong number of inputs is a guard miss")

// A miss must be safe, which means eager still produces the right answer.
// "Never run a mismatched specialization" is only meaningful if the fallback
// is actually exercised.
av_reset()
let fa2 = av_leaf(wrong_shape[0], true)
let fb2 = av_leaf(wrong_shape[1], true)
let fc2 = av_leaf(filled(DType.C64, [5, 2]), true)
let floss = av_sum_all(av_tanh(av_add(av_matmul(fa2, fb2), av_cast(av_abs2(fc2), DType.F64))))
chk(t_get(av_value(floss), [0]) == t_get(av_value(floss), [0]),
    "after a guard miss the eager fallback still produces a finite result")

// ===========================================================================
// 5. RNG and effect ordering
// ===========================================================================
// There is no RNG op on the tape, so what can be checked is the ordering
// machinery that an RNG op would use: parameter reads are marked effectful,
// pure arithmetic is not, and the effectful nodes keep their relative order.
var eff_count = 0
var pure_count = 0
var last_eff = 0 - 1
var ordered = true
for i in 0..cap.nodes.len() {
    if cap.nodes[i].effects != EFF_NONE {
        eff_count = eff_count + 1
        if cap.nodes[i].span <= last_eff { ordered = false }
        last_eff = cap.nodes[i].span
    } else {
        pure_count = pure_count + 1
    }
}
chk(eff_count > 0, "some nodes carry effects ({eff_count} of {cap.nodes.len()})")
chk(pure_count > 0, "and some are pure, so the distinction is being made")
chk(ordered, "effectful nodes appear in increasing tape order, so their relative order is preserved")

// ===========================================================================
// 6. Cache invalidation
// ===========================================================================
// Every component of the key must be load-bearing. The loop below changes
// one field at a time and requires a miss each time; a key that ignored any
// of them would hand back an artifact built for a different device, driver
// or numeric policy.
fn key_of(gh: int, uh: int, abi: str, be: str, dev: str, drv: str, num: str, lay: str) -> IrCacheKey {
    return IrCacheKey{ graph_hash: gh, guard_hash: uh, abi: abi, backend: be,
                       device: dev, driver: drv, numeric: num, layout: lay }
}
var cache = ir_cache_new()
let base_key = key_of(ir_hash(cap), ir_guard_hash(guard), "abi1", "vulkan", "rtx5090", "580.00", "strict", "rowmajor")
chk(ir_cache_get(cache, base_key) < 0, "an empty cache misses")
ir_cache_put(cache, base_key, cap, guard)
chk(ir_cache_get(cache, base_key) >= 0, "and hits after the artifact is stored")

let variants = [key_of(ir_hash(cap) + 1, ir_guard_hash(guard), "abi1", "vulkan", "rtx5090", "580.00", "strict", "rowmajor"),
                key_of(ir_hash(cap), ir_guard_hash(guard) + 1, "abi1", "vulkan", "rtx5090", "580.00", "strict", "rowmajor"),
                key_of(ir_hash(cap), ir_guard_hash(guard), "abi2", "vulkan", "rtx5090", "580.00", "strict", "rowmajor"),
                key_of(ir_hash(cap), ir_guard_hash(guard), "abi1", "cuda", "rtx5090", "580.00", "strict", "rowmajor"),
                key_of(ir_hash(cap), ir_guard_hash(guard), "abi1", "vulkan", "rtx4090", "580.00", "strict", "rowmajor"),
                key_of(ir_hash(cap), ir_guard_hash(guard), "abi1", "vulkan", "rtx5090", "581.00", "strict", "rowmajor"),
                key_of(ir_hash(cap), ir_guard_hash(guard), "abi1", "vulkan", "rtx5090", "580.00", "fast", "rowmajor"),
                key_of(ir_hash(cap), ir_guard_hash(guard), "abi1", "vulkan", "rtx5090", "580.00", "strict", "colmajor")]
let vnames = ["graph hash", "guard hash", "ABI version", "backend", "device", "driver version", "numeric flags", "layout"]
for i in 0..variants.len() {
    chk(ir_cache_get(cache, variants[i]) < 0, "changing the {vnames[i]} misses the cache")
}
chk(ir_cache_get(cache, base_key) >= 0, "the original entry is still there after all those misses")

let dropped = ir_cache_invalidate(cache, "drv=580.00")
chk(dropped == 1, "invalidating by driver version dropped {dropped} entry")
chk(ir_cache_get(cache, base_key) < 0, "and the entry is gone afterwards")

// ===========================================================================
// 7. Source-located backend error
// ===========================================================================
// A graph the backend cannot run must say which node and why, not fail
// somewhere deep in a dispatch. Rank above 4 is the real limit of the device
// kernels, so that is the case used.
av_reset()
let big = av_leaf(t_ones(DType.F64, [2, 2, 2, 2, 2]), true)
let big2 = av_leaf(t_ones(DType.F64, [2, 2, 2, 2, 2]), true)
let bigcap = ir_capture(av_mul(big, big2))
let berr = ir_verify(bigcap)
var has_rank = false
for i in 0..berr.len() {
    if berr[i].contains("exceeds the device kernels' limit") and berr[i].contains("tape node") { has_rank = true }
}
chk(has_rank, "a rank-5 graph is diagnosed with the node it came from")
var says_eager = false
for i in 0..berr.len() {
    if berr[i].contains("must stay eager") { says_eager = true }
}
chk(says_eager, "and the diagnostic says what happens instead, rather than only that it is wrong")

// ===========================================================================
// Capturing the real model, which is the case that matters
// ===========================================================================
let D = 8
let E = 4
let H = 16
let cfg = PhaseConfig{input_vocab: 6, output_vocab: 3, D: D, E: E, H: H, K: 1, pad: 0, eps: 0.00000001}
let ps = [t_zeros(DType.F64, [6, E]), t_zeros(DType.F64, [E]), t_zeros(DType.F64, [H, E + 3 * D]),
          t_zeros(DType.F64, [H]), t_zeros(DType.F64, [3 * D, H]), t_zeros(DType.F64, [3 * D])]
for i in 0..ps.len() {
    var idx = idx_zeros(ps[i].shape.len())
    var more = true
    while more {
        t_set(ps[i], idx, rnd())
        more = idx_next(idx, ps[i].shape)
    }
}
let zi = filled(DType.C64, [D])
let Mo = filled(DType.C64, [3, D])
let pp = PhaseParams{config: cfg, embedding: ps[0], think: ps[1], W1: ps[2], b1: ps[3],
                     W2: ps[4], b2: ps[5], z_init: zi, M: Mo}
let toks = t_zeros(DType.I64, [4, 3])
for r in 0..4 {
    for s in 0..3 { t_set_int(toks, [r, s], 1 + (r + s) % 5) }
}
av_reset()
let pm = pad_params(pp, true)
let ploss = pad_loss(pm, toks, [0, 1, 2, 0])
av_backward(ploss)
let pcap = ir_capture(ploss)
let perr = ir_verify(pcap)
chk(perr.len() == 0, "the real phase model captures and verifies clean, {pcap.nodes.len()} nodes")
if perr.len() > 0 {
    for i in 0..perr.len() {
        if i < 8 { print("    {perr[i]}") }
    }
}
chk(pcap.nodes.len() > 100, "and the captured graph is the whole model, not a fragment ({pcap.nodes.len()} nodes)")
chk(ir_dump(pcap).len() > 1000, "the dump of it is substantial ({ir_dump(pcap).len()} characters)")

if failed == 0 {
    print("ir: {passed} checks passed")
} else {
    print("ir: {failed} FAILED, {passed} passed")
    panic("ir tests failed")
}
