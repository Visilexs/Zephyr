import "ml/gru.zeph"
import "ml/optim.zeph"

var passed = 0
var failed = 0
fn chk(cond: bool, what: str) {
    if cond { passed += 1 } else {
        failed += 1
        print("FAIL: {what}")
    }
}

var SEED = 20260921
fn rnd() -> float {
    SEED = (SEED * 1103515245 + 12345) % 2147483648
    return ((SEED / 65536) as float) / 32768.0
}

// Nonzero deterministic parameters exercise every gate and the learned h0.
fn build(head: int, iv: int, e: int, h: int) -> GruParams {
    let c = GruConfig{inputVocab: iv, outputVocab: 3, embeddingDimension: e, hiddenDimension: h, head: head, padToken: 0, epsilon: 0.00000001}
    let ps = [tensorZeros(DType.F64, [iv, e]), tensorZeros(DType.F64, [h, e + h]), tensorZeros(DType.F64, [h]),
              tensorZeros(DType.F64, [h, e + h]), tensorZeros(DType.F64, [h]), tensorZeros(DType.F64, [h, e + h]),
              tensorZeros(DType.F64, [h]), tensorZeros(DType.F64, [3, h]), tensorZeros(DType.F64, [3]), tensorZeros(DType.F64, [h])]
    for t in ps {
        var idx = indexZeros(t.shape.len())
        var more = true
        while more {
            tensorSet(t, idx, (rnd() - 0.5) * 0.6)
            more = indexNext(idx, t.shape)
        }
    }
    return GruParams{config: c, embedding: ps[0], updateGateWeight: ps[1], updateGateBias: ps[2], resetGateWeight: ps[3], resetGateBias: ps[4],
                     candidateWeight: ps[5], candidateBias: ps[6], outputWeight: ps[7], outputBias: ps[8], initialHidden: ps[9]}
}

fn handles(m: GruAD) -> [int] {
    return [m.embedding, m.updateGateWeight, m.updateGateBias, m.resetGateWeight, m.resetGateBias, m.candidateWeight, m.candidateBias, m.outputWeight, m.outputBias, m.initialHidden]
}

fn loss_value(p: GruParams, tokens: Tensor, targets: [int]) -> float {
    autogradReset()
    return tensorGet(autogradValue(gruLoss(gruParameters(p, false), tokens, targets)), [0])
}

// Include repeated embeddings, a PAD suffix, an interior PAD and all-PAD row.
fn test_tokens() -> Tensor {
    let values = [[1, 2, 1], [3, 0, 0], [2, 0, 3], [0, 0, 0]]
    let tokens = tensorZeros(DType.I64, [4, 3])
    for row in 0..4 {
        for step in 0..3 { tensorSetInt(tokens, [row, step], values[row][step]) }
    }
    return tokens
}

// Every element of all ten tensors, including zero-gradient PAD embeddings.
// Central differences use h=1e-6 and relative tolerance 2e-5, absolute floor 1e-8.
fn check_gradients(head: int) {
    let p = build(head, 4, 2, 3)
    let tokens = test_tokens()
    let targets = [0, 2, 1, 0]
    autogradReset()
    let offset = autogradLeaf(tensorOnes(DType.F64, [1]), false)
    let m = gruParameters(p, true)
    let ids = handles(m)
    let ps = gruParameterList(p)
    chk(ps.len() == 10, "head {head}: ten parameters")
    for i in 0..10 {
        chk(ids[i] == offset + 1 + i and tensorHex(autogradValue(ids[i])) == tensorHex(ps[i]), "head {head}: fixed leaf order {i}")
    }
    autogradBackward(gruLoss(m, tokens, targets))
    var grads: [Tensor] = []
    for i in 0..10 {
        chk(autogradHasGradient(ids[i]), "head {head}: parameter {i} has a gradient")
        grads.push(tensorCopy(autogradGradient(ids[i])))
    }
    for i in 0..10 {
        let t = ps[i]
        var idx = indexZeros(t.shape.len())
        var more = true
        var largest = 0.0
        while more {
            let original = tensorGet(t, idx)
            tensorSet(t, idx, original + 0.000001)
            let up = loss_value(p, tokens, targets)
            tensorSet(t, idx, original - 0.000001)
            let down = loss_value(p, tokens, targets)
            tensorSet(t, idx, original)
            let numeric = (up - down) / 0.000002
            let analytic = tensorGet(grads[i], idx)
            var scale = fabs(numeric)
            if fabs(analytic) > scale { scale = fabs(analytic) }
            chk(fabs(numeric - analytic) <= 0.00000001 + 0.00002 * scale,
                "head {head}: tensor {i} central difference {numeric}, analytic {analytic}")
            if fabs(analytic) > largest { largest = fabs(analytic) }
            more = indexNext(idx, t.shape)
        }
        chk(largest > 0.00000001, "head {head}: tensor {i} gradient is nontrivial")
    }
}

// Byte equality checks a padded row against its actual last unpadded state.
fn check_forward(head: int) {
    let p = build(head, 4, 2, 3)
    let tokens = test_tokens()
    autogradReset()
    let m = gruParameters(p, false)
    let state = autogradValue(gruForward(m, tokens))
    let prefix = autogradValue(gruForward(m, tensorCopy(tensorSlice(tokens, 1, 0, 1))))
    chk(tensorHex(tensorCopy(tensorSlice(state, 0, 1, 2))) == tensorHex(tensorCopy(tensorSlice(prefix, 0, 1, 2))), "head {head}: PAD suffix freezes state bit-exactly")
    chk(tensorHex(tensorCopy(tensorSlice(state, 0, 3, 4))) == tensorHex(p.initialHidden), "head {head}: all-PAD row keeps h0 bit-exactly")
    chk(tensorHex(tensorCopy(tensorSlice(state, 0, 0, 1))) != tensorHex(p.initialHidden), "head {head}: real tokens move state")
    let empty = autogradValue(gruForward(m, tensorZeros(DType.I64, [1, 0])))
    chk(tensorHex(empty) == tensorHex(p.initialHidden), "head {head}: empty sequence returns h0")
    let compact = tensorZeros(DType.I64, [1, 2])
    tensorSetInt(compact, [0, 0], 2)
    tensorSetInt(compact, [0, 1], 3)
    chk(tensorHex(autogradValue(gruForward(m, compact))) == tensorHex(tensorCopy(tensorSlice(state, 0, 2, 3))), "head {head}: interior PAD skips exactly one update")
    let probs = autogradValue(gruReadout(m, autogradLeaf(state, false)))
    for row in 0..4 {
        var total = 0.0
        for col in 0..3 {
            let value = tensorGet(probs, [row, col])
            chk(value >= 0.0, "head {head}: nonnegative probability")
            total += value
        }
        chk(fabs(total - 1.0) <= 0.000000000001, "head {head}: probabilities sum to one")
    }
    // Negating both output parameters negates u, including its bias.
    for t in [p.outputWeight, p.outputBias] {
        var idx = indexZeros(t.shape.len())
        var more = true
        while more {
            tensorSet(t, idx, 0.0 - tensorGet(t, idx))
            more = indexNext(idx, t.shape)
        }
    }
    autogradReset()
    let flipped = autogradValue(gruReadout(gruParameters(p, false), autogradLeaf(state, false)))
    if head == 1 {
        chk(tensorHex(probs) == tensorHex(flipped), "quadratic head is invariant to sign of u")
        for t in [p.outputWeight, p.outputBias] {
            var idx = indexZeros(t.shape.len())
            var more = true
            while more {
                tensorSet(t, idx, 0.0)
                more = indexNext(idx, t.shape)
            }
        }
        autogradReset()
        let uniform = autogradValue(gruReadout(gruParameters(p, false), autogradLeaf(state, false)))
        chk(fabs(tensorGet(uniform, [0, 0]) - 1.0 / 3.0) < 0.000000000001, "quadratic eps makes zero amplitudes uniform")
    } else {
        chk(fabs(tensorGet(probs, [0, 0]) - tensorGet(flipped, [0, 0])) > 0.000001, "linear head changes under sign of u")
        for col in 0..3 { tensorSet(p.outputBias, [col], tensorGet(p.outputBias, [col]) + 1000.0) }
        autogradReset()
        let shifted = autogradValue(gruReadout(gruParameters(p, false), autogradLeaf(state, false)))
        chk(fabs(tensorGet(shifted, [0, 0]) - tensorGet(flipped, [0, 0])) < 0.000000000001, "linear softmax remains stable for large logits")
    }
}

// Child panics cannot be caught in-process. Spawn failure and timeout are
// separate failures, never evidence that validation rejected an input.
fn child(case: str) -> int {
    var cmd = cString("\"{args()[0]}\" {case}")
    let startup = Bytes.new(104)
    startup.put32(0, 104)
    let process = Bytes.new(24)
    let started = win("CreateProcessA", 0, cmd.addr(), 0, 0, 1, 134217728, 0, 0, startup.addr(), process.addr())
    if started == 0 { return 0 - 1 }
    let waited = win("WaitForSingleObject", process.get64(0), 30000)
    let status = Bytes.new(8)
    win("GetExitCodeProcess", process.get64(0), status.addr())
    if waited != 0 { win("TerminateProcess", process.get64(0), 1) }
    win("CloseHandle", process.get64(0))
    win("CloseHandle", process.get64(8))
    if waited != 0 { return 0 - 1 }
    return status.get32(0)
}

// Thirty-two distinct two-token sequences; labels come from a fixed RNG,
// independently of initialization. Both heads must memorize all examples.
fn check_overfit(head: int) {
    SEED = 714123
    let tokens = tensorZeros(DType.I64, [32, 2])
    var targets: [int] = []
    for row in 0..32 {
        tensorSetInt(tokens, [row, 0], 1 + row / 6)
        tensorSetInt(tokens, [row, 1], 1 + row % 6)
        targets.push((rnd() * 3.0) as int)
    }
    SEED = 20260921
    let p = build(head, 7, 8, 16)
    let ps = gruParameterList(p)
    let start = loss_value(p, tokens, targets)
    let opt = newAdamW(ps, 0.02, 0.9, 0.999, 0.00000001, 0.0)
    for step in 0..300 {
        autogradReset()
        let m = gruParameters(p, true)
        autogradBackward(gruLoss(m, tokens, targets))
        let ids = handles(m)
        var grads: [Tensor] = []
        for i in 0..10 { grads.push(tensorCopy(autogradGradient(ids[i]))) }
        let norm = clipGradientNorm(grads, 5.0)
        if not (norm >= 0.0) or norm - norm != 0.0 { panic("gru: nonfinite training gradient") }
        optimizerStep(opt, ps, grads)
    }
    let finish = loss_value(p, tokens, targets)
    chk(opt.step == 300, "head {head}: 300 AdamW steps")
    chk(finish < 0.01 and finish < start * 0.01, "head {head}: near-zero loss and at least 100-fold reduction")
    autogradReset()
    let m = gruParameters(p, false)
    let probs = autogradValue(gruReadout(m, gruForward(m, tokens)))
    var correct = 0
    for row in 0..32 {
        var best = 0
        for col in 1..3 {
            if tensorGet(probs, [row, col]) > tensorGet(probs, [row, best]) { best = col }
        }
        if best == targets[row] { correct += 1 }
    }
    chk(correct == 32, "head {head}: all 32 random labels memorized")
    print("gru overfit head {head}: loss {start} -> {finish}, {correct}/32 correct, 300 AdamW steps")
}

if args().len() > 1 {
    let case = args()[1]
    var p = build(0, 4, 2, 3)
    if case == "shape" { p.updateGateWeight = tensorZeros(DType.F64, [3, 4]) }
    if case == "head" { p.config.head = 2 }
    let m = gruParameters(p, false)
    var tokens = test_tokens()
    if case == "rank" { tokens = tensorZeros(DType.I64, [4]) }
    if case == "dtype" { tokens = tensorZeros(DType.F64, [4, 3]) }
    if case == "token" { tensorSetInt(tokens, [0, 0], 4) }
    var targets = [0, 2, 1, 0]
    if case == "count" { targets = [0] }
    if case == "target" { targets[0] = 3 }
    gruLoss(m, tokens, targets)
    print("UNREACHABLE: {case} was accepted")
} else {
    for head in [0, 1] {
        check_gradients(head)
        check_forward(head)
    }
    for case in ["shape", "head", "rank", "dtype", "token", "count", "target"] {
        let code = child(case)
        chk(code > 0 and code != 259, "{case}: child rejects invalid input (exit {code})")
    }
    for head in [0, 1] { check_overfit(head) }
    if failed > 0 {
        print("gru: {failed} FAILED, {passed} passed")
        panic("gru tests failed")
    }
    print("gru: {passed} checks passed")
}
