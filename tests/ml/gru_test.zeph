import "ml/gru.zeph"
import "ml/optim.zeph"

var passed = 0
var failed = 0
fn chk(cond: bool, what: str) {
    if cond { passed += 1 } else {
        failed += 1
        print("FAIL: {what}")
    }
}

var SEED = 20260921
fn rnd() -> float {
    SEED = (SEED * 1103515245 + 12345) % 2147483648
    return ((SEED / 65536) as float) / 32768.0
}

// Nonzero deterministic parameters exercise every gate and the learned h0.
fn build(head: int, iv: int, e: int, h: int) -> GruParams {
    let c = GruConfig{input_vocab: iv, output_vocab: 3, E: e, Hn: h, head: head, pad: 0, eps: 0.00000001}
    let ps = [t_zeros(DType.F64, [iv, e]), t_zeros(DType.F64, [h, e + h]), t_zeros(DType.F64, [h]),
              t_zeros(DType.F64, [h, e + h]), t_zeros(DType.F64, [h]), t_zeros(DType.F64, [h, e + h]),
              t_zeros(DType.F64, [h]), t_zeros(DType.F64, [3, h]), t_zeros(DType.F64, [3]), t_zeros(DType.F64, [h])]
    for t in ps {
        var idx = idx_zeros(t.shape.len())
        var more = true
        while more {
            t_set(t, idx, (rnd() - 0.5) * 0.6)
            more = idx_next(idx, t.shape)
        }
    }
    return GruParams{config: c, embedding: ps[0], Wz: ps[1], bz: ps[2], Wr: ps[3], br: ps[4],
                     Wn: ps[5], bn: ps[6], Wo: ps[7], bo: ps[8], h0: ps[9]}
}

fn handles(m: GruAD) -> [int] {
    return [m.embedding, m.Wz, m.bz, m.Wr, m.br, m.Wn, m.bn, m.Wo, m.bo, m.h0]
}

fn loss_value(p: GruParams, tokens: Tensor, targets: [int]) -> float {
    av_reset()
    return t_get(av_value(gru_loss(gru_params(p, false), tokens, targets)), [0])
}

// Include repeated embeddings, a PAD suffix, an interior PAD and all-PAD row.
fn test_tokens() -> Tensor {
    let values = [[1, 2, 1], [3, 0, 0], [2, 0, 3], [0, 0, 0]]
    let tokens = t_zeros(DType.I64, [4, 3])
    for row in 0..4 {
        for step in 0..3 { t_set_int(tokens, [row, step], values[row][step]) }
    }
    return tokens
}

// Every element of all ten tensors, including zero-gradient PAD embeddings.
// Central differences use h=1e-6 and relative tolerance 2e-5, absolute floor 1e-8.
fn check_gradients(head: int) {
    let p = build(head, 4, 2, 3)
    let tokens = test_tokens()
    let targets = [0, 2, 1, 0]
    av_reset()
    let offset = av_leaf(t_ones(DType.F64, [1]), false)
    let m = gru_params(p, true)
    let ids = handles(m)
    let ps = gru_param_list(p)
    chk(ps.len() == 10, "head {head}: ten parameters")
    for i in 0..10 {
        chk(ids[i] == offset + 1 + i and t_hex(av_value(ids[i])) == t_hex(ps[i]), "head {head}: fixed leaf order {i}")
    }
    av_backward(gru_loss(m, tokens, targets))
    var grads: [Tensor] = []
    for i in 0..10 {
        chk(av_has_grad(ids[i]), "head {head}: parameter {i} has a gradient")
        grads.push(t_copy(av_grad(ids[i])))
    }
    for i in 0..10 {
        let t = ps[i]
        var idx = idx_zeros(t.shape.len())
        var more = true
        var largest = 0.0
        while more {
            let original = t_get(t, idx)
            t_set(t, idx, original + 0.000001)
            let up = loss_value(p, tokens, targets)
            t_set(t, idx, original - 0.000001)
            let down = loss_value(p, tokens, targets)
            t_set(t, idx, original)
            let numeric = (up - down) / 0.000002
            let analytic = t_get(grads[i], idx)
            var scale = fabs(numeric)
            if fabs(analytic) > scale { scale = fabs(analytic) }
            chk(fabs(numeric - analytic) <= 0.00000001 + 0.00002 * scale,
                "head {head}: tensor {i} central difference {numeric}, analytic {analytic}")
            if fabs(analytic) > largest { largest = fabs(analytic) }
            more = idx_next(idx, t.shape)
        }
        chk(largest > 0.00000001, "head {head}: tensor {i} gradient is nontrivial")
    }
}

// Byte equality checks a padded row against its actual last unpadded state.
fn check_forward(head: int) {
    let p = build(head, 4, 2, 3)
    let tokens = test_tokens()
    av_reset()
    let m = gru_params(p, false)
    let state = av_value(gru_forward(m, tokens))
    let prefix = av_value(gru_forward(m, t_copy(t_slice(tokens, 1, 0, 1))))
    chk(t_hex(t_copy(t_slice(state, 0, 1, 2))) == t_hex(t_copy(t_slice(prefix, 0, 1, 2))), "head {head}: PAD suffix freezes state bit-exactly")
    chk(t_hex(t_copy(t_slice(state, 0, 3, 4))) == t_hex(p.h0), "head {head}: all-PAD row keeps h0 bit-exactly")
    chk(t_hex(t_copy(t_slice(state, 0, 0, 1))) != t_hex(p.h0), "head {head}: real tokens move state")
    let empty = av_value(gru_forward(m, t_zeros(DType.I64, [1, 0])))
    chk(t_hex(empty) == t_hex(p.h0), "head {head}: empty sequence returns h0")
    let compact = t_zeros(DType.I64, [1, 2])
    t_set_int(compact, [0, 0], 2)
    t_set_int(compact, [0, 1], 3)
    chk(t_hex(av_value(gru_forward(m, compact))) == t_hex(t_copy(t_slice(state, 0, 2, 3))), "head {head}: interior PAD skips exactly one update")
    let probs = av_value(gru_readout(m, av_leaf(state, false)))
    for row in 0..4 {
        var total = 0.0
        for col in 0..3 {
            let value = t_get(probs, [row, col])
            chk(value >= 0.0, "head {head}: nonnegative probability")
            total += value
        }
        chk(fabs(total - 1.0) <= 0.000000000001, "head {head}: probabilities sum to one")
    }
    // Negating both output parameters negates u, including its bias.
    for t in [p.Wo, p.bo] {
        var idx = idx_zeros(t.shape.len())
        var more = true
        while more {
            t_set(t, idx, 0.0 - t_get(t, idx))
            more = idx_next(idx, t.shape)
        }
    }
    av_reset()
    let flipped = av_value(gru_readout(gru_params(p, false), av_leaf(state, false)))
    if head == 1 {
        chk(t_hex(probs) == t_hex(flipped), "quadratic head is invariant to sign of u")
        for t in [p.Wo, p.bo] {
            var idx = idx_zeros(t.shape.len())
            var more = true
            while more {
                t_set(t, idx, 0.0)
                more = idx_next(idx, t.shape)
            }
        }
        av_reset()
        let uniform = av_value(gru_readout(gru_params(p, false), av_leaf(state, false)))
        chk(fabs(t_get(uniform, [0, 0]) - 1.0 / 3.0) < 0.000000000001, "quadratic eps makes zero amplitudes uniform")
    } else {
        chk(fabs(t_get(probs, [0, 0]) - t_get(flipped, [0, 0])) > 0.000001, "linear head changes under sign of u")
        for col in 0..3 { t_set(p.bo, [col], t_get(p.bo, [col]) + 1000.0) }
        av_reset()
        let shifted = av_value(gru_readout(gru_params(p, false), av_leaf(state, false)))
        chk(fabs(t_get(shifted, [0, 0]) - t_get(flipped, [0, 0])) < 0.000000000001, "linear softmax remains stable for large logits")
    }
}

// Child panics cannot be caught in-process. Spawn failure and timeout are
// separate failures, never evidence that validation rejected an input.
fn child(case: str) -> int {
    var cmd = cbytes("\"{args()[0]}\" {case}")
    let startup = Bytes.new(104)
    startup.put32(0, 104)
    let process = Bytes.new(24)
    let started = win("CreateProcessA", 0, cmd.addr(), 0, 0, 1, 134217728, 0, 0, startup.addr(), process.addr())
    if started == 0 { return 0 - 1 }
    let waited = win("WaitForSingleObject", process.get64(0), 30000)
    let status = Bytes.new(8)
    win("GetExitCodeProcess", process.get64(0), status.addr())
    if waited != 0 { win("TerminateProcess", process.get64(0), 1) }
    win("CloseHandle", process.get64(0))
    win("CloseHandle", process.get64(8))
    if waited != 0 { return 0 - 1 }
    return status.get32(0)
}

// Thirty-two distinct two-token sequences; labels come from a fixed RNG,
// independently of initialization. Both heads must memorize all examples.
fn check_overfit(head: int) {
    SEED = 714123
    let tokens = t_zeros(DType.I64, [32, 2])
    var targets: [int] = []
    for row in 0..32 {
        t_set_int(tokens, [row, 0], 1 + row / 6)
        t_set_int(tokens, [row, 1], 1 + row % 6)
        targets.push((rnd() * 3.0) as int)
    }
    SEED = 20260921
    let p = build(head, 7, 8, 16)
    let ps = gru_param_list(p)
    let start = loss_value(p, tokens, targets)
    let opt = adamw_new(ps, 0.02, 0.9, 0.999, 0.00000001, 0.0)
    for step in 0..300 {
        av_reset()
        let m = gru_params(p, true)
        av_backward(gru_loss(m, tokens, targets))
        let ids = handles(m)
        var grads: [Tensor] = []
        for i in 0..10 { grads.push(t_copy(av_grad(ids[i]))) }
        let norm = clip_grad_norm(grads, 5.0)
        if not (norm >= 0.0) or norm - norm != 0.0 { panic("gru: nonfinite training gradient") }
        optim_step(opt, ps, grads)
    }
    let finish = loss_value(p, tokens, targets)
    chk(opt.step == 300, "head {head}: 300 AdamW steps")
    chk(finish < 0.01 and finish < start * 0.01, "head {head}: near-zero loss and at least 100-fold reduction")
    av_reset()
    let m = gru_params(p, false)
    let probs = av_value(gru_readout(m, gru_forward(m, tokens)))
    var correct = 0
    for row in 0..32 {
        var best = 0
        for col in 1..3 {
            if t_get(probs, [row, col]) > t_get(probs, [row, best]) { best = col }
        }
        if best == targets[row] { correct += 1 }
    }
    chk(correct == 32, "head {head}: all 32 random labels memorized")
    print("gru overfit head {head}: loss {start} -> {finish}, {correct}/32 correct, 300 AdamW steps")
}

if args().len() > 1 {
    let case = args()[1]
    var p = build(0, 4, 2, 3)
    if case == "shape" { p.Wz = t_zeros(DType.F64, [3, 4]) }
    if case == "head" { p.config.head = 2 }
    let m = gru_params(p, false)
    var tokens = test_tokens()
    if case == "rank" { tokens = t_zeros(DType.I64, [4]) }
    if case == "dtype" { tokens = t_zeros(DType.F64, [4, 3]) }
    if case == "token" { t_set_int(tokens, [0, 0], 4) }
    var targets = [0, 2, 1, 0]
    if case == "count" { targets = [0] }
    if case == "target" { targets[0] = 3 }
    gru_loss(m, tokens, targets)
    print("UNREACHABLE: {case} was accepted")
} else {
    for head in [0, 1] {
        check_gradients(head)
        check_forward(head)
    }
    for case in ["shape", "head", "rank", "dtype", "token", "count", "target"] {
        let code = child(case)
        chk(code > 0 and code != 259, "{case}: child rejects invalid input (exit {code})")
    }
    for head in [0, 1] { check_overfit(head) }
    if failed > 0 {
        print("gru: {failed} FAILED, {passed} passed")
        panic("gru tests failed")
    }
    print("gru: {passed} checks passed")
}
