// Dump operator results bit-exactly for the numpy cross-check.
import "ml/ops.zeph"

var SEED = 12345
fn rnd() -> float {
    SEED = (SEED * 1103515245 + 12345) % 2147483648
    return ((SEED % 20001) as float) / 1000.0 - 10.0
}

fn dumpR(tag: str, t: Tensor) {
    var idx = indexZeros(t.shape.len())
    var more = tensorElementCount(t) > 0
    while more {
        print("{tag} {bits(tensorGet(t, idx))}")
        more = indexNext(idx, t.shape)
    }
}
fn dumpC(tag: str, t: Tensor) {
    var idx = indexZeros(t.shape.len())
    var more = tensorElementCount(t) > 0
    while more {
        print("{tag} {bits(tensorGetReal(t, idx))} {bits(tensorGetImaginary(t, idx))}")
        more = indexNext(idx, t.shape)
    }
}

// real operands [4,5] and [4,5], plus a [1,5] row and a [4,1] column
let A = tensorZeros(DType.F64, [4, 5])
let B = tensorZeros(DType.F64, [4, 5])
var i = 0
while i < 4 {
    var j = 0
    while j < 5 {
        tensorSet(A, [i, j], rnd())
        tensorSet(B, [i, j], rnd())
        j += 1
    }
    i += 1
}
let R = tensorZeros(DType.F64, [1, 5])
var j2 = 0
while j2 < 5 {
    tensorSet(R, [0, j2], rnd())
    j2 += 1
}
dumpR("A", A)
dumpR("B", B)
dumpR("R", R)
dumpR("add", tensorAdd(A, B))
dumpR("sub", tensorSubtract(A, B))
dumpR("mul", tensorMultiply(A, B))
dumpR("div", tensorDivide(A, B))
dumpR("bcast", tensorAdd(A, R))
dumpR("neg", tensorNegate(A))
dumpR("sumdim0", tensorSumDimension(A, 0))
dumpR("sumdim1", tensorSumDimension(A, 1))
print("sumall {bits(tensorSumAll(A))}")
print("meanall {bits(tensorMeanAll(A))}")
// transposed operand, to exercise the strided path
dumpR("trmul", tensorMultiply(tensorTranspose(A, 0, 1), tensorTranspose(B, 0, 1)))
// matmul [4,5] @ [5,3]
let M = tensorZeros(DType.F64, [5, 3])
var p = 0
while p < 5 {
    var q = 0
    while q < 3 {
        tensorSet(M, [p, q], rnd())
        q += 1
    }
    p += 1
}
dumpR("M", M)
dumpR("matmul", tensorMatmul(A, M))

// complex operands [3,2]
let CA = tensorZeros(DType.C64, [3, 2])
let CB = tensorZeros(DType.C64, [3, 2])
var r = 0
while r < 3 {
    var s = 0
    while s < 2 {
        tensorSetComplex(CA, [r, s], rnd(), rnd())
        tensorSetComplex(CB, [r, s], rnd(), rnd())
        s += 1
    }
    r += 1
}
dumpC("CA", CA)
dumpC("CB", CB)
dumpC("cadd", tensorAdd(CA, CB))
dumpC("cmul", tensorMultiply(CA, CB))
dumpC("cdiv", tensorDivide(CA, CB))
dumpC("cconj", tensorConjugate(CA))
dumpR("cabs2", tensorAbs2(CA))
dumpR("creal", tensorReal(CA))
dumpR("cimag", tensorImaginary(CA))
dumpC("cexpi", tensorExpImaginary(tensorReal(CA), DType.C64))
// complex matmul [3,2] @ [2,4]
let CM = tensorZeros(DType.C64, [2, 4])
var u = 0
while u < 2 {
    var w = 0
    while w < 4 {
        tensorSetComplex(CM, [u, w], rnd(), rnd())
        w += 1
    }
    u += 1
}
dumpC("CM", CM)
dumpC("cmatmul", tensorMatmul(CA, CM))

// M3 prerequisite operators
dumpR("tanh", tensorTanh(A))
dumpR("exp", tensorExp(A))
dumpR("cosr", tensorCos(A))
dumpR("sinr", tensorSin(A))
dumpR("sel0", tensorIndexSelect(A, 0, [3, 0, 2, 0]))
dumpR("sel1", tensorIndexSelect(A, 1, [4, 1]))
dumpR("rollm1", tensorRoll(A, 1, 0 - 1))
dumpR("rollp2", tensorRoll(A, 0, 2))
dumpR("cat0", tensorConcat(A, B, 0))
dumpR("cat1", tensorConcat(A, B, 1))
dumpC("csel", tensorIndexSelect(CA, 0, [2, 1]))
dumpC("croll", tensorRoll(CA, 1, 0 - 1))
