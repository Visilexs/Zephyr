import "ml/checkpoint.zeph"
import "ml/autograd.zeph"

fn ck(cond: bool, name: str) -> int {
    assert(cond, name)
    return 1
}

fn near(a: float, b: float) -> bool { return fabs(a - b) <= 0.000000000001 * (1.0 + fabs(b)) }

// Capture the child's panic too: a generic crash must not pass a rejection test.
var CHILD_PIDS: [int] = []

fn rejects(mode: int, message: str) -> bool {
    let logname = cString("optim-child.log")
    let security = Bytes.new(24)
    security.put32(0, 24)
    security.put32(16, 1)
    let log = win("CreateFileA", logname.address, 1073741824, 3, security.address, 2, 128, 0)
    assert(log != 0 - 1, "open child log")
    let command = cString("\"{args()[0]}\" {mode}")
    let startup = Bytes.new(104)
    startup.put32(0, 104)
    startup.put32(60, 256)
    startup.put64(80, win("GetStdHandle", 0 - 10))
    startup.put64(88, log)
    startup.put64(96, log)
    let process = Bytes.new(24)
    let started = win("CreateProcessA", 0, command.address, 0, 0, 1, 134217728, 0, 0, startup.address, process.address)
    assert(started != 0, "start rejection child")
    // PROCESS_INFORMATION.dwProcessId, so the cleanup at the end can name the
    // temporary file a deliberately interrupted child leaves behind.
    CHILD_PIDS.push(process.get32(16))
    let waited = win("WaitForSingleObject", process.get64(0), 30000)
    assert(waited == 0, "wait rejection child")
    let status = Bytes.new(4)
    assert(win("GetExitCodeProcess", process.get64(0), status.address) != 0, "read child exit")
    win("CloseHandle", process.get64(0))
    win("CloseHandle", process.get64(8))
    win("CloseHandle", log)
    let output = readFile("optim-child.log")
    return status.get32(0) == 1 and output.contains(message)
}

// Nonconstant gradients make missing moments or a reset step observable on resume.
fn training_step(o: Optim, params: [Tensor], step: int) {
    var grads: [Tensor] = []
    for p in params {
        let g = tensorZeros(p.dtype, p.shape)
        var idx = indexZeros(p.shape.len())
        for j in 0..tensorElementCount(p) {
            for c in 0..optimizerComponentCount(p) {
                optimizerPutComponent(g, idx, c, optimizerGetComponent(p, idx, c) * 0.3 + ((step + c + j) as float) * 0.07)
            }
            indexNext(idx, p.shape)
        }
        grads.push(g)
    }
    optimizerStep(o, params, grads)
}

// Child modes share a valid file, then corrupt exactly one field at a time.
if args().len() > 1 {
    let mode = args()[1] as int
    let b = checkpointRead("optim-good.ckpt")
    if mode <= 7 or mode >= 11 {
        var bad = b
        if mode == 1 { bad.put64(0, 0) }
        if mode == 2 { bad.put64(8, 99) }
        if mode == 3 { bad = Bytes.new(12) }
        if mode == 4 { bad.put64(16, b.size) }
        if mode == 5 { bad.put64(128, 2) }
        if mode == 6 { bad.put8(136, bad.get8(136) ^ 1) }
        if mode == 7 { bad.put64(16, 9223372036854775807) }
        if mode == 11 { bad.put64(112, 9223372036854775807) }
        if mode == 12 { bad.put64(128, 9223372036854775807) }
        if mode == 13 {
            bad = Bytes.new(112)
            for i in 0..112 { bad.put8(i, b.get8(i)) }
            bad.put64(16, 80)
        }
        if mode == 14 { bad.put64(120, 9223372036854775807) }
        let writer = checkpointBegin("optim-bad.ckpt")
        checkpointWrite(writer, bad, 0, bad.size)
        checkpointCommit(writer)
        let ignored = checkpointLoad("optim-bad.ckpt")
    }
    if mode == 8 or mode == 9 {
        let writer = checkpointBegin("optim-good.ckpt")
        checkpointWrite(writer, b, 0, 32)
        if mode == 9 {
            print("interrupted after header")
            win("ExitProcess", 1)
        }
        // An actual OS write failure after the header, through the save writer.
        win("CloseHandle", writer.handle)
        writer.handle = 0 - 1
        checkpointWrite(writer, b, 32, b.size - 32)
    }
    if mode == 10 {
        let restored = checkpointDecode(b)
        tensorSet(restored.params[0], [0], 123.0)
        checkpointSave("optim-good.ckpt", restored.params, restored.optimizer)
    }
    win("ExitProcess", 0)
}

var n = 0
let p = tensorFull(DType.F64, [1], 2.0)
let g = tensorFull(DType.F64, [1], 3.0)
let sgd = newSgd([p], 0.1, 0.0, 0.2)
optimizerStep(sgd, [p], [g])
n += ck(near(tensorGet(p, [0]), 1.66), "SGD hand value including L2")
n += ck(sgd.step == 1, "SGD step")
let mp = tensorFull(DType.F64, [1], 2.0)
let mg = tensorFull(DType.F64, [1], 1.0)
let momentum = newSgd([mp], 0.1, 0.5, 0.0)
for i in 0..3 { optimizerStep(momentum, [mp], [mg]) }
n += ck(near(tensorGet(mp, [0]), 1.575), "momentum three hand steps")
n += ck(near(tensorGet(momentum.m[0], [0]), 1.75) and momentum.step == 3, "momentum state and count")

let ap = tensorFull(DType.F64, [2], 2.0)
let ag = tensorFull(DType.F64, [2], 1000.0)
tensorSet(ag, [1], 0.001)
let adam = newAdamW([ap], 0.1, 0.9, 0.999, 0.00000001, 0.0)
optimizerStep(adam, [ap], [ag])
n += ck(near(tensorGet(ap, [0]), 2.0 - 0.1 * 1000.0 / (1000.0 + 0.00000001)), "Adam first bias correction large")
n += ck(near(tensorGet(ap, [1]), 2.0 - 0.1 * 0.001 / (0.001 + 0.00000001)), "Adam first bias correction small")
let dp = tensorFull(DType.F64, [1], 2.0)
let decay = newAdamW([dp], 0.1, 0.9, 0.999, 0.00000001, 0.2)
optimizerStep(decay, [dp], [tensorZeros(DType.F64, [1])])
n += ck(bits(tensorGet(dp, [0])) == bits(2.0 - 0.1 * 0.2 * 2.0), "zero gradient decays exactly lr wd p")
n += ck(tensorGet(decay.m[0], [0]) == 0.0 and tensorGet(decay.v[0], [0]) == 0.0, "decay excluded from moments")

// Paired-real equivalence spans six orders of gradient scale and two steps.
for complex_dtype in [DType.C32, DType.C64] {
    let cp = tensorFull(complex_dtype, [1], 2.0)
    tensorSetComplex(cp, [0], 2.0, 2.0)
    let cg = tensorZeros(complex_dtype, [1])
    let rp = tensorFull(dtypeComponent(complex_dtype), [2], 2.0)
    let rg = tensorZeros(dtypeComponent(complex_dtype), [2])
    let co = newAdamW([cp], 0.1, 0.8, 0.95, 0.00000001, 0.03)
    let ro = newAdamW([rp], 0.1, 0.8, 0.95, 0.00000001, 0.03)
    for step in 1..3 {
        let re = 0.001 * (step as float)
        let im = 1000.0 / (step as float)
        tensorSetComplex(cg, [0], re, im)
        tensorSet(rg, [0], re)
        tensorSet(rg, [1], im)
        optimizerStep(co, [cp], [cg])
        optimizerStep(ro, [rp], [rg])
        n += ck(tensorHex(cp) == tensorHex(rp), "complex matches paired-real parameters")
        n += ck(tensorHex(co.m[0]) == tensorHex(ro.m[0]), "independent first moments")
        n += ck(tensorHex(co.v[0]) == tensorHex(ro.v[0]), "independent second moments")
    }
    n += ck(co.step == 2, "Adam step count")
}

let cga = tensorFull(DType.F64, [1], 3.0)
let cgb = tensorZeros(DType.C64, [1])
tensorSetComplex(cgb, [0], 0.0, 4.0)
n += ck(clipGradientNorm([cga, cgb], 2.5) == 5.0, "preclip global norm")
n += ck(tensorGet(cga, [0]) == 1.5 and tensorGetImaginary(cgb, [0]) == 2.0, "joint common scaling")
let before_a = tensorHex(cga)
let before_b = tensorHex(cgb)
n += ck(clipGradientNorm([cga, cgb], 3.0) == 2.5, "under threshold norm")
n += ck(tensorHex(cga) == before_a and tensorHex(cgb) == before_b, "under threshold bit unchanged")
n += ck(clipGradientNorm([tensorZeros(DType.F64, [0])], 0.0) == 0.0, "empty clipping")

// Real + complex, single + double, scalar + empty, signed zero and NaN payload.
let scalar_shape: [int] = []
let round_params = [tensorFull(DType.F64, [1], 0.25), tensorFull(DType.C64, [2], 0.5), tensorFull(DType.F32, scalar_shape, 0.3), tensorFull(DType.C32, [2, 1], 0.7), tensorZeros(DType.F64, [0])]
round_params[1].storage.buffer.put64(0, 0 - 9223372036854775807 - 1)
round_params[1].storage.buffer.put64(8, 9221120237041090602)
round_params[3].storage.buffer.put32(4, 2143289386)
let round_o = newAdamW(round_params, 0.02, 0.8, 0.95, 0.000001, 0.03)
round_o.step = 17
checkpointSave("optim-good.ckpt", round_params, round_o)
let loaded = checkpointLoad("optim-good.ckpt")
n += ck(loaded.optimizer.step == 17 and loaded.optimizer.kind == 1, "checkpoint optimizer identity and count")
for i in 0..round_params.len() {
    n += ck(tensorHex(round_params[i]) == tensorHex(loaded.params[i]), "bit-exact tensor payload")
    n += ck(round_params[i].dtype == loaded.params[i].dtype and shapesEqual(round_params[i].shape, loaded.params[i].shape), "tensor descriptors")
    n += ck(tensorHex(round_o.m[i]) == tensorHex(loaded.optimizer.m[i]) and tensorHex(round_o.v[i]) == tensorHex(loaded.optimizer.v[i]), "bit-exact moments")
}
let initial_bytes = checkpointRead("optim-good.ckpt")
let initial_file = initial_bytes.getString(0, initial_bytes.size)

// Both optimizer families must continue bit-identically, including nonzero state.
for kind in 0..2 {
    let full = [tensorFull(DType.F64, [2], 0.4), tensorFull(DType.C64, [2], 0.6)]
    let split = [tensorCopy(full[0]), tensorCopy(full[1])]
    let fo = newOptimizer(full, kind, 0.02, 0.03, 0.6, 0.8, 0.95, 0.000001)
    let so = newOptimizer(split, kind, 0.02, 0.03, 0.6, 0.8, 0.95, 0.000001)
    for step in 0..6 { training_step(fo, full, step) }
    for step in 0..3 { training_step(so, split, step) }
    checkpointSave("optim-resume.ckpt", split, so)
    let resumed = checkpointLoad("optim-resume.ckpt")
    n += ck(resumed.optimizer.step == 3, "resume preserves step")
    let encoded_before = checkpointEncode(split, so)
    let encoded_after = checkpointEncode(resumed.params, resumed.optimizer)
    n += ck(encoded_before.getString(0, encoded_before.size) == encoded_after.getString(0, encoded_after.size), "all serialized optimizer settings exact")
    for step in 3..6 { training_step(resumed.optimizer, resumed.params, step) }
    for i in 0..2 {
        n += ck(tensorHex(full[i]) == tensorHex(resumed.params[i]), "resume parameters exact")
        n += ck(tensorHex(fo.m[i]) == tensorHex(resumed.optimizer.m[i]) and tensorHex(fo.v[i]) == tensorHex(resumed.optimizer.v[i]), "resume moments exact")
    }
    n += ck(resumed.optimizer.step == 6, "resume advances count")
}

// Descriptor-based updates and serialization also honor noncontiguous views.
let base = tensorFull(DType.F64, [2, 3], 1.0)
let view = tensorTranspose(base, 0, 1)
let vo = newSgd([view], 0.1, 0.0, 0.0)
optimizerStep(vo, [view], [tensorFull(DType.F64, [3, 2], 2.0)])
n += ck(tensorGet(base, [1, 2]) == 0.8, "optimizer updates view storage")
checkpointSave("optim-view.ckpt", [view], vo)
n += ck(tensorHex(checkpointLoad("optim-view.ckpt").params[0]) == tensorHex(tensorCopy(view)), "checkpoint logical view bytes")

// Direct integration: tape gradients are ordinary tensors, no tape ownership.
autogradReset()
let tp = tensorFull(DType.F64, [1], 2.0)
let tv = autogradLeaf(tp, true)
autogradBackward(autogradSumAll(autogradMultiply(tv, tv)))
let to = newSgd([tp], 0.1, 0.0, 0.0)
optimizerStep(to, [tp], [autogradGradient(tv)])
n += ck(near(tensorGet(tp, [0]), 1.6), "tape gradient integration")
autogradReset()

let messages = ["bad magic", "unknown version", "truncated file", "declared length exceeds file", "shape payload mismatch", "bad checksum", "implausibly large allocation"]
for i in 0..messages.len() { n += ck(rejects(i + 1, "checkpoint: {messages[i]}"), "distinct malformed checkpoint rejection") }
for mode in [11, 12, 14] { n += ck(rejects(mode, "checkpoint: implausibly large allocation"), "oversized metadata rejected before allocation") }
n += ck(rejects(13, "checkpoint: truncated file"), "truncated tensor descriptor")
n += ck(rejects(8, "checkpoint: write failed"), "partial write fails")
n += ck(readFile("optim-good.ckpt") == initial_file, "failed write preserves original bytes")
n += ck(tensorHex(checkpointLoad("optim-good.ckpt").params[1]) == tensorHex(round_params[1]), "original loads after failed write")
n += ck(rejects(9, "interrupted after header"), "interrupted partial write")
n += ck(readFile("optim-good.ckpt") == initial_file, "interrupted write preserves original bytes")
n += ck(checkpointLoad("optim-good.ckpt").optimizer.step == 17, "original loads after interruption")
let locked_name = cString("optim-good.ckpt")
let locked = win("CreateFileA", locked_name.address, 2147483648, 1, 0, 3, 128, 0)
n += ck(locked != 0 - 1, "lock target against rename")
n += ck(rejects(10, "checkpoint: atomic rename failed"), "failed atomic publication")
win("CloseHandle", locked)
n += ck(readFile("optim-good.ckpt") == initial_file, "failed rename preserves original bytes")
n += ck(checkpointLoad("optim-good.ckpt").optimizer.step == 17, "original loads after rename failure")
// Successful replacement must work too, not merely the failure paths.
round_o.step = 18
checkpointSave("optim-good.ckpt", round_params, round_o)
n += ck(checkpointLoad("optim-good.ckpt").optimizer.step == 18, "atomic replacement succeeds")
// Leave nothing behind. The interrupted-write cases abandon their temporary
// file on purpose -- that is the library behaving correctly under a crash --
// so the test must remove it, or one file accumulates in the working
// directory per run, forever.
fn unlink(name: str) {
    let b = cString(name)
    win("DeleteFileA", b.address)
}

for leftover in ["optim-good.ckpt", "optim-bad.ckpt", "optim-resume.ckpt", "optim-view.ckpt", "optim-child.log"] {
    unlink(leftover)
}
for pid in CHILD_PIDS {
    unlink("optim-good.ckpt.tmp.{pid}.1")
    unlink("optim-bad.ckpt.tmp.{pid}.1")
}

print("optim: {n} checks passed")


