var packed: [u8] = [1, 2, 3, 4, 5] as [u8]
var packedSum = 0
for i in 0..5 { packedSum += packed[i] * i }
assert(packedSum == 40)
var table: [int: int] = [0: 3, 1: 4, 2: 5, 3: 6]
var tableSum = 0
for i in 0..4 { tableSum += table[i] * i }
assert(tableSum == 32)
fn fill(values: [int], lo: int, hi: int, value: int) { for i in lo..hi { values[i] = value } }
for n in 0..20 {
    var output = zeros(n + 4)
    fill(output, 0, n + 4, 17)
    fill(output, 1, n + 1, 0x8000000000000000)
    assert(output[0] == 17)
    for i in 1..n + 1 { assert(output[i] == 0x8000000000000000) }
    for i in n + 1..n + 4 { assert(output[i] == 17) }
}
print("native loops: 231 weighted-sum goldens and fill/packed/map/empty checks passed")
