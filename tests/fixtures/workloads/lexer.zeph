// String-processing benchmark: generate deterministic source-code-like text
// (identifiers, keywords, numbers, string literals, operators, comments,
// whitespace), then tokenize it several times: classify bytes, cut substrings,
// push tokens with their kinds, and fold counts and a hash of every token.
// Usage: lexer [tokens]   (default 1000000)

var rngState = 12345

fn nextRandom() -> int {
    rngState = rngState * 6364136223846793005 + 1442695040888963407
    return (rngState >> 33) & 2147483647
}

enum TokenKind { Identifier, Keyword, Number, StringLiteral, Operator }

struct Token { kind: TokenKind, text: str }

let identifierCharacters = "abcdefghijklmnopqrstuvwxyz0123456789_"
let commentCharacters = "abcdefghijklmnopqrstuvwxyz "
let keywords = ["if", "else", "while", "fn", "return", "let", "var", "for"]
let operators = ["+", "-", "*", "/", "=", "==", "<", "<=", ">", ">=", "->", "(", ")", "\{", "\}", ",", "."]

fn appendText(buffer: [u8], text: str) {
    for character in text { buffer.push(character) }
}

fn generateSource(tokenCount: int) -> str {
    var buffer: [u8] = []
    for i in 0..tokenCount {
        let choice = nextRandom() % 10
        if choice < 3 {
            let length = nextRandom() % 8 + 1
            buffer.push('a' + nextRandom() % 26)
            for j in 1..length { buffer.push(identifierCharacters.byte(nextRandom() % 37)) }
        } else if choice == 3 {
            appendText(buffer, keywords[nextRandom() % 8])
        } else if choice < 6 {
            let length = nextRandom() % 6 + 1
            for j in 0..length { buffer.push('0' + nextRandom() % 10) }
        } else if choice < 8 {
            appendText(buffer, operators[nextRandom() % 17])
        } else if choice == 8 {
            let length = nextRandom() % 10
            buffer.push('"')
            for j in 0..length { buffer.push(identifierCharacters.byte(nextRandom() % 37)) }
            buffer.push('"')
        } else {
            let length = nextRandom() % 12
            appendText(buffer, "//")
            for j in 0..length { buffer.push(commentCharacters.byte(nextRandom() % 27)) }
            buffer.push('\n')
        }
        let separator = nextRandom() % 8
        if separator == 0 { buffer.push('\n') }
        else if separator == 1 { appendText(buffer, "  ") }
        else if separator > 2 { buffer.push(' ') }
    }
    return buffer as str
}

fn isLetter(character: int) -> bool {
    return ('a' <= character and character <= 'z') or ('A' <= character and character <= 'Z') or character == '_'
}

fn isDigit(character: int) -> bool {
    return '0' <= character and character <= '9'
}

fn isKeyword(word: str) -> bool {
    for keyword in keywords {
        if word == keyword { return true }
    }
    return false
}

var lineCount = 0
var commentCount = 0

fn tokenize(source: str) -> [Token] {
    var tokens: [Token] = []
    let length = source.len()
    var position = 0
    while position < length {
        let character = source.byte(position)
        if character == ' ' or character == '\t' or character == '\r' {
            position += 1
            continue
        }
        if character == '\n' {
            lineCount += 1
            position += 1
            continue
        }
        let start = position
        var kind = TokenKind.Operator
        if isLetter(character) {
            while position < length and (isLetter(source.byte(position)) or isDigit(source.byte(position))) { position += 1 }
            kind = TokenKind.Identifier
        } else if isDigit(character) {
            while position < length and isDigit(source.byte(position)) { position += 1 }
            kind = TokenKind.Number
        } else if character == '"' {
            position += 1
            while position < length and source.byte(position) != '"' { position += 1 }
            if position < length { position += 1 }
            kind = TokenKind.StringLiteral
        } else if character == '/' and position + 1 < length and source.byte(position + 1) == '/' {
            while position < length and source.byte(position) != '\n' { position += 1 }
            commentCount += 1
            continue
        } else {
            position += 1
            if position < length {
                let next = source.byte(position)
                if (next == '=' and (character == '=' or character == '<' or character == '>')) or (character == '-' and next == '>') {
                    position += 1
                }
            }
        }
        let text = source.sub(start, position)
        if kind == TokenKind.Identifier and isKeyword(text) { kind = TokenKind.Keyword }
        tokens.push(Token{kind: kind, text: text})
    }
    return tokens
}

var tokenCount = 1000000
if args().len() > 1 { tokenCount = args()[1] as int }
let passes = 3

let source = generateSource(tokenCount)
var checksum = 0
for pass in 0..passes {
    lineCount = 0
    commentCount = 0
    let tokens = tokenize(source)
    var kindCounts = [0, 0, 0, 0, 0]
    var hash = 0
    for token in tokens {
        let kindIndex = token.kind as int
        kindCounts[kindIndex] += 1
        hash = hash * 31 + kindIndex
        for character in token.text { hash = hash * 131 + character }
    }
    checksum = checksum * 31 + tokens.len()
    for kindTotal in kindCounts { checksum = checksum * 31 + kindTotal }
    checksum = checksum * 31 + lineCount
    checksum = checksum * 31 + commentCount
    checksum = checksum * 31 + hash
}
print(source.len(), checksum)
