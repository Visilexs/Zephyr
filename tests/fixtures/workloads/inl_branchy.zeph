// Inlining benchmark (branchy op on a constant selector): apply(op, a, b) is a
// 10-way if/else chain on op, called from 6 sites in the hot loop, each with a
// different literal op. Inlining lets the chain fold to the one live branch
// per site; called, every use walks the chain.
// Usage: inl_branchy [rounds]   (default 1000)

const valueMask = 1073741823

fn apply(op: int, a: int, b: int) -> int {
    var result = 0
    if op == 0 {
        result = a + b
    } else if op == 1 {
        result = a - b + 1073741824
    } else if op == 2 {
        result = (a & 65535) * (b & 16383)
    } else if op == 3 {
        result = a ^ b
    } else if op == 4 {
        result = (a & b) + ((a | b) >> 1)
    } else if op == 5 {
        result = a / ((b & 255) + 1)
    } else if op == 6 {
        result = a % ((b & 4095) + 1) + (b >> 12)
    } else if op == 7 {
        result = if a > b { a - b } else { b - a }
    } else if op == 8 {
        result = (a << (b & 7)) + (b >> 3)
    } else {
        let shift = (b & 15) + 1
        result = (a >> shift) | (a << (30 - shift))
    }
    return result & valueMask
}

var rngState = 12345

fn nextRandom() -> int {
    rngState = rngState * 6364136223846793005 + 1442695040888963407
    return (rngState >> 33) & 2147483647
}

const dataSize = 4096

fn run(data: [int], rounds: int) -> int {
    var total = 0
    for round in 0..rounds {
        var carry = round
        for i in 0..dataSize {
            let a = data[i] & valueMask
            let b = data[(i + round) & 4095] & valueMask
            var x = apply(2, a, b)
            x = apply(9, x, b)
            x = apply(4, x, carry)
            x = apply(7, a, x)
            carry = apply(3, carry, x)
            total = total + apply(0, x, carry)
        }
    }
    return total
}

var rounds = 1000
if args().len() > 1 { rounds = args()[1] as int }
var data: [int] = []
for i in 0..dataSize { data.push(nextRandom()) }
print(run(data, rounds))
