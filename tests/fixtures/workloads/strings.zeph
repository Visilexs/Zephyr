// Allocation / GC-churn benchmark: build N short formatted strings and sum
// their lengths. Exercises the allocator and the interpolation string builder.
// All three languages heap-allocate an owned string per iteration.
// Usage: strings [N]   (default 2000000)
var N = 2000000
if args().len() > 1 { N = args()[1] as int }

var acc = 0
for i in 0..N {
    let s = "item-{i}-{i * i % 1000}"
    acc += s.len()
}
print(acc)
