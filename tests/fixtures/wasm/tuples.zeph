// tuples: literals, types, t.0 access, destructuring, tuple map keys and patterns
fn divmod(a: int, b: int) -> (int, int) {
    return (a / b, a % b)
}
let pair = divmod(17, 5)
print(pair)
print("{pair.0} {pair.1}")
let (q, r) = divmod(23, 4)
print(q + r)
var (lo, hi) = (1, 10)
lo += 1
print("{lo} {hi}")
let nested = ((1, "a"), 2.5)
print(nested.0.1)
print(nested)
let scaled: (float, int) = (1, 2)
print(scaled)
var seen: [(int, int): str] = [:]
seen[(0, 0)] = "origin"
seen[(2, 3)] = "p"
print(seen[(2, 3)])
print((1, 2) == (1, 2))
print((1, "x") != (1, "y"))
let points = [(0, 1), (2, 3)]
var total = 0
for p in points { total += p.0 * p.1 }
print(total)
fn describe(p: (int, int)) -> str {
    return match p {
        (0, 0) { "origin" }
        else { "other" }
    }
}
print(describe((0, 0)) + " " + describe(pair))
let f: fn(int) -> (int, str) = fn(n: int) -> (int, str) { return (n * 2, "d") }
print(f(4))
