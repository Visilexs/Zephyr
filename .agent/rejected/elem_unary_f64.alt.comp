// Three-part pi/2 reduction and minimax polynomials target ~3e-16 absolute.
// ponytail: |x| <= 2^52; full-range Payne-Hanek reduction is needed beyond it.
// Return NaN outside that range rather than silently emit an incorrect phase.
dvec2 sincos64(double x) {
    if (isnan(x) || isinf(x) || abs(x) > 4503599627370496.0lf) {
        return dvec2(nan64());
    }
    if (x == 0.0lf) { return dvec2(x, 1.0lf); }
    double q = roundEven(x * 0.63661977236758134308lf);
    double r = fma(-q, PIO2_HI, x);
    r = fma(-q, PIO2_MID, r);
    r = fma(-q, PIO2_LO, r);
    // The rounded reciprocal can choose a neighboring quadrant at large x.
    if (r > PI * 0.25lf) {
        r = ((r - PIO2_HI) - PIO2_MID) - PIO2_LO;
        q += 1.0lf;
    } else if (r < -PI * 0.25lf) {
        r = ((r + PIO2_HI) + PIO2_MID) + PIO2_LO;
        q -= 1.0lf;
    }
    double z = r * r;
    double sp = 1.58969099521155010221e-10lf;
    sp = fma(sp, z, -2.50507602534068634195e-08lf);
    sp = fma(sp, z, 2.75573137070700676789e-06lf);
    sp = fma(sp, z, -1.98412698298579493134e-04lf);
    sp = fma(sp, z, 8.33333333332248946124e-03lf);
    sp = fma(sp, z, -1.66666666666666324348e-01lf);
    double sn = fma(r * z, sp, r);
    double cp = -1.13596475577881948265e-11lf;
    cp = fma(cp, z, 2.08757232129817482790e-09lf);
    cp = fma(cp, z, -2.75573143513906633035e-07lf);
    cp = fma(cp, z, 2.48015872894767294178e-05lf);
    cp = fma(cp, z, -1.38888888888741095749e-03lf);
    cp = fma(cp, z, 4.16666666666666019037e-02lf);
    double cs = fma(z * z, cp, fma(-0.5lf, z, 1.0lf));
    int quadrant = int(q - 4.0lf * floor(q * 0.25lf));
    if (quadrant == 0) { return dvec2(sn, cs); }
    if (quadrant == 1) { return dvec2(cs, -sn); }
    if (quadrant == 2) { return dvec2(-sn, -cs); }
    return dvec2(-cs, sn);
}

// Same absolute accuracy and range as sincos64; no float32 transcendental calls.
double sin64(double x) { return sincos64(x).x; }
double cos64(double x) { return sincos64(x).y; }

// Argument reduction to |r| <= 0.4375; fdlibm minimax targets a few ulps.
double atan64(double x) {
    if (isnan(x) || x == 0.0lf) { return x; }
    double r = abs(x);
    double hi = 0.0lf;
    double lo = 0.0lf;
    if (r >= 2.4375lf) {
        r = -1.0lf / r;
        hi = PIO2_HI;
        lo = PIO2_MID;
    } else if (r >= 1.1875lf) {
        r = (r - 1.5lf) / (1.0lf + 1.5lf * r);
        hi = 9.82793723247329054082e-01lf;
        lo = 1.39033110312309984516e-17lf;
    } else if (r >= 0.6875lf) {
        r = (r - 1.0lf) / (r + 1.0lf);
        hi = 7.85398163397448278999e-01lf;
        lo = 3.06161699786838301793e-17lf;
    } else if (r >= 0.4375lf) {
        r = (2.0lf * r - 1.0lf) / (2.0lf + r);
        hi = 4.63647609000806093515e-01lf;
        lo = 2.26987774529616870924e-17lf;
    }
    double z = r * r;
    double p = 1.62858201153657823623e-02lf;
    p = fma(p, z, -3.65315727442169155270e-02lf);
    p = fma(p, z, 4.97687799461593236017e-02lf);
    p = fma(p, z, -5.83357013379057348645e-02lf);
    p = fma(p, z, 6.66107313738753120669e-02lf);
    p = fma(p, z, -7.69187620504482999495e-02lf);
    p = fma(p, z, 9.09088713343650656196e-02lf);
    p = fma(p, z, -1.11111104054623557880e-01lf);
    p = fma(p, z, 1.42857142725034663711e-01lf);
    p = fma(p, z, -1.99999999998764832476e-01lf);
    p = fma(p, z, 3.33333333333329318027e-01lf);
    double result = hi - ((r * z * p - lo) - r);
    return copy_sign64(result, x);
}

// Targets a few ulps in radians; preserves signed-zero branch cuts/infinities.
double atan2_64(double y, double x) {
    if (isnan(x) || isnan(y)) { return x + y; }
    if (y == 0.0lf) { return negative64(x) ? copy_sign64(PI, y) : y; }
    if (x == 0.0lf) { return copy_sign64(PIO2_HI, y); }
    if (isinf(x) && isinf(y)) {
        return copy_sign64(negative64(x) ? 0.75lf * PI : 0.25lf * PI, y);
    }
    double ax = abs(x);
    double ay = abs(y);
    double angle = ay > ax ? PIO2_HI - (atan64(ax / ay) - PIO2_MID)
                           : atan64(ay / ax);
    if (negative64(x)) { angle = PI - angle; }
    return copy_sign64(angle, y);
}

// Targets a few ulps; expm1 prevents loss of the small odd component.
double sinh64(double x) {
    double ax = abs(x);
    if (ax < 1.0lf) {
        double t = expm1_64(ax);
        return copy_sign64(0.5lf * (t + t / (t + 1.0lf)), x);
    }
    double h = exp64(ax - LN2_HI - LN2_LO);
    return copy_sign64(h - 0.25lf / h, x);
}

// Targets a few ulps; subtract ln2 before exp to avoid premature overflow.
double cosh64(double x) {
    double ax = abs(x);
    if (ax < 1.0lf) {
        double t = expm1_64(ax);
        return 1.0lf + 0.5lf * t * (t / (t + 1.0lf));
    }
    double h = exp64(ax - LN2_HI - LN2_LO);
    return h + 0.25lf / h;
}

// Targets a few ulps, using the positive magnitude to avoid cancellation at -20.
double tanh64(double x) {
    if (abs(x) > 20.0lf) { return copy_sign64(1.0lf, x); }
    if (abs(x) < 1.0e-8lf) { return x; }
    double t = expm1_64(2.0lf * abs(x));
    return copy_sign64(t / (t + 2.0lf), x);
}

// Complex helpers target ~1e-14 relative away from zeros, poles and overflow.
dvec2 complex_exp64(dvec2 z) {
    dvec2 sc = sincos64(z.y);
    return exp64(z.x) * dvec2(sc.y, sc.x);
}

// Scaled magnitude is equivalent to 0.5*log(re^2+im^2), without squaring overflow.
dvec2 complex_log64(dvec2 z) {
    double hi = max(abs(z.x), abs(z.y));
    double lo = min(abs(z.x), abs(z.y));
    double magnitude;
    if (isnan(z.x) || isnan(z.y)) { magnitude = nan64(); }
    else if (hi == 0.0lf || isinf(hi)) { magnitude = log64(hi); }
    else {
        double ratio = lo / hi;
        magnitude = log64(hi) + 0.5lf * log64(1.0lf + ratio * ratio);
    }
    return dvec2(magnitude, atan2_64(z.y, z.x));
}

// Accuracy follows sincos64 and the hyperbolic helpers, away from overflow.
dvec2 complex_sin64(dvec2 z) {
    dvec2 sc = sincos64(z.x);
    return dvec2(sc.x * cosh64(z.y), sc.y * sinh64(z.y));
}

// Accuracy follows sincos64 and the hyperbolic helpers, away from overflow.
dvec2 complex_cos64(dvec2 z) {
    dvec2 sc = sincos64(z.x);
    return dvec2(sc.y * cosh64(z.y), -sc.x * sinh64(z.y));
}

// Equivalent double-angle formula; scaled for large re and stable near poles.
// Relative accuracy deteriorates at poles as expected for this conditioning.
dvec2 complex_tanh64(dvec2 z) {
    if (z.y == 0.0lf) { return dvec2(tanh64(z.x), z.y); }
    dvec2 sc = sincos64(z.y);
    double ax = abs(z.x);
    if (ax > 20.0lf) {
        double t = exp64(-2.0lf * ax);
        double denom = 1.0lf + t * t + 2.0lf * t * (sc.y * sc.y - sc.x * sc.x);
        return dvec2(copy_sign64((1.0lf - t * t) / denom, z.x),
                     4.0lf * t * sc.x * sc.y / denom);
    }
    double sh = sinh64(z.x);
    double denom = sh * sh + sc.y * sc.y;
    return dvec2(sh * cosh64(z.x) / denom, sc.x * sc.y / denom);
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.meta.y) { return; }
    bool ac = (pc.meta.w & 1u) != 0u;
    bool oc = (pc.meta.w & 4u) != 0u;
    uvec4 idx = output_index(gid);
    uint ia = double_index(idx, pc.astr, pc.offs.x, ac);
    uint ic = double_index(idx, pc.ostr, pc.offs.z, oc);
    dvec2 z = dvec2(a[ia], ac ? a[ia + 1u] : 0.0lf);
    dvec2 result = z;
    switch (pc.meta.z) {
        case 0u: result = ac ? complex_tanh64(z) : dvec2(tanh64(z.x), 0.0lf); break;
        case 1u: result = ac ? complex_cos64(z) : dvec2(cos64(z.x), 0.0lf); break;
        case 2u: result = ac ? complex_sin64(z) : dvec2(sin64(z.x), 0.0lf); break;
        case 3u: result = ac ? complex_exp64(z) : dvec2(exp64(z.x), 0.0lf); break;
        case 4u: result = ac ? complex_log64(z) : dvec2(log64(z.x), 0.0lf); break;
        case 5u: result = dvec2(0.0lf) - z; break;
        case 6u: result = dvec2(z.x * z.x + z.y * z.y, 0.0lf); break;
        case 7u: result = dvec2(z.x, 0.0lf - z.y); break;
        case 8u: result = dvec2(z.x, 0.0lf); break;
        case 9u: result = dvec2(z.y, 0.0lf); break;
        case 10u: result = sincos64(z.x).yx; break;
        case 11u: break; // The independent load/store flags implement both casts.
        case 12u: break;
    }
    c[ic] = result.x;
    if (oc) { c[ic + 1u] = result.y; }
}
