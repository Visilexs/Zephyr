#version 450
// Strided float64 unary operations. Input/output complex flags are independent.
#extension GL_ARB_gpu_shader_fp64 : enable
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer BufA { double a[]; };
layout(std430, binding = 1) writeonly buffer BufC { double c[]; };
layout(push_constant) uniform Push {
    uvec4 meta;    // rank, output numel, operation, complex flags (A/B/out)
    uvec4 oshape;
    uvec4 astr;
    uvec4 bstr;
    uvec4 ostr;
    uvec4 offs;    // A, B, output offsets; w unused
} pc;

// Decode the row-major logical index, ignoring all axes beyond rank.
uvec4 output_index(uint linear) {
    uvec4 idx = uvec4(0u);
    for (int d = int(pc.meta.x) - 1; d >= 0; --d) {
        idx[d] = linear % pc.oshape[d];
        linear /= pc.oshape[d];
    }
    return idx;
}

// Convert an element position to a double position; zero strides broadcast.
uint double_index(uvec4 idx, uvec4 strides, uint offset, bool is_complex) {
    for (uint d = 0u; d < pc.meta.x; ++d) { offset += idx[d] * strides[d]; }
    return is_complex ? 2u * offset : offset;
}

const double LN2_HI = 0.693147180559945286lf;
const double LN2_LO = 2.319046813846299558e-17lf;
const double PI = 3.141592653589793238462643383279502884lf;
const double PIO2_HI = 1.57079632679489655800lf;
const double PIO2_MID = 6.12323399573676603587e-17lf;
const double PIO2_LO = -1.49738490485916983294e-33lf;

double nan64() { return packDouble2x32(uvec2(0u, 0x7ff80000u)); }
double inf64() { return packDouble2x32(uvec2(0u, 0x7ff00000u)); }
bool negative64(double x) { return (unpackDouble2x32(x).y & 0x80000000u) != 0u; }
double copy_sign64(double x, double y) { return negative64(y) ? -abs(x) : abs(x); }

// Exact normal power of two; caller keeps e in [-1022, 1023].
double pow2_64(int e) { return packDouble2x32(uvec2(0u, uint(e + 1023) << 20)); }

// Degree-16 Taylor remainder < 1e-22 on |r| <= ln(2)/2; avoids exp(r)-1.
double expm1_reduced64(double r) {
    double p = 1.0lf;
    for (int n = 16; n >= 2; --n) { p = fma(p, r / double(n), 1.0lf); }
    return r * p;
}

// Targets a few ulps for finite normal results; retains gradual underflow.
double exp64(double x) {
    if (isnan(x)) { return x; }
    if (x > 709.782712893383973096lf) { return inf64(); }
    if (x < -745.13321910194110842lf) { return 0.0lf; }
    int k = int(roundEven(x / LN2_HI));
    double r = fma(-double(k), LN2_HI, x);
    r = fma(-double(k), LN2_LO, r);
    double p = 1.0lf + expm1_reduced64(r);
    if (k > 1023) { return (p * 2.0lf) * pow2_64(k - 1); }
    if (k < -1022) { return (p * pow2_64(k + 54)) * pow2_64(-54); }
    return p * pow2_64(k);
}

// Targets a few ulps, including small x where subtraction from one loses digits.
double expm1_64(double x) {
    if (abs(x) <= 0.34657359027997265471lf) { return expm1_reduced64(x); }
    return exp64(x) - 1.0lf;
}

// Atanh series through s^23: truncation < 2e-21 on the reduced interval.
// Full result targets a few ulps, with explicit zero/negative/NaN handling.
double log64(double x) {
    if (isnan(x)) { return x; }
    if (x == 0.0lf) { return -inf64(); }
    if (x < 0.0lf) { return nan64(); }
    if (isinf(x)) { return x; }
    int e;
    double m = frexp(x, e);
    if (m < 0.70710678118654752440lf) { m *= 2.0lf; --e; }
    double s = (m - 1.0lf) / (m + 1.0lf);
    double z = s * s;
    double p = 1.0lf / 23.0lf;
    for (int n = 21; n >= 3; n -= 2) { p = fma(p, z, 1.0lf / double(n)); }
    double lm = 2.0lf * fma(s * z, p, s);
    return fma(double(e), LN2_HI, fma(double(e), LN2_LO, lm));
}

