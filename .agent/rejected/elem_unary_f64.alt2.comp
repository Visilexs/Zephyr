#version 450
// Elementwise unary map on strided float64 tensors.
//
// Bindings 0 = in, 1 = out. Operand strides come from pc.astr / pc.offs.x,
// output strides from pc.ostr / pc.offs.z. pc.meta.z is the op; codes 0..4
// are the MAP_ constants in lib/ml/ops.zeph and must not be renumbered.
//
//   0 tanh   1 cos    2 sin    3 exp    4 ln    5 neg    6 abs2   7 conj
//   8 real   9 imag  10 expi  11 cast  12 copy
//
// The complex bits in pc.meta.w are independent on purpose: ops 6, 8 and 9
// take a complex input and produce a REAL output, op 10 takes a real input
// and produces a COMPLEX one, and op 11 converts either way. Bit 0 is read
// as "the input buffer is interleaved", bit 2 as "the output buffer is
// interleaved", and neither is inferred from the other. (Bit 1 is operand B
// and is unused in this kernel.)
//
// Strides and offsets are in ELEMENTS, not doubles: a complex element is an
// interleaved re,im pair, so its double index is twice the element index --
// the same layout as examples/shaders/matmul_c64.comp. A zero stride is a
// broadcast axis and is not special-cased: it simply makes every index along
// that axis land on the same element.
//
// The tanh/cos/sin/exp/log/atan built-ins in GLSL are float32 only, so the
// block below implements them for double. Computing in float and widening
// would lose ten significant digits; nothing here touches the float type.
#extension GL_ARB_gpu_shader_fp64 : enable
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly  buffer BufA { double a[]; };
layout(std430, binding = 1) writeonly buffer BufO { double o[]; };
layout(push_constant) uniform Push {
    uvec4 meta;    // x = rank, y = numel (output elements), z = op, w = flags
    uvec4 oshape;  // output shape, unused trailing entries are 1
    uvec4 astr;    // strides of the operand, in elements
    uvec4 bstr;    // unused in this kernel
    uvec4 ostr;    // strides of the output, in elements
    uvec4 offs;    // x = operand offset, z = output offset, y/w unused
} pc;

// ---- shared index helpers --------------------------------------------------

// Linear output index -> 4-component index vector, row-major (last axis
// fastest). Entries at or beyond pc.meta.x stay 0; the caller sets those
// shapes to 1 and their strides to 0, so they never contribute.
uvec4 out_index(uint lin) {
    uvec4 idx = uvec4(0u);
    for (uint d = pc.meta.x; d > 0u; --d) {
        uint s = pc.oshape[d - 1u];
        idx[d - 1u] = lin % s;
        lin /= s;
    }
    return idx;
}

// Index vector + strides + offset -> index into the double[] buffer. Doubles
// the element index for complex tensors, which is where the interleaving is
// accounted for exactly once.
uint buf_index(uvec4 idx, uvec4 str, uint off, bool cplx) {
    uint e = off;
    for (uint d = 0u; d < pc.meta.x; ++d) { e += idx[d] * str[d]; }
    return cplx ? 2u * e : e;
}

// All arithmetic below is float64. Error targets include rounding, not just
// polynomial truncation; GPU validation compares against System.Math/Complex.
const double LN2_HI = 0.693147180559945286lf;
const double LN2_LO = 2.319046813846299558e-17lf;
const double PI = 3.141592653589793238462643383279502884lf;
const double HALF_PI = 1.57079632679489655800lf;
const double PIO2_MID = 6.12323399573676603587e-17lf;
const double PIO2_LO = -1.49738490485916983294e-33lf;

double d_nan() { return packDouble2x32(uvec2(0u, 0x7ff80000u)); }
double d_inf() { return packDouble2x32(uvec2(0u, 0x7ff00000u)); }
bool signbit_f64(double x) { return (unpackDouble2x32(x).y & 0x80000000u) != 0u; }
double copysign_f64(double x, double y) { return signbit_f64(y) ? -abs(x) : abs(x); }

// Exact normal power of two; callers keep e in [-1022, 1023].
double pow2_f64(int e) { return packDouble2x32(uvec2(0u, uint(e + 1023) << 20)); }

// Degree 16: omitted term < 1e-22 for |r| <= ln(2)/2. Factoring r avoids
// cancellation near zero; floating-point evaluation targets a few ulps.
double expm1_poly(double r) {
    double p = 1.0lf;
    for (int n = 16; n >= 2; --n) { p = fma(p, r / double(n), 1.0lf); }
    return r * p;
}

// Targets a few ulps for normal results, with explicit overflow/underflow.
double exp_f64(double x) {
    if (isnan(x)) { return x; }
    if (x > 709.782712893383973096lf) { return d_inf(); }
    if (x < -745.13321910194110842lf) { return 0.0lf; }
    int k = int(roundEven(x / LN2_HI));
    // precise makes the explicit fma reductions single-rounding operations.
    precise double r = fma(-double(k), LN2_HI, x);
    r = fma(-double(k), LN2_LO, r);
    double p = 1.0lf + expm1_poly(r);
    if (k > 1023) { return (p * 2.0lf) * pow2_f64(k - 1); }
    if (k < -1022) { return (p * pow2_f64(k + 54)) * pow2_f64(-54); }
    return p * pow2_f64(k);
}

// Targets a few ulps, including small x where exp(x)-1 loses digits.
double expm1_f64(double x) {
    if (abs(x) <= 0.34657359027997265471lf) { return expm1_poly(x); }
    return exp_f64(x) - 1.0lf;
}

// Atanh series through s^23: truncation < 2e-21 on the reduced interval.
// Complete log targets a few ulps; frexp also handles subnormal inputs.
double log_f64(double x) {
    if (isnan(x)) { return x; }
    if (x == 0.0lf) { return -d_inf(); }
    if (x < 0.0lf) { return d_nan(); }
    if (isinf(x)) { return x; }
    int e;
    double m = frexp(x, e);
    if (m < 0.70710678118654752440lf) { m *= 2.0lf; --e; }
    double s = (m - 1.0lf) / (m + 1.0lf);
    double w = s * s;
    double p = 1.0lf / 23.0lf;
    for (int n = 21; n >= 3; n -= 2) { p = fma(p, w, 1.0lf / double(n)); }
    double lm = 2.0lf * fma(s * w, p, s);
    return fma(double(e), LN2_HI, fma(double(e), LN2_LO, lm));
}

/* Sine/cosine/atan minimax coefficients are from fdlibm:
 * https://netlib.org/fdlibm/{k_sin.c,k_cos.c,s_atan.c}
