// Three-part pi/2 reduction and minimax polynomials target ~3e-16 absolute.
// ponytail: |x| <= 2^52; full-range Payne-Hanek reduction is needed beyond it.
// Return NaN outside that range rather than silently emit an incorrect phase.
void sincos_f64(double x, out double sn, out double cs) {
    if (isnan(x) || isinf(x) || abs(x) > 4503599627370496.0lf) {
        sn = d_nan(); cs = d_nan(); return;
    }
    if (x == 0.0lf) { sn = x; cs = 1.0lf; return; }
    double n = roundEven(x * 0.63661977236758134308lf);
    precise double r = fma(-n, HALF_PI, x);
    r = fma(-n, PIO2_MID, r);
    r = fma(-n, PIO2_LO, r);
    // The rounded reciprocal can choose a neighboring quadrant at large x.
    if (r > PI * 0.25lf) {
        r = ((r - HALF_PI) - PIO2_MID) - PIO2_LO; n += 1.0lf;
    } else if (r < -PI * 0.25lf) {
        r = ((r + HALF_PI) + PIO2_MID) + PIO2_LO; n -= 1.0lf;
    }
    double w = r * r;
    double sp = 1.58969099521155010221e-10lf;
    sp = fma(sp, w, -2.50507602534068634195e-08lf);
    sp = fma(sp, w, 2.75573137070700676789e-06lf);
    sp = fma(sp, w, -1.98412698298579493134e-04lf);
    sp = fma(sp, w, 8.33333333332248946124e-03lf);
    sp = fma(sp, w, -1.66666666666666324348e-01lf);
    sn = fma(r * w, sp, r);
    double cp = -1.13596475577881948265e-11lf;
    cp = fma(cp, w, 2.08757232129817482790e-09lf);
    cp = fma(cp, w, -2.75573143513906633035e-07lf);
    cp = fma(cp, w, 2.48015872894767294178e-05lf);
    cp = fma(cp, w, -1.38888888888741095749e-03lf);
    cp = fma(cp, w, 4.16666666666666019037e-02lf);
    cs = fma(w * w, cp, fma(-0.5lf, w, 1.0lf));
    int q = int(n - 4.0lf * floor(n * 0.25lf));
    double s = sn;
    if (q == 1) { sn = cs; cs = -s; }
    else if (q == 2) { sn = -sn; cs = -cs; }
    else if (q == 3) { sn = -cs; cs = s; }
}

// Same accuracy and range as sincos_f64.
double sin_f64(double x) { double s; double c; sincos_f64(x, s, c); return s; }
double cos_f64(double x) { double s; double c; sincos_f64(x, s, c); return c; }

// Argument reduction to |r| <= 0.4375; fdlibm minimax targets a few ulps.
double atan_f64(double x) {
    if (isnan(x) || x == 0.0lf) { return x; }
    double r = abs(x);
    double hi = 0.0lf;
    double lo = 0.0lf;
    if (r >= 2.4375lf) {
        r = -1.0lf / r; hi = HALF_PI; lo = PIO2_MID;
    } else if (r >= 1.1875lf) {
        r = (r - 1.5lf) / (1.0lf + 1.5lf * r);
        hi = 9.82793723247329054082e-01lf; lo = 1.39033110312309984516e-17lf;
    } else if (r >= 0.6875lf) {
        r = (r - 1.0lf) / (r + 1.0lf);
        hi = 7.85398163397448278999e-01lf; lo = 3.06161699786838301793e-17lf;
    } else if (r >= 0.4375lf) {
        r = (2.0lf * r - 1.0lf) / (2.0lf + r);
        hi = 4.63647609000806093515e-01lf; lo = 2.26987774529616870924e-17lf;
    }
    double w = r * r;
    double p = 1.62858201153657823623e-02lf;
    p = fma(p, w, -3.65315727442169155270e-02lf);
    p = fma(p, w, 4.97687799461593236017e-02lf);
    p = fma(p, w, -5.83357013379057348645e-02lf);
    p = fma(p, w, 6.66107313738753120669e-02lf);
    p = fma(p, w, -7.69187620504482999495e-02lf);
    p = fma(p, w, 9.09088713343650656196e-02lf);
    p = fma(p, w, -1.11111104054623557880e-01lf);
    p = fma(p, w, 1.42857142725034663711e-01lf);
    p = fma(p, w, -1.99999999998764832476e-01lf);
    p = fma(p, w, 3.33333333333329318027e-01lf);
    return copysign_f64(hi - ((r * w * p - lo) - r), x);
}

// Targets a few ulps in radians, including signed-zero branch cuts/infinities.
double atan2_f64(double y, double x) {
    if (isnan(x) || isnan(y)) { return x + y; }
    if (y == 0.0lf) { return signbit_f64(x) ? copysign_f64(PI, y) : y; }
    if (x == 0.0lf) { return copysign_f64(HALF_PI, y); }
    if (isinf(x) && isinf(y)) {
        return copysign_f64(signbit_f64(x) ? 0.75lf * PI : 0.25lf * PI, y);
    }
    double ax = abs(x);
    double ay = abs(y);
    double angle = ay > ax ? HALF_PI - (atan_f64(ax / ay) - PIO2_MID)
                           : atan_f64(ay / ax);
    if (signbit_f64(x)) { angle = PI - angle; }
    return copysign_f64(angle, y);
}

// Targets a few ulps; use the magnitude so negative x cannot cancel t+2.
double tanh_f64(double x) {
    if (abs(x) > 20.0lf) { return copysign_f64(1.0lf, x); }
    if (abs(x) < 1.0e-8lf) { return x; }
    double t = expm1_f64(2.0lf * abs(x));
    return copysign_f64(t / (t + 2.0lf), x);
}

// Targets a few ulps; expm1 retains small x, half-exponents delay overflow.
double sinh_f64(double x) {
    double ax = abs(x);
    if (ax < 1.0lf) {
        double t = expm1_f64(ax);
        return copysign_f64(0.5lf * (t + t / (t + 1.0lf)), x);
    }
    precise double h = exp_f64(ax * 0.5lf);
    h = (0.5lf * h) * h;
    return copysign_f64(h - 0.25lf / h, x);
}

// Targets a few ulps; positive terms avoid cancellation.
double cosh_f64(double x) {
    double ax = abs(x);
    if (ax < 1.0lf) {
        double t = expm1_f64(ax);
        return 1.0lf + 0.5lf * t * (t / (t + 1.0lf));
    }
    precise double h = exp_f64(ax * 0.5lf);
    h = (0.5lf * h) * h;
    return h + 0.25lf / h;
}

// Complex helpers target ~1e-14 relative away from zeros, poles and overflow.
dvec2 complex_exp_f64(dvec2 z) {
    double s; double c; sincos_f64(z.y, s, c);
    return exp_f64(z.x) * dvec2(c, s);
}

// Equivalent to 0.5*log(re^2+im^2), scaled to avoid squaring overflow.
// Targets ~1e-14 absolute in each component away from the branch cut.
dvec2 complex_log_f64(dvec2 z) {
    double hi = max(abs(z.x), abs(z.y));
    double lo = min(abs(z.x), abs(z.y));
    double magnitude;
    if (isnan(z.x) || isnan(z.y)) { magnitude = d_nan(); }
    else if (hi == 0.0lf || isinf(hi)) { magnitude = log_f64(hi); }
    else {
        double ratio = lo / hi;
        magnitude = log_f64(hi) + 0.5lf * log_f64(1.0lf + ratio * ratio);
    }
    return dvec2(magnitude, atan2_f64(z.y, z.x));
}

// Accuracy follows sincos_f64 and the hyperbolic helpers, away from overflow.
dvec2 complex_sin_f64(dvec2 z) {
    double s; double c; sincos_f64(z.x, s, c);
    return dvec2(s * cosh_f64(z.y), c * sinh_f64(z.y));
}

// Accuracy follows sincos_f64 and the hyperbolic helpers, away from overflow.
dvec2 complex_cos_f64(dvec2 z) {
    double s; double c; sincos_f64(z.x, s, c);
    return dvec2(c * cosh_f64(z.y), -s * sinh_f64(z.y));
}

// Equivalent double-angle formula, scaled for large re and stable near poles.
// Relative accuracy necessarily deteriorates close to the poles.
dvec2 complex_tanh_f64(dvec2 z) {
    if (z.y == 0.0lf) { return dvec2(tanh_f64(z.x), z.y); }
    double s; double c; sincos_f64(z.y, s, c);
    double ax = abs(z.x);
    if (ax > 20.0lf) {
        double t = exp_f64(-2.0lf * ax);
        double den = 1.0lf + t * t + 2.0lf * t * (c * c - s * s);
        return dvec2(copysign_f64((1.0lf - t * t) / den, z.x), 4.0lf * t * s * c / den);
    }
    double sh = sinh_f64(z.x);
    double den = sh * sh + c * c;
    return dvec2(sh * cosh_f64(z.x) / den, s * c / den);
}

// One invocation owns one logical output element.
void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.meta.y) { return; }
    bool ac = (pc.meta.w & 1u) != 0u;
    bool oc = (pc.meta.w & 4u) != 0u;
    uvec4 idx = out_index(gid);
    uint ia = buf_index(idx, pc.astr, pc.offs.x, ac);
    uint io = buf_index(idx, pc.ostr, pc.offs.z, oc);
    dvec2 z = dvec2(a[ia], ac ? a[ia + 1u] : 0.0lf);
    dvec2 result = z;
    switch (pc.meta.z) {
        case 0u: result = ac ? complex_tanh_f64(z) : dvec2(tanh_f64(z.x), 0.0lf); break;
        case 1u: result = ac ? complex_cos_f64(z) : dvec2(cos_f64(z.x), 0.0lf); break;
        case 2u: result = ac ? complex_sin_f64(z) : dvec2(sin_f64(z.x), 0.0lf); break;
        case 3u: result = ac ? complex_exp_f64(z) : dvec2(exp_f64(z.x), 0.0lf); break;
        case 4u: result = ac ? complex_log_f64(z) : dvec2(log_f64(z.x), 0.0lf); break;
        case 5u: result = dvec2(0.0lf) - z; break;
        case 6u: result = dvec2(z.x * z.x + z.y * z.y, 0.0lf); break;
        case 7u: result = dvec2(z.x, 0.0lf - z.y); break;
        case 8u: result = dvec2(z.x, 0.0lf); break;
        case 9u: result = dvec2(z.y, 0.0lf); break;
        case 10u: sincos_f64(z.x, result.y, result.x); break;
        case 11u: break; // Independent load/store flags implement both casts.
        case 12u: break;
    }
    o[io] = result.x;
    if (oc) { o[io + 1u] = result.y; }
}

