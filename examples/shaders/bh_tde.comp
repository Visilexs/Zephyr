#version 450

// Tidal disruption event: the accretion flow, plus a star being pulled apart.
//
// Particles [0, ndisc) are the accretion disc, as before. Particles
// [ndisc, N) are the STAR: they feel the hole's gravity plus a self-gravity
// pull toward the star's centre of mass, softened inside the stellar radius.
//
// That is all the disruption needs. The hole's tidal field across the star
// grows as 2GM R*/r^3 while self-gravity stays at GM*/R*^2, so the star holds
// together until those balance and then comes apart on its own -- at the tidal
// radius r_t = R*(M_BH/M*)^(1/3), with no scripted "now shatter" event. Half
// the debris ends up bound and falls back, half is unbound and escapes, which
// is what produces the long stream and the classic t^(-5/3) fallback.
//
// Everything then deposits into the same polar density grid the geodesic
// ray-tracer samples, so the stream is gravitationally lensed like the disc.

layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer Parts { vec4 P[]; };
layout(std430, binding = 1) buffer Grid  { uint G[]; };
layout(std430, binding = 2) readonly buffer Star { float S[]; };
//  S[0..2] star centre of mass      S[3]  stellar radius R*
//  S[4]    GM* (geometrized)        S[5]  disrupted flag
//  S[6]    ndisc split index        S[7]  reseed flag
//  S[8..10] centre-of-mass velocity S[11] disc injection outer radius

layout(push_constant) uniform PC {
    vec4 eye;    // xyz camera, w time
    vec4 right;  vec4 up;  vec4 fwd;    // basis, fwd.w = frame
    vec4 disc;   // r_isco, r_grid_out, T_scale, exposure
    vec4 dims;   // W, H, NR, NPHI
    vec4 phys;   // alpha, H/R, turbulence, dt
    vec4 misc;   // r_horizon, r_escape, count, T_ref
} pc;

const float M = 1.0;
const float TAU = 6.28318530718;

uint hash(uint h) { h ^= h >> 16; h *= 0x7feb352du; h ^= h >> 15; h *= 0x846ca68bu; h ^= h >> 16; return h; }
float rnd(inout uint s) { s = s * 1664525u + 1013904223u; return float((s >> 8) & 0xFFFFFFu) / 16777216.0; }

float h31(vec3 p) { return fract(sin(dot(p, vec3(127.1, 311.7, 74.7))) * 43758.5453); }
float vn(vec3 x) {
    vec3 i = floor(x); vec3 f = fract(x);
    f = f * f * (3.0 - 2.0 * f);
    float a = mix(h31(i + vec3(0,0,0)), h31(i + vec3(1,0,0)), f.x);
    float b = mix(h31(i + vec3(0,1,0)), h31(i + vec3(1,1,0)), f.x);
    float c = mix(h31(i + vec3(0,0,1)), h31(i + vec3(1,0,1)), f.x);
    float d = mix(h31(i + vec3(0,1,1)), h31(i + vec3(1,1,1)), f.x);
    return mix(mix(a, b, f.y), mix(c, d, f.y), f.z);
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint N = uint(pc.misc.z);
    if (i >= N) return;

    float dt    = pc.phys.w;
    float rhor  = pc.misc.x;
    float resc  = pc.misc.y;
    float risco = pc.disc.x;
    float rgrid = pc.disc.y;
    float alpha = pc.phys.x;
    float hr    = pc.phys.y;
    float turb  = pc.phys.z;
    float frame = pc.fwd.w;

    vec3 com   = vec3(S[0], S[1], S[2]);
    float Rst  = S[3];
    float GMst = S[4];
    bool  torn = S[5] > 0.5;
    uint  ndisc = uint(S[6]);
    bool  reseed = S[7] > 0.5;
    vec3  comv = vec3(S[8], S[9], S[10]);
    float rinj = S[11];

    bool isStar = (i >= ndisc);

    vec3 p = P[2u * i].xyz;
    vec3 v = P[2u * i + 1u].xyz;
    uint s = hash(i ^ hash(uint(frame)));

    float r = length(p);

    if (isStar) {
        if (reseed || frame < 0.5) {
            // a uniform-density ball of gas moving with the star
            vec3 dir = normalize(vec3(rnd(s), rnd(s), rnd(s)) * 2.0 - 1.0 + vec3(1e-5));
            p = com + dir * Rst * pow(rnd(s), 0.3333333);
            v = comv;
        } else {
            vec3 rh = p / max(r, 1e-4);
            float rr = max(r - rhor, 0.05);
            v -= rh * (M / (rr * rr)) * dt;             // the hole
            if (!torn) {
                // self-gravity of a uniform sphere: linear inside, 1/d^2 outside
                vec3 dvec = com - p;
                float d = length(dvec);
                float acc = (d < Rst) ? (GMst * d / (Rst * Rst * Rst))
                                      : (GMst / max(d * d, 1e-8));
                v += normalize(dvec + vec3(1e-9)) * acc * dt;
            }
            p += v * dt;
            // debris that crosses the horizon is parked, not recycled: a star
            // is consumed once. Tested on the NEW position -- testing the old
            // one destroyed the star on the frame it was seeded, because the
            // buffer is uninitialised and reads as r = 0.
            if (length(p) < rhor * 1.08) { p = vec3(0.0, 1e6, 0.0); v = vec3(0.0); }
        }
    } else {
        if (frame < 0.5 || r < rhor * 1.08 || r > resc) {
            float rad = sqrt(mix(risco * risco, rinj * rinj, rnd(s)));
            float a = rnd(s) * TAU;
            float ca = cos(a), sa = sin(a);
            p = vec3(ca * rad, hr * rad * (rnd(s) + rnd(s) - 1.0), sa * rad);
            v = vec3(-sa, 0.0, ca) * (sqrt(M * rad) / (rad - rhor));
        } else {
            vec3 rh = p / r;
            float Om = sqrt(M / (r * r * r));
            float rr = max(r - rhor, 0.05);
            v -= rh * (M / (rr * rr)) * dt;
            vec3 vt = v - rh * dot(v, rh);
            v -= vt * (0.5 * alpha * hr * hr * Om * dt);
            if (r > risco) {
                float cs = hr * sqrt(M / r);
                float f = clamp(Om * dt, 0.0, 0.5);
                float dv = turb * sqrt(alpha) * cs * f;
                vec3 xn = p / max(hr * r, 0.5);
                float tt = pc.eye.w * 0.35;
                vec3 kick = vec3(vn(xn + vec3(tt, 0.0, 0.0)),
                                 vn(xn + vec3(0.0, tt, 11.3)),
                                 vn(xn + vec3(5.2, 0.0, tt))) * 2.0 - 1.0;
                vec3 ph = normalize(vec3(-p.z, 0.0, p.x));
                kick -= ph * dot(kick, ph);
                v += kick * dv;
                vec3 Rh = vec3(p.x, 0.0, p.z);
                float Rl = length(Rh);
                if (Rl > 0.001) {
                    Rh /= Rl;
                    v -= Rh * (dot(v, Rh) * f);
                    v.y -= v.y * f;
                }
            }
            p += v * dt;
        }
    }
    float sp = length(v);
    if (sp > 0.99) v *= 0.99 / sp;

    P[2u * i]      = vec4(p, 0.0);
    P[2u * i + 1u] = vec4(v, 0.0);

    // ---- deposit into the polar grid ----
    float rp = length(vec2(p.x, p.z));
    if (rp >= rgrid || rp < 0.25) return;
    float ang = atan(p.z, p.x);
    if (ang < 0.0) ang += TAU;
    uint NR = uint(pc.dims.z), NPHI = uint(pc.dims.w);
    uint ir = uint(clamp(rp / rgrid * float(NR), 0.0, float(NR) - 1.0));
    uint ip = uint(clamp(ang / TAU * float(NPHI), 0.0, float(NPHI) - 1.0));
    atomicAdd(G[ir * NPHI + ip], 1u);
}
