#version 450
// Primary-ray voxel tracer. The grid is the acceleration structure: one
// Amanatides-Woo walk resolves visibility, no BVH and no mesh. Ported from
// trace.frag.glsl in the C# reference, minus lighting and accumulation --
// this step only has to prove traversal and the two-image binding.
//
// Kept deterministic on purpose: examples/vulkan/voxel.zeph walks the same
// algorithm on the CPU and compares every pixel, which only works if there
// is no RNG in here.

layout(local_size_x = 8, local_size_y = 8) in;
layout(r8ui,  binding = 0) uniform readonly uimage3D vol;
layout(rgba8, binding = 1) uniform writeonly image2D dst;
// Guide buffers. Ray Reconstruction consumes depth, normals and albedo
// alongside the noisy colour, so they are produced here rather than bolted
// on later. Depth is linear ray t, not a projected z.
layout(r32f,  binding = 2) uniform writeonly image2D gDepth;
layout(rgba8, binding = 3) uniform writeonly image2D gNormal;
layout(rgba8, binding = 4) uniform writeonly image2D gAlbedo;
// Motion is signed and can exceed a pixel, so it needs a float format rather
// than the 8-bit ones above.
layout(rgba16f, binding = 5) uniform writeonly image2D gMotion;
layout(rgba8,   binding = 6) uniform writeonly image2D gRough;   // r = roughness, g = specular

layout(push_constant) uniform P {
    ivec4 volSize;   // xyz
    ivec4 res;       // xy = resolution, z = spp, w = frame index
    vec4  camPos;    // xyz
    vec4  right;
    vec4  up;
    vec4  fwd;
    vec4  misc;      // x = tanHalfFov, y = sun.x, z = sun.y, w = sun.z
    // Previous frame, for motion vectors. On the first frame these equal the
    // current ones, which makes every motion vector zero.
    vec4  prevCamPos;
    vec4  prevRight;
    vec4  prevUp;
    vec4  prevFwd;
    // xy = subpixel offset in pixels, already Halton.
    // z  = world units per voxel. The DDA steps whole cells, so traversal runs
    //      in voxel space: the ray origin is divided by this and the resulting
    //      t multiplied back. Everything leaving this shader, depth and motion
    //      included, is in world units.
    vec4  jitter;
} pc;

// ---------------------------------------------------------------- rng
// Exactly the hash from trace.frag.glsl. It is mirrored bit-for-bit in
// voxel.zeph with 32-bit masking, which is what keeps the CPU comparison
// exact even though the shading is now stochastic.
uint gSeed;
uint hashu(uint x)
{
    x ^= x >> 16; x *= 0x7feb352du;
    x ^= x >> 15; x *= 0x846ca68bu;
    x ^= x >> 16; return x;
}
float rnd()
{
    gSeed = hashu(gSeed);
    return float(gSeed) * (1.0 / 4294967296.0);
}

// Cosine-weighted hemisphere by Malley's method, with the disk sampled by
// rejection rather than by polar coordinates. The reference uses sin/cos, but
// Zephyr's fsin is a polynomial approximation that will not agree with the
// GPU's bit-for-bit, and keeping the CPU mirror exact is worth more here than
// matching the reference line for line. Same distribution either way.
vec3 cosineHemisphere(vec3 n)
{
    float u, v, r2;
    for (int i = 0; i < 32; i++)
    {
        u = rnd() * 2.0 - 1.0;
        v = rnd() * 2.0 - 1.0;
        r2 = u * u + v * v;
        if (r2 <= 1.0) { break; }
        u = 0.0; v = 0.0; r2 = 0.0;
    }
    vec3 t = abs(n.y) < 0.99 ? normalize(cross(vec3(0.0, 1.0, 0.0), n)) : vec3(1.0, 0.0, 0.0);
    vec3 b = cross(n, t);
    return normalize(t * u + b * v + n * sqrt(max(0.0, 1.0 - r2)));
}

vec3 palette(int m)
{
    if (m == 1) return vec3(0.44, 0.44, 0.47);
    if (m == 2) return vec3(0.40, 0.29, 0.19);
    if (m == 3) return vec3(0.26, 0.52, 0.19);
    if (m == 4) return vec3(0.80, 0.72, 0.50);
    if (m == 5) return vec3(1.00, 0.70, 0.22);
    if (m == 6) return vec3(1.00, 0.94, 0.84);
    if (m == 7) return vec3(0.68, 0.70, 0.78);
    if (m == 8) return vec3(0.09, 0.27, 0.42);
    if (m == 9) return vec3(0.31, 0.21, 0.12);
    if (m == 10) return vec3(0.17, 0.41, 0.13);
    return vec3(0.0);
}

// x = roughness, y = specular albedo. Voxels were uniformly matte until the
// world grew water, which is the one surface where that reads as wrong. Ray
// Reconstruction consumes both, so they are guide-buffer outputs rather than
// anything the shading here uses yet.
vec2 surface(int m)
{
    if (m == 8) return vec2(0.09, 0.32);
    if (m == 10) return vec2(0.86, 0.05);
    return vec2(1.0, 0.04);
}

// Radiant power of a material. Ore seams light the caves, lamps light the loot
// rooms. Matches emissive() in trace.frag.glsl.
float emissive(int m)
{
    if (m == 5) return 5.0;
    if (m == 6) return 18.0;
    return 0.0;
}

// Everything below is deliberately free of exp(), pow() and the trig
// functions. The CPU mirror in voxel.zeph has to reproduce it exactly, and
// Zephyr's transcendentals are polynomial approximations that will not match
// GLSL bit for bit -- so the falloffs are rational and the blends are
// polynomial. They look the same and they stay comparable.

// Warm at a low sun, neutral overhead. Driving this off the sun vector rather
// than a separate uniform means a caller gets a day cycle just by rotating the
// sun, with nothing new in the push constant.
vec3 sunColor(vec3 sun)
{
    float h = clamp(sun.y, 0.0, 1.0);
    float k = h * h * (3.0 - 2.0 * h);
    return mix(vec3(1.40, 0.68, 0.32), vec3(1.05, 1.00, 0.94), k);
}

// The vertical gradient only. Used for the sky itself, for fog, and as the
// ambient term -- which is the change that makes shadows read as sky-lit
// rather than as flat grey.
vec3 skyGradient(vec3 rd, vec3 sun)
{
    float h = clamp(rd.y * 0.5 + 0.5, 0.0, 1.0);
    float k = h * h * (3.0 - 2.0 * h);
    float lo = clamp(sun.y, 0.0, 1.0);
    float warm = 1.0 - lo * lo * (3.0 - 2.0 * lo);
    vec3 horizon = mix(vec3(0.70, 0.79, 0.90), vec3(0.95, 0.70, 0.46), warm);
    vec3 zenith  = mix(vec3(0.20, 0.41, 0.78), vec3(0.16, 0.26, 0.55), warm);
    return mix(horizon, zenith, k);
}

// Gradient plus the sun itself: a tight disc and a broad halo, both rational
// falloffs standing in for pow(dot, n).
vec3 skyColor(vec3 rd, vec3 sun)
{
    float g = 1.0 - max(0.0, dot(rd, sun));
    float disc = 1.0 / (1.0 + 900.0 * g * g);
    float halo = 1.0 / (1.0 + 14.0 * g);
    return skyGradient(rd, sun) + sunColor(sun) * (disc * 1.8 + halo * 0.20);
}

// Aerial perspective. Distant geometry washes toward the sky along the view
// ray, which is what gives a voxel world depth instead of leaving it a flat
// diorama. FOG_SCALE is in world units and is the knob worth tuning.
const float FOG_SCALE = 170.0;
float fogAmount(float d)
{
    float x = d * (1.0 / FOG_SCALE);
    float x2 = x * x;
    return clamp(x2 / (1.0 + x2) * 1.35, 0.0, 1.0);
}

// Per-voxel tint. One flat colour per material is what makes a voxel world
// read as plastic. The variation is keyed to the CELL, not the pixel, so it is
// stable under camera motion -- a per-pixel jitter would crawl and Ray
// Reconstruction would fight it. Grass and leaves vary most and toward yellow,
// which is most of what separates a lawn from a meadow.
vec3 tintAmp(int m)
{
    if (m == 3)  return vec3(0.30, 0.15, 0.11);
    if (m == 10) return vec3(0.34, 0.17, 0.11);
    if (m == 2)  return vec3(0.13, 0.11, 0.10);
    if (m == 4)  return vec3(0.10, 0.09, 0.08);
    if (m == 8)  return vec3(0.03, 0.03, 0.04);
    return vec3(0.08);
}

vec3 albedoOf(int m, ivec3 c)
{
    uint h = hashu(uint(c.x) * 73856093u ^ uint(c.y) * 19349663u ^ uint(c.z) * 83492791u);
    float j = float(h & 0xFFFFu) * (1.0 / 65535.0);
    return max(vec3(0.0), palette(m) * (1.0 + (j - 0.5) * 2.0 * tintAmp(m)));
}

int voxAt(ivec3 p)
{
    if (any(lessThan(p, ivec3(0))) || any(greaterThanEqual(p, pc.volSize.xyz))) return 0;
    return int(imageLoad(vol, p).r);
}

bool traceVox(vec3 ro, vec3 rd, float tmax, out float tHit, out vec3 nrm, out int mat, out ivec3 cell)
{
    tHit = tmax; nrm = vec3(0.0); mat = 0; cell = ivec3(0);

    ivec3 p = ivec3(floor(ro));
    ivec3 s = ivec3(rd.x >= 0.0 ? 1 : -1, rd.y >= 0.0 ? 1 : -1, rd.z >= 0.0 ? 1 : -1);
    vec3 adinv = 1.0 / max(abs(rd), vec3(1e-8));
    vec3 tside = vec3(
        rd.x >= 0.0 ? (float(p.x) + 1.0 - ro.x) : (ro.x - float(p.x)),
        rd.y >= 0.0 ? (float(p.y) + 1.0 - ro.y) : (ro.y - float(p.y)),
        rd.z >= 0.0 ? (float(p.z) + 1.0 - ro.z) : (ro.z - float(p.z))) * adinv;

    float t = 0.0;
    int axis = 1;

    // VX+VY+VZ cells can be crossed on one diagonal; 700 was sized for a
    // 64x32x64 grid and truncates rays on anything finer.
    for (int i = 0; i < 2048; i++)
    {
        if (t > tmax) return false;

        int m = voxAt(p);
        if (m != 0)
        {
            tHit = t; mat = m; cell = p;
            nrm = vec3(axis == 0 ? -float(s.x) : 0.0,
                       axis == 1 ? -float(s.y) : 0.0,
                       axis == 2 ? -float(s.z) : 0.0);
            return true;
        }

        // Escaped the volume with no way back in.
        if ((p.y < 0 && s.y < 0) || (p.y >= pc.volSize.y && s.y > 0)) return false;
        if ((p.x < 0 && s.x < 0) || (p.x >= pc.volSize.x && s.x > 0)) return false;
        if ((p.z < 0 && s.z < 0) || (p.z >= pc.volSize.z && s.z > 0)) return false;

        if (tside.x < tside.y && tside.x < tside.z) { p.x += s.x; t = tside.x; tside.x += adinv.x; axis = 0; }
        else if (tside.y < tside.z)                 { p.y += s.y; t = tside.y; tside.y += adinv.y; axis = 1; }
        else                                        { p.z += s.z; t = tside.z; tside.z += adinv.z; axis = 2; }
    }
    return false;
}

void main()
{
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(q, pc.res.xy))) { return; }

    // Seed from the pixel and the frame, so the sequence is reproducible and
    // the CPU mirror can walk the identical one.
    gSeed = hashu(uint(q.x) * 1973u + uint(q.y) * 9277u + uint(pc.res.w) * 26699u + 1u);

    vec2 res = vec2(pc.res.xy);
    float aspect = res.x / res.y;
    // The jitter is a known per-frame offset, not a per-pixel random one:
    // Ray Reconstruction has to be told the sequence and cannot infer it.
    vec2 uv = (vec2(q) + 0.5 + pc.jitter.xy) / res * 2.0 - 1.0;
    uv.x *= aspect;

    vec3 rd = normalize(pc.right.xyz * (uv.x * pc.misc.x)
                      + pc.up.xyz    * (uv.y * pc.misc.x)
                      + pc.fwd.xyz);

    // Voxel space: one unit is one cell, which is what the DDA needs.
    float vs = pc.jitter.z;
    vec3 roV = pc.camPos.xyz / vs;
    float tmaxV = 8192.0;

    float t; vec3 n; int m;
    vec3 col;
    vec3 albedo = vec3(0.0);
    float depth = 0.0;
    vec3 gn = vec3(0.0);
    ivec3 cell;
    vec3 sun = normalize(pc.misc.yzw);
    if (traceVox(roV, rd, tmaxV, t, n, m, cell))
    {
        albedo = albedoOf(m, cell);
        depth = t * vs;          // world units, for the depth guide buffer
        gn = n;
        float lam = max(0.0, dot(n, sun));
        float shade = 0.0;
        // Start just off the face. Any smaller and the shadow ray starts
        // inside the voxel it just hit and every surface shadows itself.
        // This is in voxel units, so it scales with the cells automatically.
        vec3 hp = roV + rd * t + n * 0.001;
        ivec3 scell;
        if (lam > 0.0)
        {
            float st; vec3 sn; int sm;
            if (!traceVox(hp, sun, tmaxV, st, sn, sm, scell)) { shade = lam; }
        }
        // One diffuse bounce. Cosine-weighted sampling cancels the 1/pi and
        // the cosine term, so the bounce radiance is just averaged.
        vec3 ind = vec3(0.0);
        int spp = pc.res.z;
        for (int i = 0; i < spp; i++)
        {
            vec3 bd = cosineHemisphere(n);
            float bt; vec3 bn; int bm; ivec3 bcell;
            if (traceVox(hp, bd, tmaxV, bt, bn, bm, bcell))
            {
                float blam = max(0.0, dot(bn, sun));
                float bshade = 0.0;
                if (blam > 0.0)
                {
                    vec3 bp = hp + bd * bt + bn * 0.001;
                    float st2; vec3 sn2; int sm2;
                    if (!traceVox(bp, sun, tmaxV, st2, sn2, sm2, scell)) { bshade = blam; }
                }
                ind += albedoOf(bm, bcell) *
                       (skyGradient(bn, sun) * 0.22 + sunColor(sun) * (bshade * 0.85) + vec3(emissive(bm)));
            }
            else
            {
                ind += skyGradient(bd, sun);
            }
        }
        if (spp > 0) { ind /= float(spp); }

        // Ambient is the sky in the direction the surface faces, which is what
        // turns shadowed faces sky-blue instead of flat grey. Albedo
        // multiplies both terms, so colour bleeds from the bounce.
        vec3 amb = skyGradient(n, sun) * 0.22;
        col = albedo * (amb + sunColor(sun) * (shade * 0.85) + vec3(emissive(m))) + albedo * ind;

        // Aerial perspective, toward the sky along this ray. Geometry only:
        // a miss is already sky and would be a no-op.
        col = mix(col, skyGradient(rd, sun), fogAmount(depth));
    }
    else
    {
        col = skyColor(rd, sun);
    }

    // Reinhard, so an emissive surface stays coloured instead of clipping to
    // white. The exposure is there because Reinhard on its own drags every
    // already-dim value down by half and the whole scene goes flat; 2.0 puts
    // mid-tones back roughly where they were. Tune it here, not per material.
    // The guide buffers below stay linear and untonemapped.
    const float exposure = 2.0;
    col = col * exposure;
    col = col / (1.0 + col);
    imageStore(dst, q, vec4(sqrt(clamp(col, 0.0, 1.0)), 1.0));
    // Motion: where this surface point sat in the previous frame, in pixels,
    // as (previous - current). A miss gets zero, as does anything that falls
    // behind the previous camera, which has no valid projection.
    vec2 motion = vec2(0.0);
    if (depth > 0.0)
    {
        vec3 hpw = pc.camPos.xyz + rd * depth;
        vec3 v = hpw - pc.prevCamPos.xyz;
        float pz = dot(v, pc.prevFwd.xyz);
        if (pz > 1e-4)
        {
            float pxc = dot(v, pc.prevRight.xyz) / (pz * pc.misc.x * aspect);
            float pyc = dot(v, pc.prevUp.xyz)    / (pz * pc.misc.x);
            // The forward path builds ndc from the sample position
            // (q + 0.5 + jitter), so inverting gives that same sample
            // position back. Subtracting a further half pixel here is the
            // classic off-by-half: with a stationary camera every motion
            // vector came out as -0.5 instead of 0.
            vec2 prevPix = (vec2(pxc, pyc) * 0.5 + 0.5) * res;
            motion = prevPix - (vec2(q) + 0.5 + pc.jitter.xy);
        }
    }

    // A miss writes depth 0 and a zero normal, which is how a consumer tells
    // sky from geometry without a separate mask.
    imageStore(gDepth,  q, vec4(depth, 0.0, 0.0, 0.0));
    imageStore(gNormal, q, vec4(gn * 0.5 + 0.5, 1.0));
    imageStore(gAlbedo, q, vec4(albedo, 1.0));
    imageStore(gMotion, q, vec4(motion, 0.0, 0.0));
    vec2 sf = surface(m);
    imageStore(gRough,  q, vec4(sf.x, sf.y, 0.0, 1.0));
}
