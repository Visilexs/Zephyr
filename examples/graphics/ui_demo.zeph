// A full showcase of the Zephyr immediate-mode UI toolkit (ui/ui.zeph):
// a tab bar, buttons, checkboxes, radio groups, sliders, a collapsing section,
// a text field, a progress bar and a live state read-out -- a native Win32
// window drawn through GDI, no C.
//
//   zc.exe --rt examples\ui_demo.zeph ui_demo.exe && .\ui_demo.exe
import "ui/ui.zeph"

var tab = 0
var clicks = 0
var enabled = true
var wireframe = false
var vsync = true
var quality = 2              // 0 low, 1 medium, 2 high, 3 ultra
var volume = 0.65
var brightness = 0.4
var contrast = 0.5
var particles = 250
var advanced = false
var name = "player"
var loading = 0.0

uiInitialize("Zephyr UI - showcase", 780, 600)

while uiRunning() {
    uiBeginFrame()

    // ---- left panel with a tab bar ----
    uiPanel(24, 24, 360, 540, "Zephyr UI")

    tab = uiTab(100, "General", tab, 0)
    uiSameLine()
    tab = uiTab(101, "Graphics", tab, 1)
    uiSameLine()
    tab = uiTab(102, "About", tab, 2)
    uiSeparator()

    if tab == 0 {
        uiHeading("Actions")
        if uiButton(1, "Click me") { clicks += 1 }
        uiSameLine()
        if uiButton(2, "Reset") { clicks = 0 }
        uiDimText("Button pressed " + (clicks as str) + " times")
        uiSpacing()
        uiHeading("Toggles")
        enabled = uiCheckbox(10, "Enable effects", enabled)
        wireframe = uiCheckbox(11, "Wireframe overlay", wireframe)
        vsync = uiCheckbox(12, "V-Sync", vsync)
        uiSpacing()
        uiHeading("Profile")
        uiDimText("Name (click and type)")
        name = uiTextBox(40, name)
        uiLabel("Hello, " + name + "!")
    }

    if tab == 1 {
        uiHeading("Quality")
        quality = uiRadio(20, "Low", quality, 0)
        quality = uiRadio(21, "Medium", quality, 1)
        quality = uiRadio(22, "High", quality, 2)
        quality = uiRadio(23, "Ultra", quality, 3)
        uiSpacing()
        uiHeading("Levels")
        volume = uiSlider(30, "Volume", volume, 0.0, 1.0)
        brightness = uiSlider(31, "Brightness", brightness, 0.0, 1.0)
        particles = uiSliderInt(32, "Particles", particles, 0, 1000)
        uiSpacing()
        advanced = uiCollapsingHeader(50, "Advanced", advanced)
        if advanced {
            contrast = uiSlider(33, "Contrast", contrast, 0.0, 2.0)
            if uiButtonWide(34, "Restore defaults") {
                volume = 0.65
                brightness = 0.4
                contrast = 0.5
                particles = 250
            }
        }
    }

    if tab == 2 {
        uiHeading("Zephyr UI")
        uiDimText("An immediate-mode GUI toolkit written in Zephyr.")
        uiDimText("Native Win32 + GDI. Imports only kernel32,")
        uiDimText("user32 and gdi32 -- no C anywhere.")
        uiSeparator()
        uiDimText("Every widget is a plain function call that both")
        uiDimText("draws and reports interaction. Mutable widgets")
        uiDimText("take a value and return the new one.")
        uiSpacing()
        if uiButton(60, "Start loading") { loading = 0.02 }
    }

    // ---- right panel: live state ----
    uiPanel(400, 24, 356, 540, "State")
    uiKeyValue("Effects", on_off(enabled))
    uiKeyValue("Wireframe", on_off(wireframe))
    uiKeyValue("V-Sync", on_off(vsync))
    uiKeyValue("Quality", qname(quality))
    uiSeparator()
    uiKeyValue("Volume", pct(volume))
    uiKeyValue("Brightness", pct(brightness))
    uiKeyValue("Contrast", formatTwoDecimals(contrast))
    uiKeyValue("Particles", particles as str)
    uiSeparator()
    uiKeyValue("Active tab", qtab(tab))
    uiKeyValue("Clicks", clicks as str)
    uiKeyValue("Name", name)
    uiSpacing()
    uiDimText("Progress")
    uiProgressBar(loading, pct(loading))
    if loading > 0.0 {
        loading += 0.006
        if loading >= 1.0 { loading = 0.0 }
    }

    uiEndFrame()
    let s = win("Sleep", 12)
}

fn on_off(b: bool) -> str {
    if b { return "on" }
    return "off"
}
fn qname(q: int) -> str {
    if q == 0 { return "Low" }
    if q == 1 { return "Medium" }
    if q == 2 { return "High" }
    return "Ultra"
}
fn qtab(t: int) -> str {
    if t == 0 { return "General" }
    if t == 1 { return "Graphics" }
    return "About"
}
fn pct(v: float) -> str {
    return ((v * 100.0 + 0.5) as int as str) + "%"
}
