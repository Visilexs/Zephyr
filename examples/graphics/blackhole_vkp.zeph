// The turbulent accretion flow, ported to Vulkan compute: 1,500,000 particles
// simulated and rendered entirely on the GPU, in pure Zephyr.
//
// This is the OpenGL version (examples/blackhole_gpu.zeph) moved onto the vk/
// wrapper now that it binds compute and descriptor sets. The physics shader is
// a straight port -- Paczynski-Wiita gravity, Shakura-Sunyaev alpha viscosity
// and spatially-correlated MRI turbulence -- but the pipeline around it is
// quite different, because Vulkan has no transform feedback and the wrapper has
// no samplers:
//
//   OpenGL                                Vulkan
//   ------                                ------
//   transform feedback into a VBO    ->   compute shader over an SSBO
//   additive blend into an RGBA16F   ->   atomicAdd into a fixed-point SSBO
//   sample that texture, tone map    ->   read the SSBO in the fragment shader
//
// Accumulating in 20.12 fixed point instead of an 8-bit framebuffer is the bit
// that matters for image quality: it is what stops faint gas from quantising
// its colour ratio into the olive banding the earlier versions had.
//
// Per frame: clear dispatch, sim+splat dispatch, one full-screen triangle.
//
//   zc.exe --rt examples\blackhole_vkp.zeph blackhole_vkp.exe && .\blackhole_vkp.exe
//
// Drag with the left mouse button to orbit, wheel to zoom, Esc to quit.

import "vk/gfx.zeph"

extern fn QueryPerformanceCounter(p: int) -> i32 from "kernel32.dll"
extern fn QueryPerformanceFrequency(p: int) -> i32 from "kernel32.dll"
extern fn GetCursorPos(p: int) -> i32 from "user32.dll"
extern fn ScreenToClient(hwnd: int, p: int) -> i32 from "user32.dll"

let WIDTH = 1600
let HEIGHT = 940
var COUNT = 1500000
let MAXPIX = 2560 * 1440          // accumulation buffer is sized for any resize

// ---- Schwarzschild geometry, in units of r_g = GM/c^2 = 1 ----
let R_HOR = 2.0
let R_ISCO = 6.0
let B_CRIT = 5.19615242270663     // sqrt(27): the apparent shadow radius
let R_DISC_OUT = 38.0
let R_ESCAPE = 150.0

// ---- accretion flow ----
let DTS = 0.035
let ALPHA = 0.4                   // Shakura-Sunyaev viscosity parameter
let HR = 0.10                     // disc aspect ratio H/R
let TURB = 1.2                    // MRI fluctuation amplitude, in sqrt(alpha)*c_s
let T_PEAK = 4200.0
let T_REF = 4200.0
let EXPO = 0.055

let PUSH_STAGES = VK_SHADER_STAGE_COMPUTE_BIT | VK_SHADER_STAGE_FRAGMENT_BIT

let RPK = R_ISCO * 49.0 / 36.0
let FPK = sqrt(sqrt((1.0 - sqrt(R_ISCO / RPK)) / (RPK * RPK * RPK)))
let TSCALE = T_PEAK / FPK

fn p10(n: int) -> float {
    var v = 1.0
    var i = 0
    while i < n {
        v = v * 10.0
        i += 1
    }
    return v
}

fn banner() {
    let GRAV = 6.6743 / p10(11)
    let CLIGHT = 299792458.0
    let MSUN = 1.98892 * p10(30)
    let AU = 1.495978707 * p10(11)
    let PARSEC = 3.0856775814913673 * p10(16)
    let PI = 3.141592653589793
    let MASS = 6.5 * p10(9) * MSUN
    let DIST = 16.8 * p10(6) * PARSEC
    let rg = GRAV * MASS / (CLIGHT * CLIGHT)
    let uas = (2.0 * B_CRIT * rg / DIST) * (180.0 / PI) * 3600.0 * p10(6)
    print("Schwarzschild black hole, scaled to M87* (EHT 2019)")
    print("  gravitational radius {rg / AU} AU")
    print("  shadow    2*sqrt(27) {uas} uas   (EHT measured 42 +/- 3)")
    print("  accretion: alpha = {ALPHA}, H/R = {HR}, MRI turbulence on")
}

// ---- camera ----
var ocx = 1.0
var ocz = 0.0
let DRIFT = 0.0011
var psin = 0.30
var orad = 85.0
let FOVT = 0.55
let SENS = 0.0055
let PMAX = 0.94
let RMIN = 22.0
let RMAXC = 500.0

var dragging = 0
var lastx = 0
var lasty = 0
var wheel = 0

fn yaw_by(t: float) {
    let nx = ocx - ocz * t
    let nz = ocz + ocx * t
    let n = sqrt(nx * nx + nz * nz)
    ocx = nx / n
    ocz = nz / n
}
fn sext32(v: int) -> int {
    let x = v & 4294967295
    if x >= 2147483648 { return x - 4294967296 }
    return x
}

var pt = Bytes.new(16)
var curx = 0
var cury = 0
fn read_cursor(hwnd: int) {
    let a = GetCursorPos(pt.addr())
    let b = ScreenToClient(hwnd, pt.addr())
    curx = sext32(pt.get32(0))
    cury = sext32(pt.get32(4))
}

fn camera_input(hwnd: int) {
    read_cursor(hwnd)
    if (GetAsyncKeyState(1) & 32768) != 0 {
        if dragging == 1 {
            yaw_by(((curx - lastx) as float) * SENS)
            psin = psin + ((cury - lasty) as float) * SENS * 0.6
            if psin > PMAX { psin = PMAX }
            if psin < 0.0 - PMAX { psin = 0.0 - PMAX }
        }
        dragging = 1
        lastx = curx
        lasty = cury
    } else {
        dragging = 0
        yaw_by(DRIFT)
    }
    if wheel != 0 {
        var f = 1.0
        var w = wheel
        while w > 0 {
            f = f * 0.88
            w -= 1
        }
        while w < 0 {
            f = f * 1.136
            w += 1
        }
        orad = orad * f
        if orad < RMIN { orad = RMIN }
        if orad > RMAXC { orad = RMAXC }
        wheel = 0
    }
}

// our own pump so WM_MOUSEWHEEL can be read
var pmsg = Bytes.new(64)
fn pump(hwnd: int) -> bool {
    while PeekMessageA(pmsg.addr(), 0, 0, 0, 1) != 0 {
        let m = pmsg.get32(8)
        if m == 18 { return false }
        if m == 522 {
            var d = (pmsg.get64(16) >> 16) & 65535
            if d >= 32768 { d = d - 65536 }
            wheel += d / 120
        }
        let t = TranslateMessage(pmsg.addr())
        let dd = DispatchMessageA(pmsg.addr())
    }
    if IsWindow(hwnd) == 0 { return false }
    if (GetAsyncKeyState(27) & 32768) != 0 { return false }
    return true
}

var layers: [str] = []
for a in args() {
    if a == "--validate" { layers.push("VK_LAYER_KHRONOS_validation") }
}
if args().len() > 1 {
    let a1 = args()[1]
    if not a1.starts_with("-") {          // a flag, not a particle count
        let n = a1 as int
        if n > 1000 { COUNT = n }
    }
}
banner()

var wnd = window_open("Zephyr - black hole (Vulkan compute, 1.5M particles)", WIDTH, HEIGHT)
var g = Gfx.init_windowed("zephyr-blackhole-particles", layers, wnd)
print("gpu: {g.gpu_name()}")
let format = g.surface_format()

// ---------------- render pass ----------------
var attach = Bytes.new(VkAttachmentDescription_sizeof)
attach.put32(VkAttachmentDescription_format, format)
attach.put32(VkAttachmentDescription_samples, VK_SAMPLE_COUNT_1_BIT)
attach.put32(VkAttachmentDescription_loadOp, VK_ATTACHMENT_LOAD_OP_DONT_CARE)
attach.put32(VkAttachmentDescription_storeOp, VK_ATTACHMENT_STORE_OP_STORE)
attach.put32(VkAttachmentDescription_stencilLoadOp, VK_ATTACHMENT_LOAD_OP_DONT_CARE)
attach.put32(VkAttachmentDescription_stencilStoreOp, VK_ATTACHMENT_STORE_OP_DONT_CARE)
attach.put32(VkAttachmentDescription_initialLayout, VK_IMAGE_LAYOUT_UNDEFINED)
attach.put32(VkAttachmentDescription_finalLayout, VK_IMAGE_LAYOUT_PRESENT_SRC_KHR)

var ref = Bytes.new(VkAttachmentReference_sizeof)
ref.put32(VkAttachmentReference_layout, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL)

var subpass = Bytes.new(VkSubpassDescription_sizeof)
subpass.put32(VkSubpassDescription_pipelineBindPoint, VK_PIPELINE_BIND_POINT_GRAPHICS)
subpass.put32(VkSubpassDescription_colorAttachmentCount, 1)
subpass.put64(VkSubpassDescription_pColorAttachments, ref.addr())

var rpci = Bytes.new(VkRenderPassCreateInfo_sizeof)
rpci.put32(VkRenderPassCreateInfo_sType, VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO)
rpci.put32(VkRenderPassCreateInfo_attachmentCount, 1)
rpci.put64(VkRenderPassCreateInfo_pAttachments, attach.addr())
rpci.put32(VkRenderPassCreateInfo_subpassCount, 1)
rpci.put64(VkRenderPassCreateInfo_pSubpasses, subpass.addr())
var prp = Bytes.new(8)
vkcheck(vkCreateRenderPass(g.dev, rpci.addr(), 0, prp.addr()), "vkCreateRenderPass")
let renderpass = prp.get64(0)

var swap = g.swapchain(format, renderpass, 0)
print("swapchain: {swap.w}x{swap.h}, {swap.images.len()} images")

// ---------------- buffers ----------------
// Particles are never touched by the host: frame 0 seeds them in the shader,
// so there is no staging copy and no 48 MB upload.
let pbytes = COUNT * 32
let abytes = MAXPIX * 3 * 4
var pbuf = g.buffer(pbytes, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT)
var abuf = g.buffer(abytes, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT)
print("storage: {pbytes / 1048576} MB particles + {abytes / 1048576} MB accumulator")

var bufs: [GpuBuffer] = []
bufs.push(pbuf)
bufs.push(abuf)
let ds = g.storage_set(bufs, VK_SHADER_STAGE_COMPUTE_BIT | VK_SHADER_STAGE_FRAGMENT_BIT)

var setlayouts: [int] = []
setlayouts.push(ds.layout)
let layout = g.pipeline_layout(setlayouts, 128,
    VK_SHADER_STAGE_COMPUTE_BIT | VK_SHADER_STAGE_FRAGMENT_BIT)

var entry = cbytes("main")
let shclear = g.shader("examples/shaders/bh_clear.comp.spv")
let shsim = g.shader("examples/shaders/bh_sim.comp.spv")
let pipe_clear = g.compute_pipeline(shclear, layout, entry)
let pipe_sim = g.compute_pipeline(shsim, layout, entry)
print("compute pipelines ok")

// ---------------- present pipeline ----------------
let vs = g.shader("examples/shaders/blackhole.vert.spv")
let fs = g.shader("examples/shaders/bh_present.frag.spv")

var stages = Bytes.new(VkPipelineShaderStageCreateInfo_sizeof * 2)
stages.put32(VkPipelineShaderStageCreateInfo_sType, VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO)
stages.put32(VkPipelineShaderStageCreateInfo_stage, VK_SHADER_STAGE_VERTEX_BIT)
stages.put64(VkPipelineShaderStageCreateInfo_module, vs)
stages.put64(VkPipelineShaderStageCreateInfo_pName, entry.addr())
let s1 = VkPipelineShaderStageCreateInfo_sizeof
stages.put32(s1 + VkPipelineShaderStageCreateInfo_sType, VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO)
stages.put32(s1 + VkPipelineShaderStageCreateInfo_stage, VK_SHADER_STAGE_FRAGMENT_BIT)
stages.put64(s1 + VkPipelineShaderStageCreateInfo_module, fs)
stages.put64(s1 + VkPipelineShaderStageCreateInfo_pName, entry.addr())

var vi = Bytes.new(VkPipelineVertexInputStateCreateInfo_sizeof)
vi.put32(VkPipelineVertexInputStateCreateInfo_sType, VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO)
var ia = Bytes.new(VkPipelineInputAssemblyStateCreateInfo_sizeof)
ia.put32(VkPipelineInputAssemblyStateCreateInfo_sType, VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO)
ia.put32(VkPipelineInputAssemblyStateCreateInfo_topology, VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST)

var viewport = Bytes.new(VkViewport_sizeof)
var scissor = Bytes.new(VkRect2D_sizeof)
var dynstates = Bytes.new(8)
dynstates.put32(0, VK_DYNAMIC_STATE_VIEWPORT)
dynstates.put32(4, VK_DYNAMIC_STATE_SCISSOR)
var dyn = Bytes.new(VkPipelineDynamicStateCreateInfo_sizeof)
dyn.put32(VkPipelineDynamicStateCreateInfo_sType, VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO)
dyn.put32(VkPipelineDynamicStateCreateInfo_dynamicStateCount, 2)
dyn.put64(VkPipelineDynamicStateCreateInfo_pDynamicStates, dynstates.addr())

var vp = Bytes.new(VkPipelineViewportStateCreateInfo_sizeof)
vp.put32(VkPipelineViewportStateCreateInfo_sType, VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO)
vp.put32(VkPipelineViewportStateCreateInfo_viewportCount, 1)
vp.put32(VkPipelineViewportStateCreateInfo_scissorCount, 1)

var rs = Bytes.new(VkPipelineRasterizationStateCreateInfo_sizeof)
rs.put32(VkPipelineRasterizationStateCreateInfo_sType, VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO)
rs.put32(VkPipelineRasterizationStateCreateInfo_polygonMode, VK_POLYGON_MODE_FILL)
rs.put32(VkPipelineRasterizationStateCreateInfo_cullMode, VK_CULL_MODE_NONE)
rs.put32(VkPipelineRasterizationStateCreateInfo_frontFace, VK_FRONT_FACE_CLOCKWISE)
rs.putf32(VkPipelineRasterizationStateCreateInfo_lineWidth, 1.0)

var ms = Bytes.new(VkPipelineMultisampleStateCreateInfo_sizeof)
ms.put32(VkPipelineMultisampleStateCreateInfo_sType, VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO)
ms.put32(VkPipelineMultisampleStateCreateInfo_rasterizationSamples, VK_SAMPLE_COUNT_1_BIT)

var cba = Bytes.new(VkPipelineColorBlendAttachmentState_sizeof)
cba.put32(VkPipelineColorBlendAttachmentState_colorWriteMask, 15)
var cbs = Bytes.new(VkPipelineColorBlendStateCreateInfo_sizeof)
cbs.put32(VkPipelineColorBlendStateCreateInfo_sType, VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO)
cbs.put32(VkPipelineColorBlendStateCreateInfo_attachmentCount, 1)
cbs.put64(VkPipelineColorBlendStateCreateInfo_pAttachments, cba.addr())

var gpci = Bytes.new(VkGraphicsPipelineCreateInfo_sizeof)
gpci.put32(VkGraphicsPipelineCreateInfo_sType, VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO)
gpci.put32(VkGraphicsPipelineCreateInfo_stageCount, 2)
gpci.put64(VkGraphicsPipelineCreateInfo_pStages, stages.addr())
gpci.put64(VkGraphicsPipelineCreateInfo_pVertexInputState, vi.addr())
gpci.put64(VkGraphicsPipelineCreateInfo_pInputAssemblyState, ia.addr())
gpci.put64(VkGraphicsPipelineCreateInfo_pViewportState, vp.addr())
gpci.put64(VkGraphicsPipelineCreateInfo_pRasterizationState, rs.addr())
gpci.put64(VkGraphicsPipelineCreateInfo_pMultisampleState, ms.addr())
gpci.put64(VkGraphicsPipelineCreateInfo_pColorBlendState, cbs.addr())
gpci.put64(VkGraphicsPipelineCreateInfo_pDynamicState, dyn.addr())
gpci.put64(VkGraphicsPipelineCreateInfo_layout, layout)
gpci.put64(VkGraphicsPipelineCreateInfo_renderPass, renderpass)
gpci.put32(VkGraphicsPipelineCreateInfo_basePipelineIndex, 0 - 1)
var ppipe = Bytes.new(8)
vkcheck(vkCreateGraphicsPipelines(g.dev, 0, 1, gpci.addr(), 0, ppipe.addr()), "vkCreateGraphicsPipelines")
let pipe_present = ppipe.get64(0)
print("present pipeline ok")

// ---------------- frame loop ----------------
var rpbi = Bytes.new(VkRenderPassBeginInfo_sizeof)
rpbi.put32(VkRenderPassBeginInfo_sType, VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO)
rpbi.put64(VkRenderPassBeginInfo_renderPass, renderpass)

// VkMemoryBarrier: sType 0, pNext 8, srcAccessMask 16, dstAccessMask 20.
// (vk/consts.zeph has no VK_STRUCTURE_TYPE_MEMORY_BARRIER; it is 46.)
var mb = Bytes.new(24)
mb.put32(0, 46)
mb.put32(16, VK_ACCESS_SHADER_WRITE_BIT)
mb.put32(20, VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT)

var pushc = Bytes.new(128)
var sets = u64s([ds.set])

var qpc = Bytes.new(8)
var qpf = Bytes.new(8)
let qf = QueryPerformanceFrequency(qpf.addr())
let freq = qpf.get64(0)
let q0 = QueryPerformanceCounter(qpc.addr())
let t0 = qpc.get64(0)

let rpa = rpbi.addr()
let pla = layout
let pusha = pushc.addr()
let vpa = viewport.addr()
let sca = scissor.addr()
let seta = sets.addr()
let mba = mb.addr()
let hwnd = wnd.hwnd
let pcl = pipe_clear
let psi = pipe_sim
let ppr = pipe_present
let nparts = COUNT
let simgroups = (COUNT + 255) / 256

var frame = 0
var fps_mark = 0
var fps_t = 0.0
var running = true
while running {
    if not pump(hwnd) { running = false }
    if running {
        let q = QueryPerformanceCounter(qpc.addr())
        let t = ((qpc.get64(0) - t0) as float) / (freq as float)
        camera_input(hwnd)

        let pc2 = sqrt(1.0 - psin * psin)
        let ex = ocx * pc2 * orad
        let ey = psin * orad
        let ez = ocz * pc2 * orad
        let el = sqrt(ex * ex + ey * ey + ez * ez)
        let fx = (0.0 - ex) / el
        let fy = (0.0 - ey) / el
        let fz = (0.0 - ez) / el
        var rx = fz
        var rz = 0.0 - fx
        let rl = sqrt(rx * rx + rz * rz)
        rx = rx / rl
        rz = rz / rl
        let upx = fy * rz
        let upy = fz * rx - fx * rz
        let upz = 0.0 - fy * rx
        let fw = swap.w as float
        let fh = swap.h as float
        let aspect = fw / fh
        let kx = 0.5 * fw / (FOVT * aspect)
        let ky = 0.5 * fh / FOVT

        pushc.putf32(0, ex)
        pushc.putf32(4, ey)
        pushc.putf32(8, ez)
        pushc.putf32(12, t)
        pushc.putf32(16, rx)
        pushc.putf32(20, 0.0)
        pushc.putf32(24, rz)
        pushc.putf32(28, kx)
        pushc.putf32(32, upx)
        pushc.putf32(36, upy)
        pushc.putf32(40, upz)
        pushc.putf32(44, ky)
        pushc.putf32(48, fx)
        pushc.putf32(52, fy)
        pushc.putf32(56, fz)
        pushc.putf32(60, frame as float)
        pushc.putf32(64, R_ISCO)
        pushc.putf32(68, R_DISC_OUT)
        pushc.putf32(72, TSCALE)
        pushc.putf32(76, EXPO)
        pushc.putf32(80, fw)
        pushc.putf32(84, fh)
        pushc.putf32(88, nparts as float)
        pushc.putf32(92, B_CRIT)
        pushc.putf32(96, ALPHA)
        pushc.putf32(100, HR)
        pushc.putf32(104, TURB)
        pushc.putf32(108, T_REF)
        pushc.putf32(112, DTS)
        pushc.putf32(116, R_HOR)
        pushc.putf32(120, R_ESCAPE)
        pushc.putf32(124, 0.0)

        viewport.putf32(VkViewport_width, fw)
        viewport.putf32(VkViewport_height, fh)
        viewport.putf32(VkViewport_maxDepth, 1.0)
        scissor.put32(VkRect2D_extent + VkExtent2D_width, swap.w)
        scissor.put32(VkRect2D_extent + VkExtent2D_height, swap.h)
        rpbi.put32(VkRenderPassBeginInfo_renderArea + VkRect2D_extent + VkExtent2D_width, swap.w)
        rpbi.put32(VkRenderPassBeginInfo_renderArea + VkRect2D_extent + VkExtent2D_height, swap.h)

        let clrgroups = (swap.w * swap.h * 3 + 255) / 256
        let fbs = swap.fbs
        let ok = g.frame(swap, fn(cb: int, idx: int) {
            // 1. zero the accumulator
            vkCmdBindPipeline(cb, VK_PIPELINE_BIND_POINT_COMPUTE, pcl)
            vkCmdBindDescriptorSets(cb, VK_PIPELINE_BIND_POINT_COMPUTE, pla, 0, 1, seta, 0, 0)
            vkCmdPushConstants(cb, pla, PUSH_STAGES, 0, 128, pusha)
            vkCmdDispatch(cb, clrgroups, 1, 1)
            vkCmdPipelineBarrier(cb,
                VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
                0, 1, mba, 0, 0, 0, 0)

            // 2. integrate the flow and splat it
            vkCmdBindPipeline(cb, VK_PIPELINE_BIND_POINT_COMPUTE, psi)
            vkCmdDispatch(cb, simgroups, 1, 1)
            vkCmdPipelineBarrier(cb,
                VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT,
                0, 1, mba, 0, 0, 0, 0)

            // 3. tone-map it onto the swapchain
            store64(rpa + VkRenderPassBeginInfo_framebuffer, fbs[idx])
            vkCmdBeginRenderPass(cb, rpa, VK_SUBPASS_CONTENTS_INLINE)
            vkCmdBindPipeline(cb, VK_PIPELINE_BIND_POINT_GRAPHICS, ppr)
            vkCmdBindDescriptorSets(cb, VK_PIPELINE_BIND_POINT_GRAPHICS, pla, 0, 1, seta, 0, 0)
            vkCmdPushConstants(cb, pla, PUSH_STAGES, 0, 128, pusha)
            vkCmdSetViewport(cb, 0, 1, vpa)
            vkCmdSetScissor(cb, 0, 1, sca)
            vkCmdDraw(cb, 3, 1, 0, 0)
            vkCmdEndRenderPass(cb)
        })

        if running and not ok {
            let fresh = g.rebuild(swap, renderpass)
            if fresh.has() { swap = fresh.get() }
        }
        frame += 1
        if frame - fps_mark >= 120 {
            print("{(120.0 / (t - fps_t)) as int} fps  ({swap.w}x{swap.h}, {nparts} particles, eye {orad as int} r_g)")
            fps_mark = frame
            fps_t = t
        }
    }
}

let q1 = QueryPerformanceCounter(qpc.addr())
print("{frame} frames in {((qpc.get64(0) - t0) as float) / (freq as float)}s")

vkcheck(vkDeviceWaitIdle(g.dev), "vkDeviceWaitIdle")
vkDestroyPipeline(g.dev, pipe_present, 0)
vkDestroyPipeline(g.dev, pipe_sim, 0)
vkDestroyPipeline(g.dev, pipe_clear, 0)
vkDestroyPipelineLayout(g.dev, layout, 0)
vkDestroyShaderModule(g.dev, vs, 0)
vkDestroyShaderModule(g.dev, fs, 0)
vkDestroyShaderModule(g.dev, shsim, 0)
vkDestroyShaderModule(g.dev, shclear, 0)
g.destroy_desc_set(ds)
g.destroy_buffer(pbuf)
g.destroy_buffer(abuf)
g.destroy_swapchain(swap)
vkDestroyRenderPass(g.dev, renderpass, 0)
g.shutdown()
wnd.close()
print("OK")
