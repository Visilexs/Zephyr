// The voxel tracer in a window, running in real time.
//
// Compute traces into a fixed-size storage image, then vkCmdBlitImage scales
// that into the swapchain image. Nothing is rasterised and there is no render
// pass: the swapchain is created with TRANSFER_DST usage and renderpass 0, so
// it carries no views or framebuffers. Rendering at a fixed internal
// resolution and scaling on present is also the shape Ray Reconstruction
// wants -- it upscales from exactly this kind of internal buffer.
//
// The camera carries its previous position and basis into every frame, so the
// motion vectors the shader writes are real rather than zero. That costs
// nothing now and is the input RR cannot reconstruct later.
//
// Default run is 300 frames on a canned path, printing frame rate and mean
// luma, then exits. `--play` keeps the window open and takes WASD to move and
// the arrow keys to look. Nothing here captures the mouse.
import "vk/gfx.zeph"
import "world.zeph"
import "std/math.zeph"

let VOXEL = 0.125
let MAXSTEP = 2048
let VX = 512
let VY = 256
let VZ = 512
let RW = 960              // internal render width
let RH = 540
let PCSIZE = 192
let SPP = 2
let tan_half = 0.5773502691896258

fn halton(index: int, base: int) -> float {
    var f = 1.0
    var r = 0.0
    var i = index
    while i > 0 {
        f = f / (base as float)
        r = r + f * ((i % base) as float)
        i = i / base
    }
    return r
}

extern fn QueryPerformanceCounter(p: int) -> i32 from "kernel32.dll"
extern fn QueryPerformanceFrequency(p: int) -> i32 from "kernel32.dll"

var layers: [str] = []
var play = false
let budget = 300
for arg in args() {
    if arg == "--validate" { layers.push("VK_LAYER_KHRONOS_validation") }
    if arg == "--play" { play = true }
}

var wnd = window_open("Zephyr - voxel", 1280, 720)
var g = Gfx.init_windowed("zephyr-voxel-live", layers, wnd)
print("gpu: {g.gpu_name()}")

// ---------------------------------------------------------------- world
var vox = Bytes.new(VX * VY * VZ)
let ws = build_world(vox, VX, VY, VZ, VOXEL)
print("world {VX}x{VY}x{VZ}, {ws.solid} solid voxels")
print("  water {ws.water}, wood {ws.wood}, leaves {ws.leaf}, grass {ws.grass}")

let vol = g.storage_image_3d(VX, VY, VZ, VK_FORMAT_R8_UINT)
g.write_volume(vol, vox, 1)

let target = g.storage_image(RW, RH)
let gdepth = g.storage_image_3d(RW, RH, 1, VK_FORMAT_R32_SFLOAT)
let gnormal = g.storage_image(RW, RH)
let galbedo = g.storage_image(RW, RH)
let gmotion = g.storage_image_3d(RW, RH, 1, VK_FORMAT_R16G16B16A16_SFLOAT)
let grough = g.storage_image(RW, RH)
let descriptors = g.storage_images_set([vol, target, gdepth, gnormal, galbedo, gmotion, grough],
                                       VK_SHADER_STAGE_COMPUTE_BIT)
let shader = g.shader("examples/shaders/voxel.comp.spv")
let entry = cbytes("main")
assert(g.max_push_constants() >= PCSIZE,
       "this device allows only {g.max_push_constants()} push constant bytes, the tracer needs {PCSIZE}")
let layout = g.pipeline_layout([descriptors.layout], PCSIZE, VK_SHADER_STAGE_COMPUTE_BIT)
let pipeline = g.compute_pipeline(shader, layout, entry)
let sets = u64s([descriptors.set])

// No render pass and no framebuffers: the swapchain image is only ever a blit
// destination and a present source.
let format = g.surface_format()
var swap = g.swapchain_usage(format, 0, 0, 0, VK_IMAGE_USAGE_TRANSFER_DST_BIT)
print("swapchain: {swap.w}x{swap.h}, {swap.images.len()} images, rendering {RW}x{RH}")

// The guide buffers are written every frame and never leave GENERAL, so they
// are transitioned once here rather than in the frame loop.
let gdi = gdepth.image
let gni = gnormal.image
let gai = galbedo.image
let gmi = gmotion.image
let gri = grough.image
let dsti = target.image
g.immediate(fn(cb: int) {
    image_barrier(cb, dsti, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_GENERAL,
        VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
        0, VK_ACCESS_SHADER_WRITE_BIT)
    image_barrier(cb, gdi, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_GENERAL,
        VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
        0, VK_ACCESS_SHADER_WRITE_BIT)
    image_barrier(cb, gni, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_GENERAL,
        VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
        0, VK_ACCESS_SHADER_WRITE_BIT)
    image_barrier(cb, gai, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_GENERAL,
        VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
        0, VK_ACCESS_SHADER_WRITE_BIT)
    image_barrier(cb, gmi, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_GENERAL,
        VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
        0, VK_ACCESS_SHADER_WRITE_BIT)
    image_barrier(cb, gri, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_GENERAL,
        VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
        0, VK_ACCESS_SHADER_WRITE_BIT)
})

// ---------------------------------------------------------------- camera
var cam_x = 32.0
var cam_y = 22.0
var cam_z = 0.0 - 18.0
var yaw = 0.0                   // 0 looks down +Z
var pitch = 0.0 - 0.357
var prev_x = cam_x
var prev_y = cam_y
var prev_z = cam_z

let sun_x = 0.4
let sun_y = 0.82
let sun_z = 0.41

var pc = Bytes.new(PCSIZE)
pc.put32(0, VX)
pc.put32(4, VY)
pc.put32(8, VZ)
pc.put32(16, RW)
pc.put32(20, RH)
pc.put32(24, SPP)
pc.putf32(96, tan_half)
pc.putf32(100, sun_x)
pc.putf32(104, sun_y)
pc.putf32(108, sun_z)
pc.putf32(184, VOXEL)

// The previous frame's basis, so motion vectors reproject through the camera
// that actually drew the last frame rather than the current one.
var prev_rx = 0.0
var prev_ry = 0.0
var prev_rz = 0.0
var prev_ux = 0.0
var prev_uy = 0.0
var prev_uz = 0.0
var prev_fx = 0.0
var prev_fy = 0.0
var prev_fz = 0.0
var have_prev = false

var blit = VkImageBlit.new()
    .srcSubresource_aspectMask(VK_IMAGE_ASPECT_COLOR_BIT)
    .srcSubresource_layerCount(1)
    .dstSubresource_aspectMask(VK_IMAGE_ASPECT_COLOR_BIT)
    .dstSubresource_layerCount(1)
    .srcOffsets_1_x(RW).srcOffsets_1_y(RH).srcOffsets_1_z(1)
    .dstOffsets_1_z(1)

var qpc = Bytes.new(8)
var qpf = Bytes.new(8)
let qfr = QueryPerformanceFrequency(qpf.addr())
let freq = qpf.get64(0)
let q0 = QueryPerformanceCounter(qpc.addr())
let t0 = qpc.get64(0)
var last = t0

let pca = pc.addr()
let pl = layout
let pipe = pipeline
let seta = sets.addr()
let blita = blit.addr()

var frames = 0
var resizes = 0
var running = true
while running {
    if not wnd.poll() { running = false }
    if (not play) and frames >= budget { running = false }
    if running {
        let qn = QueryPerformanceCounter(qpc.addr())
        let now = qpc.get64(0)
        var dt = ((now - last) as float) / (freq as float)
        last = now
        if dt > 0.1 { dt = 0.1 }
        let t = ((now - t0) as float) / (freq as float)

        if play {
            if (GetAsyncKeyState(37) & 32768) != 0 { yaw = yaw - 1.6 * dt }
            if (GetAsyncKeyState(39) & 32768) != 0 { yaw = yaw + 1.6 * dt }
            if (GetAsyncKeyState(38) & 32768) != 0 { pitch = pitch + 1.2 * dt }
            if (GetAsyncKeyState(40) & 32768) != 0 { pitch = pitch - 1.2 * dt }
            if pitch > 1.5 { pitch = 1.5 }
            if pitch < 0.0 - 1.5 { pitch = 0.0 - 1.5 }
        } else {
            // A canned orbit, so a default run exercises motion vectors and
            // reports a frame rate under camera movement rather than parked.
            yaw = 0.4 * fsin(t * 0.5)
        }

        let cp = fcos(pitch)
        let fx = fsin(yaw) * cp
        let fy = fsin(pitch)
        let fz = fcos(yaw) * cp
        // right = cross(worldUp, fwd), up = cross(fwd, right): the same basis
        // voxel.zeph builds and the shader is verified against.
        let rlen = sqrt(fz * fz + fx * fx)
        let rx = fz / rlen
        let ry = 0.0
        let rz = (0.0 - fx) / rlen
        let ux = fy * rz - fz * ry
        let uy = fz * rx - fx * rz
        let uz = fx * ry - fy * rx

        if play {
            var speed = 9.0
            if (GetAsyncKeyState(16) & 32768) != 0 { speed = 26.0 }
            let step = speed * dt
            if (GetAsyncKeyState(87) & 32768) != 0 {
                cam_x = cam_x + fx * step
                cam_y = cam_y + fy * step
                cam_z = cam_z + fz * step
            }
            if (GetAsyncKeyState(83) & 32768) != 0 {
                cam_x = cam_x - fx * step
                cam_y = cam_y - fy * step
                cam_z = cam_z - fz * step
            }
            if (GetAsyncKeyState(68) & 32768) != 0 {
                cam_x = cam_x - rx * step
                cam_z = cam_z - rz * step
            }
            if (GetAsyncKeyState(65) & 32768) != 0 {
                cam_x = cam_x + rx * step
                cam_z = cam_z + rz * step
            }
            if (GetAsyncKeyState(32) & 32768) != 0 { cam_y = cam_y + step }
            if (GetAsyncKeyState(17) & 32768) != 0 { cam_y = cam_y - step }
        } else {
            cam_x = 32.0 + 6.0 * fsin(t * 0.35)
            cam_z = (0.0 - 18.0) + 4.0 * fcos(t * 0.35)
        }

        // First frame has no history; pointing the previous camera at the
        // current one makes every motion vector zero, which is correct.
        if not have_prev {
            prev_x = cam_x
            prev_y = cam_y
            prev_z = cam_z
            prev_rx = rx
            prev_ry = ry
            prev_rz = rz
            prev_ux = ux
            prev_uy = uy
            prev_uz = uz
            prev_fx = fx
            prev_fy = fy
            prev_fz = fz
            have_prev = true
        }

        pc.put32(28, frames)
        pc.putf32(32, cam_x)
        pc.putf32(36, cam_y)
        pc.putf32(40, cam_z)
        pc.putf32(48, rx)
        pc.putf32(52, ry)
        pc.putf32(56, rz)
        pc.putf32(64, ux)
        pc.putf32(68, uy)
        pc.putf32(72, uz)
        pc.putf32(80, fx)
        pc.putf32(84, fy)
        pc.putf32(88, fz)
        pc.putf32(112, prev_x)
        pc.putf32(116, prev_y)
        pc.putf32(120, prev_z)
        pc.putf32(128, prev_rx)
        pc.putf32(132, prev_ry)
        pc.putf32(136, prev_rz)
        pc.putf32(144, prev_ux)
        pc.putf32(148, prev_uy)
        pc.putf32(152, prev_uz)
        pc.putf32(160, prev_fx)
        pc.putf32(164, prev_fy)
        pc.putf32(168, prev_fz)
        pc.putf32(176, halton(frames + 1, 2) - 0.5)
        pc.putf32(180, halton(frames + 1, 3) - 0.5)

        let bw = blit.dstOffsets_1_x(swap.w)
        let bh = blit.dstOffsets_1_y(swap.h)
        let imgs = swap.images
        // Wait for the acquire at TRANSFER, not COLOR_ATTACHMENT_OUTPUT: the
        // blit is the first thing that touches the swapchain image.
        let ok = g.frame_at_stage(swap, VK_PIPELINE_STAGE_TRANSFER_BIT, fn(cb: int, idx: int) {
            vkCmdBindPipeline(cb, VK_PIPELINE_BIND_POINT_COMPUTE, pipe)
            vkCmdBindDescriptorSets(cb, VK_PIPELINE_BIND_POINT_COMPUTE, pl, 0, 1, seta, 0, 0)
            vkCmdPushConstants(cb, pl, VK_SHADER_STAGE_COMPUTE_BIT, 0, PCSIZE, pca)
            vkCmdDispatch(cb, (RW + 7) / 8, (RH + 7) / 8, 1)
            image_barrier(cb, dsti, VK_IMAGE_LAYOUT_GENERAL, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
                VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
                VK_ACCESS_SHADER_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT)
            // The previous contents are about to be overwritten in full, so
            // the old layout is UNDEFINED rather than PRESENT_SRC.
            image_barrier(cb, imgs[idx], VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
                VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
                0, VK_ACCESS_TRANSFER_WRITE_BIT)
            vkCmdBlitImage(cb, dsti, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
                           imgs[idx], VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
                           1, blita, VK_FILTER_LINEAR)
            image_barrier(cb, imgs[idx], VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_PRESENT_SRC_KHR,
                VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT,
                VK_ACCESS_TRANSFER_WRITE_BIT, 0)
            // Back to GENERAL for the next frame's dispatch.
            image_barrier(cb, dsti, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_IMAGE_LAYOUT_GENERAL,
                VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
                VK_ACCESS_TRANSFER_READ_BIT, VK_ACCESS_SHADER_WRITE_BIT)
        })

        if running and (not ok) {
            let fresh = g.rebuild(swap, 0)
            if fresh.has() {
                swap = fresh.get()
                resizes += 1
            }
        }

        prev_x = cam_x
        prev_y = cam_y
        prev_z = cam_z
        prev_rx = rx
        prev_ry = ry
        prev_rz = rz
        prev_ux = ux
        prev_uy = uy
        prev_uz = uz
        prev_fx = fx
        prev_fy = fy
        prev_fz = fz
        frames += 1
    }
}

let q1 = QueryPerformanceCounter(qpc.addr())
let elapsed = ((qpc.get64(0) - t0) as float) / (freq as float)
vkcheck(vkDeviceWaitIdle(g.dev), "vkDeviceWaitIdle")

// One last trace read back, so a default run reports what was actually on
// screen rather than only how fast it got there. A frame that renders nothing
// is still fast.
g.immediate(fn(cb: int) {
    image_barrier(cb, dsti, VK_IMAGE_LAYOUT_GENERAL, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
        VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
        VK_ACCESS_SHADER_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT)
})
let px = g.read_image(dsti, RW, RH)
var lumsum = 0
var lit = 0
var i = 0
while i < RW * RH {
    let l = (px.get8(i * 4) * 2 + px.get8(i * 4 + 1) * 5 + px.get8(i * 4 + 2)) / 8
    lumsum += l
    if l > 8 { lit += 1 }
    i += 1
}
let mean = (lumsum as float) / ((RW * RH) as float)
let fps = (frames as float) / elapsed
print("{frames} frames in {elapsed}s = {fps} fps, {resizes} swapchain rebuilds")
print("last frame: mean luma {mean}, {lit} of {RW * RH} pixels lit")
assert(frames > 0, "no frames were presented")
assert(mean > 4.0, "the presented frame is essentially black -- the trace is not reaching the swapchain")
assert(lit * 4 > RW * RH, "less than a quarter of the frame is lit; the camera is probably inside geometry")

g.destroy_desc_set(descriptors)
g.destroy_image(vol)
g.destroy_image(target)
g.destroy_image(gdepth)
g.destroy_image(gnormal)
g.destroy_image(galbedo)
g.destroy_image(gmotion)
g.destroy_image(grough)
vkDestroyPipeline(g.dev, pipeline, 0)
vkDestroyPipelineLayout(g.dev, layout, 0)
vkDestroyShaderModule(g.dev, shader, 0)
g.destroy_swapchain(swap)
g.shutdown()
wnd.close()
print("OK")
