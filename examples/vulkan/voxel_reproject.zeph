// Do the motion vectors actually reproject?
//
// voxel.zeph checks motion vectors against the CPU doing the same projection,
// which catches arithmetic mistakes but not a wrong convention: a sign flip or
// an off-by-one would agree on both sides and still be useless to a temporal
// consumer. This renders two frames with the camera moved between them, then
// uses frame 1's motion vectors to look frame 0 up and compares the colours.
// If the convention is right most pixels land on the same surface.
//
// Bounces are off and the jitter is zero, so any difference is geometry rather
// than Monte Carlo noise or a subpixel shift.
//
// Headless. Build the GLSL with glslangValidator, not zspv.
import "vk/gfx.zeph"

let VOXEL = 0.125         // world units per voxel; must match voxel.zeph
let VX = 512
let VY = 256
let VZ = 512
let W = 320
let H = 180
let PCSIZE = 192

// World units, not cells, so the scene is the same shape at any voxel size.
fn ifloor(a: float) -> int {
    let i = a as int
    if (a < 0.0) and ((i as float) != a) { return i - 1 }
    return i
}

// ---------------------------------------------------------------- terrain
// Value noise off the same 32-bit hash the shader uses. World generation runs
// only on the CPU, so this never has to agree with GLSL bit-for-bit -- but it
// does have to be deterministic, because the mirror traces the same volume.
fn vhash2(xi: int, zi: int) -> float {
    var h = (xi * 374761393 + zi * 668265263) & 4294967295
    h = (h ^ (h >> 13)) & 4294967295
    h = (h * 1274126177) & 4294967295
    h = (h ^ (h >> 16)) & 4294967295
    return (h as float) / 4294967296.0
}

fn smoothf(t: float) -> float { return t * t * (3.0 - 2.0 * t) }

fn vnoise(x: float, z: float) -> float {
    let xi = ifloor(x)
    let zi = ifloor(z)
    let fx = smoothf(x - (xi as float))
    let fz = smoothf(z - (zi as float))
    let a = vhash2(xi, zi)
    let b = vhash2(xi + 1, zi)
    let c = vhash2(xi, zi + 1)
    let d = vhash2(xi + 1, zi + 1)
    let top = a + (b - a) * fx
    let bot = c + (d - c) * fx
    return top + (bot - top) * fz
}

// Two octaves is enough to put features below one world unit, which is the
// whole point of halving VOXEL: at 1.0 these bumps would be invisible.
fn terrain_height(wx: float, wz: float) -> float {
    var h = 4.6
    h = h + 1.1 * (vnoise(wx * 0.055, wz * 0.055) - 0.5) * 2.0
    h = h + 0.45 * (vnoise(wx * 0.17, wz * 0.17) - 0.5) * 2.0
    h = h + 0.18 * (vnoise(wx * 0.51, wz * 0.51) - 0.5) * 2.0
    h = h + 0.07 * (vnoise(wx * 1.6, wz * 1.6) - 0.5) * 2.0
    return h
}

fn feature_at(wx: float, wy: float, wz: float) -> int {
    if wx >= 20.0 and wx < 28.0 and wz >= 20.0 and wz < 28.0 and wy >= 6.0 and wy < 18.0 {
        if wy >= 11.0 and wy < 13.0 { return 5 }
        return 1
    }
    if wx >= 40.0 and wx < 46.0 and wz >= 34.0 and wz < 40.0 and wy >= 6.0 and wy < 11.0 { return 1 }
    return 0
}

var layers: [str] = []
for arg in args() {
    if arg == "--validate" { layers.push("VK_LAYER_KHRONOS_validation") }
}

var g = Gfx.make("zephyr-voxel-reproject", layers, 0, 0)
print("gpu: {g.gpu_name()}")

var vox = Bytes.new(VX * VY * VZ)
for z in 0..VZ {
    let wz = ((z as float) + 0.5) * VOXEL
    for x in 0..VX {
        let wx = ((x as float) + 0.5) * VOXEL
        let gh = terrain_height(wx, wz)
        for y in 0..VY {
            let wy = ((y as float) + 0.5) * VOXEL
            var m = 0
            if wy < gh - VOXEL { m = 2 }
            else if wy < gh { m = 3 }
            else { m = feature_at(wx, wy, wz) }
            vox.put8((z * VY + y) * VX + x, m)
        }
    }
}
let vol = g.storage_image_3d(VX, VY, VZ, VK_FORMAT_R8_UINT)
g.write_volume(vol, vox, 1)

let target = g.storage_image(W, H)
let gdepth = g.storage_image_3d(W, H, 1, VK_FORMAT_R32_SFLOAT)
let gnormal = g.storage_image(W, H)
let galbedo = g.storage_image(W, H)
let gmotion = g.storage_image_3d(W, H, 1, VK_FORMAT_R16G16B16A16_SFLOAT)
let grough = g.storage_image(W, H)
let descriptors = g.storage_images_set([vol, target, gdepth, gnormal, galbedo, gmotion, grough],
                                       VK_SHADER_STAGE_COMPUTE_BIT)
let shader = g.shader("examples/shaders/voxel.comp.spv")
let entry = cbytes("main")
let pcmax = g.max_push_constants()
assert(pcmax >= PCSIZE, "device allows {pcmax} push constant bytes, this needs {PCSIZE}")
let layout = g.pipeline_layout([descriptors.layout], PCSIZE, VK_SHADER_STAGE_COMPUTE_BIT)
let pipeline = g.compute_pipeline(shader, layout, entry)
let sets = u64s([descriptors.set])

// Camera basis, shared by both frames: only the position moves.
let fwd_x = 0.0
let fwd_y = -0.35
let fwd_z = 1.0
let flen = sqrt(fwd_x * fwd_x + fwd_y * fwd_y + fwd_z * fwd_z)
let fx = fwd_x / flen
let fy = fwd_y / flen
let fz = fwd_z / flen
let rx0 = 1.0 * fz
let rz0 = 0.0 - 1.0 * fx
let rlen = sqrt(rx0 * rx0 + rz0 * rz0)
let rxn = rx0 / rlen
let ryn = 0.0
let rzn = rz0 / rlen
let ux = fy * rzn - fz * ryn
let uy = fz * rxn - fx * rzn
let uz = fx * ryn - fy * rxn
let tan_half = 0.5773502691896258

let cam_y = 22.0
let cam_z = -18.0
let cam_x0 = 32.0           // frame 0
let cam_x1 = 32.6           // frame 1: a small sideways step

var pc = Bytes.new(PCSIZE)
pc.put32(0, VX)
pc.put32(4, VY)
pc.put32(8, VZ)
pc.put32(16, W)
pc.put32(20, H)
pc.put32(24, 0)             // spp 0: no bounce, so frames differ only by geometry
pc.put32(28, 0)
pc.putf32(48, rxn)
pc.putf32(52, ryn)
pc.putf32(56, rzn)
pc.putf32(64, ux)
pc.putf32(68, uy)
pc.putf32(72, uz)
pc.putf32(80, fx)
pc.putf32(84, fy)
pc.putf32(88, fz)
pc.putf32(96, tan_half)
pc.putf32(100, 0.4)
pc.putf32(104, 0.82)
pc.putf32(108, 0.41)
pc.putf32(128, rxn)
pc.putf32(132, ryn)
pc.putf32(136, rzn)
pc.putf32(144, ux)
pc.putf32(148, uy)
pc.putf32(152, uz)
pc.putf32(160, fx)
pc.putf32(164, fy)
pc.putf32(168, fz)
pc.putf32(176, 0.0)         // no jitter: it would add a subpixel shift
pc.putf32(180, 0.0)
pc.putf32(184, VOXEL)       // world units per voxel; zero here divides by zero

let pca = pc.addr()
let pl = layout
let dsti = target.image
let gdi = gdepth.image
let gni = gnormal.image
let gai = galbedo.image
let gmi = gmotion.image
let gri = grough.image
var first = true

fn dispatch() {
    g.immediate(fn(cb: int) {
        var old = VK_IMAGE_LAYOUT_GENERAL
        if first { old = VK_IMAGE_LAYOUT_UNDEFINED }
        // The colour target is the odd one out: the trailing barrier below
        // leaves it in TRANSFER_SRC_OPTIMAL for the readback, while the guide
        // buffers come back to GENERAL via read_volume_from.
        var old_dst = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL
        if first { old_dst = VK_IMAGE_LAYOUT_UNDEFINED }
        image_barrier(cb, dsti, old_dst, VK_IMAGE_LAYOUT_GENERAL,
            VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
            0, VK_ACCESS_SHADER_WRITE_BIT)
        image_barrier(cb, gdi, old, VK_IMAGE_LAYOUT_GENERAL,
            VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
            0, VK_ACCESS_SHADER_WRITE_BIT)
        image_barrier(cb, gni, old, VK_IMAGE_LAYOUT_GENERAL,
            VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
            0, VK_ACCESS_SHADER_WRITE_BIT)
        image_barrier(cb, gai, old, VK_IMAGE_LAYOUT_GENERAL,
            VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
            0, VK_ACCESS_SHADER_WRITE_BIT)
        image_barrier(cb, gmi, old, VK_IMAGE_LAYOUT_GENERAL,
            VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
            0, VK_ACCESS_SHADER_WRITE_BIT)
        image_barrier(cb, gri, old, VK_IMAGE_LAYOUT_GENERAL,
            VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
            0, VK_ACCESS_SHADER_WRITE_BIT)
        vkCmdBindPipeline(cb, VK_PIPELINE_BIND_POINT_COMPUTE, pipeline)
        vkCmdBindDescriptorSets(cb, VK_PIPELINE_BIND_POINT_COMPUTE, pl, 0, 1, sets.addr(), 0, 0)
        vkCmdPushConstants(cb, pl, VK_SHADER_STAGE_COMPUTE_BIT, 0, PCSIZE, pca)
        vkCmdDispatch(cb, (W + 7) / 8, (H + 7) / 8, 1)
        image_barrier(cb, dsti, VK_IMAGE_LAYOUT_GENERAL, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
            VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
            VK_ACCESS_SHADER_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT)
    })
    first = false
}

// ---- frame 0: camera at cam_x0, previous camera identical so motion is zero
pc.putf32(32, cam_x0)
pc.putf32(36, cam_y)
pc.putf32(40, cam_z)
pc.putf32(112, cam_x0)
pc.putf32(116, cam_y)
pc.putf32(120, cam_z)
dispatch()
let col0 = g.read_image(dsti, W, H)
let dep0 = g.read_volume_from(gdepth, 4, VK_IMAGE_LAYOUT_GENERAL)
let mot0 = g.read_volume_from(gmotion, 8, VK_IMAGE_LAYOUT_GENERAL)

// Sanity: a stationary camera must produce no motion at all.
fn f16_from(bits: int) -> float {
    let sgn = (bits >> 15) & 1
    let exp = (bits >> 10) & 31
    let man = bits & 1023
    var v = 0.0
    if exp == 0 {
        v = (man as float) / 1024.0 / 16384.0
    } else {
        var scale = 1.0
        var n = exp - 15
        while n > 0 {
            scale = scale * 2.0
            n -= 1
        }
        while n < 0 {
            scale = scale / 2.0
            n += 1
        }
        v = (1.0 + (man as float) / 1024.0) * scale
    }
    if sgn == 1 { return 0.0 - v }
    return v
}

fn half_at(b: Bytes, off: int) -> float {
    return f16_from(b.get8(off) | (b.get8(off + 1) << 8))
}

var moving = 0
for i in 0..(W * H) {
    if abs(half_at(mot0, i * 8)) > 0.001 or abs(half_at(mot0, i * 8 + 2)) > 0.001 { moving += 1 }
}
assert(moving == 0, "{moving} pixels reported motion while the camera was still")
print("PASS: a stationary camera produces zero motion everywhere")

// ---- frame 1: camera stepped sideways, previous camera is frame 0's
pc.putf32(32, cam_x1)
pc.putf32(112, cam_x0)
dispatch()
let col1 = g.read_image(dsti, W, H)
let dep1 = g.read_volume_from(gdepth, 4, VK_IMAGE_LAYOUT_GENERAL)
let mot1 = g.read_volume_from(gmotion, 8, VK_IMAGE_LAYOUT_GENERAL)

// ---- reproject frame 1 into frame 0 and see what lands
var matched = 0
var disoccluded = 0
var offscreen = 0
var wrong = 0
var sky = 0
for y in 0..H {
    for x in 0..W {
        let i = y * W + x
        let d1 = dep1.getf32(i * 4)
        if d1 <= 0.0 {
            sky += 1
            continue
        }
        let mx = half_at(mot1, i * 8)
        let my = half_at(mot1, i * 8 + 2)
        let sxf = (x as float) + 0.5 + mx
        let syf = (y as float) + 0.5 + my
        let sx = sxf as int
        let sy = syf as int
        if sx < 0 or sy < 0 or sx >= W or sy >= H {
            offscreen += 1
            continue
        }
        let j = sy * W + sx
        let d0 = dep0.getf32(j * 4)
        // A depth jump means the surface was hidden last frame. That is a
        // disocclusion, not a bad motion vector.
        if d0 <= 0.0 or abs(d0 - d1) > 0.75 {
            disoccluded += 1
            continue
        }
        // Accept the best of the 3x3 neighbourhood. At an eighth of a unit the
        // terrain has detail at roughly the pixel scale, so a vector that is
        // correct to a fraction of a pixel still lands on a different micro
        // facet under nearest-neighbour lookup. A vector that is actually
        // wrong -- flipped sign, wrong units -- misses by far more than one
        // pixel and this does not rescue it.
        var best = 999
        for oy in 0..3 {
            for ox in 0..3 {
                let nx2 = sx + ox - 1
                let ny2 = sy + oy - 1
                if nx2 < 0 or ny2 < 0 or nx2 >= W or ny2 >= H { continue }
                let k = ny2 * W + nx2
                let dr = abs(col1.get8(i * 4) - col0.get8(k * 4))
                let dg = abs(col1.get8(i * 4 + 1) - col0.get8(k * 4 + 1))
                let db = abs(col1.get8(i * 4 + 2) - col0.get8(k * 4 + 2))
                var d = dr
                if dg > d { d = dg }
                if db > d { d = db }
                if d < best { best = d }
            }
        }
        if best <= 6 { matched += 1 } else { wrong += 1 }
    }
}

let geom = W * H - sky
print("reprojected {geom} geometry pixels:")
print("  matched      {matched}")
print("  disoccluded  {disoccluded}")
print("  offscreen    {offscreen}")
print("  mismatched   {wrong}")

// If the convention were wrong -- a flipped sign, or pixels versus normalised
// units -- reprojection would land on unrelated surfaces and `wrong` would
// dominate. Disocclusions are legitimate and are counted separately.
let valid = matched + wrong
assert(valid > geom / 2, "too few pixels had a usable history ({valid} of {geom})")
assert(matched * 50 > valid * 49,
       "only {matched} of {valid} reprojected pixels matched; motion vectors look wrong")
print("PASS: {matched} of {valid} reprojected pixels found the same surface within a pixel")

g.destroy_image(grough)
g.destroy_image(gmotion)
g.destroy_image(galbedo)
g.destroy_image(gnormal)
g.destroy_image(gdepth)
g.destroy_image(target)
g.destroy_image(vol)
print("PASS: resources destroyed cleanly")
