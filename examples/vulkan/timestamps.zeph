// Headless timestamp smoke test: two stamps around a transfer command.
import "vk/gfx.zeph"

var layers: [str] = []
for a in args() {
    if a == "--validate" { layers.push("VK_LAYER_KHRONOS_validation") }
}
let g = Gfx.init("zephyr-timestamps", layers)
let pool = QueryPool.new(g, 2)
let buf = g.buffer(4096, VK_BUFFER_USAGE_TRANSFER_DST_BIT, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT)
g.immediate(fn(cmd: int) {
    pool.reset(cmd)
    pool.stamp(cmd, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, 0)
    vkCmdFillBuffer(cmd, buf.buf, 0, buf.size, 0)
    pool.stamp(cmd, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, 1)
})
let ns = pool.read_ns(0, 1)
assert(ns >= 0, "GPU timestamp delta was negative")
print("GPU timestamp delta: {ns} ns")
pool.destroy()
g.destroy_buffer(buf)
g.shutdown()
