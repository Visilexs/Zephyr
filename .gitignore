# Build artifacts. Everything here is regenerable from source.
#
# zc.exe is NOT ignored: it is the seed the self-hosting loop needs. A fresh
# clone can rebuild it with .\bootstrap\build.ps1, but keeping it committed
# means selfbuild.ps1 works immediately.

*.exe
!zc.exe
!bootstrap/zephyr.exe

*.o
*.obj
*.s

# rendered output
out.bmp
out.png

# package.ps1 output (dist/GETTING-STARTED.md is a source and stays)
dist/zephyr-*/
dist/*.zip

# copied next to test outputs by bootstrap/build.ps1
zephyr_rt.dll

# Native link artifacts. No .dll/.lib/.exp/.def is a source in this repo.
#
# vxngx.dll matters most: spikes/ngx/build.bat links it against
# nvsdk_ngx_s.lib, so the built DLL contains NVIDIA's proprietary NGX code.
# The shim source (vxngx.c) and its build script are tracked; the binary is
# rebuilt from the SDK via the DLSS_SDK environment variable and must never
# be committed.
*.dll
*.lib
*.exp
*.def

# rendered output
voxel.bmp
