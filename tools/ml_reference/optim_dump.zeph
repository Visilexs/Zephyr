// Mirrored LCG fixture; Python reconstructs every input independently.
import "ml/optim.zeph"

var OPTIM_SEED = 20260921
fn optim_rnd() -> float {
    OPTIM_SEED = (OPTIM_SEED * 1103515245 + 12345) % 2147483648
    return ((OPTIM_SEED % 20001) as float) / 100000.0 - 0.1
}

fn optim_fixture(d: DType, shape: [int], gradient: bool) -> Tensor {
    let t = t_zeros(d, shape)
    var idx = idx_zeros(shape.len())
    for j in 0..t_numel(t) {
        var re = optim_rnd()
        if dtype_is_complex(d) {
            var im = optim_rnd()
            if gradient {
                re = re * 0.001
                im = im * 1000.0
            }
            t_set_c(t, idx, re, im)
        } else {
            if gradient and j == 0 { re = 0.0 }
            t_set(t, idx, re)
        }
        idx_next(idx, shape)
    }
    return t
}

fn optim_dump(tag: str, t: Tensor) {
    var idx = idx_zeros(t.shape.len())
    for j in 0..t_numel(t) {
        if dtype_is_complex(t.dt) {
            print("{tag} {bits(t_get_re(t, idx))} {bits(t_get_im(t, idx))}")
        } else { print("{tag} {bits(t_get(t, idx))}") }
        idx_next(idx, t.shape)
    }
}

let real = optim_fixture(DType.F64, [2, 3], false)
let complex = optim_fixture(DType.C64, [2, 2], false)
var real_grads: [Tensor] = []
var complex_grads: [Tensor] = []
optim_dump("input.real", real)
optim_dump("input.complex", complex)
for step in 0..3 {
    real_grads.push(optim_fixture(DType.F64, [2, 3], true))
    complex_grads.push(optim_fixture(DType.C64, [2, 2], true))
    optim_dump("input.g{step}.real", real_grads[step])
    optim_dump("input.g{step}.complex", complex_grads[step])
}

for kind in 0..3 {
    let params = [t_copy(real), t_copy(complex)]
    var o = sgd_new(params, 0.03, 0.0, 0.07)
    var tag = "sgd"
    if kind == 1 {
        o = sgd_new(params, 0.03, 0.6, 0.07)
        tag = "momentum"
    }
    if kind == 2 {
        o = adamw_new(params, 0.03, 0.8, 0.95, 0.00000001, 0.07)
        tag = "adamw"
    }
    for step in 0..3 {
        optim_step(o, params, [real_grads[step], complex_grads[step]])
        optim_dump("{tag}.{step}.real", params[0])
        optim_dump("{tag}.{step}.complex", params[1])
        optim_dump("{tag}.{step}.m.real", o.m[0])
        optim_dump("{tag}.{step}.m.complex", o.m[1])
        optim_dump("{tag}.{step}.v.real", o.v[0])
        optim_dump("{tag}.{step}.v.complex", o.v[1])
        let count = o.step as float
        print("{tag}.{step}.count {bits(count)}")
    }
}
let clipped = [t_copy(real_grads[0]), t_copy(complex_grads[0])]
let norm = clip_grad_norm(clipped, 0.5)
print("clip.norm {bits(norm)}")
optim_dump("clip.real", clipped[0])
optim_dump("clip.complex", clipped[1])
let small_norm = clip_grad_norm(clipped, 1.0)
print("clip.small_norm {bits(small_norm)}")
optim_dump("clip.unchanged.real", clipped[0])
optim_dump("clip.unchanged.complex", clipped[1])
