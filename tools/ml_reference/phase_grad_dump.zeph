// Native gradients of the phase model, for comparison against the float64
// reference's analytic reverse pass -- acceptance A06 and A14.
//
// Finite differences already cover these gradients in
// tests/ml/phase_ad_test.zeph, but a stencil is the weakest oracle available:
// the reference's analytic reverse pass agrees with its own finite
// differences two orders tighter than the stencil's own error floor, so
// comparing against it is a strictly sharper test.
//
// The weights come from the same LCG and the same fill order as
// phase_dump.zeph, so check_phase_grad.py can rebuild them independently and
// assert they are bit-identical before comparing any gradient. No reference
// value ever reaches this program.
import "ml/phase_ad.zeph"

var SEED = 20260921
fn rnd() -> float {
    SEED = (SEED * 1103515245 + 12345) % 2147483648
    return ((SEED % 20001) as float) / 100000.0 - 0.1
}

fn dumpR(tag: str, t: Tensor) {
    var idx = indexZeros(t.shape.len())
    var more = tensorElementCount(t) > 0
    while more {
        print("{tag} {bits(tensorGet(t, idx))}")
        more = indexNext(idx, t.shape)
    }
}

fn dumpC(tag: str, t: Tensor) {
    var idx = indexZeros(t.shape.len())
    var more = tensorElementCount(t) > 0
    while more {
        print("{tag} {bits(tensorGetReal(t, idx))} {bits(tensorGetImaginary(t, idx))}")
        more = indexNext(idx, t.shape)
    }
}

fn fill_random(t: Tensor) {
    var idx = indexZeros(t.shape.len())
    var more = tensorElementCount(t) > 0
    while more {
        let re = rnd()
        if dtypeIsComplex(t.dtype) {
            let im = rnd()
            tensorSetComplex(t, idx, re, im)
        } else {
            tensorSet(t, idx, re)
        }
        more = indexNext(idx, t.shape)
    }
}

fn dump_grads(d: int, tag: str) {
    SEED = 20260921
    let config = PhaseConfig{inputVocab: 7, outputVocab: 3, stateDimension: d, embeddingDimension: 3, hiddenDimension: 5, thinkSteps: 4, padToken: 0, epsilon: 0.00000001}
    let embedding = tensorZeros(DType.F64, [7, 3])
    let think = tensorZeros(DType.F64, [3])
    let W1 = tensorZeros(DType.F64, [5, 3 + 3 * d])
    let b1 = tensorZeros(DType.F64, [5])
    let W2 = tensorZeros(DType.F64, [3 * d, 5])
    let b2 = tensorZeros(DType.F64, [3 * d])
    let z_init = tensorZeros(DType.C64, [d])
    let M = tensorZeros(DType.C64, [3, d])
    let tensors = [embedding, think, W1, b1, W2, b2, z_init, M]
    for i in 0..tensors.len() { fill_random(tensors[i]) }
    let p = PhaseParams{config: config, embedding: embedding, think: think, hiddenWeight: W1, hiddenBias: b1, angleWeight: W2, angleBias: b2, initialState: z_init, readoutMatrix: M}

    let tokens = tensorZeros(DType.I64, [3, 4])
    let values = [[1, 2, 3, 4], [5, 6, 0, 0], [0, 0, 0, 0]]
    for row in 0..3 {
        for step in 0..4 { tensorSetInt(tokens, [row, step], values[row][step]) }
    }
    let targets = [0, 2, 1]

    autogradReset()
    let m = phaseAutogradParameters(p, true)
    let loss = phaseAutogradLoss(m, tokens, targets)
    autogradBackward(loss)

    dumpR("{tag}.loss", autogradValue(loss))
    dumpR("{tag}.grad.embedding", autogradGradient(m.embedding))
    dumpR("{tag}.grad.think", autogradGradient(m.think))
    dumpR("{tag}.grad.W1", autogradGradient(m.hiddenWeight))
    dumpR("{tag}.grad.b1", autogradGradient(m.hiddenBias))
    dumpR("{tag}.grad.W2", autogradGradient(m.angleWeight))
    dumpR("{tag}.grad.b2", autogradGradient(m.angleBias))
    dumpC("{tag}.grad.z_init", autogradGradient(m.initialState))
    dumpC("{tag}.grad.M", autogradGradient(m.readoutMatrix))
}

dump_grads(4, "D4")
dump_grads(8, "D8")
