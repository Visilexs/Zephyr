// ---------------------------------------------------------------- emitter

import "std/string.zeph"

fn pad4(n: int) -> str { return "    ".repeat(n) }

struct Em {
    lines: [str] = []
    ind: int = 0
    ren: [str: str]
    memberEnum: [str: str]
    memberPayload: [str: bool]
    optScopes: [[str: bool]] = []
    tmpc: int = 0
    contLabel: str = ""
    structNames: [str: bool]
    memberRef: [str: str]
}

fn newEm() -> Em {
    var ren: [str: str] = [:]
    var me: [str: str] = [:]
    var mp: [str: bool] = [:]
    var sn: [str: bool] = [:]
    var mr: [str: str] = [:]
    return Em{lines: [], ind: 0, ren: ren, memberEnum: me, memberPayload: mp, optScopes: [], tmpc: 0, contLabel: "", structNames: sn, memberRef: mr}
}

fn ssHasCont(ss: [Stmt]) -> bool {
    for s in ss {
        match s.k {
            9 { if s.label == "" { return true } }
            2 {
                if s.thenB.len() > 0 and ssHasCont(s.thenB) { return true }
                if s.elseB.len() > 0 and ssHasCont(s.elseB) { return true }
            }
            3, 4 { if ssHasCont(s.body) { return true } }
            5 {
                for a in s.arms {
                    if ssHasCont(a.body) { return true }
                }
            }
            else { }
        }
    }
    return false
}

impl Em {
    fn line(self, s: str) { self.lines.push(pad4(self.ind) + s) }
    fn blank(self) { self.lines.push("") }

    fn initRen(self) {
        var reserved = ["end", "function", "local", "if", "then", "do", "repeat", "until",
                        "else", "elseif", "return", "in", "for", "while", "break", "continue",
                        "and", "or", "nil", "true", "false"]
        for w in reserved { self.ren[w] = "_z_" + w }
    }

    fn nm(self, name: str) -> str {
        if self.ren.has(name) { return self.ren.get(name).or("") }
        return name
    }

    fn openScope(self) {
        var sc: [str: bool] = [:]
        self.optScopes.push(sc)
    }
    fn closeScope(self) { if self.optScopes.len() > 0 { self.optScopes.pop() } }
    fn declareOpt(self, names: [str], opt: bool) {
        if self.optScopes.len() == 0 { return }
        var sc = self.optScopes[self.optScopes.len() - 1]
        for n in names { sc[n] = opt }
    }
    fn isOpt(self, name: str) -> bool {
        for i in self.optScopes.len() - 1 .. 0 step -1 {
            var sc = self.optScopes[i]
            if sc.has(name) { return sc.get(name).or(false) }
        }
        return false
    }

    fn tmp(self, prefix: str) -> str { self.tmpc += 1
 return prefix + (self.tmpc as str) }

    fn runDefers(self, dfv: str) {
        self.line("do local __i = #" + dfv + " while __i >= 1 do " + dfv + "[__i]() __i = __i - 1 end end")
    }

    // ------------------------------------------------ program

    fn emitProgram(self, tops: [Top], srcPath: str) -> str {
        self.initRen()
        self.line("-- generated by zeph2lua from " + srcPath)
        self.line("-- Luau output: types erased, lists stay 1-based (Zephyr 0-based indices are NOT shifted)")
        self.blank()
        self.emitPreamble()
        var seenImp: [str: bool] = [:]
        for t in tops {
            if t.k == 0 and not seenImp.has(t.path) {
                seenImp[t.path] = true
                self.emitImport(t)
            }
        }
        for t in tops { if t.k == 3 { self.emitEnum(t) } }
        for t in tops {
            if t.k == 2 {
                self.line("-- struct " + t.sdecl.name + " \{ " + joinFields(t.sdecl.fields) + " \}")
                self.line("local " + t.sdecl.name + " = \{\}")
                self.structNames[t.sdecl.name] = true
            }
            if t.k == 6 { self.line("-- type " + t.name + " (alias, erased)") }
            if t.k == 5 { self.line("-- interface " + t.name + " (erased)") }
            if t.k == 7 { self.line("-- test \"" + t.name + "\" (skipped by zeph2lua)") }
            if t.k == 8 { self.line("-- extern fn " + t.name + " (native interop: provide a Lua shim)") }
        }
        var hasMain = false
        for t in tops {
            if t.k == 1 {
                self.emitTopFn(t)
                if t.name == "main" { hasMain = true }
            }
        }
        for t in tops {
            if t.k == 4 {
                for f in t.implFns { self.emitImplMethod(t.name, f) }
            }
        }
        self.openScope()
        for t in tops {
            if t.k == 9 { self.emitStmt(t.st, "") }
        }
        self.closeScope()
        if hasMain { self.line("main()") }
        var out = ""
        for l in self.lines { out += l + "\n" }
        return out
    }

    fn emitTopFn(self, t: Top) {
        self.line("function " + self.nm(t.name) + "(" + paramNames(t.params) + ")")
        self.ind += 1
        self.emitDefaults(t.params)
        self.openScope()
        self.emitBlock(t.body)
        self.closeScope()
        self.ind -= 1
        self.line("end")
        self.blank()
    }

    fn emitImplMethod(self, tname: str, f: IFn) {
        self.line("function " + tname + "." + f.name + "(" + paramNames(f.params) + ")")
        self.ind += 1
        self.emitDefaults(f.params)
        self.openScope()
        self.emitBlock(f.body)
        self.closeScope()
        self.ind -= 1
        self.line("end")
        self.blank()
    }

    fn emitDefaults(self, ps: [Param]) {
        for p in ps {
            if p.hasDef {
                self.line("if " + p.name + " == nil then " + p.name + " = " + self.emitExpr(p.def) + " end")
            }
        }
    }

    // ------------------------------------------------ blocks & statements

    fn emitBlock(self, ss: [Stmt]) {
        var hasDefer = false
        for s in ss { if s.k == 6 { hasDefer = true } }
        var dfv = ""
        if hasDefer {
            dfv = self.tmp("__df")
            self.line("local " + dfv + " = \{\}")
        }
        self.openScope()
        for s in ss {
            if s.k == 6 {
                self.line("table.insert(" + dfv + ", function()")
                self.ind += 1
                for d in s.body { self.emitStmt(d, "") }
                self.ind -= 1
                self.line("end)")
                continue
            }
            self.emitStmt(s, dfv)
        }
        self.closeScope()
        if hasDefer { self.runDefers(dfv) }
    }

    fn emitStmt(self, st: Stmt, dfv: str) {
        match st.k {
            0 {
                if st.names.len() > 1 {
                    var tt = self.tmp("__t")
                    self.line("local " + tt + " = " + self.emitExpr(st.e))
                    var assigns = ""
                    for n in st.names { assigns += self.nm(n) + ", " }
                    assigns = assigns.sub(0, assigns.len() - 2)
                    var idxs = ""
                    for i in 0..st.names.len() { idxs += tt + "[" + ((i + 1) as str) + "], " }
                    idxs = idxs.sub(0, idxs.len() - 2)
                    self.line("local " + assigns + " = " + idxs)
                } else {
                    self.line("local " + self.nm(st.names[0]) + " = " + self.emitExpr(st.e))
                }
                self.declareOpt(st.names, st.opt)
            }
            1 {
                var base = ""
                match st.tgtK {
                    0 { base = self.nm(st.tgtName) }
                    1 { base = self.emitExpr(st.tgtBase) + "." + st.tgtName }
                    2 { base = self.emitExpr(st.tgtBase) + "[" + self.emitExpr(st.tgtIdx) + "]" }
                    else { panic("bad target") }
                }
                var rhs = self.emitExpr(st.e)
                match st.op {
                    "=" { self.line(base + " = " + rhs) }
                    "+=" { self.line(base + " = zadd(" + base + ", " + rhs + ")") }
                    "-=" { self.line(base + " = " + base + " - " + rhs) }
                    "*=" { self.line(base + " = " + base + " * " + rhs) }
                    "/=" { self.line(base + " = zdiv(" + base + ", " + rhs + ")") }
                    "%=" { self.line(base + " = zmod(" + base + ", " + rhs + ")") }
                    "&=" { self.line(base + " = " + base + " & " + rhs) }
                    "|=" { self.line(base + " = " + base + " | " + rhs) }
                    "^=" { self.line(base + " = " + base + " ~ " + rhs) }
                    "<<=" { self.line(base + " = " + base + " << " + rhs) }
                    ">>=" { self.line(base + " = " + base + " >> " + rhs) }
                    else { panic("bad op " + st.op) }
                }
            }
            2 { self.emitIfChain(st, dfv) }
            3 {
                if st.label != "" { self.line("-- label " + st.label + " (labeled break not lowered; innermost only)") }
                self.line("while " + self.emitExpr(st.e) + " do")
                self.ind += 1
                if ssHasCont(st.body) { self.contLabel = self.tmp("__c") }
                self.emitBlock(st.body)
                if self.contLabel != "" { self.line("::" + self.contLabel + "::")
 self.contLabel = "" }
                self.ind -= 1
                self.line("end")
            }
            4 { self.emitFor(st) }
            5 { self.emitMatch(st) }
            7 {
                if dfv != "" { self.runDefers(dfv) }
                if st.e.k != 0 or st.e.a != "" { self.line("return " + self.emitExpr(st.e)) } else { self.line("return") }
            }
            8 {
                if st.label != "" { self.line("-- labeled break " + st.label + " lowered to plain break") }
                self.line("break")
            }
            9 {
                if st.label != "" { self.line("-- labeled continue " + st.label + " lowered to plain continue") }
                if self.contLabel != "" { self.line("goto " + self.contLabel) } else { self.line("continue") }
            }
            10 { self.line(self.emitExpr(st.e)) }
            11 {
                self.line("local function " + self.nm(st.fnName) + "(" + paramNames(st.params) + ")")
                self.ind += 1
                self.emitDefaults(st.params)
                self.openScope()
                self.emitBlock(st.body)
                self.closeScope()
                self.ind -= 1
                self.line("end")
            }
            else { panic("unhandled stmt kind " + (st.k as str)) }
        }
    }

    fn emitIfChain(self, st: Stmt, dfv: str) {
        var head = st
        if head.letName != "" {
            self.line("if " + self.emitExpr(head.e) + " ~= nil then")
            self.ind += 1
            self.line("local " + self.nm(head.letName) + " = " + self.emitExpr(head.e))
            self.emitBlock(head.thenB)
            self.ind -= 1
            self.line("end")
            return
        }
        self.line("if " + self.emitExpr(head.e) + " then")
        self.ind += 1
        self.emitBlock(head.thenB)
        self.ind -= 1
        var cur = head
        while cur.elseB.len() == 1 and cur.elseB[0].k == 2 and cur.elseB[0].letName == "" {
            var nxt = cur.elseB[0]
            self.line("elseif " + self.emitExpr(nxt.e) + " then")
            self.ind += 1
            self.emitBlock(nxt.thenB)
            self.ind -= 1
            cur = nxt
        }
        if cur.elseB.len() > 0 {
            self.line("else")
            self.ind += 1
            self.emitBlock(cur.elseB)
            self.ind -= 1
        }
        self.line("end")
    }

    fn emitFor(self, st: Stmt) {
        var v1 = self.nm(st.v1)
        if st.hi.k != 0 or st.hi.a != "" {
            var loT = self.emitExpr(st.lo)
            var hiT = self.emitExpr(st.hi)
            if st.hasStep {
                self.line("for " + v1 + " = " + loT + ", " + hiT + ", " + self.emitExpr(st.step) + " do")
            } else {
                self.line("for " + v1 + " = " + loT + ", " + hiT + " - 1 do")
            }
        } else {
            var iterT = self.emitExpr(st.lo)
            if st.v2 != "" {
                if st.lo.k == 1 or st.lo.k == 19 {
                    self.line("for __zi = 1, #" + iterT + " do")
                    self.line("local " + v1 + " = __zi - 1")
                    self.line("local " + self.nm(st.v2) + " = " + iterT + ":byte(__zi)")
                } else {
                    self.line("for __zi, " + self.nm(st.v2) + " in ipairs(" + iterT + ") do")
                    self.line("local " + v1 + " = __zi - 1")
                }
            } else {
                if st.lo.k == 1 or st.lo.k == 19 {
                    self.line("for __zi = 1, #" + iterT + " do")
                    self.line("local " + v1 + " = " + iterT + ":byte(__zi)")
                } else {
                    self.line("for _, " + v1 + " in ipairs(" + iterT + ") do")
                }
            }
        }
        self.ind += 1
        if ssHasCont(st.body) { self.contLabel = self.tmp("__c") }
        self.emitBlock(st.body)
        if self.contLabel != "" { self.line("::" + self.contLabel + "::")
 self.contLabel = "" }
        self.ind -= 1
        self.line("end")
    }

    fn armCond(self, m: str, a: Arm) -> str {
        var conds = ""
        for i in 0..a.pats.len() {
            var c = ""
            var mn = a.members[i]
            if a.binds.len() > 0 and mn != "" {
                c = m + " ~= nil and " + m + ".__e == \"" + mn + "\""
            } else if mn != "" {
                if self.memberRef.has(mn) {
                    c = m + " == " + self.memberRef.get(mn).or(mn)
                } else {
                    c = m + " == " + mn
                }
            } else if a.isRange[i] {
                c = m + " >= " + self.emitExpr(a.pats[i]) + " and " + m + " < " + self.emitExpr(a.hi[i])
            } else {
                c = m + " == " + self.emitExpr(a.pats[i])
            }
            if i > 0 { conds += " or " }
            conds += c
        }
        return conds
    }

    fn emitMatch(self, st: Stmt) {
        var m = self.tmp("__m")
        self.line("local " + m + " = " + self.emitExpr(st.e))
        var first = true
        var hasElse = false
        for a in st.arms {
            if a.isElse { hasElse = true
 continue }
            if first { self.line("if " + self.armCond(m, a) + " then")
 first = false }
            else { self.line("elseif " + self.armCond(m, a) + " then") }
            self.ind += 1
            for j in 0..a.binds.len() {
                self.line("local " + a.binds[j] + " = " + m + ".v[" + ((j + 1) as str) + "]")
            }
            self.emitBlock(a.body)
            self.ind -= 1
        }
        if hasElse {
            self.line("else")
            self.ind += 1
            var ea = st.arms[st.arms.len() - 1]
            self.emitBlock(ea.body)
            self.ind -= 1
        } else {
            self.line("else")
            self.line("error(\"no matching arm\")")
        }
        self.line("end")
    }

    // ------------------------------------------------ expressions

    fn emitExpr(self, e: Expr) -> str {
        match e.k {
            0 { return e.a }
            1 { return luaStr(e.a) }
            19 { return luaStrRaw(e.a) }
            2 { return e.a }
            3 { return "nil" }
            4 { return self.nm(e.a) }
            5 { return self.emitBin(e) }
            6 {
                var x = self.emitExpr(e.kids[0])
                match e.a {
                    "-" { return "-(" + x + ")" }
                    "not" { return "not " + x }
                    "~" { return "bxor(" + x + ", -1)" }
                    else { panic("bad unary") }
                }
            }
            7 { return self.emitCall(e) }
            8 { return self.emitExpr(e.kids[0]) + "[" + self.emitExpr(e.kids[1]) + "]" }
            9 {
                var base = self.emitExpr(e.kids[0])
                if isDigitStr(e.b) { return base + "[" + ((strIntVal(e.b) + 1) as str) + "]" }
                return base + "." + e.b
            }
            10 {
                var s = ""
                for p in e.parts { if s != "" { s += ", " }
 s += self.emitExpr(p) }
                return "\{" + s + "\}"
            }
            11 {
                var s = ""
                for i in 0..e.keys.len() {
                    if s != "" { s += ", " }
                    s += "[" + self.emitExpr(e.keys[i]) + "] = " + self.emitExpr(e.parts[i])
                }
                return "\{" + s + "\}"
            }
            12 {
                var s = ""
                for i in 0..e.keys.len() {
                    if s != "" { s += ", " }
                    s += e.keys[i].a + " = " + self.emitExpr(e.parts[i])
                }
                if self.structNames.has(e.a) { return "setmetatable(\{" + s + "\}, \{__index = " + e.a + "\})" }
                return "\{" + s + "\}"
            }
            13 { return self.emitClosure(e) }
            14 {
                var c = self.emitExpr(e.kids[0])
                var t = self.emitExpr(e.kids[1])
                var f = self.emitExpr(e.kids[2])
                return ("(function()\n" + pad4(self.ind + 1) + "if " + c + " then return " + t + "\n"
                    + pad4(self.ind + 1) + "else return " + f + "\n"
                    + pad4(self.ind) + "end\n" + pad4(self.ind) + "end)()")
            }
            15 { return self.emitMatchExpr(e) }
            16 {
                var s = ""
                for p in e.parts { if s != "" { s += ", " }
 s += self.emitExpr(p) }
                return "\{" + s + "\}"
            }
            17 { return self.emitExpr(e.kids[0]) }
            18 { return "tostring(" + self.emitExpr(e.kids[0]) + ")" }
            else { panic("unhandled expr kind " + (e.k as str)) }
        }
    }

    fn dotOperand(self, x: Expr) -> str {
        if x.k == 0 or x.k == 1 or x.k == 19 or x.k == 2 { return self.emitExpr(x) }
        return "tostring(" + self.emitExpr(x) + ")"
    }

    fn emitBin(self, e: Expr) -> str {
        var l = self.emitExpr(e.kids[0])
        var r = self.emitExpr(e.kids[1])
        match e.a {
            "+" { return "zadd(" + l + ", " + r + ")" }
            "-", "*" { return l + " " + e.a + " " + r }
            "/" { return "zdiv(" + l + ", " + r + ")" }
            "%" { return "zmod(" + l + ", " + r + ")" }
            "==" { return l + " == " + r }
            "!=" { return l + " ~= " + r }
            "<", "<=", ">", ">=" { return l + " " + e.a + " " + r }
            "&", "|", "<<", ">>" { return l + " " + e.a + " " + r }
            "^" { return l + " ~ " + r }
            "and", "or" { return l + " " + e.a + " " + r }
            ".." { return self.dotOperand(e.kids[0]) + " .. " + self.dotOperand(e.kids[1]) }
            "is" {
                var rn = e.kids[1].a
                if self.memberPayload.has(rn) {
                    return l + " ~= nil and " + l + ".__e == \"" + rn + "\""
                }
                if self.memberRef.has(rn) {
                    return l + " == " + self.memberRef.get(rn).or(rn)
                }
                return l + " == " + r
            }
            else { panic("bad binop " + e.a) }
        }
    }

    fn emitCall(self, e: Expr) -> str {
        var callee = e.kids[0]
        var argsT = ""
        for a in e.parts {
            if argsT != "" { argsT += ", " }
            argsT += self.emitExpr(a)
        }
        if callee.k == 9 {
            var recvT = self.emitExpr(callee.kids[0])
            var m = callee.b
            var a0 = ""
            var a1 = ""
            if e.parts.len() > 0 { a0 = self.emitExpr(e.parts[0]) }
            if e.parts.len() > 1 { a1 = self.emitExpr(e.parts[1]) }
            var recvIsOptName = callee.kids[0].k == 4 and self.isOpt(callee.kids[0].a)
            var isEnumCtor = false
            if callee.k == 9 and callee.kids[0].k == 4 {
                var baseN = callee.kids[0].a
                var memN = callee.b
                if self.memberPayload.has(memN) and self.memberEnum.has(memN) and self.memberEnum.get(memN).or("") == baseN + "_" + memN { isEnumCtor = true }
            }
            match m {
                "len" { return "#" + recvT }
                "push" { return "table.insert(" + recvT + ", " + a0 + ")" }
                "pop" { return "table.remove(" + recvT + ")" }
                "sort" { return "table.sort(" + recvT + ")" }
                "join" {
                    if e.parts.len() == 0 { return "table.concat(" + recvT + ")" }
                    return "table.concat(" + recvT + ", " + a0 + ")"
                }
                "byte" { return recvT + ":byte(" + a0 + " + 1)" }
                "sub" { return recvT + ":sub(" + a0 + " + 1, " + a1 + ")" }
                "contains" { return recvT + ":find(" + a0 + ", nil, true) ~= nil" }
                "indexOf" { return "((" + recvT + ":find(" + a0 + ", nil, true)) or 0) - 1" }
                "startsWith" { return recvT + ":sub(1, #" + a0 + ") == " + a0 }
                "endsWith" { return "(#" + a0 + " == 0) or " + recvT + ":sub(-#" + a0 + ") == " + a0 }
                "split" { return "zsplit(" + recvT + ", " + a0 + ")" }
                "replace" { return "zreplace(" + recvT + ", " + a0 + ", " + a1 + ")" }
                "upper" { return recvT + ":upper()" }
                "lower" { return recvT + ":lower()" }
                "trim" { return "ztrim(" + recvT + ")" }
                "repeat" { return recvT + ":rep(" + a0 + ")" }
                "keys" { return "zkeys(" + recvT + ")" }
                "values" { return "zvals(" + recvT + ")" }
                "has" {
                    if recvIsOptName { return "(" + recvT + " ~= nil)" }
                    return "(" + recvT + "[" + a0 + "] ~= nil)"
                }
                "get" {
                    if recvIsOptName and e.parts.len() == 0 { return recvT }
                    return recvT + "[" + a0 + "]"
                }
                "or" {
                    if recvIsOptName { return "(" + recvT + " or " + a0 + ")" }
                    var inner = callee.kids[0]
                    if inner.k == 7 and inner.kids[0].k == 9 and inner.kids[0].b == "get" {
                        return "(" + recvT + " or " + a0 + ")"
                    }
                    return recvT + ":or(" + argsT + ")"
                }
                else {
                    if isEnumCtor { return recvT + "." + m + "(" + argsT + ")" }
                    return recvT + ":" + m + "(" + argsT + ")"
                }
            }
        }
        if callee.k == 4 {
            match callee.a {
                "print" { return "print(" + argsT + ")" }
                "panic" { return "error(" + argsT + ")" }
                "emit" { return "io.write(" + argsT + ")" }
                "chr" { return "string.char(" + argsT + ")" }
                "sqrt" { return "math.sqrt(" + argsT + ")" }
                "abs" { return "math.abs(" + argsT + ")" }
                "min" { return "math.min(" + argsT + ")" }
                "max" { return "math.max(" + argsT + ")" }
                "assert" { return "assert(" + argsT + ")" }
                "zeros" { return "zzeros(" + argsT + ")" }
                "args" { return "zargs" }
                "pow" {
                    var pb = self.emitExpr(e.parts[0])
                    var pe = self.emitExpr(e.parts[1])
                    return pb + " ^ " + pe
                }
                "bits", "floatFromBits" { return callee.a + "(" + argsT + ") -- stub: IEEE bit pattern not available in Lua" }
                else { return self.nm(callee.a) + "(" + argsT + ")" }
            }
        }
        return self.emitExpr(callee) + "(" + argsT + ")"
    }

    fn emitClosure(self, e: Expr) -> str {
        var out = "function(" + paramNames(e.params) + ")\n"
        for p in e.params {
            if p.hasDef {
                out += pad4(self.ind + 1) + "if " + p.name + " == nil then " + p.name + " = " + self.emitExpr(p.def) + " end\n"
            }
        }
        var savedInd = self.ind
        self.ind += 1
        self.openScope()
        var bodyLines: [str] = []
        var savedLines = self.lines
        self.lines = bodyLines
        self.emitBlock(e.body)
        self.lines = savedLines
        self.closeScope()
        self.ind = savedInd
        for l in bodyLines { out += l + "\n" }
        out += pad4(self.ind) + "end"
        return out
    }

    fn emitMatchExpr(self, e: Expr) -> str {
        var m = self.tmp("__m")
        var subj = self.emitExpr(e.kids[0])
        var out = "(function()\n"
        out += pad4(self.ind + 1) + "local " + m + " = " + subj + "\n"
        var first = true
        var hasElse = false
        for a in e.arms {
            if a.isElse { hasElse = true
 continue }
            if first { out += pad4(self.ind + 1) + "if " + self.armCond(m, a) + " then return " + self.emitExpr(a.ex) + "\n"
 first = false }
            else { out += pad4(self.ind + 1) + "elseif " + self.armCond(m, a) + " then return " + self.emitExpr(a.ex) + "\n" }
        }
        if hasElse {
            var ea = e.arms[e.arms.len() - 1]
            out += pad4(self.ind + 1) + "else return " + self.emitExpr(ea.ex) + "\n"
        } else {
            out += pad4(self.ind + 1) + "else return error(\"no matching arm\")\n"
        }
        out += pad4(self.ind + 1) + "end\n"
        out += pad4(self.ind) + "end)()"
        return out
    }

    // ------------------------------------------------ enums & imports

    fn emitEnum(self, t: Top) {
        var payload = false
        for m in t.emembers { if m.nvals > 0 { payload = true } }
        if not payload {
            var s = ""
            for i in 0..t.emembers.len() {
                var m = t.emembers[i]
                if s != "" { s += ", " }
                s += m.name + " = " + (i as str)
                if not self.memberEnum.has(m.name) { self.memberEnum[m.name] = t.name }
                self.memberPayload[m.name] = false
                self.memberRef[m.name] = t.name + "." + m.name
            }
            s += ", count = " + (t.emembers.len() as str)
            self.line("local " + t.name + " = \{ " + s + " \}")
            return
        }
        for m in t.emembers {
            if m.nvals > 0 {
                var ps = ""
                for j in 0..m.nvals { if j > 0 { ps += ", " }
 ps += "v" + (j as str) }
                var fields = ""
                for j in 0..m.nvals { if j > 0 { fields += ", " }
 fields += "v" + (j as str) }
                self.line("local function " + t.name + "_" + m.name + "(" + ps + ")")
                self.line("return \{ __e = \"" + m.name + "\", v = \{ " + fields + " \} \}")
                self.line("end")
            } else {
                self.line("local " + t.name + "_" + m.name + " = \{ __e = \"" + m.name + "\" \}")
            }
            if not self.memberEnum.has(m.name) { self.memberEnum[m.name] = t.name + "_" + m.name }
            self.memberPayload[m.name] = m.nvals > 0
            self.memberRef[m.name] = t.name + "_" + m.name
        }
        var s = ""
        for m in t.emembers {
            if s != "" { s += ", " }
            s += m.name + " = " + t.name + "_" + m.name
        }
        s += ", count = " + (t.emembers.len() as str)
        self.line("local " + t.name + " = \{ " + s + " \}")
    }

    fn emitImport(self, t: Top) {
        if t.alias != "" { self.line("-- import \"" + t.path + "\" as " + t.alias + " (namespacing not lowered; names spliced globally)") }
        match t.path {
            "std/math.zeph" { for l in lines(MATH_BLOCK) { self.line(l) } }
            "std/string.zeph" { for l in lines(STRING_BLOCK) { self.line(l) } }
            "std/io.zeph" { for l in lines(IO_BLOCK) { self.line(l) } }
            "std/list.zeph" { for l in lines(LIST_BLOCK) { self.line(l) } }
            else { self.line("-- import \"" + t.path + "\": splice manually (in Roblox use require())") }
        }
        self.blank()
    }

    fn emitPreamble(self) {
        for l in lines(PREAMBLE_BLOCK) { self.line(l) }
        self.blank()
    }
}

// ------------------------------------------------ small helpers

fn joinFields(fs: [str]) -> str {
    var s = ""
    for f in fs { if s != "" { s += ", " }
 s += f }
    return s
}

fn paramNames(ps: [Param]) -> str {
    var s = ""
    for p in ps { if s != "" { s += ", " }
 s += p.name }
    return s
}

fn isDigitStr(s: str) -> bool {
    if s.len() == 0 { return false }
    for c in s { if c < 48 or c > 57 { return false } }
    return true
}

fn strIntVal(s: str) -> int {
    var n = 0
    for c in s { n = n * 10 + (c - 48) }
    return n
}

// Unescape a Zephyr string chunk (escapes kept raw by the lexer) into a Lua string literal.
fn luaStr(raw: str) -> str {
    var out = "\""
    var i = 0
    while i < raw.len() {
        var c = raw.sub(i, i + 1)
        if c == "\\" {
            var e = raw.sub(i + 1, i + 2)
            match e {
                "n" { out += "\\n" }
                "t" { out += "\\t" }
                "r" { out += "\\r" }
                "0" { out += "\\0" }
                "\\" { out += "\\\\" }
                "\"" { out += "\"" }
                "\{" { out += "\{" }
                "\}" { out += "\}" }
                "x" {
                    out += "\\x" + raw.sub(i + 2, i + 4)
                    i += 2
                }
                else { out += e }
            }
            i += 2
            continue
        }
        if c == "\"" { out += "\\\""
 i += 1
 continue }
        if c == "\n" { out += "\\n"
 i += 1
 continue }
        if c == "\t" { out += "\\t"
 i += 1
 continue }
        out += c
        i += 1
    }
    out += "\""
    return out
}

// Raw / multiline content: verbatim bytes, escape for Lua.
fn luaStrRaw(raw: str) -> str {
    var out = "\""
    var i = 0
    while i < raw.len() {
        var c = raw.sub(i, i + 1)
        if c == "\\" { out += "\\\\"
 i += 1
 continue }
        if c == "\"" { out += "\\\""
 i += 1
 continue }
        if c == "\n" { out += "\\n"
 i += 1
 continue }
        if c == "\t" { out += "\\t"
 i += 1
 continue }
        out += c
        i += 1
    }
    out += "\""
    return out
}

// ------------------------------------------------ main

fn main() {
    var argv = args()
    if argv.len() < 2 {
        printError("usage: zeph2lua <input.zeph> [output.lua]")
        exit(1)
    }
    var srcPath = argv[1]
    var src = readFile(srcPath)
    var lex = Lex{src: src}
    lex.run()
    var p = P{toks: lex.toks}
    var tops = p.parseProgram()
    var em = newEm()
    var out = em.emitProgram(tops, srcPath)
    if argv.len() >= 3 {
        writeFile(argv[2], out)
        print("wrote " + argv[2])
    } else {
        print(out)
    }
}
