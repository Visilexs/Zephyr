local function zdiv(a, b)
	if type(a) == "number" and type(b) == "number" and a % 1 == 0 and b % 1 == 0 then
		local q = math.floor(a / b)
		if q ~= 0 and (a < 0) ~= (b < 0) and q * b ~= a then q = q + 1 end
		return q
	end
	return a / b
end
local function zmod(a, b)
	if type(a) == "number" and type(b) == "number" and a % 1 == 0 and b % 1 == 0 then
		local r = a - math.floor(a / b) * b
		if r ~= 0 and ((r > 0) ~= (b > 0)) then r = r + b end
		return r
	end
	return a % b
end
local function zfmt(n)
	if type(n) ~= "number" then return tostring(n) end
	if n % 1 == 0 and math.abs(n) < 1e18 then return string.format("%d", n) end
	return string.format("%.15g", n)
end
local function zadd(a, b)
	if type(a) == "string" or type(b) == "string" then
		local function f(x)
			if type(x) == "string" then return x end
			return zfmt(x)
		end
		return f(a) .. f(b)
	end
	return a + b
end
local function ztrim(s) return (s:match("^%s*(.-)%s*$")) end
local function zsplit(s, sep)
	local out = {}
	if sep == "" then
		for i = 1, #s do out[#out + 1] = s:sub(i, i) end
		return out
	end
	local start = 1
	while true do
		local idx = s:find(sep, start, true)
		if idx == nil then out[#out + 1] = s:sub(start); break end
		out[#out + 1] = s:sub(start, idx - 1)
		start = idx + #sep
	end
	return out
end
local function zreplace(s, old, new)
	local pat = old:gsub("(%W)", "%%%1")
	return (s:gsub(pat, function() return new end))
end
local function zzeros(n)
	local t = {}
	for i = 1, n do t[i] = 0 end
	return t
end
local function zkeys(m)
	local t = {}
	for k in pairs(m) do t[#t + 1] = k end
	return t
end
local function zvals(m)
	local t = {}
	for _, v in pairs(m) do t[#t + 1] = v end
	return t
end
local zargs = arg or {}
