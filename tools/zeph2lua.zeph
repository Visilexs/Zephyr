// zeph2lua.zeph — Zephyr (Luau dialect source) → Luau transpiler.
// Usage: zeph2lua <input.zeph> [output.lua]
// Produces self-contained Luau suitable for Roblox scripts.
//
// Coverage: functions, closures, structs, enums (plain + tagged unions),
// tuples, optionals, lists, maps, match (value/range/member/payload arms),
// for/while, if-let, defer, impl methods, string/list builtins, and
// import aliasing for std/math, std/string, std/io, std/list.
// Types are erased; Zephyr 0-based list indices are NOT shifted (documented).

import "std/io.zeph"

// ---------------------------------------------------------------- tokens

struct Tok { kind: int = 0, text: str = "" }
// kind: 0 num, 1 str-chunk, 2 ident, 3 punct, 4 newline, 5 raw-string, 9 eof

// ---------------------------------------------------------------- AST

struct Param { name: str = "", def: Expr = Expr{}, hasDef: bool = false }

struct Expr {
    k: int = 0      // 0 num 1 str 2 bool 3 none 4 name 5 bin 6 un 7 call 8 index 9 field
                    // 10 list 11 map 12 structlit 13 closure 14 ifexpr 15 matchexpr 16 tuple 17 cast
    a: str = ""     // num text / str chunk / name / op / struct name / cast type
    b: str = ""     // field name
    kids: [Expr] = []
    parts: [Expr] = []
    keys: [Expr] = []
    params: [Param] = []
    body: [Stmt] = []
    arms: [Arm] = []
}

struct Arm {
    pats: [Expr] = []
    isRange: [bool] = []
    hi: [Expr] = []
    members: [str] = []
    binds: [str] = []
    isElse: bool = false
    body: [Stmt] = []
    ex: Expr = Expr{}
}

struct Stmt {
    k: int = 0      // 0 decl 1 assign 2 if 3 while 4 for 5 match 6 defer 7 return
                    // 8 break 9 continue 10 exprstmt 11 fndecl
    names: [str] = []
    opt: bool = false
    tgtK: int = 0   // 0 id 1 field 2 index
    tgtName: str = ""
    tgtBase: Expr = Expr{}
    tgtIdx: Expr = Expr{}
    op: str = "="
    e: Expr = Expr{}
    letName: str = ""
    thenB: [Stmt] = []
    elseB: [Stmt] = []
    label: str = ""
    v1: str = ""
    v2: str = ""
    lo: Expr = Expr{}
    hi: Expr = Expr{}
    step: Expr = Expr{}
    hasStep: bool = false
    body: [Stmt] = []
    arms: [Arm] = []
    fnName: str = ""
    params: [Param] = []
}

struct EMember { name: str = "", nvals: int = 0 }
struct SDecl { name: str = "", fields: [str] = [] }
struct IFn { name: str = "", params: [Param] = [], body: [Stmt] = [] }

struct Top {
    k: int = 0      // 0 import 1 fn 2 struct 3 enum 4 impl 5 interface 6 typealias 7 test 8 extern 9 stmt
    path: str = ""
    alias: str = ""
    name: str = ""
    params: [Param] = []
    body: [Stmt] = []
    sdecl: SDecl = SDecl{}
    emembers: [EMember] = []
    implFns: [IFn] = []
    st: Stmt = Stmt{}
}

// ---------------------------------------------------------------- lexer

struct Lex { src: str = "", i: int = 0, toks: [Tok] = [] }

impl Lex {
    fn push(self, kind: int, text: str) { self.toks.push(Tok{kind: kind, text: text}) }
    fn cur(self) -> str {
    if self.i >= self.src.len() { return "" }
    return self.src.sub(self.i, self.i + 1)
}
    fn adv(self) -> str { var c = self.cur()
 self.i += 1
 return c }
    fn peekCh(self, off: int) -> str {
        var j = self.i + off
        if j >= self.src.len() { return "" }
        return self.src.sub(j, j + 1)
    }

    // Scan one full string literal starting at the opening quote.
    // Normal strings emit: STR(chunk) (".." expr-tokens "..")* with "\{" "\}" puncts
    // around interpolated expressions. Raw (r"...") and multiline (""") emit kind 5.
    fn scanString(self) {
        if self.peekCh(1) == "\"" and self.peekCh(2) == "\"" {
            self.i += 3
            var buf = ""
            while true {
                if self.cur() == "" { panic("unterminated string at " + (self.i as str)) }
                if self.cur() == "\"" and self.peekCh(1) == "\"" and self.peekCh(2) == "\"" { self.i += 3
 break }
                buf += self.adv()
            }
            self.push(5, buf)
            return
        }
        self.i += 1
        var buf = ""
        while true {
            var c = self.cur()
            if c == "" { panic("unterminated string") }
            if c == "\"" { self.i += 1
 self.push(1, buf)
 return }
            if c == "\\" {
                var e = self.adv()
                buf += "\\" + e
                self.i += 1
                continue
            }
            if c == "\{" {
                self.push(1, buf)
                self.push(3, "..")
                self.push(3, "\{")
                buf = ""
                self.i += 1
                // resume after this call site: caller continues in interp mode
                return
            }
            buf += self.adv()
        }
    }

    fn run(self) {
        var mode = 0        // 0 normal, 1 string-chunk, 2 string-interp
        var buf = ""
        var strDepth = 0
        var parenDepth = 0
        while true {
            var c = self.cur()
            if c == "" { break }
            if mode == 1 {
                if c == "\"" { self.push(1, buf)
 self.i += 1
 buf = ""
 mode = 0
 continue }
                if c == "\\" {
                    var e = self.adv()
                    buf += "\\" + e
                    self.i += 1
                    continue
                }
                if c == "\{" {
                    self.push(1, buf)
                    self.push(3, "..")
                    self.push(3, "\{")
                    buf = ""
                    strDepth = 1
                    mode = 2
                    self.i += 1
                    continue
                }
                buf += self.adv()
                continue
            }
            if mode == 2 {
                if c == "\"" {
                    self.scanString()
                    continue
                }
                if c == "\{" {
                    strDepth += 1
                    self.push(3, "\{")
                    self.i += 1
                    continue
                }
                if c == "\}" {
                    strDepth -= 1
                    self.push(3, "\}")
                    self.i += 1
                    if strDepth == 0 {
                        self.push(3, "..")
                        buf = ""
                        mode = 1
                        continue
                    }
                    continue
                }
                // fall through to normal tokenization for expression tokens
            }
            if c == "\n" {
                self.i += 1
                if mode == 0 and parenDepth == 0 {
                    if self.toks.len() > 0 {
                        var last = self.toks[self.toks.len() - 1]
                        if last.kind != 4 { self.push(4, "\n") }
                    }
                }
                continue
            }
            if c == " " or c == "\t" or c == "\r" { self.i += 1
 continue }
            if c == "/" and self.peekCh(1) == "/" {
                while true { if self.cur() == "" { break }
 if self.cur() == "\n" { break }
 self.i += 1 }
                continue
            }
            if c == "/" and self.peekCh(1) == "*" {
                var d = 1
                self.i += 2
                while true {
                    if self.cur() == "" { panic("unterminated comment") }
                    if self.cur() == "/" and self.peekCh(1) == "*" { d += 1
 self.i += 2
 continue }
                    if self.cur() == "*" and self.peekCh(1) == "/" { d -= 1
 self.i += 2
 if d == 0 { break }
 continue }
                    self.i += 1
                }
                continue
            }
            if c >= "0" and c <= "9" {
                var start = self.i
                if c == "0" and (self.peekCh(1) == "x" or self.peekCh(1) == "X") {
                    self.i += 2
                    while true { var ch = self.cur()
 if (ch >= "0" and ch <= "9" or ch >= "a" and ch <= "f" or ch >= "A" and ch <= "F" or ch == "_") { self.i += 1 } else { break } }
                } else if c == "0" and (self.peekCh(1) == "b" or self.peekCh(1) == "B") {
                    self.i += 2
                    while true { var ch = self.cur()
 if ch == "0" or ch == "1" or ch == "_" { self.i += 1 } else { break } }
                } else if c == "0" and (self.peekCh(1) == "o" or self.peekCh(1) == "O") {
                    self.i += 2
                    while true { var ch = self.cur()
 if (ch >= "0" and ch <= "7" or ch == "_") { self.i += 1 } else { break } }
                } else {
                    while true { var ch = self.cur()
 if (ch >= "0" and ch <= "9" or ch == "_") { self.i += 1 } else { break } }
                    if self.cur() == "." and self.peekCh(1) >= "0" and self.peekCh(1) <= "9" {
                        self.i += 1
                        while true { var ch = self.cur()
 if ch >= "0" and ch <= "9" { self.i += 1 } else { break } }
                    }
                    if self.cur() == "e" or self.cur() == "E" {
                        var save = self.i
                        self.i += 1
                        if self.cur() == "+" or self.cur() == "-" { self.i += 1 }
                        var ok = self.cur() >= "0" and self.cur() <= "9"
                        while true { var ch = self.cur()
 if ch >= "0" and ch <= "9" { self.i += 1 } else { break } }
                        if not ok { self.i = save }
                    }
                }
                self.push(0, self.src.sub(start, self.i))
                continue
            }
            if c == "r" and self.peekCh(1) == "\"" {
                self.i += 2
                var start = self.i
                while true { if self.cur() == "" { panic("unterminated raw string") }
 if self.cur() == "\"" { break }
 self.i += 1 }
                self.push(5, self.src.sub(start, self.i))
                self.i += 1
                continue
            }
            if c == "\"" {
                self.i += 1
                buf = ""
                mode = 1
                continue
            }
            if c == "'" {
                self.i += 1
                var ch = self.cur()
                if ch == "\\" {
                    var e = self.adv()
                    self.i += 1
                    match e {
                        "n" { self.push(0, "10")
 continue }
                        "t" { self.push(0, "9")
 continue }
                        "r" { self.push(0, "13")
 continue }
                        "0" { self.push(0, "0")
 continue }
                        else { self.push(0, e)
 continue }
                    }
                }
                self.i += 1
                self.push(0, ch.byte(0) as str)
                continue
            }
            if (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or c == "_" or c == "$" {
                var start = self.i
                while true {
                    var ch = self.cur()
                    if (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or (ch >= "0" and ch <= "9") or ch == "_" or ch == "$" { self.i += 1 } else { break }
                }
                self.push(2, self.src.sub(start, self.i))
                continue
            }
            var two = c + self.peekCh(1)
            match two {
                "<<", ">>", "+=", "-=", "*=", "/=", "%=", "&=", "|=", "^=", "..", "->", "==", "!=" {
                    self.push(3, two)
                    self.i += 2
                    continue
                }
                else { }
            }
            match c {
                "+", "-", "*", "/", "%", "=", "<", ">", "!", "&", "|", "^", "~", "?", ".", ",", ":", "(", ")", "[", "]", "\{", "\}" {
                    self.push(3, c)
                    self.i += 1
                    if c == "(" or c == "[" { parenDepth += 1 }
                    if c == ")" or c == "]" { parenDepth -= 1 }
                    continue
                }
                else { panic("unexpected character '" + c + "' at " + (self.i as str)) }
            }
        }
        self.push(9, "")
    }
}

// ---------------------------------------------------------------- parser

struct P { toks: [Tok] = [], i: int = 0, inHeader: bool = false }

impl P {
    fn peek(self) -> Tok {
        if self.i >= self.toks.len() { return Tok{kind: 9} }
        return self.toks[self.i]
    }
    fn atOff(self, off: int) -> Tok {
        var j = self.i + off
        if j >= self.toks.len() { return Tok{kind: 9} }
        return self.toks[j]
    }
    fn next(self) -> Tok { var t = self.peek()
 if self.i < self.toks.len() { self.i += 1 }
 return t }
    fn at(self, text: str) -> bool { return self.peek().text == text }
    fn atKw(self, text: str) -> bool { var t = self.peek()
 return t.kind == 2 and t.text == text }
    fn eat(self, text: str) -> bool { if self.at(text) { self.i += 1
 return true }
 return false }
    fn expect(self, text: str) {
        if not self.eat(text) { panic("expected '" + text + "' got '" + self.peek().text + "' near token " + (self.i as str)) }
    }
    fn skipNL(self) { while self.peek().kind == 4 { self.i += 1 } }

    // Consume a type annotation, returning its text (we only care about a trailing '?').
    fn parseTypeText(self) -> str {
        var t = self.peek()
        if t.kind == 3 and (t.text == "[" or t.text == "(") {
            var depth = 0
            var buf = ""
            while true {
                var c = self.next()
                buf += c.text
                if c.text == "[" or c.text == "(" { depth += 1 }
                if c.text == "]" or c.text == ")" { depth -= 1
 if depth == 0 { break } }
            }
            if self.eat("?") { buf += "?" }
            return buf
        }
        if t.kind == 2 and t.text == "fn" {
            self.next()
            self.expect("(")
            var depth = 1
            while true {
                if depth == 0 { break }
                var c = self.next()
                if c.text == "(" { depth += 1 }
                if c.text == ")" { depth -= 1 }
            }
            var buf = "fn(...)"
            if self.eat("->") { buf += " " + self.parseTypeText() }
            return buf
        }
        if t.kind != 2 { panic("expected type, got '" + t.text + "'") }
        var buf = self.next().text
        if self.at("[") {
            var depth = 0
            while true {
                var c = self.next()
                buf += c.text
                if c.text == "[" { depth += 1 }
                if c.text == "]" { depth -= 1
 if depth == 0 { break } }
            }
        }
        if self.eat("?") { buf += "?" }
        return buf
    }

    fn parseParams(self) -> [Param] {
        var ps: [Param] = []
        self.expect("(")
        self.skipNL()
        if not self.at(")") {
            while true {
                self.skipNL()
                var n = self.next()
                if n.kind != 2 { panic("expected param name, got '" + n.text + "'") }
                var p = Param{name: n.text}
                if self.eat(":") { self.parseTypeText() }
                if self.eat("=") { p.def = self.parseExpr()
 p.hasDef = true }
                ps.push(p)
                if self.eat(",") { continue }
                break
            }
        }
        self.expect(")")
        self.skipNL()
        return ps
    }

    fn parseBlock(self) -> [Stmt] {
        self.expect("\{")
        var ss: [Stmt] = []
        self.skipNL()
        while true {
            if self.at("\}") { self.next()
 break }
            if self.peek().kind == 9 { panic("unterminated block") }
            ss.push(self.parseStmt())
            self.skipNL()
        }
        return ss
    }

    fn parseTop(self) -> Top {
        var t = self.peek()
        if t.kind == 2 {
            match t.text {
                "import" {
                    self.next()
                    var p = self.next()
                    if p.kind != 1 and p.kind != 5 { panic("import path must be a string") }
                    var top = Top{k: 0, path: p.text}
                    if self.atKw("as") { self.next()
 top.alias = self.next().text }
                    return top
                }
                "fn" {
                    self.next()
                    var name = self.next().text
                    if self.at("[") { self.skipBalanced("[", "]") }
                    var ps = self.parseParams()
                    if self.eat("->") { self.parseTypeText() }
                    var body = self.parseBlock()
                    return Top{k: 1, name: name, params: ps, body: body}
                }
                "struct" {
                    self.next()
                    var name = self.next().text
                    if self.at("[") { self.skipBalanced("[", "]") }
                    self.expect("\{")
                    var sdecl = SDecl{name: name}
                    self.skipNL()
                    while true {
                        self.skipNL()
                        if self.at("\}") { self.next()
 break }
                        var f = self.next()
                        sdecl.fields.push(f.text)
                        self.expect(":")
                        self.parseTypeText()
                        if self.eat("=") { self.parseExpr() }
                        self.eat(",")
                    }
                    return Top{k: 2, sdecl: sdecl}
                }
                "enum" {
                    self.next()
                    var name = self.next().text
                    if self.at("[") { self.skipBalanced("[", "]") }
                    self.expect("\{")
                    var ems: [EMember] = []
                    self.skipNL()
                    while true {
                        self.skipNL()
                        if self.at("\}") { self.next()
 break }
                        var m = self.next()
                        var nv = 0
                        if self.at("(") {
                            self.next()
                            self.skipNL()
                            nv = 1
                            while true {
                                self.next()
                                if self.eat(",") {
                                    self.skipNL()
                                    nv += 1
                                    continue
                                }
                                break
                            }
                            self.expect(")")
                        }
                        ems.push(EMember{name: m.text, nvals: nv})
                        self.eat(",")
                    }
                    return Top{k: 3, name: name, emembers: ems}
                }
                "impl" {
                    self.next()
                    var tname = self.next().text
                    if self.at("[") { self.skipBalanced("[", "]") }
                    self.expect("\{")
                    var fns: [IFn] = []
                    self.skipNL()
                    while true {
                        self.skipNL()
                        if self.at("\}") { self.next()
 break }
                        self.expect("fn")
                        var fname = self.next().text
                        if self.at("[") { self.skipBalanced("[", "]") }
                        var ps = self.parseParams()
                        if self.eat("->") { self.parseTypeText() }
                        var body = self.parseBlock()
                        fns.push(IFn{name: fname, params: ps, body: body})
                        self.skipNL()
                    }
                    return Top{k: 4, name: tname, implFns: fns}
                }
                "interface" {
                    self.next()
                    var name = self.next().text
                    if self.at("[") { self.skipBalanced("[", "]") }
                    self.skipBalanced("\{", "\}")
                    return Top{k: 5, name: name}
                }
                "type" {
                    self.next()
                    var name = self.next().text
                    self.expect("=")
                    self.parseTypeText()
                    return Top{k: 6, name: name}
                }
                "private" {
                    self.next()
                    return self.parseTop()
                }
                "test" {
                    self.next()
                    var n = self.next()
                    var name = n.text
                    self.skipBalanced("\{", "\}")
                    return Top{k: 7, name: name}
                }
                "extern" {
                    self.next()
                    self.expect("fn")
                    var name = self.next().text
                    if self.at("[") { self.skipBalanced("[", "]") }
                    self.parseParams()
                    if self.eat("->") { self.parseTypeText() }
                    self.expect("from")
                    self.next()
                    return Top{k: 8, name: name}
                }
                else { }
            }
        }
        var st = self.parseStmt()
        return Top{k: 9, st: st}
    }

    fn skipBalanced(self, open: str, close: str) {
        var depth = 0
        while true {
            var t = self.next()
            if t.kind == 9 { panic("unterminated '" + open + "'") }
            if t.text == open { depth += 1 }
            if t.text == close { depth -= 1
 if depth == 0 { return } }
        }
    }

    fn parseProgram(self) -> [Top] {
        var tops: [Top] = []
        self.skipNL()
        while true {
            var t = self.peek()
            if t.kind == 9 { break }
            tops.push(self.parseTop())
            self.skipNL()
        }
        return tops
    }

    fn parseIfStmt(self) -> Stmt {
        self.expect("if")
        var letName = ""
        if self.atKw("let") {
            self.next()
            letName = self.next().text
            self.expect("=")
        }
        self.inHeader = true
        var cond = self.parseExpr()
        self.inHeader = false
        var tb = self.parseBlock()
        var eb: [Stmt] = []
        if self.eat("else") {
            if self.atKw("if") { eb = [self.parseIfStmt()] } else { eb = self.parseBlock() }
        }
        return Stmt{k: 2, e: cond, letName: letName, thenB: tb, elseB: eb}
    }

    fn parsePattern(self, arm: Arm) {
        var t = self.peek()
        if t.kind == 2 and t.text == "_" {
            self.next()
            arm.pats.push(Expr{k: 4, a: "_"})
            arm.isRange.push(false)
            arm.hi.push(Expr{})
            arm.members.push("")
            return
        }
        if t.kind == 2 and self.atOff(1).text == "(" {
            var mname = self.next().text
            self.expect("(")
            self.skipNL()
            if not self.at(")") {
                while true {
                    var b = self.next()
                    arm.binds.push(b.text)
                    if self.eat(",") { self.skipNL()
 continue }
                    break
                }
            }
            self.expect(")")
            arm.pats.push(Expr{k: 4, a: mname})
            arm.isRange.push(false)
            arm.hi.push(Expr{})
            arm.members.push(mname)
            return
        }
        self.inHeader = true
        var e = self.parseCmp()
        if self.eat("..") {
            var hi = self.parseCmp()
            self.inHeader = false
            arm.pats.push(e)
            arm.isRange.push(true)
            arm.hi.push(hi)
            arm.members.push("")
            return
        }
        self.inHeader = false
        arm.pats.push(e)
        arm.isRange.push(false)
        arm.hi.push(Expr{})
        if t.kind == 2 { arm.members.push(t.text) } else { arm.members.push("") }
    }

    fn parseMatchStmt(self) -> Stmt {
        self.expect("match")
        self.inHeader = true
        var subj = self.parseExpr()
        self.inHeader = false
        self.expect("\{")
        var arms: [Arm] = []
        self.skipNL()
        while true {
            if self.at("\}") { self.next()
 break }
            if self.eat("else") {
                var a = Arm{isElse: true}
                a.body = self.parseBlock()
                arms.push(a)
                self.skipNL()
                continue
            }
            var a = Arm{}
            while true {
                self.parsePattern(a)
                if self.eat(",") { self.skipNL()
 continue }
                break
            }
            a.body = self.parseBlock()
            arms.push(a)
            self.skipNL()
        }
        return Stmt{k: 5, e: subj, arms: arms}
    }

    fn parseForStmt(self) -> Stmt {
        var label = ""
        if self.peek().kind == 2 and self.atOff(1).text == "for" { label = self.next().text }
        self.expect("for")
        var v1 = self.next().text
        var v2 = ""
        if self.eat(",") { v2 = self.next().text }
        self.expect("in")
        self.inHeader = true
        var lo = self.parsePrimary()
        var st = Stmt{k: 4, v1: v1, v2: v2, lo: lo, label: label}
        if self.eat("..") {
            st.hi = self.parsePrimary()
            if self.atKw("step") {
                self.next()
                st.step = self.parsePrimary()
                st.hasStep = true
            }
        }
        self.inHeader = false
        st.body = self.parseBlock()
        return st
    }

    fn parseAssignTarget(self) -> Expr {
        // Parse ID (.ID | [expr])* ; caller checks for an assignment operator.
        var t = self.peek()
        if t.kind != 2 { return Expr{} }
        var e = Expr{k: 4, a: self.next().text}
        while true {
            if self.at(".") {
                self.next()
                var f = self.next()
                e = Expr{k: 9, b: f.text, kids: [e]}
                continue
            }
            if self.at("[") {
                self.next()
                var idx = self.parseExpr()
                self.expect("]")
                e = Expr{k: 8, kids: [e, idx]}
                continue
            }
            break
        }
        return e
    }

    fn parseStmt(self) -> Stmt {
        var t = self.peek()
        if t.kind == 2 {
            match t.text {
                "let", "var", "const" {
                    self.next()
                    var names: [str] = []
                    if self.at("(") {
                        self.next()
                        while true {
                            var n = self.next()
                            names.push(n.text)
                            if self.eat(",") { continue }
                            break
                        }
                        self.expect(")")
                    } else {
                        names.push(self.next().text)
                    }
                    var opt = false
                    if self.eat(":") { var tt = self.parseTypeText()
 if tt.endsWith("?") { opt = true } }
                    self.expect("=")
                    var init = self.parseExpr()
                    return Stmt{k: 0, names: names, opt: opt, e: init}
                }
                "if" { return self.parseIfStmt() }
                "while" {
                    var label = ""
                    if self.peek().kind == 2 and self.atOff(1).text == "while" { label = self.next().text }
                    self.expect("while")
                    self.inHeader = true
                    var cond = self.parseExpr()
                    self.inHeader = false
                    var body = self.parseBlock()
                    return Stmt{k: 3, e: cond, body: body, label: label}
                }
                "for" { return self.parseForStmt() }
                "match" { return self.parseMatchStmt() }
                "defer" {
                    self.next()
                    var st = Stmt{k: 6}
                    if self.at("\{") { st.body = self.parseBlock() } else { st.body = [self.parseStmt()] }
                    return st
                }
                "return" {
                    self.next()
                    var st = Stmt{k: 7}
                    if not self.at("\}") and self.peek().kind != 4 { st.e = self.parseExpr() }
                    return st
                }
                "break" {
                    self.next()
                    var st = Stmt{k: 8}
                    if self.peek().kind == 2 and (self.atOff(1).kind == 4 or self.atOff(1).text == "\}" or self.atOff(1).kind == 9) { st.label = self.next().text }
                    return st
                }
                "continue" {
                    self.next()
                    var st = Stmt{k: 9}
                    if self.peek().kind == 2 and (self.atOff(1).kind == 4 or self.atOff(1).text == "\}" or self.atOff(1).kind == 9) { st.label = self.next().text }
                    return st
                }
                "fn" {
                    self.next()
                    var name = self.next().text
                    if self.at("[") { self.skipBalanced("[", "]") }
                    var ps = self.parseParams()
                    if self.eat("->") { self.parseTypeText() }
                    var body = self.parseBlock()
                    return Stmt{k: 11, fnName: name, params: ps, body: body}
                }
                else { }
            }
        }
        var saved = self.i
        var tgt = self.parseAssignTarget()
        var op = ""
        if tgt.k != 0 {
            match self.peek().text {
                "=", "+=", "-=", "*=", "/=", "%=", "&=", "|=", "^=", "<<=", ">>=" { op = self.next().text }
                else { }
            }
        }
        if op == "" { self.i = saved }
        if op != "" {
            var rhs = self.parseExpr()
                var st = Stmt{k: 1, op: op, e: rhs}
                match tgt.k {
                    4 { st.tgtK = 0
 st.tgtName = tgt.a }
                    9 { st.tgtK = 1
 st.tgtBase = tgt.kids[0]
 st.tgtName = tgt.b }
                    8 { st.tgtK = 2
 st.tgtBase = tgt.kids[0]
 st.tgtIdx = tgt.kids[1] }
                    else { panic("bad assign target") }
                }
                return st
        }
        var e = self.parseExpr()
        return Stmt{k: 10, e: e}
    }

    // ------------------------------------------------ expressions

    fn parseExpr(self) -> Expr { return self.parseOr() }

    fn parseOr(self) -> Expr {
        var e = self.parseAnd()
        while self.atKw("or") { self.next()
 e = Expr{k: 5, a: "or", kids: [e, self.parseAnd()]} }
        return e
    }

    fn parseAnd(self) -> Expr {
        var e = self.parseCmp()
        while self.atKw("and") { self.next()
 e = Expr{k: 5, a: "and", kids: [e, self.parseCmp()]} }
        return e
    }

    fn parseCmp(self) -> Expr {
        var e = self.parsePipe()
        var ops: [str] = []
        var rhs: [Expr] = []
        while true {
            var t = self.peek()
            var isCmp = false
            if t.kind == 3 {
                var tx = t.text
                if tx == "<" or tx == "<=" or tx == ">" or tx == ">=" or tx == "==" or tx == "!=" { isCmp = true }
            }
            if t.kind == 2 and t.text == "is" { isCmp = true }
            if not isCmp { break }
            var op = self.next().text
            var r = self.parsePipe()
            ops.push(op)
            rhs.push(r)
        }
        if ops.len() == 0 { return e }
        var acc = Expr{k: 5, a: ops[0], kids: [e, rhs[0]]}
        for i in 1..ops.len() {
            acc = Expr{k: 5, a: "and", kids: [acc, Expr{k: 5, a: ops[i], kids: [rhs[i - 1], rhs[i]]}]}
        }
        return acc
    }

    fn parsePipe(self) -> Expr {
        var e = self.parseAdd()
        while true {
            var t = self.peek()
            if t.kind == 3 and (t.text == "|" or t.text == "^") {
                var op = self.next().text
                e = Expr{k: 5, a: op, kids: [e, self.parseAdd()]}
                continue
            }
            break
        }
        return e
    }

    fn parseAdd(self) -> Expr {
        var e = self.parseMul()
        while true {
            var t = self.peek()
            if t.kind == 3 and (t.text == "+" or t.text == "-") {
                var op = self.next().text
                e = Expr{k: 5, a: op, kids: [e, self.parseMul()]}
                continue
            }
            break
        }
        return e
    }

    fn parseMul(self) -> Expr {
        var e = self.parseCast()
        while true {
            var t = self.peek()
            if t.kind == 3 and (t.text == "*" or t.text == "/" or t.text == "%" or t.text == "&" or t.text == "<<" or t.text == ">>") {
                var op = self.next().text
                e = Expr{k: 5, a: op, kids: [e, self.parseCast()]}
                continue
            }
            break
        }
        return e
    }

    fn parseCast(self) -> Expr {
        var e = self.parseUnary()
        while self.atKw("as") {
            self.next()
            var tt = self.parseTypeText()
            e = Expr{k: 17, a: tt, kids: [e]}
        }
        return e
    }

    fn parseUnary(self) -> Expr {
        var t = self.peek()
        if t.kind == 3 and (t.text == "-" or t.text == "~") {
            self.next()
            return Expr{k: 6, a: t.text, kids: [self.parseUnary()]}
        }
        if t.kind == 2 and t.text == "not" {
            self.next()
            return Expr{k: 6, a: "not", kids: [self.parseUnary()]}
        }
        return self.parsePostfix()
    }

    fn parseArgs(self) -> [Expr] {
        var args: [Expr] = []
        self.skipNL()
        if self.at(")") { self.next()
 return args }
        while true {
            self.skipNL()
            args.push(self.parseExpr())
            if self.eat(",") {
                self.skipNL()
                if self.at(")") { break }
                continue
            }
            break
        }
        self.expect(")")
        self.skipNL()
        return args
    }

    fn parsePostfix(self) -> Expr {
        var e = self.parsePrimary()
        while true {
            if self.at("(") {
                self.next()
                var args = self.parseArgs()
                var call = Expr{k: 7, kids: [e]}
                call.parts = args
                e = call
                continue
            }
            if self.at("[") {
                self.next()
                var idx = self.parseExpr()
                self.expect("]")
                e = Expr{k: 8, kids: [e, idx]}
                continue
            }
            if self.at(".") {
                self.next()
                var f = self.next()
                e = Expr{k: 9, b: f.text, kids: [e]}
                continue
            }
            break
        }
        return e
    }

    fn parsePrimary(self) -> Expr {
        var t = self.peek()
        if t.kind == 0 { self.next()
 return Expr{k: 0, a: t.text} }
        if t.kind == 1 {
            var first = self.next()
            var e = Expr{k: 1, a: first.text}
            while self.at("..") {
                self.next()
                var inner = self.parseExpr()
                self.expect("\}")
                if inner.k == 1 { e = Expr{k: 5, a: "..", kids: [e, inner]} }
                else { e = Expr{k: 5, a: "..", kids: [e, Expr{k: 18, a: "tostring", kids: [inner]}]} }
            }
            return e
        }
        if t.kind == 5 { self.next()
 return Expr{k: 19, a: t.text} }
        if t.kind == 2 {
            match t.text {
                "true" { self.next()
 return Expr{k: 2, a: "true"} }
                "false" { self.next()
 return Expr{k: 2, a: "false"} }
                "none" { self.next()
 return Expr{k: 3} }
                "if" {
                    self.next()
                    var cond = self.parseExpr()
                    var tb = self.parseBlock()
                    var te = Expr{}
                    if tb.len() > 0 { te = tb[0].e }
                    self.expect("else")
                    var ee = Expr{}
                    if self.at("\{") {
                        var eb = self.parseBlock()
                        if eb.len() > 0 { ee = eb[0].e }
                    } else { ee = self.parsePrimary() }
                    return Expr{k: 14, kids: [cond, te, ee]}
                }
                "match" {
                    self.next()
                    self.inHeader = true
                    var subj = self.parseExpr()
                    self.inHeader = false
                    self.expect("\{")
                    var arms: [Arm] = []
                    self.skipNL()
                    while true {
                        if self.at("\}") { self.next()
 break }
                        if self.eat("else") {
                            var a = Arm{isElse: true}
                            var eb = self.parseBlock()
                            if eb.len() > 0 { a.ex = eb[0].e }
                            arms.push(a)
                            self.skipNL()
                            continue
                        }
                        var a = Arm{}
                        while true {
                            self.parsePattern(a)
                            if self.eat(",") { self.skipNL()
 continue }
                            break
                        }
                        var ab = self.parseBlock()
                        if ab.len() > 0 { a.ex = ab[0].e }
                        arms.push(a)
                        self.skipNL()
                    }
                    return Expr{k: 15, kids: [subj], arms: arms}
                }
                "fn" {
                    self.next()
                    var ps = self.parseParams()
                    if self.eat("->") { self.parseTypeText() }
                    var body = self.parseBlock()
                    return Expr{k: 13, params: ps, body: body}
                }
                else { }
            }
            var name = self.next().text
            if self.at("\{") and not self.inHeader {
                self.next()
                var e = Expr{k: 12, a: name}
                self.skipNL()
                if not self.at("\}") {
                    while true {
                        self.skipNL()
                        var f = self.next()
                        self.expect(":")
                        e.keys.push(Expr{k: 4, a: f.text})
                        e.parts.push(self.parseExpr())
                        if self.eat(",") { continue }
                        break
                    }
                }
                self.expect("\}")
                return e
            }
            return Expr{k: 4, a: name}
        }
        if t.kind == 3 {
            match t.text {
                "(" {
                    self.next()
                    self.skipNL()
                    var e = self.parseExpr()
                    if self.eat(",") {
                        e.parts.push(e)
                        while true {
                            e.parts.push(self.parseExpr())
                            if self.eat(",") { continue }
                            break
                        }
                        self.expect(")")
                        return Expr{k: 16, parts: e.parts}
                    }
                    self.expect(")")
                    return e
                }
                "[" {
                    self.next()
                    self.skipNL()
                    if self.at(":") { self.next()
 self.expect("]")
 return Expr{k: 11} }
                    if self.at("]") { self.next()
 return Expr{k: 10} }
                    var first = self.parseExpr()
                    if self.eat(":") {
                        var e = Expr{k: 11}
                        e.keys.push(first)
                        e.parts.push(self.parseExpr())
                        while true {
                            if self.eat(",") {
                                self.skipNL()
                                if self.at("]") { break }
                                e.keys.push(self.parseExpr())
                                self.expect(":")
                                e.parts.push(self.parseExpr())
                                continue
                            }
                            break
                        }
                        self.expect("]")
                        return e
                    }
                    var e2 = Expr{k: 10}
                    e2.parts.push(first)
                    while true {
                        if self.eat(",") {
                            self.skipNL()
                            if self.at("]") { break }
                            e2.parts.push(self.parseExpr())
                            continue
                        }
                        break
                    }
                    self.expect("]")
                    return e2
                }
                else { }
            }
        }
        panic("unexpected token '" + t.text + "' in expression")
    }
}

