var IO_BLOCK = r"""
-- std/io.zeph aliases (Roblox-aware: uses readfile/writefile when present)
local function fileExists(p)
	local f = io.open(p, "rb")
	if f ~= nil then f:close(); return true end
	return false
end
local function readFile(p)
	if readfile ~= nil then
		local d = readfile(p)
		if d == nil then error("cannot read " .. p) end
		return d
	end
	local f = assert(io.open(p, "rb"))
	local d = f:read("a")
	f:close()
	return d
end
local function writeFile(p, d)
	if writefile ~= nil then writefile(p, d); return end
	local f = assert(io.open(p, "wb"))
	f:write(d)
	f:close()
end
local function appendFile(p, d)
	local old = ""
	if fileExists(p) then old = readFile(p) end
	writeFile(p, old .. d)
end
local printError = function(t) print(t) end
local function exit(c) os.exit(c, true) end
local function deleteFile(p) return os.remove(p) == 0 end
local function environmentVariable(n) return os.getenv(n) end
local function nowMilliseconds() return math.floor(os.clock() * 1000) end
local function sleepMilliseconds(ms)
	local t0 = os.clock()
	while os.clock() - t0 < ms / 1000 do end
end
