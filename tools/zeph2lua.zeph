var LIST_BLOCK = r"""
-- std/list.zeph aliases
local function contains(items, t)
	for _, v in ipairs(items) do if v == t then return true end end
	return false
end
local function indexOf(items, t)
	for i, v in ipairs(items) do if v == t then return i - 1 end end
	return -1
end
local function reverse(items)
	for i = 1, math.floor(#items / 2) do
		items[i], items[#items - i + 1] = items[#items - i + 1], items[i]
	end
end
local function slice(items, lo, hi)
	local t = {}
	for i = lo, hi - 1 do t[#t + 1] = items[i + 1] end
	return t
end
local function first(items)
	if #items == 0 then return nil end
	return items[1]
end
local function last(items)
	if #items == 0 then return nil end
	return items[#items]
end
local function map(items, f)
	local t = {}
	for _, v in ipairs(items) do t[#t + 1] = f(v) end
	return t
end
local function filter(items, f)
	local t = {}
	for _, v in ipairs(items) do if f(v) then t[#t + 1] = v end end
	return t
end
local function fold(items, start, f)
	local acc = start
	for _, v in ipairs(items) do acc = f(acc, v) end
	return acc
end
local function any(items, f)
	for _, v in ipairs(items) do if f(v) then return true end end
	return false
end
local function all(items, f)
	for _, v in ipairs(items) do if not f(v) then return false end end
	return true
end
local function count(items, t)
	local n = 0
	for _, v in ipairs(items) do if v == t then n = n + 1 end end
	return n
end
local function sortBy(items, cmp)
