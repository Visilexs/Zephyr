// Where does a real native training step actually spend its time?
//
// The optimization section of the specification opens with "Optimization only
// after an end-to-end profile" and "First optimize operations that dominate a
// real native training step", so this runs before any fusion is written and
// decides what gets fused. It also warns against implementing "a broad
// autotuner before measuring fixed model shapes", which is why this measures
// one fixed configuration rather than sweeping.
//
// The forward profile comes from replaying the captured IR node by node with
// a timer around each. That covers all 26 opcodes the model reaches, which a
// hook-based profiler would not: only six op families are hooked, leaving
// concat, slice, cast, transpose, reshape, expand and roll -- 118 of 426
// nodes -- unmeasured.
//
// Replay timing carries per-node overhead, and that overhead is roughly
// constant per node rather than per element. So the cost of a cheap op is
// overstated and the cost of an expensive one is not. The count column is
// printed next to the time for exactly that reason: an op with a large share
// and a large count may be telling you about dispatch overhead, while one
// with a large share and a small count is real work.
import "ml/ir.zeph"
import "ml/phase_ad.zeph"
import "ml/optim.zeph"

extern fn QueryPerformanceCounter(p: int) -> i32 from "kernel32.dll"
extern fn QueryPerformanceFrequency(p: int) -> i32 from "kernel32.dll"
var qpf = Bytes.new(8)
QueryPerformanceFrequency(qpf.addr())
let FREQ = (qpf.get64(0)) as float
var qtmp = Bytes.new(8)
fn now_ms() -> float {
    QueryPerformanceCounter(qtmp.addr())
    return ((qtmp.get64(0)) as float) * 1000.0 / FREQ
}

var SEED = 20260921
fn rnd() -> float {
    SEED = (SEED * 1103515245 + 12345) % 2147483648
    return ((SEED % 2001) as float) / 1000.0 - 1.0
}
fn rndi(n: int) -> int {
    SEED = (SEED * 1103515245 + 12345) % 2147483648
    return SEED % n
}
fn fill_random(t: Tensor) {
    var idx = indexZeros(t.shape.len())
    var more = tensorElementCount(t) > 0
    while more {
        let re = rnd()
        if dtypeIsComplex(t.dtype) { tensorSetComplex(t, idx, re, rnd()) } else { tensorSet(t, idx, re) }
        more = indexNext(idx, t.shape)
    }
}

// The specification's model dimension, which is the shape the profile has to
// be about. A profile at a toy size would rank dispatch overhead first and
// send the optimization work to the wrong place.
let D = 128
let E = 32
let H = 128
let K = 2
let IV = 6
let OV = 3
let NB = 32
let T = 4

let cfg = PhaseConfig{inputVocab: IV, outputVocab: OV, stateDimension: D, embeddingDimension: E, hiddenDimension: H, thinkSteps: K, padToken: 0, epsilon: 0.00000001}
let embedding = tensorZeros(DType.F64, [IV, E])
let think = tensorZeros(DType.F64, [E])
let W1 = tensorZeros(DType.F64, [H, E + 3 * D])
let b1 = tensorZeros(DType.F64, [H])
let W2 = tensorZeros(DType.F64, [3 * D, H])
let b2 = tensorZeros(DType.F64, [3 * D])
let z_init = tensorZeros(DType.C64, [D])
let Mo = tensorZeros(DType.C64, [OV, D])
let ps = [embedding, think, W1, b1, W2, b2, z_init, Mo]
for i in 0..ps.len() { fill_random(ps[i]) }
let p = PhaseParams{config: cfg, embedding: embedding, think: think, hiddenWeight: W1, hiddenBias: b1,
                    angleWeight: W2, angleBias: b2, initialState: z_init, readoutMatrix: Mo}
let tokens = tensorZeros(DType.I64, [NB, T])
var targets: [int] = []
for row in 0..NB {
    for st in 0..T { tensorSetInt(tokens, [row, st], 1 + rndi(IV - 1)) }
    targets.push(rndi(OV))
}

print("phase model D={D} E={E} H={H} K={K} batch={NB} T={T}")
print("")

// ---- forward against backward, the first thing worth knowing ---------------
let opt = newAdamW(ps, 0.02, 0.9, 0.999, 0.00000001, 0.0)
let REPS = 3
var fwd_total = 0.0
var bwd_total = 0.0
var opt_total = 0.0
var nodes = 0
for r in 0..REPS {
    autogradReset()
    let t0 = now_ms()
    let m = phaseAutogradParameters(p, true)
    let loss = phaseAutogradLoss(m, tokens, targets)
    let t1 = now_ms()
    autogradBackward(loss)
    let t2 = now_ms()
    let handles = [m.embedding, m.think, m.hiddenWeight, m.hiddenBias, m.angleWeight, m.angleBias, m.initialState, m.readoutMatrix]
    var grads: [Tensor] = []
    for i in 0..handles.len() { grads.push(tensorCopy(autogradGradient(handles[i]))) }
    clipGradientNorm(grads, 5.0)
    optimizerStep(opt, ps, grads)
    let t3 = now_ms()
    fwd_total = fwd_total + (t1 - t0)
    bwd_total = bwd_total + (t2 - t1)
    opt_total = opt_total + (t3 - t2)
    nodes = autogradNodeCount()
}
let fwd = fwd_total / (REPS as float)
let bwd = bwd_total / (REPS as float)
let opt_ms = opt_total / (REPS as float)
let step = fwd + bwd + opt_ms
print("step {step} ms = forward {fwd} + backward {bwd} + optimizer {opt_ms}")
print("  forward {100.0 * fwd / step}%, backward {100.0 * bwd / step}%, optimizer {100.0 * opt_ms / step}%")
print("  tape nodes {nodes}")
print("")

// ---- per-op forward profile, by replaying the captured graph ---------------
autogradReset()
let m2 = phaseAutogradParameters(p, true)
let loss2 = phaseAutogradLoss(m2, tokens, targets)
let g = irCapture(loss2)
let errs = irVerify(g)
if errs.len() > 0 {
    print("WARNING: the captured graph does not verify, so this profile is of something malformed")
    for i in 0..errs.len() {
        if i < 5 { print("  {errs[i]}") }
    }
}

let NOPS = 31
var t_by_op: [float] = []
var n_by_op: [int] = []
var el_by_op: [int] = []
for i in 0..NOPS {
    t_by_op.push(0.0)
    n_by_op.push(0)
    el_by_op.push(0)
}

var vals: [Tensor] = []
let placeholder = tensorZeros(DType.F64, [1])
for i in 0..g.values.len() { vals.push(placeholder) }
for i in 0..g.inputs.len() { vals[g.inputs[i]] = tapeVariables[g.tapeVariableOf[g.inputs[i]]].v }

let rt0 = now_ms()
for i in 0..g.nodes.len() {
    let nd = g.nodes[i]
    let ov = g.values[nd.out]
    // Executed here through the same rules irReplay uses, with a timer
    // around each node. Calling irReplay per node would pay a full graph
    // setup every time and measure that instead.
    var x = placeholder
    var y = placeholder
    if nd.a >= 0 { x = vals[nd.a] }
    if nd.b >= 0 { y = vals[nd.b] }
    let a0 = now_ms()
    var r = placeholder
    if nd.op == operationAdd { r = tensorAdd(x, y) }
    if nd.op == operationSubtract { r = tensorSubtract(x, y) }
    if nd.op == operationMultiply { r = tensorMultiply(x, y) }
    if nd.op == operationDivide { r = tensorDivide(x, y) }
    if nd.op == operationNegate { r = tensorNegate(x) }
    if nd.op == operationMatmul { r = tensorMatmul(x, y) }
    if nd.op == operationTanh { r = tensorTanh(x) }
    if nd.op == operationCos { r = tensorCos(x) }
    if nd.op == operationSin { r = tensorSin(x) }
    if nd.op == operationLn { r = tensorLn(x) }
    if nd.op == operationExp { r = tensorExp(x) }
    if nd.op == operationGivens { r = tensorGivens(x, y, nd.integerAttributes[0]) }
    if nd.op == operationBiasTanh { r = tensorBiasTanh(x, y) }
    if nd.op == operationAbs2 { r = tensorAbs2(x) }
    if nd.op == operationConjugate { r = tensorConjugate(x) }
    if nd.op == operationReal { r = tensorReal(x) }
    if nd.op == operationImaginary { r = tensorImaginary(x) }
    if nd.op == operationExpImaginary { r = tensorExpImaginary(x, ov.dtype) }
    if nd.op == operationComplex { r = tensorComplex(x, y, ov.dtype) }
    if nd.op == operationSumDimension { r = tensorSumDimension(x, nd.integerAttributes[0]) }
    if nd.op == operationSumAll { r = tensorSumToOne(x) }
    if nd.op == operationMeanAll { r = tensorDivide(tensorSumToOne(x), tensorFull(x.dtype, [1], tensorElementCount(x) as float)) }
    if nd.op == operationConcat { r = tensorConcat(x, y, nd.integerAttributes[0]) }
    if nd.op == operationRoll { r = tensorRoll(x, nd.integerAttributes[0], nd.integerAttributes[1]) }
    if nd.op == operationTranspose { r = tensorCopy(tensorTranspose(x, nd.integerAttributes[0], nd.integerAttributes[1])) }
    if nd.op == operationReshape { r = tensorReshape(tensorCopy(x), ov.shape) }
    if nd.op == operationExpand { r = tensorCopy(tensorExpand(x, ov.shape)) }
    if nd.op == operationSlice { r = tensorCopy(tensorSlice(x, nd.integerAttributes[0], nd.integerAttributes[1], nd.integerAttributes[2])) }
    if nd.op == operationCast { r = tensorCast(x, ov.dtype) }
    if nd.op == operationIndexSelect {
        var sel: [int] = []
        for k in 2..nd.integerAttributes.len() { sel.push(nd.integerAttributes[k]) }
        r = tensorIndexSelect(x, nd.integerAttributes[0], sel)
    }
    let dt = now_ms() - a0
    vals[nd.out] = r
    t_by_op[nd.op] = t_by_op[nd.op] + dt
    n_by_op[nd.op] = n_by_op[nd.op] + 1
    el_by_op[nd.op] = el_by_op[nd.op] + irElementCount(ov.shape)
}
let replay_ms = now_ms() - rt0

// Agreement between the replayed result and the eager one, so a profile of a
// computation that is not the model does not get reported as if it were.
let eager_loss = tensorGet(autogradValue(loss2), [0])
let replay_loss = tensorGet(vals[g.result], [0])
print("replayed forward in {replay_ms} ms; loss {replay_loss} against eager {eager_loss}")
assert(fabs(replay_loss - eager_loss) / (1.0 + fabs(eager_loss)) < 0.000000000001,
       "the replayed graph disagrees with eager, so this profile is not of the model")
print("")
print("op              nodes    elements      ms     share")
var total = 0.0
for i in 0..NOPS { total = total + t_by_op[i] }
for pass in 0..NOPS {
    // print in descending order of time, without sorting structures
    var best = 0 - 1
    var bestv = 0.0 - 1.0
    for i in 0..NOPS {
        if n_by_op[i] > 0 and t_by_op[i] > bestv {
            best = i
            bestv = t_by_op[i]
        }
    }
    if best < 0 { break }
    print("{irOperationName(best)}   {n_by_op[best]}   {el_by_op[best]}   {t_by_op[best]}   {100.0 * t_by_op[best] / total}%")
    t_by_op[best] = 0.0 - 2.0
}
