// The project op-coverage ledger, derived rather than written down.
//
// A23 asks that every op the model requires be supported on the selected GPU
// with its VJP, and A41 asks for a complete op-coverage ledger. Both need to
// know which ops the model actually reaches, and a hand-maintained list of
// that would be wrong within a week. This instead runs one real full step --
// forward and backward, real and complex -- and counts the opcodes the tape
// recorded, so the answer comes from the model rather than from memory.
//
// It also reports which recorded opcodes carried a complex value, because an
// op needs a device kernel per dtype it is actually used at, not per dtype it
// could in principle take.
import "ml/causal.zeph"
import "ml/gru.zeph"
import "ml/transformer.zeph"
import "ml/optim.zeph"

var SEED = 20260921
fn rnd() -> float { SEED = (SEED * 1103515245 + 12345) % 2147483648
    return ((SEED % 2001) as float) / 1000.0 - 1.0 }
fn rndi(n: int) -> int { SEED = (SEED * 1103515245 + 12345) % 2147483648
    return SEED % n }
fn fill_random(t: Tensor) {
    var idx = indexZeros(t.shape.len())
    var more = tensorElementCount(t) > 0
    while more {
        let re = rnd()
        if dtypeIsComplex(t.dtype) { tensorSetComplex(t, idx, re, rnd()) } else { tensorSet(t, idx, re) }
        more = indexNext(idx, t.shape)
    }
}
let D = 16
let E = 8
let H = 32
let K = 2
let IV = 6
let OV = 3
let N = 8
let T = 4
let config = PhaseConfig{inputVocab: IV, outputVocab: OV, stateDimension: D, embeddingDimension: E, hiddenDimension: H, thinkSteps: K, padToken: 0, epsilon: 0.00000001}
let embedding = tensorZeros(DType.F64, [IV, E])
let think = tensorZeros(DType.F64, [E])
let W1 = tensorZeros(DType.F64, [H, E + 3 * D])
let b1 = tensorZeros(DType.F64, [H])
let W2 = tensorZeros(DType.F64, [3 * D, H])
let b2 = tensorZeros(DType.F64, [3 * D])
let z_init = tensorZeros(DType.C64, [D])
let Mo = tensorZeros(DType.C64, [OV, D])
let ps = [embedding, think, W1, b1, W2, b2, z_init, Mo]
for i in 0..ps.len() { fill_random(ps[i]) }
let p = PhaseParams{config: config, embedding: embedding, think: think, hiddenWeight: W1, hiddenBias: b1, angleWeight: W2, angleBias: b2, initialState: z_init, readoutMatrix: Mo}
let tokens = tensorZeros(DType.I64, [N, T])
var targets: [int] = []
for row in 0..N {
    for st in 0..T { tensorSetInt(tokens, [row, st], 1 + rndi(IV - 1)) }
    targets.push(rndi(OV))
}

let NAMES = ["LEAF","ADD","SUB","MUL","DIV","NEG","MATMUL","TANH","SUM_DIM","SUM_ALL","MEAN_ALL","ABS2","CONJ","REAL","IMAG","EXPI","COMPLEX","CONCAT","INDEX_SELECT","ROLL","TRANSPOSE","RESHAPE","SLICE","CAST","EXPAND","COS","SIN","LN","EXP","GIVENS","BIAS_TANH"]
var count: [int] = []
for i in 0..NAMES.len() { count.push(0) }
var cplx: [int] = []
for i in 0..NAMES.len() { cplx.push(0) }
// tapeVariables and tapeNodes are NOT index-aligned: autogradLeaf pushes a variable with
// node = -1 and no node at all, so variables outnumber nodes and the indices
// drift apart. An earlier version of this file read tapeVariables[i] for node i,
// which made the per-op counts right and the complex column wrong. The map
// below goes the only direction that is defined: variable to its node.
var node_var: [int] = []
// A node whose opcode has no name here is a new opcode that nobody added to
// the ledger. Crashing on an index was how that was reported before, which
// named neither the opcode nor this file.
for i in 0..tapeNodes.len() {
    if tapeNodes[i].op < 0 or tapeNodes[i].op >= NAMES.len() {
        panic("op_census: opcode {tapeNodes[i].op} has no entry in NAMES. A new operator was added to autograd.zeph without being added to the coverage ledger.")
    }
}
for i in 0..tapeNodes.len() { node_var.push(0 - 1) }
for v in 0..tapeVariables.len() {
    let n = tapeVariables[v].node
    if n >= 0 { node_var[n] = v }
}
for i in 0..tapeNodes.len() {
    let o = tapeNodes[i].op
    count[o] = count[o] + 1
    let v = node_var[i]
    if v >= 0 {
        if dtypeIsComplex(tapeVariables[v].v.dtype) { cplx[o] = cplx[o] + 1 }
    } else {
        print("WARNING: node {i} has no variable, which should be impossible")
    }
}
// Counting is per family and then unioned. The ledger has to be about the
// project, not about one model: the GRU and Transformer controls and the
// causal path reach operators the phase classifier never does, and an
// operator that only a control reaches still needs a correct VJP.
fn tally(count: [int], cplx: [int], names: [str]) -> int {
    var node_var: [int] = []
    for i in 0..tapeNodes.len() { node_var.push(0 - 1) }
    for v in 0..tapeVariables.len() {
        let nd = tapeVariables[v].node
        if nd >= 0 { node_var[nd] = v }
    }
    for i in 0..tapeNodes.len() {
        let o = tapeNodes[i].op
        if o < 0 or o >= names.len() {
            panic("op_census: opcode {o} has no entry in NAMES. A new operator was added to autograd.zeph without being added to the coverage ledger.")
        }
        count[o] = count[o] + 1
        let v = node_var[i]
        if v >= 0 {
            if dtypeIsComplex(tapeVariables[v].v.dtype) { cplx[o] = cplx[o] + 1 }
        }
    }
    return tapeNodes.len()
}

fn fresh(n: int) -> [int] {
    var c: [int] = []
    for i in 0..n { c.push(0) }
    return c
}

var union_count = fresh(NAMES.len())
var union_cplx = fresh(NAMES.len())
var fam_names: [str] = []
var fam_nodes: [int] = []
var fam_reached: [int] = []

fn note_family(label: str, count: [int], cplx: [int], nodes: int) {
    var reached = 0
    var line = ""
    for i in 0..NAMES.len() {
        if count[i] > 0 {
            reached = reached + 1
            union_count[i] = union_count[i] + count[i]
            union_cplx[i] = union_cplx[i] + cplx[i]
        }
    }
    fam_names.push(label)
    fam_nodes.push(nodes)
    fam_reached.push(reached)
    print("  {label}: {nodes} tape nodes, {reached} distinct opcodes")
}

print("per family")

// 1. the phase classifier, in its default configuration
var c1 = fresh(NAMES.len())
var x1 = fresh(NAMES.len())
autogradReset()
autogradBackward(phaseAutogradLoss(phaseAutogradParameters(p, true), tokens, targets))
note_family("phase classifier", c1, x1, tally(c1, x1, NAMES))

// 2. both ablations, which change which operators are reached
readoutIncoherent = true
var c2 = fresh(NAMES.len())
var x2 = fresh(NAMES.len())
autogradReset()
autogradBackward(phaseAutogradLoss(phaseAutogradParameters(p, true), tokens, targets))
note_family("incoherent readout", c2, x2, tally(c2, x2, NAMES))
readoutIncoherent = false

phaseRealRotations = true
var c3 = fresh(NAMES.len())
var x3 = fresh(NAMES.len())
autogradReset()
autogradBackward(phaseAutogradLoss(phaseAutogradParameters(p, true), tokens, targets))
note_family("real rotations", c3, x3, tally(c3, x3, NAMES))
phaseRealRotations = false

// 3. the unfused path, which is what the fusion gate compares against and
//    therefore still has to be differentiable
givensFuse = false
controllerFuse = false
var c4 = fresh(NAMES.len())
var x4 = fresh(NAMES.len())
autogradReset()
autogradBackward(phaseAutogradLoss(phaseAutogradParameters(p, true), tokens, targets))
note_family("phase, fusions off", c4, x4, tally(c4, x4, NAMES))
givensFuse = true
controllerFuse = true

// 4. the causal language-modelling path
let ctok = tensorZeros(DType.I64, [N, T])
for row in 0..N {
    for st in 0..T { tensorSetInt(ctok, [row, st], 1 + rndi(IV - 1)) }
}
let crst = tensorZeros(DType.I64, [N, T])
let cp = PhaseParams{config: PhaseConfig{inputVocab: IV, outputVocab: IV, stateDimension: D, embeddingDimension: E, hiddenDimension: H, thinkSteps: 1, padToken: 0, epsilon: 0.00000001},
                     embedding: p.embedding, think: p.think, hiddenWeight: p.hiddenWeight, hiddenBias: p.hiddenBias, angleWeight: p.angleWeight, angleBias: p.angleBias,
                     initialState: p.initialState, readoutMatrix: tensorZeros(DType.C64, [IV, D])}
fill_random(cp.readoutMatrix)
var c5 = fresh(NAMES.len())
var x5 = fresh(NAMES.len())
autogradReset()
autogradBackward(causalLoss(phaseAutogradParameters(cp, true), ctok, crst, 0 - 1))
note_family("causal language model", c5, x5, tally(c5, x5, NAMES))

// 5. the GRU controls, both heads
for head in 0..2 {
    let hn = 2 * D
    let gp = GruParams{config: GruConfig{inputVocab: IV, outputVocab: OV, embeddingDimension: E, hiddenDimension: hn, head: head, padToken: 0, epsilon: 0.00000001},
                       embedding: tensorZeros(DType.F64, [IV, E]),
                       updateGateWeight: tensorZeros(DType.F64, [hn, E + hn]), updateGateBias: tensorZeros(DType.F64, [hn]),
                       resetGateWeight: tensorZeros(DType.F64, [hn, E + hn]), resetGateBias: tensorZeros(DType.F64, [hn]),
                       candidateWeight: tensorZeros(DType.F64, [hn, E + hn]), candidateBias: tensorZeros(DType.F64, [hn]),
                       outputWeight: tensorZeros(DType.F64, [OV, hn]), outputBias: tensorZeros(DType.F64, [OV]),
                       initialHidden: tensorZeros(DType.F64, [hn])}
    let gl = gruParameterList(gp)
    for i in 0..gl.len() { fill_random(gl[i]) }
    var cg = fresh(NAMES.len())
    var xg = fresh(NAMES.len())
    autogradReset()
    autogradBackward(gruLoss(gruParameters(gp, true), tokens, targets))
    note_family("gru head {head}", cg, xg, tally(cg, xg, NAMES))
}

// 6. the Transformer control
let tp = newTransformer(TfConfig{inputVocab: IV, outputVocab: OV, d: 16, feedForwardDimension: 32, layers: 2, maxLength: T, padToken: 0, epsilon: 0.00001})
let tl = transformerParameterList(tp)
for i in 0..tl.len() { fill_random(tl[i]) }
var ct = fresh(NAMES.len())
var xt = fresh(NAMES.len())
autogradReset()
autogradBackward(transformerLoss(transformerParameters(tp, true), tokens, targets))
note_family("transformer", ct, xt, tally(ct, xt, NAMES))

print("")
print("union across every family")
print("op                count   of which complex")
var reached = 0
for i in 0..NAMES.len() {
    if union_count[i] > 0 {
        reached = reached + 1
        print("  OP_{NAMES[i]}  {union_count[i]}  {union_cplx[i]}")
    }
}
print("reached {reached} of {NAMES.len()} opcodes across the whole project")
var missing = ""
for i in 0..NAMES.len() {
    if union_count[i] == 0 { missing = missing + " " + NAMES[i] }
}
if missing == "" {
    print("every opcode in the ledger is reached by some family")
} else {
    print("never reached by any family:{missing}")
    print("  LEAF is expected here: a leaf is a variable with no node, so it is")
    print("  never counted as one. COMPLEX is genuinely unused -- no family")
    print("  builds a complex value from separate real and imaginary tensors;")
    print("  every complex value comes from expi, a cast or an arithmetic op.")
}
