// The Phase Reasoner v1 forward pass expressed on the autograd tape, so the
// model can be trained natively.
//
// This is a second expression of the same function as lib/ml/phase.zeph, and
// two expressions of one function are a maintenance hazard unless the
// agreement is checked. tests/ml/phase_ad_test.zeph asserts that this forward
// pass reproduces phase.zeph's state and probabilities to the last ulp, which
// turns the hazard into a checked invariant -- the same arrangement the
// reference uses for its paired-real port.
//
// Three differences from phase.zeph, all forced by differentiability:
//
//   * A Givens stage cannot write its results in place. tensorIndexCopy mutates
//     storage, which the tape's saved-tensor version check correctly refuses.
//     The stage instead concatenates the two halves and applies the inverse
//     permutation with one index_select, which is the same map expressed
//     functionally.
//   * PAD rows are masked arithmetically rather than skipped. A skipped row
//     is a control-flow decision the tape cannot see; multiplying by a 0/1
//     mask is equivalent, keeps the graph static, and still contributes
//     exactly nothing to the controller's gradient, because the contribution
//     is scaled by zero.
//   * The norm is reached through exp(-0.5*ln(sum)) rather than sqrt, since
//     ln and exp already carry VJPs and sqrt would need another primitive for
//     no gain.
import "ml/autograd.zeph"
import "ml/phase.zeph"

struct PhaseAD {
    config: PhaseConfig,
    embedding: int,
    think: int,
    hiddenWeight: int,
    hiddenBias: int,
    angleWeight: int,
    angleBias: int,
    initialState: int,
    readoutMatrix: int,
}

// Leaves are created in a fixed order so a caller can rely on the handles.
fn phaseAutogradParameters(parameters: PhaseParams, requiresGradient: bool) -> PhaseAD {
    let embeddingHandle = autogradLeaf(parameters.embedding, requiresGradient)
    let thinkHandle = autogradLeaf(parameters.think, requiresGradient)
    let hiddenWeightHandle = autogradLeaf(parameters.hiddenWeight, requiresGradient)
    let hiddenBiasHandle = autogradLeaf(parameters.hiddenBias, requiresGradient)
    let angleWeightHandle = autogradLeaf(parameters.angleWeight, requiresGradient)
    let angleBiasHandle = autogradLeaf(parameters.angleBias, requiresGradient)
    let initialStateHandle = autogradLeaf(parameters.initialState, requiresGradient)
    let readoutHandle = autogradLeaf(parameters.readoutMatrix, requiresGradient)
    return PhaseAD{config: parameters.config, embedding: embeddingHandle, think: thinkHandle, hiddenWeight: hiddenWeightHandle, hiddenBias: hiddenBiasHandle, angleWeight: angleWeightHandle, angleBias: angleBiasHandle, initialState: initialStateHandle, readoutMatrix: readoutHandle}
}

fn phaseAutogradScalar(value: float) -> int { return autogradLeaf(tensorFull(DType.F64, [], value), false) }

// abs2(z), Re(conj(z_j) z_{j+1}), Im of the same -- invariant under a global
// phase, sensitive to a relative one.
fn phaseAutogradFeatures(state: int) -> int {
    let neighbor = autogradMultiply(autogradConjugate(state), autogradRoll(state, 1, 0 - 1))
    let first = autogradConcat(autogradAbs2(state), autogradReal(neighbor), 1)
    return autogradConcat(first, autogradImaginary(neighbor), 1)
}

// The fusion switch. Off restores the composed stage below, which is what the
// fusion is checked against; a fused-only library could not be checked at all.
var givensFuse = true

// ---------------------------------------------------------------------------
// The two ablations the baselines document requires, as switches rather than
// forked copies of the model. A fork would drift from the model it is an
// ablation of, and then the comparison would be measuring the drift.
//
// Both are OFF by default, so the default model is the model.

// "Incoherent phase readout". The coherent readout is |sum_d M_vd z_d|^2 --
// the contributions are summed as complex amplitudes and can cancel, which
// is the interference the hypothesis is about. The incoherent version sums
// their squared magnitudes instead, sum_d |M_vd|^2 |z_d|^2, so every
// contribution is positive and nothing can cancel. Same parameters, same
// normalisation, same eps; the only thing removed is the interference.
var readoutIncoherent = false

// "No phase-angle modulation / real rotations". Removes the per-coordinate
// phase multiplier from the update and forces every Givens rotation's phi to
// zero, leaving real rotations in a complex container. The state stays
// complex and the parameter count is unchanged -- what is removed is the
// relative-phase mechanism, not the capacity.
var phaseRealRotations = false

// The controller's two bias-then-tanh stages, likewise switchable.
var controllerFuse = true

// One stage, built functionally. combined holds [new_a | new_b] and perm maps
// each output coordinate back to its place in that concatenation.
fn phaseAutogradGivens(state: int, theta: int, phi: int, stage: int, width: int) -> int {
    var left: [int] = []
    var right: [int] = []
    for j in 0..(width / 2) {
        left.push(2 * j + stage)
        right.push((2 * j + stage + 1) % width)
    }
    var permutation: [int] = []
    for j in 0..width { permutation.push(0) }
    for k in 0..(width / 2) {
        permutation[left[k]] = k
        permutation[right[k]] = width / 2 + k
    }
    let pairFirst = autogradIndexSelect(state, 1, left)
    let pairSecond = autogradIndexSelect(state, 1, right)
    let cosTheta = autogradCast(autogradCos(theta), DType.C64)
    let sinTheta = autogradCast(autogradSin(theta), DType.C64)
    let phase = autogradExpImaginary(phi, DType.C64)
    let newPairFirst = autogradAdd(autogradMultiply(cosTheta, pairFirst), autogradMultiply(sinTheta, autogradMultiply(phase, pairSecond)))
    let newPairSecond = autogradAdd(autogradNegate(autogradMultiply(sinTheta, autogradMultiply(autogradConjugate(phase), pairFirst))), autogradMultiply(cosTheta, pairSecond))
    return autogradIndexSelect(autogradConcat(newPairFirst, newPairSecond, 1), 1, permutation)
}

// All 3D angles come from the pre-update state, then phase, even pairs, odd
// cyclic pairs, in that order.
fn phaseAutogradUpdate(model: PhaseAD, state: int, embedding: int) -> int {
    let width = model.config.stateDimension
    let inputs = autogradConcat(embedding, phaseAutogradFeatures(state), 1)
    var hidden = 0
    var bounded = 0
    if controllerFuse {
        hidden = autogradBiasTanh(autogradMatmul(inputs, autogradTranspose(model.hiddenWeight, 0, 1)), model.hiddenBias)
        bounded = autogradBiasTanh(autogradMatmul(hidden, autogradTranspose(model.angleWeight, 0, 1)), model.angleBias)
    } else {
        hidden = autogradTanh(autogradAdd(autogradMatmul(inputs, autogradTranspose(model.hiddenWeight, 0, 1)), model.hiddenBias))
        bounded = autogradTanh(autogradAdd(autogradMatmul(hidden, autogradTranspose(model.angleWeight, 0, 1)), model.angleBias))
    }
    let angles = autogradMultiply(bounded, phaseAutogradScalar(pi))
    // The phase modulation, and the ablation that removes it. Under the
    // ablation the state passes through unmodulated and each stage's phi
    // half is multiplied by zero, which leaves a real rotation.
    var phased = state
    if not phaseRealRotations {
        phased = autogradMultiply(state, autogradExpImaginary(autogradSlice(angles, 1, 0, width), DType.C64))
    }
    if phaseRealRotations {
        let thetaMask = tensorZeros(DType.F64, [1, width])
        for j in 0..(width / 2) { tensorSet(thetaMask, [0, j], 1.0) }
        let thetaMaskHandle = autogradLeaf(thetaMask, false)
        let evenAngles = autogradMultiply(autogradSlice(angles, 1, width, 2 * width), thetaMaskHandle)
        let oddAngles = autogradMultiply(autogradSlice(angles, 1, 2 * width, 3 * width), thetaMaskHandle)
        if givensFuse {
            return autogradGivens(autogradGivens(phased, evenAngles, 0), oddAngles, 1)
        }
        let evenState = phaseAutogradGivens(phased, autogradSlice(evenAngles, 1, 0, width / 2), autogradSlice(evenAngles, 1, width / 2, width), 0, width)
        return phaseAutogradGivens(evenState, autogradSlice(oddAngles, 1, 0, width / 2), autogradSlice(oddAngles, 1, width / 2, width), 1, width)
    }
    if givensFuse {
        // theta and phi for a stage are adjacent halves of one angle block,
        // so the fused stage takes the block whole and the two slices go away
        // with the seventeen nodes the composed stage cost.
        let evenFusedState = autogradGivens(phased, autogradSlice(angles, 1, width, 2 * width), 0)
        return autogradGivens(evenFusedState, autogradSlice(angles, 1, 2 * width, 3 * width), 1)
    }
    let evenTheta = autogradSlice(angles, 1, width, width + width / 2)
    let evenPhi = autogradSlice(angles, 1, width + width / 2, 2 * width)
    let even = phaseAutogradGivens(phased, evenTheta, evenPhi, 0, width)
    let oddTheta = autogradSlice(angles, 1, 2 * width, 2 * width + width / 2)
    let oddPhi = autogradSlice(angles, 1, 2 * width + width / 2, 3 * width)
    return phaseAutogradGivens(even, oddTheta, oddPhi, 1, width)
}

// initialState normalized once, then one independent copy per batch row.
fn phaseAutogradInitial(model: PhaseAD, batch: int) -> int {
    let total = autogradSumAll(autogradAbs2(model.initialState))
    let inverseNorm = autogradExp(autogradMultiply(autogradLn(total), phaseAutogradScalar(0.0 - 0.5)))
    let unit = autogradMultiply(model.initialState, autogradCast(inverseNorm, DType.C64))
    return autogradExpand(autogradReshape(unit, [1, model.config.stateDimension]), [batch, model.config.stateDimension])
}

// probabilities = (|Mz|^2 + eps) normalized, denominator sum(w) + V*eps
fn phaseAutogradReadout(model: PhaseAD, state: int) -> int {
    var magnitudes = 0
    if readoutIncoherent {
        // sum_d |M_vd|^2 |z_d|^2, as a real matmul of the two magnitude
        // maps. Reaching it this way rather than by zeroing cross terms
        // keeps it on the tape and keeps the parameters identical.
        magnitudes = autogradMatmul(autogradAbs2(state), autogradTranspose(autogradAbs2(model.readoutMatrix), 0, 1))
    } else {
        magnitudes = autogradAbs2(autogradMatmul(state, autogradTranspose(model.readoutMatrix, 0, 1)))
    }
    let smoothed = autogradAdd(magnitudes, phaseAutogradScalar(model.config.epsilon))
    return autogradDivide(smoothed, autogradSumDimension(smoothed, 1))
}

// A 0/1 column mask per step; PAD rows keep their previous state exactly.
fn phaseAutogradMask(tokens: Tensor, step: int, padToken: int, batch: int) -> Tensor {
    let mask = tensorZeros(DType.F64, [batch, 1])
    for row in 0..batch {
        if tensorGetInt(tokens, [row, step]) != padToken { tensorSet(mask, [row, 0], 1.0) }
    }
    return mask
}

fn phaseAutogradForward(model: PhaseAD, tokens: Tensor) -> int {
    let batch = tokens.shape[0]
    let length = tokens.shape[1]
    let width = model.config.stateDimension
    var state = phaseAutogradInitial(model, batch)
    for step in 0..(length + model.config.thinkSteps) {
        var embedding = autogradExpand(autogradReshape(model.think, [1, model.config.embeddingDimension]), [batch, model.config.embeddingDimension])
        if step < length {
            var tokenIds: [int] = []
            for row in 0..batch { tokenIds.push(tensorGetInt(tokens, [row, step])) }
            embedding = autogradIndexSelect(model.embedding, 0, tokenIds)
        }
        let updated = phaseAutogradUpdate(model, state, embedding)
        if step < length {
            let keep = autogradLeaf(phaseAutogradMask(tokens, step, model.config.padToken, batch), false)
            let drop = autogradLeaf(tensorSubtract(tensorOnes(DType.F64, [batch, 1]), phaseAutogradMask(tokens, step, model.config.padToken, batch)), false)
            let keepComplex = autogradCast(keep, DType.C64)
            let dropComplex = autogradCast(drop, DType.C64)
            state = autogradAdd(autogradMultiply(updated, keepComplex), autogradMultiply(state, dropComplex))
        } else {
            state = updated
        }
    }
    return state
}

// Mean negative log likelihood. The target is selected by a one-hot mask and
// a sum rather than by indexing, so the selection stays on the tape.
fn phaseAutogradLoss(model: PhaseAD, tokens: Tensor, targets: [int]) -> int {
    let batch = tokens.shape[0]
    let probabilities = phaseAutogradReadout(model, phaseAutogradForward(model, tokens))
    let oneHot = tensorZeros(DType.F64, [batch, model.config.outputVocab])
    for row in 0..batch {
        if targets[row] < 0 or targets[row] >= model.config.outputVocab { panic("phase_ad: target out of range") }
        tensorSet(oneHot, [row, targets[row]], 1.0)
    }
    let picked = autogradSumDimension(autogradMultiply(probabilities, autogradLeaf(oneHot, false)), 1)
    return autogradMeanAll(autogradNegate(autogradLn(picked)))
}
