// Version 1, little endian: magic/u64 version/u64 payload bytes/u64 FNV1a32
// (in a u64), then optimizer kind/step, six f64 settings, parameter count,
// and interleaved parameter/m/v records. Each record is dtype/rank/nbytes
// (u64 each), rank u64 dimensions, then raw logical row-major bytes.
import "ml/optim.zeph"

let checkpointMagic = 3554826236233868634
// ponytail: whole-file buffering capped at 256 MiB; stream records for larger models.
let checkpointMaxBytes = 268435456

struct Checkpoint { params: [Tensor], optimizer: Optim }
struct CheckpointRecord { dtype: DType, shape: [int], offset: int, size: int }
struct CheckpointWriter { handle: int, temporaryPath: Bytes, target: Bytes }
var checkpointSerial = 0

// FNV-1a covers all payload bytes, including tensor metadata and optimizer state.
fn checkpointChecksum(buffer: Bytes) -> int {
    var hash = 2166136261
    for i in 32..buffer.size { hash = ((hash ^ buffer.get8(i)) * 16777619) & 4294967295 }
    return hash
}

// Bound every addition before allocating or reading untrusted lengths.
fn checkpointCheckBound(value: int) {
    if value < 0 or value > checkpointMaxBytes { panic("checkpoint: implausibly large allocation") }
}

fn checkpointDtype(code: int) -> DType {
    if code == 0 { return DType.F32 }
    if code == 1 { return DType.F64 }
    if code == 2 { return DType.C32 }
    if code == 3 { return DType.C64 }
    if code == 4 { return DType.I32 }
    if code == 5 { return DType.I64 }
    if code == 6 { return DType.Bool }
    panic("checkpoint: unknown dtype")
    return DType.F64
}

// Encode raw bytes, not float conversions: NaN payloads and signed zero survive.
fn checkpointEncode(params: [Tensor], optimizer: Optim) -> Bytes {
    optimizerValidateState(optimizer, params)
    assert(params.len() <= 65536, "checkpoint: implausibly large allocation")
    var tensors: [Tensor] = []
    var size = 104
    for i in 0..params.len() {
        tensors.push(params[i])
        tensors.push(optimizer.m[i])
        tensors.push(optimizer.v[i])
    }
    for tensor in tensors {
        assert(tensor.shape.len() <= 32, "checkpoint: implausibly large allocation")
        let byteCount = tensorElementCount(tensor) * dtypeSize(tensor.dtype)
        checkpointCheckBound(byteCount)
        size += 24 + 8 * tensor.shape.len() + byteCount
        checkpointCheckBound(size)
    }
    let buffer = Bytes.new(size)
    buffer.put64(0, checkpointMagic)
    buffer.put64(8, 1)
    buffer.put64(16, size - 32)
    buffer.put64(32, optimizer.kind)
    buffer.put64(40, optimizer.step)
    buffer.putFloat64(48, optimizer.learningRate)
    buffer.putFloat64(56, optimizer.weightDecay)
    buffer.putFloat64(64, optimizer.momentum)
    buffer.putFloat64(72, optimizer.beta1)
    buffer.putFloat64(80, optimizer.beta2)
    buffer.putFloat64(88, optimizer.epsilon)
    buffer.put64(96, params.len())
    var position = 104
    for tensor in tensors {
        let width = dtypeSize(tensor.dtype)
        buffer.put64(position, tensor.dtype as int)
        buffer.put64(position + 8, tensor.shape.len())
        buffer.put64(position + 16, tensorElementCount(tensor) * width)
        position += 24
        for dimension in tensor.shape {
            buffer.put64(position, dimension)
            position += 8
        }
        var index = indexZeros(tensor.shape.len())
        for j in 0..tensorElementCount(tensor) {
            let sourceOffset = tensorByteOffset(tensor, index)
            for k in 0..width { buffer.put8(position + k, tensor.storage.buffer.get8(sourceOffset + k)) }
            position += width
            indexNext(index, tensor.shape)
        }
    }
    buffer.put64(24, checkpointChecksum(buffer))
    return buffer
}

// Validate every record and checksum before allocating tensor storage.
fn checkpointDecode(buffer: Bytes) -> Checkpoint {
    if buffer.size < 32 { panic("checkpoint: truncated file") }
    if buffer.get64(0) != checkpointMagic { panic("checkpoint: bad magic") }
    if buffer.get64(8) != 1 { panic("checkpoint: unknown version") }
    let length = buffer.get64(16)
    checkpointCheckBound(length)
    if length > buffer.size - 32 { panic("checkpoint: declared length exceeds file") }
    if length < buffer.size - 32 { panic("checkpoint: trailing data") }
    if buffer.size < 104 { panic("checkpoint: truncated file") }
    let parameterCount = buffer.get64(96)
    if parameterCount < 0 or parameterCount > 65536 { panic("checkpoint: implausibly large allocation") }
    var records: [CheckpointRecord] = []
    var position = 104
    for i in 0..parameterCount * 3 {
        if buffer.size - position < 24 { panic("checkpoint: truncated file") }
        let dtype = checkpointDtype(buffer.get64(position))
        let rank = buffer.get64(position + 8)
        let size = buffer.get64(position + 16)
        checkpointCheckBound(size)
        if rank < 0 or rank > 32 { panic("checkpoint: implausibly large allocation") }
        position += 24
        if rank * 8 > buffer.size - position { panic("checkpoint: truncated file") }
        var shape: [int] = []
        var elements = 1
        for j in 0..rank {
            let dimension = buffer.get64(position)
            checkpointCheckBound(dimension)
            if dimension != 0 and elements > checkpointMaxBytes / dimension { panic("checkpoint: implausibly large allocation") }
            elements = elements * dimension
            shape.push(dimension)
            position += 8
        }
        if elements > checkpointMaxBytes / dtypeSize(dtype) { panic("checkpoint: implausibly large allocation") }
        if elements * dtypeSize(dtype) != size { panic("checkpoint: shape payload mismatch") }
        if size > buffer.size - position { panic("checkpoint: declared length exceeds file") }
        records.push(CheckpointRecord{dtype: dtype, shape: shape, offset: position, size: size})
        position += size
    }
    if position != buffer.size { panic("checkpoint: trailing data") }
    if checkpointChecksum(buffer) != buffer.get64(24) { panic("checkpoint: bad checksum") }
    var params: [Tensor] = []
    var firstMoments: [Tensor] = []
    var secondMoments: [Tensor] = []
    for i in 0..records.len() {
        let currentRecord = records[i]
        let tensor = tensorZeros(currentRecord.dtype, currentRecord.shape)
        for j in 0..currentRecord.size { tensor.storage.buffer.put8(j, buffer.get8(currentRecord.offset + j)) }
        if i % 3 == 0 { params.push(tensor) }
        if i % 3 == 1 { firstMoments.push(tensor) }
        if i % 3 == 2 { secondMoments.push(tensor) }
    }
    let optimizer = Optim{kind: buffer.get64(32), step: buffer.get64(40), learningRate: buffer.getFloat64(48), weightDecay: buffer.getFloat64(56), momentum: buffer.getFloat64(64), beta1: buffer.getFloat64(72), beta2: buffer.getFloat64(80), epsilon: buffer.getFloat64(88), m: firstMoments, v: secondMoments}
    optimizerValidateState(optimizer, params)
    return Checkpoint{params: params, optimizer: optimizer}
}

// Check size before allocation and require a complete native read.
fn checkpointRead(path: str) -> Bytes {
    let pathBytes = cString(path)
    let handle = win("CreateFileA", pathBytes.address, 2147483648, 1, 0, 3, 128, 0)
    assert(handle != 0 - 1, "checkpoint: open failed")
    let sizeOutput = Bytes.new(8)
    let sized = win("GetFileSizeEx", handle, sizeOutput.address)
    if sized == 0 {
        win("CloseHandle", handle)
        panic("checkpoint: size failed")
    }
    let byteCount = sizeOutput.get64(0)
    if byteCount < 0 or byteCount > checkpointMaxBytes {
        win("CloseHandle", handle)
        panic("checkpoint: implausibly large allocation")
    }
    let buffer = Bytes.new(byteCount)
    let bytesRead = Bytes.new(4)
    let readSucceeded = win("ReadFile", handle, buffer.address, byteCount, bytesRead.address, 0)
    let closed = win("CloseHandle", handle)
    assert(readSucceeded != 0 and bytesRead.get32(0) == byteCount, "checkpoint: truncated file")
    assert(closed != 0, "checkpoint: close failed")
    return buffer
}

fn checkpointLoad(path: str) -> Checkpoint { return checkpointDecode(checkpointRead(path)) }

// Staged writer keeps the target untouched until commit. CREATE_NEW prevents
// two writers (or a stale interrupted temp) from sharing a temporary file.
fn checkpointBegin(path: str) -> CheckpointWriter {
    let processId = win("GetCurrentProcessId")
    let target = cString(path)
    for attempt in 0..100 {
        checkpointSerial += 1
        let temporaryPath = cString("{path}.tmp.{processId}.{checkpointSerial}")
        let handle = win("CreateFileA", temporaryPath.address, 1073741824, 0, 0, 1, 128, 0)
        if handle != 0 - 1 { return CheckpointWriter{handle: handle, temporaryPath: temporaryPath, target: target} }
        if win("GetLastError") != 80 { panic("checkpoint: temporary open failed") }
    }
    panic("checkpoint: temporary names exhausted")
    return CheckpointWriter{handle: 0 - 1, temporaryPath: target, target: target}
}

fn checkpointAbort(writer: CheckpointWriter) {
    if writer.handle != 0 - 1 { win("CloseHandle", writer.handle) }
    writer.handle = 0 - 1
    win("DeleteFileA", writer.temporaryPath.address)
}

// A failed/short write discards only the temporary file.
fn checkpointWrite(writer: CheckpointWriter, buffer: Bytes, offset: int, size: int) {
    assert(offset >= 0 and size >= 0 and offset <= buffer.size and size <= buffer.size - offset, "checkpoint: write bounds")
    let bytesWritten = Bytes.new(4)
    let succeeded = win("WriteFile", writer.handle, buffer.at(offset), size, bytesWritten.address, 0)
    if succeeded == 0 or bytesWritten.get32(0) != size {
        checkpointAbort(writer)
        panic("checkpoint: write failed")
    }
}

// Flush and close BEFORE atomic same-directory replacement. No delete-target
// fallback: failed publication must leave the previous checkpoint intact.
fn checkpointCommit(writer: CheckpointWriter) {
    let flushed = win("FlushFileBuffers", writer.handle)
    let closed = win("CloseHandle", writer.handle)
    writer.handle = 0 - 1
    if flushed == 0 or closed == 0 {
        checkpointAbort(writer)
        panic("checkpoint: flush/close failed")
    }
    if win("MoveFileExA", writer.temporaryPath.address, writer.target.address, 9) == 0 {
        checkpointAbort(writer)
        panic("checkpoint: atomic rename failed")
    }
}

fn checkpointSave(path: str, params: [Tensor], optimizer: Optim) {
    let buffer = checkpointEncode(params, optimizer)
    let writer = checkpointBegin(path)
    checkpointWrite(writer, buffer, 0, 32)
    checkpointWrite(writer, buffer, 32, buffer.size - 32)
    checkpointCommit(writer)
}
