// GRU controls composed entirely from the existing autograd operators.
import "ml/autograd.zeph"

struct GruConfig {
    inputVocab: int,
    outputVocab: int,
    embeddingDimension: int,
    hiddenDimension: int,
    head: int,
    padToken: int,
    epsilon: float,
}

struct GruParams {
    config: GruConfig,
    embedding: Tensor,
    updateGateWeight: Tensor,
    updateGateBias: Tensor,
    resetGateWeight: Tensor,
    resetGateBias: Tensor,
    candidateWeight: Tensor,
    candidateBias: Tensor,
    outputWeight: Tensor,
    outputBias: Tensor,
    initialHidden: Tensor,
}

struct GruAD {
    config: GruConfig,
    embedding: int,
    updateGateWeight: int,
    updateGateBias: int,
    resetGateWeight: int,
    resetGateBias: int,
    candidateWeight: int,
    candidateBias: int,
    outputWeight: int,
    outputBias: int,
    initialHidden: int,
}

// This order is also the leaf allocation order used by optimizers.
fn gruParameterList(parameters: GruParams) -> [Tensor] {
    return [parameters.embedding, parameters.updateGateWeight, parameters.updateGateBias, parameters.resetGateWeight, parameters.resetGateBias, parameters.candidateWeight, parameters.candidateBias, parameters.outputWeight, parameters.outputBias, parameters.initialHidden]
}

// Reject incompatible parameters before allocating any tape leaves.
fn gruParameters(parameters: GruParams, requiresGradient: bool) -> GruAD {
    let config = parameters.config
    if config.inputVocab <= 0 or config.outputVocab <= 0 or config.embeddingDimension <= 0 or config.hiddenDimension <= 0 { panic("gru: dimensions must be positive") }
    if config.head != 0 and config.head != 1 { panic("gru: unknown head") }
    if config.padToken < 0 or config.padToken >= config.inputVocab { panic("gru: PAD out of range") }
    if not (config.epsilon > 0.0) or config.epsilon - config.epsilon != 0.0 { panic("gru: eps must be finite and positive") }
    let parameterTensors = gruParameterList(parameters)
    let shapes = [[config.inputVocab, config.embeddingDimension], [config.hiddenDimension, config.embeddingDimension + config.hiddenDimension], [config.hiddenDimension],
                  [config.hiddenDimension, config.embeddingDimension + config.hiddenDimension], [config.hiddenDimension], [config.hiddenDimension, config.embeddingDimension + config.hiddenDimension], [config.hiddenDimension],
                  [config.outputVocab, config.hiddenDimension], [config.outputVocab], [config.hiddenDimension]]
    var handles: [int] = []
    for i in 0..parameterTensors.len() {
        if parameterTensors[i].dtype != DType.F64 or not shapesEqual(parameterTensors[i].shape, shapes[i]) { panic("gru: parameter shape or dtype mismatch") }
    }
    for i in 0..parameterTensors.len() { handles.push(autogradLeaf(parameterTensors[i], requiresGradient)) }
    return GruAD{config: config, embedding: handles[0], updateGateWeight: handles[1], updateGateBias: handles[2], resetGateWeight: handles[3], resetGateBias: handles[4],
                 candidateWeight: handles[5], candidateBias: handles[6], outputWeight: handles[7], outputBias: handles[8], initialHidden: handles[9]}
}

fn gruScalar(value: float) -> int { return autogradLeaf(tensorFull(DType.F64, [], value), false) }

// sigmoid(x) = (tanh(x / 2) + 1) / 2, with no new tape primitive.
fn gruSigmoid(x: int) -> int {
    let half = gruScalar(0.5)
    return autogradMultiply(half, autogradAdd(autogradTanh(autogradMultiply(half, x)), gruScalar(1.0)))
}

// Standard reset-before-candidate GRU recurrence on [batch, features].
fn gruUpdate(model: GruAD, hidden: int, input: int) -> int {
    let concatenated = autogradConcat(input, hidden, 1)
    let updateGate = gruSigmoid(autogradAdd(autogradMatmul(concatenated, autogradTranspose(model.updateGateWeight, 0, 1)), model.updateGateBias))
    let resetGate = gruSigmoid(autogradAdd(autogradMatmul(concatenated, autogradTranspose(model.resetGateWeight, 0, 1)), model.resetGateBias))
    let candidateInput = autogradConcat(input, autogradMultiply(resetGate, hidden), 1)
    let candidate = autogradTanh(autogradAdd(autogradMatmul(candidateInput, autogradTranspose(model.candidateWeight, 0, 1)), model.candidateBias))
    return autogradAdd(autogradMultiply(autogradSubtract(gruScalar(1.0), updateGate), candidate), autogradMultiply(updateGate, hidden))
}

// Each batch row starts from the same trainable state; PAD is a tape mask.
fn gruForward(model: GruAD, tokens: Tensor) -> int {
    if tokens.dtype != DType.I64 or tokens.shape.len() != 2 { panic("gru: tokens must be a rank-2 I64 tensor") }
    let batch = tokens.shape[0]
    if batch <= 0 { panic("gru: empty batch") }
    var hidden = autogradExpand(autogradReshape(model.initialHidden, [1, model.config.hiddenDimension]), [batch, model.config.hiddenDimension])
    for step in 0..tokens.shape[1] {
        var tokenIds: [int] = []
        let mask = tensorZeros(DType.F64, [batch, 1])
        for row in 0..batch {
            let tokenId = tensorGetInt(tokens, [row, step])
            if tokenId < 0 or tokenId >= model.config.inputVocab { panic("gru: token out of range") }
            tokenIds.push(tokenId)
            if tokenId != model.config.padToken { tensorSet(mask, [row, 0], 1.0) }
        }
        let updated = gruUpdate(model, hidden, autogradIndexSelect(model.embedding, 0, tokenIds))
        let keep = autogradLeaf(mask, false)
        hidden = autogradAdd(autogradMultiply(keep, updated), autogradMultiply(autogradSubtract(gruScalar(1.0), keep), hidden))
    }
    return hidden
}

// Quadratic normalization matches phaseAutogradReadout, including eps per class.
// Softmax uses a detached row shift: translation invariance makes its
// derivative cancel, so treating this numerical stabilizer as constant is exact.
fn gruReadout(model: GruAD, hidden: int) -> int {
    let logits = autogradAdd(autogradMatmul(hidden, autogradTranspose(model.outputWeight, 0, 1)), model.outputBias)
    var scores = 0
    if model.config.head == 1 {
        scores = autogradAdd(autogradMultiply(logits, logits), gruScalar(model.config.epsilon))
    } else {
        let logitValues = autogradValue(logits)
        let shift = tensorZeros(DType.F64, [logitValues.shape[0], 1])
        for row in 0..logitValues.shape[0] {
            var largest = tensorGet(logitValues, [row, 0])
            for column in 1..model.config.outputVocab {
                let value = tensorGet(logitValues, [row, column])
                if value > largest { largest = value }
            }
            tensorSet(shift, [row, 0], largest)
        }
        scores = autogradExp(autogradSubtract(logits, autogradLeaf(shift, false)))
    }
    return autogradDivide(scores, autogradSumDimension(scores, 1))
}

// Match phaseAutogradLoss: one-hot selection, then mean negative log likelihood.
fn gruLoss(model: GruAD, tokens: Tensor, targets: [int]) -> int {
    if tokens.shape.len() != 2 { panic("gru: tokens must be rank-2") }
    let batch = tokens.shape[0]
    if targets.len() != batch { panic("gru: target count must match batch") }
    let oneHot = tensorZeros(DType.F64, [batch, model.config.outputVocab])
    for row in 0..batch {
        if targets[row] < 0 or targets[row] >= model.config.outputVocab { panic("gru: target out of range") }
        tensorSet(oneHot, [row, targets[row]], 1.0)
    }
    let probabilities = gruReadout(model, gruForward(model, tokens))
    let picked = autogradSumDimension(autogradMultiply(probabilities, autogradLeaf(oneHot, false)), 1)
    return autogradMeanAll(autogradNegate(autogradLn(picked)))
}
