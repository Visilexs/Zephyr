// CPU operators over the descriptors in ml/tensor.zeph -- milestone M2b.
// Acceptance A04 (operator fixtures against the reference, including
// non-contiguous layouts and invalid inputs) and A05 (complex arithmetic).
//
// Everything here is out-of-place and same-dtype. There is no promotion: the
// specification wants a mixed-dtype call to be an error the caller resolves
// with an explicit cast, not a silent widening. Nothing here records a tape;
// autograd is M4 and will wrap these.
//
// The accumulation order is the reference order -- plain row-major traversal,
// no reassociation, no fused paths. A faster kernel must reproduce these
// numbers under the strict numeric policy, so this file is what it is
// measured against.
import "ml/tensor.zeph"
// Keep the established math surface: model programs may already define E.
import "std/math_core.zeph"

fn requireSameDtype(left: Tensor, right: Tensor, operationName: str) {
    if left.dtype != right.dtype {
        panic("{operationName}: dtype mismatch, {dtypeName(left.dtype)} against {dtypeName(right.dtype)}; cast explicitly")
    }
}

// Both operands are expanded to the broadcast shape, then read through
// zero-stride views. No data is copied to do it.
fn broadcastPair(left: Tensor, right: Tensor, operationName: str) -> [int] {
    requireSameDtype(left, right, operationName)
    return broadcastShape(left.shape, right.shape)
}

// ---- elementwise binary ----------------------------------------------------

// op: 0 add, 1 sub, 2 mul, 3 div
fn elementwiseReal(left: float, right: float, opcode: int) -> float {
    if opcode == 0 { return left + right }
    if opcode == 1 { return left - right }
    if opcode == 2 { return left * right }
    return left / right
}

// Smith's algorithm for the division, so an intermediate does not overflow
// merely because the components are large. Scaling by the larger component
// keeps the ratio at or below one.
fn complexDivideReal(numeratorReal: float, numeratorImaginary: float, denominatorReal: float, denominatorImaginary: float) -> float {
    if fabs(denominatorReal) >= fabs(denominatorImaginary) {
        let ratio = denominatorImaginary / denominatorReal
        return (numeratorReal + numeratorImaginary * ratio) / (denominatorReal + denominatorImaginary * ratio)
    }
    let ratio = denominatorReal / denominatorImaginary
    return (numeratorReal * ratio + numeratorImaginary) / (denominatorReal * ratio + denominatorImaginary)
}

fn complexDivideImaginary(numeratorReal: float, numeratorImaginary: float, denominatorReal: float, denominatorImaginary: float) -> float {
    if fabs(denominatorReal) >= fabs(denominatorImaginary) {
        let ratio = denominatorImaginary / denominatorReal
        return (numeratorImaginary - numeratorReal * ratio) / (denominatorReal + denominatorImaginary * ratio)
    }
    let ratio = denominatorReal / denominatorImaginary
    return (numeratorImaginary * ratio - numeratorReal) / (denominatorReal * ratio + denominatorImaginary)
}

// ---------------------------------------------------------------------------
// Backend hooks.
//
// A backend takes over an op family by pushing one function here; empty means
// the CPU body below, which is what every existing bit-exact comparison in
// this repository runs against. The unary hook is keyed by the device opcode
// so that tensorUnaryMap and the five complex-specific ops share one slot instead of
// needing five, and the output dtype is passed because abs2, real, imag and
// expi all change it.
//
// The cost is one length check per call against bodies that are O(n) or
// worse, so the CPU path is unaffected.
var binaryHook: [fn(Tensor, Tensor, int) -> Tensor] = []
var unaryHook: [fn(Tensor, int, DType) -> Tensor] = []
var sumDimensionHook: [fn(Tensor, int) -> Tensor] = []
var gatherHook: [fn(Tensor, int, [int]) -> Tensor] = []

fn callUnaryHook(tensor: Tensor, opcode: int, outputDtype: DType) -> Tensor {
    let hook = unaryHook[0]
    return hook(tensor, opcode, outputDtype)
}

fn tensorBinary(left: Tensor, right: Tensor, opcode: int, operationName: str) -> Tensor {
    if binaryHook.len() > 0 {
        let hook = binaryHook[0]
        return hook(left, right, opcode)
    }
    return tensorBinaryCpu(left, right, opcode, operationName)
}

fn tensorBinaryCpu(left: Tensor, right: Tensor, opcode: int, operationName: str) -> Tensor {
    let shape = broadcastPair(left, right, operationName)
    let expandedLeft = tensorExpand(left, shape)
    let expandedRight = tensorExpand(right, shape)
    let output = tensorZeros(left.dtype, shape)
    if tensorElementCount(output) == 0 { return output }
    var index = indexZeros(shape.len())
    var more = true
    while more {
        if dtypeIsComplex(left.dtype) {
            let leftReal = tensorGetReal(expandedLeft, index)
            let leftImaginary = tensorGetImaginary(expandedLeft, index)
            let rightReal = tensorGetReal(expandedRight, index)
            let rightImaginary = tensorGetImaginary(expandedRight, index)
            if opcode == 0 {
                tensorSetComplex(output, index, leftReal + rightReal, leftImaginary + rightImaginary)
            } else {
                if opcode == 1 {
                    tensorSetComplex(output, index, leftReal - rightReal, leftImaginary - rightImaginary)
                } else {
                    if opcode == 2 {
                        tensorSetComplex(output, index, leftReal * rightReal - leftImaginary * rightImaginary, leftReal * rightImaginary + leftImaginary * rightReal)
                    } else {
                        tensorSetComplex(output, index, complexDivideReal(leftReal, leftImaginary, rightReal, rightImaginary), complexDivideImaginary(leftReal, leftImaginary, rightReal, rightImaginary))
                    }
                }
            }
        } else {
            if dtypeIsFloat(left.dtype) {
                tensorSet(output, index, elementwiseReal(tensorGet(expandedLeft, index), tensorGet(expandedRight, index), opcode))
            } else {
                panic("{operationName}: integer and bool arithmetic is not supported yet")
            }
        }
        more = indexNext(index, shape)
    }
    return output
}

fn tensorAdd(left: Tensor, right: Tensor) -> Tensor { return tensorBinary(left, right, 0, "add") }
fn tensorSubtract(left: Tensor, right: Tensor) -> Tensor { return tensorBinary(left, right, 1, "sub") }
fn tensorMultiply(left: Tensor, right: Tensor) -> Tensor { return tensorBinary(left, right, 2, "mul") }
fn tensorDivide(left: Tensor, right: Tensor) -> Tensor { return tensorBinary(left, right, 3, "div") }

// ---- elementwise unary -----------------------------------------------------

fn tensorNegate(tensor: Tensor) -> Tensor {
    let output = tensorZeros(tensor.dtype, tensor.shape)
    if tensorElementCount(tensor) == 0 { return output }
    var index = indexZeros(tensor.shape.len())
    var more = true
    while more {
        if dtypeIsComplex(tensor.dtype) {
            tensorSetComplex(output, index, 0.0 - tensorGetReal(tensor, index), 0.0 - tensorGetImaginary(tensor, index))
        } else {
            tensorSet(output, index, 0.0 - tensorGet(tensor, index))
        }
        more = indexNext(index, tensor.shape)
    }
    return output
}

fn tensorConjugate(tensor: Tensor) -> Tensor {
    if unaryHook.len() > 0 { return callUnaryHook(tensor, 7, tensor.dtype) }
    return tensorConjugateCpu(tensor)
}

fn tensorConjugateCpu(tensor: Tensor) -> Tensor {
    if not dtypeIsComplex(tensor.dtype) { panic("conj: not a complex tensor") }
    let output = tensorZeros(tensor.dtype, tensor.shape)
    if tensorElementCount(tensor) == 0 { return output }
    var index = indexZeros(tensor.shape.len())
    var more = true
    while more {
        tensorSetComplex(output, index, tensorGetReal(tensor, index), 0.0 - tensorGetImaginary(tensor, index))
        more = indexNext(index, tensor.shape)
    }
    return output
}

// abs2 leaves the complex domain, so the output dtype is the component dtype.
// This is the only real-from-complex path that is not an error, and its VJP
// is 2z under the real inner product.
fn tensorAbs2(tensor: Tensor) -> Tensor {
    if unaryHook.len() > 0 { return callUnaryHook(tensor, 6, dtypeComponent(tensor.dtype)) }
    return tensorAbs2Cpu(tensor)
}

fn tensorAbs2Cpu(tensor: Tensor) -> Tensor {
    if not dtypeIsComplex(tensor.dtype) { panic("abs2: not a complex tensor") }
    let output = tensorZeros(dtypeComponent(tensor.dtype), tensor.shape)
    if tensorElementCount(tensor) == 0 { return output }
    var index = indexZeros(tensor.shape.len())
    var more = true
    while more {
        let realPart = tensorGetReal(tensor, index)
        let imaginaryPart = tensorGetImaginary(tensor, index)
        tensorSet(output, index, realPart * realPart + imaginaryPart * imaginaryPart)
        more = indexNext(index, tensor.shape)
    }
    return output
}

fn tensorReal(tensor: Tensor) -> Tensor {
    if unaryHook.len() > 0 { return callUnaryHook(tensor, 8, dtypeComponent(tensor.dtype)) }
    return tensorRealCpu(tensor)
}

fn tensorRealCpu(tensor: Tensor) -> Tensor {
    if not dtypeIsComplex(tensor.dtype) { panic("real: not a complex tensor") }
    let output = tensorZeros(dtypeComponent(tensor.dtype), tensor.shape)
    if tensorElementCount(tensor) == 0 { return output }
    var index = indexZeros(tensor.shape.len())
    var more = true
    while more {
        tensorSet(output, index, tensorGetReal(tensor, index))
        more = indexNext(index, tensor.shape)
    }
    return output
}

fn tensorImaginary(tensor: Tensor) -> Tensor {
    if unaryHook.len() > 0 { return callUnaryHook(tensor, 9, dtypeComponent(tensor.dtype)) }
    return tensorImaginaryCpu(tensor)
}

fn tensorImaginaryCpu(tensor: Tensor) -> Tensor {
    if not dtypeIsComplex(tensor.dtype) { panic("imag: not a complex tensor") }
    let output = tensorZeros(dtypeComponent(tensor.dtype), tensor.shape)
    if tensorElementCount(tensor) == 0 { return output }
    var index = indexZeros(tensor.shape.len())
    var more = true
    while more {
        tensorSet(output, index, tensorGetImaginary(tensor, index))
        more = indexNext(index, tensor.shape)
    }
    return output
}

// expi(theta) = cos(theta) + i sin(theta), real in, complex out. The phase
// gate is built on this.
fn tensorExpImaginary(tensor: Tensor, outputDtype: DType) -> Tensor {
    if unaryHook.len() > 0 { return callUnaryHook(tensor, 10, outputDtype) }
    return tensorExpImaginaryCpu(tensor, outputDtype)
}

fn tensorExpImaginaryCpu(tensor: Tensor, outputDtype: DType) -> Tensor {
    if not dtypeIsFloat(tensor.dtype) { panic("expi: argument must be a real float tensor") }
    if not dtypeIsComplex(outputDtype) { panic("expi: output dtype must be complex") }
    let output = tensorZeros(outputDtype, tensor.shape)
    if tensorElementCount(tensor) == 0 { return output }
    var index = indexZeros(tensor.shape.len())
    var more = true
    while more {
        let angle = tensorGet(tensor, index)
        tensorSetComplex(output, index, fcos(angle), fsin(angle))
        more = indexNext(index, tensor.shape)
    }
    return output
}

// build a complex tensor from two real ones
fn tensorComplex(realPart: Tensor, imaginaryPart: Tensor, outputDtype: DType) -> Tensor {
    if not dtypeIsComplex(outputDtype) { panic("complex: output dtype must be complex") }
    requireSameDtype(realPart, imaginaryPart, "complex")
    let shape = broadcastShape(realPart.shape, imaginaryPart.shape)
    let expandedReal = tensorExpand(realPart, shape)
    let expandedImaginary = tensorExpand(imaginaryPart, shape)
    let output = tensorZeros(outputDtype, shape)
    if tensorElementCount(output) == 0 { return output }
    var index = indexZeros(shape.len())
    var more = true
    while more {
        tensorSetComplex(output, index, tensorGet(expandedReal, index), tensorGet(expandedImaginary, index))
        more = indexNext(index, shape)
    }
    return output
}

// ---- reductions ------------------------------------------------------------
// sum over an empty tensor is 0, per the specification. mean over an empty
// tensor is an error rather than a NaN, because it is always a caller bug.

fn tensorSumAll(tensor: Tensor) -> float {
    if dtypeIsComplex(tensor.dtype) { panic("sum_all: use tensorSumAllReal / tensorSumAllImaginary") }
    var total = 0.0
    if tensorElementCount(tensor) == 0 { return total }
    var index = indexZeros(tensor.shape.len())
    var more = true
    while more {
        total += tensorGet(tensor, index)
        more = indexNext(index, tensor.shape)
    }
    return total
}

fn tensorMeanAll(tensor: Tensor) -> float {
    let elementCount = tensorElementCount(tensor)
    if elementCount == 0 { panic("mean_all: mean over no elements is undefined") }
    return tensorSumAll(tensor) / (elementCount as float)
}

fn tensorSumAllReal(tensor: Tensor) -> float {
    if not dtypeIsComplex(tensor.dtype) { panic("sum_all_re: not a complex tensor") }
    var total = 0.0
    if tensorElementCount(tensor) == 0 { return total }
    var index = indexZeros(tensor.shape.len())
    var more = true
    while more {
        total += tensorGetReal(tensor, index)
        more = indexNext(index, tensor.shape)
    }
    return total
}

fn tensorSumAllImaginary(tensor: Tensor) -> float {
    if not dtypeIsComplex(tensor.dtype) { panic("sum_all_im: not a complex tensor") }
    var total = 0.0
    if tensorElementCount(tensor) == 0 { return total }
    var index = indexZeros(tensor.shape.len())
    var more = true
    while more {
        total += tensorGetImaginary(tensor, index)
        more = indexNext(index, tensor.shape)
    }
    return total
}

// Reduce one axis, keeping the rank so the result broadcasts back over the
// input without the caller having to reason about which axis vanished.
fn tensorSumDimension(tensor: Tensor, dimension: int) -> Tensor {
    if sumDimensionHook.len() > 0 {
        let hook = sumDimensionHook[0]
        return hook(tensor, dimension)
    }
    return tensorSumDimensionCpu(tensor, dimension)
}

fn tensorSumDimensionCpu(tensor: Tensor, dimension: int) -> Tensor {
    let rank = tensor.shape.len()
    if dimension < 0 or dimension >= rank { panic("sum_dim: dim out of range") }
    var outputShape: [int] = []
    for i in 0..rank { outputShape.push(tensor.shape[i]) }
    outputShape[dimension] = 1
    let output = tensorZeros(tensor.dtype, outputShape)
    if tensorElementCount(tensor) == 0 { return output }
    var index = indexZeros(rank)
    var more = true
    while more {
        var outputIndex: [int] = []
        for i in 0..rank { outputIndex.push(index[i]) }
        outputIndex[dimension] = 0
        if dtypeIsComplex(tensor.dtype) {
            tensorSetComplex(output, outputIndex, tensorGetReal(output, outputIndex) + tensorGetReal(tensor, index),
                              tensorGetImaginary(output, outputIndex) + tensorGetImaginary(tensor, index))
        } else {
            tensorSet(output, outputIndex, tensorGet(output, outputIndex) + tensorGet(tensor, index))
        }
        more = indexNext(index, tensor.shape)
    }
    return output
}

// ---- matmul ----------------------------------------------------------------
// [M,K] @ [K,N] -> [M,N] only. Batch dimensions are deliberately not here: the
// specification wants the two-dimensional case correct and the vector cases
// specified separately rather than inherited by accident.
// A backend may take over matmul by pushing one function here; empty means the
// CPU path below. A list rather than an optional because it needs no default
// value and no new type. The cost is one length check per call, against an
// O(n^3) body, so the CPU path is unaffected and stays the default -- every
// existing bit-exact comparison in this repository runs with this empty.
var matmulHook: [fn(Tensor, Tensor) -> Tensor] = []
var matmulCallCount = 0

fn tensorMatmul(left: Tensor, right: Tensor) -> Tensor {
    matmulCallCount = matmulCallCount + 1
    if matmulHook.len() > 0 {
        let hook = matmulHook[0]
        return hook(left, right)
    }
    return tensorMatmulCpu(left, right)
}

// ---- the matmul fast path --------------------------------------------------
//
// An end-to-end profile of a real training step at the specification's model
// dimension (tools/ml_profile.zeph) puts matmul at 94.85% of the forward: 13
// nodes out of 426, 2480 ms out of 2614. Everything the optimization section
// lists for fusion -- the elementwise chain in the Givens stages -- is about
// 1.9% put together. So this is where the time is, and the reference loop
// below is why it is here rather than in the arithmetic.
//
// The reference reads every element through tensorGet, which allocates a list
// literal for the index on every call, walks the shape to compute an offset,
// and bounds-checks twice. For a [32,416]x[416,128] product that is 1.7
// million list allocations to perform 1.7 million multiply-adds.
//
// This kernel computes the same sums in the same order with the index
// arithmetic hoisted: byte strides are constant per operand, so the inner
// loop advances two pointers and does nothing else. It is not blocked, not
// vectorised and not reassociated -- the accumulation order is identical to
// the reference, which is what keeps it inside the strict numeric policy and
// lets the two be compared bit-for-bit rather than within a tolerance.
//
// Strided and offset views are handled by construction, since the strides are
// read from the tensors. There is no contiguity requirement and so no hidden
// copy.
fn matmulFloat64(left: Tensor, right: Tensor, output: Tensor, rowCount: int, innerSize: int, columnCount: int) {
    let leftBytes = left.storage.buffer
    let rightBytes = right.storage.buffer
    let outputBytes = output.storage.buffer
    let leftColumnStride = left.stride[1] * 8
    let rightRowStride = right.stride[0] * 8
    var i = 0
    while i < rowCount {
        let leftRow = (left.offset + i * left.stride[0]) * 8
        let outputRow = (output.offset + i * output.stride[0]) * 8
        var j = 0
        while j < columnCount {
            var total = 0.0
            var leftPosition = leftRow
            var rightPosition = (right.offset + j * right.stride[1]) * 8
            var innerIndex = 0
            while innerIndex < innerSize {
                total += leftBytes.getFloat64(leftPosition) * rightBytes.getFloat64(rightPosition)
                leftPosition += leftColumnStride
                rightPosition += rightRowStride
                innerIndex += 1
            }
            outputBytes.putFloat64(outputRow + j * output.stride[1] * 8, total)
            j += 1
        }
        i += 1
    }
}

// Complex elements are 16 bytes, real part first, which is the C64 layout in
// tensor.zeph and the same one the device kernels use.
fn matmulComplex64(left: Tensor, right: Tensor, output: Tensor, rowCount: int, innerSize: int, columnCount: int) {
    let leftBytes = left.storage.buffer
    let rightBytes = right.storage.buffer
    let outputBytes = output.storage.buffer
    let leftColumnStride = left.stride[1] * 16
    let rightRowStride = right.stride[0] * 16
    var i = 0
    while i < rowCount {
        let leftRow = (left.offset + i * left.stride[0]) * 16
        let outputRow = (output.offset + i * output.stride[0]) * 16
        var j = 0
        while j < columnCount {
            var sumReal = 0.0
            var sumImaginary = 0.0
            var leftPosition = leftRow
            var rightPosition = (right.offset + j * right.stride[1]) * 16
            var innerIndex = 0
            while innerIndex < innerSize {
                let leftReal = leftBytes.getFloat64(leftPosition)
                let leftImaginary = leftBytes.getFloat64(leftPosition + 8)
                let rightReal = rightBytes.getFloat64(rightPosition)
                let rightImaginary = rightBytes.getFloat64(rightPosition + 8)
                sumReal += leftReal * rightReal - leftImaginary * rightImaginary
                sumImaginary += leftReal * rightImaginary + leftImaginary * rightReal
                leftPosition += leftColumnStride
                rightPosition += rightRowStride
                innerIndex += 1
            }
            let outputPosition = outputRow + j * output.stride[1] * 16
            outputBytes.putFloat64(outputPosition, sumReal)
            outputBytes.putFloat64(outputPosition + 8, sumImaginary)
            j += 1
        }
        i += 1
    }
}

// Off by default until measured; tools/ml_profile.zeph and the A25 suite turn
// it on. "A slower optimization remains disabled" is the specification's rule
// and a default-on optimization cannot honour it.
var matmulFastPath = true

fn tensorMatmulCpu(left: Tensor, right: Tensor) -> Tensor {
    requireSameDtype(left, right, "matmul")
    if left.shape.len() != 2 or right.shape.len() != 2 { panic("matmul: both operands must be rank 2") }
    let rowCount = left.shape[0]
    let innerSize = left.shape[1]
    let columnCount = right.shape[1]
    if right.shape[0] != innerSize {
        panic("matmul: inner dimensions differ, {innerSize} against {right.shape[0]}")
    }
    let output = tensorZeros(left.dtype, [rowCount, columnCount])
    if rowCount == 0 or columnCount == 0 { return output }
    if matmulFastPath {
        if left.dtype == DType.F64 {
            matmulFloat64(left, right, output, rowCount, innerSize, columnCount)
            return output
        }
        if left.dtype == DType.C64 {
            matmulComplex64(left, right, output, rowCount, innerSize, columnCount)
            return output
        }
    }
    var i = 0
    while i < rowCount {
        var j = 0
        while j < columnCount {
            if dtypeIsComplex(left.dtype) {
                var sumReal = 0.0
                var sumImaginary = 0.0
                var parameters = 0
                while parameters < innerSize {
                    let leftReal = tensorGetReal(left, [i, parameters])
                    let leftImaginary = tensorGetImaginary(left, [i, parameters])
                    let rightReal = tensorGetReal(right, [parameters, j])
                    let rightImaginary = tensorGetImaginary(right, [parameters, j])
                    sumReal += leftReal * rightReal - leftImaginary * rightImaginary
                    sumImaginary += leftReal * rightImaginary + leftImaginary * rightReal
                    parameters += 1
                }
                tensorSetComplex(output, [i, j], sumReal, sumImaginary)
            } else {
                var total = 0.0
                var parameters = 0
                while parameters < innerSize {
                    total += tensorGet(left, [i, parameters]) * tensorGet(right, [parameters, j])
                    parameters += 1
                }
                tensorSet(output, [i, j], total)
            }
            j += 1
        }
        i += 1
    }
    return output
}

// conjugate transpose, which is what the complex VJPs are written in terms of
fn tensorConjugateTranspose(tensor: Tensor) -> Tensor {
    if tensor.shape.len() != 2 { panic("conj_transpose: rank 2 only") }
    if dtypeIsComplex(tensor.dtype) { return tensorCopy(tensorConjugate(tensorTranspose(tensor, 0, 1))) }
    return tensorCopy(tensorTranspose(tensor, 0, 1))
}

// ---- real unary maps -------------------------------------------------------
// One dispatcher rather than one loop per function: the traversal is the bulk
// of the code and it is identical every time. Complex inputs are refused
// because tanh of a complex number is not what any caller here means.

let unaryMapTanh = 0
let unaryMapCos = 1
let unaryMapSin = 2
let unaryMapExp = 3
let unaryMapLn = 4

fn applyUnaryMap(value: float, opcode: int) -> float {
    if opcode == unaryMapTanh { return tanh(value) }
    if opcode == unaryMapCos { return fcos(value) }
    if opcode == unaryMapSin { return fsin(value) }
    if opcode == unaryMapExp { return fexp(value) }
    if opcode == unaryMapLn { return fln(value) }
    panic("map1: unknown op")
    return 0.0
}

fn tensorUnaryMap(tensor: Tensor, opcode: int) -> Tensor {
    if unaryHook.len() > 0 { return callUnaryHook(tensor, opcode, tensor.dtype) }
    return tensorUnaryMapCpu(tensor, opcode)
}

fn tensorUnaryMapCpu(tensor: Tensor, opcode: int) -> Tensor {
    if dtypeIsComplex(tensor.dtype) { panic("map1: real tensor required") }
    if not dtypeIsFloat(tensor.dtype) { panic("map1: float tensor required") }
    let output = tensorZeros(tensor.dtype, tensor.shape)
    if tensorElementCount(tensor) == 0 { return output }
    var index = indexZeros(tensor.shape.len())
    var more = true
    while more {
        tensorSet(output, index, applyUnaryMap(tensorGet(tensor, index), opcode))
        more = indexNext(index, tensor.shape)
    }
    return output
}

fn tensorTanh(tensor: Tensor) -> Tensor { return tensorUnaryMap(tensor, unaryMapTanh) }
fn tensorCos(tensor: Tensor) -> Tensor { return tensorUnaryMap(tensor, unaryMapCos) }
fn tensorSin(tensor: Tensor) -> Tensor { return tensorUnaryMap(tensor, unaryMapSin) }
fn tensorExp(tensor: Tensor) -> Tensor { return tensorUnaryMap(tensor, unaryMapExp) }
fn tensorLn(tensor: Tensor) -> Tensor { return tensorUnaryMap(tensor, unaryMapLn) }

// ---- gather and scatter ----------------------------------------------------
// tensorIndexSelect covers three things the phase forward pass needs that would
// otherwise be three operators: embedding lookup (dim 0), picking out one
// Givens stage's pair coordinates (dim 1), and cyclic roll (below).

fn tensorIndexSelect(tensor: Tensor, dimension: int, indices: [int]) -> Tensor {
    if gatherHook.len() > 0 {
        let hook = gatherHook[0]
        return hook(tensor, dimension, indices)
    }
    return tensorIndexSelectCpu(tensor, dimension, indices)
}

fn tensorIndexSelectCpu(tensor: Tensor, dimension: int, indices: [int]) -> Tensor {
    let rank = tensor.shape.len()
    if dimension < 0 or dimension >= rank { panic("index_select: dim out of range") }
    let extent = tensor.shape[dimension]
    for i in 0..indices.len() {
        if indices[i] < 0 or indices[i] >= extent { panic("index_select: index out of range") }
    }
    var outputShape: [int] = []
    for i in 0..rank { outputShape.push(tensor.shape[i]) }
    outputShape[dimension] = indices.len()
    let output = tensorZeros(tensor.dtype, outputShape)
    if shapeElementCount(outputShape) == 0 { return output }
    var index = indexZeros(rank)
    var more = true
    while more {
        var sourceIndex: [int] = []
        for i in 0..rank { sourceIndex.push(index[i]) }
        sourceIndex[dimension] = indices[index[dimension]]
        if dtypeIsComplex(tensor.dtype) {
            tensorSetComplex(output, index, tensorGetReal(tensor, sourceIndex), tensorGetImaginary(tensor, sourceIndex))
        } else {
            tensorSet(output, index, tensorGet(tensor, sourceIndex))
        }
        more = indexNext(index, outputShape)
    }
    return output
}

// The scatter counterpart, writing in place. Duplicate indices are refused
// rather than silently letting the last write win: every use here is a
// disjoint pairing, so a duplicate means a caller bug, not an accumulation.
fn tensorIndexCopy(destination: Tensor, dimension: int, indices: [int], source: Tensor) {
    if destination.readOnly { panic("index_copy: write into a read-only (broadcast) view") }
    requireSameDtype(destination, source, "index_copy")
    let rank = destination.shape.len()
    if source.shape.len() != rank { panic("index_copy: rank mismatch") }
    if dimension < 0 or dimension >= rank { panic("index_copy: dim out of range") }
    if source.shape[dimension] != indices.len() { panic("index_copy: source extent does not match the index count") }
    for i in 0..rank {
        if i != dimension and source.shape[i] != destination.shape[i] { panic("index_copy: shape mismatch off the indexed dimension") }
    }
    let extent = destination.shape[dimension]
    var seen: [int] = []
    for i in 0..extent { seen.push(0) }
    for i in 0..indices.len() {
        if indices[i] < 0 or indices[i] >= extent { panic("index_copy: index out of range") }
        if seen[indices[i]] == 1 { panic("index_copy: duplicate index") }
        seen[indices[i]] = 1
    }
    if tensorElementCount(source) == 0 { return }
    var index = indexZeros(rank)
    var more = true
    while more {
        var destinationIndex: [int] = []
        for i in 0..rank { destinationIndex.push(index[i]) }
        destinationIndex[dimension] = indices[index[dimension]]
        if dtypeIsComplex(source.dtype) {
            tensorSetComplex(destination, destinationIndex, tensorGetReal(source, index), tensorGetImaginary(source, index))
        } else {
            tensorSet(destination, destinationIndex, tensorGet(source, index))
        }
        more = indexNext(index, source.shape)
    }
}

// out[i] = t[(i - shift) mod n], matching numpy's roll, so roll(x, -1) is the
// forward cyclic neighbour the invariant feature map is defined in terms of.
fn tensorRoll(tensor: Tensor, dimension: int, shift: int) -> Tensor {
    let rank = tensor.shape.len()
    if dimension < 0 or dimension >= rank { panic("roll: dim out of range") }
    let extent = tensor.shape[dimension]
    if extent == 0 { return tensorCopy(tensor) }
    var indices: [int] = []
    for i in 0..extent {
        var sourceIndex = (i - shift) % extent
        if sourceIndex < 0 { sourceIndex += extent }
        indices.push(sourceIndex)
    }
    return tensorIndexSelect(tensor, dimension, indices)
}

// ---- concatenation ---------------------------------------------------------

fn tensorConcat(leading: Tensor, trailing: Tensor, dimension: int) -> Tensor {
    requireSameDtype(leading, trailing, "concat")
    let rank = leading.shape.len()
    if trailing.shape.len() != rank { panic("concat: rank mismatch") }
    if dimension < 0 or dimension >= rank { panic("concat: dim out of range") }
    for i in 0..rank {
        if i != dimension and leading.shape[i] != trailing.shape[i] { panic("concat: shape mismatch off the joined dimension") }
    }
    var outputShape: [int] = []
    for i in 0..rank { outputShape.push(leading.shape[i]) }
    outputShape[dimension] = leading.shape[dimension] + trailing.shape[dimension]
    let output = tensorZeros(leading.dtype, outputShape)
    var left: [int] = []
    for i in 0..leading.shape[dimension] { left.push(i) }
    var right: [int] = []
    for i in 0..trailing.shape[dimension] { right.push(leading.shape[dimension] + i) }
    tensorIndexCopy(output, dimension, left, leading)
    tensorIndexCopy(output, dimension, right, trailing)
    return output
}

// ---------------------------------------------------------------------------
// The fused Givens stage.
//
// "A disjoint Givens stage can load a pair, rotate and write once." Unfused,
// one stage is seventeen tape nodes and fourteen [B,D/2] temporaries: two
// index_selects, cos, sin, two casts, expi, five muls, a neg, two adds, a
// concat and a final index_select for the inverse permutation. Fused it is
// one node, one pass, one write per element.
//
// The pairs of a stage are disjoint by construction -- stage 0 pairs (0,1),
// (2,3), ... and stage 1 pairs (1,2), (3,4), ..., (D-1,0) -- so every output
// coordinate is written exactly once and the loop needs no barrier between
// pairs. Two *overlapping* stages do not have that property, which is why the
// even stage still runs to completion before the odd one starts: they are two
// launches, not one. Fusing across them would need the barrier the
// optimization section warns about, and would buy nothing here.
//
// theta and phi arrive as one tensor because they always were one: the caller
// slices them out of adjacent columns of the same angle block. Columns 0..H
// are theta, columns H..2H are phi. That fuses the two slices away as well.
//
// The arithmetic below is not the short form of the rotation. It is the
// composed graph's expression tree written out term for term, including the
// multiplications by the zero imaginary part that a real-to-complex cast
// introduces. The short form differs from it in the sign of zero and in the
// last ulp, and the point of the fusion gate is to compare the two
// bit-for-bit rather than within a tolerance.
fn givensCheck(state: Tensor, thetaPhi: Tensor, stage: int) -> int {
    if not dtypeIsComplex(state.dtype) { panic("givens: state must be complex") }
    if not dtypeIsFloat(thetaPhi.dtype) { panic("givens: angles must be a real float tensor") }
    if state.shape.len() != 2 or thetaPhi.shape.len() != 2 { panic("givens: state and angles must both be 2-D") }
    if stage != 0 and stage != 1 { panic("givens: stage must be 0 or 1") }
    let width = state.shape[1]
    if width < 2 or width % 2 != 0 { panic("givens: state width {width} must be even and at least 2") }
    if thetaPhi.shape[0] != state.shape[0] { panic("givens: angle batch {thetaPhi.shape[0]} does not match state batch {state.shape[0]}") }
    if thetaPhi.shape[1] != width { panic("givens: angle width {thetaPhi.shape[1]} must be the state width {width}, theta then phi") }
    return width
}

fn tensorGivens(state: Tensor, thetaPhi: Tensor, stage: int) -> Tensor {
    let width = givensCheck(state, thetaPhi, stage)
    let halfWidth = width / 2
    let batch = state.shape[0]
    let output = tensorZeros(state.dtype, [batch, width])
    let stateBytes = state.storage.buffer
    let thetaPhiBytes = thetaPhi.storage.buffer
    let outputBytes = output.storage.buffer
    let stateColumnStride = state.stride[1] * 16
    let thetaPhiColumnStride = thetaPhi.stride[1] * 8
    let outputColumnStride = output.stride[1] * 16
    var row = 0
    while row < batch {
        let stateRow = (state.offset + row * state.stride[0]) * 16
        let thetaPhiRow = (thetaPhi.offset + row * thetaPhi.stride[0]) * 8
        let outputRow = (output.offset + row * output.stride[0]) * 16
        var k = 0
        while k < halfWidth {
            let firstColumn = 2 * k + stage
            let secondColumn = (2 * k + stage + 1) % width
            let firstPosition = stateRow + firstColumn * stateColumnStride
            let secondPosition = stateRow + secondColumn * stateColumnStride
            let firstReal = stateBytes.getFloat64(firstPosition)
            let firstImaginary = stateBytes.getFloat64(firstPosition + 8)
            let secondReal = stateBytes.getFloat64(secondPosition)
            let secondImaginary = stateBytes.getFloat64(secondPosition + 8)
            let theta = thetaPhiBytes.getFloat64(thetaPhiRow + k * thetaPhiColumnStride)
            let phi = thetaPhiBytes.getFloat64(thetaPhiRow + (halfWidth + k) * thetaPhiColumnStride)
            let cosTheta = fcos(theta)
            let sinTheta = fsin(theta)
            let phaseReal = fcos(phi)
            let phaseImaginary = fsin(phi)
            // new_a = (c+0i)*a + (s+0i)*(q*b)
            let cosFirstReal = cosTheta * firstReal - 0.0 * firstImaginary
            let cosFirstImaginary = cosTheta * firstImaginary + 0.0 * firstReal
            let phaseSecondReal = phaseReal * secondReal - phaseImaginary * secondImaginary
            let phaseSecondImaginary = phaseReal * secondImaginary + phaseImaginary * secondReal
            let sinPhaseSecondReal = sinTheta * phaseSecondReal - 0.0 * phaseSecondImaginary
            let sinPhaseSecondImaginary = sinTheta * phaseSecondImaginary + 0.0 * phaseSecondReal
            // new_b = -((s+0i)*(conj(q)*a)) + (c+0i)*b
            let conjugatePhaseImaginary = 0.0 - phaseImaginary
            let conjugatePhaseFirstReal = phaseReal * firstReal - conjugatePhaseImaginary * firstImaginary
            let conjugatePhaseFirstImaginary = phaseReal * firstImaginary + conjugatePhaseImaginary * firstReal
            let sinConjugatePhaseFirstReal = sinTheta * conjugatePhaseFirstReal - 0.0 * conjugatePhaseFirstImaginary
            let sinConjugatePhaseFirstImaginary = sinTheta * conjugatePhaseFirstImaginary + 0.0 * conjugatePhaseFirstReal
            let cosSecondReal = cosTheta * secondReal - 0.0 * secondImaginary
            let cosSecondImaginary = cosTheta * secondImaginary + 0.0 * secondReal
            outputBytes.putFloat64(outputRow + firstColumn * outputColumnStride, cosFirstReal + sinPhaseSecondReal)
            outputBytes.putFloat64(outputRow + firstColumn * outputColumnStride + 8, cosFirstImaginary + sinPhaseSecondImaginary)
            outputBytes.putFloat64(outputRow + secondColumn * outputColumnStride, (0.0 - sinConjugatePhaseFirstReal) + cosSecondReal)
            outputBytes.putFloat64(outputRow + secondColumn * outputColumnStride + 8, (0.0 - sinConjugatePhaseFirstImaginary) + cosSecondImaginary)
            k += 1
        }
        row += 1
    }
    return output
}

// The adjoint of the same stage. In (a,b) the rotation is the holomorphic
// linear map [[c, s q], [-s conj(q), c]], so the state gradient is that
// matrix's conjugate transpose applied to the incoming gradient:
//
//     g_a = c gA - s q gB          g_b = s conj(q) gA + c gB
//
// theta and phi are real, so their gradients follow the library's convention
// dL = Re(sum(conj(g) dz)) directly:
//
//     dA/dtheta = -s a + c q b     dB/dtheta = -c conj(q) a - s b
//     dA/dphi   = i s q b          dB/dphi   = i s conj(q) a
//
// and Re(conj(u) i v) = -Im(conj(u) v), which is what the phi lines compute.
//
// Returned as [gz, gtp] because Zephyr has no tuples. Unlike the forward,
// this is the short form rather than a transcription of the composed
// backward pass, so nothing here guarantees agreement to the bit -- only to
// rounding. tests/ml/fusion_test.zeph gates on 1e-14 relative and prints
// what the difference actually is, which at the tested configuration is
// zero. That is a measurement, not a promise.
fn tensorGivensBackward(state: Tensor, thetaPhi: Tensor, gradient: Tensor, stage: int) -> [Tensor] {
    let width = givensCheck(state, thetaPhi, stage)
    let halfWidth = width / 2
    let batch = state.shape[0]
    let stateGradient = tensorZeros(state.dtype, [batch, width])
    let thetaPhiGradient = tensorZeros(thetaPhi.dtype, [batch, width])
    let stateBytes = state.storage.buffer
    let thetaPhiBytes = thetaPhi.storage.buffer
    let gradientBytes = gradient.storage.buffer
    let stateGradientBytes = stateGradient.storage.buffer
    let thetaPhiGradientBytes = thetaPhiGradient.storage.buffer
    let stateColumnStride = state.stride[1] * 16
    let thetaPhiColumnStride = thetaPhi.stride[1] * 8
    let gradientColumnStride = gradient.stride[1] * 16
    let stateGradientColumnStride = stateGradient.stride[1] * 16
    let thetaPhiGradientColumnStride = thetaPhiGradient.stride[1] * 8
    var row = 0
    while row < batch {
        let stateRow = (state.offset + row * state.stride[0]) * 16
        let thetaPhiRow = (thetaPhi.offset + row * thetaPhi.stride[0]) * 8
        let gradientRow = (gradient.offset + row * gradient.stride[0]) * 16
        let stateGradientRow = (stateGradient.offset + row * stateGradient.stride[0]) * 16
        let thetaPhiGradientRow = (thetaPhiGradient.offset + row * thetaPhiGradient.stride[0]) * 8
        var k = 0
        while k < halfWidth {
            let firstColumn = 2 * k + stage
            let secondColumn = (2 * k + stage + 1) % width
            let firstReal = stateBytes.getFloat64(stateRow + firstColumn * stateColumnStride)
            let firstImaginary = stateBytes.getFloat64(stateRow + firstColumn * stateColumnStride + 8)
            let secondReal = stateBytes.getFloat64(stateRow + secondColumn * stateColumnStride)
            let secondImaginary = stateBytes.getFloat64(stateRow + secondColumn * stateColumnStride + 8)
            let gradientFirstReal = gradientBytes.getFloat64(gradientRow + firstColumn * gradientColumnStride)
            let gradientFirstImaginary = gradientBytes.getFloat64(gradientRow + firstColumn * gradientColumnStride + 8)
            let gradientSecondReal = gradientBytes.getFloat64(gradientRow + secondColumn * gradientColumnStride)
            let gradientSecondImaginary = gradientBytes.getFloat64(gradientRow + secondColumn * gradientColumnStride + 8)
            let theta = thetaPhiBytes.getFloat64(thetaPhiRow + k * thetaPhiColumnStride)
            let phi = thetaPhiBytes.getFloat64(thetaPhiRow + (halfWidth + k) * thetaPhiColumnStride)
            let cosTheta = fcos(theta)
            let sinTheta = fsin(theta)
            let phaseReal = fcos(phi)
            let phaseImaginary = fsin(phi)
            let sinPhaseReal = sinTheta * phaseReal
            let sinPhaseImaginary = sinTheta * phaseImaginary
            // g_a = c gA - (s q) gB
            let crossTermFirstReal = sinPhaseReal * gradientSecondReal - sinPhaseImaginary * gradientSecondImaginary
            let crossTermFirstImaginary = sinPhaseReal * gradientSecondImaginary + sinPhaseImaginary * gradientSecondReal
            stateGradientBytes.putFloat64(stateGradientRow + firstColumn * stateGradientColumnStride, cosTheta * gradientFirstReal - crossTermFirstReal)
            stateGradientBytes.putFloat64(stateGradientRow + firstColumn * stateGradientColumnStride + 8, cosTheta * gradientFirstImaginary - crossTermFirstImaginary)
            // g_b = (s conj(q)) gA + c gB
            let crossTermSecondReal = sinPhaseReal * gradientFirstReal + sinPhaseImaginary * gradientFirstImaginary
            let crossTermSecondImaginary = sinPhaseReal * gradientFirstImaginary - sinPhaseImaginary * gradientFirstReal
            stateGradientBytes.putFloat64(stateGradientRow + secondColumn * stateGradientColumnStride, crossTermSecondReal + cosTheta * gradientSecondReal)
            stateGradientBytes.putFloat64(stateGradientRow + secondColumn * stateGradientColumnStride + 8, crossTermSecondImaginary + cosTheta * gradientSecondImaginary)
            // dA/dtheta = -s a + c q b, dB/dtheta = -c conj(q) a - s b
            let phaseSecondReal = phaseReal * secondReal - phaseImaginary * secondImaginary
            let phaseSecondImaginary = phaseReal * secondImaginary + phaseImaginary * secondReal
            let firstThetaDerivativeReal = 0.0 - sinTheta * firstReal + cosTheta * phaseSecondReal
            let firstThetaDerivativeImaginary = 0.0 - sinTheta * firstImaginary + cosTheta * phaseSecondImaginary
            let conjugatePhaseFirstReal = phaseReal * firstReal + phaseImaginary * firstImaginary
            let conjugatePhaseFirstImaginary = phaseReal * firstImaginary - phaseImaginary * firstReal
            let secondThetaDerivativeReal = 0.0 - cosTheta * conjugatePhaseFirstReal - sinTheta * secondReal
            let secondThetaDerivativeImaginary = 0.0 - cosTheta * conjugatePhaseFirstImaginary - sinTheta * secondImaginary
            thetaPhiGradientBytes.putFloat64(thetaPhiGradientRow + k * thetaPhiGradientColumnStride, gradientFirstReal * firstThetaDerivativeReal + gradientFirstImaginary * firstThetaDerivativeImaginary + gradientSecondReal * secondThetaDerivativeReal + gradientSecondImaginary * secondThetaDerivativeImaginary)
            // dA/dphi = i s q b, dB/dphi = i s conj(q) a; Re(conj(g) i v) = -Im(conj(g) v)
            let firstPhiTermReal = sinPhaseReal * secondReal - sinPhaseImaginary * secondImaginary
            let firstPhiTermImaginary = sinPhaseReal * secondImaginary + sinPhaseImaginary * secondReal
            let secondPhiTermReal = sinPhaseReal * firstReal + sinPhaseImaginary * firstImaginary
            let secondPhiTermImaginary = sinPhaseReal * firstImaginary - sinPhaseImaginary * firstReal
            thetaPhiGradientBytes.putFloat64(thetaPhiGradientRow + (halfWidth + k) * thetaPhiGradientColumnStride,
                       0.0 - (gradientFirstReal * firstPhiTermImaginary - gradientFirstImaginary * firstPhiTermReal) - (gradientSecondReal * secondPhiTermImaginary - gradientSecondImaginary * secondPhiTermReal))
            k += 1
        }
        row += 1
    }
    return [stateGradient, thetaPhiGradient]
}

// ---------------------------------------------------------------------------
// The fused controller nonlinearity: tanh(x + b), bias broadcast along rows.
//
// The controller is two of these back to back, and unfused each one is a
// broadcast add that materialises a [B,H] temporary and then a tanh that
// reads it back. Both passes walk the tensor through the generic elementwise
// loop, which allocates an index list per element. Fused it is one pass, one
// temporary, and the bias row read once per row rather than once per element.
//
// out = ftanh(x + b) is the same expression in the same order as the
// composed tensorTanh(tensorAdd(x, b)), so this is bit-exact against it and the gate
// compares tensorHex rather than a tolerance.
fn biasTanhCheck(input: Tensor, bias: Tensor) {
    if input.dtype != DType.F64 or bias.dtype != DType.F64 { panic("bias_tanh: both operands must be f64") }
    if input.shape.len() != 2 { panic("bias_tanh: input must be 2-D, got rank {input.shape.len()}") }
    if bias.shape.len() != 1 { panic("bias_tanh: bias must be 1-D, got rank {bias.shape.len()}") }
    if bias.shape[0] != input.shape[1] { panic("bias_tanh: bias length {bias.shape[0]} does not match the row width {input.shape[1]}") }
}

fn tensorBiasTanh(input: Tensor, bias: Tensor) -> Tensor {
    biasTanhCheck(input, bias)
    let rows = input.shape[0]
    let columns = input.shape[1]
    let output = tensorZeros(DType.F64, [rows, columns])
    let inputBytes = input.storage.buffer
    let biasBytes = bias.storage.buffer
    let outputBytes = output.storage.buffer
    let inputColumnStride = input.stride[1] * 8
    let biasStride = bias.stride[0] * 8
    let outputColumnStride = output.stride[1] * 8
    let biasStart = bias.offset * 8
    var row = 0
    while row < rows {
        var inputPosition = (input.offset + row * input.stride[0]) * 8
        var outputPosition = (output.offset + row * output.stride[0]) * 8
        var biasPosition = biasStart
        var j = 0
        while j < columns {
            outputBytes.putFloat64(outputPosition, tanh(inputBytes.getFloat64(inputPosition) + biasBytes.getFloat64(biasPosition)))
            inputPosition += inputColumnStride
            biasPosition += biasStride
            outputPosition += outputColumnStride
            j += 1
        }
        row += 1
    }
    return output
}

// d/dx tanh(u) = 1 - tanh(u)^2, and the bias gradient is that summed down the
// rows, which is what the broadcast add's VJP does unfused. Returned as
// [gx, gb].
//
// The bias column sums accumulate in row order, the same order reduceToShape
// walks, so this one is bit-exact with the composed backward as well.
fn tensorBiasTanhBackward(forwardOutput: Tensor, gradient: Tensor) -> [Tensor] {
    let rows = forwardOutput.shape[0]
    let columns = forwardOutput.shape[1]
    let inputGradient = tensorZeros(DType.F64, [rows, columns])
    let biasGradient = tensorZeros(DType.F64, [columns])
    let forwardOutputBytes = forwardOutput.storage.buffer
    let gradientBytes = gradient.storage.buffer
    let inputGradientBytes = inputGradient.storage.buffer
    let biasGradientBytes = biasGradient.storage.buffer
    let forwardOutputColumnStride = forwardOutput.stride[1] * 8
    let gradientColumnStride = gradient.stride[1] * 8
    let inputGradientColumnStride = inputGradient.stride[1] * 8
    var row = 0
    while row < rows {
        var forwardOutputPosition = (forwardOutput.offset + row * forwardOutput.stride[0]) * 8
        var gradientPosition = (gradient.offset + row * gradient.stride[0]) * 8
        var inputGradientPosition = (inputGradient.offset + row * inputGradient.stride[0]) * 8
        var j = 0
        while j < columns {
            let tanhValue = forwardOutputBytes.getFloat64(forwardOutputPosition)
            let preActivationGradient = gradientBytes.getFloat64(gradientPosition) * (1.0 - tanhValue * tanhValue)
            inputGradientBytes.putFloat64(inputGradientPosition, preActivationGradient)
            biasGradientBytes.putFloat64(j * 8, biasGradientBytes.getFloat64(j * 8) + preActivationGradient)
            forwardOutputPosition += forwardOutputColumnStride
            gradientPosition += gradientColumnStride
            inputGradientPosition += inputGradientColumnStride
            j += 1
        }
        row += 1
    }
    return [inputGradient, biasGradient]
}
