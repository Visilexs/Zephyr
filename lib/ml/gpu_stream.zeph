// Streams, events and an allocator that recycles only completed storage.
//
// This is the machinery A22 stresses. The specification's memory-runtime
// document is precise about what it wants, and the three sentences that
// shape everything here are:
//
//   "Stream is an ordered execution lane, not guaranteed independent
//    hardware"
//   "Cross-stream consumers must wait on producer events"
//   "Associate each allocation's last use with completion information;
//    releasing a tensor handle cannot immediately recycle in-flight storage"
//
// The first sentence is why this needs no change to device creation. The
// repository creates one queue with queueCount hardcoded to 1, and a second
// queue would mean rewriting vkCreateDevice and risking every graphics
// example. A stream is defined as an ordered lane, explicitly not as
// independent hardware, so two lanes sharing one queue satisfy it: each lane
// keeps its own chain of submissions and its own fences, and ordering
// between lanes goes through semaphores rather than through the queue.
//
// The second sentence is why events carry a binary semaphore as well as a
// fence. A fence answers the host's question, "is this finished yet"; a
// semaphore answers the device's, "do not start until that finished". Both
// are needed and they are not interchangeable.
//
// The specification also says: "Do not emulate every event with device-wide
// idle." vkDeviceWaitIdle appears nowhere in this file. Completion is asked
// per fence, and asked without blocking via vkGetFenceStatus.
//
// Timeline semaphores would be a better fit than binary ones, but there are
// no bindings, structs or constants for them anywhere in lib/vk, and the
// specification permits "timeline semaphores or fences according to
// available support".
import "vk/gfx.zeph"

// An event is a recorded completion point. `fence` is the host's view and
// `sem` is the device's; `pending` distinguishes a submitted event from a
// fresh one, because an unsubmitted fence never signals and treating it as
// merely "not done yet" would deadlock a waiter.
struct GpuEvent {
    fence: int,
    semaphore: int,
    pending: bool,
    commandBuffer: int,        // the command buffer this submission recorded into, owned here
}

// An ordered execution lane. `waits` holds semaphores the next submission on
// this lane must wait for -- consumed by that submission and then cleared,
// because a wait is a one-shot on a binary semaphore and re-waiting on an
// already-consumed one would hang.
struct GpuStream {
    queue: int,
    waits: [int],
}

// Lane 0 is the default queue; lane 1 is the second queue when the device
// has one. Two lanes on genuinely separate queues can overlap, which is what
// makes a missing cross-lane wait observable instead of hidden by the
// in-order behaviour of a single queue.
fn newStreamOnLane(graphics: Gfx, lane: int) -> GpuStream {
    var emptyWaits: [int] = []
    var queue = graphics.queue
    if lane != 0 { queue = graphics.queue2 }
    return GpuStream{ queue: queue, waits: emptyWaits }
}

fn newStream(graphics: Gfx) -> GpuStream { return newStreamOnLane(graphics, 0) }

fn newEvent(graphics: Gfx) -> GpuEvent {
    var fenceCreateInfo = Bytes.new(VkFenceCreateInfo_sizeof)
    fenceCreateInfo.put32(VkFenceCreateInfo_sType, VK_STRUCTURE_TYPE_FENCE_CREATE_INFO)
    var fenceHandle = Bytes.new(8)
    checkVulkanResult(vkCreateFence(graphics.device, fenceCreateInfo.addr(), 0, fenceHandle.addr()), "newEvent: vkCreateFence")
    var semaphoreCreateInfo = Bytes.new(VkSemaphoreCreateInfo_sizeof)
    semaphoreCreateInfo.put32(VkSemaphoreCreateInfo_sType, VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO)
    var semaphoreHandle = Bytes.new(8)
    checkVulkanResult(vkCreateSemaphore(graphics.device, semaphoreCreateInfo.addr(), 0, semaphoreHandle.addr()), "newEvent: vkCreateSemaphore")
    return GpuEvent{ fence: fenceHandle.get64(0), semaphore: semaphoreHandle.get64(0), pending: false, commandBuffer: 0 }
}

// Has the work this event records finished? Asked without blocking, which is
// the point: an allocator that can only answer by stalling the device cannot
// recycle anything during a training step.
//
// An event that was never submitted is reported finished. That is the honest
// answer -- there is no work outstanding -- and it keeps a freshly created
// allocation from being pinned forever by a fence nobody ever signals.
fn eventDone(graphics: Gfx, event: GpuEvent) -> bool {
    if not event.pending { return true }
    return vkGetFenceStatus(graphics.device, event.fence) == VK_SUCCESS
}

fn eventWait(graphics: Gfx, event: GpuEvent) {
    if not event.pending { return }
    var fences = Bytes.new(8)
    fences.put64(0, event.fence)
    checkVulkanResult(vkWaitForFences(graphics.device, 1, fences.addr(), VK_TRUE, 5000000000), "eventWait: vkWaitForFences")
}

fn eventDestroy(graphics: Gfx, event: GpuEvent) {
    // Destroying a fence or semaphore that a pending submission still
    // references is undefined behaviour, so wait first. This is the same
    // early-release rule the allocator enforces for buffers, applied to the
    // synchronisation objects themselves.
    eventWait(graphics, event)
    // The command buffer cannot be freed while its submission is pending, which
    // is why this happens after the wait and not at submit time. Freeing it at
    // submit -- or never, as the first draft did -- is how a stress loop with
    // dozens of outstanding submissions runs the pool out from under itself.
    if event.commandBuffer != 0 {
        var commandBuffers = Bytes.new(8)
        commandBuffers.put64(0, event.commandBuffer)
        vkFreeCommandBuffers(graphics.device, graphics.commandPool, 1, commandBuffers.addr())
    }
    vkDestroyFence(graphics.device, event.fence, 0)
    vkDestroySemaphore(graphics.device, event.semaphore, 0)
}

// Record and submit without waiting. Returns the event that marks completion.
//
// This is the piece gfx.zeph does not provide: `immediate` submits and then
// blocks on its own fence, so nothing can ever be in flight and the phrase
// "delayed completion" has no meaning. Everything below depends on being able
// to leave work outstanding.
fn streamSubmit(graphics: Gfx, stream: GpuStream, event: GpuEvent, recordCommands: fn(int)) -> GpuEvent {
    var allocateInfo = Bytes.new(VkCommandBufferAllocateInfo_sizeof)
    allocateInfo.put32(VkCommandBufferAllocateInfo_sType, VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO)
    allocateInfo.put64(VkCommandBufferAllocateInfo_commandPool, graphics.commandPool)
    allocateInfo.put32(VkCommandBufferAllocateInfo_level, VK_COMMAND_BUFFER_LEVEL_PRIMARY)
    allocateInfo.put32(VkCommandBufferAllocateInfo_commandBufferCount, 1)
    var commandBuffers = Bytes.new(8)
    checkVulkanResult(vkAllocateCommandBuffers(graphics.device, allocateInfo.addr(), commandBuffers.addr()), "streamSubmit: vkAllocateCommandBuffers")
    let commandBuffer = commandBuffers.get64(0)

    var beginInfo = Bytes.new(VkCommandBufferBeginInfo_sizeof)
    beginInfo.put32(VkCommandBufferBeginInfo_sType, VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO)
    beginInfo.put32(VkCommandBufferBeginInfo_flags, VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT)
    checkVulkanResult(vkBeginCommandBuffer(commandBuffer, beginInfo.addr()), "streamSubmit: vkBeginCommandBuffer")
    recordCommands(commandBuffer)
    checkVulkanResult(vkEndCommandBuffer(commandBuffer), "streamSubmit: vkEndCommandBuffer")

    var submitInfo = Bytes.new(VkSubmitInfo_sizeof)
    submitInfo.put32(VkSubmitInfo_sType, VK_STRUCTURE_TYPE_SUBMIT_INFO)
    submitInfo.put32(VkSubmitInfo_commandBufferCount, 1)
    submitInfo.put64(VkSubmitInfo_pCommandBuffers, commandBuffers.addr())

    // Cross-stream ordering: whatever this lane was told to wait for is
    // consumed here, at COMPUTE_SHADER stage, and then cleared.
    var waitSemaphores = uint64Array(stream.waits)
    var stages = Bytes.new(4 * 16)
    if stream.waits.len() > 0 {
        for i in 0..stream.waits.len() { stages.put32(i * 4, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT) }
        submitInfo.put32(VkSubmitInfo_waitSemaphoreCount, stream.waits.len())
        submitInfo.put64(VkSubmitInfo_pWaitSemaphores, waitSemaphores.addr())
        submitInfo.put64(VkSubmitInfo_pWaitDstStageMask, stages.addr())
    }
    var signalSemaphores = Bytes.new(8)
    signalSemaphores.put64(0, event.semaphore)
    submitInfo.put32(VkSubmitInfo_signalSemaphoreCount, 1)
    submitInfo.put64(VkSubmitInfo_pSignalSemaphores, signalSemaphores.addr())

    checkVulkanResult(vkQueueSubmit(stream.queue, 1, submitInfo.addr(), event.fence), "streamSubmit: vkQueueSubmit")
    let cleared: [int] = []
    stream.waits = cleared
    return GpuEvent{ fence: event.fence, semaphore: event.semaphore, pending: true, commandBuffer: commandBuffer }
}

// Make the next submission on `s` wait for `e`. This is the cross-stream
// ordering primitive: a consumer on one lane waits on the producer's event
// rather than on device idle.
fn streamWaitEvent(stream: GpuStream, event: GpuEvent) {
    if not event.pending { return }
    stream.waits.push(event.semaphore)
}

// ---------------------------------------------------------------------------
// The allocator.
//
// Every allocation remembers the event of the last submission that used it.
// Releasing a handle does not return storage to the free list; it moves the
// allocation to `retired`, where it stays until its event reports done. That
// is the whole of "releasing a tensor handle cannot immediately recycle
// in-flight storage", and it is the property the delayed-completion stress
// test is designed to break.

struct GpuAlloc {
    buffer: GpuBuffer,
    last: GpuEvent,     // the submission that last touched this storage
    live: bool,         // handed out to an owner right now
    referenceCount: int,          // owners plus views; storage retires at zero, not before
}

struct GpuPool {
    g: Gfx,
    allocations: [GpuAlloc],
    free: [int],        // indices into allocs, known complete, reusable
    retired: [int],     // indices released by their owner but possibly in flight
    liveBytes: int,
    peakBytes: int,
    totalAllocated: int,   // how many vkCreateBuffer calls we have made
    reuses: int,            // how many acquisitions were served from the free list
    limitBytes: int,       // 0 means no limit; a limit makes allocation failure testable
    owned: [GpuEvent],      // events the pool holds references to, destroyed with it
}

fn newPool(graphics: Gfx) -> GpuPool {
    var emptyAllocations: [GpuAlloc] = []
    var emptyFree: [int] = []
    var emptyRetired: [int] = []
    var emptyOwned: [GpuEvent] = []
    return GpuPool{ g: graphics, allocations: emptyAllocations, free: emptyFree, retired: emptyRetired, liveBytes: 0, peakBytes: 0, totalAllocated: 0, reuses: 0, limitBytes: 0, owned: emptyOwned }
}

// Move every retired allocation whose last use has completed onto the free
// list. Non-blocking: an allocation still in flight simply stays retired.
fn poolCollect(pool: GpuPool) -> int {
    var still: [int] = []
    var moved = 0
    for i in 0..pool.retired.len() {
        let allocationIndex = pool.retired[i]
        if eventDone(pool.g, pool.allocations[allocationIndex].last) {
            pool.free.push(allocationIndex)
            moved = moved + 1
        } else {
            still.push(allocationIndex)
        }
    }
    pool.retired = still
    return moved
}

fn poolAcquire(pool: GpuPool, bytes: int) -> int {
    if bytes <= 0 { panic("poolAcquire: size must be positive, got {bytes}") }
    poolCollect(pool)
    // Exact-size reuse only. Size-class reuse would return a larger buffer and
    // then every kernel would need to know its logical length separately from
    // its allocated length; exact matching keeps that impossible to get wrong.
    // ponytail: exact-fit free list, add size classes if fragmentation shows up.
    for i in 0..pool.free.len() {
        let allocationIndex = pool.free[i]
        if pool.allocations[allocationIndex].buffer.size == bytes {
            var rest: [int] = []
            for j in 0..pool.free.len() {
                if j != i { rest.push(pool.free[j]) }
            }
            pool.free = rest
            pool.allocations[allocationIndex].live = true
            pool.allocations[allocationIndex].referenceCount = 1
            pool.liveBytes = pool.liveBytes + bytes
            if pool.liveBytes > pool.peakBytes { pool.peakBytes = pool.liveBytes }
            pool.reuses = pool.reuses + 1
            return allocationIndex
        }
    }
    if pool.limitBytes > 0 and pool.liveBytes + bytes > pool.limitBytes {
        // Before giving up, wait out everything in flight and collect again --
        // an allocation failure that could have been satisfied by finished
        // work is a bug in the allocator, not a real exhaustion.
        for i in 0..pool.retired.len() { eventWait(pool.g, pool.allocations[pool.retired[i]].last) }
        poolCollect(pool)
        for i in 0..pool.free.len() {
            let allocationIndex = pool.free[i]
            if pool.allocations[allocationIndex].buffer.size == bytes {
                var rest: [int] = []
                for j in 0..pool.free.len() {
                    if j != i { rest.push(pool.free[j]) }
                }
                pool.free = rest
                pool.allocations[allocationIndex].live = true
                pool.allocations[allocationIndex].referenceCount = 1
                pool.liveBytes = pool.liveBytes + bytes
                if pool.liveBytes > pool.peakBytes { pool.peakBytes = pool.liveBytes }
                pool.reuses = pool.reuses + 1
                return allocationIndex
            }
        }
        if pool.liveBytes + bytes > pool.limitBytes {
            panic("gpu allocation failed: requested {bytes} bytes with {pool.liveBytes} live against a limit of {pool.limitBytes}. Reduce batch size or model dimension, or raise the pool limit.")
        }
    }
    let buffer = pool.g.buffer(bytes, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT)
    // A fresh allocation has no outstanding use. The pool deliberately does
    // NOT create an event here: poolTouch will store one the caller owns,
    // and an event created here would be both leaked and double-destroyed.
    // Events belong to whoever submitted the work, never to the allocator.
    pool.allocations.push(GpuAlloc{ buffer: buffer, last: GpuEvent{ fence: 0, semaphore: 0, pending: false, commandBuffer: 0 }, live: true, referenceCount: 1 })
    pool.totalAllocated = pool.totalAllocated + 1
    pool.liveBytes = pool.liveBytes + bytes
    if pool.liveBytes > pool.peakBytes { pool.peakBytes = pool.liveBytes }
    return pool.allocations.len() - 1
}

// Record that a submission touched this allocation. Called for every buffer a
// dispatch reads or writes, before the submission goes in. Without this the
// allocator has no completion information to associate and recycling becomes
// a guess.
// The pool TAKES OWNERSHIP of the event. It must: the allocator goes on
// asking this fence whether the work finished, long after the caller has
// forgotten about the submission, and a caller that destroyed its own event
// would leave the allocator polling a freed handle. That is a host-side
// use-after-free, it crashes rather than misbehaves quietly, and it is
// exactly the early-release failure this criterion is about -- so callers
// must not call eventDestroy on anything they pass here.
//
// One submission touches several buffers in a row with the same event, so
// deduplication only has to look at the most recent entry.
fn poolTouch(pool: GpuPool, allocationIndex: int, event: GpuEvent) {
    pool.allocations[allocationIndex].last = event
    if event.pending {
        var fresh = true
        if pool.owned.len() > 0 {
            if pool.owned[pool.owned.len() - 1].fence == event.fence { fresh = false }
        }
        if fresh { pool.owned.push(event) }
    }
}

// A view shares storage with its owner. The order in which the two are
// released must not matter, which is what a count buys and a bool cannot.
fn poolRetain(pool: GpuPool, allocationIndex: int) {
    if pool.allocations[allocationIndex].referenceCount <= 0 { panic("poolRetain: allocation {allocationIndex} has no live reference to retain") }
    pool.allocations[allocationIndex].referenceCount = pool.allocations[allocationIndex].referenceCount + 1
}

// Drop one reference. Note what does NOT happen at the last one: the storage
// does not go on the free list, and nothing is destroyed. It goes to
// `retired` and waits there for its last use to complete.
fn poolRelease(pool: GpuPool, allocationIndex: int) {
    if pool.allocations[allocationIndex].referenceCount <= 0 { panic("poolRelease: allocation {allocationIndex} released more times than it was retained") }
    pool.allocations[allocationIndex].referenceCount = pool.allocations[allocationIndex].referenceCount - 1
    if pool.allocations[allocationIndex].referenceCount > 0 { return }
    pool.allocations[allocationIndex].live = false
    pool.liveBytes = pool.liveBytes - pool.allocations[allocationIndex].buffer.size
    pool.retired.push(allocationIndex)
}

fn poolBuffer(pool: GpuPool, allocationIndex: int) -> GpuBuffer { return pool.allocations[allocationIndex].buffer }

// Tear the pool down. Waits for every outstanding use before destroying
// anything: freeing memory the device is still reading is exactly the
// host-owner early release this is meant to make impossible.
fn poolDestroy(pool: GpuPool) {
    // Order matters and getting it wrong is the same use-after-free in a
    // different costume. Wait for everything first, then release the buffers,
    // and only destroy the events last -- an allocation's `last` points at an
    // event in `owned`, so destroying events up front leaves every following
    // wait reading a freed fence.
    for i in 0..pool.allocations.len() { eventWait(pool.g, pool.allocations[i].last) }
    for i in 0..pool.allocations.len() { pool.g.destroyBuffer(pool.allocations[i].buffer) }
    for i in 0..pool.owned.len() { eventDestroy(pool.g, pool.owned[i]) }
    var emptyEvents: [GpuEvent] = []
    pool.owned = emptyEvents
    var emptyAllocations: [GpuAlloc] = []
    var emptyFree: [int] = []
    var emptyRetired: [int] = []
    pool.allocations = emptyAllocations
    pool.free = emptyFree
    pool.retired = emptyRetired
    pool.liveBytes = 0
}
