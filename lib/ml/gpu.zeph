// Vulkan compute backend for the one operation that dominates the phase
// model's cost: matmul, real float64 and complex float64.
//
// Scope is deliberately one operation. The backward pass of a matmul is two
// more matmuls against conjugate-transposed operands (see operationMatmul in
// autograd.zeph), and the transposes are O(n^2) against the matmul's O(n^3),
// so covering matmul alone puts both the forward and the backward of the
// expensive part on the device. Everything else stays on the CPU, where it is
// already verified against numpy and PyTorch.
//
// Precision is float64 only. float32 is measurably faster -- see the table in
// .agent/env-ledger.md -- but every cross-check harness in this repository
// compares bit-identical float64 fixtures, and an fp32 path would cost that
// evidence to buy a speedup on a kernel that is bandwidth-bound anyway.
//
// Pipelines are built per call. Measured cold build is 0.2-0.3 ms against a
// 49 ms host upload at n=1024, so caching them would optimise the wrong end.
// ponytail: rebuild per call; cache pipelines if upload ever gets a bulk path.
import "vk/gfx.zeph"
import "ml/ops.zeph"

let gpuMatmulShaderFloat64 = "examples/shaders/matmul_f64.comp.spv"
let gpuMatmulShaderComplex64 = "examples/shaders/matmul_c64.comp.spv"

// Returns "" when the backend can run, and otherwise a message that says what
// is missing and what to do about it. Callers should print it verbatim: a
// backend that is unavailable for a fixable reason should not look like a bug.
// readFile dies on a missing path rather than returning empty, so existence
// has to be asked before the read -- the whole point here is to report the
// absence with a fix, not to abort on it.
fn gpuFileExists(path: str) -> bool {
    var pathBytes = cString(path)
    let attributes = win("GetFileAttributesA", pathBytes.addr())
    return attributes != 4294967295 and attributes != 0 - 1
}

fn gpuKernelMissing(path: str) -> str {
    if not gpuFileExists(path) {
        return "gpu backend unavailable: compiled kernel {path} is missing. Run scripts\\build-compute-shaders.ps1 to build it (needs glslc from the Vulkan SDK on PATH)."
    }
    return ""
}

fn gpuUnavailable() -> str {
    let message = gpuKernelMissing(gpuMatmulShaderFloat64)
    if message != "" { return message }
    return gpuKernelMissing(gpuMatmulShaderComplex64)
}

struct GpuMM { g: Gfx }

// Bring the device up. Panics with the actionable text from gpuUnavailable()
// rather than letting the failure surface as a Vulkan error code.
fn gpuInitialize() -> GpuMM {
    let reason = gpuUnavailable()
    if reason != "" { panic(reason) }
    let graphics = Gfx.init("zephyr-ml", [])
    return GpuMM{ g: graphics }
}

fn gpuShutdown(backend: GpuMM) { backend.g.shutdown() }

fn gpuDeviceName(backend: GpuMM) -> str { return backend.g.gpuName() }

// Number of float64 lanes per element: 1 real, 2 complex.
fn gpuLanesPerElement(dtype: DType) -> int {
    if dtypeIsComplex(dtype) { return 2 }
    return 1
}

// Host-visible upload of a 2-D tensor, element by element through tensorGet, so
// non-contiguous views (transposes, slices) upload correctly without a repack.
fn gpuUpload(backend: GpuMM, tensor: Tensor, rows: int, cols: int, lanes: int) -> GpuBuffer {
    let buffer = gpuAllocateBuffer(backend, rows * cols * lanes * 8)
    var mappedPointer = Bytes.new(8)
    var cell = Bytes.new(8)
    checkVulkanResult(vkMapMemory(backend.g.device, buffer.memory, 0, buffer.size, 0, mappedPointer.addr()), "gpuUpload: vkMapMemory")
    let base = mappedPointer.get64(0)
    for i in 0..rows {
        for j in 0..cols {
            let laneIndex = (i * cols + j) * lanes
            if lanes == 2 {
                cell.putFloat64(0, tensorGetReal(tensor, [i, j]))
                for byteIndex in 0..8 { store8(base + (laneIndex + 0) * 8 + byteIndex, cell.get8(byteIndex)) }
                cell.putFloat64(0, tensorGetImaginary(tensor, [i, j]))
                for byteIndex in 0..8 { store8(base + (laneIndex + 1) * 8 + byteIndex, cell.get8(byteIndex)) }
            } else {
                cell.putFloat64(0, tensorGet(tensor, [i, j]))
                for byteIndex in 0..8 { store8(base + laneIndex * 8 + byteIndex, cell.get8(byteIndex)) }
            }
        }
    }
    vkUnmapMemory(backend.g.device, buffer.memory)
    return buffer
}

// C = A @ B on the device. Shapes and dtypes are checked here rather than in
// the shader, which has no way to report a mismatch -- it would just read
// garbage inside its bounds and return a plausible wrong answer.
fn gpuMatmul(backend: GpuMM, a: Tensor, b: Tensor) -> Tensor {
    if tensorRank(a) != 2 or tensorRank(b) != 2 { panic("gpuMatmul: both operands must be rank 2") }
    if a.dtype != b.dtype { panic("gpuMatmul: dtype mismatch") }
    if a.dtype != DType.F64 and a.dtype != DType.C64 {
        panic("gpuMatmul: only F64 and C64 are supported on the device; got {a.dtype}. Use tensorMatmul on the CPU for other dtypes.")
    }
    let rowCount = a.shape[0]
    let innerCount = a.shape[1]
    if b.shape[0] != innerCount { panic("gpuMatmul: inner dimensions disagree, {innerCount} against {b.shape[0]}") }
    let columnCount = b.shape[1]
    let lanes = gpuLanesPerElement(a.dtype)

    let leftBuffer = gpuUpload(backend, a, rowCount, innerCount, lanes)
    let rightBuffer = gpuUpload(backend, b, innerCount, columnCount, lanes)
    let outputBuffer = gpuAllocateBuffer(backend, rowCount * columnCount * lanes * 8)

    var buffers: [GpuBuffer] = []
    buffers.push(leftBuffer)
    buffers.push(rightBuffer)
    buffers.push(outputBuffer)
    let descriptorSet = backend.g.storageBufferSet(buffers, VK_SHADER_STAGE_COMPUTE_BIT)
    var path = gpuMatmulShaderFloat64
    if lanes == 2 { path = gpuMatmulShaderComplex64 }
    let shaderModule = backend.g.shader(path)
    var setLayouts: [int] = []
    setLayouts.push(descriptorSet.layout)
    let pipelineLayout = backend.g.pipelineLayout(setLayouts, 12, VK_SHADER_STAGE_COMPUTE_BIT)
    let pipeline = backend.g.computePipeline(shaderModule, pipelineLayout, cString("main"))

    var pushConstants = Bytes.new(12)
    pushConstants.put32(0, rowCount)
    pushConstants.put32(4, innerCount)
    pushConstants.put32(8, columnCount)
    var sets = uint64Array([descriptorSet.set])
    let groupCountX = (columnCount + 15) / 16
    let groupCountY = (rowCount + 15) / 16
    let capturedLayout = pipelineLayout
    let capturedPipeline = pipeline
    let setsAddress = sets.addr()
    let pushConstantsAddress = pushConstants.addr()
    backend.g.immediate(fn(commandBuffer: int) {
        vkCmdBindPipeline(commandBuffer, VK_PIPELINE_BIND_POINT_COMPUTE, capturedPipeline)
        vkCmdBindDescriptorSets(commandBuffer, VK_PIPELINE_BIND_POINT_COMPUTE, capturedLayout, 0, 1, setsAddress, 0, 0)
        vkCmdPushConstants(commandBuffer, capturedLayout, VK_SHADER_STAGE_COMPUTE_BIT, 0, 12, pushConstantsAddress)
        vkCmdDispatch(commandBuffer, groupCountX, groupCountY, 1)
    })

    let output = tensorZeros(a.dtype, [rowCount, columnCount])
    var mappedPointer = Bytes.new(8)
    var readCell = Bytes.new(8)
    checkVulkanResult(vkMapMemory(backend.g.device, outputBuffer.memory, 0, outputBuffer.size, 0, mappedPointer.addr()), "gpuMatmul: vkMapMemory readback")
    let readbackBase = mappedPointer.get64(0)
    for i in 0..rowCount {
        for j in 0..columnCount {
            let laneIndex = (i * columnCount + j) * lanes
            if lanes == 2 {
                for b in 0..8 { readCell.put8(b, load8(readbackBase + (laneIndex + 0) * 8 + b)) }
                let realPart = readCell.getFloat64(0)
                for b in 0..8 { readCell.put8(b, load8(readbackBase + (laneIndex + 1) * 8 + b)) }
                tensorSetComplex(output, [i, j], realPart, readCell.getFloat64(0))
            } else {
                for b in 0..8 { readCell.put8(b, load8(readbackBase + laneIndex * 8 + b)) }
                tensorSet(output, [i, j], readCell.getFloat64(0))
            }
        }
    }
    vkUnmapMemory(backend.g.device, outputBuffer.memory)

    vkDestroyPipeline(backend.g.device, pipeline, 0)
    vkDestroyPipelineLayout(backend.g.device, pipelineLayout, 0)
    vkDestroyShaderModule(backend.g.device, shaderModule, 0)
    backend.g.destroyDescriptorSet(descriptorSet)
    gpuFreeBuffer(backend, leftBuffer)
    gpuFreeBuffer(backend, rightBuffer)
    gpuFreeBuffer(backend, outputBuffer)
    return output
}

// The backward of C = A @ B, on the device: dA = dC @ B^H, dB = A^H @ dC.
// This mirrors the operationMatmul case in autograd.zeph exactly -- plain transpose
// for real operands, conjugate transpose for complex -- so the two can be
// compared directly. The transposes are O(n^2) and stay on the host.
fn gpuMatmulBackward(backend: GpuMM, left: Tensor, right: Tensor, outputGradient: Tensor) -> [Tensor] {
    var rightTransposed = tensorCopy(tensorTranspose(right, 0, 1))
    var leftTransposed = tensorCopy(tensorTranspose(left, 0, 1))
    if dtypeIsComplex(right.dtype) { rightTransposed = tensorConjugateTranspose(right) }
    if dtypeIsComplex(left.dtype) { leftTransposed = tensorConjugateTranspose(left) }
    var gradients: [Tensor] = []
    gradients.push(gpuMatmul(backend, outputGradient, rightTransposed))
    gradients.push(gpuMatmul(backend, leftTransposed, outputGradient))
    return gradients
}

// ---------------------------------------------------------------------------
// Device memory accounting and the matmul hook.
//
// Peak device memory is tracked here rather than asked of the driver: every
// allocation in this backend goes through gpuAllocateBuffer, so the number is exact and
// does not depend on a driver query that may or may not exist.
var gpuLiveBytes = 0
var gpuPeakBytes = 0

fn gpuResetMemory() {
    gpuLiveBytes = 0
    gpuPeakBytes = 0
}

fn gpuAllocateBuffer(backend: GpuMM, bytes: int) -> GpuBuffer {
    let buffer = backend.g.buffer(bytes, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT)
    gpuLiveBytes = gpuLiveBytes + bytes
    if gpuLiveBytes > gpuPeakBytes { gpuPeakBytes = gpuLiveBytes }
    return buffer
}

fn gpuFreeBuffer(backend: GpuMM, buffer: GpuBuffer) {
    gpuLiveBytes = gpuLiveBytes - buffer.size
    backend.g.destroyBuffer(buffer)
}

// Route tensorMatmul through the device. Anything the kernels do not cover falls
// back to tensorMatmulCpu rather than failing, so enabling the backend can change
// speed but never coverage.
fn gpuEnable(backend: GpuMM) {
    var hooks: [fn(Tensor, Tensor) -> Tensor] = []
    hooks.push(fn(left: Tensor, right: Tensor) -> Tensor {
        if left.shape.len() != 2 or right.shape.len() != 2 { return tensorMatmulCpu(left, right) }
        if left.dtype != right.dtype { return tensorMatmulCpu(left, right) }
        if left.dtype != DType.F64 and left.dtype != DType.C64 { return tensorMatmulCpu(left, right) }
        return gpuMatmul(backend, left, right)
    })
    matmulHook = hooks
}

fn gpuDisable() {
    let empty: [fn(Tensor, Tensor) -> Tensor] = []
    matmulHook = empty
}
