// A typed SSA operation graph captured from the autograd tape -- milestone
// M6a, acceptance A24.
//
// The specification is explicit that this comes last: "Introduce a compact
// typed SSA operation graph only after eager operators are stable." They are,
// and the tape in autograd.zeph is already an operation graph recorded
// eagerly -- opcode, operands, attributes, one value per node, allocated in
// forward order. So capture is a translation, not a second tracer, and the
// eager path stays the oracle rather than becoming a thing the IR replaces.
//
// What capture adds over the tape is the part a tape does not need and a
// compiler does: every value carries dtype, shape, layout facts and device;
// every node carries its effects; and the whole thing can be verified,
// hashed, printed deterministically and cached. Those are what A24 gates.
//
// Effects follow the specification's list -- RNG, host I/O, parameter
// mutation, device transfers -- modelled as ordering tokens so that pure
// arithmetic may be reordered and effectful nodes may not.
import "ml/autograd.zeph"

let effectNone = 0
let effectParameter = 1      // reads a mutable parameter, so ordering against a
                       // parameter update matters
let effectRng = 2
let effectInputOutput = 4
let effectTransfer = 8

let deviceCpu = 0
let deviceGpu = 1

struct IrValue {
    id: int,
    dtype: DType,
    shape: [int],
    stride: [int],
    offset: int,
    device: int,
    contiguous: bool,
}

struct IrNode {
    op: int,
    out: int,          // index into values
    a: int,            // operand value index, or -1
    b: int,
    integerAttributes: [int],         // integer attributes, as recorded on the tape
    floatAttributes: [float],       // float attributes
    effects: int,
    span: int,         // the tape node this came from, so a diagnostic can
                       // point back at something real
}

struct IrGraph {
    values: [IrValue],
    nodes: [IrNode],
    inputs: [int],     // value indices with no defining node
    result: int,
    tapeVariableOf: [int],     // value index -> tape variable, for replay
}

fn irOperationName(opcode: int) -> str {
    let names = ["leaf", "add", "sub", "mul", "div", "neg", "matmul", "tanh",
                 "sum_dim", "sum_all", "mean_all", "abs2", "conj", "real",
                 "imag", "expi", "complex", "concat", "index_select", "roll",
                 "transpose", "reshape", "slice", "cast", "expand", "cos",
                 "sin", "ln", "exp", "givens", "bias_tanh"]
    if opcode < 0 or opcode >= names.len() { return "op{opcode}" }
    return names[opcode]
}

fn irDtypeName(dtype: DType) -> str {
    if dtype == DType.F64 { return "f64" }
    if dtype == DType.F32 { return "f32" }
    if dtype == DType.C64 { return "c64" }
    if dtype == DType.C32 { return "c32" }
    if dtype == DType.I64 { return "i64" }
    return "?"
}

fn irShapeString(shape: [int]) -> str {
    var text = "["
    for i in 0..shape.len() {
        if i > 0 { text = text + "," }
        text = text + "{shape[i]}"
    }
    return text + "]"
}

fn irIsContiguous(tensor: Tensor) -> bool { return tensorIsContiguous(tensor) }

// ---------------------------------------------------------------------------
// Capture
//
// One IR value per tape variable, one IR node per tape node. The tape
// allocates handles in forward order, so operands always have lower indices
// than their consumer and dominance holds by construction -- which the
// verifier then checks rather than assumes, because "by construction" is a
// claim about code that can change.
fn irCapture(result: int) -> IrGraph {
    var values: [IrValue] = []
    var nodes: [IrNode] = []
    var inputs: [int] = []
    var tapeVariableOf: [int] = []

    for variableIndex in 0..tapeVariables.len() {
        let tensor = tapeVariables[variableIndex].v
        values.push(IrValue{ id: variableIndex, dtype: tensor.dtype, shape: tensor.shape, stride: tensor.stride,
                             offset: tensor.offset, device: deviceCpu, contiguous: irIsContiguous(tensor) })
        tapeVariableOf.push(variableIndex)
        if tapeVariables[variableIndex].node < 0 { inputs.push(variableIndex) }
    }

    // tape node index -> the variable it defines
    var nodeOutput: [int] = []
    for i in 0..tapeNodes.len() { nodeOutput.push(0 - 1) }
    for variableIndex in 0..tapeVariables.len() {
        let tapeNodeIndex = tapeVariables[variableIndex].node
        if tapeNodeIndex >= 0 { nodeOutput[tapeNodeIndex] = variableIndex }
    }

    for i in 0..tapeNodes.len() {
        let tapeNode = tapeNodes[i]
        // A parameter read is the only effect the tape can carry today: there
        // is no RNG op, no host I/O op and no explicit transfer op in the
        // recorded set. Marking them here rather than pretending they cannot
        // exist keeps the ordering rules meaningful when they do.
        var effects = effectNone
        if tapeNode.a >= 0 {
            if tapeVariables[tapeNode.a].node < 0 and tapeVariables[tapeNode.a].requiresGradient { effects = effects + effectParameter }
        }
        nodes.push(IrNode{ op: tapeNode.op, out: nodeOutput[i], a: tapeNode.a, b: tapeNode.b,
                           integerAttributes: tapeNode.integerAttributes, floatAttributes: tapeNode.floatAttributes, effects: effects, span: i })
    }
    return IrGraph{ values: values, nodes: nodes, inputs: inputs, result: result, tapeVariableOf: tapeVariableOf }
}

// ---------------------------------------------------------------------------
// Verification
//
// Returns a list of diagnostics; empty means the graph is well formed. A
// verifier that panicked on the first problem would be useless for the thing
// it is for, which is reporting what is wrong with a graph.
//
// Every diagnostic carries the tape node it came from, because the
// specification asks for source-located errors and a message that only says
// "shape mismatch" cannot be acted on.

fn irBroadcastCompatible(firstShape: [int], secondShape: [int]) -> bool {
    let firstRank = firstShape.len()
    var sharedRank = secondShape.len()
    if sharedRank > firstRank { sharedRank = firstRank }
    for k in 0..sharedRank {
        let firstExtent = firstShape[firstShape.len() - 1 - k]
        let secondExtent = secondShape[secondShape.len() - 1 - k]
        if firstExtent != secondExtent and firstExtent != 1 and secondExtent != 1 { return false }
    }
    return true
}

fn irSameShape(firstShape: [int], secondShape: [int]) -> bool {
    if firstShape.len() != secondShape.len() { return false }
    for i in 0..firstShape.len() {
        if firstShape[i] != secondShape[i] { return false }
    }
    return true
}

fn irElementCount(shape: [int]) -> int {
    var elementCount = 1
    for i in 0..shape.len() { elementCount = elementCount * shape[i] }
    return elementCount
}

fn irVerify(graph: IrGraph) -> [str] {
    var errors: [str] = []

    if graph.result < 0 or graph.result >= graph.values.len() {
        errors.push("graph result {graph.result} is not a value in this graph")
        return errors
    }

    var defined: [bool] = []
    for i in 0..graph.values.len() { defined.push(false) }
    for i in 0..graph.inputs.len() { defined[graph.inputs[i]] = true }

    for i in 0..graph.nodes.len() {
        let node = graph.nodes[i]
        let where = "node {i} ({irOperationName(node.op)}, tape node {node.span})"

        if node.out < 0 or node.out >= graph.values.len() {
            errors.push("{where}: defines value {node.out}, which is out of range")
            continue
        }

        // ---- dominance: operands must be defined before use ----
        var badOperand = false
        if node.a >= 0 {
            if node.a >= graph.values.len() {
                errors.push("{where}: operand a = {node.a} is out of range")
                badOperand = true
            } else {
                if not defined[node.a] {
                    errors.push("{where}: operand a = %{node.a} is used before it is defined")
                    badOperand = true
                }
                if node.a >= node.out {
                    errors.push("{where}: operand a = %{node.a} does not dominate its use in %{node.out}")
                    badOperand = true
                }
            }
        }
        if node.b >= 0 {
            if node.b >= graph.values.len() {
                errors.push("{where}: operand b = {node.b} is out of range")
                badOperand = true
            } else {
                if not defined[node.b] {
                    errors.push("{where}: operand b = %{node.b} is used before it is defined")
                    badOperand = true
                }
                if node.b >= node.out {
                    errors.push("{where}: operand b = %{node.b} does not dominate its use in %{node.out}")
                    badOperand = true
                }
            }
        }
        if defined[node.out] {
            errors.push("{where}: value %{node.out} is assigned more than once, which is not SSA")
        }
        defined[node.out] = true
        if badOperand { continue }

        let outputValue = graph.values[node.out]

        // ---- dtype and shape inference ----
        if node.a >= 0 {
            let firstOperand = graph.values[node.a]

            // elementwise binary: broadcast-compatible, same dtype
            if node.op == operationAdd or node.op == operationSubtract or node.op == operationMultiply or node.op == operationDivide {
                if node.b < 0 {
                    errors.push("{where}: a binary op has no second operand")
                } else {
                    let secondOperand = graph.values[node.b]
                    if firstOperand.dtype != secondOperand.dtype {
                        errors.push("{where}: operands differ in dtype, {irDtypeName(firstOperand.dtype)} against {irDtypeName(secondOperand.dtype)}; the library requires an explicit cast")
                    }
                    if not irBroadcastCompatible(firstOperand.shape, secondOperand.shape) {
                        errors.push("{where}: operand shapes {irShapeString(firstOperand.shape)} and {irShapeString(secondOperand.shape)} do not broadcast")
                    }
                    if outputValue.dtype != firstOperand.dtype {
                        errors.push("{where}: result dtype {irDtypeName(outputValue.dtype)} should be {irDtypeName(firstOperand.dtype)}")
                    }
                }
            }

            // dtype-changing unary ops, which are where a wrong rule is
            // easiest to write and hardest to notice
            if node.op == operationAbs2 or node.op == operationReal or node.op == operationImaginary {
                if not dtypeIsComplex(firstOperand.dtype) {
                    errors.push("{where}: takes a complex operand, got {irDtypeName(firstOperand.dtype)}")
                }
                if dtypeIsComplex(outputValue.dtype) {
                    errors.push("{where}: produces a real tensor, but the result is {irDtypeName(outputValue.dtype)}")
                }
                if not irSameShape(outputValue.shape, firstOperand.shape) {
                    errors.push("{where}: result shape {irShapeString(outputValue.shape)} should equal the operand's {irShapeString(firstOperand.shape)}")
                }
            }
            if node.op == operationExpImaginary {
                if dtypeIsComplex(firstOperand.dtype) {
                    errors.push("{where}: takes a real angle, got {irDtypeName(firstOperand.dtype)}")
                }
                if not dtypeIsComplex(outputValue.dtype) {
                    errors.push("{where}: produces a complex tensor, but the result is {irDtypeName(outputValue.dtype)}")
                }
            }
            if node.op == operationConjugate {
                if not dtypeIsComplex(firstOperand.dtype) {
                    errors.push("{where}: takes a complex operand, got {irDtypeName(firstOperand.dtype)}")
                }
                if outputValue.dtype != firstOperand.dtype {
                    errors.push("{where}: conj preserves dtype, {irDtypeName(outputValue.dtype)} against {irDtypeName(firstOperand.dtype)}")
                }
            }

            // shape-preserving unary
            if node.op == operationTanh or node.op == operationCos or node.op == operationSin or node.op == operationLn or node.op == operationExp or node.op == operationNegate {
                if not irSameShape(outputValue.shape, firstOperand.shape) {
                    errors.push("{where}: result shape {irShapeString(outputValue.shape)} should equal the operand's {irShapeString(firstOperand.shape)}")
                }
                if outputValue.dtype != firstOperand.dtype {
                    errors.push("{where}: result dtype {irDtypeName(outputValue.dtype)} should be {irDtypeName(firstOperand.dtype)}")
                }
            }

            if node.op == operationGivens {
                if node.b < 0 {
                    errors.push("{where}: the fused Givens stage has no angle operand")
                } else {
                    let angle = graph.values[node.b]
                    if not dtypeIsComplex(firstOperand.dtype) {
                        errors.push("{where}: state operand is {irDtypeName(firstOperand.dtype)}, must be complex")
                    }
                    if dtypeIsComplex(angle.dtype) {
                        errors.push("{where}: angle operand is {irDtypeName(angle.dtype)}, must be real")
                    }
                    if not irSameShape(outputValue.shape, firstOperand.shape) {
                        errors.push("{where}: result shape {irShapeString(outputValue.shape)} should equal the state's {irShapeString(firstOperand.shape)}")
                    }
                    if not irSameShape(angle.shape, firstOperand.shape) {
                        errors.push("{where}: angle shape {irShapeString(angle.shape)} should equal the state's {irShapeString(firstOperand.shape)}, theta then phi")
                    }
                    if node.integerAttributes.len() < 1 or node.integerAttributes[0] < 0 or node.integerAttributes[0] > 1 {
                        errors.push("{where}: stage must be 0 or 1")
                    }
                }
            }

            if node.op == operationMatmul {
                if node.b < 0 {
                    errors.push("{where}: matmul has no second operand")
                } else {
                    let secondOperand = graph.values[node.b]
                    if firstOperand.shape.len() != 2 or secondOperand.shape.len() != 2 {
                        errors.push("{where}: matmul needs rank-2 operands, got {irShapeString(firstOperand.shape)} and {irShapeString(secondOperand.shape)}")
                    } else {
                        if firstOperand.shape[1] != secondOperand.shape[0] {
                            errors.push("{where}: inner dimensions disagree, {firstOperand.shape[1]} against {secondOperand.shape[0]}")
                        }
                        if outputValue.shape.len() != 2 or outputValue.shape[0] != firstOperand.shape[0] or outputValue.shape[1] != secondOperand.shape[1] {
                            errors.push("{where}: result shape {irShapeString(outputValue.shape)} should be [{firstOperand.shape[0]},{secondOperand.shape[1]}]")
                        }
                    }
                    if firstOperand.dtype != secondOperand.dtype {
                        errors.push("{where}: matmul operands differ in dtype")
                    }
                }
            }

            if node.op == operationSumDimension {
                if node.integerAttributes.len() < 1 {
                    errors.push("{where}: sum_dim has no axis attribute")
                } else {
                    let axis = node.integerAttributes[0]
                    if axis < 0 or axis >= firstOperand.shape.len() {
                        errors.push("{where}: axis {axis} is out of range for {irShapeString(firstOperand.shape)}")
                    } else {
                        if outputValue.shape.len() != firstOperand.shape.len() or outputValue.shape[axis] != 1 {
                            errors.push("{where}: sum_dim keeps the reduced axis at extent 1; result is {irShapeString(outputValue.shape)}")
                        }
                    }
                }
            }

            // Index lists must be in bounds. This is the general form of the
            // specification's "valid pairings": a gate pairing is an index
            // list, and an out-of-range entry is the failure it is guarding
            // against.
            if node.op == operationIndexSelect {
                if node.integerAttributes.len() < 1 {
                    errors.push("{where}: index_select has no axis attribute")
                } else {
                    let axis = node.integerAttributes[0]
                    if axis < 0 or axis >= firstOperand.shape.len() {
                        errors.push("{where}: axis {axis} is out of range for {irShapeString(firstOperand.shape)}")
                    } else {
                        // ia is [dim, source extent, then the selection],
                        // so the indices start at 2. Starting at 1 would read
                        // the recorded extent as though it were a selection.
                        var outOfBoundsCount = 0
                        for k in 2..node.integerAttributes.len() {
                            if node.integerAttributes[k] < 0 or node.integerAttributes[k] >= firstOperand.shape[axis] { outOfBoundsCount = outOfBoundsCount + 1 }
                        }
                        if node.integerAttributes.len() >= 2 {
                            if node.integerAttributes[1] != firstOperand.shape[axis] {
                                errors.push("{where}: recorded source extent {node.integerAttributes[1]} disagrees with the operand's {firstOperand.shape[axis]} on axis {axis}")
                            }
                        }
                        if outOfBoundsCount > 0 {
                            errors.push("{where}: {outOfBoundsCount} selected indices are outside 0..{firstOperand.shape[axis]} on axis {axis}")
                        }
                    }
                }
            }

            if node.op == operationReshape {
                if irElementCount(outputValue.shape) != irElementCount(firstOperand.shape) {
                    errors.push("{where}: reshape changes the element count, {irElementCount(firstOperand.shape)} to {irElementCount(outputValue.shape)}")
                }
            }

            if node.op == operationExpand {
                if not irBroadcastCompatible(outputValue.shape, firstOperand.shape) {
                    errors.push("{where}: cannot expand {irShapeString(firstOperand.shape)} to {irShapeString(outputValue.shape)}")
                }
            }

            if node.op == operationConcat {
                if node.b < 0 {
                    errors.push("{where}: concat has no second operand")
                } else {
                    let secondOperand = graph.values[node.b]
                    if firstOperand.dtype != secondOperand.dtype { errors.push("{where}: concat operands differ in dtype") }
                    if firstOperand.shape.len() != secondOperand.shape.len() {
                        errors.push("{where}: concat operands differ in rank")
                    }
                }
            }
        }

        // ---- kernel launch bounds ----
        // The device kernels take rank up to 4 and index through 32-bit
        // element counts. A graph that violates either can still run eagerly,
        // so this is a diagnostic about where it may run, not an error about
        // whether it is valid -- but it has to be visible before a backend
        // silently truncates something.
        if outputValue.shape.len() > 4 and node.op != operationLeaf {
            errors.push("{where}: rank {outputValue.shape.len()} exceeds the device kernels' limit of 4; this region must stay eager")
        }
        if irElementCount(outputValue.shape) > 2147483647 {
            errors.push("{where}: {irElementCount(outputValue.shape)} elements exceeds the 32-bit launch bound")
        }

        // ---- transfer boundaries ----
        if node.a >= 0 {
            if graph.values[node.a].device != outputValue.device {
                errors.push("{where}: operand a is on device {graph.values[node.a].device} but the result is on {outputValue.device}, with no transfer between them")
            }
        }
        if node.b >= 0 {
            if graph.values[node.b].device != outputValue.device {
                errors.push("{where}: operand b is on device {graph.values[node.b].device} but the result is on {outputValue.device}, with no transfer between them")
            }
        }
    }
    return errors
}

// ---------------------------------------------------------------------------
// Deterministic text dump, for golden tests.
//
// Deterministic means: no addresses, no iteration over anything unordered, no
// timings. Two captures of the same model must produce byte-identical text or
// the golden test is worthless and the graph hash below is meaningless.
fn irDump(graph: IrGraph) -> str {
    var text = "graph \{\n"
    for i in 0..graph.inputs.len() {
        let value = graph.values[graph.inputs[i]]
        text = text + "  %{value.id} = input : {irDtypeName(value.dtype)}{irShapeString(value.shape)}\n"
    }
    for i in 0..graph.nodes.len() {
        let node = graph.nodes[i]
        let value = graph.values[node.out]
        var line = "  %{node.out} = {irOperationName(node.op)}"
        if node.a >= 0 { line = line + " %{node.a}" }
        if node.b >= 0 { line = line + ", %{node.b}" }
        if node.integerAttributes.len() > 0 {
            line = line + " \{"
            for k in 0..node.integerAttributes.len() {
                if k > 0 { line = line + "," }
                line = line + "{node.integerAttributes[k]}"
            }
            line = line + "\}"
        }
        line = line + " : {irDtypeName(value.dtype)}{irShapeString(value.shape)}"
        if not value.contiguous { line = line + " strided" }
        if node.effects != effectNone { line = line + " effects={node.effects}" }
        text = text + line + "\n"
    }
    text = text + "  return %{graph.result}\n\}\n"
    return text
}

// A stable hash of the structure, dtypes and shapes -- deliberately NOT of
// the data, because two steps of the same model differ in values and must hit
// the same cache entry.
fn irHash(graph: IrGraph) -> int {
    var hash = 1469598103
    for i in 0..graph.nodes.len() {
        let node = graph.nodes[i]
        let value = graph.values[node.out]
        hash = (hash * 31 + node.op) % 2147483647
        hash = (hash * 31 + node.a + 2) % 2147483647
        hash = (hash * 31 + node.b + 2) % 2147483647
        hash = (hash * 31 + node.effects) % 2147483647
        hash = (hash * 31 + (value.dtype as int)) % 2147483647
        for k in 0..value.shape.len() { hash = (hash * 31 + value.shape[k]) % 2147483647 }
        for k in 0..node.integerAttributes.len() { hash = (hash * 31 + node.integerAttributes[k]) % 2147483647 }
    }
    hash = (hash * 31 + graph.result) % 2147483647
    return hash
}

// ---------------------------------------------------------------------------
// Replay
//
// Executing the captured graph from its inputs, using the same eager
// operators. This is what "captured execution" means until there is codegen:
// the point is not that it is faster, it is that the IR carried enough to
// reproduce the computation. If capture dropped an attribute, replay diverges
// and the parity test says so.
//
// Unknown opcodes panic rather than falling through to a copy. A replay that
// silently skipped an op would agree with eager on every graph that did not
// use that op -- which is precisely the set of graphs where the skip does not
// matter, so the test would pass exactly when it was useless.
fn irReplay(graph: IrGraph, inputs: [Tensor]) -> Tensor {
    if inputs.len() != graph.inputs.len() {
        panic("irReplay: graph takes {graph.inputs.len()} inputs, got {inputs.len()}")
    }
    var values: [Tensor] = []
    let placeholder = tensorZeros(DType.F64, [1])
    for i in 0..graph.values.len() { values.push(placeholder) }
    for i in 0..graph.inputs.len() { values[graph.inputs[i]] = inputs[i] }

    for i in 0..graph.nodes.len() {
        let node = graph.nodes[i]
        let outputValue = graph.values[node.out]
        var x = placeholder
        var y = placeholder
        if node.a >= 0 { x = values[node.a] }
        if node.b >= 0 { y = values[node.b] }
        var result = placeholder
        var done = true

        if node.op == operationAdd { result = tensorAdd(x, y) }
        if node.op == operationSubtract { result = tensorSubtract(x, y) }
        if node.op == operationMultiply { result = tensorMultiply(x, y) }
        if node.op == operationDivide { result = tensorDivide(x, y) }
        if node.op == operationNegate { result = tensorNegate(x) }
        if node.op == operationMatmul { result = tensorMatmul(x, y) }
        if node.op == operationTanh { result = tensorTanh(x) }
        if node.op == operationCos { result = tensorCos(x) }
        if node.op == operationSin { result = tensorSin(x) }
        if node.op == operationLn { result = tensorLn(x) }
        if node.op == operationExp { result = tensorExp(x) }
        if node.op == operationAbs2 { result = tensorAbs2(x) }
        if node.op == operationConjugate { result = tensorConjugate(x) }
        if node.op == operationReal { result = tensorReal(x) }
        if node.op == operationImaginary { result = tensorImaginary(x) }
        if node.op == operationExpImaginary { result = tensorExpImaginary(x, outputValue.dtype) }
        if node.op == operationComplex { result = tensorComplex(x, y, outputValue.dtype) }
        if node.op == operationSumDimension { result = tensorSumDimension(x, node.integerAttributes[0]) }
        // sum_all and mean_all reduce to a one-element tensor rather than a
        // scalar, exactly as the tape does, so the graph stays all-tensor.
        if node.op == operationSumAll { result = tensorSumToOne(x) }
        if node.op == operationMeanAll { result = tensorDivide(tensorSumToOne(x), tensorFull(x.dtype, [1], tensorElementCount(x) as float)) }
        if node.op == operationConcat { result = tensorConcat(x, y, node.integerAttributes[0]) }
        if node.op == operationRoll { result = tensorRoll(x, node.integerAttributes[0], node.integerAttributes[1]) }
        if node.op == operationTranspose { result = tensorCopy(tensorTranspose(x, node.integerAttributes[0], node.integerAttributes[1])) }
        if node.op == operationReshape { result = tensorReshape(tensorCopy(x), outputValue.shape) }
        if node.op == operationExpand { result = tensorCopy(tensorExpand(x, outputValue.shape)) }
        if node.op == operationSlice { result = tensorCopy(tensorSlice(x, node.integerAttributes[0], node.integerAttributes[1], node.integerAttributes[2])) }
        if node.op == operationCast { result = tensorCast(x, outputValue.dtype) }
        if node.op == operationIndexSelect {
            var indices: [int] = []
            for k in 2..node.integerAttributes.len() { indices.push(node.integerAttributes[k]) }
            result = tensorIndexSelect(x, node.integerAttributes[0], indices)
        }
        if node.op == operationGivens { result = tensorGivens(x, y, node.integerAttributes[0]) }
        if node.op == operationBiasTanh { result = tensorBiasTanh(x, y) }
        if node.op == operationLeaf { done = false }
        if node.op > operationBiasTanh { done = false }
        if node.op < 0 { done = false }

        if not done {
            panic("irReplay: no rule for {irOperationName(node.op)} (opcode {node.op}) at tape node {node.span}. Add one rather than letting replay diverge silently.")
        }
        values[node.out] = result
    }
    return values[graph.result]
}

// ---------------------------------------------------------------------------
// Guards
//
// A compiled artifact is valid only for the dtypes and shapes it was
// specialised on. The specification is blunt about the consequence -- "never
// run a mismatched specialization" -- so a guard records what was assumed and
// a miss falls back to eager rather than to recompile-and-hope.
struct IrGuard {
    dtypes: [DType],
    shapes: [[int]],
}

fn irGuardMake(graph: IrGraph) -> IrGuard {
    var dtypes: [DType] = []
    var shapes: [[int]] = []
    for i in 0..graph.inputs.len() {
        let value = graph.values[graph.inputs[i]]
        dtypes.push(value.dtype)
        shapes.push(value.shape)
    }
    return IrGuard{ dtypes: dtypes, shapes: shapes }
}

// Returns "" on a hit, or the reason for the miss. A boolean would be cheaper
// and would make the diagnostic the specification asks for impossible.
fn irGuardCheck(guard: IrGuard, inputs: [Tensor]) -> str {
    if inputs.len() != guard.dtypes.len() {
        return "guard miss: specialised for {guard.dtypes.len()} inputs, called with {inputs.len()}"
    }
    for i in 0..inputs.len() {
        if inputs[i].dtype != guard.dtypes[i] {
            return "guard miss: input {i} has dtype {irDtypeName(inputs[i].dtype)}, specialised for {irDtypeName(guard.dtypes[i])}"
        }
        if not irSameShape(inputs[i].shape, guard.shapes[i]) {
            return "guard miss: input {i} has shape {irShapeString(inputs[i].shape)}, specialised for {irShapeString(guard.shapes[i])}"
        }
    }
    return ""
}

// ---------------------------------------------------------------------------
// The compiled-artifact cache.
//
// The key carries everything the specification lists: graph hash, ABI
// versions, dtype and shape guards, layout, device capability, driver and
// toolchain versions, numeric flags and backend. Cache invalidation is part
// of correctness, so the key is built from explicit named fields rather than
// from whatever happened to be in scope, and the test changes each in turn.
struct IrCacheKey {
    graphHash: int,
    guardHash: int,
    abi: str,
    backend: str,
    device: str,
    driver: str,
    numeric: str,
    layout: str,
}

fn irGuardHash(guard: IrGuard) -> int {
    var hash = 2166136261
    for i in 0..guard.dtypes.len() {
        hash = (hash * 31 + (guard.dtypes[i] as int)) % 2147483647
        for k in 0..guard.shapes[i].len() { hash = (hash * 31 + guard.shapes[i][k]) % 2147483647 }
        hash = (hash * 31 + 7) % 2147483647      // separator, so [2,3] and [2],[3] differ
    }
    return hash
}

fn irKeyString(key: IrCacheKey) -> str {
    return "g{key.graphHash}/u{key.guardHash}/abi={key.abi}/be={key.backend}/dev={key.device}/drv={key.driver}/num={key.numeric}/lay={key.layout}"
}

struct IrCache {
    keys: [str],
    graphs: [IrGraph],
    guards: [IrGuard],
    hits: int,
    misses: int,
    evictions: int,
}

fn newIrCache() -> IrCache {
    var emptyKeys: [str] = []
    var emptyGraphs: [IrGraph] = []
    var emptyGuards: [IrGuard] = []
    return IrCache{ keys: emptyKeys, graphs: emptyGraphs, guards: emptyGuards, hits: 0, misses: 0, evictions: 0 }
}

fn irCacheFind(cache: IrCache, key: IrCacheKey) -> int {
    let keyText = irKeyString(key)
    for i in 0..cache.keys.len() {
        if cache.keys[i] == keyText { return i }
    }
    return 0 - 1
}

fn irCacheGet(cache: IrCache, key: IrCacheKey) -> int {
    let entryIndex = irCacheFind(cache, key)
    if entryIndex >= 0 { cache.hits = cache.hits + 1 } else { cache.misses = cache.misses + 1 }
    return entryIndex
}

fn irCachePut(cache: IrCache, key: IrCacheKey, graph: IrGraph, guard: IrGuard) {
    let entryIndex = irCacheFind(cache, key)
    if entryIndex >= 0 {
        cache.graphs[entryIndex] = graph
        cache.guards[entryIndex] = guard
        return
    }
    cache.keys.push(irKeyString(key))
    cache.graphs.push(graph)
    cache.guards.push(guard)
}

// Drop every entry whose key mentions something that has changed underneath
// us -- a driver or toolchain version, say -- where keeping the entry would
// mean running a binary built for a different thing.
fn irCacheInvalidate(cache: IrCache, substring: str) -> int {
    var keys: [str] = []
    var graphs: [IrGraph] = []
    var guards: [IrGuard] = []
    var dropped = 0
    for i in 0..cache.keys.len() {
        if cache.keys[i].contains(substring) {
            dropped = dropped + 1
        } else {
            keys.push(cache.keys[i])
            graphs.push(cache.graphs[i])
            guards.push(cache.guards[i])
        }
    }
    cache.keys = keys
    cache.graphs = graphs
    cache.guards = guards
    cache.evictions = cache.evictions + dropped
    return dropped
}
