// Native loader for the frozen M7 datasets. No Python at run time: the files
// in data/m7/ are written once by tools/ml_reference/freeze_datasets.py and
// read here.
//
// Binary format, little-endian:
//
//     magic   : 8 bytes, ASCII "ZML7DATA"
//     version : u32 = 1
//     n_rows  : u32
//     sequenceLength : u32        (all rows padded to this with the PAD id)
//     vocab   : u32        (input vocabulary size)
//     classCount : u32        (output vocabulary size, i.e. number of target classes)
//     paddingId  : u32
//     reserved: u32 = 0
//     then n_rows * sequenceLength  i32 token ids
//     then n_rows            i32 targets
//
// Every header field is validated before a single element is read, and the
// payload size has to match the header exactly: a truncated file is rejected
// rather than read as far as it goes. Token ids and targets are range-checked
// as they are read, so a Dataset that exists is a Dataset that is in range.
import "ml/tensor.zeph"

let datasetHeaderSize = 36

struct Dataset {
    tokens: Tensor,     // I64, [n_rows, sequenceLength]
    targets: [int],     // length n_rows
    sequenceLength: int,
    vocab: int,
    classCount: int,
    paddingId: int,
}

// readFile panics on a missing path rather than returning empty, so the
// existence question has to be asked first -- same as gpu.zeph does.
fn datasetFileExists(path: str) -> bool {
    var pathBytes = cString(path)
    let attributes = win("GetFileAttributesA", pathBytes.addr())
    return attributes != 4294967295 and attributes != 0 - 1
}

fn datasetReadUint32(data: str, offset: int) -> int {
    return data.byte(offset) + data.byte(offset + 1) * 256 + data.byte(offset + 2) * 65536 + data.byte(offset + 3) * 16777216
}

fn datasetReadInt32(data: str, offset: int) -> int {
    let value = datasetReadUint32(data, offset)
    if value >= 2147483648 { return value - 4294967296 }
    return value
}

fn datasetLoad(path: str) -> Dataset {
    if not datasetFileExists(path) {
        panic("datasetLoad: {path} does not exist. Run: python tools/ml_reference/freeze_datasets.py")
    }
    let contents = readFile(path)
    if contents.len() < datasetHeaderSize {
        panic("datasetLoad: {path} is {contents.len()} bytes, too short for the {datasetHeaderSize}-byte header")
    }
    let magic = contents.sub(0, 8)
    if magic != "ZML7DATA" {
        panic("datasetLoad: {path} has bad magic, expected ZML7DATA")
    }
    let version = datasetReadUint32(contents, 8)
    if version != 1 {
        panic("datasetLoad: {path} has unknown version {version}, this reader understands version 1 only")
    }
    let rowCount = datasetReadUint32(contents, 12)
    let sequenceLength = datasetReadUint32(contents, 16)
    let vocab = datasetReadUint32(contents, 20)
    let classCount = datasetReadUint32(contents, 24)
    let paddingId = datasetReadUint32(contents, 28)
    let reserved = datasetReadUint32(contents, 32)
    if reserved != 0 {
        panic("datasetLoad: {path} has reserved = {reserved}, expected 0")
    }
    if vocab <= 0 {
        panic("datasetLoad: {path} declares a vocabulary of {vocab}")
    }
    if classCount <= 0 {
        panic("datasetLoad: {path} declares {classCount} target classes")
    }
    if paddingId >= vocab {
        panic("datasetLoad: {path} has pad id {paddingId} outside its vocabulary of {vocab}")
    }
    let payload = contents.len() - datasetHeaderSize
    // Bound each count by the payload before multiplying, so a header with
    // absurd counts cannot overflow its way into looking consistent.
    if rowCount > payload / 4 or sequenceLength > payload / 4 {
        panic("datasetLoad: {path} claims {rowCount} rows of {sequenceLength} tokens but only {payload} bytes follow the header")
    }
    let expectedPayload = (rowCount * sequenceLength + rowCount) * 4
    if expectedPayload != payload {
        panic("datasetLoad: {path} claims {rowCount} rows of {sequenceLength} tokens, needing {expectedPayload} payload bytes, but {payload} follow the header")
    }

    let tokens = tensorZeros(DType.I64, [rowCount, sequenceLength])
    var index = [0, 0]
    var offset = datasetHeaderSize
    for row in 0..rowCount {
        index[0] = row
        for column in 0..sequenceLength {
            let value = datasetReadInt32(contents, offset)
            if value < 0 or value >= vocab {
                panic("datasetLoad: {path} row {row} position {column} has token id {value}, outside the vocabulary of {vocab}")
            }
            index[1] = column
            tensorSetInt(tokens, index, value)
            offset += 4
        }
    }
    var targets: [int] = []
    for row in 0..rowCount {
        let value = datasetReadInt32(contents, offset)
        if value < 0 or value >= classCount {
            panic("datasetLoad: {path} row {row} has target {value}, outside the {classCount} target classes")
        }
        targets.push(value)
        offset += 4
    }
    return Dataset{tokens: tokens, targets: targets, sequenceLength: sequenceLength, vocab: vocab,
                   classCount: classCount, paddingId: paddingId}
}

// Rows [start, start + count) as a view over the same storage. An
// out-of-range request is an error, never a clamp: a short last batch that
// silently appeared would be a training bug nobody sees.
fn datasetBatch(dataset: Dataset, start: int, count: int) -> Dataset {
    let rowCount = dataset.targets.len()
    if start < 0 or count < 0 or start + count > rowCount {
        panic("datasetBatch: rows [{start}, {start + count}) requested from a dataset of {rowCount} rows")
    }
    var batchTargets: [int] = []
    for i in 0..count { batchTargets.push(dataset.targets[start + i]) }
    return Dataset{tokens: tensorSlice(dataset.tokens, 0, start, start + count), targets: batchTargets,
                   sequenceLength: dataset.sequenceLength, vocab: dataset.vocab, classCount: dataset.classCount, paddingId: dataset.paddingId}
}
