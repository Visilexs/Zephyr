// Causal language modelling on the phase state: consuming x_t predicts
// x_(t+1).
//
// The classification path in phase_ad runs its thinkSteps THINK steps once, after the
// whole sequence. That policy cannot work here. A causal model has to have a
// well-defined state after every token, because generation produces tokens
// one at a time and must arrive at exactly the state that teacher-forced
// training would have reached on the same prefix. So:
//
//   THE thinkSteps POLICY FOR CAUSAL MODE: consume the token, then run thinkSteps THINK steps,
//   per position. The state after position t is the state used to predict
//   x_(t+1).
//
// It is written down here because it is the thing that makes generation and
// training agree, and tests/ml/causal_test.zeph asserts the agreement
// bit-for-bit rather than to a tolerance. If the policy ever changes on one
// side only, that test fails, which is the whole point of having it.
//
// Three other decisions, all of which are visible in the tests:
//
//   * A reset mask resets the state to the initial state BEFORE consuming
//     that position's token. Running a sequence with a reset in the middle
//     therefore equals running the two halves independently, which is what
//     makes document boundaries inside a batch meaningful.
//   * Chunking carries the state across calls. Running [0,T) in one call and
//     running [0,k) then [k,T) with the state handed over must agree
//     bit-for-bit, or training on long sequences in chunks is not training
//     on the sequence.
//   * A position contributes to the loss only if both its own token and the
//     token it predicts are real. Perplexity is exp of the mean negative log
//     likelihood over exactly those positions -- "computed from valid logp",
//     not from a sum that quietly includes padding.
import "ml/phase_ad.zeph"

struct CausalRun {
    states: [int],   // one handle per position: the state after consuming it
    last: int,       // the state after the final position, for the next chunk
}

// A 0/1 column selector for one step, as a constant leaf. The same
// arithmetic-masking approach phase_ad uses: a branch would be control flow
// the tape cannot see.
fn causalColumnMask(source: Tensor, step: int, batch: int, wantedValue: int) -> Tensor {
    let mask = tensorZeros(DType.F64, [batch, 1])
    for row in 0..batch {
        if tensorGetInt(source, [row, step]) == wantedValue { tensorSet(mask, [row, 0], 1.0) }
    }
    return mask
}

fn causalBlend(take: int, ifTaken: int, ifNotTaken: int, batch: int) -> int {
    // take is a [batch,1] real 0/1 mask: result = take*a + (1-take)*b
    let onesLeaf = autogradLeaf(tensorOnes(DType.F64, [batch, 1]), false)
    let takeComplex = autogradCast(take, DType.C64)
    let complementComplex = autogradCast(autogradSubtract(onesLeaf, take), DType.C64)
    return autogradAdd(autogradMultiply(ifTaken, takeComplex), autogradMultiply(ifNotTaken, complementComplex))
}

// tokens [batch, T] int, reset [batch, T] int with 1 meaning "reset before
// this position". z_in is the incoming state handle, or -1 to start fresh.
fn causalRun(model: PhaseAD, tokens: Tensor, reset: Tensor, incomingState: int) -> CausalRun {
    let batch = tokens.shape[0]
    let length = tokens.shape[1]
    if reset.shape[0] != batch or reset.shape[1] != length {
        panic("causal: reset mask is {reset.shape[0]}x{reset.shape[1]}, tokens are {batch}x{length}")
    }
    let initialState = phaseAutogradInitial(model, batch)
    var state = initialState
    if incomingState >= 0 { state = incomingState }
    var states: [int] = []
    for position in 0..length {
        let resetMask = autogradLeaf(causalColumnMask(reset, position, batch, 1), false)
        state = causalBlend(resetMask, initialState, state, batch)

        var tokenIds: [int] = []
        for row in 0..batch {
            let tokenId = tensorGetInt(tokens, [row, position])
            if tokenId < 0 or tokenId >= model.config.inputVocab { panic("causal: token {tokenId} outside the vocabulary of {model.config.inputVocab}") }
            tokenIds.push(tokenId)
        }
        var nextState = phaseAutogradUpdate(model, state, autogradIndexSelect(model.embedding, 0, tokenIds))
        // The thinkSteps policy: THINK steps per position, not once at the end.
        for k in 0..model.config.thinkSteps {
            nextState = phaseAutogradUpdate(model, nextState, autogradExpand(autogradReshape(model.think, [1, model.config.embeddingDimension]), [batch, model.config.embeddingDimension]))
        }
        // A PAD position leaves the state exactly as it was.
        let realMask = autogradLeaf(tensorSubtract(tensorOnes(DType.F64, [batch, 1]), causalColumnMask(tokens, position, batch, model.config.padToken)), false)
        state = causalBlend(realMask, nextState, state, batch)
        states.push(state)
    }
    return CausalRun{states: states, last: state}
}

// Which positions predict something real: this token is real and the next
// token exists and is real.
fn causalValidMask(tokens: Tensor, paddingId: int) -> Tensor {
    let batch = tokens.shape[0]
    let length = tokens.shape[1]
    let validMask = tensorZeros(DType.F64, [batch, length])
    for row in 0..batch {
        for position in 0..(length - 1) {
            if tensorGetInt(tokens, [row, position]) != paddingId and tensorGetInt(tokens, [row, position + 1]) != paddingId {
                tensorSet(validMask, [row, position], 1.0)
            }
        }
    }
    return validMask
}

fn causalCountValid(tokens: Tensor, paddingId: int) -> int {
    let validMask = causalValidMask(tokens, paddingId)
    var validCount = 0
    for row in 0..validMask.shape[0] {
        for position in 0..validMask.shape[1] {
            if tensorGet(validMask, [row, position]) > 0.5 { validCount = validCount + 1 }
        }
    }
    return validCount
}

// Total negative log likelihood over valid positions, and the count, as a
// handle and an integer. Summed rather than averaged so chunks can be
// combined: a mean per chunk cannot be recombined without its weight.
fn causalNllSum(model: PhaseAD, tokens: Tensor, reset: Tensor, incomingState: int, runResult: CausalRun) -> int {
    let batch = tokens.shape[0]
    let length = tokens.shape[1]
    let valid = causalValidMask(tokens, model.config.padToken)
    var total = 0
    var started = false
    for position in 0..(length - 1) {
        let probabilities = phaseAutogradReadout(model, runResult.states[position])
        let oneHot = tensorZeros(DType.F64, [batch, model.config.outputVocab])
        var anyValid = false
        for row in 0..batch {
            if tensorGet(valid, [row, position]) > 0.5 {
                let nextTokenId = tensorGetInt(tokens, [row, position + 1])
                if nextTokenId < 0 or nextTokenId >= model.config.outputVocab { panic("causal: next token {nextTokenId} outside the readout vocabulary of {model.config.outputVocab}") }
                tensorSet(oneHot, [row, nextTokenId], 1.0)
                anyValid = true
            }
        }
        if anyValid {
            // Positions that do not contribute select nothing, so their row
            // of the one-hot is all zeros; adding eps keeps the log finite
            // and the zero row contributes ln(1) = 0 after the mask.
            let picked = autogradSumDimension(autogradMultiply(probabilities, autogradLeaf(oneHot, false)), 1)
            let keep = autogradLeaf(tensorReshape(tensorCopy(tensorSlice(valid, 1, position, position + 1)), [batch, 1]), false)
            let safe = autogradAdd(picked, autogradMultiply(autogradSubtract(autogradLeaf(tensorOnes(DType.F64, [batch, 1]), false), keep),
                                             phaseAutogradScalar(1.0)))
            let contribution = autogradSumAll(autogradMultiply(autogradNegate(autogradLn(safe)), keep))
            if not started { total = contribution
                             started = true } else { total = autogradAdd(total, contribution) }
        }
    }
    if not started { panic("causal: no position in this batch predicts a real token") }
    return total
}

// Mean negative log likelihood per valid position. This is the training loss
// and it is also exactly what perplexity exponentiates, so the two cannot
// drift apart.
fn causalLoss(model: PhaseAD, tokens: Tensor, reset: Tensor, incomingState: int) -> int {
    let runResult = causalRun(model, tokens, reset, incomingState)
    let validCount = causalCountValid(tokens, model.config.padToken)
    if validCount == 0 { panic("causal: this batch has no valid next-token position") }
    return autogradDivide(causalNllSum(model, tokens, reset, incomingState, runResult), phaseAutogradScalar(validCount as float))
}

// Takes the parameters rather than a tape view, because it resets the tape
// itself: perplexity is an evaluation, and an evaluation that inherited a
// half-built tape would be measuring whatever was on it.
fn causalPerplexity(parameters: PhaseParams, tokens: Tensor, reset: Tensor) -> float {
    autogradReset()
    let model = phaseAutogradParameters(parameters, false)
    return fexp(tensorGet(autogradValue(causalLoss(model, tokens, reset, 0 - 1)), [0]))
}

// Greedy generation, one token at a time, carrying the state forward. The
// state after each generated token is the state teacher-forced training
// would have reached on the same prefix -- that is the property
// tests/ml/causal_test.zeph checks, and it is the reason this walks the same
// causalRun rather than a second, separately written loop.
fn causalGenerate(model: PhaseAD, prompt: [int], newTokenCount: int) -> [int] {
    if prompt.len() == 0 { panic("causal: generation needs a non-empty prompt") }
    var generated: [int] = []
    for i in 0..prompt.len() { generated.push(prompt[i]) }
    var state = 0 - 1
    var first = true
    for step in 0..newTokenCount {
        // Feed only what is new since the last call: the prompt on the first
        // pass, then one token at a time.
        var feed: [int] = []
        if first {
            for i in 0..prompt.len() { feed.push(prompt[i]) }
        } else {
            feed.push(generated[generated.len() - 1])
        }
        let tokenTensor = tensorZeros(DType.I64, [1, feed.len()])
        let resetTensor = tensorZeros(DType.I64, [1, feed.len()])
        for i in 0..feed.len() { tensorSetInt(tokenTensor, [0, i], feed[i]) }
        if first { tensorSetInt(resetTensor, [0, 0], 1) }
        let runResult = causalRun(model, tokenTensor, resetTensor, state)
        state = runResult.last
        first = false
        let probabilities = autogradValue(phaseAutogradReadout(model, runResult.last))
        var best = 0
        var bestProbability = tensorGet(probabilities, [0, 0])
        for candidateToken in 1..model.config.outputVocab {
            let probability = tensorGet(probabilities, [0, candidateToken])
            if probability > bestProbability { bestProbability = probability
                        best = candidateToken }
        }
        generated.push(best)
    }
    return generated
}
