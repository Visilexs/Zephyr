// A small causal Transformer, as a control for the phase reasoner.
//
// The baselines document lists this as "Small causal Transformer -- later,
// same vocabulary/data and tuning budget". It is included here rather than
// deferred, so what "small" means is declared up front rather than tuned
// until it flatters or embarrasses the comparison: one attention head, a
// configurable number of blocks (two by default), pre-norm, a tanh MLP, and
// learned positional embeddings. Those are choices, not findings, and they
// are recorded in the run record with everything else.
//
// Everything is built from existing av_* operators. No opcode and no VJP is
// added, which is deliberate: a control whose gradients came from new,
// separately-verified-at-best code would confound "this architecture does
// worse" with "this architecture's backward pass is wrong". The verified
// tape differentiates all three families.
//
// Three things here are worth reading before trusting the numbers.
//
//   * Attention is computed per batch row. The tape's matmul is 2-D, so the
//     linear layers run on a flattened [B*T, d] matrix -- one large matmul
//     each, which is where the time goes -- while the [T,T] score matrix is
//     built one row at a time and concatenated back. That is a layout
//     decision, not an approximation: the arithmetic is the usual one.
//   * The softmax subtracts a row maximum that is DETACHED. Subtracting a
//     constant does not change softmax's value, and the maximum is not
//     differentiated, so no gradient is lost and nothing overflows. If the
//     maximum were on the tape it would contribute a spurious gradient path
//     through whichever element happened to be largest.
//   * Padding is masked in two places and both are necessary. Keys at PAD
//     positions are masked out of attention, and the readout is taken at
//     each row's last REAL token rather than at the padded end. Masking only
//     one of the two produces a model that looks trained and is reading
//     padding.
import "ml/autograd.zeph"

let transformerParametersPerLayer = 12
let transformerMaskedScore = 0.0 - 1000000000000000000000000000000.0

struct TfConfig {
    inputVocab: int,
    outputVocab: int,
    d: int,           // model width
    feedForwardDimension: int,          // MLP inner width
    layers: int,
    maxLength: int,
    padToken: int,
    epsilon: float,
}

struct TfParams {
    config: TfConfig,
    // embedding, pos, then transformerParametersPerLayer per layer, then lnf_g, lnf_b, Wout, bout
    tensors: [Tensor],
}

struct TfAD {
    config: TfConfig,
    handles: [int],
}

// The parameter order is fixed and is the only thing that relates a
// TfParams to a TfAD, so it is written once, here, and never duplicated.
fn newTransformer(config: TfConfig) -> TfParams {
    var tensors: [Tensor] = []
    tensors.push(tensorZeros(DType.F64, [config.inputVocab, config.d]))   // token embedding
    tensors.push(tensorZeros(DType.F64, [config.maxLength, config.d]))       // positional
    for layer in 0..config.layers {
        tensors.push(tensorOnes(DType.F64, [config.d]))                 // ln1 gain
        tensors.push(tensorZeros(DType.F64, [config.d]))                // ln1 bias
        tensors.push(tensorZeros(DType.F64, [config.d, config.d]))         // Wq
        tensors.push(tensorZeros(DType.F64, [config.d, config.d]))         // Wk
        tensors.push(tensorZeros(DType.F64, [config.d, config.d]))         // Wv
        tensors.push(tensorZeros(DType.F64, [config.d, config.d]))         // Wo
        tensors.push(tensorOnes(DType.F64, [config.d]))                 // ln2 gain
        tensors.push(tensorZeros(DType.F64, [config.d]))                // ln2 bias
        tensors.push(tensorZeros(DType.F64, [config.feedForwardDimension, config.d]))        // W1
        tensors.push(tensorZeros(DType.F64, [config.feedForwardDimension]))               // b1
        tensors.push(tensorZeros(DType.F64, [config.d, config.feedForwardDimension]))        // W2
        tensors.push(tensorZeros(DType.F64, [config.d]))                // b2
    }
    tensors.push(tensorOnes(DType.F64, [config.d]))                     // final ln gain
    tensors.push(tensorZeros(DType.F64, [config.d]))                    // final ln bias
    tensors.push(tensorZeros(DType.F64, [config.outputVocab, config.d]))  // readout
    tensors.push(tensorZeros(DType.F64, [config.outputVocab]))
    return TfParams{config: config, tensors: tensors}
}

fn transformerParameterList(parameters: TfParams) -> [Tensor] { return parameters.tensors }

fn transformerParameters(parameters: TfParams, requiresGradient: bool) -> TfAD {
    var handles: [int] = []
    for i in 0..parameters.tensors.len() { handles.push(autogradLeaf(parameters.tensors[i], requiresGradient)) }
    return TfAD{config: parameters.config, handles: handles}
}

fn transformerLayerBase(config: TfConfig, layer: int) -> int { return 2 + layer * transformerParametersPerLayer }
fn transformerTailBase(config: TfConfig) -> int { return 2 + config.layers * transformerParametersPerLayer }

fn transformerScalar(value: float) -> int { return autogradLeaf(tensorFull(DType.F64, [], value), false) }

// Softmax along rows with a detached maximum. See the header note: the
// maximum is a constant leaf, so it shifts the exponent without creating a
// gradient path.
fn transformerSoftmax(scores: int) -> int {
    let scoreValues = autogradValue(scores)
    let rowCount = scoreValues.shape[0]
    let columnCount = scoreValues.shape[1]
    let rowMaximum = tensorZeros(DType.F64, [rowCount, 1])
    for row in 0..rowCount {
        var best = tensorGet(scoreValues, [row, 0])
        for column in 1..columnCount {
            let candidate = tensorGet(scoreValues, [row, column])
            if candidate > best { best = candidate }
        }
        tensorSet(rowMaximum, [row, 0], best)
    }
    let exponentials = autogradExp(autogradSubtract(scores, autogradLeaf(rowMaximum, false)))
    return autogradDivide(exponentials, autogradSumDimension(exponentials, 1))
}

// Layer norm over the feature dimension. The reciprocal square root is
// reached through exp(-0.5 ln(v)) for the same reason phase_ad does it: ln
// and exp already carry VJPs and a sqrt primitive would buy nothing.
fn transformerLayerNorm(input: int, gain: int, bias: int, width: int, epsilon: float) -> int {
    let widthScalar = transformerScalar(width as float)
    let mean = autogradDivide(autogradSumDimension(input, 1), widthScalar)
    let centered = autogradSubtract(input, mean)
    let variance = autogradDivide(autogradSumDimension(autogradMultiply(centered, centered), 1), widthScalar)
    let inverseDeviation = autogradExp(autogradMultiply(autogradLn(autogradAdd(variance, transformerScalar(epsilon))), transformerScalar(0.0 - 0.5)))
    return autogradAdd(autogradMultiply(autogradMultiply(centered, inverseDeviation), gain), bias)
}

// The additive attention mask for one row: -inf above the diagonal, and
// -inf on any key at a PAD position. Built as a constant because it depends
// only on the input, never on the parameters.
fn transformerMaskRow(tokens: Tensor, row: int, length: int, padToken: int) -> Tensor {
    let mask = tensorZeros(DType.F64, [length, length])
    for queryPosition in 0..length {
        for keyPosition in 0..length {
            var blocked = keyPosition > queryPosition
            if tensorGetInt(tokens, [row, keyPosition]) == padToken { blocked = true }
            // A row's first position must keep at least one visible key, or
            // the softmax is 0/0. The diagonal is always visible.
            if keyPosition == queryPosition { blocked = false }
            if blocked { tensorSet(mask, [queryPosition, keyPosition], transformerMaskedScore) }
        }
    }
    return mask
}

// The last non-PAD position of each row, which is where the readout is
// taken. A model read at the padded end is reading padding.
fn transformerLastReal(tokens: Tensor, row: int, length: int, padToken: int) -> int {
    var last = 0
    for k in 0..length {
        if tensorGetInt(tokens, [row, k]) != padToken { last = k }
    }
    return last
}

// The full hidden state, [B*T, d], before any position is selected.
// Separated from transformerForward so causality can be tested directly: two inputs
// that agree up to position p must give the same hidden state AT p, and
// there is no way to check that if only the selected row is reachable.
fn transformerEncode(model: TfAD, tokens: Tensor) -> int {
    let batch = tokens.shape[0]
    let length = tokens.shape[1]
    let config = model.config
    let width = config.d
    if length > config.maxLength { panic("transformer: sequence of {length} exceeds maxLength {config.maxLength}") }

    // Token and position embeddings, flattened to [B*T, d] so every linear
    // layer below is one matmul rather than B of them.
    var tokenIds: [int] = []
    var positionIds: [int] = []
    for row in 0..batch {
        for position in 0..length {
            let tokenId = tensorGetInt(tokens, [row, position])
            if tokenId < 0 or tokenId >= config.inputVocab { panic("transformer: token id {tokenId} outside the vocabulary of {config.inputVocab}") }
            tokenIds.push(tokenId)
            positionIds.push(position)
        }
    }
    var residual = autogradAdd(autogradIndexSelect(model.handles[0], 0, tokenIds), autogradIndexSelect(model.handles[1], 0, positionIds))

    // The per-row attention masks, constant for the whole forward pass.
    var masks: [int] = []
    for row in 0..batch { masks.push(autogradLeaf(transformerMaskRow(tokens, row, length, config.padToken), false)) }
    let scale = transformerScalar(1.0 / fexp(0.5 * fln(width as float)))

    for layer in 0..config.layers {
        let layerBase = transformerLayerBase(config, layer)
        let attentionInput = transformerLayerNorm(residual, model.handles[layerBase], model.handles[layerBase + 1], width, config.epsilon)
        let queryProjection = autogradMatmul(attentionInput, autogradTranspose(model.handles[layerBase + 2], 0, 1))
        let keyProjection = autogradMatmul(attentionInput, autogradTranspose(model.handles[layerBase + 3], 0, 1))
        let valueProjection = autogradMatmul(attentionInput, autogradTranspose(model.handles[layerBase + 4], 0, 1))

        var context = 0 - 1
        for row in 0..batch {
            let rowStart = row * length
            let rowEnd = rowStart + length
            let rowQueries = autogradSlice(queryProjection, 0, rowStart, rowEnd)
            let rowKeys = autogradSlice(keyProjection, 0, rowStart, rowEnd)
            let rowValues = autogradSlice(valueProjection, 0, rowStart, rowEnd)
            let scores = autogradAdd(autogradMultiply(autogradMatmul(rowQueries, autogradTranspose(rowKeys, 0, 1)), scale), masks[row])
            let attention = transformerSoftmax(scores)
            let rowContext = autogradMatmul(attention, rowValues)
            if row == 0 { context = rowContext } else { context = autogradConcat(context, rowContext, 0) }
        }
        residual = autogradAdd(residual, autogradMatmul(context, autogradTranspose(model.handles[layerBase + 5], 0, 1)))

        let mlpInput = transformerLayerNorm(residual, model.handles[layerBase + 6], model.handles[layerBase + 7], width, config.epsilon)
        let inner = autogradTanh(autogradAdd(autogradMatmul(mlpInput, autogradTranspose(model.handles[layerBase + 8], 0, 1)), model.handles[layerBase + 9]))
        residual = autogradAdd(residual, autogradAdd(autogradMatmul(inner, autogradTranspose(model.handles[layerBase + 10], 0, 1)), model.handles[layerBase + 11]))
    }

    let tailBase = transformerTailBase(config)
    return transformerLayerNorm(residual, model.handles[tailBase], model.handles[tailBase + 1], width, config.epsilon)
}

fn transformerForward(model: TfAD, tokens: Tensor) -> int {
    let batch = tokens.shape[0]
    let length = tokens.shape[1]
    let hiddenStates = transformerEncode(model, tokens)
    var pick: [int] = []
    for row in 0..batch { pick.push(row * length + transformerLastReal(tokens, row, length, model.config.padToken)) }
    return autogradIndexSelect(hiddenStates, 0, pick)
}

fn transformerReadout(model: TfAD, hidden: int) -> int {
    let tailBase = transformerTailBase(model.config)
    return transformerSoftmax(autogradAdd(autogradMatmul(hidden, autogradTranspose(model.handles[tailBase + 2], 0, 1)), model.handles[tailBase + 3]))
}

// Mean negative log likelihood, selected by a one-hot mask and a sum so the
// selection stays on the tape -- the same construction phaseAutogradLoss uses, for
// the same reason, and so the two families' losses are the same quantity.
fn transformerLoss(model: TfAD, tokens: Tensor, targets: [int]) -> int {
    let batch = tokens.shape[0]
    let probabilities = transformerReadout(model, transformerForward(model, tokens))
    let oneHot = tensorZeros(DType.F64, [batch, model.config.outputVocab])
    for row in 0..batch {
        if targets[row] < 0 or targets[row] >= model.config.outputVocab { panic("transformer: target out of range") }
        tensorSet(oneHot, [row, targets[row]], 1.0)
    }
    let picked = autogradSumDimension(autogradMultiply(probabilities, autogradLeaf(oneHot, false)), 1)
    return autogradMeanAll(autogradNegate(autogradLn(picked)))
}
