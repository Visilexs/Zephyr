// Tensor-only optimizers. Complex storage is treated as independent real
// coordinates, including BOTH moment buffers (never a magnitude estimate).
import "ml/tensor.zeph"

struct Optim {
    kind: int,
    step: int,
    learningRate: float,
    weightDecay: float,
    momentum: float,
    beta1: float,
    beta2: float,
    epsilon: float,
    m: [Tensor],
    v: [Tensor],
}

fn optimizerIsFinite(value: float) -> bool { return ((bits(value) >> 52) & 2047) != 2047 }

// Validate public configuration, including state restored from a checkpoint.
fn optimizerValidateConfig(optimizer: Optim) {
    assert(optimizer.kind == 0 or optimizer.kind == 1, "optim: unknown optimizer")
    assert(optimizer.step >= 0 and optimizer.step < 9223372036854775807, "optim: invalid step")
    assert(optimizerIsFinite(optimizer.learningRate) and optimizer.learningRate >= 0.0, "optim: invalid learning rate")
    assert(optimizerIsFinite(optimizer.weightDecay) and optimizer.weightDecay >= 0.0, "optim: invalid weight decay")
    assert(optimizer.momentum >= 0.0 and optimizer.momentum < 1.0, "optim: invalid momentum")
    assert(optimizer.beta1 >= 0.0 and optimizer.beta1 < 1.0 and optimizer.beta2 >= 0.0 and optimizer.beta2 < 1.0, "optim: invalid beta")
    assert(optimizerIsFinite(optimizer.epsilon) and optimizer.epsilon > 0.0, "optim: invalid epsilon")
}

// Allocate moments in the parameter dtype; complex components round separately.
fn newOptimizer(params: [Tensor], kind: int, learningRate: float, weightDecay: float, momentum: float, beta1: float, beta2: float, epsilon: float) -> Optim {
    var firstMoments: [Tensor] = []
    var secondMoments: [Tensor] = []
    for i in 0..params.len() {
        let parameter = params[i]
        assert(dtypeIsFloat(parameter.dtype) or dtypeIsComplex(parameter.dtype), "optim: floating parameters required")
        assert(not parameter.readOnly, "optim: read-only parameter")
        firstMoments.push(tensorZeros(parameter.dtype, parameter.shape))
        secondMoments.push(tensorZeros(parameter.dtype, parameter.shape))
    }
    let optimizer = Optim{kind: kind, step: 0, learningRate: learningRate, weightDecay: weightDecay, momentum: momentum, beta1: beta1, beta2: beta2, epsilon: epsilon, m: firstMoments, v: secondMoments}
    optimizerValidateConfig(optimizer)
    return optimizer
}

fn newSgd(params: [Tensor], learningRate: float, momentum: float, weightDecay: float) -> Optim {
    return newOptimizer(params, 0, learningRate, weightDecay, momentum, 0.9, 0.999, 0.00000001)
}

fn newAdamW(params: [Tensor], learningRate: float, beta1: float, beta2: float, epsilon: float, weightDecay: float) -> Optim {
    return newOptimizer(params, 1, learningRate, weightDecay, 0.0, beta1, beta2, epsilon)
}

fn optimizerComponentCount(tensor: Tensor) -> int {
    if dtypeIsComplex(tensor.dtype) { return 2 }
    return 1
}

// Index through the tensor descriptor so slices and transposes also work.
fn optimizerGetComponent(tensor: Tensor, index: [int], component: int) -> float {
    let width = dtypeSize(dtypeComponent(tensor.dtype))
    let offset = tensorByteOffset(tensor, index) + component * width
    if width == 4 { return tensor.storage.buffer.getFloat32(offset) }
    return tensor.storage.buffer.getFloat64(offset)
}

fn optimizerPutComponent(tensor: Tensor, index: [int], component: int, value: float) {
    assert(not tensor.readOnly, "optim: read-only tensor")
    let width = dtypeSize(dtypeComponent(tensor.dtype))
    let offset = tensorByteOffset(tensor, index) + component * width
    if width == 4 { tensor.storage.buffer.putFloat32(offset, value) } else { tensor.storage.buffer.putFloat64(offset, value) }
    storageBump(tensor.storage)
}

// Integer exponentiation avoids a logarithm and is deterministic after resume.
fn optimizerPower(value: float, power: int) -> float {
    var base = value
    var exponent = power
    var result = 1.0
    while exponent > 0 {
        if exponent % 2 == 1 { result = result * base }
        base = base * base
        exponent = exponent / 2
    }
    return result
}

// Check all descriptors before mutating any parameter or advancing the step.
fn optimizerValidateState(optimizer: Optim, params: [Tensor]) {
    optimizerValidateConfig(optimizer)
    assert(optimizer.m.len() == params.len() and optimizer.v.len() == params.len(), "optim: state count mismatch")
    for i in 0..params.len() {
        let parameter = params[i]
        assert(dtypeIsFloat(parameter.dtype) or dtypeIsComplex(parameter.dtype), "optim: floating parameters required")
        assert(not parameter.readOnly and not optimizer.m[i].readOnly and not optimizer.v[i].readOnly, "optim: read-only state")
        assert(parameter.dtype == optimizer.m[i].dtype and parameter.dtype == optimizer.v[i].dtype, "optim: state dtype mismatch")
        assert(shapesEqual(parameter.shape, optimizer.m[i].shape) and shapesEqual(parameter.shape, optimizer.v[i].shape), "optim: state shape mismatch")
    }
}

// In-place SGD (coupled L2 decay) or AdamW (decay outside the moments).
// Call after backward; writes bump storage versions just like tensor setters.
fn optimizerStep(optimizer: Optim, params: [Tensor], gradients: [Tensor]) {
    optimizerValidateState(optimizer, params)
    assert(params.len() == gradients.len(), "optim: gradient count mismatch")
    for i in 0..params.len() {
        assert(params[i].dtype == gradients[i].dtype and shapesEqual(params[i].shape, gradients[i].shape), "optim: gradient descriptor mismatch")
    }
    optimizer.step += 1
    let biasCorrection1 = 1.0 - optimizerPower(optimizer.beta1, optimizer.step)
    let biasCorrection2 = 1.0 - optimizerPower(optimizer.beta2, optimizer.step)
    for i in 0..params.len() {
        let parameter = params[i]
        var index = indexZeros(parameter.shape.len())
        for j in 0..tensorElementCount(parameter) {
            for component in 0..optimizerComponentCount(parameter) {
                let oldValue = optimizerGetComponent(parameter, index, component)
                let gradient = optimizerGetComponent(gradients[i], index, component)
                if optimizer.kind == 0 {
                    let velocity = optimizer.momentum * optimizerGetComponent(optimizer.m[i], index, component) + (gradient + optimizer.weightDecay * oldValue)
                    optimizerPutComponent(optimizer.m[i], index, component, velocity)
                    optimizerPutComponent(parameter, index, component, oldValue - optimizer.learningRate * optimizerGetComponent(optimizer.m[i], index, component))
                } else {
                    optimizerPutComponent(optimizer.m[i], index, component, optimizer.beta1 * optimizerGetComponent(optimizer.m[i], index, component) + (1.0 - optimizer.beta1) * gradient)
                    optimizerPutComponent(optimizer.v[i], index, component, optimizer.beta2 * optimizerGetComponent(optimizer.v[i], index, component) + (1.0 - optimizer.beta2) * gradient * gradient)
                    let correctedFirstMoment = optimizerGetComponent(optimizer.m[i], index, component) / biasCorrection1
                    let correctedSecondMoment = optimizerGetComponent(optimizer.v[i], index, component) / biasCorrection2
                    optimizerPutComponent(parameter, index, component, oldValue - optimizer.learningRate * optimizer.weightDecay * oldValue - optimizer.learningRate * correctedFirstMoment / (sqrt(correctedSecondMoment) + optimizer.epsilon))
                }
            }
            indexNext(index, parameter.shape)
        }
    }
}

// Joint Euclidean norm over every real and imaginary gradient coordinate.
// Scale the sum of squares to avoid overflow for otherwise finite gradients.
fn clipGradientNorm(gradients: [Tensor], limit: float) -> float {
    assert(optimizerIsFinite(limit) and limit >= 0.0, "optim: invalid clipping limit")
    var scale = 0.0
    var scaledSumOfSquares = 0.0
    for i in 0..gradients.len() {
        let gradient = gradients[i]
        assert((dtypeIsFloat(gradient.dtype) or dtypeIsComplex(gradient.dtype)) and not gradient.readOnly, "optim: invalid clipping tensor")
        var index = indexZeros(gradient.shape.len())
        for j in 0..tensorElementCount(gradient) {
            for component in 0..optimizerComponentCount(gradient) {
                var value = optimizerGetComponent(gradient, index, component)
                assert(optimizerIsFinite(value), "optim: nonfinite gradient norm")
                if value < 0.0 { value = 0.0 - value }
                if value > 0.0 {
                    if value > scale {
                        scaledSumOfSquares = 1.0 + scaledSumOfSquares * (scale / value) * (scale / value)
                        scale = value
                    } else { scaledSumOfSquares += (value / scale) * (value / scale) }
                }
            }
            indexNext(index, gradient.shape)
        }
    }
    let norm = scale * sqrt(scaledSumOfSquares)
    if norm <= limit { return norm }
    let factor = (limit / scale) / sqrt(scaledSumOfSquares)
    for i in 0..gradients.len() {
        let gradient = gradients[i]
        var index = indexZeros(gradient.shape.len())
        for j in 0..tensorElementCount(gradient) {
            for component in 0..optimizerComponentCount(gradient) { optimizerPutComponent(gradient, index, component, optimizerGetComponent(gradient, index, component) * factor) }
            indexNext(index, gradient.shape)
        }
    }
    return norm
}
