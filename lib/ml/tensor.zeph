// Tensor descriptors and storage for the ML stack -- milestone M2a.
// Acceptance A02 (checked dimensions, bytes, strides, overflow and range)
// and A03 (owner/view lifetime, mutation versions, allocation accounting).
//
// Runtime descriptors over the existing Bytes buffer, deliberately: the
// specification stages first-class tensor types and scalar complex types as
// later compiler work, after the storage and AD semantics are settled here.
// Nothing in this file needs a parser change.
//
// Structs are reference types on Zephyr's counted heap, so a view holding a
// Storage keeps the buffer alive on its own and sees the owner's mutation
// version. Lifetime for CPU storage therefore needs no explicit free; the
// byte counters below are diagnostics, and matter mainly for the GPU path
// later, where completion has to be waited on before recycling.
import "std/bytes.zeph"

enum DType { F32, F64, C32, C64, I32, I64, Bool }

// Component-width naming, per the specification and NOT PyTorch's:
// C32 is two f32 components (8 bytes) and maps to torch.complex64.
// C64 is two f64 components (16 bytes) and maps to torch.complex128.
fn dtypeSize(dtype: DType) -> int {
    if dtype == DType.F32 { return 4 }
    if dtype == DType.F64 { return 8 }
    if dtype == DType.C32 { return 8 }
    if dtype == DType.C64 { return 16 }
    if dtype == DType.I32 { return 4 }
    if dtype == DType.I64 { return 8 }
    return 1
}

fn dtypeName(dtype: DType) -> str {
    if dtype == DType.F32 { return "f32" }
    if dtype == DType.F64 { return "f64" }
    if dtype == DType.C32 { return "c32_components" }
    if dtype == DType.C64 { return "c64_components" }
    if dtype == DType.I32 { return "i32" }
    if dtype == DType.I64 { return "i64" }
    return "bool"
}

fn dtypeIsComplex(dtype: DType) -> bool {
    return dtype == DType.C32 or dtype == DType.C64
}

fn dtypeIsFloat(dtype: DType) -> bool {
    return dtype == DType.F32 or dtype == DType.F64
}

// Component dtype of a complex dtype, so paired-real code can share a path.
fn dtypeComponent(dtype: DType) -> DType {
    if dtype == DType.C32 { return DType.F32 }
    if dtype == DType.C64 { return DType.F64 }
    return dtype
}

// Two caps with two different jobs.
//
// maxElements is the overflow guard: 2^40 elements times the widest dtype (16
// bytes) is 2^44, so checking it before each multiply is what makes the byte
// product provably unable to wrap i64, rather than merely unlikely to.
//
// maxBytes is a sanity cap, 128 GiB, comfortably above anything this project
// will allocate on a 32 GB machine and far below the absurd. Without it a
// nonsense request reaches the allocator and comes back as a bare "heap
// full", which says nothing about what was asked for. Raise it if a machine
// ever justifies that; it is deliberately not derived from maxElements, which
// would make it unreachable.
let maxElements = 1099511627776
let maxBytes = 137438953472

// ---- allocation accounting (A03) -------------------------------------------
// Live bytes only decreases when a caller explicitly releases. CPU buffers are
// also reclaimed by the counted heap when the last handle goes, so release is
// for accounting and for the later GPU allocator, not for correctness here.
var liveStorageBytes = 0
var peakStorageBytes = 0
var storageAllocationCount = 0
var storageReleaseCount = 0

fn mlLiveBytes() -> int { return liveStorageBytes }
fn mlPeakBytes() -> int { return peakStorageBytes }
fn mlAllocations() -> int { return storageAllocationCount }
fn mlReleases() -> int { return storageReleaseCount }

fn mlResetAccounting() {
    liveStorageBytes = 0
    peakStorageBytes = 0
    storageAllocationCount = 0
    storageReleaseCount = 0
}

struct Storage {
    buffer: Bytes,
    byteCount: int,
    version: int,
    released: bool,
}

fn newStorage(nbytes: int) -> Storage {
    if nbytes < 0 { panic("newStorage: negative byte count") }
    if nbytes > maxBytes {
        panic("newStorage: request of {nbytes} bytes exceeds the {maxBytes} byte cap")
    }
    liveStorageBytes += nbytes
    storageAllocationCount += 1
    if liveStorageBytes > peakStorageBytes { peakStorageBytes = liveStorageBytes }
    return Storage{buffer: Bytes.new(nbytes), byteCount: nbytes, version: 0, released: false}
}

// Accounting only. The buffer itself stays valid until the last handle drops,
// so this cannot create a dangling view.
fn storageRelease(storage: Storage) {
    if storage.released { panic("storageRelease: already released") }
    storage.released = true
    liveStorageBytes -= storage.byteCount
    storageReleaseCount += 1
}

fn storageBump(storage: Storage) { storage.version += 1 }

// ---- tensor descriptor -----------------------------------------------------
// strides and off are counted in ELEMENTS, never bytes; the byte conversion
// happens once, at the access site.
// ro marks a read-only view. A broadcast expansion carries stride 0 on the
// expanded axes, so many output indices alias one input element; writing
// through it would be a silent many-to-one corruption. Every setter refuses.
struct Tensor {
    storage: Storage,
    dtype: DType,
    shape: [int],
    stride: [int],
    offset: int,
    readOnly: bool,
}

fn shapeElementCount(shape: [int]) -> int {
    var elementCount = 1
    for i in 0..shape.len() {
        let extent = shape[i]
        if extent < 0 { panic("shape: negative dimension") }
        if extent != 0 and elementCount > maxElements / extent { panic("shape: element count overflows") }
        elementCount = elementCount * extent
    }
    return elementCount
}

fn contiguousStrides(shape: [int]) -> [int] {
    let rank = shape.len()
    var strides: [int] = []
    for i in 0..rank { strides.push(0) }
    var runningStride = 1
    var i = rank
    while i > 0 {
        i -= 1
        strides[i] = runningStride
        runningStride = runningStride * shape[i]
    }
    return strides
}

// Dimensions align from the right. Equal sizes agree; a 1 takes the other
// size, and that includes 1 against 0, which yields 0. Anything else is an
// error rather than a guess. Shape only -- no data is moved here.
fn broadcastShape(leftShape: [int], rightShape: [int]) -> [int] {
    let leftRank = leftShape.len()
    let rightRank = rightShape.len()
    var rank = leftRank
    if rightRank > rank { rank = rightRank }
    var output: [int] = []
    for i in 0..rank { output.push(0) }
    var i = 0
    while i < rank {
        var leftExtent = 1
        var rightExtent = 1
        if i < leftRank { leftExtent = leftShape[leftRank - 1 - i] }
        if i < rightRank { rightExtent = rightShape[rightRank - 1 - i] }
        var extent = 0
        if leftExtent == rightExtent {
            extent = leftExtent
        } else {
            if leftExtent == 1 {
                extent = rightExtent
            } else {
                if rightExtent == 1 {
                    extent = leftExtent
                } else {
                    panic("broadcast: incompatible dimensions")
                }
            }
        }
        output[rank - 1 - i] = extent
        i += 1
    }
    return output
}

fn shapesEqual(leftShape: [int], rightShape: [int]) -> bool {
    if leftShape.len() != rightShape.len() { return false }
    for i in 0..leftShape.len() {
        if leftShape[i] != rightShape[i] { return false }
    }
    return true
}

fn tensorRank(tensor: Tensor) -> int { return tensor.shape.len() }
fn tensorElementCount(tensor: Tensor) -> int { return shapeElementCount(tensor.shape) }
fn tensorDtype(tensor: Tensor) -> DType { return tensor.dtype }
fn tensorVersion(tensor: Tensor) -> int { return tensor.storage.version }

// Rank zero is a scalar and holds one element; an empty dimension is legal
// and makes the tensor hold none.
fn tensorZeros(dtype: DType, shape: [int]) -> Tensor {
    let elementCount = shapeElementCount(shape)
    let elementSize = dtypeSize(dtype)
    if elementCount != 0 and elementSize > maxBytes / elementCount {
        panic("tensorZeros: {elementCount} elements of {elementSize} bytes exceeds the {maxBytes} byte cap")
    }
    let storage = newStorage(elementCount * elementSize)
    return Tensor{storage: storage, dtype: dtype, shape: shape, stride: contiguousStrides(shape), offset: 0, readOnly: false}
}

fn tensorIsContiguous(tensor: Tensor) -> bool {
    let expectedStrides = contiguousStrides(tensor.shape)
    for i in 0..expectedStrides.len() {
        // a dimension of length 1 can carry any stride without changing layout
        if tensor.shape[i] != 1 and tensor.stride[i] != expectedStrides[i] { return false }
    }
    return true
}

// The single place an index becomes a byte offset. Every read and write goes
// through it, so the range check cannot be bypassed.
fn tensorElementOffset(tensor: Tensor, index: [int]) -> int {
    if index.len() != tensor.shape.len() { panic("index: wrong rank") }
    var offset = tensor.offset
    for i in 0..index.len() {
        let coordinate = index[i]
        if coordinate < 0 or coordinate >= tensor.shape[i] { panic("index: out of range") }
        offset += coordinate * tensor.stride[i]
    }
    return offset
}

fn tensorByteOffset(tensor: Tensor, index: [int]) -> int {
    let elementOffset = tensorElementOffset(tensor, index)
    let byteOffset = elementOffset * dtypeSize(tensor.dtype)
    if byteOffset < 0 or byteOffset + dtypeSize(tensor.dtype) > tensor.storage.byteCount { panic("index: outside storage") }
    return byteOffset
}

// ---- element access --------------------------------------------------------
// Real dtypes read and write through float (f64). Reading an f32 widens;
// writing an f32 rounds at the store, which is where the specification wants
// the rounding to be explicit.
fn tensorGet(tensor: Tensor, index: [int]) -> float {
    let byteOffset = tensorByteOffset(tensor, index)
    if tensor.dtype == DType.F64 { return tensor.storage.buffer.getFloat64(byteOffset) }
    if tensor.dtype == DType.F32 { return tensor.storage.buffer.getFloat32(byteOffset) }
    if tensor.dtype == DType.I64 { return tensor.storage.buffer.get64(byteOffset) as float }
    if tensor.dtype == DType.I32 { return tensor.storage.buffer.get32(byteOffset) as float }
    if tensor.dtype == DType.Bool { return tensor.storage.buffer.get8(byteOffset) as float }
    panic("tensorGet: complex dtype needs tensorGetReal / tensorGetImaginary")
    return 0.0
}

fn tensorSet(tensor: Tensor, index: [int], value: float) {
    if tensor.readOnly { panic("write into a read-only (broadcast) view") }
    let byteOffset = tensorByteOffset(tensor, index)
    if tensor.dtype == DType.F64 {
        tensor.storage.buffer.putFloat64(byteOffset, value)
    } else {
        if tensor.dtype == DType.F32 {
            tensor.storage.buffer.putFloat32(byteOffset, value)
        } else {
            panic("tensorSet: not a real float dtype")
        }
    }
    storageBump(tensor.storage)
}

fn tensorGetInt(tensor: Tensor, index: [int]) -> int {
    let byteOffset = tensorByteOffset(tensor, index)
    if tensor.dtype == DType.I64 { return tensor.storage.buffer.get64(byteOffset) }
    if tensor.dtype == DType.I32 { return tensor.storage.buffer.get32(byteOffset) }
    if tensor.dtype == DType.Bool { return tensor.storage.buffer.get8(byteOffset) }
    panic("tensorGetInt: not an integer dtype")
    return 0
}

fn tensorSetInt(tensor: Tensor, index: [int], value: int) {
    if tensor.readOnly { panic("write into a read-only (broadcast) view") }
    let byteOffset = tensorByteOffset(tensor, index)
    if tensor.dtype == DType.I64 {
        tensor.storage.buffer.put64(byteOffset, value)
    } else {
        if tensor.dtype == DType.I32 {
            tensor.storage.buffer.put32(byteOffset, value)
        } else {
            if tensor.dtype == DType.Bool {
                if value == 0 { tensor.storage.buffer.put8(byteOffset, 0) } else { tensor.storage.buffer.put8(byteOffset, 1) }
            } else {
                panic("tensorSetInt: not an integer dtype")
            }
        }
    }
    storageBump(tensor.storage)
}

// Complex is stored interleaved, real then imaginary, which is the canonical
// external layout the checkpoint format also uses.
fn tensorGetReal(tensor: Tensor, index: [int]) -> float {
    let byteOffset = tensorByteOffset(tensor, index)
    if tensor.dtype == DType.C64 { return tensor.storage.buffer.getFloat64(byteOffset) }
    if tensor.dtype == DType.C32 { return tensor.storage.buffer.getFloat32(byteOffset) }
    panic("tensorGetReal: not a complex dtype")
    return 0.0
}

fn tensorGetImaginary(tensor: Tensor, index: [int]) -> float {
    let byteOffset = tensorByteOffset(tensor, index)
    if tensor.dtype == DType.C64 { return tensor.storage.buffer.getFloat64(byteOffset + 8) }
    if tensor.dtype == DType.C32 { return tensor.storage.buffer.getFloat32(byteOffset + 4) }
    panic("tensorGetImaginary: not a complex dtype")
    return 0.0
}

fn tensorSetComplex(tensor: Tensor, index: [int], realPart: float, imaginaryPart: float) {
    if tensor.readOnly { panic("write into a read-only (broadcast) view") }
    let byteOffset = tensorByteOffset(tensor, index)
    if tensor.dtype == DType.C64 {
        tensor.storage.buffer.putFloat64(byteOffset, realPart)
        tensor.storage.buffer.putFloat64(byteOffset + 8, imaginaryPart)
    } else {
        if tensor.dtype == DType.C32 {
            tensor.storage.buffer.putFloat32(byteOffset, realPart)
            tensor.storage.buffer.putFloat32(byteOffset + 4, imaginaryPart)
        } else {
            panic("tensorSetComplex: not a complex dtype")
        }
    }
    storageBump(tensor.storage)
}

// ---- views -----------------------------------------------------------------
// All of these change metadata only and share the owner's Storage, so a write
// through one is visible through the others and bumps the same version.

fn tensorTranspose(tensor: Tensor, firstAxis: int, secondAxis: int) -> Tensor {
    let rank = tensor.shape.len()
    if firstAxis < 0 or secondAxis < 0 or firstAxis >= rank or secondAxis >= rank { panic("transpose: axis out of range") }
    var newShape: [int] = []
    var newStrides: [int] = []
    for i in 0..rank {
        newShape.push(tensor.shape[i])
        newStrides.push(tensor.stride[i])
    }
    newShape[firstAxis] = tensor.shape[secondAxis]
    newShape[secondAxis] = tensor.shape[firstAxis]
    newStrides[firstAxis] = tensor.stride[secondAxis]
    newStrides[secondAxis] = tensor.stride[firstAxis]
    return Tensor{storage: tensor.storage, dtype: tensor.dtype, shape: newShape, stride: newStrides, offset: tensor.offset, readOnly: tensor.readOnly}
}

// half-open [start, stop), matching the language's own range convention
fn tensorSlice(tensor: Tensor, dimension: int, start: int, stop: int) -> Tensor {
    let rank = tensor.shape.len()
    if dimension < 0 or dimension >= rank { panic("slice: dim out of range") }
    if start < 0 or stop > tensor.shape[dimension] or start > stop { panic("slice: bounds out of range") }
    var newShape: [int] = []
    var newStrides: [int] = []
    for i in 0..rank {
        newShape.push(tensor.shape[i])
        newStrides.push(tensor.stride[i])
    }
    newShape[dimension] = stop - start
    return Tensor{storage: tensor.storage, dtype: tensor.dtype, shape: newShape, stride: newStrides, offset: tensor.offset + start * tensor.stride[dimension], readOnly: tensor.readOnly}
}

// Aliases only when the layout permits. No hidden copy: a non-contiguous
// input is an error the caller has to resolve with an explicit copy, which
// keeps the cost visible.
fn tensorReshape(tensor: Tensor, shape: [int]) -> Tensor {
    if not tensorIsContiguous(tensor) { panic("reshape: tensor is not contiguous") }
    if shapeElementCount(shape) != tensorElementCount(tensor) { panic("reshape: element count differs") }
    return Tensor{storage: tensor.storage, dtype: tensor.dtype, shape: shape, stride: contiguousStrides(shape), offset: tensor.offset, readOnly: tensor.readOnly}
}

// ---- saved tensors ---------------------------------------------------------
// The autograd tape will save forward values and use them during backward. A
// write through any view in between invalidates them, and that must be an
// error rather than a silently wrong gradient.
struct Saved {
    tensor: Tensor,
    version: int,
}

fn tensorSave(tensor: Tensor) -> Saved {
    return Saved{tensor: tensor, version: tensor.storage.version}
}

fn savedGet(saved: Saved) -> Tensor {
    if saved.tensor.storage.version != saved.version { panic("saved tensor used after its storage was mutated") }
    return saved.tensor
}

fn savedIsStale(saved: Saved) -> bool {
    return saved.tensor.storage.version != saved.version
}

// ---- index iteration -------------------------------------------------------
// Row-major odometer over an arbitrary shape. Returns false once it wraps, so
// a rank-zero shape runs its body exactly once and an empty shape not at all.

fn indexZeros(rank: int) -> [int] {
    var index: [int] = []
    for i in 0..rank { index.push(0) }
    return index
}

fn indexNext(index: [int], shape: [int]) -> bool {
    var i = shape.len()
    while i > 0 {
        i -= 1
        index[i] += 1
        if index[i] < shape[i] { return true }
        index[i] = 0
    }
    return false
}

// ---- broadcast expansion ---------------------------------------------------
// Zero stride on every expanded axis, so all the output indices along it read
// the one source element. Read-only by construction: writing through it would
// be many-to-one.
fn tensorExpand(tensor: Tensor, shape: [int]) -> Tensor {
    let rank = shape.len()
    let sourceRank = tensor.shape.len()
    if sourceRank > rank { panic("expand: cannot reduce rank") }
    var newStrides: [int] = []
    for i in 0..rank { newStrides.push(0) }
    var i = 0
    while i < rank {
        let outputAxis = rank - 1 - i
        if i < sourceRank {
            let sourceAxis = sourceRank - 1 - i
            let sourceExtent = tensor.shape[sourceAxis]
            if sourceExtent == shape[outputAxis] {
                newStrides[outputAxis] = tensor.stride[sourceAxis]
            } else {
                if sourceExtent == 1 {
                    newStrides[outputAxis] = 0
                } else {
                    panic("expand: source dimension is neither 1 nor equal to the target")
                }
            }
        } else {
            newStrides[outputAxis] = 0
        }
        i += 1
    }
    return Tensor{storage: tensor.storage, dtype: tensor.dtype, shape: shape, stride: newStrides, offset: tensor.offset, readOnly: true}
}

// ---- fills, copy and cast --------------------------------------------------

fn tensorFull(dtype: DType, shape: [int], value: float) -> Tensor {
    let tensor = tensorZeros(dtype, shape)
    let elementCount = tensorElementCount(tensor)
    if elementCount == 0 { return tensor }
    var index = indexZeros(shape.len())
    var more = true
    while more {
        if dtypeIsComplex(dtype) {
            tensorSetComplex(tensor, index, value, 0.0)
        } else {
            tensorSet(tensor, index, value)
        }
        more = indexNext(index, shape)
    }
    return tensor
}

fn tensorOnes(dtype: DType, shape: [int]) -> Tensor { return tensorFull(dtype, shape, 1.0) }

// Always materialises a fresh contiguous buffer, so the result never aliases
// the source and is safe to write to even when the source was a broadcast.
fn tensorCopy(tensor: Tensor) -> Tensor {
    let output = tensorZeros(tensor.dtype, tensor.shape)
    let elementCount = tensorElementCount(tensor)
    if elementCount == 0 { return output }
    var index = indexZeros(tensor.shape.len())
    var more = true
    while more {
        if dtypeIsComplex(tensor.dtype) {
            tensorSetComplex(output, index, tensorGetReal(tensor, index), tensorGetImaginary(tensor, index))
        } else {
            if dtypeIsFloat(tensor.dtype) {
                tensorSet(output, index, tensorGet(tensor, index))
            } else {
                tensorSetInt(output, index, tensorGetInt(tensor, index))
            }
        }
        more = indexNext(index, tensor.shape)
    }
    return output
}

// Explicit only. Real to complex fills the imaginary part with zero; complex
// to real is refused outright, because dropping the imaginary part silently
// is exactly the bug the specification wants made impossible.
fn tensorCast(tensor: Tensor, dtype: DType) -> Tensor {
    if dtypeIsComplex(tensor.dtype) and not dtypeIsComplex(dtype) {
        panic("cast: complex to real needs an explicit tensorReal or tensorImaginary")
    }
    let output = tensorZeros(dtype, tensor.shape)
    let elementCount = tensorElementCount(tensor)
    if elementCount == 0 { return output }
    var index = indexZeros(tensor.shape.len())
    var more = true
    while more {
        if dtypeIsComplex(dtype) {
            if dtypeIsComplex(tensor.dtype) {
                tensorSetComplex(output, index, tensorGetReal(tensor, index), tensorGetImaginary(tensor, index))
            } else {
                if dtypeIsFloat(tensor.dtype) {
                    tensorSetComplex(output, index, tensorGet(tensor, index), 0.0)
                } else {
                    tensorSetComplex(output, index, tensorGetInt(tensor, index) as float, 0.0)
                }
            }
        } else {
            if dtypeIsFloat(dtype) {
                if dtypeIsFloat(tensor.dtype) { tensorSet(output, index, tensorGet(tensor, index)) }
                else { tensorSet(output, index, tensorGetInt(tensor, index) as float) }
            } else {
                if dtypeIsFloat(tensor.dtype) { tensorSetInt(output, index, tensorGet(tensor, index) as int) }
                else { tensorSetInt(output, index, tensorGetInt(tensor, index)) }
            }
        }
        more = indexNext(index, tensor.shape)
    }
    return output
}

// ---- raw layout inspection (A05) -------------------------------------------
// Lowercase hex of the whole backing buffer, so the byte order of a complex
// tensor can be compared against numpy or torch without a binary channel.

fn hexDigitCharacter(digit: int) -> str {
    if digit < 10 { return chr(48 + digit) }
    return chr(87 + digit)
}

fn tensorHex(tensor: Tensor) -> str {
    var output = ""
    for i in 0..tensor.storage.byteCount {
        let byteValue = tensor.storage.buffer.get8(i)
        output = "{output}{hexDigitCharacter(byteValue / 16)}{hexDigitCharacter(byteValue % 16)}"
    }
    return output
}
