// Device dispatch for the elementwise, reduction and gather kernels.
//
// The contract these five kernels share is in .agent/briefs/gpu_kernels.md: a
// 96-byte push-constant block carrying rank, element count, opcode, a
// complex-ness bitfield, the output shape, three stride vectors and three
// offsets. Strides and offsets are in elements, which is exactly what
// lib/ml/tensor.zeph already stores, so a Tensor's metadata passes straight
// through with no translation and no repacking.
//
// That is the whole reason the contract is shaped this way. Because the
// kernels index through strides, a transposed, sliced, broadcast or otherwise
// non-contiguous view needs no materialisation: the view's own strides are
// the kernel's strides, and a zero stride broadcasts. Four of the twenty-five
// ops the model uses -- transpose, slice, reshape, expand -- therefore cost
// nothing on the device at all, because they are metadata and never reach a
// kernel.
//
// Uploads here send a tensor's entire storage verbatim rather than gathering
// the view. That is deliberate: gathering on the host would defeat the point
// of passing strides, and it keeps the upload a straight byte copy whose
// correctness is obvious.
//
// ponytail: upload-dispatch-download per call, which is the slow shape. The
// resident layer is what makes these worth calling; this is the correctness
// floor it will be checked against.
import "ml/gpu.zeph"
import "ml/autograd.zeph"

// Opcodes. 0-3 are fixed by tensorBinary and 0-4 by the MAP_ constants in
// ops.zeph; the rest continue that numbering and the kernels agree.
let gpuOperationAdd = 0
let gpuOperationSubtract = 1
let gpuOperationMultiply = 2
let gpuOperationDivide = 3

let gpuOperationTanh = 0
let gpuOperationCos = 1
let gpuOperationSin = 2
let gpuOperationExp = 3
let gpuOperationLn = 4
let gpuOperationNegate = 5
let gpuOperationAbs2 = 6
let gpuOperationConjugate = 7
let gpuOperationReal = 8
let gpuOperationImaginary = 9
let gpuOperationExpImaginary = 10
let gpuOperationCast = 11
let gpuOperationCopy = 12

let gpuOperationMaxRank = 4

fn gpuOperationComplexBit(dtype: DType) -> int {
    if dtypeIsComplex(dtype) { return 1 }
    return 0
}

// Copy a Bytes into a device buffer.
fn gpuOperationSend(backend: GpuMM, buffer: GpuBuffer, source: Bytes, byteCount: int) {
    var mappedPointer = Bytes.new(8)
    checkVulkanResult(vkMapMemory(backend.g.device, buffer.memory, 0, buffer.size, 0, mappedPointer.addr()), "gpuOperationSend: map")
    let base = mappedPointer.get64(0)
    for i in 0..byteCount { store8(base + i, source.get8(i)) }
    vkUnmapMemory(backend.g.device, buffer.memory)
}

fn gpuOperationReceive(backend: GpuMM, buffer: GpuBuffer, destination: Bytes, byteCount: int) {
    var mappedPointer = Bytes.new(8)
    checkVulkanResult(vkMapMemory(backend.g.device, buffer.memory, 0, buffer.size, 0, mappedPointer.addr()), "gpuOperationReceive: map")
    let base = mappedPointer.get64(0)
    for i in 0..byteCount { destination.put8(i, load8(base + i)) }
    vkUnmapMemory(backend.g.device, buffer.memory)
}

fn gpuOperationUpload(backend: GpuMM, tensor: Tensor) -> GpuBuffer {
    let byteCount = tensor.storage.byteCount
    let buffer = gpuAllocateBuffer(backend, byteCount)
    gpuOperationSend(backend, buffer, tensor.storage.buffer, byteCount)
    return buffer
}

// Build the shared 96-byte push block. Shape and stride vectors are padded to
// rank 4 with shape 1 and stride 0, which the kernels are specified to ignore.
fn gpuOperationPushConstants(rank: int, elementCount: int, opcode: int, flags: int, outputShape: [int], firstStrides: [int], secondStrides: [int], outputStrides: [int], firstOffset: int, secondOffset: int, outputOffset: int) -> Bytes {
    if rank > gpuOperationMaxRank { panic("gpu ops: rank {rank} exceeds the device kernels' maximum of {gpuOperationMaxRank}. Reshape to rank 4 or fewer, or run this op on the CPU.") }
    var pushConstants = Bytes.new(96)
    pushConstants.put32(0, rank)
    pushConstants.put32(4, elementCount)
    pushConstants.put32(8, opcode)
    pushConstants.put32(12, flags)
    for i in 0..gpuOperationMaxRank {
        var extent = 1
        var firstStride = 0
        var secondStride = 0
        var outputStride = 0
        if i < outputShape.len() { extent = outputShape[i] }
        if i < firstStrides.len() { firstStride = firstStrides[i] }
        if i < secondStrides.len() { secondStride = secondStrides[i] }
        if i < outputStrides.len() { outputStride = outputStrides[i] }
        pushConstants.put32(16 + i * 4, extent)
        pushConstants.put32(32 + i * 4, firstStride)
        pushConstants.put32(48 + i * 4, secondStride)
        pushConstants.put32(64 + i * 4, outputStride)
    }
    pushConstants.put32(80, firstOffset)
    pushConstants.put32(84, secondOffset)
    pushConstants.put32(88, outputOffset)
    return pushConstants
}

// One-dimensional dispatch over `numel` output elements, 256 per workgroup.
fn gpuOperationRun(backend: GpuMM, shaderPath: str, buffers: [GpuBuffer], pushConstants: Bytes, elementCount: int) {
    let descriptorSet = backend.g.storageBufferSet(buffers, VK_SHADER_STAGE_COMPUTE_BIT)
    let shaderModule = backend.g.shader(shaderPath)
    var setLayouts: [int] = []
    setLayouts.push(descriptorSet.layout)
    let pipelineLayout = backend.g.pipelineLayout(setLayouts, 96, VK_SHADER_STAGE_COMPUTE_BIT)
    let pipeline = backend.g.computePipeline(shaderModule, pipelineLayout, cString("main"))
    var sets = uint64Array([descriptorSet.set])
    let groups = (elementCount + 255) / 256
    let capturedLayout = pipelineLayout
    let capturedPipeline = pipeline
    let setsAddress = sets.addr()
    let pushConstantsAddress = pushConstants.addr()
    backend.g.immediate(fn(commandBuffer: int) {
        vkCmdBindPipeline(commandBuffer, VK_PIPELINE_BIND_POINT_COMPUTE, capturedPipeline)
        vkCmdBindDescriptorSets(commandBuffer, VK_PIPELINE_BIND_POINT_COMPUTE, capturedLayout, 0, 1, setsAddress, 0, 0)
        vkCmdPushConstants(commandBuffer, capturedLayout, VK_SHADER_STAGE_COMPUTE_BIT, 0, 96, pushConstantsAddress)
        vkCmdDispatch(commandBuffer, groups, 1, 1)
    })
    vkDestroyPipeline(backend.g.device, pipeline, 0)
    vkDestroyPipelineLayout(backend.g.device, pipelineLayout, 0)
    vkDestroyShaderModule(backend.g.device, shaderModule, 0)
    backend.g.destroyDescriptorSet(descriptorSet)
}

// a and b must already have the same shape. Broadcasting is expressed by
// passing an expanded view, whose zero strides the kernel reads directly --
// which is the point of the stride contract, so inferring a broadcast shape
// here would just duplicate what tensorExpand already did.
fn gpuOperationBinary(backend: GpuMM, left: Tensor, right: Tensor, opcode: int) -> Tensor {
    if left.dtype != right.dtype { panic("gpuOperationBinary: dtype mismatch") }
    if left.shape.len() != right.shape.len() { panic("gpuOperationBinary: rank mismatch; expand first") }
    for i in 0..left.shape.len() {
        if left.shape[i] != right.shape[i] { panic("gpuOperationBinary: shape mismatch at {i}; expand first") }
    }
    let output = tensorZeros(left.dtype, left.shape)
    let elementCount = tensorElementCount(output)
    if elementCount == 0 { return output }
    let leftBuffer = gpuOperationUpload(backend, left)
    let rightBuffer = gpuOperationUpload(backend, right)
    let outputBuffer = gpuAllocateBuffer(backend, output.storage.byteCount)
    let complexBit = gpuOperationComplexBit(left.dtype)
    let flags = complexBit + complexBit * 2 + complexBit * 4
    var buffers: [GpuBuffer] = []
    buffers.push(leftBuffer)
    buffers.push(rightBuffer)
    buffers.push(outputBuffer)
    gpuOperationRun(backend, "examples/shaders/elem_binary_f64.comp.spv", buffers,
            gpuOperationPushConstants(output.shape.len(), elementCount, opcode, flags, output.shape, left.stride, right.stride, output.stride, left.offset, right.offset, output.offset), elementCount)
    gpuOperationReceive(backend, outputBuffer, output.storage.buffer, output.storage.byteCount)
    gpuFreeBuffer(backend, leftBuffer)
    gpuFreeBuffer(backend, rightBuffer)
    gpuFreeBuffer(backend, outputBuffer)
    return output
}

fn gpuOperationUnary(backend: GpuMM, tensor: Tensor, opcode: int, outputDtype: DType) -> Tensor {
    let output = tensorZeros(outputDtype, tensor.shape)
    let elementCount = tensorElementCount(output)
    if elementCount == 0 { return output }
    let inputBuffer = gpuOperationUpload(backend, tensor)
    let outputBuffer = gpuAllocateBuffer(backend, output.storage.byteCount)
    let flags = gpuOperationComplexBit(tensor.dtype) + gpuOperationComplexBit(outputDtype) * 4
    var buffers: [GpuBuffer] = []
    buffers.push(inputBuffer)
    buffers.push(outputBuffer)
    var emptyStrides: [int] = []
    gpuOperationRun(backend, "examples/shaders/elem_unary_f64.comp.spv", buffers,
            gpuOperationPushConstants(output.shape.len(), elementCount, opcode, flags, output.shape, tensor.stride, emptyStrides, output.stride, tensor.offset, 0, output.offset), elementCount)
    gpuOperationReceive(backend, outputBuffer, output.storage.buffer, output.storage.byteCount)
    gpuFreeBuffer(backend, inputBuffer)
    gpuFreeBuffer(backend, outputBuffer)
    return output
}

// Sum along one axis. The output keeps that axis at extent 1, matching
// tensorSumDimension -- the kernel author read the Zephyr source and corrected the
// brief on this point, so host and device agree by construction rather than
// by coincidence.
fn gpuOperationSumDimension(backend: GpuMM, tensor: Tensor, dimension: int) -> Tensor {
    if dimension < 0 or dimension >= tensor.shape.len() { panic("gpuOperationSumDimension: dim {dimension} out of range") }
    var outputShape: [int] = []
    for i in 0..tensor.shape.len() { outputShape.push(tensor.shape[i]) }
    outputShape[dimension] = 1
    let output = tensorZeros(tensor.dtype, outputShape)
    let elementCount = tensorElementCount(output)
    if elementCount == 0 { return output }
    let inputBuffer = gpuOperationUpload(backend, tensor)
    let outputBuffer = gpuAllocateBuffer(backend, output.storage.byteCount)
    let complexBit = gpuOperationComplexBit(tensor.dtype)
    var buffers: [GpuBuffer] = []
    buffers.push(inputBuffer)
    buffers.push(outputBuffer)
    // bstr.x carries the stride along the reduced axis and offs.w its length.
    var reducedStrides: [int] = []
    reducedStrides.push(tensor.stride[dimension])
    var pushConstants = gpuOperationPushConstants(output.shape.len(), elementCount, dimension, complexBit + complexBit * 4, output.shape, tensor.stride, reducedStrides, output.stride, tensor.offset, 0, output.offset)
    pushConstants.put32(92, tensor.shape[dimension])
    gpuOperationRun(backend, "examples/shaders/reduce_f64.comp.spv", buffers, pushConstants, elementCount)
    gpuOperationReceive(backend, outputBuffer, output.storage.buffer, output.storage.byteCount)
    gpuFreeBuffer(backend, inputBuffer)
    gpuFreeBuffer(backend, outputBuffer)
    return output
}

fn gpuOperationIndexBuffer(backend: GpuMM, indices: [int]) -> GpuBuffer {
    var indexBytes = Bytes.new(4 * indices.len())
    for i in 0..indices.len() { indexBytes.put32(i * 4, indices[i]) }
    let buffer = gpuAllocateBuffer(backend, 4 * indices.len())
    gpuOperationSend(backend, buffer, indexBytes, 4 * indices.len())
    return buffer
}

// index_select, and with the right index list also roll and concat.
fn gpuOperationGather(backend: GpuMM, tensor: Tensor, dimension: int, indices: [int]) -> Tensor {
    if dimension < 0 or dimension >= tensor.shape.len() { panic("gpuOperationGather: dim {dimension} out of range") }
    var outputShape: [int] = []
    for i in 0..tensor.shape.len() { outputShape.push(tensor.shape[i]) }
    outputShape[dimension] = indices.len()
    let output = tensorZeros(tensor.dtype, outputShape)
    let elementCount = tensorElementCount(output)
    if elementCount == 0 { return output }
    let inputBuffer = gpuOperationUpload(backend, tensor)
    let indexBuffer = gpuOperationIndexBuffer(backend, indices)
    let outputBuffer = gpuAllocateBuffer(backend, output.storage.byteCount)
    let complexBit = gpuOperationComplexBit(tensor.dtype)
    var buffers: [GpuBuffer] = []
    buffers.push(inputBuffer)
    buffers.push(indexBuffer)
    buffers.push(outputBuffer)
    gpuOperationRun(backend, "examples/shaders/gather_f64.comp.spv", buffers,
            gpuOperationPushConstants(output.shape.len(), elementCount, dimension, complexBit + complexBit * 4, output.shape, tensor.stride, [], output.stride, tensor.offset, 0, output.offset), elementCount)
    gpuOperationReceive(backend, outputBuffer, output.storage.buffer, output.storage.byteCount)
    gpuFreeBuffer(backend, inputBuffer)
    gpuFreeBuffer(backend, indexBuffer)
    gpuFreeBuffer(backend, outputBuffer)
    return output
}

// The VJP of a gather: scatter `gr` back into an output of extent `n` along
// `dim`, accumulating where sel repeats. The output must start zeroed, which
// tensorZeros guarantees and the kernel's header comment requires.
fn gpuOperationScatterAdd(backend: GpuMM, gradient: Tensor, dimension: int, outputExtent: int, indices: [int]) -> Tensor {
    if dimension < 0 or dimension >= gradient.shape.len() { panic("gpuOperationScatterAdd: dim {dimension} out of range") }
    var outputShape: [int] = []
    for i in 0..gradient.shape.len() { outputShape.push(gradient.shape[i]) }
    outputShape[dimension] = outputExtent
    let output = tensorZeros(gradient.dtype, outputShape)
    let elementCount = tensorElementCount(gradient)
    if elementCount == 0 { return output }
    let gradientBuffer = gpuOperationUpload(backend, gradient)
    let indexBuffer = gpuOperationIndexBuffer(backend, indices)
    let outputBuffer = gpuAllocateBuffer(backend, output.storage.byteCount)
    gpuOperationSend(backend, outputBuffer, output.storage.buffer, output.storage.byteCount)      // the required zero fill
    let complexBit = gpuOperationComplexBit(gradient.dtype)
    var buffers: [GpuBuffer] = []
    buffers.push(gradientBuffer)
    buffers.push(indexBuffer)
    buffers.push(outputBuffer)
    // Iteration is over the GRADIENT's elements, so the shape driving the
    // dispatch is the gradient's, not the output's.
    gpuOperationRun(backend, "examples/shaders/scatter_add_f64.comp.spv", buffers,
            gpuOperationPushConstants(gradient.shape.len(), elementCount, dimension, complexBit + complexBit * 4, gradient.shape, gradient.stride, [], output.stride, gradient.offset, 0, output.offset), elementCount)
    gpuOperationReceive(backend, outputBuffer, output.storage.buffer, output.storage.byteCount)
    gpuFreeBuffer(backend, gradientBuffer)
    gpuFreeBuffer(backend, indexBuffer)
    gpuFreeBuffer(backend, outputBuffer)
    return output
}

// ---------------------------------------------------------------------------
// Installing the backend.
//
// Every hook falls back to the CPU body for anything the kernels do not
// cover -- non-float dtypes, float32, rank above 4 -- so enabling the backend
// changes where work happens and never what is computed. That property is
// what makes the gradient gate meaningful: if enabling the device could
// silently narrow coverage, a matching gradient would only prove the narrowed
// paths agreed.
fn gpuOperationSupported(dtype: DType) -> bool {
    return dtype == DType.F64 or dtype == DType.C64
}

fn gpuOperationsEnable(backend: GpuMM) {
    var binaryHooks: [fn(Tensor, Tensor, int) -> Tensor] = []
    binaryHooks.push(fn(left: Tensor, right: Tensor, opcode: int) -> Tensor {
        if left.dtype != right.dtype or not gpuOperationSupported(left.dtype) { return tensorBinaryCpu(left, right, opcode, "binary") }
        // The CPU path broadcasts inside itself; the device kernel wants both
        // operands already at the output shape, which tensorExpand gives for free
        // as zero strides. Doing it here keeps the kernel simple and keeps the
        // two paths computing the same thing.
        let shape = broadcastShape(left.shape, right.shape)
        if shape.len() > gpuOperationMaxRank { return tensorBinaryCpu(left, right, opcode, "binary") }
        return gpuOperationBinary(backend, tensorExpand(left, shape), tensorExpand(right, shape), opcode)
    })
    binaryHook = binaryHooks

    var unaryHooks: [fn(Tensor, int, DType) -> Tensor] = []
    unaryHooks.push(fn(tensor: Tensor, opcode: int, outputDtype: DType) -> Tensor {
        if not gpuOperationSupported(tensor.dtype) or not gpuOperationSupported(outputDtype) or tensor.shape.len() > gpuOperationMaxRank {
            if opcode == 6 { return tensorAbs2Cpu(tensor) }
            if opcode == 7 { return tensorConjugateCpu(tensor) }
            if opcode == 8 { return tensorRealCpu(tensor) }
            if opcode == 9 { return tensorImaginaryCpu(tensor) }
            if opcode == 10 { return tensorExpImaginaryCpu(tensor, outputDtype) }
            return tensorUnaryMapCpu(tensor, opcode)
        }
        return gpuOperationUnary(backend, tensor, opcode, outputDtype)
    })
    unaryHook = unaryHooks

    var sumDimensionHooks: [fn(Tensor, int) -> Tensor] = []
    sumDimensionHooks.push(fn(tensor: Tensor, dimension: int) -> Tensor {
        if not gpuOperationSupported(tensor.dtype) or tensor.shape.len() > gpuOperationMaxRank { return tensorSumDimensionCpu(tensor, dimension) }
        return gpuOperationSumDimension(backend, tensor, dimension)
    })
    sumDimensionHook = sumDimensionHooks

    var gatherHooks: [fn(Tensor, int, [int]) -> Tensor] = []
    gatherHooks.push(fn(tensor: Tensor, dimension: int, indices: [int]) -> Tensor {
        if not gpuOperationSupported(tensor.dtype) or tensor.shape.len() > gpuOperationMaxRank { return tensorIndexSelectCpu(tensor, dimension, indices) }
        return gpuOperationGather(backend, tensor, dimension, indices)
    })
    gatherHook = gatherHooks

    var scatterHooks: [fn(Tensor, int, int, [int]) -> Tensor] = []
    scatterHooks.push(fn(gradient: Tensor, dimension: int, outputExtent: int, indices: [int]) -> Tensor {
        if not gpuOperationSupported(gradient.dtype) or gradient.shape.len() > gpuOperationMaxRank { return scatterAddCpu(gradient, dimension, outputExtent, indices) }
        return gpuOperationScatterAdd(backend, gradient, dimension, outputExtent, indices)
    })
    scatterHook = scatterHooks

    gpuEnable(backend)
}

fn gpuOperationsDisable() {
    let emptyBinaryHooks: [fn(Tensor, Tensor, int) -> Tensor] = []
    let emptyUnaryHooks: [fn(Tensor, int, DType) -> Tensor] = []
    let emptySumDimensionHooks: [fn(Tensor, int) -> Tensor] = []
    let emptyGatherHooks: [fn(Tensor, int, [int]) -> Tensor] = []
    let emptyScatterHooks: [fn(Tensor, int, int, [int]) -> Tensor] = []
    binaryHook = emptyBinaryHooks
    unaryHook = emptyUnaryHooks
    sumDimensionHook = emptySumDimensionHooks
    gatherHook = emptyGatherHooks
    scatterHook = emptyScatterHooks
    gpuDisable()
}
