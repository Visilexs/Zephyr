// Eager reverse-mode automatic differentiation over lib/ml/ops.zeph.
//
// Compositional by construction: every entry here is an analytic VJP for a
// primitive operation, and anything higher level is built by calling those
// primitives rather than by adding a new rule. A specialized VJP is warranted
// only where an operation has no primitive decomposition, or where a
// measurement demands one; none has so far.
//
// The tape records an opcode and saved tensors, never a closure. Closures are
// unavailable on the wasm target, and recording them would quietly cost the
// three-target parity that lib/ml otherwise keeps.
//
// Gradient convention, matching MATHEMATICS.md: dL = Re(sum(conj(g) * dz)).
// A complex tensor's gradient is therefore another complex tensor of the same
// shape, and grad(abs2(z)) is exactly 2z. Real and imaginary parts are
// independent real coordinates; nothing here assumes holomorphicity.
import "ml/ops.zeph"

let operationLeaf = 0
let operationAdd = 1
let operationSubtract = 2
let operationMultiply = 3
let operationDivide = 4
let operationNegate = 5
let operationMatmul = 6
let operationTanh = 7
let operationSumDimension = 8
let operationSumAll = 9
let operationMeanAll = 10
let operationAbs2 = 11
let operationConjugate = 12
let operationReal = 13
let operationImaginary = 14
let operationExpImaginary = 15
let operationComplex = 16
let operationConcat = 17
let operationIndexSelect = 18
let operationRoll = 19
let operationTranspose = 20
let operationReshape = 21
let operationSlice = 22
let operationCast = 23
let operationExpand = 24
let operationCos = 25
let operationSin = 26
let operationLn = 27
let operationExp = 28

// The fused Givens stage (A25). A fusion is a new opcode, not a rewrite of
// the old ones: the composed form stays reachable so the two can be compared,
// which is the whole content of the acceptance check.
let operationGivens = 29
let operationBiasTanh = 30

// A node's inputs are variable handles, never tensors: a handle cannot go
// stale and cannot alias, and the graph stays a plain integer DAG.
struct ANode {
    op: int,
    a: int,
    b: int,
    saved: [Saved],
    integerAttributes: [int],
    floatAttributes: [float],
}

struct AVar {
    v: Tensor,
    g: Tensor,
    hasGradient: bool,
    node: int,
    requiresGradient: bool,
}

var tapeVariables: [AVar] = []
var tapeNodes: [ANode] = []
var tapeRecording = true
var tapeConsumed = false

// ---- tape lifetime ---------------------------------------------------------
// A07: the tape must not grow without bound across training steps, so it is
// explicitly reset rather than trimmed heuristically. autogradNodeCount() is exported
// so a test can assert the count returns to its baseline.

fn autogradReset() {
    let noVariables: [AVar] = []
    let noNodes: [ANode] = []
    tapeVariables = noVariables
    tapeNodes = noNodes
    tapeRecording = true
    tapeConsumed = false
}

fn autogradNodeCount() -> int { return tapeNodes.len() }
fn autogradVariableCount() -> int { return tapeVariables.len() }
fn autogradIsConsumed() -> bool { return tapeConsumed }

fn autogradNoGradient(enabled: bool) { tapeRecording = not enabled }
fn autogradIsRecording() -> bool { return tapeRecording }

// ---- variables -------------------------------------------------------------

fn autogradLeaf(tensor: Tensor, requiresGradient: bool) -> int {
    tapeVariables.push(AVar{v: tensor, g: tensor, hasGradient: false, node: 0 - 1, requiresGradient: requiresGradient})
    return tapeVariables.len() - 1
}

fn autogradConstant(tensor: Tensor) -> int { return autogradLeaf(tensor, false) }

fn autogradValue(handle: int) -> Tensor {
    if handle < 0 or handle >= tapeVariables.len() { panic("autograd: bad variable handle") }
    return tapeVariables[handle].v
}

fn autogradRequiresGradient(handle: int) -> bool { return tapeVariables[handle].requiresGradient }

fn autogradHasGradient(handle: int) -> bool { return tapeVariables[handle].hasGradient }

fn autogradGradient(handle: int) -> Tensor {
    if handle < 0 or handle >= tapeVariables.len() { panic("autograd: bad variable handle") }
    if not tapeVariables[handle].hasGradient { panic("autograd: no gradient for this variable") }
    return tapeVariables[handle].g
}

// detach yields a fresh leaf that shares the value but carries no history, so
// a gradient can never flow back through it.
fn autogradDetach(handle: int) -> int { return autogradLeaf(autogradValue(handle), false) }

// ---- recording -------------------------------------------------------------

fn anyRequiresGradient(firstOperand: int, secondOperand: int) -> bool {
    var anyRequires = false
    if firstOperand >= 0 and tapeVariables[firstOperand].requiresGradient { anyRequires = true }
    if secondOperand >= 0 and tapeVariables[secondOperand].requiresGradient { anyRequires = true }
    return anyRequires
}

fn record(output: Tensor, operation: int, firstOperand: int, secondOperand: int, saved: [Saved], integerAttributes: [int], floatAttributes: [float]) -> int {
    let live = tapeRecording and anyRequiresGradient(firstOperand, secondOperand)
    if not live { return autogradLeaf(output, false) }
    tapeNodes.push(ANode{op: operation, a: firstOperand, b: secondOperand, saved: saved, integerAttributes: integerAttributes, floatAttributes: floatAttributes})
    tapeVariables.push(AVar{v: output, g: output, hasGradient: false, node: tapeNodes.len() - 1, requiresGradient: true})
    return tapeVariables.len() - 1
}

// ---- gradient plumbing -----------------------------------------------------

fn zerosLike(tensor: Tensor) -> Tensor { return tensorZeros(tensor.dtype, tensor.shape) }

fn accumulate(handle: int, gradient: Tensor) {
    if handle < 0 { return }
    if not tapeVariables[handle].requiresGradient { return }
    if tapeVariables[handle].hasGradient {
        tapeVariables[handle].g = tensorAdd(tapeVariables[handle].g, gradient)
    } else {
        tapeVariables[handle].g = gradient
        tapeVariables[handle].hasGradient = true
    }
}

// A broadcast forward must be summed back down in reverse, or a shared
// parameter silently receives one contribution instead of all of them.
fn reduceToShape(gradient: Tensor, shape: [int]) -> Tensor {
    if shapesEqual(gradient.shape, shape) { return gradient }
    var reduced = gradient
    // leading axes the input does not have at all
    while reduced.shape.len() > shape.len() {
        let summed = tensorSumDimension(reduced, 0)
        var rest: [int] = []
        for i in 1..summed.shape.len() { rest.push(summed.shape[i]) }
        reduced = tensorReshape(tensorCopy(summed), rest)
    }
    for i in 0..shape.len() {
        if reduced.shape[i] != shape[i] {
            if shape[i] != 1 { panic("autograd: cannot reduce gradient to the input shape") }
            reduced = tensorSumDimension(reduced, i)
        }
    }
    if not shapesEqual(reduced.shape, shape) { panic("autograd: reduced gradient has the wrong shape") }
    return reduced
}

// ---- differentiable operations --------------------------------------------

fn autogradAdd(x: int, y: int) -> int {
    let output = tensorAdd(autogradValue(x), autogradValue(y))
    return record(output, operationAdd, x, y, [], [], [])
}

fn autogradSubtract(x: int, y: int) -> int {
    let output = tensorSubtract(autogradValue(x), autogradValue(y))
    return record(output, operationSubtract, x, y, [], [], [])
}

fn autogradMultiply(x: int, y: int) -> int {
    let output = tensorMultiply(autogradValue(x), autogradValue(y))
    return record(output, operationMultiply, x, y, [tensorSave(autogradValue(x)), tensorSave(autogradValue(y))], [], [])
}

fn autogradDivide(x: int, y: int) -> int {
    let output = tensorDivide(autogradValue(x), autogradValue(y))
    return record(output, operationDivide, x, y, [tensorSave(autogradValue(y)), tensorSave(output)], [], [])
}

fn autogradNegate(x: int) -> int {
    return record(tensorNegate(autogradValue(x)), operationNegate, x, 0 - 1, [], [], [])
}

fn autogradMatmul(x: int, y: int) -> int {
    let output = tensorMatmul(autogradValue(x), autogradValue(y))
    return record(output, operationMatmul, x, y, [tensorSave(autogradValue(x)), tensorSave(autogradValue(y))], [], [])
}

fn autogradTanh(x: int) -> int {
    let output = tensorTanh(autogradValue(x))
    return record(output, operationTanh, x, 0 - 1, [tensorSave(output)], [], [])
}

// cos and sin keep their own input rather than their output, because each
// one's derivative is the other function, not an expression in its own value.
fn autogradCos(x: int) -> int {
    let output = tensorCos(autogradValue(x))
    return record(output, operationCos, x, 0 - 1, [tensorSave(autogradValue(x))], [], [])
}

fn autogradSin(x: int) -> int {
    let output = tensorSin(autogradValue(x))
    return record(output, operationSin, x, 0 - 1, [tensorSave(autogradValue(x))], [], [])
}

fn autogradLn(x: int) -> int {
    let output = tensorLn(autogradValue(x))
    return record(output, operationLn, x, 0 - 1, [tensorSave(autogradValue(x))], [], [])
}

fn autogradExp(x: int) -> int {
    let output = tensorExp(autogradValue(x))
    return record(output, operationExp, x, 0 - 1, [tensorSave(output)], [], [])
}

fn autogradSumDimension(x: int, dimension: int) -> int {
    let output = tensorSumDimension(autogradValue(x), dimension)
    return record(output, operationSumDimension, x, 0 - 1, [], [dimension], [])
}

// Sums every element into a rank-1 single-element tensor, so a loss stays a
// tensor and needs no separate scalar path through the tape.
fn tensorSumToOne(tensor: Tensor) -> Tensor {
    let result = tensorZeros(tensor.dtype, [1])
    if dtypeIsComplex(tensor.dtype) {
        tensorSetComplex(result, [0], tensorSumAllReal(tensor), tensorSumAllImaginary(tensor))
    } else {
        tensorSet(result, [0], tensorSumAll(tensor))
    }
    return result
}

fn autogradSumAll(x: int) -> int {
    let output = tensorSumToOne(autogradValue(x))
    var inputShape: [int] = []
    for i in 0..autogradValue(x).shape.len() { inputShape.push(autogradValue(x).shape[i]) }
    return record(output, operationSumAll, x, 0 - 1, [], inputShape, [])
}

fn autogradMeanAll(x: int) -> int {
    let elementCount = tensorElementCount(autogradValue(x))
    if elementCount == 0 { panic("autograd: mean of an empty tensor") }
    let output = tensorDivide(tensorSumToOne(autogradValue(x)), tensorFull(autogradValue(x).dtype, [1], elementCount as float))
    var inputShape: [int] = []
    for i in 0..autogradValue(x).shape.len() { inputShape.push(autogradValue(x).shape[i]) }
    return record(output, operationMeanAll, x, 0 - 1, [], inputShape, [])
}

fn autogradAbs2(x: int) -> int {
    let output = tensorAbs2(autogradValue(x))
    return record(output, operationAbs2, x, 0 - 1, [tensorSave(autogradValue(x))], [], [])
}

fn autogradConjugate(x: int) -> int {
    return record(tensorConjugate(autogradValue(x)), operationConjugate, x, 0 - 1, [], [], [])
}

fn autogradReal(x: int) -> int {
    return record(tensorReal(autogradValue(x)), operationReal, x, 0 - 1, [], [dtypeSize(autogradValue(x).dtype)], [])
}

fn autogradImaginary(x: int) -> int {
    return record(tensorImaginary(autogradValue(x)), operationImaginary, x, 0 - 1, [], [dtypeSize(autogradValue(x).dtype)], [])
}

fn autogradExpImaginary(x: int, complexDtype: DType) -> int {
    let output = tensorExpImaginary(autogradValue(x), complexDtype)
    return record(output, operationExpImaginary, x, 0 - 1, [tensorSave(output)], [], [])
}

fn autogradComplex(realPart: int, imaginaryPart: int, complexDtype: DType) -> int {
    let output = tensorComplex(autogradValue(realPart), autogradValue(imaginaryPart), complexDtype)
    return record(output, operationComplex, realPart, imaginaryPart, [], [], [])
}

fn autogradConcat(x: int, y: int, dimension: int) -> int {
    let output = tensorConcat(autogradValue(x), autogradValue(y), dimension)
    return record(output, operationConcat, x, y, [], [dimension, autogradValue(x).shape[dimension], autogradValue(y).shape[dimension]], [])
}

fn autogradIndexSelect(x: int, dimension: int, indices: [int]) -> int {
    let output = tensorIndexSelect(autogradValue(x), dimension, indices)
    var integerAttributes: [int] = [dimension, autogradValue(x).shape[dimension]]
    for i in 0..indices.len() { integerAttributes.push(indices[i]) }
    return record(output, operationIndexSelect, x, 0 - 1, [], integerAttributes, [])
}

// The controller nonlinearity as a single node: tanh(x + b).
fn autogradBiasTanh(x: int, bias: int) -> int {
    let output = tensorBiasTanh(autogradValue(x), autogradValue(bias))
    return record(output, operationBiasTanh, x, bias, [tensorSave(output)], [], [])
}

// One Givens stage as a single node. theta and phi travel as one tensor, tp,
// theta in columns 0..D/2 and phi in D/2..D -- the two halves the caller used
// to slice apart.
fn autogradGivens(z: int, thetaPhi: int, stage: int) -> int {
    let output = tensorGivens(autogradValue(z), autogradValue(thetaPhi), stage)
    return record(output, operationGivens, z, thetaPhi, [tensorSave(autogradValue(z)), tensorSave(autogradValue(thetaPhi))], [stage], [])
}

fn autogradRoll(x: int, dimension: int, shift: int) -> int {
    let output = tensorRoll(autogradValue(x), dimension, shift)
    return record(output, operationRoll, x, 0 - 1, [], [dimension, shift], [])
}

fn autogradTranspose(x: int, firstAxis: int, secondAxis: int) -> int {
    let output = tensorCopy(tensorTranspose(autogradValue(x), firstAxis, secondAxis))
    return record(output, operationTranspose, x, 0 - 1, [], [firstAxis, secondAxis], [])
}

fn autogradReshape(x: int, shape: [int]) -> int {
    let output = tensorReshape(tensorCopy(autogradValue(x)), shape)
    var inputShape: [int] = []
    for i in 0..autogradValue(x).shape.len() { inputShape.push(autogradValue(x).shape[i]) }
    return record(output, operationReshape, x, 0 - 1, [], inputShape, [])
}

fn autogradSlice(x: int, dimension: int, start: int, stop: int) -> int {
    let output = tensorCopy(tensorSlice(autogradValue(x), dimension, start, stop))
    return record(output, operationSlice, x, 0 - 1, [], [dimension, start, stop, autogradValue(x).shape[dimension]], [])
}

fn autogradCast(x: int, targetDtype: DType) -> int {
    let sourceDtype = autogradValue(x).dtype
    let output = tensorCast(autogradValue(x), targetDtype)
    var fromComplex = 0
    if dtypeIsComplex(sourceDtype) { fromComplex = 1 }
    return record(output, operationCast, x, 0 - 1, [], [fromComplex], [])
}

fn autogradExpand(x: int, shape: [int]) -> int {
    let output = tensorCopy(tensorExpand(autogradValue(x), shape))
    var inputShape: [int] = []
    for i in 0..autogradValue(x).shape.len() { inputShape.push(autogradValue(x).shape[i]) }
    return record(output, operationExpand, x, 0 - 1, [], inputShape, [])
}

// ---- the reverse pass ------------------------------------------------------

fn realDtypeOf(tensor: Tensor) -> DType {
    if dtypeIsComplex(tensor.dtype) { return dtypeComponent(tensor.dtype) }
    return tensor.dtype
}

// Scatter-add rather than scatter-copy: index_select may repeat an index, and
// each occurrence contributes. tensorIndexCopy deliberately refuses duplicates,
// so it cannot be reused here.
var scatterHook: [fn(Tensor, int, int, [int]) -> Tensor] = []

fn scatterAdd(gradient: Tensor, dimension: int, outputExtent: int, indices: [int]) -> Tensor {
    if scatterHook.len() > 0 {
        let hook = scatterHook[0]
        return hook(gradient, dimension, outputExtent, indices)
    }
    return scatterAddCpu(gradient, dimension, outputExtent, indices)
}

fn scatterAddCpu(gradient: Tensor, dimension: int, outputExtent: int, indices: [int]) -> Tensor {
    var outputShape: [int] = []
    for i in 0..gradient.shape.len() { outputShape.push(gradient.shape[i]) }
    outputShape[dimension] = outputExtent
    let output = tensorZeros(gradient.dtype, outputShape)
    if tensorElementCount(gradient) == 0 { return output }
    var index = indexZeros(gradient.shape.len())
    var more = true
    while more {
        var destinationIndex: [int] = []
        for i in 0..index.len() { destinationIndex.push(index[i]) }
        destinationIndex[dimension] = indices[index[dimension]]
        if dtypeIsComplex(gradient.dtype) {
            tensorSetComplex(output, destinationIndex, tensorGetReal(output, destinationIndex) + tensorGetReal(gradient, index), tensorGetImaginary(output, destinationIndex) + tensorGetImaginary(gradient, index))
        } else {
            tensorSet(output, destinationIndex, tensorGet(output, destinationIndex) + tensorGet(gradient, index))
        }
        more = indexNext(index, gradient.shape)
    }
    return output
}

fn padSliceGradient(gradient: Tensor, dimension: int, start: int, outputExtent: int) -> Tensor {
    var outputShape: [int] = []
    for i in 0..gradient.shape.len() { outputShape.push(gradient.shape[i]) }
    outputShape[dimension] = outputExtent
    let output = tensorZeros(gradient.dtype, outputShape)
    if tensorElementCount(gradient) == 0 { return output }
    var index = indexZeros(gradient.shape.len())
    var more = true
    while more {
        var destinationIndex: [int] = []
        for i in 0..index.len() { destinationIndex.push(index[i]) }
        destinationIndex[dimension] = start + index[dimension]
        if dtypeIsComplex(gradient.dtype) {
            tensorSetComplex(output, destinationIndex, tensorGetReal(gradient, index), tensorGetImaginary(gradient, index))
        } else {
            tensorSet(output, destinationIndex, tensorGet(gradient, index))
        }
        more = indexNext(index, gradient.shape)
    }
    return output
}

fn backwardNode(node: ANode, gradient: Tensor) {
    let firstOperand = node.a
    let secondOperand = node.b

    if node.op == operationAdd {
        if firstOperand >= 0 { accumulate(firstOperand, reduceToShape(gradient, autogradValue(firstOperand).shape)) }
        if secondOperand >= 0 { accumulate(secondOperand, reduceToShape(gradient, autogradValue(secondOperand).shape)) }
        return
    }
    if node.op == operationSubtract {
        if firstOperand >= 0 { accumulate(firstOperand, reduceToShape(gradient, autogradValue(firstOperand).shape)) }
        if secondOperand >= 0 { accumulate(secondOperand, reduceToShape(tensorNegate(gradient), autogradValue(secondOperand).shape)) }
        return
    }
    if node.op == operationMultiply {
        let x = savedGet(node.saved[0])
        let y = savedGet(node.saved[1])
        if firstOperand >= 0 {
            var firstGradient = tensorMultiply(gradient, y)
            if dtypeIsComplex(y.dtype) { firstGradient = tensorMultiply(gradient, tensorConjugate(y)) }
            accumulate(firstOperand, reduceToShape(firstGradient, x.shape))
        }
        if secondOperand >= 0 {
            var secondGradient = tensorMultiply(gradient, x)
            if dtypeIsComplex(x.dtype) { secondGradient = tensorMultiply(gradient, tensorConjugate(x)) }
            accumulate(secondOperand, reduceToShape(secondGradient, y.shape))
        }
        return
    }
    if node.op == operationDivide {
        let y = savedGet(node.saved[0])
        let output = savedGet(node.saved[1])
        var yConjugate = y
        if dtypeIsComplex(y.dtype) { yConjugate = tensorConjugate(y) }
        if firstOperand >= 0 { accumulate(firstOperand, reduceToShape(tensorDivide(gradient, yConjugate), autogradValue(firstOperand).shape)) }
        if secondOperand >= 0 {
            var outputConjugate = output
            if dtypeIsComplex(output.dtype) { outputConjugate = tensorConjugate(output) }
            accumulate(secondOperand, reduceToShape(tensorNegate(tensorDivide(tensorMultiply(gradient, outputConjugate), yConjugate)), y.shape))
        }
        return
    }
    if node.op == operationNegate { accumulate(firstOperand, tensorNegate(gradient))
        return }
    if node.op == operationMatmul {
        let x = savedGet(node.saved[0])
        let y = savedGet(node.saved[1])
        if firstOperand >= 0 {
            var yTransposed = tensorCopy(tensorTranspose(y, 0, 1))
            if dtypeIsComplex(y.dtype) { yTransposed = tensorConjugateTranspose(y) }
            accumulate(firstOperand, tensorMatmul(gradient, yTransposed))
        }
        if secondOperand >= 0 {
            var xTransposed = tensorCopy(tensorTranspose(x, 0, 1))
            if dtypeIsComplex(x.dtype) { xTransposed = tensorConjugateTranspose(x) }
            accumulate(secondOperand, tensorMatmul(xTransposed, gradient))
        }
        return
    }
    if node.op == operationBiasTanh {
        let gradients = tensorBiasTanhBackward(savedGet(node.saved[0]), gradient)
        accumulate(firstOperand, gradients[0])
        accumulate(secondOperand, gradients[1])
        return
    }
    if node.op == operationGivens {
        let stateValue = savedGet(node.saved[0])
        let angleValue = savedGet(node.saved[1])
        let gradients = tensorGivensBackward(stateValue, angleValue, gradient, node.integerAttributes[0])
        accumulate(firstOperand, gradients[0])
        accumulate(secondOperand, gradients[1])
        return
    }
    if node.op == operationTanh {
        let output = savedGet(node.saved[0])
        accumulate(firstOperand, tensorMultiply(gradient, tensorSubtract(tensorOnes(output.dtype, output.shape), tensorMultiply(output, output))))
        return
    }
    if node.op == operationCos {
        accumulate(firstOperand, tensorNegate(tensorMultiply(gradient, tensorSin(savedGet(node.saved[0])))))
        return
    }
    if node.op == operationSin {
        accumulate(firstOperand, tensorMultiply(gradient, tensorCos(savedGet(node.saved[0]))))
        return
    }
    if node.op == operationLn {
        accumulate(firstOperand, tensorDivide(gradient, savedGet(node.saved[0])))
        return
    }
    if node.op == operationExp {
        accumulate(firstOperand, tensorMultiply(gradient, savedGet(node.saved[0])))
        return
    }
    if node.op == operationSumDimension {
        accumulate(firstOperand, tensorCopy(tensorExpand(gradient, autogradValue(firstOperand).shape)))
        return
    }
    if node.op == operationSumAll {
        let full = tensorZeros(gradient.dtype, node.integerAttributes)
        var index = indexZeros(node.integerAttributes.len())
        var more = tensorElementCount(full) > 0
        while more {
            if dtypeIsComplex(gradient.dtype) {
                tensorSetComplex(full, index, tensorGetReal(gradient, [0]), tensorGetImaginary(gradient, [0]))
            } else {
                tensorSet(full, index, tensorGet(gradient, [0]))
            }
            more = indexNext(index, node.integerAttributes)
        }
        accumulate(firstOperand, full)
        return
    }
    if node.op == operationMeanAll {
        let full = tensorZeros(gradient.dtype, node.integerAttributes)
        let size = tensorElementCount(full)
        var index = indexZeros(node.integerAttributes.len())
        var more = size > 0
        while more {
            if dtypeIsComplex(gradient.dtype) {
                tensorSetComplex(full, index, tensorGetReal(gradient, [0]) / (size as float), tensorGetImaginary(gradient, [0]) / (size as float))
            } else {
                tensorSet(full, index, tensorGet(gradient, [0]) / (size as float))
            }
            more = indexNext(index, node.integerAttributes)
        }
        accumulate(firstOperand, full)
        return
    }
    if node.op == operationAbs2 {
        // the convention's defining case: a unit upstream gradient gives 2z
        let z = savedGet(node.saved[0])
        let doubledGradient = tensorCast(tensorMultiply(gradient, tensorFull(gradient.dtype, [], 2.0)), z.dtype)
        accumulate(firstOperand, tensorMultiply(z, doubledGradient))
        return
    }
    if node.op == operationConjugate { accumulate(firstOperand, tensorConjugate(gradient))
        return }
    if node.op == operationReal {
        accumulate(firstOperand, tensorComplex(gradient, tensorZeros(gradient.dtype, gradient.shape), autogradValue(firstOperand).dtype))
        return
    }
    if node.op == operationImaginary {
        accumulate(firstOperand, tensorComplex(tensorZeros(gradient.dtype, gradient.shape), gradient, autogradValue(firstOperand).dtype))
        return
    }
    if node.op == operationExpImaginary {
        // z = exp(i*t); dz/dt = i*z, so dL/dt = Re(conj(g) * i * z)
        let z = savedGet(node.saved[0])
        accumulate(firstOperand, tensorSubtract(tensorMultiply(tensorImaginary(gradient), tensorReal(z)), tensorMultiply(tensorReal(gradient), tensorImaginary(z))))
        return
    }
    if node.op == operationComplex {
        if firstOperand >= 0 { accumulate(firstOperand, tensorReal(gradient)) }
        if secondOperand >= 0 { accumulate(secondOperand, tensorImaginary(gradient)) }
        return
    }
    if node.op == operationConcat {
        let dimension = node.integerAttributes[0]
        let firstExtent = node.integerAttributes[1]
        let secondExtent = node.integerAttributes[2]
        if firstOperand >= 0 { accumulate(firstOperand, tensorCopy(tensorSlice(gradient, dimension, 0, firstExtent))) }
        if secondOperand >= 0 { accumulate(secondOperand, tensorCopy(tensorSlice(gradient, dimension, firstExtent, firstExtent + secondExtent))) }
        return
    }
    if node.op == operationIndexSelect {
        let dimension = node.integerAttributes[0]
        let size = node.integerAttributes[1]
        var indices: [int] = []
        for i in 2..node.integerAttributes.len() { indices.push(node.integerAttributes[i]) }
        accumulate(firstOperand, scatterAdd(gradient, dimension, size, indices))
        return
    }
    if node.op == operationRoll {
        accumulate(firstOperand, tensorRoll(gradient, node.integerAttributes[0], 0 - node.integerAttributes[1]))
        return
    }
    if node.op == operationTranspose {
        accumulate(firstOperand, tensorCopy(tensorTranspose(gradient, node.integerAttributes[0], node.integerAttributes[1])))
        return
    }
    if node.op == operationReshape {
        accumulate(firstOperand, tensorReshape(tensorCopy(gradient), node.integerAttributes))
        return
    }
    if node.op == operationSlice {
        accumulate(firstOperand, padSliceGradient(gradient, node.integerAttributes[0], node.integerAttributes[1], node.integerAttributes[3]))
        return
    }
    if node.op == operationCast {
        if node.integerAttributes[0] == 1 { panic("autograd: no gradient path out of a complex-to-real cast") }
        // The forward was real-to-something. If that something was complex the
        // upstream gradient is complex and its real part is what flows back;
        // if the cast was degenerate -- the same dtype on both sides, which is
        // legal and which tensorCast happily performs -- the gradient is already
        // real and taking its real part panics. An earlier version did that
        // unconditionally, and a same-dtype cast crashed the backward pass.
        if dtypeIsComplex(gradient.dtype) {
            accumulate(firstOperand, tensorReal(gradient))
        } else {
            accumulate(firstOperand, gradient)
        }
        return
    }
    if node.op == operationExpand {
        accumulate(firstOperand, reduceToShape(gradient, node.integerAttributes))
        return
    }
    panic("autograd: no VJP for this opcode")
}

// Nodes are appended in forward order and every input handle is strictly
// smaller than its output's, so one descending sweep visits each node after
// all of its consumers. No topological sort is needed.
fn autogradBackward(loss: int) {
    if tapeConsumed { panic("autograd: tape already consumed; reset before differentiating again") }
    if loss < 0 or loss >= tapeVariables.len() { panic("autograd: bad loss handle") }
    if tensorElementCount(autogradValue(loss)) != 1 { panic("autograd: loss must be a single element") }
    if not tapeVariables[loss].requiresGradient { panic("autograd: loss does not depend on anything requiring a gradient") }
    tapeConsumed = true
    let seed = tensorOnes(autogradValue(loss).dtype, autogradValue(loss).shape)
    accumulate(loss, seed)
    var variableIndex = tapeVariables.len() - 1
    while variableIndex >= 0 {
        let variable = tapeVariables[variableIndex]
        if variable.node >= 0 and variable.hasGradient and variable.requiresGradient {
            backwardNode(tapeNodes[variable.node], variable.g)
        }
        variableIndex -= 1
    }
}
