// Phase Reasoner v1, forward only. Real/complex component dtypes must match.
import "ml/ops.zeph"

struct PhaseConfig {
    inputVocab: int,
    outputVocab: int,
    stateDimension: int,
    embeddingDimension: int,
    hiddenDimension: int,
    thinkSteps: int,
    padToken: int,
    epsilon: float,
}

struct PhaseParams {
    config: PhaseConfig,
    embedding: Tensor,
    think: Tensor,
    hiddenWeight: Tensor,
    hiddenBias: Tensor,
    angleWeight: Tensor,
    angleBias: Tensor,
    initialState: Tensor,
    readoutMatrix: Tensor,
}

// Diagnostics are the actual intermediates used by the update, never recomputed.
struct PhaseStep {
    active: [int],
    features: Tensor,
    hidden: Tensor,
    angles: Tensor,
    phased: Tensor,
    even: Tensor,
    odd: Tensor,
}

struct PhaseResult {
    initial: Tensor,
    state: Tensor,
    probabilities: Tensor,
    steps: [PhaseStep],
    trajectory: [Tensor],
}

fn phaseIsFinite(value: float) -> bool { return value == value and fabs(value) != infinity }

// Reject malformed public parameters before any sequence work or allocation.
fn phaseValidate(parameters: PhaseParams) {
    let config = parameters.config
    if config.stateDimension < 2 or config.stateDimension % 2 != 0 { panic("phase: stateDimension must be positive and even") }
    if config.inputVocab < 1 or config.outputVocab < 1 or config.embeddingDimension < 1 or config.hiddenDimension < 1 or config.thinkSteps < 0 { panic("phase: invalid dimensions or THINK count") }
    if config.padToken < 0 or config.padToken >= config.inputVocab or not phaseIsFinite(config.epsilon) or config.epsilon <= 0.0 { panic("phase: invalid PAD or epsilon") }
    if not dtypeIsComplex(parameters.initialState.dtype) { panic("phase: complex initial state required") }
    let realDtype = dtypeComponent(parameters.initialState.dtype)
    let tensors = [parameters.embedding, parameters.think, parameters.hiddenWeight, parameters.hiddenBias, parameters.angleWeight, parameters.angleBias, parameters.initialState, parameters.readoutMatrix]
    let shapes = [[config.inputVocab, config.embeddingDimension], [config.embeddingDimension], [config.hiddenDimension, config.embeddingDimension + 3 * config.stateDimension], [config.hiddenDimension], [3 * config.stateDimension, config.hiddenDimension], [3 * config.stateDimension], [config.stateDimension], [config.outputVocab, config.stateDimension]]
    for i in 0..tensors.len() {
        let tensor = tensors[i]
        var expectedDtype = realDtype
        if i >= 6 { expectedDtype = parameters.initialState.dtype }
        if tensor.dtype != expectedDtype or not shapesEqual(tensor.shape, shapes[i]) { panic("phase: parameter shape or dtype mismatch") }
        var index = indexZeros(tensor.shape.len())
        var more = tensorElementCount(tensor) > 0
        while more {
            if dtypeIsComplex(tensor.dtype) {
                if not phaseIsFinite(tensorGetReal(tensor, index)) or not phaseIsFinite(tensorGetImaginary(tensor, index)) { panic("phase: nonfinite parameter") }
            } else {
                if not phaseIsFinite(tensorGet(tensor, index)) { panic("phase: nonfinite parameter") }
            }
            more = indexNext(index, tensor.shape)
        }
    }
}

// Normalize the learned state once, then broadcast an independent batch copy.
fn phaseInitial(parameters: PhaseParams, batch: int) -> Tensor {
    phaseValidate(parameters)
    if batch < 1 { panic("phase: empty batch") }
    let norm = sqrt(tensorSumAll(tensorAbs2(parameters.initialState)))
    if not phaseIsFinite(norm) or norm == 0.0 { panic("phase: initial norm must be finite and nonzero") }
    let normalized = tensorMultiply(parameters.initialState, tensorFull(parameters.initialState.dtype, [], 1.0 / norm))
    return tensorCopy(tensorExpand(normalized, [batch, parameters.config.stateDimension]))
}

// Cyclic neighbor products preserve global phase but expose relative phase.
fn phaseFeatures(state: Tensor) -> Tensor {
    if state.shape.len() != 2 { panic("phaseFeatures: expected [B,stateDimension]") }
    let neighbor = tensorMultiply(tensorConjugate(state), tensorRoll(state, 1, 0 - 1))
    return tensorConcat(tensorConcat(tensorAbs2(state), tensorReal(neighbor), 1), tensorImaginary(neighbor), 1)
}

// Each stage gathers both old pair values before either scatter writes.
fn phaseGivens(state: Tensor, theta: Tensor, phi: Tensor, stage: int) -> Tensor {
    let width = state.shape[1]
    if width < 2 or width % 2 != 0 or stage < 0 or stage > 1 { panic("phaseGivens: invalid dimension or stage") }
    var left: [int] = []
    var right: [int] = []
    for j in 0..(width / 2) {
        left.push(2 * j + stage)
        right.push((2 * j + stage + 1) % width)
    }
    let pairFirst = tensorIndexSelect(state, 1, left)
    let pairSecond = tensorIndexSelect(state, 1, right)
    let cosTheta = tensorCast(tensorCos(theta), state.dtype)
    let sinTheta = tensorCast(tensorSin(theta), state.dtype)
    let phase = tensorExpImaginary(phi, state.dtype)
    let newPairFirst = tensorAdd(tensorMultiply(cosTheta, pairFirst), tensorMultiply(sinTheta, tensorMultiply(phase, pairSecond)))
    let newPairSecond = tensorAdd(tensorNegate(tensorMultiply(sinTheta, tensorMultiply(tensorConjugate(phase), pairFirst))), tensorMultiply(cosTheta, pairSecond))
    let output = tensorCopy(state)
    tensorIndexCopy(output, 1, left, newPairFirst)
    tensorIndexCopy(output, 1, right, newPairSecond)
    return output
}

// All 3D angles are computed once from the pre-update state.
fn phaseUpdateTrace(parameters: PhaseParams, state: Tensor, embedding: Tensor) -> PhaseStep {
    let width = parameters.config.stateDimension
    if state.shape.len() != 2 or state.shape[1] != width or state.dtype != parameters.initialState.dtype { panic("phaseUpdate: invalid state") }
    if not shapesEqual(embedding.shape, [state.shape[0], parameters.config.embeddingDimension]) { panic("phaseUpdate: invalid embedding") }
    let features = phaseFeatures(state)
    let inputs = tensorConcat(embedding, features, 1)
    let hidden = tensorTanh(tensorAdd(tensorMatmul(inputs, tensorTranspose(parameters.hiddenWeight, 0, 1)), parameters.hiddenBias))
    let bounded = tensorTanh(tensorAdd(tensorMatmul(hidden, tensorTranspose(parameters.angleWeight, 0, 1)), parameters.angleBias))
    let angles = tensorMultiply(bounded, tensorFull(bounded.dtype, [], pi))
    let phased = tensorMultiply(state, tensorExpImaginary(tensorSlice(angles, 1, 0, width), state.dtype))
    let even = phaseGivens(phased, tensorSlice(angles, 1, width, width + width / 2), tensorSlice(angles, 1, width + width / 2, 2 * width), 0)
    let odd = phaseGivens(even, tensorSlice(angles, 1, 2 * width, 2 * width + width / 2), tensorSlice(angles, 1, 2 * width + width / 2, 3 * width), 1)
    var active: [int] = []
    return PhaseStep{active: active, features: features, hidden: hidden, angles: angles, phased: phased, even: even, odd: odd}
}

fn phaseUpdate(parameters: PhaseParams, state: Tensor, embedding: Tensor) -> Tensor {
    return phaseUpdateTrace(parameters, state, embedding).odd
}

// fln's normal-number implementation needs explicit scaling for subnormals.
fn phaseLogPositive(value: float) -> float {
    if value > 0.0 and value < floatFromBits(1 << 52) { return fln(value * 4503599627370496.0) - 52.0 * ln2 }
    return fln(value)
}

// Finite or negative-infinity inputs; used for epsilon addition and logsumexp.
fn phaseLogAdd(left: float, right: float) -> float {
    if left == 0.0 - infinity { return right }
    if right == 0.0 - infinity { return left }
    var larger = left
    var smaller = right
    if right > left {
        larger = right
        smaller = left
    }
    return larger + fln(1.0 + fexp(smaller - larger))
}

// Stable log(|a|^2 + eps), avoiding overflow even when |a|^2 cannot fit.
fn phaseReadout(parameters: PhaseParams, state: Tensor) -> Tensor {
    let amplitudes = tensorMatmul(state, tensorTranspose(parameters.readoutMatrix, 0, 1))
    let logs = tensorZeros(dtypeComponent(state.dtype), amplitudes.shape)
    let output = tensorZeros(logs.dtype, amplitudes.shape)
    for row in 0..amplitudes.shape[0] {
        var total = 0.0 - infinity
        for j in 0..amplitudes.shape[1] {
            let realMagnitude = fabs(tensorGetReal(amplitudes, [row, j]))
            let imaginaryMagnitude = fabs(tensorGetImaginary(amplitudes, [row, j]))
            if not phaseIsFinite(realMagnitude) or not phaseIsFinite(imaginaryMagnitude) { panic("phase: nonfinite readout amplitude") }
            var scale = realMagnitude
            if imaginaryMagnitude > scale { scale = imaginaryMagnitude }
            var weight = 0.0 - infinity
            if scale > 0.0 {
                let scaledReal = realMagnitude / scale
                let scaledImaginary = imaginaryMagnitude / scale
                weight = 2.0 * phaseLogPositive(scale) + fln(scaledReal * scaledReal + scaledImaginary * scaledImaginary)
            }
            let smoothed = phaseLogAdd(weight, phaseLogPositive(parameters.config.epsilon))
            tensorSet(logs, [row, j], smoothed)
            total = phaseLogAdd(total, smoothed)
        }
        for j in 0..amplitudes.shape[1] { tensorSet(output, [row, j], fexp(tensorGet(logs, [row, j]) - total)) }
    }
    return output
}

// Integer [B,T] tokens; PAD rows never enter the controller. THINK runs thinkSteps times.
// Set record=true for diagnostics; no trajectory is retained otherwise.
fn phaseForward(parameters: PhaseParams, tokens: Tensor, record: bool) -> PhaseResult {
    if tokens.shape.len() != 2 or tokens.shape[0] == 0 { panic("phase: tokens must be nonempty [B,T]") }
    if tokens.dtype != DType.I32 and tokens.dtype != DType.I64 { panic("phase: integer tokens required") }
    let batch = tokens.shape[0]
    let length = tokens.shape[1]
    for row in 0..batch {
        for step in 0..length {
            let token = tensorGetInt(tokens, [row, step])
            if token < 0 or token >= parameters.config.inputVocab { panic("phase: token outside vocabulary") }
        }
    }
    let initial = phaseInitial(parameters, batch)
    var state = initial
    var steps: [PhaseStep] = []
    var trajectory: [Tensor] = []
    if record { trajectory.push(initial) }
    for step in 0..(length + parameters.config.thinkSteps) {
        var active: [int] = []
        var tokenIds: [int] = []
        for row in 0..batch {
            if step >= length {
                active.push(row)
            } else {
                let token = tensorGetInt(tokens, [row, step])
                if token != parameters.config.padToken {
                    active.push(row)
                    tokenIds.push(token)
                }
            }
        }
        var embedding = tensorExpand(parameters.think, [active.len(), parameters.config.embeddingDimension])
        if step < length { embedding = tensorIndexSelect(parameters.embedding, 0, tokenIds) }
        let update = phaseUpdateTrace(parameters, tensorIndexSelect(state, 0, active), embedding)
        update.active = active
        state = tensorCopy(state)
        tensorIndexCopy(state, 0, active, update.odd)
        if record {
            steps.push(update)
            trajectory.push(state)
        }
    }
    return PhaseResult{initial: initial, state: state, probabilities: phaseReadout(parameters, state), steps: steps, trajectory: trajectory}
}
