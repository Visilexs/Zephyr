// a VkClearValue is a bare union of four floats
fn clearColor(red: float, green: float, blue: float, alpha: float) -> Bytes {
    var color = Bytes.new(16)
    color.putFloat32(0, red)
    color.putFloat32(4, green)
    color.putFloat32(8, blue)
    color.putFloat32(12, alpha)
    return color
}
