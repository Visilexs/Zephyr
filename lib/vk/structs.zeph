// a VkClearValue is a bare union of four floats
fn clear_color(r: float, g: float, b: float, a: float) -> Bytes {
    var c = Bytes.new(16)
    c.putf32(0, r)
    c.putf32(4, g)
    c.putf32(8, b)
    c.putf32(12, a)
    return c
}
