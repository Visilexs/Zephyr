fn createBuffer(device: int, createInfo: VkBufferCreateInfo) -> int {
    var handleOutput = vulkanOutput(8)
    checkVulkanResult(vkCreateBuffer(device, createInfo.addr(), 0, handleOutput.addr()), "vkCreateBuffer")
    let handle = handleOutput.get64(0)
    freeVulkanOutput(handleOutput)
    return handle
}

