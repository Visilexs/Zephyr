fn create_buffer(dev: int, ci: VkBufferCreateInfo) -> int {
    var p = vk_output(8)
    vkcheck(vkCreateBuffer(dev, ci.addr(), 0, p.addr()), "vkCreateBuffer")
    let handle = p.get64(0)
    vk_free_output(p)
    return handle
}

