// A minimal Win32 window for Vulkan presentation.
//
// There is no window procedure written in Zephyr: the class installs the
// address of user32's own DefWindowProcA, and the app polls messages with
// PeekMessageA. That sidesteps needing to hand a native callback back to the
// OS -- Vulkan never calls us, so nothing here needs a thunk.

import "std/bytes.zeph"
import "vk/raw.zeph"

extern fn GetModuleHandleA(name: int) -> int from "kernel32.dll"
extern fn RegisterClassA(windowClassInfo: int) -> int from "user32.dll"
extern fn CreateWindowExA(extendedStyle: int, className: int, title: int, style: int, x: int, y: int, width: int, height: int, parent: int, menu: int, hinstance: int, param: int) -> int from "user32.dll"
extern fn ShowWindow(hwnd: int, showCommand: int) -> i32 from "user32.dll"
extern fn DestroyWindow(hwnd: int) -> i32 from "user32.dll"
extern fn PeekMessageA(message: int, hwnd: int, filterMin: int, filterMax: int, remove: int) -> i32 from "user32.dll"
extern fn TranslateMessage(message: int) -> i32 from "user32.dll"
extern fn DispatchMessageA(message: int) -> int from "user32.dll"
extern fn IsWindow(hwnd: int) -> i32 from "user32.dll"
extern fn GetClientRect(hwnd: int, rect: int) -> i32 from "user32.dll"
extern fn LoadCursorA(hinstance: int, name: int) -> int from "user32.dll"
extern fn GetAsyncKeyState(key: int) -> i32 from "user32.dll"
// No arguments; the FFI needs one, and a spare register argument is harmless on Win64.
extern fn GetForegroundWindow(unused: int) -> int from "user32.dll"

struct Window {
    hwnd: int,
    hinstance: int,
    message: Bytes,        // MSG scratch, reused every poll
    rect: Bytes,
    windowClass: Bytes,        // WNDCLASSA and the class name must outlive the window
    name: Bytes
}

// WNDCLASSA on x64: style 0, lpfnWndProc 8, cbClsExtra 16, cbWndExtra 20,
// hInstance 24, hIcon 32, hCursor 40, hbrBackground 48, lpszMenuName 56,
// lpszClassName 64  (size 72)
fn openWindow(title: str, width: int, height: int) -> Window {
    let hinstance = GetModuleHandleA(0)
    // LoadLibraryA, not GetModuleHandleA: every user32 entry point here is
    // resolved lazily through `extern fn`, so user32 may not be mapped yet and
    // GetModuleHandleA would hand back 0.
    // Both names are bound to locals first. `cbytes(x).addr()` hands out the
    // address of a temporary whose last reference dies with the expression, so
    // reference counting frees the buffer before the call reads it -- it only
    // appeared to work when nothing else had allocated yet and the freed block
    // still held its bytes.
    var user32Name = cString("user32.dll")
    let user32Module = win("LoadLibraryA", user32Name.addr())
    if user32Module == 0 { panic("could not load user32.dll") }
    // the window procedure is user32's own default handler
    var defaultProcName = cString("DefWindowProcA")
    let defaultWindowProc = win("GetProcAddress", user32Module, defaultProcName.addr())
    if defaultWindowProc == 0 { panic("could not resolve DefWindowProcA") }

    var className = cString("zephyrVulkanWindow")
    var windowClassBytes = Bytes.new(72)
    windowClassBytes.put32(0, 3)                            // CS_HREDRAW | CS_VREDRAW
    windowClassBytes.put64(8, defaultWindowProc)
    windowClassBytes.put64(24, hinstance)
    windowClassBytes.put64(40, LoadCursorA(0, 32512))       // IDC_ARROW
    windowClassBytes.put64(64, className.addr())
    if RegisterClassA(windowClassBytes.addr()) == 0 { panic("RegisterClassA failed") }

    var titleBytes = cString(title)
    // WS_OVERLAPPEDWINDOW | WS_VISIBLE
    let hwnd = CreateWindowExA(0, className.addr(), titleBytes.addr(), 282001408,
                               120, 90, width, height, 0, 0, hinstance, 0)
    if hwnd == 0 { panic("CreateWindowExA failed") }
    let showResult = ShowWindow(hwnd, 5)
    return Window{hwnd: hwnd, hinstance: hinstance, message: vulkanOutput(64),
                  rect: vulkanOutput(16), windowClass: windowClassBytes, name: className}
}

impl Window {
    // Drain the queue; false once the window is gone or Esc is pressed while
    // it has focus (GetAsyncKeyState is global: Esc in another app must not quit).
    fn poll(self) -> bool {
        while PeekMessageA(self.message.addr(), 0, 0, 0, 1) != 0 {
            let messageId = self.message.get32(8)
            if messageId == 18 { return false }               // WM_QUIT
            let translated = TranslateMessage(self.message.addr())
            let dispatched = DispatchMessageA(self.message.addr())
        }
        if IsWindow(self.hwnd) == 0 { return false }
        if GetForegroundWindow(0) == self.hwnd and (GetAsyncKeyState(27) & 32768) != 0 { return false }   // VK_ESCAPE
        return true
    }

    fn width(self) -> int {
        let rectResult = GetClientRect(self.hwnd, self.rect.addr())
        return self.rect.get32(8)
    }
    fn height(self) -> int {
        let rectResult = GetClientRect(self.hwnd, self.rect.addr())
        return self.rect.get32(12)
    }
    fn close(self) {
        let destroyed = DestroyWindow(self.hwnd)
        freeVulkanOutput(self.message)
        freeVulkanOutput(self.rect)
    }
}
