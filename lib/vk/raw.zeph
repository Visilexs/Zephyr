// Raw Vulkan bindings: mechanical transcription, no opinions.
//
// Every parameter is `int` -- a handle, an address, or a scalar. Composite
// values never cross the boundary; they are laid into `Bytes` buffers by the
// caller (see std/bytes.zeph and the layout constants in vk/consts.zeph).
//
// On desktop Windows vulkan-1.dll exports all core 1.x entry points directly,
// so GetProcAddress resolves everything here. vkGetInstanceProcAddr is only
// required for extensions (debug messenger, surfaces) -- not needed yet.

import "vk/consts.zeph"

fn vkcheck(r: int, what: str) {
    // externs declared `-> i32` already sign-extend, so r is a true VkResult
    if r != VK_SUCCESS { panic("{what}: VkResult {r}") }
}

// A foreign function returning a 32-bit value leaves it in EAX, which the CPU
// zero-extends into RAX -- so a negative VkResult arrives as a large positive
// number. Sign-extend it before comparing against the VK_ERROR_* constants.
fn i32(v: int) -> int {
    if v >= 2147483648 { return v - 4294967296 }
    return v
}

// ---- instance ----
extern fn vkEnumerateInstanceVersion(pApiVersion: int) -> i32 from "vulkan-1.dll"
extern fn vkEnumerateInstanceLayerProperties(pCount: int, pProps: int) -> i32 from "vulkan-1.dll"
extern fn vkEnumerateInstanceExtensionProperties(pLayerName: int, pCount: int, pProps: int) -> i32 from "vulkan-1.dll"
extern fn vkCreateInstance(pCreateInfo: int, pAllocator: int, pInstance: int) -> i32 from "vulkan-1.dll"
extern fn vkDestroyInstance(instance: int, pAllocator: int) from "vulkan-1.dll"

