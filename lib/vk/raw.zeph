// ---- WSI: surface + swapchain ----
// The Windows loader exports these directly, so GetProcAddress resolves them
// without going through vkGetInstanceProcAddr.
extern fn vkCreateWin32SurfaceKHR(instance: int, pCreateInfo: int, pAllocator: int, pSurface: int) -> i32 from "vulkan-1.dll"
extern fn vkDestroySurfaceKHR(instance: int, surface: int, pAllocator: int) from "vulkan-1.dll"
