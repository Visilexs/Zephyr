extern fn vkGetPhysicalDeviceSurfaceCapabilitiesKHR(physicalDevice: int, surface: int, pCaps: int) -> i32 from "vulkan-1.dll"
extern fn vkGetPhysicalDeviceSurfaceFormatsKHR(physicalDevice: int, surface: int, pCount: int, pFormats: int) -> i32 from "vulkan-1.dll"
extern fn vkGetPhysicalDeviceSurfacePresentModesKHR(physicalDevice: int, surface: int, pCount: int, pModes: int) -> i32 from "vulkan-1.dll"
extern fn vkCreateSwapchainKHR(device: int, pCreateInfo: int, pAllocator: int, pSwapchain: int) -> i32 from "vulkan-1.dll"
extern fn vkDestroySwapchainKHR(device: int, swapchain: int, pAllocator: int) from "vulkan-1.dll"
extern fn vkGetSwapchainImagesKHR(device: int, swapchain: int, pCount: int, pImages: int) -> i32 from "vulkan-1.dll"
extern fn vkAcquireNextImageKHR(device: int, swapchain: int, timeout: int, semaphore: int, fence: int, pImageIndex: int) -> i32 from "vulkan-1.dll"
extern fn vkQueuePresentKHR(queue: int, pPresentInfo: int) -> i32 from "vulkan-1.dll"
