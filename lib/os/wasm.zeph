// lib/os/wasm.zeph -- the kernel32 surface runtime.zeph uses, on top of a wasm
// linear memory. Merged ahead of runtime.zeph by `zc --wasm --rt`, which rewrites
// every win("Foo", ...) in the runtime into a call to kernel32Foo(...). The GC, the
// string machinery and the collections compile unchanged for all three targets.
//
// Nothing here may allocate: runtimeInitializeHeap calls kernel32VirtualAlloc before the GC heap
// exists, so these functions use raw loads/stores and growMemory only.

// The compiler writes three constants into the first words of linear memory,
// because only it knows where the data segment and globals block ended:
// [8] heap base, [16] stack bottom, [24] stack top. The heap base is page
// aligned and equals the initial memory size, so no memory.size query is needed.
let wasmHeap = 8
let wasmStackBottom = 16
let wasmStackTop = 24

// Reserving address space is free on Windows and Linux. On wasm it is not:
// memory.grow only extends the end, so a committed region ABOVE a sparse one
// forces every page in between to exist. runtimeInitializeHeap reserves the 1 GiB heap
// first and its bitmaps second, which would mean 1 GiB of linear memory the
// moment a bitmap page is touched.
//
// Two adjustments, both confined to this file:
//   - every reserve is SCALED DOWN. The bitmap sizes the runtime derives from
//     runtimeHeapReserve scale by the same factor, so the arithmetic stays consistent
//     -- a 64 MiB heap needs exactly the 1 MiB bitmap that 16 MiB >> 4 gives.
//   - the first (largest) reserve is placed ABOVE a window kept for the later,
//     smaller ones, so the heap is the topmost region and nothing sparse sits
//     underneath a committed one.
// A commit that runs past its own region returns 0, which the runtime reports
// as "out of memory (commit)" rather than silently scribbling on the bitmaps.
let wasmOutsideHeap = 4194304            // 4 MiB for committed off-heap blocks
let wasmRegionShift = 4                   // reserves are scaled by 1/16
let wasmMaximumRegions = 8

var wasmSmallAllocationPointer = 0                    // small committed blocks, grows up
var wasmSmallAllocationBase = 0                  // window for the post-heap reserves
var wasmReservedHeap = 0                    // the heap region, above that window
var wasmMemoryEnd = 0                    // first address past what memory.grow gave us
var wasmRegionTable = 0                    // wasmMaximumRegions entries of (base, end)
var wasmRegionCount = 0

fn wasmInitialize() {
    if wasmSmallAllocationPointer != 0 { return }
    let heapBase = load64(wasmHeap)
    wasmMemoryEnd = heapBase
    wasmRegionTable = heapBase                 // carve the region table out by hand: calling
    wasmSmallAllocationPointer = heapBase + 16 * wasmMaximumRegions // kernel32VirtualAlloc here would recurse
    let memoryEnsured = wasmEnsure(wasmSmallAllocationPointer)
}

fn wasmRegionAdd(regionStart: int, size: int) {
    if wasmRegionCount >= wasmMaximumRegions { return }
    store64(wasmRegionTable + 16 * wasmRegionCount, regionStart)
    store64(wasmRegionTable + 16 * wasmRegionCount + 8, regionStart + size)
    wasmRegionCount += 1
}

// the end of the reserved region containing `base`, or 0 if it is in none
fn wasmRegionEnd(address: int) -> int {
    var index = 0
    while index < wasmRegionCount {
        let regionStart = load64(wasmRegionTable + 16 * index)
        let regionEnd = load64(wasmRegionTable + 16 * index + 8)
        if address >= regionStart and address < regionEnd { return regionEnd }
        index += 1
    }
    return 0
}

// Grow linear memory until `need` is a valid address to touch.
fn wasmEnsure(need: int) -> bool {
    wasmInitialize()
    if need <= wasmMemoryEnd { return true }
    let pages = (need - wasmMemoryEnd + 65535) / 65536
    if growMemory(pages) < 0 { return false }
    wasmMemoryEnd = wasmMemoryEnd + pages * 65536
    return true
}

// MEM_RESERVE=0x2000, MEM_COMMIT=0x1000. Reserving takes address space without
// growing memory, which is exactly what a wasm heap wants: the GC reserves a
// large region up front and only ever touches the part it has committed.
fn kernel32VirtualAlloc(base: int, byteCount: int, flags: int, protectionArgument: int) -> int {
    wasmInitialize()
    let wantCommit = (flags & 4096) != 0
    let wantReserve = (flags & 8192) != 0
    if wantReserve and not wantCommit {
        let want = byteCount >> wasmRegionShift
        if wasmReservedHeap == 0 {
            // the first reserve is the heap: park it above a window sized for
            // the bitmaps and worklist that runtimeInitializeHeap asks for next
            wasmSmallAllocationBase = load64(wasmHeap) + wasmOutsideHeap
            wasmReservedHeap = wasmSmallAllocationBase + (want >> 3)
            let allocationAddress = wasmReservedHeap
            wasmReservedHeap = wasmReservedHeap + want
            wasmRegionAdd(allocationAddress, want)
            return allocationAddress
        }
        let allocationAddress = wasmSmallAllocationBase
        if allocationAddress + want > load64(wasmHeap) + wasmOutsideHeap + (wasmReservedHeap - wasmSmallAllocationBase) { return 0 }
        wasmSmallAllocationBase = wasmSmallAllocationBase + want
        wasmRegionAdd(allocationAddress, want)
        return allocationAddress
    }
    if wantCommit and base != 0 {
        let regionEnd = wasmRegionEnd(base)
        if regionEnd != 0 and base + byteCount > regionEnd { return 0 }
        if not wasmEnsure(base + byteCount) { return 0 }
        return base
    }
    let allocationAddress = wasmSmallAllocationPointer
    if allocationAddress + byteCount > load64(wasmHeap) + wasmOutsideHeap { return 0 }
    wasmSmallAllocationPointer = wasmSmallAllocationPointer + byteCount
    if not wasmEnsure(allocationAddress + byteCount) { return 0 }
    return allocationAddress
}

// ---- console ----
//
// Output is buffered into linear memory and handed to the host one line at a
// time; the host import takes a (pointer, length) pair and decodes UTF-8.
fn kernel32GetStdHandle(which: int) -> int {
    if which == 0 - 12 { return 2 }
    return 1
}

fn kernel32WriteFile(handle: int, bytesAddress: int, byteCount: int, writtenCountAddress: int, overlapped: int) -> int {
    hostWrite(handle, bytesAddress, byteCount)
    if writtenCountAddress != 0 { store64(writtenCountAddress, byteCount) }
    return 1
}

fn kernel32ExitProcess(code: int) -> int {
    hostExit(code)
    return 0
}

// ---- files ----
//
// ponytail: no filesystem. readFile/writeFile panic rather than silently
// returning nothing; wire them to host imports if a wasm build ever needs them.
fn kernel32CreateFileA(cStringPointer: int, access: int, share: int, securityAttributes: int, creationDisposition: int, flags: int, templateHandle: int) -> int {
    return 0 - 1
}
fn kernel32GetFileSize(handle: int, highSizeAddress: int) -> int { return 0 }
fn kernel32ReadFile(handle: int, buffer: int, byteCount: int, readCountAddress: int, overlapped: int) -> int { return 0 }
fn kernel32CloseHandle(handle: int) -> int { return 1 }
fn kernel32GetFileAttributesA(cStringPointer: int) -> int { return 4294967295 }
fn kernel32GetModuleFileNameA(module: int, buffer: int, capacity: int) -> int { return 0 }

// The command line is a single NUL so runtimeArguments yields an empty argument list.
var wasmCommandLine = 0
fn kernel32GetCommandLineA() -> int {
    if wasmCommandLine == 0 {
        wasmCommandLine = kernel32VirtualAlloc(0, 16, 12288, 4)
        store8(wasmCommandLine, 0)
    }
    return wasmCommandLine
}

// ---- GC roots ----
//
// The shadow stack occupies a fixed window below the heap, and Zephyr frames
// live in it, so the conservative scan works here exactly as it does natively.
fn kernel32GetCurrentThreadStackLimits(lowLimitAddress: int, highLimitAddress: int) -> int {
    store64(lowLimitAddress, load64(wasmStackBottom))
    store64(highLimitAddress, load64(wasmStackTop))
    return 0
}

// ---- threads ----
//
// ponytail: wasm without the threads proposal is single-threaded, so runtimeRegisteredThreadCount
// never rises and the lock and suspend paths are never reached.
fn kernel32GetCurrentThreadId() -> int { return 1 }
fn kernel32InitializeCriticalSection(address: int) -> int { return 0 }
fn kernel32EnterCriticalSection(address: int) -> int { return 0 }
fn kernel32LeaveCriticalSection(address: int) -> int { return 0 }
fn kernel32SuspendThread(handle: int) -> int { return 0 - 1 }
fn kernel32ResumeThread(handle: int) -> int { return 0 - 1 }
fn kernel32GetThreadContext(handle: int, context: int) -> int { return 0 }
fn kernel32RtlCaptureContext(contextAddress: int) -> int { return 0 }

var wasmThreadLocalStorage = 0
var wasmThreadLocalSlotCount = 0

fn kernel32TlsAlloc() -> int {
    if wasmThreadLocalStorage == 0 { wasmThreadLocalStorage = kernel32VirtualAlloc(0, 4096, 12288, 4) }
    let index = wasmThreadLocalSlotCount
    wasmThreadLocalSlotCount += 1
    return index
}

fn kernel32TlsSetValue(index: int, valueArgument: int) -> int {
    store64(wasmThreadLocalStorage + 8 * index, valueArgument)
    return 1
}

fn kernel32TlsGetValue(index: int) -> int {
    return load64(wasmThreadLocalStorage + 8 * index)
}
