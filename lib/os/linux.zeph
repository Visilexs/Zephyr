// lib/os/linux.zeph -- the kernel32 surface runtime.zeph uses, on top of Linux
// syscalls. Merged ahead of runtime.zeph by `zc --linux --rt`, which rewrites
// every win("Foo", ...) in the runtime into a call to kernel32Foo(...). The runtime,
// the GC and the string machinery are already platform-neutral and are compiled
// unchanged for both targets.
//
// Startup/GC shims must not allocate: runtimeInitializeHeap calls kernel32VirtualAlloc before
// the heap exists. They use raw syscalls, load*/store* and mmap only.
// Unsupported application-only operations may panic after runtime startup.

let systemCallRead = 0
let systemCallWrite = 1
let systemCallOpen = 2
let systemCallClose = 3
let systemCallSeekFile = 8
let systemCallMapMemory = 9
let systemCallProtectMemory = 10
let systemCallExitGroup = 231

let memoryProtectionNone = 0
let memoryProtectionReadWrite = 3
let mapAnonymousPrivate = 34          // MAP_PRIVATE | MAP_ANONYMOUS
let mapNoReservation = 16384

// mmap and friends report failure as a small negative value (-errno)
fn linuxFailed(result: int) -> bool {
    return result < 0 and result > 0 - 4096
}

fn linuxMapMemory(address: int, byteCount: int, protection: int, flags: int) -> int {
    let result = syscall(systemCallMapMemory, address, byteCount, protection, flags, 0 - 1, 0)
    if linuxFailed(result) { return 0 }
    return result
}

// ---- memory ----

// MEM_RESERVE=0x2000 MEM_COMMIT=0x1000. A reserve maps memoryProtectionNone address space
// (Linux overcommits, so this costs nothing); a later commit just mprotects it.
fn kernel32VirtualAlloc(base: int, byteCount: int, flags: int, protectionArgument: int) -> int {
    var protection = memoryProtectionReadWrite
    if protectionArgument == 64 { protection = 7 } // PAGE_EXECUTE_READWRITE
    let wantCommit = (flags & 4096) != 0
    let wantReserve = (flags & 8192) != 0
    if wantReserve and not wantCommit {
        return linuxMapMemory(base, byteCount, memoryProtectionNone, mapAnonymousPrivate + mapNoReservation)
    }
    if wantCommit and base != 0 {
        let result = syscall(systemCallProtectMemory, base, byteCount, protection)
        if linuxFailed(result) { return 0 }
        return base
    }
    // Keep allocation size in a preceding page for MEM_RELEASE (size == 0).
    if byteCount <= 0 or byteCount > 9223372036854771711 { return 0 }
    let mappingAddress = linuxMapMemory(0, byteCount + 4096, protection, mapAnonymousPrivate)
    if mappingAddress == 0 { return 0 }
    store64(mappingAddress, byteCount + 4096)
    return mappingAddress + 4096
}

// Release a committed allocation returned by VirtualAlloc above.
fn kernel32VirtualFree(memoryAddress: int, byteCount: int, freeFlags: int) -> int {
    if memoryAddress == 0 or freeFlags != 32768 { return 0 }
    let mappingAddress = memoryAddress - 4096
    if syscall(11, mappingAddress, load64(mappingAddress)) != 0 { return 0 }
    return 1
}

// ---- console and files ----

// Windows handles are opaque; on Linux we hand back the fd itself, so the
// runtime's WriteFile/ReadFile calls land on the right descriptor unchanged.
fn kernel32GetStdHandle(which: int) -> int {
    if which == 0 - 10 { return 0 }
    if which == 0 - 11 { return 1 }
    return 2
}

fn kernel32WriteFile(handle: int, bytesAddress: int, byteCount: int, writtenCountAddress: int, overlapped: int) -> int {
    var bytesWritten = 0
    while bytesWritten < byteCount {
        let result = syscall(systemCallWrite, handle, bytesAddress + bytesWritten, byteCount - bytesWritten)
        if result <= 0 {
            if writtenCountAddress != 0 { store64(writtenCountAddress, bytesWritten) }
            return 0
        }
        bytesWritten += result
    }
    if writtenCountAddress != 0 { store64(writtenCountAddress, bytesWritten) }
    return 1
}

fn kernel32ReadFile(handle: int, buffer: int, byteCount: int, readCountAddress: int, overlapped: int) -> int {
    let result = syscall(systemCallRead, handle, buffer, byteCount)
    if result < 0 {
        if readCountAddress != 0 { store64(readCountAddress, 0) }
        return 0
    }
    if readCountAddress != 0 { store64(readCountAddress, result) }
    return 1
}

fn kernel32CreateFileA(cStringPointer: int, access: int, share: int, securityAttributes: int, creationDisposition: int, flags: int, templateHandle: int) -> int {
    var openFlags = 0                       // O_RDONLY
    var mode = 0
    if (access & 1073741824) != 0 {      // GENERIC_WRITE
        openFlags = 1                       // O_WRONLY
        mode = 420                       // 0644
    }
    if (access & 4) != 0 { openFlags = 1025  // O_WRONLY | O_APPEND
        mode = 420
    }
    if creationDisposition == 1 { openFlags = openFlags | 192 } // CREATE_NEW: O_CREAT | O_EXCL
    if creationDisposition == 2 { openFlags = openFlags | 576 } // CREATE_ALWAYS: O_CREAT | O_TRUNC
    if creationDisposition == 4 { openFlags = openFlags | 64 }  // OPEN_ALWAYS: O_CREAT
    if creationDisposition == 5 { openFlags = openFlags | 512 } // TRUNCATE_EXISTING
    let fileDescriptor = syscall(systemCallOpen, cStringPointer, openFlags, mode)
    if fileDescriptor < 0 { return 0 - 1 }
    return fileDescriptor
}

fn kernel32GetFileSize(handle: int, highSizeAddress: int) -> int {
    let size = syscall(systemCallSeekFile, handle, 0, 2)      // SEEK_END
    let rewindResult = syscall(systemCallSeekFile, handle, 0, 0)      // SEEK_SET
    if size < 0 { return 0 }
    return size
}

fn kernel32CloseHandle(handle: int) -> int {
    if linuxCloseThread(handle) { return 1 }
    let result = syscall(systemCallClose, handle)
    if result < 0 { return 0 }
    return 1
}

// stat follows symlinks and provides the directory bit used by std/io.
fn kernel32GetFileAttributesA(cStringPointer: int) -> int {
    let scratch = linuxMapMemory(0, 144, memoryProtectionReadWrite, mapAnonymousPrivate)
    if scratch == 0 { return 4294967295 }
    let status = syscall(4, cStringPointer, scratch)
    let mode = load64(scratch + 24) & 61440
    let released = syscall(11, scratch, 144)
    if status < 0 { return 4294967295 }
    if mode == 16384 { return 16 }
    return 0
}

// /proc/self/exe is the Linux answer to GetModuleFileNameA. readlink does not
// NUL-terminate, so do it here -- callers pass the length back but exe_dir
// reads the buffer directly.
var linuxScratch = 0

// Absolute form of `path` with `.`, `..` and repeated slashes resolved (no symlinks),
// as the import de-duplicator needs. Returns the length, or the size needed if it won't fit.
fn kernel32GetFullPathNameA(path: int, capacity: int, destination: int, filePart: int) -> int {
    let joined = linuxMapMemory(0, 8192, memoryProtectionReadWrite, mapAnonymousPrivate)
    var joinedLength = 0
    if load8(path) != 47 {
        let cwdLength = syscall(79, joined, 4096)          // getcwd, length includes the NUL
        if cwdLength <= 0 {
            let freed = syscall(11, joined, 8192)
            return 0
        }
        joinedLength = cwdLength - 1
        store8(joined + joinedLength, 47)
        joinedLength += 1
    }
    var index = 0
    while load8(path + index) != 0 and joinedLength < 8191 {
        store8(joined + joinedLength, load8(path + index))
        joinedLength += 1
        index += 1
    }
    var outputLength = 0
    var position = 0
    while position < joinedLength {
        while position < joinedLength and load8(joined + position) == 47 { position += 1 }
        var segmentEnd = position
        while segmentEnd < joinedLength and load8(joined + segmentEnd) != 47 { segmentEnd += 1 }
        let segmentLength = segmentEnd - position
        let isDot = segmentLength == 1 and load8(joined + position) == 46
        let isDotDot = segmentLength == 2 and load8(joined + position) == 46 and load8(joined + position + 1) == 46
        if isDotDot {
            if outputLength > 0 { outputLength -= 1 }
            while outputLength > 0 and load8(destination + outputLength) != 47 { outputLength -= 1 }
        } else if segmentLength > 0 and not isDot {
            if outputLength + segmentLength + 2 > capacity {
                let freed = syscall(11, joined, 8192)
                return outputLength + segmentLength + 2
            }
            store8(destination + outputLength, 47)
            outputLength += 1
            var otherIndex = 0
            while otherIndex < segmentLength {
                store8(destination + outputLength, load8(joined + position + otherIndex))
                outputLength += 1
                otherIndex += 1
            }
        }
        position = segmentEnd
    }
    let released = syscall(11, joined, 8192)
    if outputLength == 0 {
        store8(destination, 47)
        outputLength = 1
    }
    store8(destination + outputLength, 0)
    return outputLength
}

fn kernel32GetModuleFileNameA(module: int, buffer: int, capacity: int) -> int {
    if linuxScratch == 0 { linuxScratch = linuxMapMemory(0, 4096, memoryProtectionReadWrite, mapAnonymousPrivate) }
    let suffixAddress = linuxProcSelfPath(linuxScratch)
    store8(suffixAddress, 101)           // e
    store8(suffixAddress + 1, 120)       // x
    store8(suffixAddress + 2, 101)       // e
    store8(suffixAddress + 3, 0)
    let pathLength = syscall(89, linuxScratch, buffer, capacity - 1)     // readlink
    if pathLength < 0 { return 0 }
    store8(buffer + pathLength, 0)
    return pathLength
}

fn kernel32ExitProcess(code: int) -> int {
    let result = syscall(systemCallExitGroup, code)
    return 0
}

// ---- reading a whole /proc file into an off-heap page ----

// The two /proc paths, written out a byte at a time. runtimeCollectGarbage calls into
// kernel32GetCurrentThreadStackLimits, so nothing on that path may touch the heap
// -- not even a list literal for the filename.
fn linuxProcSelfPath(destination: int) -> int {
    store8(destination, 47)          // /
    store8(destination + 1, 112)     // p
    store8(destination + 2, 114)     // r
    store8(destination + 3, 111)     // o
    store8(destination + 4, 99)      // c
    store8(destination + 5, 47)      // /
    store8(destination + 6, 115)     // s
    store8(destination + 7, 101)     // e
    store8(destination + 8, 108)     // l
    store8(destination + 9, 102)     // f
    store8(destination + 10, 47)     // /
    return destination + 11
}

fn linuxProcMapsPath(destination: int) -> int {
    let suffixAddress = linuxProcSelfPath(destination)
    store8(suffixAddress, 109)           // m
    store8(suffixAddress + 1, 97)        // a
    store8(suffixAddress + 2, 112)       // p
    store8(suffixAddress + 3, 115)       // s
    store8(suffixAddress + 4, 0)
    return destination
}

fn linuxProcCommandLinePath(destination: int) -> int {
    let suffixAddress = linuxProcSelfPath(destination)
    store8(suffixAddress, 99)            // c
    store8(suffixAddress + 1, 109)       // m
    store8(suffixAddress + 2, 100)       // d
    store8(suffixAddress + 3, 108)       // l
    store8(suffixAddress + 4, 105)       // i
    store8(suffixAddress + 5, 110)       // n
    store8(suffixAddress + 6, 101)       // e
    store8(suffixAddress + 7, 0)
    return destination
}

// Reads a whole file into a fresh off-heap buffer; returns the byte count and
// leaves the bytes at `buf`. /proc files report size 0, so this just reads
// until EOF or the buffer is full.
fn linuxReadWholeFile(path: int, buffer: int, capacity: int) -> int {
    let fileDescriptor = syscall(systemCallOpen, path, 0, 0)
    if fileDescriptor < 0 { return 0 }
    var bytesRead = 0
    var going = true
    while going {
        let result = syscall(systemCallRead, fileDescriptor, buffer + bytesRead, capacity - 1 - bytesRead)
        if result <= 0 { going = false } else { bytesRead += result }
        if bytesRead >= capacity - 1 { going = false }
    }
    let closeResult = syscall(systemCallClose, fileDescriptor)
    store8(buffer + bytesRead, 0)
    return bytesRead
}

// ---- command line ----

// /proc/self/cmdline is argv joined by NULs; runtimeArguments wants the Windows
// GetCommandLineA shape, so the NULs become spaces.
// ponytail: no quoting, so an argument containing a space splits in two.
// Capture argv at _start if that ever matters.
var linuxCommandLine = 0

fn kernel32GetCommandLineA() -> int {
    if linuxCommandLine != 0 { return linuxCommandLine }
    let page = linuxMapMemory(0, 8192, memoryProtectionReadWrite, mapAnonymousPrivate)
    if page == 0 { return 0 }
    let path = linuxProcCommandLinePath(page + 4096)
    let byteCount = linuxReadWholeFile(path, page, 4096)
    for i in 0..byteCount {
        if load8(page + i) == 0 { store8(page + i, 32) }
    }
    store8(page + byteCount, 0)
    linuxCommandLine = page
    return page
}

// ---- stack bounds (GC root scanning) ----

var linuxStackLowerBound = 0
var linuxStackUpperBound = 0

fn linuxHexadecimalAt(buffer: int, position: int) -> int {
    var value = 0
    var index = position
    var going = true
    while going {
        let character = load8(buffer + index)
        var hexDigit = 0 - 1
        if character >= 48 and character <= 57 { hexDigit = character - 48 }
        else if character >= 97 and character <= 102 { hexDigit = character - 87 }
        if hexDigit < 0 { going = false } else {
            value = value * 16 + hexDigit
            index += 1
        }
    }
    return value
}

// "[stack]" at p?
fn linuxIsStackTag(address: int) -> bool {
    if load8(address + 1) != 115 { return false }      // s
    if load8(address + 2) != 116 { return false }      // t
    if load8(address + 3) != 97 { return false }       // a
    if load8(address + 4) != 99 { return false }       // c
    if load8(address + 5) != 107 { return false }      // k
    if load8(address + 6) != 93 { return false }       // ]
    return true
}

// The main thread's stack is the one region /proc/self/maps tags "[stack]".
fn linuxFindStack() {
    let page = linuxMapMemory(0, 262144, memoryProtectionReadWrite, mapAnonymousPrivate)
    if page == 0 { return }
    let path = linuxProcMapsPath(page + 258048)
    let byteCount = linuxReadWholeFile(path, page, 258048)
    var lineStart = 0
    var index = 0
    while index <= byteCount {
        let character = load8(page + index)
        if character == 10 or index == byteCount {
            // a "[stack]" tag anywhere in the line identifies the region
            var otherIndex = lineStart
            var tagged = false
            while otherIndex + 6 < index {
                if load8(page + otherIndex) == 91 and linuxIsStackTag(page + otherIndex) { tagged = true }
                otherIndex += 1
            }
            if tagged {
                linuxStackLowerBound = linuxHexadecimalAt(page, lineStart)
                var dashIndex = lineStart
                while load8(page + dashIndex) != 45 { dashIndex += 1 }
                linuxStackUpperBound = linuxHexadecimalAt(page, dashIndex + 1)
            }
            lineStart = index + 1
        }
        index += 1
    }
}

fn kernel32GetCurrentThreadStackLimits(lowLimitAddress: int, highLimitAddress: int) -> int {
    let threadRecord = linuxCurrentThread()
    if threadRecord != 0 {
        store64(lowLimitAddress, load64(threadRecord + 8) + 4096)
        store64(highLimitAddress, load64(threadRecord + 40))
        return 0
    }
    if linuxStackUpperBound == 0 { linuxFindStack() }
    if linuxStackUpperBound == 0 {
        // no maps, no roots we can trust -- better to stop than to collect blind
        let result = syscall(systemCallExitGroup, 70)
    }
    store64(lowLimitAddress, linuxStackLowerBound)
    store64(highLimitAddress, linuxStackUpperBound)
    return 0
}

// ---- threads and futex synchronization ----
// Immutable linked records retain their addresses for lock-free stack lookup.
// Closed records are reused under runtimeLockHeap; their stacks are unmapped on join.
// Layout: tid32, gate32, mapping, entry, argument, next, stack high, active,
// generation, then 512 TLS cells at offset 64. A guard precedes each stack.
var linuxThreads = 0
var linuxNative = 0
var linuxThreadLocalStorage = 0
var linuxThreadLocalSlotCount = 0

// Initialize native CAS32/xadd32/clone code without touching the managed heap.
fn linuxNativeInitialize() {
    if linuxNative != 0 { return }
    let codeAddress = linuxMapMemory(0, 4096, 7, mapAnonymousPrivate)
    if codeAddress == 0 { let exited = syscall(systemCallExitGroup, 70) }
    // CAS32: mov eax,edx; lock cmpxchg [rcx],r8d; ret (old value).
    store8(codeAddress, 137)
    store8(codeAddress + 1, 208)
    store8(codeAddress + 2, 240)
    store8(codeAddress + 3, 68)
    store8(codeAddress + 4, 15)
    store8(codeAddress + 5, 177)
    store8(codeAddress + 6, 1)
    store8(codeAddress + 7, 195)
    // XADD32: mov eax,edx; lock xadd [rcx],eax; ret.
    store8(codeAddress + 16, 137)
    store8(codeAddress + 17, 208)
    store8(codeAddress + 18, 240)
    store8(codeAddress + 19, 15)
    store8(codeAddress + 20, 193)
    store8(codeAddress + 21, 1)
    store8(codeAddress + 22, 195)
    // clone entry: push rdi/rsi; move RCX,RDX,R8,R9 to RDI,RSI,RDX,R10;
    // clear R8 (TLS), syscall 56, then restore and return only in the parent.
    store8(codeAddress + 32, 87)
    store8(codeAddress + 33, 86)
    store8(codeAddress + 34, 72)
    store8(codeAddress + 35, 137)
    store8(codeAddress + 36, 207)
    store8(codeAddress + 37, 72)
    store8(codeAddress + 38, 137)
    store8(codeAddress + 39, 214)
    store8(codeAddress + 40, 76)
    store8(codeAddress + 41, 137)
    store8(codeAddress + 42, 194)
    store8(codeAddress + 43, 77)
    store8(codeAddress + 44, 137)
    store8(codeAddress + 45, 202)
    store8(codeAddress + 46, 69)
    store8(codeAddress + 47, 49)
    store8(codeAddress + 48, 192)
    store8(codeAddress + 49, 184)
    store8(codeAddress + 50, 56)
    store8(codeAddress + 51, 0)
    store8(codeAddress + 52, 0)
    store8(codeAddress + 53, 0)
    store8(codeAddress + 54, 15)
    store8(codeAddress + 55, 5)
    store8(codeAddress + 56, 72)
    store8(codeAddress + 57, 133)
    store8(codeAddress + 58, 192)
    store8(codeAddress + 59, 116)
    store8(codeAddress + 60, 3)
    store8(codeAddress + 61, 94)
    store8(codeAddress + 62, 95)
    store8(codeAddress + 63, 195)
    // child: pop rbx (record); while gate == 0, FUTEX_WAIT on record + 4.
    // JE +3 reaches the child; JNE +20 exits the gate; JMP -26 retries it.
    store8(codeAddress + 64, 91)
    store8(codeAddress + 65, 131)
    store8(codeAddress + 66, 123)
    store8(codeAddress + 67, 4)
    store8(codeAddress + 68, 0)
    store8(codeAddress + 69, 117)
    store8(codeAddress + 70, 20)
    store8(codeAddress + 71, 72)
    store8(codeAddress + 72, 141)
    store8(codeAddress + 73, 123)
    store8(codeAddress + 74, 4)
    store8(codeAddress + 75, 49)
    store8(codeAddress + 76, 246)
    store8(codeAddress + 77, 49)
    store8(codeAddress + 78, 210)
    store8(codeAddress + 79, 69)
    store8(codeAddress + 80, 49)
    store8(codeAddress + 81, 210)
    store8(codeAddress + 82, 184)
    store8(codeAddress + 83, 202)
    store8(codeAddress + 84, 0)
    store8(codeAddress + 85, 0)
    store8(codeAddress + 86, 0)
    store8(codeAddress + 87, 15)
    store8(codeAddress + 88, 5)
    store8(codeAddress + 89, 235)
    store8(codeAddress + 90, 230)
    // Reserve Win64 shadow space; RCX = argument; call [rbx + 16].
    // The child ends with syscall 60 (exit), never a Zephyr return.
    store8(codeAddress + 91, 72)
    store8(codeAddress + 92, 131)
    store8(codeAddress + 93, 236)
    store8(codeAddress + 94, 32)
    store8(codeAddress + 95, 72)
    store8(codeAddress + 96, 139)
    store8(codeAddress + 97, 75)
    store8(codeAddress + 98, 24)
    store8(codeAddress + 99, 255)
    store8(codeAddress + 100, 83)
    store8(codeAddress + 101, 16)
    store8(codeAddress + 102, 184)
    store8(codeAddress + 103, 60)
    store8(codeAddress + 104, 0)
    store8(codeAddress + 105, 0)
    store8(codeAddress + 106, 0)
    store8(codeAddress + 107, 49)
    store8(codeAddress + 108, 255)
    store8(codeAddress + 109, 15)
    store8(codeAddress + 110, 5)
    store8(codeAddress + 111, 15)
    store8(codeAddress + 112, 11)
    linuxNative = codeAddress
}

// Return the current worker's native record, or zero for the main thread.
// ponytail: linear range lookup; index ranges if many live records make TLS hot.
fn linuxCurrentThread() -> int {
    let stackAddress = stackptr()
    var threadRecord = linuxThreads
    while threadRecord != 0 {
        // An odd or changed generation belongs to another thread's reuse/close.
        // Our own live record cannot change until this thread exits and joins.
        let generation = load64(threadRecord + 56)
        let stackLow = load64(threadRecord + 8) + 4096
        let stackHigh = load64(threadRecord + 40)
        if (generation & 1) == 0 and generation == load64(threadRecord + 56) and stackAddress >= stackLow and stackAddress < stackHigh {
            return threadRecord
        }
        threadRecord = load64(threadRecord + 32)
    }
    return 0
}

// Obtain the kernel TID, also used as recursive-lock ownership token.
fn kernel32GetCurrentThreadId() -> int { return syscall(186) }

// Initialize a recursive lock: owner TID at 0, recursion count at 8.
fn kernel32InitializeCriticalSection(lockAddress: int) -> int {
    linuxNativeInitialize()
    store64(lockAddress, 0)
    store64(lockAddress + 8, 0)
    return 0
}

// Acquire ownership without sleeping, or increase this owner's recursion count.
fn kernel32TryEnterCriticalSection(lockAddress: int) -> int {
    let threadId = syscall(186)
    if (load64(lockAddress) & 4294967295) == threadId {
        store64(lockAddress + 8, load64(lockAddress + 8) + 1)
        return 1
    }
    if callptr(linuxNative, lockAddress, 0, threadId) != 0 { return 0 }
    store64(lockAddress + 8, 1)
    return 1
}

// Retry acquisition around futex waits; changed ownership yields EAGAIN.
fn kernel32EnterCriticalSection(lockAddress: int) -> int {
    while kernel32TryEnterCriticalSection(lockAddress) == 0 {
        let ownerId = load64(lockAddress) & 4294967295
        if ownerId != 0 { let waited = syscall(202, lockAddress, 128, ownerId, 0) }
    }
    return 0
}

// Release the outermost acquisition and wake a waiter.
fn kernel32LeaveCriticalSection(lockAddress: int) -> int {
    let recursionCount = load64(lockAddress + 8) - 1
    store64(lockAddress + 8, recursionCount)
    if recursionCount == 0 {
        store32(lockAddress, 0)
        let awakened = syscall(202, lockAddress, 129, 1)
    }
    return 0
}

// Initialize a futex sequence counter.
fn kernel32InitializeConditionVariable(conditionAddress: int) -> int {
    store64(conditionAddress, 0)
    return 0
}

// Atomically sleep relative to the sequence, releasing and reacquiring the lock.
// As on Windows the caller must hold the critical section exactly once.
fn kernel32SleepConditionVariableCS(conditionAddress: int, lockAddress: int, waitTimeout: int) -> int {
    let sequenceNumber = load64(conditionAddress) & 4294967295
    var timeoutAddress = 0
    if waitTimeout != 4294967295 {
        timeoutAddress = linuxMapMemory(0, 16, memoryProtectionReadWrite, mapAnonymousPrivate)
        if timeoutAddress == 0 { return 0 }
        store64(timeoutAddress, waitTimeout / 1000)
        store64(timeoutAddress + 8, (waitTimeout % 1000) * 1000000)
    }
    let released = kernel32LeaveCriticalSection(lockAddress)
    let waitStatus = syscall(202, conditionAddress, 128, sequenceNumber, timeoutAddress)
    let acquired = kernel32EnterCriticalSection(lockAddress)
    if timeoutAddress != 0 { let freed = syscall(11, timeoutAddress, 16) }
    if waitStatus == 0 - 110 { return 0 }
    return 1
}

// Change the sequence before waking one sleeper, preventing missed wakeups.
fn kernel32WakeConditionVariable(conditionAddress: int) -> int {
    let previousSequence = callptr(linuxNative + 16, conditionAddress, 1)
    return syscall(202, conditionAddress, 129, 1)
}

// Change the sequence and wake every sleeper.
fn kernel32WakeAllConditionVariable(conditionAddress: int) -> int {
    let previousSequence = callptr(linuxNative + 16, conditionAddress, 1)
    return syscall(202, conditionAddress, 129, 2147483647)
}

// Create a guarded stack and clone; the native child waits before entering Zephyr.
fn kernel32CreateThread(securityAddress: int, stackSize: int, entryAddress: int, argument: int, creationFlags: int, threadIdAddress: int) -> int {
    runtimeLockHeap()
    var threadRecord = linuxThreads
    while threadRecord != 0 and load64(threadRecord + 48) != 0 {
        threadRecord = load64(threadRecord + 32)
    }
    if threadRecord == 0 {
        threadRecord = linuxMapMemory(0, 8192, memoryProtectionReadWrite, mapAnonymousPrivate)
        if threadRecord == 0 { runtimeUnlockHeap()
            return 0
        }
        store64(threadRecord + 32, linuxThreads)
        linuxThreads = threadRecord
    }
    var requestedSize = stackSize
    if requestedSize == 0 { requestedSize = 8388608 }
    if requestedSize < 16384 or requestedSize > 1073741824 { runtimeUnlockHeap()
        return 0
    }
    let mappingSize = ((requestedSize + 4095) / 4096) * 4096 + 4096
    let stackMapping = linuxMapMemory(0, mappingSize, memoryProtectionReadWrite, mapAnonymousPrivate)
    if stackMapping == 0 { runtimeUnlockHeap()
        return 0
    }
    let guarded = syscall(systemCallProtectMemory, stackMapping, 4096, memoryProtectionNone)
    if guarded < 0 { let freed = syscall(11, stackMapping, mappingSize)
        runtimeUnlockHeap()
        return 0
    }
    store64(threadRecord + 56, load64(threadRecord + 56) + 1)
    store64(threadRecord, 0)
    store64(threadRecord + 8, stackMapping)
    store64(threadRecord + 16, entryAddress)
    store64(threadRecord + 24, argument)
    store64(threadRecord + 40, stackMapping + mappingSize)
    store64(threadRecord + 48, 1)
    for i in 0..512 { store64(threadRecord + 64 + i * 8, 0) }
    store64(threadRecord + 56, load64(threadRecord + 56) + 1)
    if (creationFlags & 4) == 0 { store32(threadRecord + 4, 1) }
    // Pop the record in the child, leaving RSP 16-byte aligned for its CALL.
    let childStack = stackMapping + mappingSize - 8
    store64(childStack, threadRecord)
    // VM|FS|FILES|SIGHAND|THREAD|SYSVSEM|PARENT_SETTID|CHILD_CLEARTID.
    let cloneResult = callptr(linuxNative + 32, 3477248, childStack, threadRecord, threadRecord)
    if cloneResult < 0 {
        let freed = syscall(11, stackMapping, mappingSize)
        store64(threadRecord + 56, load64(threadRecord + 56) + 1)
        store64(threadRecord + 8, 0)
        store64(threadRecord + 40, 0)
        store64(threadRecord + 48, 0)
        store64(threadRecord + 56, load64(threadRecord + 56) + 1)
        runtimeUnlockHeap()
        return 0
    }
    if threadIdAddress != 0 { store32(threadIdAddress, cloneResult) }
    runtimeAdjustUnsuspendableThreads(1)
    runtimeUnlockHeap()
    return threadRecord
}

// Release a suspended child's startup gate.
fn kernel32ResumeThread(threadHandle: int) -> int {
    store32(threadHandle + 4, 1)
    let awakened = syscall(202, threadHandle + 4, 1, 1)
    return 1
}

// Signal-based stack suspension is not implemented; the runtime defers GC.
fn kernel32SuspendThread(threadHandle: int) -> int { return 0 - 1 }
// No stopped register context is available on this platform yet.
fn kernel32GetThreadContext(threadHandle: int, contextAddress: int) -> int { return 0 }

// Wait on CHILD_CLEARTID using shared futexes (the kernel's wake convention).
fn kernel32WaitForSingleObject(threadHandle: int, waitTimeout: int) -> int {
    if waitTimeout != 4294967295 and waitTimeout != 0 { return 4294967295 }
    var threadId = load64(threadHandle) & 4294967295
    while threadId != 0 {
        if waitTimeout == 0 { return 258 }
        let waitStatus = syscall(202, threadHandle, 0, threadId, 0)
        if waitStatus < 0 and waitStatus != 0 - 4 and waitStatus != 0 - 11 { return 4294967295 }
        threadId = load64(threadHandle) & 4294967295
    }
    return 0
}

// Release a joined thread's stack; retain and reuse its TLS directory record.
fn linuxCloseThread(threadHandle: int) -> bool {
    var threadRecord = linuxThreads
    while threadRecord != 0 {
        if threadRecord == threadHandle {
            runtimeLockHeap()
            if load64(threadRecord + 48) != 0 and (load64(threadRecord) & 4294967295) == 0 {
                store64(threadRecord + 56, load64(threadRecord + 56) + 1)
                let stackMapping = load64(threadRecord + 8)
                let freed = syscall(11, stackMapping, load64(threadRecord + 40) - stackMapping)
                store64(threadRecord + 8, 0)
                store64(threadRecord + 40, 0)
                store64(threadRecord + 48, 0)
                store64(threadRecord + 56, load64(threadRecord + 56) + 1)
                runtimeAdjustUnsuspendableThreads(0 - 1)
            }
            runtimeUnlockHeap()
            return true
        }
        threadRecord = load64(threadRecord + 32)
    }
    return false
}

// Count the actual CPUs permitted by the calling thread's affinity mask.
fn kernel32GetSystemInfo(resultAddress: int) -> int {
    let maskAddress = linuxMapMemory(0, 131072, memoryProtectionReadWrite, mapAnonymousPrivate)
    var processorCount = 0
    if maskAddress != 0 {
        let byteCount = syscall(204, 0, 131072, maskAddress)
        if byteCount > 0 {
            for i in 0..byteCount {
                var remainingBits = load8(maskAddress + i)
                while remainingBits != 0 {
                    processorCount += remainingBits & 1
                    remainingBits = remainingBits >> 1
                }
            }
        }
        let freed = syscall(11, maskAddress, 131072)
    }
    if processorCount < 1 { processorCount = 1 }
    store32(resultAddress + 32, processorCount)
    return 0
}

// Allocate a process-wide TLS key; each stack range has its own cell table.
fn kernel32TlsAlloc() -> int {
    if linuxThreadLocalStorage == 0 { linuxThreadLocalStorage = linuxMapMemory(0, 4096, memoryProtectionReadWrite, mapAnonymousPrivate) }
    if linuxThreadLocalStorage == 0 or linuxThreadLocalSlotCount >= 512 { return 4294967295 }
    let slotIndex = linuxThreadLocalSlotCount
    linuxThreadLocalSlotCount += 1
    return slotIndex
}

// Store a value in this thread's TLS table without a gettid syscall.
fn kernel32TlsSetValue(slotIndex: int, value: int) -> int {
    if slotIndex < 0 or slotIndex >= linuxThreadLocalSlotCount { return 0 }
    var tableAddress = linuxThreadLocalStorage
    let threadRecord = linuxCurrentThread()
    if threadRecord != 0 { tableAddress = threadRecord + 64 }
    store64(tableAddress + 8 * slotIndex, value)
    return 1
}

// Read this thread's TLS table without a gettid syscall.
fn kernel32TlsGetValue(slotIndex: int) -> int {
    if slotIndex < 0 or slotIndex >= linuxThreadLocalSlotCount { return 0 }
    var tableAddress = linuxThreadLocalStorage
    let threadRecord = linuxCurrentThread()
    if threadRecord != 0 { tableAddress = threadRecord + 64 }
    return load64(tableAddress + 8 * slotIndex)
}
// ---- standard I/O extensions ----
var linuxLastError = 0
fn kernel32SetLastError(code: int) -> int { linuxLastError = code
    return 0
}
fn kernel32GetLastError() -> int { return linuxLastError }

fn kernel32DeleteFileA(path: int) -> int {
    if syscall(87, path) < 0 { return 0 }
    return 1
}

// CLOCK_MONOTONIC timespec. Scratch stays off the managed heap.
fn kernel32QueryPerformanceCounter(result: int) -> int {
    let scratch = linuxMapMemory(0, 16, memoryProtectionReadWrite, mapAnonymousPrivate)
    if scratch == 0 { return 0 }
    let status = syscall(228, 1, scratch)
    if status == 0 { store64(result, load64(scratch) * 1000000000 + load64(scratch + 8)) }
    let released = syscall(11, scratch, 16)
    if status < 0 { return 0 }
    return 1
}

fn kernel32QueryPerformanceFrequency(result: int) -> int {
    store64(result, 1000000000)
    return 1
}

fn kernel32GetTickCount64() -> int {
    let scratch = linuxMapMemory(0, 16, memoryProtectionReadWrite, mapAnonymousPrivate)
    if scratch == 0 { return 0 }
    let status = syscall(228, 1, scratch)
    var milliseconds = 0
    if status == 0 { milliseconds = load64(scratch) * 1000 + load64(scratch + 8) / 1000000 }
    let released = syscall(11, scratch, 16)
    return milliseconds
}

fn kernel32Sleep(milliseconds: int) -> int {
    let scratch = linuxMapMemory(0, 32, memoryProtectionReadWrite, mapAnonymousPrivate)
    if scratch == 0 { return 0 }
    store64(scratch, milliseconds / 1000)
    store64(scratch + 8, (milliseconds % 1000) * 1000000)
    var status = syscall(35, scratch, scratch + 16)
    while status == -4 {
        store64(scratch, load64(scratch + 16))
        store64(scratch + 8, load64(scratch + 24))
        status = syscall(35, scratch, scratch + 16)
    }
    let released = syscall(11, scratch, 32)
    return 0
}

// A directory handle owns one mmap: fd, cursor, count, then getdents64 records.
// Linux d_name is at byte 19; Windows WIN32_FIND_DATAA cFileName is at byte 44.
fn kernel32FindNextFileA(handle: int, result: int) -> int {
    var cursor = load64(handle + 8)
    var available = load64(handle + 16)
    if cursor >= available {
        available = syscall(217, load64(handle), handle + 24, 32744)
        if available <= 0 {
            linuxLastError = 18
            if available < 0 { linuxLastError = 5 }
            return 0
        }
        cursor = 0
        store64(handle + 16, available)
    }
    let record = handle + 24 + cursor
    let recordLength = load8(record + 16) + load8(record + 17) * 256
    if recordLength < 20 or cursor + recordLength > available {
        linuxLastError = 5
        return 0
    }
    var length = 0
    while length < 259 and length + 19 < recordLength and load8(record + 19 + length) != 0 {
        store8(result + 44 + length, load8(record + 19 + length))
        length += 1
    }
    store8(result + 44 + length, 0)
    store64(handle + 8, cursor + recordLength)
    return 1
}

fn kernel32FindClose(handle: int) -> int {
    let closed = syscall(systemCallClose, load64(handle))
    let released = syscall(11, handle, 32768)
    if closed < 0 or released < 0 { return 0 }
    return 1
}

fn kernel32FindFirstFileA(pattern: int, result: int) -> int {
    var length = 0
    while load8(pattern + length) != 0 { length += 1 }
    let path = linuxMapMemory(0, length + 1, memoryProtectionReadWrite, mapAnonymousPrivate)
    if path == 0 { linuxLastError = 8
        return -1
    }
    // std/io appends /*, so remove exactly that suffix without wildcard parsing.
    var pathLength = length
    if length >= 2 and load8(pattern + length - 1) == 42 and load8(pattern + length - 2) == 47 {
        pathLength -= 2
    }
    for i in 0..pathLength { store8(path + i, load8(pattern + i)) }
    store8(path + pathLength, 0)
    let descriptor = syscall(systemCallOpen, path, 65536, 0)
    let pathReleased = syscall(11, path, length + 1)
    if descriptor < 0 { linuxLastError = 5
        return -1
    }
    let handle = linuxMapMemory(0, 32768, memoryProtectionReadWrite, mapAnonymousPrivate)
    if handle == 0 {
        let closed = syscall(systemCallClose, descriptor)
        linuxLastError = 8
        return -1
    }
    store64(handle, descriptor)
    if kernel32FindNextFileA(handle, result) == 0 {
        let closed = kernel32FindClose(handle)
        return -1
    }
    return handle
}

