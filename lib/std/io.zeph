// Typed kernel32 wrappers. Linux builds route these calls through os/linux.zeph
// (run uses /bin/sh -c there; environmentVariable reads /proc/self/environ).
// Paths/names reject NUL bytes.
import "std/bytes.zeph"
import "std/result.zeph"

fn checkedCString(value: str) -> Bytes {
    for i in 0..value.len() { assert(value.byte(i) != 0, "io: embedded NUL") }
    return cString(value)
}

// Reads one byte at a time so successive calls never consume the next line.
fn readLine() -> str? {
    let inputHandle = win("GetStdHandle", -10)
    let buffer = Bytes.new(8)
    let countBuffer = Bytes.new(8)
    var pieces: [str] = []
    while true {
        let success = win("ReadFile", inputHandle, buffer.addr(), 1, countBuffer.addr(), 0)
        // A closed anonymous pipe reports ERROR_BROKEN_PIPE rather than success.
        if success == 0 {
            assert(win("GetLastError") == 109, "readLine: ReadFile failed")
            countBuffer.put32(0, 0)
        }
        if countBuffer.get32(0) == 0 {
            if pieces.len() == 0 { return none }
            break
        }
        let byteValue = buffer.get8(0)
        if byteValue == 10 { break }
        pieces.push(chr(byteValue))
    }
    if pieces.len() > 0 and pieces[pieces.len() - 1] == chr(13) { pieces.pop() }
    return pieces.join()
}

// Write all bytes, handling short writes. The caller owns and closes the handle.
fn writeToHandle(handle: int, data: str) {
    let buffer = cString(data)
    let countBuffer = Bytes.new(8)
    var written = 0
    while written < data.len() {
        let requested = min(data.len() - written, 2147483647)
        let success = win("WriteFile", handle, buffer.at(written), requested, countBuffer.addr(), 0)
        let amount = countBuffer.get32(0)
        assert(success != 0 and amount > 0 and amount <= requested, "io: WriteFile failed")
        written += amount
    }
}

fn printError(text: str) { writeToHandle(win("GetStdHandle", -12), text + "\n") }
fn exit(code: int) { let ignored = win("ExitProcess", code) }

// FILE_APPEND_DATA + OPEN_ALWAYS makes each write append, without truncating.
fn appendFile(path: str, data: str) {
    let filename = checkedCString(path)
    let handle = win("CreateFileA", filename.addr(), 4, 7, 0, 4, 128, 0)
    assert(handle != -1, "appendFile: cannot open file")
    writeToHandle(handle, data)
    let closed = win("CloseHandle", handle)
    assert(closed != 0, "appendFile: close failed")
}

fn fileExists(path: str) -> bool {
    let filename = checkedCString(path)
    let attributes = win("GetFileAttributesA", filename.addr())
    return (attributes & 4294967295) != 4294967295
}

fn deleteFile(path: str) -> bool {
    let filename = checkedCString(path)
    return win("DeleteFileA", filename.addr()) != 0
}

// Enumerates immediate entry names in OS order, excluding dot entries.
fn listDirectory(path: str) -> [str] {
    let directory = checkedCString(path)
    let attributes = win("GetFileAttributesA", directory.addr()) & 4294967295
    assert(attributes != 4294967295 and (attributes & 16) != 0, "listDirectory: not a directory")
    let pattern = checkedCString(path + "/*")
    let entry = Bytes.new(320)
    var names: [str] = []
    let handle = win("FindFirstFileA", pattern.addr(), entry.addr())
    if handle == -1 {
        assert(win("GetLastError") == 18 or win("GetLastError") == 2, "listDirectory: enumeration failed")
        return names
    }
    var more = true
    while more {
        var length = 0
        while length < 260 and entry.get8(44 + length) != 0 { length += 1 }
        let name = entry.getString(44, length)
        if name != "." and name != ".." { names.push(name) }
        more = win("FindNextFileA", handle, entry.addr()) != 0
    }
    let lastError = win("GetLastError")
    let closed = win("FindClose", handle)
    assert(lastError == 18 and closed != 0, "listDirectory: enumeration failed")
    return names
}

// Preserve the distinction between an absent variable and a present empty value.
fn environmentVariable(name: str) -> str? {
    let variable = checkedCString(name)
    var capacity = 256
    while true {
        let buffer = Bytes.new(capacity)
        let cleared = win("SetLastError", 0)
        let length = win("GetEnvironmentVariableA", variable.addr(), buffer.addr(), capacity)
        if length == 0 {
            if win("GetLastError") == 203 { return none }
            assert(win("GetLastError") == 0, "env: lookup failed")
            return ""
        }
        if length < capacity { return buffer.getString(0, length) }
        capacity = length
    }
    return none
}

fn nowMilliseconds() -> int { return win("GetTickCount64") }

// Divide first, retaining the fractional tick count without overflowing ticks*1e9.
fn nowNanoseconds() -> int {
    let counter = Bytes.new(8)
    let frequency = Bytes.new(8)
    assert(win("QueryPerformanceFrequency", frequency.addr()) != 0, "nowNanoseconds: no performance frequency")
    assert(win("QueryPerformanceCounter", counter.addr()) != 0, "nowNanoseconds: no performance counter")
    let ticks = counter.get64(0)
    let ticksPerSecond = frequency.get64(0)
    assert(ticksPerSecond > 0, "nowNanoseconds: invalid frequency")
    let remainder = ticks % ticksPerSecond
    var fraction = 0
    if ticksPerSecond <= 9223372036 { fraction = remainder * 1000000000 / ticksPerSecond }
    else { fraction = ((remainder as float) * 1000000000.0 / (ticksPerSecond as float)) as int }
    return (ticks / ticksPerSecond) * 1000000000 + fraction
}

fn sleepMilliseconds(milliseconds: int) {
    assert(milliseconds >= 0 and milliseconds < 4294967295, "sleepMilliseconds: duration out of range")
    let ignored = win("Sleep", milliseconds)
}

// Windows: a raw command line, no implicit shell (pass cmd.exe /c for shell
// syntax). Linux: run by /bin/sh -c with this process's environment; a
// command killed by signal N gives 128 + N, and 127 means sh could not start.
fn run(command: str) -> int {
    let commandBuffer = checkedCString(command)
    let startup = Bytes.new(104)
    startup.put32(0, 104)
    let process = Bytes.new(24)
    let created = win("CreateProcessA", 0, commandBuffer.addr(), 0, 0, 0, 0, 0, 0, startup.addr(), process.addr())
    assert(created != 0, "run: CreateProcess failed")
    let threadClosed = win("CloseHandle", process.get64(8))
    let waitResult = win("WaitForSingleObject", process.get64(0), 4294967295)
    let result = Bytes.new(8)
    let success = win("GetExitCodeProcess", process.get64(0), result.addr())
    let processClosed = win("CloseHandle", process.get64(0))
    assert(threadClosed != 0 and waitResult == 0 and success != 0 and processClosed != 0, "run: wait failed")
    return result.get32(0)
}

// ---- fallible file access ----

// Text for a GetLastError code: Linux errno values (tagged 0x20000000 by
// os/linux.zeph) or the common Windows codes.
fn ioErrorText(code: int) -> str {
    if (code & 536870912) != 0 {
        let errno = code & 65535
        let names = [2: "no such file or directory", 1: "operation not permitted", 4: "interrupted",
            5: "input/output error", 9: "bad file descriptor", 12: "out of memory", 13: "permission denied",
            17: "file exists", 20: "not a directory", 21: "is a directory", 22: "invalid argument",
            24: "too many open files", 27: "file too large", 28: "no space left on device",
            30: "read-only file system", 32: "broken pipe", 36: "file name too long", 40: "too many symbolic links"]
        return names.get(errno).or("errno {errno}")
    }
    let windows = [2: "no such file or directory", 3: "path not found", 5: "permission denied",
        32: "file in use", 80: "file exists", 112: "no space left on device", 123: "invalid file name"]
    return windows.get(code).or("error {code}")
}

private fn ioFailure(what: str, path: str) -> str {
    return "{what} {path}: " + ioErrorText(win("GetLastError"))
}

// The whole file, or Err("open PATH: no such file or directory") and the
// like. Reads to EOF, so /proc files and FIFOs work. Never panics on I/O.
fn tryReadFile(path: str) -> Result[str, str] {
    for i in 0..path.len() {
        if path.byte(i) == 0 { return Result.Err("open {path}: embedded NUL") }
    }
    let filename = cString(path)
    let cleared = win("SetLastError", 0)
    let handle = win("CreateFileA", filename.addr(), 2147483648, 1, 0, 3, 128, 0)
    if handle == -1 { return Result.Err(ioFailure("open", path)) }
    var buffer = Bytes.new(65536)
    let countBuffer = Bytes.new(8)
    var total = 0
    while true {
        if total == buffer.len() {
            let bigger = Bytes.new(buffer.len() * 2)
            bigger.putString(0, buffer.getString(0, total))
            buffer = bigger
        }
        countBuffer.put64(0, 0)
        let success = win("ReadFile", handle, buffer.addr() + total, buffer.len() - total, countBuffer.addr(), 0)
        if success == 0 {
            let message = ioFailure("read", path)
            let closed = win("CloseHandle", handle)
            return Result.Err(message)
        }
        let amount = countBuffer.get32(0)
        if amount == 0 { break }
        total += amount
    }
    let closed = win("CloseHandle", handle)
    return Result.Ok(buffer.getString(0, total))
}

// Creates or truncates PATH and writes DATA. Ok(byte count) or Err(text).
fn tryWriteFile(path: str, data: str) -> Result[int, str] {
    for i in 0..path.len() {
        if path.byte(i) == 0 { return Result.Err("open {path}: embedded NUL") }
    }
    let filename = cString(path)
    let cleared = win("SetLastError", 0)
    let handle = win("CreateFileA", filename.addr(), 1073741824, 0, 0, 2, 128, 0)
    if handle == -1 { return Result.Err(ioFailure("open", path)) }
    let buffer = cString(data)
    let countBuffer = Bytes.new(8)
    var written = 0
    while written < data.len() {
        countBuffer.put64(0, 0)
        let requested = min(data.len() - written, 1073741824)
        let success = win("WriteFile", handle, buffer.addr() + written, requested, countBuffer.addr(), 0)
        let amount = countBuffer.get32(0)
        if success == 0 or amount <= 0 {
            let message = ioFailure("write", path)
            let closed = win("CloseHandle", handle)
            return Result.Err(message)
        }
        written += amount
    }
    let closed = win("CloseHandle", handle)
    if closed == 0 { return Result.Err(ioFailure("close", path)) }
    return Result.Ok(written)
}
