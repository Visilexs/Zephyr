// Transcendental maths for a runtime with no libm (kernel32-only exes).
// exp/ln by range reduction + short series (good to ~1e-9), tanh on top.
// First written for gale (the GPT project); promoted here once a third
// project needed them. Import as "std/math.zeph".

let LN2 = 0.6931471805599453

fn round_i(v: float) -> int {
    if v >= 0.0 { return (v + 0.5) as int }
    return 0 - ((0.5 - v) as int)
}

// e^x: e^x = 2^n * e^r with r in [-ln2/2, ln2/2], Taylor for e^r, 2^n from bits
fn fexp(x0: float) -> float {
    var x = x0
    if x < -87.3 { return 0.0 }
    if x > 88.7 { x = 88.7 }
    let n = round_i(x / LN2)
    let r = x - (n as float) * LN2
    var term = 1.0
    var sum = 1.0
    for i in 1..12 {
        term = term * r / (i as float)
        sum += term
    }
    let p2 = frombits((1023 + n) << 52)
    return sum * p2
}

// ln(x) = e*ln2 + 2*atanh((m-1)/(m+1)), where x = m * 2^e, m in [1,2)
fn fln(x: float) -> float {
    if x <= 0.0 { return 0.0 - 1000000000000000000000000000000.0 }
    let b = bits(x)
    let e = ((b >> 52) & 2047) - 1023
    let m = frombits((b & ((1 << 52) - 1)) | (1023 << 52))
    let t = (m - 1.0) / (m + 1.0)
    let t2 = t * t
    var term = t
    var sum = t
    for i in 1..12 {
        term = term * t2
        sum += term / ((2 * i + 1) as float)
    }
    return (e as float) * LN2 + 2.0 * sum
}

fn tanh(x: float) -> float {
    if x > 15.0 { return 1.0 }
    if x < -15.0 { return -1.0 }
    let e = fexp(2.0 * x)
    return (e - 1.0) / (e + 1.0)
}

let PI = 3.141592653589793
let TWO_PI = 6.283185307179586
let HALF_PI = 1.5707963267948966

// sin via range reduction to [-pi,pi] then Taylor (10 terms -> ~1e-6 at +-pi)
fn fsin(x0: float) -> float {
    let k = round_i(x0 / TWO_PI)
    let x = x0 - (k as float) * TWO_PI
    let x2 = x * x
    var term = x
    var sum = x
    for i in 1..10 {
        let d = ((2 * i) * (2 * i + 1)) as float
        term = term * (0.0 - x2) / d
        sum += term
    }
    return sum
}

fn fcos(x: float) -> float { return fsin(x + HALF_PI) }
