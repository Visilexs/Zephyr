// Raw byte buffers: a fixed-size, GC-managed, non-moving region you can lay C
// structs into. Backed by a `zeros()` list, so the collector owns it -- no
// manual free, and the mark-sweep collector never moves objects.
//
// PINNING RULE: any address handed to a foreign library must belong to a Bytes
// that is still reachable from a Zephyr variable for as long as that library
// may use it. The collector never moves and never frees reachable objects, so
// that is the entire contract.
//
// Every accessor is bounds-checked and panics on violation, like list indexing.

struct Bytes {
    memory: [int],     // the backing allocation -- keeps the data alive for the GC
    address: int,         // 16-byte-aligned address of byte 0
    size: int          // usable size in bytes
}

// The one bounds check: `width` bytes at `offset` lie inside the buffer.
// Written so that no sum can overflow: a huge offset or width panics instead
// of wrapping around to a small, "valid" address.
private fn check(buffer: Bytes, offset: int, width: int) {
    if offset < 0 or width < 0 or width > buffer.size - offset {
        panic("Bytes: {width} bytes at offset {offset} out of range for size {buffer.size}")
    }
}

impl Bytes {
    // n zero-filled bytes, aligned to 16 so any C struct laid at offset 0 is aligned
    fn new(size: int) -> Bytes {
        assert(size >= 0 and size < 1 << 56, "Bytes.new: bad size")
        var memory = zeros(size / 8 + 4)                 // slack for the alignment bump
        let address = (dataAddr(memory) + 15) & (0 - 16)
        return Bytes{memory: memory, address: address, size: size}
    }

    fn len(self) -> int { return self.size }
    fn addr(self) -> int { return self.address }

    // address of byte `off`, for passing an interior pointer to a foreign call
    fn at(self, offset: int) -> int {
        check(self, offset, 0)
        return self.address + offset
    }

    // `length` bytes at `offset` as a Bytes of their own. Both views share the
    // same memory (writes through one show in the other) and keep it alive.
    fn slice(self, offset: int, length: int) -> Bytes {
        check(self, offset, length)
        return Bytes{memory: self.memory, address: self.address + offset, size: length}
    }

    // copy `length` bytes from `source` at `sourceOffset` to `offset`; the
    // ranges may overlap (memmove)
    fn copyFrom(self, offset: int, source: Bytes, sourceOffset: int, length: int) {
        check(self, offset, length)
        check(source, sourceOffset, length)
        copyMemory(self.address + offset, source.address + sourceOffset, length)
    }

    // set `length` bytes at `offset` to `value & 255`
    fn fill(self, offset: int, length: int, value: int) {
        check(self, offset, length)
        fillMemory(self.address + offset, value, length)
    }

    fn put8(self, offset: int, value: int) {
        check(self, offset, 1)
        store8(self.address + offset, value)
    }
    fn get8(self, offset: int) -> int {
        check(self, offset, 1)
        return load8(self.address + offset)
    }

    fn put16(self, offset: int, value: int) {
        check(self, offset, 2)
        store16(self.address + offset, value)
    }
    fn get16(self, offset: int) -> int {
        check(self, offset, 2)
        return load16(self.address + offset)
    }

    fn put32(self, offset: int, value: int) {
        check(self, offset, 4)
        store32(self.address + offset, value)
    }
    // zero-extends: Vulkan's 32-bit fields are enums, flags and counts
    fn get32(self, offset: int) -> int {
        check(self, offset, 4)
        return load32(self.address + offset)
    }

    fn put64(self, offset: int, value: int) {
        check(self, offset, 8)
        store64(self.address + offset, value)
    }
    fn get64(self, offset: int) -> int {
        check(self, offset, 8)
        return load64(self.address + offset)
    }

    // an IEEE single: rounded to nearest on the way in, widened exactly on the way out
    fn putFloat32(self, offset: int, value: float) {
        check(self, offset, 4)
        storeF32(self.address + offset, value)
    }
    fn getFloat32(self, offset: int) -> float {
        check(self, offset, 4)
        return loadF32(self.address + offset)
    }

    fn putFloat64(self, offset: int, value: float) {
        check(self, offset, 8)
        storeF64(self.address + offset, value)
    }
    fn getFloat64(self, offset: int) -> float {
        check(self, offset, 8)
        return loadF64(self.address + offset)
    }

    // copy a Zephyr string in and NUL-terminate it -- a C `const char*`
    fn putCString(self, offset: int, text: str) {
        check(self, offset, text.len() + 1)
        copyMemory(self.address + offset, dataAddr(text), text.len())
        store8(self.address + offset + text.len(), 0)
    }

    // copy raw bytes of a str (e.g. a .spv file read with readFile) in
    fn putString(self, offset: int, text: str) {
        check(self, offset, text.len())
        copyMemory(self.address + offset, dataAddr(text), text.len())
    }

    // read `n` bytes back out as a str
    fn getString(self, offset: int, length: int) -> str {
        check(self, offset, length)
        let text = " ".repeat(length)                // a fresh string, filled in place
        copyMemory(dataAddr(text), self.address + offset, length)
        return text
    }
}

// a standalone NUL-terminated C string; hold the returned Bytes to keep it alive
fn cString(text: str) -> Bytes {
    var buffer = Bytes.new(text.len() + 1)
    buffer.putCString(0, text)
    return buffer
}

// ---- array plumbing for C APIs that take count + pointer ----

// a contiguous array of 64-bit values (handles, pointers)
fn uint64Array(values: [int]) -> Bytes {
    var buffer = Bytes.new(8 * values.len() + 8)
    for i in 0..values.len() { buffer.put64(i * 8, values[i]) }
    return buffer
}

// a contiguous array of 32-bit values (indices, enum values)
fn uint32Array(values: [int]) -> Bytes {
    var buffer = Bytes.new(4 * values.len() + 4)
    for i in 0..values.len() { buffer.put32(i * 4, values[i]) }
    return buffer
}

// Lay several equally-sized structs out back to back, which is what an API
// wanting `count, pStructs` expects. Pass each builder's .raw().
fn pack(items: [Bytes]) -> Bytes {
    if items.len() == 0 { return Bytes.new(8) }
    let stride = items[0].len()
    var packed = Bytes.new(stride * items.len() + 8)
    for i in 0..items.len() {
        packed.copyFrom(i * stride, items[i], 0, stride)
    }
    return packed
}

// A `const char* const*`. The individual strings must outlive the call, so the
// array and its buffers are held together.
struct CStrs { pointers: Bytes, buffers: [Bytes] }
fn cStringArray(strings: [str]) -> CStrs {
    var buffers: [Bytes] = []
    var pointers = Bytes.new(8 * strings.len() + 8)
    for i in 0..strings.len() {
        var buffer = cString(strings[i])
        buffers.push(buffer)
        pointers.put64(i * 8, buffer.addr())
    }
    return CStrs{pointers: pointers, buffers: buffers}
}
impl CStrs {
    fn addr(self) -> int {
        if self.buffers.len() == 0 { return 0 }
        return self.pointers.addr()
    }
    fn len(self) -> int { return self.buffers.len() }
}

// ---- IEEE-754 double <-> single conversion (Zephyr floats are all doubles) ----
// Rounds to nearest, ties to even -- the same rule the hardware uses for a
// double->float store, so results match what a C `(float)x` would produce.
fn float32Bits(value: float) -> int {
    let doubleBits = bits(value)
    let sign = (doubleBits >> 63) & 1
    let exponent = (doubleBits >> 52) & 2047
    let mantissa = doubleBits & 4503599627370495                  // 2^52 - 1
    if exponent == 0 { return sign << 31 }               // zero / subnormal -> signed zero
    if exponent == 2047 {                                // inf / NaN
        if mantissa != 0 { return (sign << 31) | (255 << 23) | 4194303 }
        return (sign << 31) | (255 << 23)
    }
    var singleExponent = exponent - 1023 + 127
    if singleExponent >= 255 { return (sign << 31) | (255 << 23) }   // overflow -> inf
    if singleExponent <= 0 {
        // Below the smallest normal float, but a subnormal may still represent
        // it: value = m * 2^-149, so shift the 53-bit significand down to suit.
        let shift = 30 - singleExponent
        if shift > 53 { return sign << 31 }             // truly zero
        let fullSignificand = 4503599627370496 + mantissa               // 2^52 + mantissa
        var subnormalMantissa = fullSignificand >> shift
        let subnormalDropped = fullSignificand & ((1 << shift) - 1)
        let subnormalHalf = 1 << (shift - 1)
        if subnormalDropped > subnormalHalf or (subnormalDropped == subnormalHalf and (subnormalMantissa & 1) == 1) { subnormalMantissa += 1 }
        // carrying out of the mantissa lands on the smallest normal, which this
        // encoding already expresses correctly (exponent 1, mantissa 0)
        return (sign << 31) | subnormalMantissa
    }
    // 52 mantissa bits down to 23: 29 bits are dropped. Round to nearest, and on
    // an exact tie pick the even significand.
    var singleMantissa = mantissa >> 29
    let dropped = mantissa & 536870911                   // 2^29 - 1
    let half = 268435456                            // 2^28
    if dropped > half or (dropped == half and (singleMantissa & 1) == 1) {
        singleMantissa += 1
        if singleMantissa == 8388608 {                           // mantissa overflowed: bump exponent
            singleMantissa = 0
            singleExponent += 1
            if singleExponent >= 255 { return (sign << 31) | (255 << 23) }
        }
    }
    return (sign << 31) | (singleExponent << 23) | singleMantissa
}

fn float32FromBits(singleBits: int) -> float {
    let sign = (singleBits >> 31) & 1
    let exponent = (singleBits >> 23) & 255
    let mantissa = singleBits & 8388607                           // 2^23 - 1
    if exponent == 0 {
        if mantissa == 0 { return floatFromBits(sign << 63) }
        // subnormal: man * 2^-149, renormalised into a double
        var highestBit = 22
        while highestBit > 0 and (mantissa & (1 << highestBit)) == 0 { highestBit -= 1 }
        let doubleExponent = 0 - 149 + highestBit + 1023
        let doubleMantissa = (mantissa << (52 - highestBit)) & 4503599627370495
        return floatFromBits((sign << 63) | (doubleExponent << 52) | doubleMantissa)
    }
    if exponent == 255 {
        if mantissa != 0 { return floatFromBits((sign << 63) | (2047 << 52) | 1) }
        return floatFromBits((sign << 63) | (2047 << 52))
    }
    return floatFromBits((sign << 63) | ((exponent - 127 + 1023) << 52) | (mantissa << 29))
}
