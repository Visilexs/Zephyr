// Threads.
//
// Two things stand between Zephyr and CreateThread:
//
//  1. The OS calls a thread entry with Win64 conventions (one argument in RCX),
//     but a Zephyr function reads its arguments off the stack. So there is a
//     29-byte thunk below, assembled by hand into executable memory, that
//     translates one into the other. This is the native callback we managed to
//     avoid for windowing (DefWindowProcA did that job) and for Vulkan
//     validation (a settings file did). A thread entry has no such escape.
//
//  2. The collector is stop-the-world and finds its roots by scanning stacks.
//     runtime.zeph keeps a registry. On Windows runtimeCollectGarbage suspends every other
//     registered thread, reads its CONTEXT for the integer registers, and scans
//     from its Rsp to its stack base. A thread
//     is registered before it is resumed, so it cannot allocate unseen. Linux
//     defers cyclic collection until all workers are joined (no stack suspension).
//
// The argument passed to a thread is an `int` -- a worker index, or an address
// in a buffer you allocated up front. It is deliberately not a heap reference:
// it travels through memory the collector does not scan.
//
// String interpolation IS safe across threads: the runtime's builder is
// per-thread, reached through TLS once a second thread exists.

struct Thread { handle: int, recordAddress: int, slot: int }

// Thread bodies are closures, and a closure is a heap object. The record handed
// to the OS lives outside the heap, so without this list the collector would
// see no reference to a running thread's body and free it.
// join() releases the entry, so spawning in a loop reuses these rather than
// growing a list the collector has to walk on every cycle.
var threadBodies: [fn(int)] = []
var threadBodyInUse: [bool] = []
var threadEntryThunkAddress = 0

// Retain a thread body in a reusable root slot until its worker is joined.
fn retainThreadBody(threadBody: fn(int)) -> int {
    for i in 0..threadBodies.len() {
        if not threadBodyInUse[i] {
            threadBodies[i] = threadBody
            threadBodyInUse[i] = true
            return i
        }
    }
    threadBodies.push(threadBody)
    threadBodyInUse.push(true)
    return threadBodies.len() - 1
}

// push rbx / mov rbx,rsp        -- keep a copy of the stack pointer
// mov rax,[rcx]                 -- rcx = record; rax = the closure cell
// mov rdx,[rax+8] / push rdx    -- env, pushed first (deepest) as Zephyr expects
// mov rdx,[rcx+8] / push rdx    -- the int argument
// mov rax,[rax] / call rax      -- code pointer
// mov rsp,rbx / pop rbx / xor eax,eax / ret
let threadEntryThunkCode = [83, 72, 137, 227, 72, 139, 1, 72, 139, 80, 8, 82,
                  72, 139, 81, 8, 82, 72, 139, 0, 255, 208,
                  72, 137, 220, 91, 49, 192, 195]

// Return the executable adapter from native thread entry to a Zephyr closure.
fn threadEntryThunk() -> int {
    if threadEntryThunkAddress != 0 { return threadEntryThunkAddress }
    // MEM_COMMIT|MEM_RESERVE, PAGE_EXECUTE_READWRITE
    let codeAddress = win("VirtualAlloc", 0, 4096, 12288, 64)
    if codeAddress == 0 { panic("thread: cannot allocate executable memory") }
    for i in 0..threadEntryThunkCode.len() { store8(codeAddress + i, threadEntryThunkCode[i]) }
    threadEntryThunkAddress = codeAddress
    return codeAddress
}

// Run threadFunction(argument) on a new thread.
fn spawnThread(threadFunction: fn(int), argument: int) -> Thread {
    // wrap the caller's function so registration cannot be forgotten
    let threadBody = fn(workerArgument: int) {
        runtimeMarkThreadReady()
        threadFunction(workerArgument)
        runtimeMarkThreadDone()
    }
    let bodySlot = retainThreadBody(threadBody)

    let recordAddress = win("VirtualAlloc", 0, 32, 12288, 4)
    if recordAddress == 0 { panic("thread: cannot allocate record") }
    store64(recordAddress, addr(threadBody))
    store64(recordAddress + 8, argument)
    let threadIdAddress = win("VirtualAlloc", 0, 16, 12288, 4)
    if threadIdAddress == 0 { panic("thread: cannot allocate thread id") }

    // CREATE_SUSPENDED so the thread is in the registry before it can allocate
    let threadHandle = win("CreateThread", 0, 0, threadEntryThunk(), recordAddress, 4, threadIdAddress)
    if threadHandle == 0 { panic("thread: CreateThread failed") }
    let registrySlot = runtimeRegisterThread(threadHandle, load64(threadIdAddress) & 4294967295)
    let resumeResult = win("ResumeThread", threadHandle)
    let threadIdReleased = win("VirtualFree", threadIdAddress, 0, 32768) // MEM_RELEASE
    return Thread{handle: threadHandle, recordAddress: recordAddress, slot: bodySlot}
}

impl Thread {
    // Wait for completion and release this worker's native resources and root.
    fn join(self) {
        let waitResult = win("WaitForSingleObject", self.handle, 4294967295) // INFINITE
        assert(waitResult == 0, "thread: join failed")
        let handleClosed = win("CloseHandle", self.handle)
        // the body has returned, so nothing reaches the record or the closure
        let recordReleased = win("VirtualFree", self.recordAddress, 0, 32768) // MEM_RELEASE
        threadBodyInUse[self.slot] = false
    }
}

// Run workerFunction(i) across workerCount threads and wait for all of them.
fn parallelFor(workerCount: int, workerFunction: fn(int)) {
    var workers: [Thread] = []
    for i in 0..workerCount { workers.push(spawnThread(workerFunction, i)) }
    for worker in workers { worker.join() }
}

// Return the system's logical processor count, falling back to one.
fn cpuCount() -> int {
    // GetSystemInfo fills a SYSTEM_INFO; dwNumberOfProcessors sits at offset 32
    let systemInfoAddress = win("VirtualAlloc", 0, 128, 12288, 4)
    if systemInfoAddress == 0 { panic("thread: cannot allocate system info") }
    let systemInfoResult = win("GetSystemInfo", systemInfoAddress)
    let processorCount = load64(systemInfoAddress + 32) & 4294967295
    let released = win("VirtualFree", systemInfoAddress, 0, 32768)
    if processorCount < 1 { return 1 }
    return processorCount
}

// Freeze a structure that worker threads will share read-only: it and
// everything reachable from it stop being reference counted (no atomic writes
// to shared headers, so readers on many cores do not contend) and are never
// freed by counting. Still safe to mutate; anything stored into it later is
// counted normally. Use on long-lived shared state (tables, samplers, registries).
fn freeze[T](value: T) { runtimeFreezeObject(addr(value)) }
