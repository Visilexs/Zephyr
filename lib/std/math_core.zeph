// Transcendental maths for a runtime with no libm (kernel32-only exes).
// exp/ln by range reduction + short series, tanh on top, then the inverse
// trig / hyperbolic / special-function family built on a single new
// primitive: fatan. First written for gale (the GPT project); promoted here
// once a third project needed them. Import as "std/math.zeph".
//
// Domain errors return nan, matching the sqrt builtin, which already does.
// Poles return infinity where the limit is +inf, nan where it is undefined.
//
//   fn              domain             outside it
//   fln             x > 0              nan below zero, -infinity at zero
//   fasin facos     -1 <= x <= 1       nan
//   fasec facsc     |x| >= 1           nan
//   gdInverse          |y| < pi/2         nan
//   gamma digamma   x not 0,-1,-2,...  nan at the poles, gamma infinity above 171.62
//   lgamma          x not 0,-1,-2,...  infinity at the poles

let ln2 = 0.6931471805599453
// Cody-Waite split of ln2: HI holds the top bits exactly, so n*ln2High is
// exact and the reduced argument keeps full precision for large |n|.
let ln2High = 0.6931471803691238
let ln2Low = 0.00000000019082149292705877
let nan = floatFromBits((2047 << 52) | (1 << 51))
let infinity = floatFromBits(2047 << 52)

fn roundToInt(value: float) -> int {
    if value >= 0.0 { return (value + 0.5) as int }
    return 0 - ((0.5 - value) as int)
}

fn isNan(x: float) -> bool { return x != x }

fn fabs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

// e^x: e^x = 2^n * e^r with r in [-ln2/2, ln2/2], Taylor for e^r, 2^n from bits
fn fexp(x: float) -> float {
    if isNan(x) { return x }
    if x < -745.2 { return 0.0 }
    if x > 709.782712893384 { return infinity }
    var binaryExponent = roundToInt(x / ln2)
    if binaryExponent > 1023 { binaryExponent = 1023 }
    let binaryExponentFloat = binaryExponent as float
    let reduced = (x - binaryExponentFloat * ln2High) - binaryExponentFloat * ln2Low
    var term = 1.0
    var sum = 1.0
    for i in 1..15 {
        term = term * reduced / (i as float)
        sum += term
    }
    if binaryExponent < -1022 {
        // subnormal result: split the scale so both factors stay representable
        return sum * floatFromBits(1 << 52) * floatFromBits((1023 + binaryExponent + 1022) << 52)
    }
    return sum * floatFromBits((1023 + binaryExponent) << 52)
}

// ln(x) = e*ln2 + 2*atanh((m-1)/(m+1)), where x = m * 2^e, m in [1,2)
fn fln(x: float) -> float {
    // was a -1e30 sentinel; nan/-infinity is what the rest of the file and the
    // sqrt builtin do, and -infinity is the actual limit at zero
    if x < 0.0 { return nan }
    if x == 0.0 { return 0.0 - infinity }
    if isNan(x) or x == infinity { return x }
    if x < floatFromBits(1 << 52) { return fln(x * 4503599627370496.0) - 52.0 * ln2 }
    let bitPattern = bits(x)
    let exponent = ((bitPattern >> 52) & 2047) - 1023
    let mantissa = floatFromBits((bitPattern & ((1 << 52) - 1)) | (1023 << 52))
    let ratio = (mantissa - 1.0) / (mantissa + 1.0)
    let ratioSquared = ratio * ratio
    var term = ratio
    var sum = ratio
    // 19 terms, not 11: t reaches 1/3, where the old count left ~1e-13 of
    // absolute error. gamma multiplies that by (z+0.5), so it showed up there.
    for i in 1..20 {
        term = term * ratioSquared
        sum += term / ((2 * i + 1) as float)
    }
    return (exponent as float) * ln2 + 2.0 * sum
}

// (e^x - e^-x)/2 cancels badly for small x, so use the series there instead
fn sinh(x: float) -> float {
    if x < 1.0 and x > -1.0 {
        let xSquared = x * x
        var term = x
        var sum = x
        for i in 1..10 {
            term = term * xSquared / (((2 * i) * (2 * i + 1)) as float)
            sum += term
        }
        return sum
    }
    let exponential = fexp(x)
    return (exponential - 1.0 / exponential) / 2.0
}

// no cancellation here: both terms are positive
fn cosh(x: float) -> float {
    let exponential = fexp(x)
    return (exponential + 1.0 / exponential) / 2.0
}

fn tanh(x: float) -> float {
    if x > 15.0 { return 1.0 }
    if x < -15.0 { return -1.0 }
    // (e^2x - 1) loses ~8 digits near zero; sinh/cosh stay exact there
    if x < 1.0 and x > -1.0 { return sinh(x) / cosh(x) }
    let exponential = fexp(2.0 * x)
    return (exponential - 1.0) / (exponential + 1.0)
}

let pi = 3.141592653589793
let twoPi = 6.283185307179586
let halfPi = 1.5707963267948966
let piOver6 = 0.5235987755982988
let sqrt3 = 1.7320508075688772
let tanPiOver12 = 0.2679491924311227
// Cody-Waite split of 2pi, as for ln2 above. HI has its low 20 mantissa bits
// clear, so k*HI is exact out to k = 2^20 and the reduced argument does not
// inherit k ulps of error from a single rounded twoPi.
let twoPiHigh = 6.2831853069365025
let twoPiLow = 0.0000000002430840202602477

// sin via range reduction to [-pi,pi] then Taylor. 13 terms reaches double
// precision at +-pi; the old 9 stopped at ~5e-10, which capped every
// reciprocal and inverse built on it (tan, csc, cot, gdInverse, digamma).
fn fsin(angle: float) -> float {
    let turns = roundToInt(angle / twoPi)
    let turnsFloat = turns as float
    let reduced = (angle - turnsFloat * twoPiHigh) - turnsFloat * twoPiLow
    let reducedSquared = reduced * reduced
    var term = reduced
    var sum = reduced
    for i in 1..14 {
        let denominator = ((2 * i) * (2 * i + 1)) as float
        term = term * (0.0 - reducedSquared) / denominator
        sum += term
    }
    return sum
}

// Its own reduction and series rather than fsin(x + halfPi): that shift
// rounds away the low bits of a large argument before the reduction sees it.
fn fcos(angle: float) -> float {
    let turns = roundToInt(angle / twoPi)
    let turnsFloat = turns as float
    let reduced = (angle - turnsFloat * twoPiHigh) - turnsFloat * twoPiLow
    let reducedSquared = reduced * reduced
    var term = 1.0
    var sum = 1.0
    for i in 1..15 {
        let denominator = ((2 * i - 1) * (2 * i)) as float
        term = term * (0.0 - reducedSquared) / denominator
        sum += term
    }
    return sum
}
fn ftan(x: float) -> float { return fsin(x) / fcos(x) }

fn fcsc(x: float) -> float { return 1.0 / fsin(x) }
fn fsec(x: float) -> float { return 1.0 / fcos(x) }
fn fcot(x: float) -> float { return fcos(x) / fsin(x) }

// The one new primitive everything below needs. Fold to [0,1] by sign and
// reciprocal, then a pi/6 shift puts |t| under tan(pi/12) = 0.268, where the
// alternating series reaches full double precision in 13 terms.
fn fatan(input: float) -> float {
    var folded = input
    var negative = false
    if folded < 0.0 {
        folded = 0.0 - folded
        negative = true
    }
    var inverted = false
    if folded > 1.0 {
        folded = 1.0 / folded
        inverted = true
    }
    var offset = 0.0
    var shifted = folded
    if folded > tanPiOver12 {
        shifted = (folded * sqrt3 - 1.0) / (folded + sqrt3)
        offset = piOver6
    }
    let negativeShiftedSquared = 0.0 - shifted * shifted
    var term = shifted
    var sum = shifted
    for i in 1..14 {
        term = term * negativeShiftedSquared
        sum += term / ((2 * i + 1) as float)
    }
    var result = offset + sum
    if inverted { result = halfPi - result }
    if negative { result = 0.0 - result }
    return result
}

// (1-x)*(1+x) rather than 1-x*x: the latter cancels as |x| approaches 1
fn fasin(x: float) -> float {
    if x > 1.0 or x < -1.0 { return nan }
    if x == 1.0 { return halfPi }
    if x == -1.0 { return 0.0 - halfPi }
    return fatan(x / sqrt((1.0 - x) * (1.0 + x)))
}

// 2*atan(sqrt((1-x)/(1+x))) holds its digits near x=1, where halfPi - fasin
// would cancel away the answer
fn facos(x: float) -> float {
    if x > 1.0 or x < -1.0 { return nan }
    if x == -1.0 { return pi }
    return 2.0 * fatan(sqrt((1.0 - x) / (1.0 + x)))
}

// Continuous branch, range (0,pi) -- the calculus convention, not the
// arctan(1/x) one that jumps at zero. Built from atan(1/x) rather than
// halfPi - atan(x), which cancels for large |x|.
fn facot(x: float) -> float {
    if x == 0.0 { return halfPi }
    if x > 0.0 { return fatan(1.0 / x) }
    return pi + fatan(1.0 / x)
}

fn fasec(x: float) -> float {
    if x < 1.0 and x > -1.0 { return nan }
    return facos(1.0 / x)
}

fn facsc(x: float) -> float {
    if x < 1.0 and x > -1.0 { return nan }
    return fasin(1.0 / x)
}

// Gudermannian: links circular and hyperbolic angle without complex numbers.
// 2*atan(tanh(x/2)) is the stable form; 2*atan(e^x) - pi/2 cancels at zero.
fn gd(x: float) -> float { return 2.0 * fatan(tanh(x / 2.0)) }

// inverse Gudermannian, which is also the antiderivative of sec
fn gdInverse(y: float) -> float {
    if y >= halfPi or y <= 0.0 - halfPi { return nan }
    return fln(fabs(fsec(y) + ftan(y)))
}

// Lanczos g=7, n=9. Evaluated in log space so the result survives the range
// of fexp and stays finite up to the true overflow point.
fn lanczosSum(z: float) -> float {
    var total = 0.99999999999980993
    total += 676.5203681218851 / (z + 1.0)
    total += (0.0 - 1259.1392167224028) / (z + 2.0)
    total += 771.32342877765313 / (z + 3.0)
    total += (0.0 - 176.61502916214059) / (z + 4.0)
    total += 12.507343278686905 / (z + 5.0)
    total += (0.0 - 0.13857109526572012) / (z + 6.0)
    total += 0.0000099843695780195716 / (z + 7.0)
    total += 0.00000015056327351493116 / (z + 8.0)
    return total
}

fn isNonPositiveInteger(x: float) -> bool {
    if x > 0.0 { return false }
    return x == (roundToInt(x) as float)
}

// log of the absolute value of gamma
fn lgamma(x: float) -> float {
    if isNonPositiveInteger(x) { return infinity }
    if x < 0.5 {
        // reflection: gamma(x)*gamma(1-x) = pi/sin(pi*x)
        return fln(pi / fabs(fsin(pi * x))) - lgamma(1.0 - x)
    }
    let z = x - 1.0
    let shifted = z + 7.5
    return 0.5 * fln(twoPi) + (z + 0.5) * fln(shifted) - shifted + fln(lanczosSum(z))
}

fn gamma(x: float) -> float {
    if isNonPositiveInteger(x) { return nan }
    if x > 171.62 { return infinity }
    if x < 0.5 { return pi / (fsin(pi * x) * gamma(1.0 - x)) }
    return fexp(lgamma(x))
}

// digamma is the logarithmic derivative of gamma. Recurrence up to x >= 6,
// then the asymptotic series.
fn digamma(input: float) -> float {
    if isNonPositiveInteger(input) { return nan }
    if input < 0.0 { return digamma(1.0 - input) - pi * fcot(pi * input) }
    var shifted = input
    var correction = 0.0
    // shift to 12, not 6: the series truncates after the 1/(132 x^10) term,
    // and at 6 that leaves ~5e-12, which is ruinous near the root at 1.4616
    while shifted < 12.0 {
        correction -= 1.0 / shifted
        shifted += 1.0
    }
    let inverseSquare = 1.0 / (shifted * shifted)
    let series = inverseSquare * (1.0 / 12.0 - inverseSquare * (1.0 / 120.0 - inverseSquare * (1.0 / 252.0 - inverseSquare * (1.0 / 240.0 - inverseSquare * (1.0 / 132.0)))))
    return correction + fln(shifted) - 0.5 / shifted - series
}

// ---- derivatives -----------------------------------------------------------
// One per function above. These are the VJP bodies for a future lib/ml tape;
// today they are ordinary functions, checkable by finite differences.

fn derivativeFsin(x: float) -> float { return fcos(x) }
fn derivativeFcos(x: float) -> float { return 0.0 - fsin(x) }
fn derivativeFtan(x: float) -> float { return fsec(x) * fsec(x) }
fn derivativeFcsc(x: float) -> float { return 0.0 - fcsc(x) * fcot(x) }
fn derivativeFsec(x: float) -> float { return fsec(x) * ftan(x) }
fn derivativeFcot(x: float) -> float { return 0.0 - fcsc(x) * fcsc(x) }

fn derivativeFasin(x: float) -> float {
    if x >= 1.0 or x <= -1.0 { return nan }
    return 1.0 / sqrt((1.0 - x) * (1.0 + x))
}

fn derivativeFacos(x: float) -> float {
    if x >= 1.0 or x <= -1.0 { return nan }
    return 0.0 - 1.0 / sqrt((1.0 - x) * (1.0 + x))
}

fn derivativeFatan(x: float) -> float { return 1.0 / (1.0 + x * x) }
fn derivativeFacot(x: float) -> float { return 0.0 - 1.0 / (1.0 + x * x) }

// the fabs here is not decoration: without it the sign is wrong for x < -1
fn derivativeFasec(x: float) -> float {
    if x <= 1.0 and x >= -1.0 { return nan }
    return 1.0 / (fabs(x) * sqrt(x * x - 1.0))
}

fn derivativeFacsc(x: float) -> float {
    if x <= 1.0 and x >= -1.0 { return nan }
    return 0.0 - 1.0 / (fabs(x) * sqrt(x * x - 1.0))
}

fn derivativeFln(x: float) -> float { return 1.0 / x }
fn derivativeFexp(x: float) -> float { return fexp(x) }
fn derivativeSinh(x: float) -> float { return cosh(x) }
fn derivativeCosh(x: float) -> float { return sinh(x) }

fn derivativeTanh(x: float) -> float {
    let tanhValue = tanh(x)
    return 1.0 - tanhValue * tanhValue
}

fn derivativeGd(x: float) -> float { return 1.0 / cosh(x) }
fn derivativeGdInverse(y: float) -> float { return fsec(y) }
fn derivativeLgamma(x: float) -> float { return digamma(x) }
fn derivativeGamma(x: float) -> float { return gamma(x) * digamma(x) }

// ---- quadrature ------------------------------------------------------------
// Adaptive Simpson with Richardson extrapolation. For the two functions above
// with no elementary antiderivative -- gamma and gd -- this is the only route.

fn simpson(integrand: fn(float) -> float, lower: float, upper: float) -> float {
    let middle = (lower + upper) / 2.0
    return (upper - lower) / 6.0 * (integrand(lower) + 4.0 * integrand(middle) + integrand(upper))
}

fn adaptiveSimpson(integrand: fn(float) -> float, lower: float, upper: float, tolerance: float, whole: float, depth: int) -> float {
    let middle = (lower + upper) / 2.0
    let left = simpson(integrand, lower, middle)
    let right = simpson(integrand, middle, upper)
    let delta = left + right - whole
    if depth <= 0 or fabs(delta) <= 15.0 * tolerance {
        return left + right + delta / 15.0
    }
    let leftResult = adaptiveSimpson(integrand, lower, middle, tolerance / 2.0, left, depth - 1)
    let rightResult = adaptiveSimpson(integrand, middle, upper, tolerance / 2.0, right, depth - 1)
    return leftResult + rightResult
}

// definite integral of f over [a,b]; eps is the absolute error target
fn integrate(integrand: fn(float) -> float, lower: float, upper: float, tolerance: float) -> float {
    if lower == upper { return 0.0 }
    if lower > upper { return 0.0 - integrate(integrand, upper, lower, tolerance) }
    return adaptiveSimpson(integrand, lower, upper, tolerance, simpson(integrand, lower, upper), 50)
}

// Same again for a one-parameter family f(t; p). Worth the duplication: the
// alternative is capturing p in a closure, which does not exist on wasm, or a
// module-level var, which would make the quadrature non-reentrant.

fn simpsonWithParameter(integrand: fn(float, float) -> float, parameter: float, lower: float, upper: float) -> float {
    let middle = (lower + upper) / 2.0
    return (upper - lower) / 6.0 * (integrand(lower, parameter) + 4.0 * integrand(middle, parameter) + integrand(upper, parameter))
}

fn adaptiveSimpsonWithParameter(integrand: fn(float, float) -> float, parameter: float, lower: float, upper: float, tolerance: float, whole: float, depth: int) -> float {
    let middle = (lower + upper) / 2.0
    let left = simpsonWithParameter(integrand, parameter, lower, middle)
    let right = simpsonWithParameter(integrand, parameter, middle, upper)
    let delta = left + right - whole
    if depth <= 0 or fabs(delta) <= 15.0 * tolerance {
        return left + right + delta / 15.0
    }
    let leftResult = adaptiveSimpsonWithParameter(integrand, parameter, lower, middle, tolerance / 2.0, left, depth - 1)
    let rightResult = adaptiveSimpsonWithParameter(integrand, parameter, middle, upper, tolerance / 2.0, right, depth - 1)
    return leftResult + rightResult
}

fn integrateWithParameter(integrand: fn(float, float) -> float, parameter: float, lower: float, upper: float, tolerance: float) -> float {
    if lower == upper { return 0.0 }
    if lower > upper { return 0.0 - integrateWithParameter(integrand, parameter, upper, lower, tolerance) }
    return adaptiveSimpsonWithParameter(integrand, parameter, lower, upper, tolerance, simpsonWithParameter(integrand, parameter, lower, upper), 50)
}

