// std/list.zeph â€” generic list algorithms, written in Zephyr.
//
// These used to be compiler builtins, because without generics there was no way
// to write "works for any element type" in the language itself. They are plain
// library code now. Call them directly, or as methods via UFCS:
//
//     import "std/list.zeph"
//     print(items.contains(3))        // == contains(items, 3)
//
// Instantiation is what type-checks each use: `contains` compiles `item == target` for
// the concrete T, so it works for int/str/enum and is rejected for element types
// that have no ==. No trait system needed â€” the monomorphisation is the contract.

fn contains[T](items: [T], target: T) -> bool {
    for item in items {
        if item == target { return true }
    }
    return false
}

fn indexOf[T](items: [T], target: T) -> int {
    for i in 0..items.len() {
        if items[i] == target { return i }
    }
    return 0 - 1
}

fn reverse[T](items: [T]) {
    var i = 0
    var j = items.len() - 1
    while i < j {
        let saved = items[i]
        items[i] = items[j]
        items[j] = saved
        i += 1
        j -= 1
    }
}

fn slice[T](items: [T], low: int, high: int) -> [T] {
    if low < 0 or high < low or high > items.len() { panic("slice out of range") }
    var result: [T] = []
    for i in low..high { result.push(items[i]) }
    return result
}

fn first[T](items: [T]) -> T? {
    if items.len() == 0 { return none }
    return items[0]
}

fn last[T](items: [T]) -> T? {
    if items.len() == 0 { return none }
    return items[items.len() - 1]
}

fn map[T, U](items: [T], transform: fn(T) -> U) -> [U] {
    var result: [U] = []
    for item in items { result.push(transform(item)) }
    return result
}

fn filter[T](items: [T], keep: fn(T) -> bool) -> [T] {
    var result: [T] = []
    for item in items {
        if keep(item) { result.push(item) }
    }
    return result
}

fn fold[T, A](items: [T], start: A, combine: fn(A, T) -> A) -> A {
    var accumulator = start
    for item in items { accumulator = combine(accumulator, item) }
    return accumulator
}

fn any[T](items: [T], predicate: fn(T) -> bool) -> bool {
    for item in items {
        if predicate(item) { return true }
    }
    return false
}

fn all[T](items: [T], predicate: fn(T) -> bool) -> bool {
    for item in items {
        if not predicate(item) { return false }
    }
    return true
}

fn count[T](items: [T], target: T) -> int {
    var matchCount = 0
    for item in items {
        if item == target { matchCount += 1 }
    }
    return matchCount
}

// Stable bottom-up merge sort: O(n log n) comparisons, O(n) scratch space.
// Runs of 8 are insertion-sorted first; merges alternate between the list and
// the scratch copy instead of copying back after every pass.
// compare(left, right) < 0 when left should come first; ties retain their original order.
fn sortBy[T](items: [T], compare: fn(T, T) -> int) {
    let length = items.len()
    if length < 2 { return }
    let runLength = 8
    var runStart = 0
    while runStart < length {
        let runEnd = min(runStart + runLength, length)
        for i in (runStart + 1)..runEnd {
            let value = items[i]
            var position = i
            while position > runStart and compare(items[position - 1], value) > 0 {
                items[position] = items[position - 1]
                position -= 1
            }
            items[position] = value
        }
        runStart = runEnd
    }
    if length <= runLength { return }
    var source = items
    var target = slice(items, 0, length)
    var inScratch = false
    var width = runLength
    while width < length {
        var start = 0
        while start < length {
            let middle = min(start + width, length)
            let end = min(middle + width, length)
            var leftIndex = start
            var rightIndex = middle
            var writeIndex = start
            while leftIndex < middle and rightIndex < end {
                if compare(source[leftIndex], source[rightIndex]) <= 0 {
                    target[writeIndex] = source[leftIndex]
                    leftIndex += 1
                } else {
                    target[writeIndex] = source[rightIndex]
                    rightIndex += 1
                }
                writeIndex += 1
            }
            if leftIndex == middle { leftIndex = rightIndex }
            for i in writeIndex..end {
                target[i] = source[leftIndex]
                leftIndex += 1
            }
            start = end
        }
        let merged = target
        target = source
        source = merged
        inScratch = not inScratch
        width *= 2
    }
    if inScratch {
        for i in 0..length { items[i] = source[i] }
    }
}

// Reductions require a nonempty list and the corresponding operator on T.
fn sum[T](items: [T]) -> T {
    if items.len() == 0 { panic("sum: empty list") }
    var total = items[0]
    for i in 1..items.len() { total = total + items[i] }
    return total
}

fn minOf[T](items: [T]) -> T {
    if items.len() == 0 { panic("minOf: empty list") }
    var smallest = items[0]
    for i in 1..items.len() { if items[i] < smallest { smallest = items[i] } }
    return smallest
}

fn maxOf[T](items: [T]) -> T {
    if items.len() == 0 { panic("maxOf: empty list") }
    var largest = items[0]
    for i in 1..items.len() { if items[i] > largest { largest = items[i] } }
    return largest
}
