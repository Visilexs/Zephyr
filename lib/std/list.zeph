// std/list.zeph — generic list algorithms, written in Zephyr.
//
// These used to be compiler builtins, because without generics there was no way
// to write "works for any element type" in the language itself. They are plain
// library code now. Call them directly, or as methods via UFCS:
//
//     import "std/list.zeph"
//     print(xs.contains(3))        // == contains(xs, 3)
//
// Instantiation is what type-checks each use: `contains` compiles `v == x` for
// the concrete T, so it works for int/str/enum and is rejected for element types
// that have no ==. No trait system needed — the monomorphisation is the contract.

fn contains[T](xs: [T], x: T) -> bool {
    for v in xs {
        if v == x { return true }
    }
    return false
}

fn index_of[T](xs: [T], x: T) -> int {
    for i in 0..xs.len() {
        if xs[i] == x { return i }
    }
    return 0 - 1
}

fn reverse[T](xs: [T]) {
    var i = 0
    var j = xs.len() - 1
    while i < j {
        let t = xs[i]
        xs[i] = xs[j]
        xs[j] = t
        i += 1
        j -= 1
    }
}

fn slice[T](xs: [T], lo: int, hi: int) -> [T] {
    if lo < 0 or hi < lo or hi > xs.len() { panic("slice out of range") }
    var out: [T] = []
    for i in lo..hi { out.push(xs[i]) }
    return out
}

fn first[T](xs: [T]) -> T? {
    if xs.len() == 0 { return none }
    return xs[0]
}

fn last[T](xs: [T]) -> T? {
    if xs.len() == 0 { return none }
    return xs[xs.len() - 1]
}

fn map[T, U](xs: [T], f: fn(T) -> U) -> [U] {
    var out: [U] = []
    for x in xs { out.push(f(x)) }
    return out
}

fn filter[T](xs: [T], keep: fn(T) -> bool) -> [T] {
    var out: [T] = []
    for x in xs {
        if keep(x) { out.push(x) }
    }
    return out
}

fn fold[T, A](xs: [T], start: A, f: fn(A, T) -> A) -> A {
    var acc = start
    for x in xs { acc = f(acc, x) }
    return acc
}

fn any[T](xs: [T], pred: fn(T) -> bool) -> bool {
    for x in xs {
        if pred(x) { return true }
    }
    return false
}

fn all[T](xs: [T], pred: fn(T) -> bool) -> bool {
    for x in xs {
        if not pred(x) { return false }
    }
    return true
}

fn count[T](xs: [T], x: T) -> int {
    var n = 0
    for v in xs {
        if v == x { n += 1 }
    }
    return n
}

// Stable bottom-up merge sort: O(n log n) comparisons, O(n) scratch space.
// cmp(a, b) < 0 when a should come first; ties retain their original order.
fn sort_by[T](xs: [T], cmp: fn(T, T) -> int) {
    let length = xs.len()
    if length < 2 { return }
    let scratch = slice(xs, 0, length)
    var width = 1
    while width < length {
        var start = 0
        while start < length {
            let middle = min(start + width, length)
            let end = min(middle + width, length)
            var leftIndex = start
            var rightIndex = middle
            for i in start..end {
                if leftIndex < middle and (rightIndex >= end or cmp(xs[leftIndex], xs[rightIndex]) <= 0) {
                    scratch[i] = xs[leftIndex]
                    leftIndex += 1
                } else {
                    scratch[i] = xs[rightIndex]
                    rightIndex += 1
                }
            }
            start = end
        }
        for i in 0..length { xs[i] = scratch[i] }
        width *= 2
    }
}

// Reductions require a nonempty list and the corresponding operator on T.
fn sum[T](xs: [T]) -> T {
    if xs.len() == 0 { panic("sum: empty list") }
    var total = xs[0]
    for i in 1..xs.len() { total = total + xs[i] }
    return total
}

fn min_of[T](xs: [T]) -> T {
    if xs.len() == 0 { panic("min_of: empty list") }
    var smallest = xs[0]
    for i in 1..xs.len() { if xs[i] < smallest { smallest = xs[i] } }
    return smallest
}

fn max_of[T](xs: [T]) -> T {
    if xs.len() == 0 { panic("max_of: empty list") }
    var largest = xs[0]
    for i in 1..xs.len() { if xs[i] > largest { largest = xs[i] } }
    return largest
}
