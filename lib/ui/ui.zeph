// ui.zeph -- an immediate-mode GUI toolkit for Zephyr.
//
// Native Win32, drawn through GDI (real TrueType text, crisp filled rects),
// double-buffered so it never flickers. Input (mouse + keyboard) is polled each
// frame, so there's no window-procedure callback to wire up. Pure Zephyr on top
// of the win() FFI to user32/gdi32.
//
// Immediate mode means there is no widget tree and no retained state you have to
// manage: you call widget functions every frame and they both draw and report
// interaction. Because Zephyr has no pointers, mutable widgets are FUNCTIONAL --
// they take the current value and return the new one:
//
//     uiInitialize("Demo", 900, 620)
//     var vol = 0.5
//     var on  = true
//     while uiRunning() {
//         uiBeginFrame()
//         uiPanel(30, 30, 320, 400, "Settings")
//         if uiButton(1, "Apply") { ... }
//         on  = uiCheckbox(2, "Enabled", on)
//         vol = uiSlider(3, "Volume", vol, 0.0, 1.0)
//         uiEndFrame()
//     }
//
// See examples/ui_demo.zeph for a full showcase.

// ---- raw, permanent memory (VirtualAlloc, never GC-managed) ----
fn allocatePermanentMemory(byteCount: int) -> int {
    // MEM_COMMIT|MEM_RESERVE = 0x3000, PAGE_READWRITE = 4
    return win("VirtualAlloc", 0, byteCount, 12288, 4)
}

var scratchStringBuffer = 0                 // scratch C-string buffer (one at a time)
fn scratchCString(text: str) -> int {
    let length = text.len()
    var i = 0
    while i < length {
        store8(scratchStringBuffer + i, text.byte(i))
        i += 1
    }
    store8(scratchStringBuffer + length, 0)
    return scratchStringBuffer
}
// a permanent copy (its own buffer), for strings that must outlive the scratch
fn permanentCString(text: str) -> int {
    let length = text.len()
    let address = allocatePermanentMemory(length + 1)
    var i = 0
    while i < length {
        store8(address + i, text.byte(i))
        i += 1
    }
    store8(address + length, 0)
    return address
}
fn rgb(red: int, green: int, blue: int) -> int { return red + green * 256 + blue * 65536 }
fn low32Bits(value: int) -> int { return value & 4294967295 }
fn signExtend32(value: int) -> int {           // sign-extend a 32-bit field
    let lowBits = value & 4294967295
    if lowBits >= 2147483648 { return lowBits - 4294967296 }
    return lowBits
}

// ---- theme (JetBrains "New UI" dark) ----
// One flat surface colour everywhere; regions are separated by 1px seams that
// are DARKER than the surface, never lighter. Interaction = rounded rects.
let colorBackground     = rgb(30, 31, 34)      // editor / darkest surface  (#1E1F22)
let colorPanel  = rgb(43, 45, 48)      // tool windows, bars        (#2B2D30)
let colorTitle  = rgb(43, 45, 48)      // toolbar/status: Gray2 (real MainToolbar.background)
let colorItem   = rgb(57, 59, 64)      // hover                     (#393B40)
let colorHot    = rgb(67, 69, 74)      // pressed: Gray4 #43454A (exact)
let colorActive = rgb(46, 67, 110)     // selection blue            (#2E436E)
let colorAccent = rgb(53, 116, 240)    // accent blue               (#3574F0)
let colorText   = rgb(223, 225, 229)   // primary text              (#DFE1E5)
let colorDim    = rgb(157, 160, 168)   // secondary text            (#9DA0A8)
let colorFaint  = rgb(111, 115, 122)   // tertiary (line numbers)   (#6F737A)
let colorBorder = rgb(30, 31, 34)      // seams between regions (darker!)
let colorOutline= rgb(78, 81, 87)      // widget outlines (buttons, fields)
let colorTrack  = rgb(35, 36, 40)      // slider/progress track
let colorField  = rgb(30, 31, 34)      // text field background

let innerPadding = 8                       // inner padding
let widgetGap = 7                       // vertical gap between rows
let defaultRowHeight = 26                     // default widget height

// ---- state ----
var windowHandle = 0
var windowHdc = 0                     // window DC
var backBufferHdc = 0                     // memory (back buffer) DC
var backBufferBitmap = 0
var backBufferWidth = 0
var backBufferHeight = 0
var normalFont = 0
var boldFont = 0                   // bold font (titles)
var monospaceFont = 0                   // monospace (code)
var wheelNotchesPending = 0                   // wheel notches accumulated by the pump
var wheelNotchesThisFrame = 0                  // wheel notches available this frame
var clientWidth = 0                      // client width
var clientHeight = 0                      // client height
var windowRunning = 1

var scratchRect = 0                    // scratch RECT
var scratchPoint = 0                      // scratch POINT
var scratchSize = 0                    // scratch SIZE
var windowClass = 0
var messageBuffer = 0

var mouseX = 0                      // mouse x/y in client space
var mouseY = 0
var mouseDown = false               // left button down this frame
var mouseDownLastFrame = false               // ... last frame
var mousePressed = false               // pressed this frame (down & !prev)
var mouseReleased = false             // released this frame
var windowFocused = false             // our window is foreground

var hotWidgetId = 0                     // widget id under the cursor
var treeRowIconX = 0                  // last uiTreeRow icon center x (for SVG overlay)
var treeRowIconY = 0                  // last uiTreeRow icon center y
var stripCursorX = 0                 // right-to-left toolbar strip cursor
var stripCursorY = 0                 // top-to-bottom rail strip cursor
var activeWidgetId = 0                  // widget id being manipulated

// keyboard: previous key states, and text typed this frame
var previousKeyStates = 0                 // 256-byte table
var typedText: str = ""             // printable chars typed this frame
var backspaceCount = 0                      // backspace count this frame
var enterPressed = false
var focusedFieldId = 0                // focused text field
var fieldClicked = false           // a text field was clicked this frame
var frameCounter = 0                   // frame counter (caret blink)

// layout cursor
var layoutCursorX = 0
var layoutCursorY = 0
var contentX = 0
var contentWidth = 0
var currentRowHeight = 0
var sameLine = false
var rowPending = false
var widgetX = 0                      // last widget rect
var widgetY = 0
var widgetWidth = 0
var widgetHeight = 0
var furthestY = 0                    // furthest y reached (for scroll content height)

fn uiInitialize(title: str, width: int, height: int) {
    scratchStringBuffer = allocatePermanentMemory(2048)
    scratchRect = allocatePermanentMemory(16)
    scratchPoint = allocatePermanentMemory(16)
    scratchSize = allocatePermanentMemory(16)
    allocateWindowStructures()
    let instanceHandle = win("GetModuleHandleA", 0)
    let user32Module = win("GetModuleHandleA", scratchCString("user32.dll"))
    let defaultWindowProcedure = win("GetProcAddress", user32Module, scratchCString("DefWindowProcA"))
    let className = permanentCString("zephyrUiWindow")
    store32(windowClass + 0, 3)                            // CS_HREDRAW|CS_VREDRAW
    store64(windowClass + 8, defaultWindowProcedure)
    store64(windowClass + 24, instanceHandle)
    store64(windowClass + 40, win("user32!LoadCursorA", 0, 32512))   // IDC_ARROW
    // dark class brush: area exposed during OS moves/resizes paints theme-dark
    // instead of undefined (white); steady-state frames never invalidate, so no flicker
    store64(windowClass + 48, win("gdi32!CreateSolidBrush", 2236190))   // #1E1F22 as BGR
    store64(windowClass + 64, className)
    let atom = win("user32!RegisterClassA", windowClass)
    windowHandle = win("user32!CreateWindowExA", 0, className, scratchCString(title),
        282001408, 90, 70, width, height, 0, 0, instanceHandle, 0)     // WS_OVERLAPPEDWINDOW|WS_VISIBLE
    let wasVisible = win("user32!ShowWindow", windowHandle, 5)
    // fonts: CreateFontA(height, w, esc, orient, weight, italic, ul, so, charset,
    //                    outprec, clipprec, quality, pitch, face)
    normalFont = win("gdi32!CreateFontA", 0 - 15, 0, 0, 0, 400, 0, 0, 0, 0, 0, 0, 5, 0, scratchCString("Segoe UI"))
    boldFont = win("gdi32!CreateFontA", 0 - 17, 0, 0, 0, 700, 0, 0, 0, 0, 0, 0, 5, 0, scratchCString("Segoe UI"))
    monospaceFont = win("gdi32!CreateFontA", 0 - 15, 0, 0, 0, 400, 0, 0, 0, 0, 0, 0, 49, 0, scratchCString("Consolas"))
    previousKeyStates = allocatePermanentMemory(256)
}
fn allocateWindowStructures() {
    windowClass = allocatePermanentMemory(80)
    messageBuffer = allocatePermanentMemory(64)
}

// keep the message queue drained; report whether the window still exists
fn uiRunning() -> bool {
    while win("user32!PeekMessageA", messageBuffer, 0, 0, 0, 1) != 0 {
        let messageId = low32Bits(load64(messageBuffer + 8))
        if messageId == 18 { windowRunning = 0 }                          // WM_QUIT
        if messageId == 522 {                                         // WM_MOUSEWHEEL
            var wheelDelta = (load64(messageBuffer + 16) >> 16) & 65535        // high word of wParam = delta
            if wheelDelta >= 32768 { wheelDelta = wheelDelta - 65536 }
            wheelNotchesPending += wheelDelta / 120
        }
        let translated = win("user32!TranslateMessage", messageBuffer)
        let dispatched = win("user32!DispatchMessageA", messageBuffer)
    }
    if win("user32!IsWindow", windowHandle) == 0 { windowRunning = 0 }
    return windowRunning == 1
}

// grab client size and (re)build the back buffer if it changed
fn ensureBackBuffer() {
    let gotRect = win("user32!GetClientRect", windowHandle, scratchRect)
    clientWidth = signExtend32(load64(scratchRect + 8))
    clientHeight = signExtend32(load64(scratchRect + 12))
    if clientWidth < 1 { clientWidth = 1 }
    if clientHeight < 1 { clientHeight = 1 }
    if windowHdc == 0 { windowHdc = win("user32!GetDC", windowHandle) }
    if backBufferHdc == 0 { backBufferHdc = win("gdi32!CreateCompatibleDC", windowHdc) }
    if clientWidth != backBufferWidth or clientHeight != backBufferHeight {
        if backBufferBitmap != 0 { let deleted = win("gdi32!DeleteObject", backBufferBitmap) }
        backBufferBitmap = win("gdi32!CreateCompatibleBitmap", windowHdc, clientWidth, clientHeight)
        let previousBitmap = win("gdi32!SelectObject", backBufferHdc, backBufferBitmap)
        backBufferWidth = clientWidth
        backBufferHeight = clientHeight
    }
    let previousFont = win("gdi32!SelectObject", backBufferHdc, normalFont)
    let previousBackgroundMode = win("gdi32!SetBkMode", backBufferHdc, 1)         // TRANSPARENT
}

fn pollInput() {
    // mouse position in client space
    let gotCursor = win("user32!GetCursorPos", scratchPoint)
    let converted = win("user32!ScreenToClient", windowHandle, scratchPoint)
    mouseX = signExtend32(load64(scratchPoint + 0))
    mouseY = signExtend32(load64(scratchPoint + 4))
    windowFocused = win("user32!GetForegroundWindow") == windowHandle
    mouseDownLastFrame = mouseDown
    mouseDown = false
    if windowFocused {
        if win("user32!GetAsyncKeyState", 1) & 32768 != 0 { mouseDown = true }   // VK_LBUTTON
    }
    mousePressed = mouseDown and not mouseDownLastFrame
    mouseReleased = (not mouseDown) and mouseDownLastFrame
    wheelNotchesThisFrame = wheelNotchesPending
    wheelNotchesPending = 0
    // keyboard -> typed chars this frame (transitions up->down)
    typedText = ""
    backspaceCount = 0
    enterPressed = false
    if windowFocused {
        let shift = win("user32!GetAsyncKeyState", 16) & 32768 != 0    // VK_SHIFT
        var virtualKey = 8
        while virtualKey < 223 {
            let downNow = win("user32!GetAsyncKeyState", virtualKey) & 32768 != 0
            let wasDown = load8(previousKeyStates + virtualKey) != 0
            if downNow and not wasDown { handleKeyPress(virtualKey, shift) }
            if downNow { store8(previousKeyStates + virtualKey, 1) } else { store8(previousKeyStates + virtualKey, 0) }
            virtualKey += 1
        }
    }
}

fn handleKeyPress(virtualKey: int, shift: bool) {
    if virtualKey == 8 {
        backspaceCount += 1
        return
    }
    if virtualKey == 13 {
        enterPressed = true
        return
    }
    var character = 0
    if virtualKey >= 65 and virtualKey <= 90 {                       // letters
        if shift { character = virtualKey } else { character = virtualKey + 32 }
    } else if virtualKey >= 48 and virtualKey <= 57 {                // digits / shifted symbols
        if shift { character = ")!@#$%^&*(".byte(virtualKey - 48) } else { character = virtualKey }
    } else if virtualKey == 32 { character = 32 }
    else if virtualKey == 190 { if shift { character = 62 } else { character = 46 } }   // . >
    else if virtualKey == 188 { if shift { character = 60 } else { character = 44 } }   // , <
    else if virtualKey == 189 { if shift { character = 95 } else { character = 45 } }   // - _
    else if virtualKey == 191 { if shift { character = 63 } else { character = 47 } }   // / ?
    if character != 0 { typedText = typedText + chr(character) }
}

// ---- drawing primitives (into the back buffer) ----
fn fill(x: int, y: int, width: int, height: int, color: int) {
    store32(scratchRect + 0, x)
    store32(scratchRect + 4, y)
    store32(scratchRect + 8, x + width)
    store32(scratchRect + 12, y + height)
    let brush = win("gdi32!CreateSolidBrush", color)
    let filled = win("user32!FillRect", backBufferHdc, scratchRect, brush)
    let deleted = win("gdi32!DeleteObject", brush)
}
fn frame(x: int, y: int, width: int, height: int, color: int) {   // 1px border
    fill(x, y, width, 1, color)
    fill(x, y + height - 1, width, 1, color)
    fill(x, y, 1, height, color)
    fill(x + width - 1, y, 1, height, color)
}
// rounded fill / outline (r = corner diameter, ~8 for the JetBrains look)
fn fillRoundRect(x: int, y: int, width: int, height: int, cornerDiameter: int, color: int) {
    let brush = win("gdi32!CreateSolidBrush", color)
    let pen = win("gdi32!CreatePen", 0, 1, color)
    let previousBrush = win("gdi32!SelectObject", backBufferHdc, brush)
    let previousPen = win("gdi32!SelectObject", backBufferHdc, pen)
    let drawn = win("gdi32!RoundRect", backBufferHdc, x, y, x + width, y + height, cornerDiameter, cornerDiameter)
    let restoredBrush = win("gdi32!SelectObject", backBufferHdc, previousBrush)
    let restoredPen = win("gdi32!SelectObject", backBufferHdc, previousPen)
    let brushDeleted = win("gdi32!DeleteObject", brush)
    let penDeleted = win("gdi32!DeleteObject", pen)
}
fn frameRoundRect(x: int, y: int, width: int, height: int, cornerDiameter: int, color: int) {
    let pen = win("gdi32!CreatePen", 0, 1, color)
    let nullBrush = win("gdi32!GetStockObject", 5)          // NULL_BRUSH
    let previousBrush = win("gdi32!SelectObject", backBufferHdc, nullBrush)
    let previousPen = win("gdi32!SelectObject", backBufferHdc, pen)
    let drawn = win("gdi32!RoundRect", backBufferHdc, x, y, x + width, y + height, cornerDiameter, cornerDiameter)
    let restoredBrush = win("gdi32!SelectObject", backBufferHdc, previousBrush)
    let restoredPen = win("gdi32!SelectObject", backBufferHdc, previousPen)
    let penDeleted = win("gdi32!DeleteObject", pen)
}
fn textWidth(text: str) -> int {
    let measured = win("gdi32!GetTextExtentPoint32A", backBufferHdc, scratchCString(text), text.len(), scratchSize)
    return signExtend32(load64(scratchSize + 0))
}
fn drawText(x: int, y: int, text: str, color: int) {
    let previousColor = win("gdi32!SetTextColor", backBufferHdc, color)
    let drawn = win("gdi32!TextOutA", backBufferHdc, x, y, scratchCString(text), text.len())
}
fn drawTextCentered(x: int, y: int, width: int, height: int, text: str, color: int) {   // centered in a box
    let measuredWidth = textWidth(text)
    drawText(x + (width - measuredWidth) / 2, y + (height - 15) / 2, text, color)
}
fn drawTextVerticallyCentered(x: int, y: int, height: int, text: str, color: int) {          // vertically centered, left
    drawText(x, y + (height - 15) / 2, text, color)
}

// ---- frame lifecycle ----
fn uiBeginFrame() {
    frameCounter += 1
    ensureBackBuffer()
    pollInput()
    fill(0, 0, clientWidth, clientHeight, colorBackground)
    hotWidgetId = 0
    fieldClicked = false
    // reset layout to the whole client; a panel narrows it
    contentX = innerPadding
    contentWidth = clientWidth - innerPadding * 2
    layoutCursorX = innerPadding
    layoutCursorY = innerPadding
    currentRowHeight = 0
    sameLine = false
    rowPending = false
}
fn uiEndFrame() {
    // a click that missed every text field drops focus
    if mousePressed and not fieldClicked { focusedFieldId = 0 }
    let blitted = win("gdi32!BitBlt", windowHdc, 0, 0, clientWidth, clientHeight, backBufferHdc, 0, 0, 13369376)  // SRCCOPY
}

// ---- layout ----
fn beginWidget(width: int, height: int) {
    if not sameLine {
        if rowPending {
            layoutCursorY = layoutCursorY + currentRowHeight + widgetGap
            currentRowHeight = 0
        }
        layoutCursorX = contentX
        rowPending = true
    }
    var resolvedWidth = width
    if resolvedWidth <= 0 { resolvedWidth = contentX + contentWidth - layoutCursorX }   // fill remaining width
    widgetX = layoutCursorX
    widgetY = layoutCursorY
    widgetWidth = resolvedWidth
    widgetHeight = height
    layoutCursorX = layoutCursorX + resolvedWidth + widgetGap
    if height > currentRowHeight { currentRowHeight = height }
    if layoutCursorY + height > furthestY { furthestY = layoutCursorY + height }
    sameLine = false
}
fn uiSameLine() { sameLine = true }
fn uiSpacing() { layoutCursorY = layoutCursorY + 6 }
fn uiSeparator() {
    if rowPending {
        layoutCursorY = layoutCursorY + currentRowHeight + widgetGap
        currentRowHeight = 0
        rowPending = false
    }
    layoutCursorX = contentX
    fill(contentX, layoutCursorY + 3, contentWidth, 1, colorBorder)
    layoutCursorY = layoutCursorY + 8
}

// a panel: draws a titled container and constrains following widgets to it
fn uiPanel(x: int, y: int, width: int, height: int, title: str) {
    fillRoundRect(x, y, width, height, 14, colorPanel)
    var contentTop = y
    if title.len() > 0 {
        let previousFont = win("gdi32!SelectObject", backBufferHdc, boldFont)
        drawText(x + innerPadding + 4, y + 8, title, colorText)
        let restoredFont = win("gdi32!SelectObject", backBufferHdc, normalFont)
        fill(x + innerPadding, y + 31, width - innerPadding * 2, 1, colorBorder)
        contentTop = y + 34
    }
    contentX = x + innerPadding
    contentWidth = width - innerPadding * 2
    layoutCursorX = contentX
    layoutCursorY = contentTop + innerPadding
    currentRowHeight = 0
    sameLine = false
    rowPending = false
}

fn hit(x: int, y: int, width: int, height: int) -> bool {
    return mouseX >= x and mouseX < x + width and mouseY >= y and mouseY < y + height
}

// round a float to a 2-decimal display string
fn formatTwoDecimals(value: float) -> str {
    var magnitude = value
    var signText = ""
    if magnitude < 0.0 {
        signText = "-"
        magnitude = 0.0 - magnitude
    }
    let scaled = (magnitude * 100.0 + 0.5) as int
    let wholePart = scaled / 100
    let hundredths = scaled - wholePart * 100
    var hundredthsText = hundredths as str
    if hundredths < 10 { hundredthsText = "0" + hundredthsText }
    return signText + (wholePart as str) + "." + hundredthsText
}

// shared button-like interaction: returns true on a click (press+release inside)
fn pressClick(id: int, x: int, y: int, width: int, height: int) -> bool {
    let over = hit(x, y, width, height)
    if over { hotWidgetId = id }
    var clicked = false
    if activeWidgetId == id {
        if mouseReleased {
            if over { clicked = true }
            activeWidgetId = 0
        }
    } else if over and mousePressed {
        activeWidgetId = id
    }
    return clicked
}

// ---- widgets ----
fn uiLabel(text: str) {
    beginWidget(0, 19)
    drawText(widgetX, widgetY + 2, text, colorText)
}
fn uiDimText(text: str) {
    beginWidget(0, 19)
    drawText(widgetX, widgetY + 2, text, colorDim)
}
fn uiHeading(text: str) {
    beginWidget(0, 24)
    let previousFont = win("gdi32!SelectObject", backBufferHdc, boldFont)
    drawText(widgetX, widgetY + 2, text, colorText)
    let restoredFont = win("gdi32!SelectObject", backBufferHdc, normalFont)
}

fn uiButton(id: int, label: str) -> bool {
    let buttonWidth = textWidth(label) + 30
    beginWidget(buttonWidth, defaultRowHeight)
    let x = widgetX
    let y = widgetY
    let width = widgetWidth
    let height = widgetHeight
    let clicked = pressClick(id, x, y, width, height)
    var color = colorItem
    if hotWidgetId == id { color = colorHot }
    if activeWidgetId == id { color = colorAccent }
    fillRoundRect(x, y, width, height, 10, color)
    if activeWidgetId != id { frameRoundRect(x, y, width, height, 10, colorOutline) }
    drawTextCentered(x, y, width, height, label, colorText)
    return clicked
}
// full-width button (menus, dialogs)
fn uiButtonWide(id: int, label: str) -> bool {
    beginWidget(0, defaultRowHeight)
    let x = widgetX
    let y = widgetY
    let width = widgetWidth
    let height = widgetHeight
    let clicked = pressClick(id, x, y, width, height)
    var color = colorItem
    if hotWidgetId == id { color = colorHot }
    if activeWidgetId == id { color = colorAccent }
    fillRoundRect(x, y, width, height, 10, color)
    if activeWidgetId != id { frameRoundRect(x, y, width, height, 10, colorOutline) }
    drawTextCentered(x, y, width, height, label, colorText)
    return clicked
}

fn uiCheckbox(id: int, label: str, value: bool) -> bool {
    let boxSize = 20
    beginWidget(boxSize + 8 + textWidth(label), defaultRowHeight)
    let x = widgetX
    let y = widgetY
    let height = widgetHeight
    let clicked = pressClick(id, x, y, widgetWidth, height)
    var checked = value
    if clicked { checked = not value }
    let boxY = y + (height - boxSize) / 2
    if checked {
        fillRoundRect(x, boxY, boxSize, boxSize, 8, colorAccent)
        // check mark
        fill(x + 4, boxY + 9, 2, 2, colorText)
        fill(x + 5, boxY + 10, 2, 2, colorText)
        fill(x + 6, boxY + 11, 2, 2, colorText)
        fill(x + 8, boxY + 10, 2, 2, colorText)
        fill(x + 9, boxY + 9, 2, 2, colorText)
        fill(x + 10, boxY + 8, 2, 2, colorText)
        fill(x + 11, boxY + 7, 2, 2, colorText)
        fill(x + 12, boxY + 6, 2, 2, colorText)
        fill(x + 13, boxY + 5, 2, 2, colorText)
    } else {
        var outlineColor = colorOutline
        if hotWidgetId == id { outlineColor = colorDim }
        fillRoundRect(x, boxY, boxSize, boxSize, 8, colorField)
        frameRoundRect(x, boxY, boxSize, boxSize, 8, outlineColor)
    }
    drawTextVerticallyCentered(x + boxSize + 8, y, height, label, colorText)
    return checked
}

fn uiRadio(id: int, label: str, current: int, optionValue: int) -> int {
    let boxSize = 18
    beginWidget(boxSize + 8 + textWidth(label), defaultRowHeight)
    let x = widgetX
    let y = widgetY
    let height = widgetHeight
    let clicked = pressClick(id, x, y, widgetWidth, height)
    var selected = current
    if clicked { selected = optionValue }
    let boxY = y + (height - boxSize) / 2
    if selected == optionValue {
        fillRoundRect(x, boxY, boxSize, boxSize, boxSize, colorAccent)
        fillRoundRect(x + 6, boxY + 6, boxSize - 12, boxSize - 12, boxSize, colorText)
    } else {
        var outlineColor = colorOutline
        if hotWidgetId == id { outlineColor = colorDim }
        fillRoundRect(x, boxY, boxSize, boxSize, boxSize, colorField)
        frameRoundRect(x, boxY, boxSize, boxSize, boxSize, outlineColor)
    }
    drawTextVerticallyCentered(x + boxSize + 8, y, height, label, colorText)
    return selected
}

fn uiSlider(id: int, label: str, value: float, minimum: float, maximum: float) -> float {
    beginWidget(0, defaultRowHeight)
    let x = widgetX
    let y = widgetY
    let width = widgetWidth
    let height = widgetHeight
    let labelWidth = 96
    let valueWidth = 52
    let trackX = x + labelWidth
    let trackWidth = width - labelWidth - valueWidth
    let over = hit(trackX, y, trackWidth, height)
    if over { hotWidgetId = id }
    var result = value
    if activeWidgetId == id or (over and mousePressed) {
        activeWidgetId = id
        var dragFraction = ((mouseX - (trackX + 6)) as float) / ((trackWidth - 12) as float)
        if dragFraction < 0.0 { dragFraction = 0.0 }
        if dragFraction > 1.0 { dragFraction = 1.0 }
        result = minimum + dragFraction * (maximum - minimum)
        if mouseReleased { activeWidgetId = 0 }
    }
    drawTextVerticallyCentered(x, y, height, label, colorDim)
    let trackY = y + height / 2 - 2
    fillRoundRect(trackX, trackY, trackWidth, 4, 4, colorOutline)
    var fillFraction = (result - minimum) / (maximum - minimum)
    if fillFraction < 0.0 { fillFraction = 0.0 }
    if fillFraction > 1.0 { fillFraction = 1.0 }
    let fillWidth = (fillFraction * ((trackWidth - 14) as float)) as int
    fillRoundRect(trackX, trackY, fillWidth + 8, 4, 4, colorAccent)
    let knobX = trackX + fillWidth
    var knobColor = colorText
    if activeWidgetId == id { knobColor = colorAccent }
    fillRoundRect(knobX, y + height / 2 - 7, 14, 14, 14, knobColor)
    if activeWidgetId != id { frameRoundRect(knobX, y + height / 2 - 7, 14, 14, 14, colorOutline) }
    drawText(trackX + trackWidth + 8, y + (height - 15) / 2, formatTwoDecimals(result), colorText)
    return result
}

fn uiSliderInt(id: int, label: str, value: int, minimum: int, maximum: int) -> int {
    let floatResult = uiSlider(id, label, value as float, minimum as float, maximum as float)
    return (floatResult + 0.5) as int
}

fn uiProgressBar(fraction: float, label: str) {
    beginWidget(0, 20)
    let x = widgetX
    let y = widgetY
    let width = widgetWidth
    let height = widgetHeight
    var clampedFraction = fraction
    if clampedFraction < 0.0 { clampedFraction = 0.0 }
    if clampedFraction > 1.0 { clampedFraction = 1.0 }
    fillRoundRect(x, y, width, height, 10, colorTrack)
    let fillWidth = (clampedFraction * (width as float)) as int
    if fillWidth > 4 { fillRoundRect(x, y, fillWidth, height, 10, colorAccent) }
    if label.len() > 0 { drawTextCentered(x, y, width, height, label, colorText) }
}

fn uiTextBox(id: int, value: str) -> str {
    beginWidget(0, defaultRowHeight + 2)
    let x = widgetX
    let y = widgetY
    let width = widgetWidth
    let height = widgetHeight
    let over = hit(x, y, width, height)
    if over { hotWidgetId = id }
    if over and mousePressed {
        focusedFieldId = id
        fieldClicked = true
    }
    var text = value
    if focusedFieldId == id {
        var i = 0
        while i < backspaceCount {
            if text.len() > 0 { text = text.sub(0, text.len() - 1) }
            i += 1
        }
        text = text + typedText
    }
    var borderColor = colorOutline
    if hotWidgetId == id { borderColor = colorDim }
    if focusedFieldId == id { borderColor = colorAccent }
    fillRoundRect(x, y, width, height, 10, colorField)
    frameRoundRect(x, y, width, height, 10, borderColor)
    drawText(x + 8, y + (height - 15) / 2, text, colorText)
    if focusedFieldId == id and (frameCounter / 25) % 2 == 0 {
        let caretX = x + 8 + textWidth(text) + 1
        fill(caretX, y + 5, 2, height - 10, colorAccent)
    }
    return text
}

// a tab in a tab bar: place several on one row with uiSameLine(). Returns the
// selected index (this tab's `index` if clicked, else `current`).
fn uiTab(id: int, label: str, current: int, index: int) -> int {
    let tabWidth = textWidth(label) + 26
    beginWidget(tabWidth, defaultRowHeight)
    let x = widgetX
    let y = widgetY
    let width = widgetWidth
    let height = widgetHeight
    let clicked = pressClick(id, x, y, width, height)
    var selected = current
    if clicked { selected = index }
    if hotWidgetId == id and selected != index { fillRoundRect(x, y + 2, width, height - 4, 8, colorItem) }
    if selected == index { fillRoundRect(x + 4, y + height - 3, width - 8, 3, 3, colorAccent) }
    var textColor = colorDim
    if selected == index or hotWidgetId == id { textColor = colorText }
    drawTextCentered(x, y, width, height, label, textColor)
    return selected
}

// a collapsing section header: returns the new open/closed state (guard the
// section's widgets with `if uiCollapsingHeader(...) { ... }`)
fn uiCollapsingHeader(id: int, label: str, open: bool) -> bool {
    beginWidget(0, defaultRowHeight)
    let x = widgetX
    let y = widgetY
    let width = widgetWidth
    let height = widgetHeight
    let clicked = pressClick(id, x, y, width, height)
    var expanded = open
    if clicked { expanded = not open }
    if hotWidgetId == id { fillRoundRect(x, y, width, height, 8, colorItem) }
    let chevronX = x + 10
    let chevronY = y + height / 2
    if expanded { drawChevronDown(chevronX, chevronY, colorDim) } else { drawChevronRight(chevronX, chevronY, colorDim) }
    drawTextVerticallyCentered(x + 24, y, height, label, colorText)
    return expanded
}

// small chevron glyphs (expanders, dropdowns)
fn drawChevronDown(x: int, y: int, color: int) {
    var i = 0
    while i < 4 {
        fill(x - 4 + i, y - 1 + i, 2, 2, color)
        fill(x + 3 - i, y - 1 + i, 2, 2, color)
        i += 1
    }
}
fn drawChevronRight(x: int, y: int, color: int) {
    var i = 0
    while i < 4 {
        fill(x - 1 + i, y - 4 + i, 2, 2, color)
        fill(x - 1 + i, y + 3 - i, 2, 2, color)
        i += 1
    }
}

// value read-out helper: "label   value" on one line (dim label, bright value)
fn uiKeyValue(label: str, value: str) {
    beginWidget(0, 19)
    drawText(widgetX, widgetY + 2, label, colorDim)
    let valueWidth = textWidth(value)
    drawText(widgetX + widgetWidth - valueWidth, widgetY + 2, value, colorText)
}

// ================= IDE-scale primitives =================
// clipping, split panes, scrollable regions, tree views, colored code text.

// ---- clipping (so scroll regions and panels don't draw outside themselves) ----
fn uiClip(x: int, y: int, width: int, height: int) {
    let region = win("gdi32!CreateRectRgn", x, y, x + width, y + height)
    let selected = win("gdi32!SelectClipRgn", backBufferHdc, region)
    let deleted = win("gdi32!DeleteObject", region)
}
fn uiClipOff() {
    let selected = win("gdi32!SelectClipRgn", backBufferHdc, 0)
}

// ---- font selection + colored text runs (for code / rich lines) ----
fn uiUseMonospaceFont() { let previousFont = win("gdi32!SelectObject", backBufferHdc, monospaceFont) }
fn uiUseNormalFont() { let previousFont = win("gdi32!SelectObject", backBufferHdc, normalFont) }
// draw a run of text and return its pixel width (advance) -- build colored lines
fn uiTextRun(x: int, y: int, text: str, color: int) -> int {
    drawText(x, y, text, color)
    return textWidth(text)
}

// ---- absolute-positioned building blocks (for toolbars, tabs, custom chrome) ----
fn uiFill(x: int, y: int, width: int, height: int, color: int) { fill(x, y, width, height, color) }
fn uiFrame(x: int, y: int, width: int, height: int, color: int) { frame(x, y, width, height, color) }
fn uiText(x: int, y: int, text: str, color: int) { drawText(x, y, text, color) }
fn uiTextCentered(x: int, y: int, width: int, height: int, text: str, color: int) { drawTextCentered(x, y, width, height, text, color) }
// ---- right-aligned toolbar strip: allocate slots right-to-left, no magic offsets ----
// ActionToolbar analogue: begin at the right edge, then each slot()/sep() reserves
// space leftward and returns the left-x (or centre-x) to draw at.
fn uiStripBegin(rightX: int) { stripCursorX = rightX }
fn uiStripSlot(width: int, gap: int) -> int {
    stripCursorX -= gap
    stripCursorX -= width
    return stripCursorX
}
fn uiStripSeparator(space: int) -> int {
    stripCursorX -= space
    return stripCursorX + space / 2
}
fn uiStripX() -> int { return stripCursorX }
// left-to-right variant (mirror): slots advance rightward from a start x.
fn uiLeftStripBegin(leftX: int) { stripCursorX = leftX }
fn uiLeftStripSlot(width: int, gap: int) -> int {
    let x = stripCursorX
    stripCursorX += width + gap
    return x
}
fn uiLeftStripSeparator(space: int) -> int {
    let x = stripCursorX + space / 2
    stripCursorX += space
    return x
}
// JetBrains-style text field: rounded fill, accent frame when focused, blinking caret.
fn uiTextField(x: int, y: int, width: int, height: int, text: str, focused: bool) {
    fillRoundRect(x, y, width, height, 8, colorField)
    var frameColor = colorOutline
    if focused { frameColor = colorAccent }
    frameRoundRect(x, y, width, height, 8, frameColor)
    var shown = text
    if focused and (frameCounter / 15) % 2 == 0 { shown = shown + "_" }
    drawText(x + 8, y + (height - 16) / 2, shown, colorText)
}
// vertical (top-to-bottom) strip for the tool-window rail.
fn uiVerticalStripBegin(topY: int) { stripCursorY = topY }
fn uiVerticalStripSlot(height: int, gap: int) -> int {
    let y = stripCursorY
    stripCursorY += height + gap
    return y
}
fn uiAbsoluteButton(id: int, x: int, y: int, width: int, height: int, label: str) -> bool {
    let clicked = pressClick(id, x, y, width, height)
    var color = colorPanel
    if hotWidgetId == id { color = colorItem }
    if activeWidgetId == id { color = colorAccent }
    fillRoundRect(x, y, width, height, 8, color)
    if activeWidgetId != id { frameRoundRect(x, y, width, height, 8, colorOutline) }
    drawTextCentered(x, y, width, height, label, colorText)
    return clicked
}
// a flat (chrome-less) clickable region -- toolbar icons, tab strips
fn uiFlatButton(id: int, x: int, y: int, width: int, height: int, glyph: str, hotColor: int) -> bool {
    let clicked = pressClick(id, x, y, width, height)
    if hotWidgetId == id or activeWidgetId == id { fillRoundRect(x, y, width, height, 10, hotColor) }
    if glyph.len() > 0 { drawTextCentered(x, y, width, height, glyph, colorDim) }
    return clicked
}
fn hitAbsolute(x: int, y: int, width: int, height: int) -> bool { return hit(x, y, width, height) }

// ---- split panes (draggable) ----
fn uiVerticalSplit(id: int, x: int, y: int, height: int, minimum: int, maximum: int) -> int {
    let over = mouseX >= x - 3 and mouseX < x + 4 and mouseY >= y and mouseY < y + height
    if over { hotWidgetId = id }
    var newX = x
    if activeWidgetId == id {
        newX = mouseX
        if mouseReleased { activeWidgetId = 0 }
    } else if over and mousePressed {
        activeWidgetId = id
    }
    if newX < minimum { newX = minimum }
    if newX > maximum { newX = maximum }
    fill(x, y, 1, height, colorBorder)
    if over or activeWidgetId == id { fill(x - 1, y, 3, height, colorAccent) }
    return newX
}
fn uiHorizontalSplit(id: int, y: int, x: int, width: int, minimum: int, maximum: int) -> int {
    let over = mouseY >= y - 3 and mouseY < y + 4 and mouseX >= x and mouseX < x + width
    if over { hotWidgetId = id }
    var newY = y
    if activeWidgetId == id {
        newY = mouseY
        if mouseReleased { activeWidgetId = 0 }
    } else if over and mousePressed {
        activeWidgetId = id
    }
    if newY < minimum { newY = minimum }
    if newY > maximum { newY = maximum }
    fill(x, y, width, 1, colorBorder)
    if over or activeWidgetId == id { fill(x, y - 1, width, 3, colorAccent) }
    return newY
}

// ---- scrollable region (vertical), with wheel + scrollbar ----
var scrollRegionX = 0
var scrollRegionY = 0
var scrollRegionWidth = 0
var scrollRegionHeight = 100000
var scrollContentHeight = 0
var scrollOffset = 0
var scrollIndent = 6
fn uiScrollBegin(id: int, x: int, y: int, width: int, height: int, contentHeight: int, offset: int) -> int {
    var clampedOffset = offset
    if hit(x, y, width, height) { clampedOffset = clampedOffset - wheelNotchesThisFrame * 46 }
    var maximumOffset = contentHeight - height
    if maximumOffset < 0 { maximumOffset = 0 }
    if clampedOffset > maximumOffset { clampedOffset = maximumOffset }
    if clampedOffset < 0 { clampedOffset = 0 }
    scrollRegionX = x
    scrollRegionY = y
    scrollRegionWidth = width
    scrollRegionHeight = height
    scrollContentHeight = contentHeight
    scrollOffset = clampedOffset
    uiClip(x, y, width, height)
    contentX = x + scrollIndent
    contentWidth = width - scrollIndent - 12
    layoutCursorX = contentX
    layoutCursorY = y - clampedOffset + 4
    currentRowHeight = 0
    sameLine = false
    rowPending = false
    furthestY = y
    return clampedOffset
}
// returns the measured content height, to feed back next frame for a correct thumb
fn uiScrollEnd() -> int {
    uiClipOff()
    if scrollContentHeight > scrollRegionHeight {
        let thumbX = scrollRegionX + scrollRegionWidth - 8
        var thumbHeight = scrollRegionHeight * scrollRegionHeight / scrollContentHeight
        if thumbHeight < 24 { thumbHeight = 24 }
        let thumbY = scrollRegionY + scrollOffset * (scrollRegionHeight - thumbHeight) / (scrollContentHeight - scrollRegionHeight)
        var thumbColor = rgb(78, 81, 87)
        if hit(scrollRegionX, scrollRegionY, scrollRegionWidth, scrollRegionHeight) { thumbColor = rgb(102, 106, 112) }
        fillRoundRect(thumbX, thumbY, 5, thumbHeight, 5, thumbColor)
    }
    let measured = furthestY - scrollRegionY + scrollOffset + 8
    scrollRegionY = 0
    scrollRegionHeight = 100000
    return measured
}

// ---- tree view (retained expand + selection state) ----
var openTreeIds: [int] = []
var selectedTreeId = 0
fn isTreeNodeOpen(id: int) -> bool {
    for openId in openTreeIds {
        if openId == id { return true }
    }
    return false
}
fn setTreeNodeOpen(id: int, open: bool) {
    var updated: [int] = []
    for openId in openTreeIds {
        if openId != id { updated.push(openId) }
    }
    if open { updated.push(id) }
    openTreeIds = updated
}
fn uiTreeSelected() -> int { return selectedTreeId }

// one tree row. depth = indent level, has_kids draws an expander, iconcol draws a
// small colour swatch (0 = none). Returns whether the node is open (draw its
// children when true). Clicking selects; clicking a parent also toggles it.
// icon kinds for tree rows: encode as uiIcon(kind, colour).
//   0 = plain swatch, 1 = folder, 2 = file, 3 = database, 4 = table, 5 = dot
fn uiIcon(kind: int, color: int) -> int { return color + kind * 16777216 }
// ---- Material icon font (optional) ----
// Load a Material Icons .ttf privately for this process; afterwards any icon
// kind >= 256 (in uiIcon / drawIcon / uiMaterialIcon) is a Material codepoint
// drawn as a real font glyph, e.g. 58055 = folder, 59574 = search.
var iconFont = 0
var wideCharBuffer = 0                    // 1-wchar UTF-16 buffer for TextOutW
fn uiLoadIconFont(path: str, pixelSize: int) -> bool {
    if win("gdi32!AddFontResourceExA", scratchCString(path), 16, 0) == 0 { return false }   // FR_PRIVATE
    iconFont = win("gdi32!CreateFontA", 0 - pixelSize, 0, 0, 0, 400, 0, 0, 0, 0, 0, 0, 5, 0, permanentCString("Material Icons"))
    wideCharBuffer = allocatePermanentMemory(4)
    return iconFont != 0
}
fn uiMaterialIcon(codepoint: int, x: int, y: int, color: int) {
    if iconFont == 0 { return }
    store8(wideCharBuffer + 0, codepoint & 255)
    store8(wideCharBuffer + 1, (codepoint >> 8) & 255)
    let previousFont = win("gdi32!SelectObject", backBufferHdc, iconFont)
    let previousColor = win("gdi32!SetTextColor", backBufferHdc, color)
    let drawn = win("gdi32!TextOutW", backBufferHdc, x, y, wideCharBuffer, 1)
    let restoredFont = win("gdi32!SelectObject", backBufferHdc, normalFont)
}

fn drawIcon(kind: int, color: int, x: int, centerY: int) {
    if kind >= 256 {                                  // Material codepoint
        uiMaterialIcon(kind, x - 1, centerY - 8, color)
        return
    }
    if kind == 1 {                                    // folder: tab + body
        fillRoundRect(x, centerY - 6, 6, 3, 2, color)
        fillRoundRect(x, centerY - 5, 13, 10, 4, color)
    } else if kind == 2 {                             // file: page + folded corner
        fillRoundRect(x + 1, centerY - 6, 11, 13, 3, color)
        fill(x + 8, centerY - 6, 4, 4, colorPanel)
        fill(x + 8, centerY - 3, 4, 1, color)
    } else if kind == 3 {                             // database: cylinder bands
        fillRoundRect(x, centerY - 6, 13, 13, 7, color)
        fill(x + 2, centerY - 2, 9, 1, colorPanel)
        fill(x + 2, centerY + 2, 9, 1, colorPanel)
    } else if kind == 4 {                             // table: grid
        fillRoundRect(x, centerY - 6, 13, 13, 3, color)
        fill(x + 1, centerY - 2, 11, 1, colorPanel)
        fill(x + 6, centerY - 5, 1, 11, colorPanel)
    } else if kind == 5 {                             // status dot
        fillRoundRect(x + 3, centerY - 3, 7, 7, 7, color)
    } else {
        fillRoundRect(x + 1, centerY - 5, 10, 10, 4, color)
    }
}

// one tree row. depth = indent level, has_kids draws an expander, icon draws a
// small icon (0 = none; use uiIcon(kind, colour) for real shapes). Returns
// whether the node is open (draw its children when true). Clicking selects;
// clicking a parent also toggles it.
fn uiTreeRow(id: int, depth: int, label: str, hasChildren: bool, icon: int) -> bool {
    beginWidget(0, 24)
    let x = widgetX
    let y = widgetY
    let width = widgetWidth
    let height = widgetHeight
    let over = hit(scrollRegionX, y, scrollRegionWidth, height) and mouseY >= scrollRegionY and mouseY < scrollRegionY + scrollRegionHeight
    if over { hotWidgetId = id }
    let wasOpen = isTreeNodeOpen(id)
    if over and mousePressed {
        selectedTreeId = id
        if hasChildren { setTreeNodeOpen(id, not wasOpen) }
    }
    // full-width rounded selection / hover, JetBrains-style
    let rowX = scrollRegionX + 4
    let rowWidth = scrollRegionWidth - 8
    if selectedTreeId == id { fillRoundRect(rowX, y + 1, rowWidth, height - 2, 8, colorActive) }
    else if over { fillRoundRect(rowX, y + 1, rowWidth, height - 2, 8, colorItem) }
    let chevronX = x + 6 + depth * 16
    let centerY = y + height / 2
    if hasChildren {
        if wasOpen { drawChevronDown(chevronX + 4, centerY, colorDim) } else { drawChevronRight(chevronX + 4, centerY, colorDim) }
    }
    let kind = icon / 16777216
    let color = icon % 16777216
    treeRowIconX = chevronX + 22                   // icon centre clears the 10px-wide chevron at ax+4
    treeRowIconY = centerY
    if icon != 0 { drawIcon(kind, color, chevronX + 22, centerY) }
    drawTextVerticallyCentered(chevronX + 40, y, height, label, colorText)
    return isTreeNodeOpen(id)
}

// ---- accessors + IDE chrome helpers ----
fn uiWidth() -> int { return clientWidth }
fn uiHeight() -> int { return clientHeight }
fn uiSelectBoldFont() -> int { return win("gdi32!SelectObject", backBufferHdc, boldFont) }
fn uiSelectNormalFont() -> int { return win("gdi32!SelectObject", backBufferHdc, normalFont) }
// a flat document/tool tab (no border); `active` highlights it
fn uiFlatTab(id: int, x: int, y: int, width: int, height: int, label: str, active: bool) -> bool {
    let clicked = pressClick(id, x, y, width, height)
    if hotWidgetId == id and not active { fillRoundRect(x + 2, y + 3, width - 4, height - 6, 8, colorItem) }
    var textColor = colorDim
    if active or hotWidgetId == id { textColor = colorText }
    drawTextCentered(x, y, width, height, label, textColor)
    return clicked
}
