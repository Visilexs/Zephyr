    p.push("        rx_sb_byte(93)\n")
    p.push("    \} else \{\n")
    p.push("        rx_sb_float(v)\n")
    p.push("    \}\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn rx_pow10(k: int) -> int \{\n")
