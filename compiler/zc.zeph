    p.push("fn facos(x: float) -> float \{\n")
    p.push("    if x > 1.0 or x < -1.0 \{ return NAN \}\n")
    p.push("    if x == -1.0 \{ return PI \}\n")
    p.push("    return 2.0 * fatan(sqrt((1.0 - x) / (1.0 + x)))\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// Continuous branch, range (0,pi) -- the calculus convention, not the\n")
    p.push("// arctan(1/x) one that jumps at zero. Built from atan(1/x) rather than\n")
    p.push("// HALF_PI - atan(x), which cancels for large |x|.\n")
