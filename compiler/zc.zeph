    p.push("        if man != 0 \{ return frombits((sign << 63) | (2047 << 52) | 1) \}\n")
    p.push("        return frombits((sign << 63) | (2047 << 52))\n")
    p.push("    \}\n")
    p.push("    return frombits((sign << 63) | ((exp - 127 + 1023) << 52) | (man << 29))\n")
