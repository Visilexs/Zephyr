    p.push("    a += 676.5203681218851 / (z + 1.0)\n")
    p.push("    a += (0.0 - 1259.1392167224028) / (z + 2.0)\n")
    p.push("    a += 771.32342877765313 / (z + 3.0)\n")
    p.push("    a += (0.0 - 176.61502916214059) / (z + 4.0)\n")
    p.push("    a += 12.507343278686905 / (z + 5.0)\n")
    p.push("    a += (0.0 - 0.13857109526572012) / (z + 6.0)\n")
    p.push("    a += 0.0000099843695780195716 / (z + 7.0)\n")
    p.push("    a += 0.00000015056327351493116 / (z + 8.0)\n")
    p.push("    return a\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn is_nonpos_int(x: float) -> bool \{\n")
    p.push("    if x > 0.0 \{ return false \}\n")
    p.push("    return x == (round_i(x) as float)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// log of the absolute value of gamma\n")
    p.push("fn lgamma(x: float) -> float \{\n")
    p.push("    if is_nonpos_int(x) \{ return INF \}\n")
    p.push("    if x < 0.5 \{\n")
    p.push("        // reflection: gamma(x)*gamma(1-x) = pi/sin(pi*x)\n")
    p.push("        return fln(PI / fabs(fsin(PI * x))) - lgamma(1.0 - x)\n")
    p.push("    \}\n")
    p.push("    let z = x - 1.0\n")
    p.push("    let t = z + 7.5\n")
    p.push("    return 0.5 * fln(TWO_PI) + (z + 0.5) * fln(t) - t + fln(lanczos_a(z))\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn gamma(x: float) -> float \{\n")
    p.push("    if is_nonpos_int(x) \{ return NAN \}\n")
    p.push("    if x > 171.62 \{ return INF \}\n")
    p.push("    if x < 0.5 \{ return PI / (fsin(PI * x) * gamma(1.0 - x)) \}\n")
    p.push("    return fexp(lgamma(x))\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// digamma is the logarithmic derivative of gamma. Recurrence up to x >= 6,\n")
    p.push("// then the asymptotic series.\n")
    p.push("fn digamma(x0: float) -> float \{\n")
    p.push("    if is_nonpos_int(x0) \{ return NAN \}\n")
    p.push("    if x0 < 0.0 \{ return digamma(1.0 - x0) - PI * fcot(PI * x0) \}\n")
    p.push("    var x = x0\n")
    p.push("    var r = 0.0\n")
    p.push("    // shift to 12, not 6: the series truncates after the 1/(132 x^10) term,\n")
    p.push("    // and at 6 that leaves ~5e-12, which is ruinous near the root at 1.4616\n")
    p.push("    while x < 12.0 \{\n")
    p.push("        r -= 1.0 / x\n")
    p.push("        x += 1.0\n")
    p.push("    \}\n")
    p.push("    let f = 1.0 / (x * x)\n")
    p.push("    let s = f * (1.0 / 12.0 - f * (1.0 / 120.0 - f * (1.0 / 252.0 - f * (1.0 / 240.0 - f * (1.0 / 132.0)))))\n")
    p.push("    return r + fln(x) - 0.5 / x - s\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// ---- derivatives -----------------------------------------------------------\n")
    p.push("// One per function above. These are the VJP bodies for a future lib/ml tape;\n")
    p.push("// today they are ordinary functions, checkable by finite differences.\n")
    p.push("\n")
    p.push("fn d_fsin(x: float) -> float \{ return fcos(x) \}\n")
    p.push("fn d_fcos(x: float) -> float \{ return 0.0 - fsin(x) \}\n")
    p.push("fn d_ftan(x: float) -> float \{ return fsec(x) * fsec(x) \}\n")
    p.push("fn d_fcsc(x: float) -> float \{ return 0.0 - fcsc(x) * fcot(x) \}\n")
    p.push("fn d_fsec(x: float) -> float \{ return fsec(x) * ftan(x) \}\n")
    p.push("fn d_fcot(x: float) -> float \{ return 0.0 - fcsc(x) * fcsc(x) \}\n")
    p.push("\n")
    p.push("fn d_fasin(x: float) -> float \{\n")
    p.push("    if x >= 1.0 or x <= -1.0 \{ return NAN \}\n")
    p.push("    return 1.0 / sqrt((1.0 - x) * (1.0 + x))\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn d_facos(x: float) -> float \{\n")
    p.push("    if x >= 1.0 or x <= -1.0 \{ return NAN \}\n")
    p.push("    return 0.0 - 1.0 / sqrt((1.0 - x) * (1.0 + x))\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn d_fatan(x: float) -> float \{ return 1.0 / (1.0 + x * x) \}\n")
    p.push("fn d_facot(x: float) -> float \{ return 0.0 - 1.0 / (1.0 + x * x) \}\n")
    p.push("\n")
    p.push("// the fabs here is not decoration: without it the sign is wrong for x < -1\n")
    p.push("fn d_fasec(x: float) -> float \{\n")
    p.push("    if x <= 1.0 and x >= -1.0 \{ return NAN \}\n")
    p.push("    return 1.0 / (fabs(x) * sqrt(x * x - 1.0))\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn d_facsc(x: float) -> float \{\n")
    p.push("    if x <= 1.0 and x >= -1.0 \{ return NAN \}\n")
    p.push("    return 0.0 - 1.0 / (fabs(x) * sqrt(x * x - 1.0))\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn d_fln(x: float) -> float \{ return 1.0 / x \}\n")
    p.push("fn d_fexp(x: float) -> float \{ return fexp(x) \}\n")
    p.push("fn d_sinh(x: float) -> float \{ return cosh(x) \}\n")
    p.push("fn d_cosh(x: float) -> float \{ return sinh(x) \}\n")
    p.push("\n")
    p.push("fn d_tanh(x: float) -> float \{\n")
    p.push("    let t = tanh(x)\n")
    p.push("    return 1.0 - t * t\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn d_gd(x: float) -> float \{ return 1.0 / cosh(x) \}\n")
    p.push("fn d_gd_inv(y: float) -> float \{ return fsec(y) \}\n")
    p.push("fn d_lgamma(x: float) -> float \{ return digamma(x) \}\n")
    p.push("fn d_gamma(x: float) -> float \{ return gamma(x) * digamma(x) \}\n")
    p.push("\n")
    p.push("// ---- quadrature ------------------------------------------------------------\n")
    p.push("// Adaptive Simpson with Richardson extrapolation. For the two functions above\n")
    p.push("// with no elementary antiderivative -- gamma and gd -- this is the only route.\n")
    p.push("\n")
    p.push("fn simpson(f: fn(float) -> float, a: float, b: float) -> float \{\n")
    p.push("    let c = (a + b) / 2.0\n")
    p.push("    return (b - a) / 6.0 * (f(a) + 4.0 * f(c) + f(b))\n")
