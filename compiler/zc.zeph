    p.push("    let closed = win(\"CloseHandle\", handle)\n")
    p.push("    assert(closed != 0, \"append_file: close failed\")\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn file_exists(path: str) -> bool \{\n")
