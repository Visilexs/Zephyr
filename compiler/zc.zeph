    p.push("        x = 0.0 - x\n")
    p.push("        neg = true\n")
    p.push("    \}\n")
    p.push("    var inv = false\n")
    p.push("    if x > 1.0 \{\n")
    p.push("        x = 1.0 / x\n")
    p.push("        inv = true\n")
    p.push("    \}\n")
    p.push("    var add = 0.0\n")
    p.push("    var t = x\n")
    p.push("    if x > TAN_PI_12 \{\n")
    p.push("        t = (x * SQRT3 - 1.0) / (x + SQRT3)\n")
    p.push("        add = PI_6\n")
    p.push("    \}\n")
    p.push("    let mt2 = 0.0 - t * t\n")
    p.push("    var term = t\n")
    p.push("    var sum = t\n")
    p.push("    for i in 1..14 \{\n")
    p.push("        term = term * mt2\n")
    p.push("        sum += term / ((2 * i + 1) as float)\n")
    p.push("    \}\n")
    p.push("    var r = add + sum\n")
    p.push("    if inv \{ r = HALF_PI - r \}\n")
    p.push("    if neg \{ r = 0.0 - r \}\n")
    p.push("    return r\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// (1-x)*(1+x) rather than 1-x*x: the latter cancels as |x| approaches 1\n")
    p.push("fn fasin(x: float) -> float \{\n")
    p.push("    if x > 1.0 or x < -1.0 \{ return NAN \}\n")
    p.push("    if x == 1.0 \{ return HALF_PI \}\n")
    p.push("    if x == -1.0 \{ return 0.0 - HALF_PI \}\n")
    p.push("    return fatan(x / sqrt((1.0 - x) * (1.0 + x)))\n")
