    p.push("//\n")
    p.push("//  1. The OS calls a thread entry with Win64 conventions (one argument in RCX),\n")
    p.push("//     but a Zephyr function reads its arguments off the stack. So there is a\n")
    p.push("//     29-byte thunk below, assembled by hand into executable memory, that\n")
    p.push("//     translates one into the other. This is the native callback we managed to\n")
    p.push("//     avoid for windowing (DefWindowProcA did that job) and for Vulkan\n")
    p.push("//     validation (a settings file did). A thread entry has no such escape.\n")
    p.push("//\n")
    p.push("//  2. The collector is stop-the-world and finds its roots by scanning stacks.\n")
    p.push("//     runtime.zeph keeps a registry. On Windows rx_collect suspends every other\n")
    p.push("//     registered thread, reads its CONTEXT for the integer registers, and scans\n")
    p.push("//     from its Rsp to its stack base. A thread\n")
    p.push("//     is registered before it is resumed, so it cannot allocate unseen. Linux\n")
    p.push("//     defers cyclic collection until all workers are joined (no stack suspension).\n")
    p.push("//\n")
    p.push("// The argument passed to a thread is an `int` -- a worker index, or an address\n")
    p.push("// in a buffer you allocated up front. It is deliberately not a heap reference:\n")
    p.push("// it travels through memory the collector does not scan.\n")
    p.push("//\n")
    p.push("// String interpolation IS safe across threads: the runtime's builder is\n")
    p.push("// per-thread, reached through TLS once a second thread exists.\n")
    p.push("\n")
    p.push("struct Thread \{ handle: int, rec: int, slot: int \}\n")
    p.push("\n")
    p.push("// Thread bodies are closures, and a closure is a heap object. The record handed\n")
    p.push("// to the OS lives outside the heap, so without this list the collector would\n")
    p.push("// see no reference to a running thread's body and free it.\n")
    p.push("// join() releases the entry, so spawning in a loop reuses these rather than\n")
    p.push("// growing a list the collector has to walk on every cycle.\n")
    p.push("var g_bodies: [fn(int)] = []\n")
    p.push("var g_live: [bool] = []\n")
    p.push("var g_thunk = 0\n")
    p.push("\n")
    p.push("// Retain a thread body in a reusable root slot until its worker is joined.\n")
    p.push("fn body_slot(threadBody: fn(int)) -> int \{\n")
    p.push("    for i in 0..g_bodies.len() \{\n")
    p.push("        if not g_live[i] \{\n")
    p.push("            g_bodies[i] = threadBody\n")
    p.push("            g_live[i] = true\n")
    p.push("            return i\n")
    p.push("        \}\n")
    p.push("    \}\n")
    p.push("    g_bodies.push(threadBody)\n")
    p.push("    g_live.push(true)\n")
    p.push("    return g_bodies.len() - 1\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// push rbx / mov rbx,rsp        -- keep a copy of the stack pointer\n")
    p.push("// mov rax,[rcx]                 -- rcx = record; rax = the closure cell\n")
    p.push("// mov rdx,[rax+8] / push rdx    -- env, pushed first (deepest) as Zephyr expects\n")
    p.push("// mov rdx,[rcx+8] / push rdx    -- the int argument\n")
    p.push("// mov rax,[rax] / call rax      -- code pointer\n")
    p.push("// mov rsp,rbx / pop rbx / xor eax,eax / ret\n")
    p.push("let THUNK_CODE = [83, 72, 137, 227, 72, 139, 1, 72, 139, 80, 8, 82,\n")
    p.push("                  72, 139, 81, 8, 82, 72, 139, 0, 255, 208,\n")
    p.push("                  72, 137, 220, 91, 49, 192, 195]\n")
    p.push("\n")
    p.push("// Return the executable adapter from native thread entry to a Zephyr closure.\n")
    p.push("fn tx_thunk() -> int \{\n")
    p.push("    if g_thunk != 0 \{ return g_thunk \}\n")
    p.push("    // MEM_COMMIT|MEM_RESERVE, PAGE_EXECUTE_READWRITE\n")
    p.push("    let codeAddress = win(\"VirtualAlloc\", 0, 4096, 12288, 64)\n")
    p.push("    if codeAddress == 0 \{ panic(\"thread: cannot allocate executable memory\") \}\n")
    p.push("    for i in 0..THUNK_CODE.len() \{ store8(codeAddress + i, THUNK_CODE[i]) \}\n")
    p.push("    g_thunk = codeAddress\n")
    p.push("    return codeAddress\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// Run threadFunction(argument) on a new thread.\n")
    p.push("fn thread_spawn(threadFunction: fn(int), argument: int) -> Thread \{\n")
    p.push("    // wrap the caller's function so registration cannot be forgotten\n")
    p.push("    let threadBody = fn(workerArgument: int) \{\n")
    p.push("        rt_thread_ready()\n")
    p.push("        threadFunction(workerArgument)\n")
    p.push("        rt_thread_done()\n")
    p.push("    \}\n")
    p.push("    let bodySlot = body_slot(threadBody)\n")
    p.push("\n")
    p.push("    let recordAddress = win(\"VirtualAlloc\", 0, 32, 12288, 4)\n")
    p.push("    if recordAddress == 0 \{ panic(\"thread: cannot allocate record\") \}\n")
    p.push("    store64(recordAddress, addr(threadBody))\n")
    p.push("    store64(recordAddress + 8, argument)\n")
    p.push("    let threadIdAddress = win(\"VirtualAlloc\", 0, 16, 12288, 4)\n")
    p.push("    if threadIdAddress == 0 \{ panic(\"thread: cannot allocate thread id\") \}\n")
    p.push("\n")
    p.push("    // CREATE_SUSPENDED so the thread is in the registry before it can allocate\n")
    p.push("    let threadHandle = win(\"CreateThread\", 0, 0, tx_thunk(), recordAddress, 4, threadIdAddress)\n")
    p.push("    if threadHandle == 0 \{ panic(\"thread: CreateThread failed\") \}\n")
    p.push("    let registrySlot = rt_thread_add(threadHandle, load64(threadIdAddress) & 4294967295)\n")
    p.push("    let resumeResult = win(\"ResumeThread\", threadHandle)\n")
    p.push("    let threadIdReleased = win(\"VirtualFree\", threadIdAddress, 0, 32768) // MEM_RELEASE\n")
    p.push("    return Thread\{handle: threadHandle, rec: recordAddress, slot: bodySlot\}\n")
    p.push("\}\n")
    p.push("\n")
    p.push("impl Thread \{\n")
    p.push("    // Wait for completion and release this worker's native resources and root.\n")
    p.push("    fn join(self) \{\n")
    p.push("        let waitResult = win(\"WaitForSingleObject\", self.handle, 4294967295) // INFINITE\n")
    p.push("        assert(waitResult == 0, \"thread: join failed\")\n")
    p.push("        let handleClosed = win(\"CloseHandle\", self.handle)\n")
    p.push("        // the body has returned, so nothing reaches the record or the closure\n")
    p.push("        let recordReleased = win(\"VirtualFree\", self.rec, 0, 32768) // MEM_RELEASE\n")
    p.push("        g_live[self.slot] = false\n")
    p.push("    \}\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// Run workerFunction(i) across workerCount threads and wait for all of them.\n")
    p.push("fn parallel_for(workerCount: int, workerFunction: fn(int)) \{\n")
    p.push("    var workers: [Thread] = []\n")
    p.push("    for i in 0..workerCount \{ workers.push(thread_spawn(workerFunction, i)) \}\n")
    p.push("    for worker in workers \{ worker.join() \}\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// Return the system's logical processor count, falling back to one.\n")
    p.push("fn cpu_count() -> int \{\n")
    p.push("    // GetSystemInfo fills a SYSTEM_INFO; dwNumberOfProcessors sits at offset 32\n")
    p.push("    let systemInfoAddress = win(\"VirtualAlloc\", 0, 128, 12288, 4)\n")
    p.push("    if systemInfoAddress == 0 \{ panic(\"thread: cannot allocate system info\") \}\n")
    p.push("    let systemInfoResult = win(\"GetSystemInfo\", systemInfoAddress)\n")
    p.push("    let processorCount = load64(systemInfoAddress + 32) & 4294967295\n")
    p.push("    let released = win(\"VirtualFree\", systemInfoAddress, 0, 32768)\n")
    p.push("    if processorCount < 1 \{ return 1 \}\n")
    p.push("    return processorCount\n")
    p.push("\}\n")
    p.push("\n")
    return p.join()
}
fn embedded_name(i: int) -> str {
    if i == 0 { return "std/bytes.zeph" }
    if i == 1 { return "std/io.zeph" }
    if i == 2 { return "std/list.zeph" }
    if i == 3 { return "std/math.zeph" }
    if i == 4 { return "std/math_core.zeph" }
    if i == 5 { return "std/random.zeph" }
    if i == 6 { return "std/result.zeph" }
    if i == 7 { return "std/set.zeph" }
    if i == 8 { return "std/string.zeph" }
    if i == 9 { return "std/sync.zeph" }
    if i == 10 { return "std/thread.zeph" }
    return ""
}
fn embedded_src(i: int) -> str {
    if i == 0 { return __emb_0() }
    if i == 1 { return __emb_1() }
    if i == 2 { return __emb_2() }
    if i == 3 { return __emb_3() }
    if i == 4 { return __emb_4() }
    if i == 5 { return __emb_5() }
    if i == 6 { return __emb_6() }
    if i == 7 { return __emb_7() }
    if i == 8 { return __emb_8() }
    if i == 9 { return __emb_9() }
    if i == 10 { return __emb_10() }
    return ""
}
// <<<EMBED

// Directory of the running zc.exe (with trailing separator), so `runtime.zeph`
// and the `std/` library resolve next to the compiler wherever it is installed
// -- not the current directory. Computed once into cachedExecutableDirectory.
var cachedExecutableDirectory = ""
fn executableDirectory() -> str {
    let buffer = zeros(64)                         // 512-byte path buffer (a [int] keeps its data alive)
    let data = load64(addr(buffer) + 16)
    let count = win("GetModuleFileNameA", 0, data, 512)
    var text = ""
    var index = 0
    while index < count {
        text = text + chr(load8(data + index))
        index += 1
    }
    return directoryName(text)
}
// true if the file exists (GetFileAttributesA != INVALID_FILE_ATTRIBUTES)
fn pathExists(path: str) -> bool {
    let count = path.len()
    let buffer = zeros(count / 8 + 2)
    let data = load64(addr(buffer) + 16)
    var index = 0
    while index < count {
        store8(data + index, path.byte(index))
        index += 1
    }
    store8(data + count, 0)                          // NUL-terminate for the Win32 call
    let attribute = win("GetFileAttributesA", data)
    return (attribute & 4294967295) != 4294967295
}

// Compare disk imports by absolute Windows path, regardless of spelling.
fn canonicalPathKey(path: str) -> str {
    let buffer = zeros(path.len() / 8 + 2)
    let data = load64(addr(buffer) + 16)
    for i in 0..path.len() { store8(data + i, path.byte(i)) }
    store8(data + path.len(), 0)
    let output = zeros(33)                        // 264 bytes for a 260-byte path
    let destination = load64(addr(output) + 16)
    let count = win("GetFullPathNameA", data, 260, destination, 0)
    if count == 0 or count >= 260 { return path.lower() }   // too long: n is the size it needed
    var key = ""
    for i in 0..count { key = key + chr(load8(destination + i)) }
    return key.lower()
}

// The main file's test blocks, in order (scopeModule drops them from the program).
fn collectTests(program: Node) -> [Node] {
    var tests: [Node] = []
    for count in program.children {
        if count.nodeKind == nodeTest { tests.push(count) }
    }
    return tests
}

// A main file that declares fn main() and never calls it at the top level
// gets the call appended, after every other top-level statement.
fn callMain(program: Node) {
    var mainNode = makeNode(nodeNone, 0)
    for count in program.children {
        if count.nodeKind == nodeFunction and count.name == "main" { mainNode = count }
        if count.nodeKind == nodeExpressionStatement and count.children[0].nodeKind == nodeCall and count.children[0].children[0].nodeKind == nodeIdentifier and count.children[0].children[0].name == "main" { return }
    }
    if mainNode.nodeKind == nodeNone { return }
    if mainNode.children[0].children.len() > 0 { failCompilation(mainNode.line, "main takes no parameters (read them with args())") }
    if mainNode.children[3].children.len() > 0 { failCompilation(mainNode.line, "main cannot be generic") }
    program.children.push(callStatement("main", mainNode.line))
}

fn callStatement(name: str, line: int) -> Node {
    var call = makeNode(nodeCall, line)
    call.children.push(nameNode(name, line))
    var statement = makeNode(nodeExpressionStatement, line)
    statement.children.push(call)
    return statement
}

// emit(text) or print(text) as a statement
fn textStatement(builtin: str, text: str, line: int) -> Node {
    var part = makeNode(nodeStringText, line)
    part.name = text
    var literal = makeNode(nodeStringLiteral, line)
    literal.children.push(part)
    var call = makeNode(nodeCall, line)
    call.children.push(nameNode(builtin, line))
    call.children.push(literal)
    var statement = makeNode(nodeExpressionStatement, line)
    statement.children.push(call)
    return statement
}

// zc --test: each test block becomes a function, run in order after the
// top-level statements (main() is not called). A failing test panics, which
// ends the run at that test.
// ponytail: no isolation; the first failure stops the run. A process per test
// would let the rest run.
fn addTestRunner(program: Node, tests: [Node]) {
    for i in 0..tests.len() {
        let test = tests[i]
        var body = makeNode(nodeFunction, test.line)
        body.name = "__test{i}"
        body.children.push(makeNode(nodeProgram, test.line))     // no parameters
        body.children.push(makeNode(nodeNone, test.line))     // returns nothing
        body.children.push(test.children[0])
        body.children.push(makeNode(nodeProgram, test.line))     // not generic
        program.children.push(body)
    }
    for i in 0..tests.len() {
        program.children.push(textStatement("emit", "test {tests[i].name} ... ", tests[i].line))
        program.children.push(callStatement("__test{i}", tests[i].line))
        program.children.push(textStatement("print", "ok", tests[i].line))
    }
    var plural = "s"
    if tests.len() == 1 { plural = "" }
    program.children.push(textStatement("print", "{tests.len()} test{plural} passed", 0))
}

// splice each `import "path"` in place with that file's declarations.
// Each path is included once, so diamonds and cycles terminate.
fn expandImports(program: Node, baseDirectory: str) -> Node {
    var output: [Node] = []
    for count in program.children {
        if count.nodeKind == nodeImport {
            var path = count.name
            var display = baseName(count.name)
            if not isAbsolutePath(path) {
                display = directoryName(count.file) + count.name
                path = baseDirectory + count.name
                // Fall back to the compiler's own directory, then to lib/
                // beneath it, so `import "std/list.zeph"` or `import
                // "vk/gfx.zeph"` finds the shipped library from anywhere.
                if not pathExists(path) and cachedExecutableDirectory != "" {
                    if pathExists(cachedExecutableDirectory + count.name) {
                        path = cachedExecutableDirectory + count.name
                        display = count.name
                    } else if pathExists(cachedExecutableDirectory + "lib/" + count.name) {
                        path = cachedExecutableDirectory + "lib/" + count.name
                        display = "lib/" + count.name
                    }
                }
            }
            // not on disk anywhere: use the copy baked into the compiler
            var elementIndex = 0 - 1
            if not pathExists(path) {
                elementIndex = embedMatch(count.name)
                if elementIndex >= 0 {
                    path = "embed:" + embedded_name(elementIndex)
                    display = "lib/" + embedded_name(elementIndex)
                }
            }
            var key = path
            if elementIndex < 0 { key = canonicalPathKey(path) }
            var seen = false
            for i in 0..imported.len() {
                if imported[i] == key { seen = true }
            }
            var prefix = ""
            if count.children.len() > 0 { prefix = count.children[0].name + "." }
            if seen {
                let earlier = importPrefixes.get(key).or("")
                if prefix == "" and earlier != "" {
                    failCompilation(count.line, "'{count.name}' is imported with 'as' elsewhere, so its names are qualified; import it with 'as' here too")
                }
                prefix = earlier
            } else {
                importPrefixes[key] = prefix
            }
            if count.children.len() > 0 {
                let alias = count.children[0].name
                if namespacePrefixes.has(alias) and (namespacePrefixes[alias] != prefix or not seen) {
                    failCompilation(count.line, "'{alias}' already names another import")
                }
                namespacePrefixes[alias] = prefix
            }
            if not seen {
                imported.push(key)
                let previous = currentSourceFile
                if elementIndex >= 0 {
                    currentSourceFile = display
                    let inner = parse(tokenizeSource(embedded_src(elementIndex), 1))
                    scopeModule(inner, display, prefix)
                    let expanded = expandImports(inner, "")
                    currentSourceFile = previous
                    for i in 0..expanded.children.len() { output.push(expanded.children[i]) }
                } else {
                    currentSourceFile = display
                    let inner = parse(tokenizeSource(read_file(path), 1))
                    scopeModule(inner, display, prefix)
                    let expanded = expandImports(inner, directoryName(path))
                    currentSourceFile = previous
                    for i in 0..expanded.children.len() { output.push(expanded.children[i]) }
                }
            }
        } else {
            output.push(count)
        }
    }
    program.children = output
    return program
}

let imageBase = 5368709120  // 0x140000000

fn writePe(path: str) {
    let runtimeMode = symbolIsLocal("rt_alloc")   // Zephyr runtime linked: kernel32-only
    let entryOffset = textSectionLength
    currentAssemblySection = sectionText
    if runtimeMode {
        writeTextByte(72)                               // sub rsp, 40
        writeTextByte(131)
        writeTextByte(236)
        writeTextByte(40)
        writeTextByte(232)                              // call zephyr_main
        addFix(fixupRelative32, internAssemblySymbol("zephyr_main"), 0)
        writeText32Bits(0)
        writeTextByte(49)                               // xor ecx, ecx
        writeTextByte(201)
        writeTextByte(255)                              // call [rip+ExitProcess]
        writeTextByte(21)
        addFix(fixupImportAddress32, internLibraryImport("ExitProcess", 1), 0)
        writeText32Bits(0)
        writeTextByte(204)
    } else {
        writeTextByte(72)                               // lea rcx, [rip+zephyr_main]
        writeTextByte(141)
        writeTextByte(13)
        addFix(fixupRelative32, internAssemblySymbol("zephyr_main"), 0)
        writeText32Bits(0)
        writeTextByte(72)                               // sub rsp, 40
        writeTextByte(131)
        writeTextByte(236)
        writeTextByte(40)
        writeTextByte(255)                              // call [rip+rt_start]
        writeTextByte(21)
        addFix(fixupImportAddress32, internRuntimeImport("rt_start"), 0)
        writeText32Bits(0)
        writeTextByte(204)
    }

    // import layout, grouped by DLL; only DLLs with imports get a descriptor
    let importCount = assemblyImports.len()
    let importLibraryNames = ["zephyr_rt.dll", "kernel32.dll", "user32.dll", "gdi32.dll", "opengl32.dll"]
    var used: [bool] = [false, false, false, false, false]
    for i in 0..importCount { used[importLibraryIndices[i]] = true }
    var libraryMapping: [int] = []
    for descriptor in 0..importLibraryNames.len() {
        if used[descriptor] { libraryMapping.push(descriptor) }
    }
    let libraryCount = libraryMapping.len()
    var slot: [int] = []
    for i in 0..importCount { slot.push(0) }
    var grpStart: [int] = []
    var entryCount = 0
    for globalIndex in 0..libraryCount {
        grpStart.push(entryCount)
        for i in 0..importCount {
            if importLibraryIndices[i] == libraryMapping[globalIndex] {
                slot[i] = entryCount
                entryCount += 1
            }
        }
        entryCount += 1                        // per-DLL null terminator
    }
    let importDirectorySize = (libraryCount + 1) * 20
    let importLookupTableOffset = importDirectorySize
    let importAddressTableOffset = importLookupTableOffset + 8 * entryCount
    let namesOffset = importAddressTableOffset + 8 * entryCount
    var nameOffsets: [int] = []
    var nameOffset = namesOffset
    for i in 0..importCount {
        nameOffsets.push(nameOffset)
        nameOffset += 2 + assemblyImports[i].len() + 1
        if nameOffset % 2 == 1 { nameOffset += 1 }
    }
    var libraryOffset: [int] = []
    for globalIndex in 0..libraryCount {
        libraryOffset.push(nameOffset)
        nameOffset += importLibraryNames[libraryMapping[globalIndex]].len() + 1
    }
    let importDataSize = peAlign(nameOffset, 16)

    let textRelativeAddress = 4096
    let textSize = textSectionLength
    let readOnlyDataRelativeAddress = peAlign(textRelativeAddress + textSize, 4096)
    let dataOffset = importDataSize
    let readOnlyDataSize = importDataSize + readOnlySectionLength
    let zeroDataRelativeAddress = peAlign(readOnlyDataRelativeAddress + readOnlyDataSize, 4096)
    var imageSize = peAlign(zeroDataRelativeAddress, 4096)
    if zeroSectionSize > 0 { imageSize = peAlign(zeroDataRelativeAddress + zeroSectionSize, 4096) }
    let importTableRelativeAddress = readOnlyDataRelativeAddress + importAddressTableOffset

    // resolve fixups
    for i in 0..assemblyFixups.len() {
        let fixup = assemblyFixups[i]
        var target = 0
        if fixup.kind == fixupImportAddress32 {
            target = importTableRelativeAddress + 8 * slot[fixup.symbol]
        } else {
            let symbol = assemblySymbols[fixup.symbol]
            if not symbol.defined { assemblyFail("undefined symbol {symbol.name}") }
            if symbol.section == sectionText { target = textRelativeAddress + symbol.offset }
            else if symbol.section == sectionReadOnlyData { target = readOnlyDataRelativeAddress + dataOffset + symbol.offset }
            else { target = zeroDataRelativeAddress + symbol.offset }
        }
        if fixup.kind == fixupAbsolute64 {
            patch8(readOnlySectionBytes, fixup.offset, imageBase + target)
        } else {
            patch4(textSectionBytes, fixup.offset, target + fixup.addend - (textRelativeAddress + fixup.offset + 4))
        }
    }

    var sectionCount = 2
    if zeroSectionSize > 0 { sectionCount = 3 }
    let headersSize = 1024
    let textRaw = headersSize
    let readOnlyDataRaw = textRaw + peAlign(textSize, 512)
    let fileSize = readOnlyDataRaw + peAlign(readOnlyDataSize, 512)
    peOutput = chr(0).repeat(fileSize)

    // DOS header
    writePeByte(77)
    writePeByte(90) // "MZ"
    padPeOutput(60)
    writePe32Bits(64)
    // PE signature + COFF
    writePeByte(80)
    writePeByte(69)
    writePeByte(0)
    writePeByte(0)
    writePe16Bits(34404)                       // 0x8664
    writePe16Bits(sectionCount)
    writePe32Bits(0)
    writePe32Bits(0)
    writePe32Bits(0)
    writePe16Bits(240)
    writePe16Bits(34) // opt size, EXE | large-address-aware
    // optional header
    writePe16Bits(523)                         // 0x20B
    writePe16Bits(256)
    writePe32Bits(peAlign(textSize, 512))
    writePe32Bits(peAlign(readOnlyDataSize, 512))
    writePe32Bits(0)
    writePe32Bits(textRelativeAddress + entryOffset)
    writePe32Bits(textRelativeAddress)
    writePe64Bits(imageBase)
    writePe32Bits(4096)
    writePe32Bits(512)
    writePe16Bits(6)
    writePe16Bits(0)
    writePe16Bits(0)
    writePe16Bits(0)
    writePe16Bits(6)
    writePe16Bits(0)
    writePe32Bits(0)
    writePe32Bits(imageSize)
    writePe32Bits(headersSize)
    writePe32Bits(0)
    writePe16Bits(3)                           // console
    writePe16Bits(33024)                       // 0x8100: NX + TS aware, no ASLR
    writePe64Bits(8388608)
    writePe64Bits(65536) // stack
    writePe64Bits(1048576)
    writePe64Bits(4096) // heap
    writePe32Bits(0)
    writePe32Bits(16)
    for i in 0..16 {
        if i == 1 {
            writePe32Bits(readOnlyDataRelativeAddress)
            writePe32Bits(importDirectorySize)
        } else if i == 12 {
            writePe32Bits(importTableRelativeAddress)
            writePe32Bits(8 * entryCount)
        } else {
            writePe32Bits(0)
            writePe32Bits(0)
        }
    }
    // section headers: name(8) vsz rva rsz raw 0 0 0 chr
    let sectionNames = [".text", ".rdata", ".bss"]
    var sectionVirtualSizes: [int] = []
    var sectionVirtualAddresses: [int] = []
    var sectionRawSizes: [int] = []
    var sectionRawOffsets: [int] = []
    var sectionCharacteristics: [int] = []
    sectionVirtualSizes.push(textSize)
    sectionVirtualAddresses.push(textRelativeAddress)
    sectionRawSizes.push(peAlign(textSize, 512))
    sectionRawOffsets.push(textRaw)
    sectionCharacteristics.push(1610612768)
    sectionVirtualSizes.push(readOnlyDataSize)
    sectionVirtualAddresses.push(readOnlyDataRelativeAddress)
    sectionRawSizes.push(peAlign(readOnlyDataSize, 512))
    sectionRawOffsets.push(readOnlyDataRaw)
    sectionCharacteristics.push(1073741888)
    sectionVirtualSizes.push(zeroSectionSize)
    sectionVirtualAddresses.push(zeroDataRelativeAddress)
    sectionRawSizes.push(0)
    sectionRawOffsets.push(0)
    sectionCharacteristics.push(3221225600)
    for i in 0..sectionCount {
        let memberCount = sectionNames[i]
        for j in 0..8 {
            if j < memberCount.len() { writePeByte(memberCount.byte(j)) } else { writePeByte(0) }
        }
        writePe32Bits(sectionVirtualSizes[i])
        writePe32Bits(sectionVirtualAddresses[i])
        writePe32Bits(sectionRawSizes[i])
        writePe32Bits(sectionRawOffsets[i])
        writePe32Bits(0)
        writePe32Bits(0)
        writePe32Bits(0)
        writePe32Bits(sectionCharacteristics[i])
    }
    padPeOutput(textRaw)
    writePeBytes(textSectionBytes, textSectionLength)
    padPeOutput(readOnlyDataRaw)
    // import descriptor table: one entry per used DLL, then a null entry
    for globalIndex in 0..libraryCount {
        writePe32Bits(readOnlyDataRelativeAddress + importLookupTableOffset + 8 * grpStart[globalIndex])   // OriginalFirstThunk
        writePe32Bits(0)
        writePe32Bits(0)
        writePe32Bits(readOnlyDataRelativeAddress + libraryOffset[globalIndex])                   // Name
        writePe32Bits(readOnlyDataRelativeAddress + importAddressTableOffset + 8 * grpStart[globalIndex])   // FirstThunk
    }
    writePe32Bits(0)
    writePe32Bits(0)
    writePe32Bits(0)
    writePe32Bits(0)
    writePe32Bits(0)
    // ILT then IAT (identical on disk), grouped by DLL with null terminators
    for pass in 0..2 {
        for globalIndex in 0..libraryCount {
            for i in 0..importCount {
                if importLibraryIndices[i] == libraryMapping[globalIndex] { writePe64Bits(readOnlyDataRelativeAddress + nameOffsets[i]) }
            }
            writePe64Bits(0)
        }
    }
    for i in 0..importCount {
        writePeByte(0)
        writePeByte(0)
        let memberCount = assemblyImports[i]
        for j in 0..memberCount.len() { writePeByte(memberCount.byte(j)) }
        writePeByte(0)
        if (peLength - readOnlyDataRaw) % 2 == 1 { writePeByte(0) }
    }
    for globalIndex in 0..libraryCount {
        let libraryName = importLibraryNames[libraryMapping[globalIndex]]
        for j in 0..libraryName.len() { writePeByte(libraryName.byte(j)) }
        writePeByte(0)
    }
    padPeOutput(readOnlyDataRaw + importDataSize)
    writePeBytes(readOnlySectionBytes, readOnlySectionLength)
    padPeOutput(fileSize)

    write_file(path, peOutput)
}

// ---------------- ELF writer (--linux) ----------------
//
// A static ET_EXEC with two PT_LOAD segments and nothing else: no interpreter,
// no dynamic section, no relocations, no section headers. Everything the
// program needs from the kernel it asks for with `syscall`, so there is no
// import table to build -- this is a good deal shorter than writePe.
let elfBase = 4194304   // 0x400000

fn writeElf64Bits(value: int) {
    var valueLocal = value
    for i in 0..8 {
        writePeByte(valueLocal % 256)
        valueLocal = valueLocal / 256
    }
}

fn writeElf(path: str) {
    let entryOffset = textSectionLength
    currentAssemblySection = sectionText
    writeTextByte(232)                              // call zephyr_main
    addFix(fixupRelative32, internAssemblySymbol("zephyr_main"), 0)
    writeText32Bits(0)
    writeTextByte(184)                              // mov eax, 231 (exit_group)
    writeText32Bits(231)
    writeTextByte(49)                               // xor edi, edi
    writeTextByte(255)
    writeTextByte(15)                               // syscall
    writeTextByte(5)

    let textRelativeAddress = 4096
    let textSize = textSectionLength
    let readOnlyDataRelativeAddress = peAlign(textRelativeAddress + textSize, 4096)
    let readOnlyDataSize = readOnlySectionLength
    let zeroDataRelativeAddress = peAlign(readOnlyDataRelativeAddress + readOnlyDataSize, 4096)
    peOutput = chr(0).repeat(readOnlyDataRelativeAddress + readOnlyDataSize)

    for i in 0..assemblyFixups.len() {
        let fixup = assemblyFixups[i]
        if fixup.kind == fixupImportAddress32 { assemblyFail("DLL imports are not available on --linux") }
        let symbol = assemblySymbols[fixup.symbol]
        if not symbol.defined { assemblyFail("undefined symbol {symbol.name}") }
        var target = 0
        if symbol.section == sectionText { target = textRelativeAddress + symbol.offset }
        else if symbol.section == sectionReadOnlyData { target = readOnlyDataRelativeAddress + symbol.offset }
        else { target = zeroDataRelativeAddress + symbol.offset }
        if fixup.kind == fixupAbsolute64 {
            patch8(readOnlySectionBytes, fixup.offset, elfBase + target)
        } else {
            patch4(textSectionBytes, fixup.offset, target + fixup.addend - (textRelativeAddress + fixup.offset + 4))
        }
    }

    // ELF header
    writePeByte(127)
    writePeByte(69)
    writePeByte(76)
    writePeByte(70)                               // \x7fELF
    writePeByte(2)                                // 64-bit
    writePeByte(1)                                // little-endian
    writePeByte(1)                                // version
    padPeOutput(16)
    writePe16Bits(2)                               // ET_EXEC
    writePe16Bits(62)                              // EM_X86_64
    writePe32Bits(1)
    writeElf64Bits(elfBase + textRelativeAddress + entryOffset) // e_entry
    writeElf64Bits(64)                              // e_phoff
    writeElf64Bits(0)                               // e_shoff
    writePe32Bits(0)
    writePe16Bits(64)                              // e_ehsize
    writePe16Bits(56)                              // e_phentsize
    writePe16Bits(2)                               // e_phnum
    writePe16Bits(64)
    writePe16Bits(0)
    writePe16Bits(0)

    // PT_LOAD r-x: the headers and .text, mapped from file offset 0
    writePe32Bits(1)
    writePe32Bits(5)
    writeElf64Bits(0)
    writeElf64Bits(elfBase)
    writeElf64Bits(elfBase)
    writeElf64Bits(textRelativeAddress + textSize)
    writeElf64Bits(textRelativeAddress + textSize)
    writeElf64Bits(4096)
    // PT_LOAD rw-: .rdata then .bss. File and virtual offsets are kept equal so
    // the p_offset == p_vaddr (mod page) requirement holds without arithmetic.
    writePe32Bits(1)
    writePe32Bits(6)
    writeElf64Bits(readOnlyDataRelativeAddress)
    writeElf64Bits(elfBase + readOnlyDataRelativeAddress)
    writeElf64Bits(elfBase + readOnlyDataRelativeAddress)
    writeElf64Bits(readOnlyDataSize)
    writeElf64Bits(zeroDataRelativeAddress - readOnlyDataRelativeAddress + zeroSectionSize)
    writeElf64Bits(4096)

    padPeOutput(textRelativeAddress)
    writePeBytes(textSectionBytes, textSectionLength)
    padPeOutput(readOnlyDataRelativeAddress)
    writePeBytes(readOnlySectionBytes, readOnlySectionLength)

    write_file(path, peOutput)
}

fn isLabelChar(character: int) -> bool {
    return character == 95 or (character >= 65 and character <= 90) or (character >= 97 and character <= 122) or (character >= 48 and character <= 57)
}

// Only rt_* calls distinguish forward local definitions from DLL imports.
// Record those labels during emission instead of scanning every assembly line.
fn predefineAssemblyLabel(line: str) {
    let count = line.len()
    if not textStartsWith(line, "rt_") or line.byte(count - 1) != 58 { return }
    for i in 3..count - 1 {
        if not isLabelChar(line.byte(i)) { return }
    }
    assemblySymbols[internAssemblySymbol(line.sub(0, count - 1))].predefined = true
}

// ---- .zdbg sidecar (little-endian) ----
fn writeDebug16Bits(outputBytes: [int], value: int) {
    outputBytes.push(value % 256)
    outputBytes.push((value / 256) % 256)
}
fn writeDebug32Bits(outputBytes: [int], value: int) {
    var valueLocal = value
    for i in 0..4 {
        outputBytes.push(valueLocal % 256)
        valueLocal = valueLocal / 256
    }
}
fn writeDebug64Bits(outputBytes: [int], value: int) {
    var valueLocal = value
    for i in 0..8 {
        outputBytes.push(valueLocal % 256)
        valueLocal = valueLocal / 256
    }
}
fn writeDebugString(outputBytes: [int], text: str) {
    for i in 0..text.len() { outputBytes.push(text.byte(i)) }
}

// Format: "ZDBG" | u16 version | u64 imagebase | u32 text_rva
//         | strtab: u32 nfiles, each (u16 len, bytes)
//         | lines:  u32 n, each (u32 rva, u32 fileIdx, u32 line)   sorted by rva
//         | funcs:  u32 n (0 for now)
// ponytail: text_rva mirrors writePe's `let text_rva = 4096`; single main file only.
fn writeDebugSymbols(path: str) {
    var outputBytes: [int] = []
    writeDebugString(outputBytes, "ZDBG")
    writeDebug16Bits(outputBytes, 1)
    writeDebug64Bits(outputBytes, 5368709120)         // imageBase (0x140000000)
    writeDebug32Bits(outputBytes, 4096)               // text_rva
    writeDebug32Bits(outputBytes, 1)                  // one source file
    writeDebug16Bits(outputBytes, mainSourceFile.len())
    writeDebugString(outputBytes, mainSourceFile)
    writeDebug32Bits(outputBytes, debugOffsets.len())
    for i in 0..debugOffsets.len() {
        writeDebug32Bits(outputBytes, 4096 + debugOffsets[i])  // rva
        writeDebug32Bits(outputBytes, 0)                  // fileIdx
        writeDebug32Bits(outputBytes, debugLines[i])        // line
    }
    writeDebug32Bits(outputBytes, 0)                  // funcs: none yet
    var parts: [str] = []
    for i in 0..outputBytes.len() { parts.push(chr(outputBytes[i])) }
    write_file(path, parts.join())
}

// ================= WebAssembly backend (--wasm) =================
//
// The fourth binary format this compiler writes by hand, and the only target
// that is not a register machine. Two decisions shape everything below.
//
// 1. Zephyr locals live in a SHADOW STACK in linear memory, not in wasm locals.
//    Wasm locals and the operand stack are not addressable, so a conservative
//    collector cannot scan them -- and Zephyr's GC finds its roots by scanning
//    the machine stack. Putting frames in linear memory means the existing GC
//    works here completely unchanged. It costs a load per variable read; the
//    alternative is spilling pointer-typed locals at every safepoint, which is
//    a precise-rootset project in its own right.
//
// 2. Every Zephyr value is 64 bits, so every wasm value is i64. Floats are
//    already stored as bit patterns (bits/frombits), so float arithmetic just
//    reinterprets around the operation. Addresses wrap to i32 at the load/store.

var wasmOutputBytes: [int] = []

fn writeUnsignedLeb128(rightValue: [int], value0: int) {                   // LEB128, unsigned
    var value = value0
    var going = true
    while going {
        let lowerBound = value & 127
        value = value >> 7
        if value != 0 { rightValue.push(lowerBound | 128) } else {
            rightValue.push(lowerBound)
            going = false
        }
    }
}

fn writeSignedLeb128(rightValue: [int], value0: int) {                   // LEB128, signed
    var value = value0
    var more = true
    while more {
        var lowerBound = value & 127
        value = value >> 7
        let sign = lowerBound & 64
        if (value == 0 and sign == 0) or (value == (0 - 1) and sign != 0) { more = false }
        else { lowerBound = lowerBound | 128 }
        rightValue.push(lowerBound)
    }
}

fn appendWasmBytes(destination: [int], source: [int]) {
    for i in 0..source.len() { destination.push(source[i]) }
}

fn writeWasmSection(id: int, body: [int]) {
    if body.len() == 0 { return }
    wasmOutputBytes.push(id)
    writeUnsignedLeb128(wasmOutputBytes, body.len())
    appendWasmBytes(wasmOutputBytes, body)
}

// ---- linear memory map ----
// 0      eight reserved bytes, so address 0 can keep meaning "none"
// 8      heap base    ) three constants the OS shim loads, because only the
// 16     stack bottom ) compiler knows where the data segment ended
// 24     stack top    )
// 32     data: string literals, type descriptors, vtables, C strings
// ...    globals block (8 * globalCount), zero-initialised
// ...    shadow stack, wasmStackBytes, growing DOWN from the heap base
// ...    heap: reserved by the GC, committed through memory.grow
let wasmMetaHeap = 8
let wasmMetaStackBottom = 16
let wasmMetaStackTop = 24
let wasmData = 32
let wasmStackBytes = 1048576                  // 1 MiB of shadow stack

var wasmDataBytes: [int] = []                      // the data segment, byte for byte
var wasmStringAddresses: [int] = []                     // address of each string literal
var wasmTypeAddresses: [int] = []                     // address of each type descriptor
var wasmCStringAddresses: [int] = []                     // address of each C string
var wasmPatchOffsets: [int] = []                      // deferred address slots in the data
var wasmPatchKinds: [int] = []
var wasmPatchIndices: [int] = []
var wasmDispatchAddresses: [int] = []                     // address of each interface vtable
var wasmPass = 1                              // pass 1 discovers literals; pass 2 emits
var wasmGlobalsAddress = 0                           // address of the globals block
var wasmStackBottom = 0
var wasmStackTop = 0
var wasmPageCount = 0

var wasmFunctionBody: [int] = []                           // body being emitted
var wasmCodeBytes: [int] = []                      // all bodies, concatenated
var wasmFunctionIndices: [int] = []                      // FDef index -> wasm function index
var wasmFunctionArities: [int] = []                     // wasm function index -> arity
var wasmControlDepth = 0                              // control-structure nesting depth
var wasmBreakDepths: [int] = []
var wasmContinueDepths: [int] = []
var wasmInlineDepths: [int] = []                       // nest depth of each open inline block
var wasmInlineSlots: [int] = []
var wasmFramePointerLocal = 0                                // wasm local index of the frame pointer
var wasmFrameSize = 0
var wasmSlotCount = 0
var wasmParameterCount = 0

fn newWasmByteBuffer() -> [int] {
    var leftValue: [int] = []
    return leftValue
}

// A small pool of i64 scratch locals. Needed wherever a value must outlive the
// evaluation of user code -- `.or()`'s default is lazy, so its receiver has to
// survive an arbitrary expression, and a single fixed local would collide with
// a nested `.or()`.
let wasmScratch = 8
var wasmScratchCount = 0

// Temporary GC roots. A half-built list or map has to stay reachable while its
// elements are evaluated, and the wasm operand stack is NOT scanned -- so these
// live in the frame, past the locals, where the conservative scan will find
// them. This is the whole reason frames are in linear memory.
let wasmRoots = 6
var wasmRootCount = 0

fn reserveWasmRoot(line: int) -> int {
    if wasmRootCount >= wasmRoots { failCompilation(line, "--wasm: too many live temporaries in one expression") }
    let offset = 8 * (wasmSlotCount + wasmParameterCount + wasmRootCount)
    wasmRootCount += 1
    return offset
}

fn releaseWasmRoot() { wasmRootCount -= 1 }

fn storeWasmRoot(offset: int) {                   // value on the stack -> root slot
    let scopeIndex = reserveWasmScratch(0)
    setWasmScratch(scopeIndex)
    emitWasmFrameAddress()
    getWasmScratch(scopeIndex)
    wasmFunctionBody.push(55)                              // i64.store
    writeUnsignedLeb128(wasmFunctionBody, 3)
    writeUnsignedLeb128(wasmFunctionBody, offset)
    releaseWasmScratch()
}

fn loadWasmRoot(offset: int) {
    emitWasmFrameAddress()
    wasmFunctionBody.push(41)                              // i64.load
    writeUnsignedLeb128(wasmFunctionBody, 3)
    writeUnsignedLeb128(wasmFunctionBody, offset)
}

// The closure environment arrives in a global rather than as an extra parameter,
// which keeps every function's signature (i64 x arity) -> i64. The prologue
// copies it into the frame immediately, so it is a GC root and cannot be
// clobbered by a nested indirect call.
fn wasmEnvironmentOffset() -> int { return 8 * (wasmSlotCount + wasmParameterCount + wasmRoots) }

fn loadWasmEnvironment() {
    emitWasmFrameAddress()
    wasmFunctionBody.push(41)
    writeUnsignedLeb128(wasmFunctionBody, 3)
    writeUnsignedLeb128(wasmFunctionBody, wasmEnvironmentOffset())
}

fn reserveWasmScratch(line: int) -> int {
    if wasmScratchCount >= wasmScratch { failCompilation(line, "--wasm: expression nests deeper than the scratch pool") }
    wasmScratchCount += 1
    return wasmFramePointerLocal + wasmScratchCount
}

fn releaseWasmScratch() { wasmScratchCount -= 1 }

fn setWasmScratch(index: int) {
    wasmFunctionBody.push(33)                              // local.set
    writeUnsignedLeb128(wasmFunctionBody, index)
}

fn getWasmScratch(index: int) {
    wasmFunctionBody.push(32)                              // local.get
    writeUnsignedLeb128(wasmFunctionBody, index)
}

// During pass one the address tables are still empty and the code is discarded,
// so any placeholder will do.
fn wasmStringAddress(index: int) -> int {
    if wasmPass == 1 { return 0 }
    return wasmStringAddresses[index]
}

fn wasmTypeAddress(index: int) -> int {
    if wasmPass == 1 { return 0 }
    return wasmTypeAddresses[index]
}

fn wasmDispatchAddress(index: int) -> int {
    if wasmPass == 1 { return 0 }
    return wasmDispatchAddresses[index]
}

fn emitWasmInteger(value: int) {
    wasmFunctionBody.push(66)                              // i64.const
    writeSignedLeb128(wasmFunctionBody, value)
}

fn emitWasmInteger32(value: int) {
    wasmFunctionBody.push(65)                              // i32.const
    writeSignedLeb128(wasmFunctionBody, value)
}

fn writeWasmInteger32(rightValue: [int], value: int) {
    rightValue.push(65)
    writeSignedLeb128(rightValue, value)
}

fn emitWasmFrameAddress() {
    wasmFunctionBody.push(32)                              // local.get fp
    writeUnsignedLeb128(wasmFunctionBody, wasmFramePointerLocal)
}

fn wasmSlotOffset(kind: int, index: int) -> int {
    if kind == identifierKindParameter { return 8 * (wasmSlotCount + index) }
    return 8 * index
}

fn loadWasmSlot(kind: int, index: int) {
    if kind == identifierKindGlobal { emitWasmInteger32(wasmGlobalsAddress + 8 * index) } else { emitWasmFrameAddress() }
    wasmFunctionBody.push(41)                              // i64.load
    writeUnsignedLeb128(wasmFunctionBody, 3)
    writeUnsignedLeb128(wasmFunctionBody, wasmSlotOffset(kind, index))
}

// stores are split: the address goes down first, then the value, then the op
fn storeWasmAddress(kind: int, index: int) {
    if kind == identifierKindGlobal { emitWasmInteger32(wasmGlobalsAddress + 8 * index) } else { emitWasmFrameAddress() }
}

fn finishWasmStore(kind: int, index: int) {
    wasmFunctionBody.push(55)                              // i64.store
    writeUnsignedLeb128(wasmFunctionBody, 3)
    writeUnsignedLeb128(wasmFunctionBody, wasmSlotOffset(kind, index))
}

fn emitWasmBranch(targetNest: int) {
    wasmFunctionBody.push(12)                              // br
    writeUnsignedLeb128(wasmFunctionBody, wasmControlDepth - targetNest)
}

fn restoreWasmStack() {
    emitWasmFrameAddress()
    emitWasmInteger32(wasmFrameSize)
    wasmFunctionBody.push(106)                             // i32.add
    wasmFunctionBody.push(36)                              // global.set __sp
    writeUnsignedLeb128(wasmFunctionBody, 0)
}

// a bool-typed i64 narrowed to the i32 that if/br_if want. Safe because the
// typechecker guarantees conditions are bools, so only 0 and 1 reach here.
fn emitWasmBoolean() { wasmFunctionBody.push(167) }                 // i32.wrap_i64

// Leaves the address of list[index] on the stack as an i32, bounds-checked.
// One unsigned compare covers both ends: a negative index is a huge unsigned.
fn emitWasmIndexAddress(listValue: Node, index: Node, line: int) {
    let leftIndex = reserveWasmScratch(line)
    let indexLocal = reserveWasmScratch(line)
    emitWasmExpression(listValue)
    setWasmScratch(leftIndex)
    emitWasmExpression(index)
    setWasmScratch(indexLocal)
    getWasmScratch(indexLocal)
    getWasmScratch(leftIndex)
    emitWasmBoolean()
    wasmFunctionBody.push(41)                              // i64.load: length
    writeUnsignedLeb128(wasmFunctionBody, 3)
    writeUnsignedLeb128(wasmFunctionBody, 0)
    wasmFunctionBody.push(90)                              // i64.ge_u
    wasmFunctionBody.push(4)                               // if
    wasmFunctionBody.push(64)
    wasmControlDepth += 1
    getWasmScratch(indexLocal)
    getWasmScratch(leftIndex)
    emitWasmBoolean()
    wasmFunctionBody.push(41)
    writeUnsignedLeb128(wasmFunctionBody, 3)
    writeUnsignedLeb128(wasmFunctionBody, 0)
    callWasmFunction("rt_bounds_fail")
    wasmFunctionBody.push(26)
    wasmControlDepth -= 1
    wasmFunctionBody.push(11)
    getWasmScratch(leftIndex)
    emitWasmBoolean()
    wasmFunctionBody.push(41)                              // i64.load: the data pointer
    writeUnsignedLeb128(wasmFunctionBody, 3)
    writeUnsignedLeb128(wasmFunctionBody, 16)
    getWasmScratch(indexLocal)
    emitWasmInteger(8)
    wasmFunctionBody.push(126)                             // i64.mul
    wasmFunctionBody.push(124)                             // i64.add
    emitWasmBoolean()
    releaseWasmScratch()
    releaseWasmScratch()
}

fn emitWasmExpression(expression: Node) {
    let key = expression.nodeKind
    if key == nodeInteger or key == nodeBoolean {
        emitWasmInteger(expression.integerValue)
        return
    }
    if key == nodeIfExpression {
        emitWasmExpression(expression.children[0])
        emitWasmBoolean()
        wasmFunctionBody.push(4)                           // if
        wasmFunctionBody.push(126)                         // result i64
        wasmControlDepth += 1
        emitWasmExpression(expression.children[1])
        wasmFunctionBody.push(5)                           // else
        emitWasmExpression(expression.children[2])
        wasmControlDepth -= 1
        wasmFunctionBody.push(11)                          // end
        return
    }
    if key == nodeLetExpression {
        emitWasmStatement(expression.children[0])
        emitWasmExpression(expression.children[1])
        return
    }
    if key == nodeFloat {
        emitWasmInteger(bits(expression.floatValue))
        return
    }
    if key == nodeIdentifier {
        if expression.auxiliary == identifierKindFunction {                // plain function as a value: {code, 0}
            let result = reserveWasmRoot(expression.line)
            emitWasmInteger(16)
            callWasmFunction("rt_alloc")
            storeWasmRoot(result)
            loadWasmRoot(result)
            emitWasmBoolean()
            emitWasmInteger(wasmFunctionIndices[expression.referenceIndex])          // the function-table index IS the code
            wasmFunctionBody.push(55)
            writeUnsignedLeb128(wasmFunctionBody, 3)
            writeUnsignedLeb128(wasmFunctionBody, 0)
            loadWasmRoot(result)
            emitWasmBoolean()
            emitWasmInteger(0)
            wasmFunctionBody.push(55)
            writeUnsignedLeb128(wasmFunctionBody, 3)
            writeUnsignedLeb128(wasmFunctionBody, 8)
            loadWasmRoot(result)
            releaseWasmRoot()
            return
        }
        if expression.auxiliary == identifierKindCapture {             // captured by value into the env
            loadWasmEnvironment()
            emitWasmBoolean()
            wasmFunctionBody.push(41)
            writeUnsignedLeb128(wasmFunctionBody, 3)
            writeUnsignedLeb128(wasmFunctionBody, 8 * expression.slot)
            return
        }
        loadWasmSlot(expression.auxiliary, expression.slot)
        return
    }
    if key == nodeFunctionLiteral {                        // closure: snapshot captures, build {code, env}
        let functionDefinition = functionDefinitions[expression.referenceIndex]
        let newCapacity = expression.children.len() - 3
        let environmentRoot = reserveWasmRoot(expression.line)
        let rcell = reserveWasmRoot(expression.line)
        emitWasmInteger(8 * newCapacity)
        callWasmFunction("rt_alloc")
        storeWasmRoot(environmentRoot)
        for i in 0..newCapacity {
            let scopeIndex = reserveWasmScratch(expression.line)
            emitWasmExpression(expression.children[3 + i])
            setWasmScratch(scopeIndex)
            loadWasmRoot(environmentRoot)
            emitWasmBoolean()
            getWasmScratch(scopeIndex)
            wasmFunctionBody.push(55)
            writeUnsignedLeb128(wasmFunctionBody, 3)
            writeUnsignedLeb128(wasmFunctionBody, 8 * i)
            releaseWasmScratch()
        }
        emitWasmInteger(16)
        callWasmFunction("rt_alloc")
        storeWasmRoot(rcell)
        loadWasmRoot(rcell)
        emitWasmBoolean()
        emitWasmInteger(wasmFunctionIndices[expression.referenceIndex])
        wasmFunctionBody.push(55)
        writeUnsignedLeb128(wasmFunctionBody, 3)
        writeUnsignedLeb128(wasmFunctionBody, 0)
        loadWasmRoot(rcell)
        emitWasmBoolean()
        loadWasmRoot(environmentRoot)
        wasmFunctionBody.push(55)
        writeUnsignedLeb128(wasmFunctionBody, 3)
        writeUnsignedLeb128(wasmFunctionBody, 8)
        loadWasmRoot(rcell)
        releaseWasmRoot()
        releaseWasmRoot()
        return
    }
    if key == nodeInterfaceBox {                         // interface value: {vtable, data} cell
        let descriptorRoot = reserveWasmRoot(expression.line)
        let referenceCount = reserveWasmRoot(expression.line)
        emitWasmExpression(expression.children[0])
        storeWasmRoot(descriptorRoot)
        emitWasmInteger(16)
        callWasmFunction("rt_alloc")
        storeWasmRoot(referenceCount)
        loadWasmRoot(referenceCount)
        emitWasmBoolean()
        emitWasmInteger(wasmDispatchAddress(expression.operator))
        wasmFunctionBody.push(55)
        writeUnsignedLeb128(wasmFunctionBody, 3)
        writeUnsignedLeb128(wasmFunctionBody, 0)
        loadWasmRoot(referenceCount)
        emitWasmBoolean()
        loadWasmRoot(descriptorRoot)
        wasmFunctionBody.push(55)
        writeUnsignedLeb128(wasmFunctionBody, 3)
        writeUnsignedLeb128(wasmFunctionBody, 8)
        loadWasmRoot(referenceCount)
        releaseWasmRoot()
        releaseWasmRoot()
        return
    }
    if key == nodeNegate {
        if expression.typeIndex == typeIdFloat {
            // f64.neg flips the sign bit; 0.0 - x would turn -0.0 into +0.0
            emitWasmExpression(expression.children[0])
            wasmFunctionBody.push(191)                     // f64.reinterpret_i64
            wasmFunctionBody.push(154)                     // f64.neg
            wasmFunctionBody.push(189)                     // i64.reinterpret_f64
            return
        }
        emitWasmInteger(0)
        emitWasmExpression(expression.children[0])
        wasmFunctionBody.push(125)                         // i64.sub
        return
    }
    if key == nodeNot {
        emitWasmExpression(expression.children[0])
        wasmFunctionBody.push(80)                          // i64.eqz -> i32
        wasmFunctionBody.push(173)                         // i64.extend_i32_u
        return
    }
    if key == nodeStringLiteral {
        // a lone text part is a constant: just its address in the data segment
        if expression.children.len() == 1 and expression.children[0].nodeKind == nodeStringText {
            emitWasmInteger(wasmStringAddress(addDstr(expression.children[0].name)))
            return
        }
        // otherwise build through the runtime's string builder and materialise
        // one string at the end -- the same shape the native backend uses
        // The mark rides the wasm operand stack across the parts: each part is
        // stack-balanced, so nested interpolation nests correctly with no
        // scratch local to collide over.
        callWasmFunction("rt_sb_begin")
        for i in 0..expression.children.len() {
            let address = expression.children[i]
            if address.nodeKind == nodeStringText {
                emitWasmInteger(wasmStringAddress(addDstr(address.name)))
                callWasmFunction("rt_sb_txt")
                wasmFunctionBody.push(26)
            } else {
                emitWasmExpression(address.children[0])
                emitWasmInteger(wasmTypeAddress(address.slot))
                callWasmFunction("rt_sb_val")
                wasmFunctionBody.push(26)
            }
        }
        callWasmFunction("rt_sb_end")
        return
    }
    if key == nodeNoneLiteral {
        emitWasmInteger(0)                            // none is the null pointer
        return
    }
    if key == nodeList {
        let result = reserveWasmRoot(expression.line)
        emitWasmInteger(expression.children.len())
        callWasmFunction("rt_list_new")
        storeWasmRoot(result)
        for i in 0..expression.children.len() {
            let scopeIndex = reserveWasmScratch(expression.line)
            emitWasmExpression(expression.children[i])                 // may allocate; the list is rooted
            setWasmScratch(scopeIndex)
            loadWasmRoot(result)
            emitWasmBoolean()
            wasmFunctionBody.push(41)                      // i64.load: the data pointer
            writeUnsignedLeb128(wasmFunctionBody, 3)
            writeUnsignedLeb128(wasmFunctionBody, 16)
            emitWasmBoolean()
            getWasmScratch(scopeIndex)
            wasmFunctionBody.push(55)
            writeUnsignedLeb128(wasmFunctionBody, 3)
            writeUnsignedLeb128(wasmFunctionBody, 8 * i)
            releaseWasmScratch()
        }
        loadWasmRoot(result)
        releaseWasmRoot()
        return
    }
    if key == nodeMapLiteral {
        let result = reserveWasmRoot(expression.line)
        if mapKeyKind(expression.typeIndex) == 2 { emitWasmInteger(wasmTypeAddress(typeDescriptorIndex(typeDefinitionIds[expression.typeIndex]))) }
        else { emitWasmInteger(mapKeyKind(expression.typeIndex)) }
        callWasmFunction("rt_map_new")
        storeWasmRoot(result)
        let setterFunction = mapSetterFunction(expression.typeIndex)
        var memberIndex = 0
        while memberIndex < expression.children.len() {
            let keySlot = reserveWasmScratch(expression.line)
            let values = reserveWasmScratch(expression.line)
            emitWasmExpression(expression.children[memberIndex])
            setWasmScratch(keySlot)
            emitWasmExpression(expression.children[memberIndex + 1])
            setWasmScratch(values)
            loadWasmRoot(result)
            getWasmScratch(keySlot)
            getWasmScratch(values)
            callWasmFunction(setterFunction)
            wasmFunctionBody.push(26)
            releaseWasmScratch()
            releaseWasmScratch()
            memberIndex += 2
        }
        loadWasmRoot(result)
        releaseWasmRoot()
        return
    }
    if key == nodeStructLiteral {
        let structIndex = structDefinitions[expression.referenceIndex]
        let result = reserveWasmRoot(expression.line)
        emitWasmInteger(8 * structIndex.fieldNames.len())
        callWasmFunction("rt_alloc")
        storeWasmRoot(result)
        for functionDefinition in expression.children {
            let scopeIndex = reserveWasmScratch(expression.line)
            emitWasmExpression(functionDefinition.children[0])
            setWasmScratch(scopeIndex)
            loadWasmRoot(result)
            emitWasmBoolean()
            getWasmScratch(scopeIndex)
            wasmFunctionBody.push(55)
            writeUnsignedLeb128(wasmFunctionBody, 3)
            writeUnsignedLeb128(wasmFunctionBody, 8 * functionDefinition.slot)
            releaseWasmScratch()
        }
        loadWasmRoot(result)
        releaseWasmRoot()
        return
    }
    if key == nodeIndex {
        if typeKinds[expression.children[0].typeIndex] == kindMap {
            let result = reserveWasmRoot(expression.line)
            emitWasmExpression(expression.children[0])
            storeWasmRoot(result)
            loadWasmRoot(result)
            emitWasmExpression(expression.children[1])
            callWasmFunction(mapGetterFunction(expression.children[0].typeIndex))
            releaseWasmRoot()
            return
        }
        emitWasmIndexAddress(expression.children[0], expression.children[1], expression.line)
        wasmFunctionBody.push(41)                          // i64.load
        writeUnsignedLeb128(wasmFunctionBody, 3)
        writeUnsignedLeb128(wasmFunctionBody, 0)
        return
    }
    if key == nodeMember {
        emitWasmExpression(expression.children[0])
        emitWasmBoolean()
        wasmFunctionBody.push(41)
        writeUnsignedLeb128(wasmFunctionBody, 3)
        writeUnsignedLeb128(wasmFunctionBody, 8 * expression.slot)
        return
    }
    if key == nodeCast {
        emitWasmCast(expression)
        return
    }
    if key == nodeBinary {
        emitWasmBinary(expression)
        return
    }
    if key == nodeCall {
        emitWasmCall(expression)
        return
    }
    failCompilation(expression.line, "--wasm: unsupported expression kind {key}")
}

fn emitWasmCast(expression: Node) {
    let callKind = expression.auxiliary
    emitWasmExpression(expression.children[0])
    if callKind == castKindIntegerToFloat {
        wasmFunctionBody.push(185)                         // f64.convert_i64_s
        wasmFunctionBody.push(189)                         // i64.reinterpret_f64
        return
    }
    if callKind == castKindTruncate {
        wasmFunctionBody.push(191)                         // f64.reinterpret_i64
        wasmFunctionBody.push(176)                         // i64.trunc_f64_s
        return
    }
    if callKind != castKindNoOperation { failCompilation(expression.line, "--wasm: unsupported cast kind {callKind}") }
}

// float binop: reinterpret both operands, operate, reinterpret the result back
fn emitWasmFloatBinary(expression: Node, opcode: int, isRelation: bool) {
    emitWasmExpression(expression.children[0])
    wasmFunctionBody.push(191)
    emitWasmExpression(expression.children[1])
    wasmFunctionBody.push(191)
    wasmFunctionBody.push(opcode)
    if isRelation { wasmFunctionBody.push(173) } else { wasmFunctionBody.push(189) }
}

fn emitWasmBinary(expression: Node) {
    let operator = expression.operator
    if operator == tokenAnd or operator == tokenOr {
        // short-circuit as a block that yields i64. The left value is kept in a
        // scratch local so the condition test can consume a copy of it.
        wasmFunctionBody.push(2)                           // block
        wasmFunctionBody.push(126)                         // result i64
        wasmControlDepth += 1
        let scopeIndex = reserveWasmScratch(expression.line)
        emitWasmExpression(expression.children[0])
        setWasmScratch(scopeIndex)
        getWasmScratch(scopeIndex)                          // candidate result
        getWasmScratch(scopeIndex)
        emitWasmBoolean()
        if operator == tokenAnd { wasmFunctionBody.push(69) }       // i32.eqz: false short-circuits `and`
        wasmFunctionBody.push(13)                          // br_if 0 -> leave the candidate
        writeUnsignedLeb128(wasmFunctionBody, 0)
        wasmFunctionBody.push(26)                          // drop the candidate
        releaseWasmScratch()                           // the scratch is dead before the RHS
        emitWasmExpression(expression.children[1])
        wasmControlDepth -= 1
        wasmFunctionBody.push(11)                          // end
        return
    }
    let category = expression.auxiliary
    if category == binaryCategoryFloat {
        if operator == tokenPlus {
            emitWasmFloatBinary(expression, 160, false)
            return
        }
        if operator == tokenMinus {
            emitWasmFloatBinary(expression, 161, false)
            return
        }
        if operator == tokenStar {
            emitWasmFloatBinary(expression, 162, false)
            return
        }
        if operator == tokenSlash {
            emitWasmFloatBinary(expression, 163, false)
            return
        }
        if operator == tokenEquals {
            emitWasmFloatBinary(expression, 97, true)
            return
        }
        if operator == tokenNotEquals {
            emitWasmFloatBinary(expression, 98, true)
            return
        }
        if operator == tokenLessThan {
            emitWasmFloatBinary(expression, 99, true)
            return
        }
        if operator == tokenGreaterThan {
            emitWasmFloatBinary(expression, 100, true)
            return
        }
        if operator == tokenLessOrEqual {
            emitWasmFloatBinary(expression, 101, true)
            return
        }
        if operator == tokenGreaterOrEqual {
            emitWasmFloatBinary(expression, 102, true)
            return
        }
        failCompilation(expression.line, "--wasm: unsupported float operator")
    }
    if category == binaryCategoryString {
        // The left string has to survive evaluation of the right one, which can
        // allocate -- so it goes in a frame root, not on the operand stack.
        let result = reserveWasmRoot(expression.line)
        emitWasmExpression(expression.children[0])
        storeWasmRoot(result)
        loadWasmRoot(result)
        emitWasmExpression(expression.children[1])
        releaseWasmRoot()
        if operator == tokenPlus {
            callWasmFunction("rt_str_concat")
            return
        }
        if operator == tokenEquals or operator == tokenNotEquals {
            if expression.slot > 0 {
                emitWasmInteger(wasmTypeAddress(expression.slot - 1))
                callWasmFunction("rt_value_eq")
            } else {
                callWasmFunction("rt_str_eq")
            }
            if operator == tokenNotEquals {
                emitWasmInteger(1)
                wasmFunctionBody.push(133)                 // i64.xor
            }
            return
        }
        callWasmFunction("rt_str_cmp")
        emitWasmInteger(0)
        var stringRelation = 0
        if operator == tokenLessThan { stringRelation = 83 }
        else if operator == tokenGreaterThan { stringRelation = 85 }
        else if operator == tokenLessOrEqual { stringRelation = 87 }
        else if operator == tokenGreaterOrEqual { stringRelation = 89 }
        if stringRelation == 0 { failCompilation(expression.line, "--wasm: unsupported string operator") }
        wasmFunctionBody.push(stringRelation)
        wasmFunctionBody.push(173)
        return
    }
    emitWasmExpression(expression.children[0])
    emitWasmExpression(expression.children[1])
    if operator == tokenPlus {
        wasmFunctionBody.push(124)
        return
    }
    if operator == tokenMinus {
        wasmFunctionBody.push(125)
        return
    }
    if operator == tokenStar {
        wasmFunctionBody.push(126)
        return
    }
    if operator == tokenSlash {
        wasmFunctionBody.push(127)
        return
    }
    if operator == tokenPercent {
        wasmFunctionBody.push(129)
        return
    }
    if operator == tokenAmpersand {
        wasmFunctionBody.push(131)
        return
    }
    if operator == tokenPipe {
        wasmFunctionBody.push(132)
        return
    }
    if operator == tokenCaret {
        wasmFunctionBody.push(133)
        return
    }
    if operator == tokenShiftLeft {
        wasmFunctionBody.push(134)
        return
    }
    if operator == tokenShiftRight {
        wasmFunctionBody.push(135)
        return
    }
    var relationCode = 0
    if operator == tokenEquals { relationCode = 81 }
    else if operator == tokenNotEquals { relationCode = 82 }
    else if operator == tokenLessThan { relationCode = 83 }
    else if operator == tokenGreaterThan { relationCode = 85 }
    else if operator == tokenLessOrEqual { relationCode = 87 }
    else if operator == tokenGreaterOrEqual { relationCode = 89 }
    if relationCode == 0 { failCompilation(expression.line, "--wasm: unsupported operator") }
    wasmFunctionBody.push(relationCode)
    wasmFunctionBody.push(173)                             // i64.extend_i32_u
}

fn emitWasmCall(expression: Node) {
    let key = expression.auxiliary
    if key == callKindUser {
        if expression.operator == 1 { emitWasmExpression(expression.children[0].children[0]) }        // UFCS receiver is arg 0
        for i in 1..expression.children.len() { emitWasmExpression(expression.children[i]) }
        wasmFunctionBody.push(16)                          // call
        writeUnsignedLeb128(wasmFunctionBody, wasmFunctionIndices[expression.referenceIndex])
        return
    }
    if key == callKindPrint {
        // with the runtime linked, print goes through it exactly as it does
        // natively, so formatting is identical across all three targets
        if findWasmFunction("rt_print_val") >= 0 {
            emitWasmExpression(expression.children[1])
            emitWasmInteger(wasmTypeAddress(expression.slot))
            callWasmFunction("rt_print_val")
            wasmFunctionBody.push(26)                      // rt_print_val is void
            emitWasmInteger(0)
            return
        }
        let typeIndex = expression.children[1].typeIndex
        emitWasmExpression(expression.children[1])
        if typeIndex == typeIdFloat {
            wasmFunctionBody.push(191)                     // f64.reinterpret_i64
            wasmFunctionBody.push(16)
            writeUnsignedLeb128(wasmFunctionBody, 1)
        } else if typeIndex == typeIdBoolean {
            wasmFunctionBody.push(16)
            writeUnsignedLeb128(wasmFunctionBody, 2)
        } else {
            wasmFunctionBody.push(16)
            writeUnsignedLeb128(wasmFunctionBody, 0)
        }
        emitWasmInteger(0)                            // print is void; every call yields i64
        return
    }
    if key == callKindWasmGrowMemory {
        emitWasmExpression(expression.children[1])
        emitWasmBoolean()
        wasmFunctionBody.push(64)                          // memory.grow
        wasmFunctionBody.push(0)
        wasmFunctionBody.push(172)                         // i64.extend_i32_s
        return
    }
    if key == callKindWasmHostWrite {
        for i in 1..expression.children.len() { emitWasmExpression(expression.children[i]) }
        wasmFunctionBody.push(16)
        writeUnsignedLeb128(wasmFunctionBody, 3)
        emitWasmInteger(0)
        return
    }
    if key == callKindWasmHostExit {
        emitWasmExpression(expression.children[1])
        wasmFunctionBody.push(16)
        writeUnsignedLeb128(wasmFunctionBody, 4)
        emitWasmInteger(0)
        return
    }
    if key == callKindRuntimeCall {
        emitWasmExpression(expression.children[0].children[0])             // receiver
        for i in 1..expression.children.len() { emitWasmExpression(expression.children[i]) }
        callWasmFunction(expression.name)
        return
    }
    if key == callKindLength {
        emitWasmExpression(expression.children[0].children[0])
        emitWasmBoolean()
        wasmFunctionBody.push(41)                          // i64.load: length is the first word
        writeUnsignedLeb128(wasmFunctionBody, 3)
        writeUnsignedLeb128(wasmFunctionBody, 0)
        return
    }
    if key == callKindPush {
        emitWasmExpression(expression.children[0].children[0])
        emitWasmExpression(expression.children[1])
        callWasmFunction("rt_list_push")
        return
    }
    if key == callKindPop {
        emitWasmExpression(expression.children[0].children[0])
        callWasmFunction("rt_list_pop")
        return
    }
    if key == callKindOptionalHas {
        emitWasmExpression(expression.children[0].children[0])
        emitWasmInteger(0)
        wasmFunctionBody.push(82)                          // i64.ne
        wasmFunctionBody.push(173)
        return
    }
    if key == callKindOptionalGet {
        let scopeIndex = reserveWasmScratch(expression.line)
        emitWasmExpression(expression.children[0].children[0])
        setWasmScratch(scopeIndex)
        getWasmScratch(scopeIndex)
        wasmFunctionBody.push(80)                          // i64.eqz
        wasmFunctionBody.push(4)                           // if
        wasmFunctionBody.push(64)
        wasmControlDepth += 1
        emitWasmInteger(wasmStringAddress(addDstr("called .get() on a none value")))
        callWasmFunction("rt_panic_str")
        wasmFunctionBody.push(26)
        wasmControlDepth -= 1
        wasmFunctionBody.push(11)
        getWasmScratch(scopeIndex)
        emitWasmBoolean()
        wasmFunctionBody.push(41)
        writeUnsignedLeb128(wasmFunctionBody, 3)
        writeUnsignedLeb128(wasmFunctionBody, 0)
        releaseWasmScratch()
        return
    }
    if key == callKindOptionalOr {
        let scopeIndex = reserveWasmScratch(expression.line)
        emitWasmExpression(expression.children[0].children[0])
        setWasmScratch(scopeIndex)
        wasmFunctionBody.push(2)                           // block (result i64)
        wasmFunctionBody.push(126)
        wasmControlDepth += 1
        getWasmScratch(scopeIndex)
        wasmFunctionBody.push(80)                          // i64.eqz
        wasmFunctionBody.push(4)                           // if
        wasmFunctionBody.push(64)
        wasmControlDepth += 1
        // none: the default is lazy, so it is only evaluated on this path
        releaseWasmScratch()
        emitWasmExpression(expression.children[1])
        emitWasmBranch(wasmControlDepth - 1)
        wasmControlDepth -= 1
        wasmFunctionBody.push(11)
        getWasmScratch(scopeIndex)
        emitWasmBoolean()
        wasmFunctionBody.push(41)
        writeUnsignedLeb128(wasmFunctionBody, 3)
        writeUnsignedLeb128(wasmFunctionBody, 0)
        wasmControlDepth -= 1
        wasmFunctionBody.push(11)
        return
    }
    if key == callKindAssert {
        emitWasmExpression(expression.children[1])
        emitWasmBoolean()
        wasmFunctionBody.push(69)                          // i32.eqz
        wasmFunctionBody.push(4)
        wasmFunctionBody.push(64)
        wasmControlDepth += 1
        if expression.children.len() > 2 { emitWasmExpression(expression.children[2]) }
        else { emitWasmInteger(wasmStringAddress(addDstr("assertion failed"))) }
        callWasmFunction("rt_panic_str")
        wasmFunctionBody.push(26)
        wasmControlDepth -= 1
        wasmFunctionBody.push(11)
        emitWasmInteger(0)
        return
    }
    if key == callKindMin or key == callKindMax {
        if expression.typeIndex == typeIdFloat {
            emitWasmExpression(expression.children[1])
            wasmFunctionBody.push(191)
            emitWasmExpression(expression.children[2])
            wasmFunctionBody.push(191)
            if key == callKindMin { wasmFunctionBody.push(164) } else { wasmFunctionBody.push(165) }
            wasmFunctionBody.push(189)
            return
        }
        let leftValue = reserveWasmScratch(expression.line)
        let rightValue = reserveWasmScratch(expression.line)
        emitWasmExpression(expression.children[1])
        setWasmScratch(leftValue)
        emitWasmExpression(expression.children[2])
        setWasmScratch(rightValue)
        getWasmScratch(leftValue)
        getWasmScratch(rightValue)
        getWasmScratch(leftValue)
        getWasmScratch(rightValue)
        if key == callKindMin { wasmFunctionBody.push(83) } else { wasmFunctionBody.push(85) }   // lt_s / gt_s
        wasmFunctionBody.push(27)                          // select: a if the test holds
        releaseWasmScratch()
        releaseWasmScratch()
        return
    }
    if key == callKindAbsolute and expression.typeIndex != typeIdFloat {
        let leftValue = reserveWasmScratch(expression.line)
        emitWasmExpression(expression.children[1])
        setWasmScratch(leftValue)
        getWasmScratch(leftValue)
        emitWasmInteger(0)
        getWasmScratch(leftValue)
        wasmFunctionBody.push(125)                         // i64.sub: negated
        getWasmScratch(leftValue)
        emitWasmInteger(0)
        wasmFunctionBody.push(89)                          // i64.ge_s
        wasmFunctionBody.push(27)                          // select
        releaseWasmScratch()
        return
    }
    if key == callKindPower {
        emitWasmExpression(expression.children[1])
        emitWasmExpression(expression.children[2])
        callWasmFunction("rt_ipow")
        return
    }
    if key == callKindSubstring {
        let result = reserveWasmRoot(expression.line)
        emitWasmExpression(expression.children[0].children[0])
        storeWasmRoot(result)
        loadWasmRoot(result)
        emitWasmExpression(expression.children[1])
        emitWasmExpression(expression.children[2])
        callWasmFunction("rt_str_sub")
        releaseWasmRoot()
        return
    }
    if key == callKindJoin {
        emitWasmExpression(expression.children[0].children[0])
        callWasmFunction("rt_join")
        return
    }
    if key == callKindByte {
        let scopeIndex = reserveWasmScratch(expression.line)
        let index = reserveWasmScratch(expression.line)
        emitWasmExpression(expression.children[0].children[0])
        setWasmScratch(scopeIndex)
        emitWasmExpression(expression.children[1])
        setWasmScratch(index)
        getWasmScratch(index)                          // bounds: one unsigned compare
        getWasmScratch(scopeIndex)
        emitWasmBoolean()
        wasmFunctionBody.push(41)
        writeUnsignedLeb128(wasmFunctionBody, 3)
        writeUnsignedLeb128(wasmFunctionBody, 0)
        wasmFunctionBody.push(90)                          // i64.ge_u
        wasmFunctionBody.push(4)
        wasmFunctionBody.push(64)
        wasmControlDepth += 1
        getWasmScratch(index)
        getWasmScratch(scopeIndex)
        emitWasmBoolean()
        wasmFunctionBody.push(41)
        writeUnsignedLeb128(wasmFunctionBody, 3)
        writeUnsignedLeb128(wasmFunctionBody, 0)
        callWasmFunction("rt_bounds_fail")
        wasmFunctionBody.push(26)
        wasmControlDepth -= 1
        wasmFunctionBody.push(11)
        getWasmScratch(scopeIndex)
        getWasmScratch(index)
        wasmFunctionBody.push(124)                         // i64.add
        emitWasmBoolean()
        wasmFunctionBody.push(49)                          // i64.load8_u, past the length word
        writeUnsignedLeb128(wasmFunctionBody, 0)
        writeUnsignedLeb128(wasmFunctionBody, 8)
        releaseWasmScratch()
        releaseWasmScratch()
        return
    }
    if key == callKindIndirect {
        // Call through a {code, env} cell. code is a function-table index; env
        // travels in a global that the callee's prologue immediately spills to
        // its frame. Arguments are evaluated BEFORE the global is set, so a
        // nested indirect call in an argument cannot clobber it.
        let result = reserveWasmRoot(expression.line)
        var count = 0
        emitWasmExpression(expression.children[0])
        storeWasmRoot(result)
        for i in 1..expression.children.len() {
            emitWasmExpression(expression.children[i])
            count += 1
        }
        loadWasmRoot(result)
        emitWasmBoolean()
        wasmFunctionBody.push(41)                          // env = cell[8]
        writeUnsignedLeb128(wasmFunctionBody, 3)
        writeUnsignedLeb128(wasmFunctionBody, 8)
        wasmFunctionBody.push(36)                          // global.set __env
        writeUnsignedLeb128(wasmFunctionBody, 1)
        loadWasmRoot(result)
        emitWasmBoolean()
        wasmFunctionBody.push(41)                          // code = cell[0]
        writeUnsignedLeb128(wasmFunctionBody, 3)
        writeUnsignedLeb128(wasmFunctionBody, 0)
        emitWasmBoolean()
        wasmFunctionBody.push(17)                          // call_indirect
        writeUnsignedLeb128(wasmFunctionBody, 5 + count)
        writeUnsignedLeb128(wasmFunctionBody, 0)                            // table 0
        releaseWasmRoot()
        return
    }
    if key == callKindInterfaceDispatch {
        // Virtual call: the interface value is a {vtable, data} cell, and the
        // vtable slot holds a function-table index.
        let result = reserveWasmRoot(expression.line)
        emitWasmExpression(expression.children[0].children[0])
        storeWasmRoot(result)
        loadWasmRoot(result)
        emitWasmBoolean()
        wasmFunctionBody.push(41)                          // self = data
        writeUnsignedLeb128(wasmFunctionBody, 3)
        writeUnsignedLeb128(wasmFunctionBody, 8)
        for i in 1..expression.children.len() { emitWasmExpression(expression.children[i]) }
        loadWasmRoot(result)
        emitWasmBoolean()
        wasmFunctionBody.push(41)                          // vtable
        writeUnsignedLeb128(wasmFunctionBody, 3)
        writeUnsignedLeb128(wasmFunctionBody, 0)
        emitWasmBoolean()
        wasmFunctionBody.push(41)                          // method index
        writeUnsignedLeb128(wasmFunctionBody, 3)
        writeUnsignedLeb128(wasmFunctionBody, 8 * expression.slot)
        emitWasmBoolean()
        wasmFunctionBody.push(17)                          // call_indirect
        writeUnsignedLeb128(wasmFunctionBody, 5 + expression.children.len())             // self plus the declared arguments
        writeUnsignedLeb128(wasmFunctionBody, 0)
        releaseWasmRoot()
        return
    }
    if key == callKindReadFile {
        emitWasmExpression(expression.children[1])
        callWasmFunction("rt_read_file")
        return
    }
    if key == callKindWriteFile {
        let result = reserveWasmRoot(expression.line)
        emitWasmExpression(expression.children[1])
        storeWasmRoot(result)
        loadWasmRoot(result)
        emitWasmExpression(expression.children[2])
        callWasmFunction("rt_write_file")
        releaseWasmRoot()
        return
    }
    if key == callKindEmit {
        emitWasmExpression(expression.children[1])
        callWasmFunction("rt_emit")
        wasmFunctionBody.push(26)
        emitWasmInteger(0)
        return
    }
    if key == callKindPanic {
        emitWasmExpression(expression.children[1])
        callWasmFunction("rt_panic_str")
        wasmFunctionBody.push(26)
        emitWasmInteger(0)
        return
    }
    if key == callKindZeros {
        emitWasmExpression(expression.children[1])
        callWasmFunction("rt_list_new")
        return
    }
    if key == callKindArguments {
        callWasmFunction("rt_args")
        return
    }
    if key == callKindCharacter {
        emitWasmExpression(expression.children[1])
        callWasmFunction("rt_chr")
        return
    }
    if key == callKindLoad64 {
        emitWasmExpression(expression.children[1])
        emitWasmBoolean()
        wasmFunctionBody.push(41)
        writeUnsignedLeb128(wasmFunctionBody, 3)
        writeUnsignedLeb128(wasmFunctionBody, 0)
        return
    }
    if key == callKindLoad8 {
        emitWasmExpression(expression.children[1])
        emitWasmBoolean()
        wasmFunctionBody.push(49)                          // i64.load8_u
        writeUnsignedLeb128(wasmFunctionBody, 0)
        writeUnsignedLeb128(wasmFunctionBody, 0)
        return
    }
    if key == callKindLoad32 or key == callKindLoad16 {
        emitWasmExpression(expression.children[1])
        emitWasmBoolean()
        if key == callKindLoad32 {
            wasmFunctionBody.push(53)                      // i64.load32_u
            writeUnsignedLeb128(wasmFunctionBody, 2)
        } else {
            wasmFunctionBody.push(51)                      // i64.load16_u
            writeUnsignedLeb128(wasmFunctionBody, 1)
        }
        writeUnsignedLeb128(wasmFunctionBody, 0)
        return
    }
    if key == callKindStore64 or key == callKindStore32 or key == callKindStore8 {
        emitWasmExpression(expression.children[1])
        emitWasmBoolean()
        emitWasmExpression(expression.children[2])
        if key == callKindStore64 {
            wasmFunctionBody.push(55)
            writeUnsignedLeb128(wasmFunctionBody, 3)
        } else if key == callKindStore32 {
            wasmFunctionBody.push(62)                      // i64.store32
            writeUnsignedLeb128(wasmFunctionBody, 2)
        } else {
            wasmFunctionBody.push(60)                      // i64.store8
            writeUnsignedLeb128(wasmFunctionBody, 0)
        }
        writeUnsignedLeb128(wasmFunctionBody, 0)
        emitWasmInteger(0)
        return
    }
    if key == callKindStackPointer {
        emitWasmFrameAddress()
        wasmFunctionBody.push(172)                         // i64.extend_i32_s
        return
    }
    if key == callKindSquareRoot {
        emitWasmExpression(expression.children[1])
        wasmFunctionBody.push(191)
        wasmFunctionBody.push(159)                         // f64.sqrt
        wasmFunctionBody.push(189)
        return
    }
    if key == callKindBits {        // identity: values are bits
        emitWasmExpression(expression.children[1])
        return
    }
    if key == callKindAbsolute and expression.typeIndex == typeIdFloat {
        emitWasmExpression(expression.children[1])
        wasmFunctionBody.push(191)
        wasmFunctionBody.push(153)                         // f64.abs
        wasmFunctionBody.push(189)
        return
    }
    failCompilation(expression.line, "--wasm: unsupported call kind {key}")
}

fn emitWasmStatement(statement: Node) {
    let key = statement.nodeKind
    if key == nodeDeclaration {
        storeWasmAddress(statement.auxiliary, statement.slot)
        emitWasmExpression(statement.children[0])
        finishWasmStore(statement.auxiliary, statement.slot)
        return
    }
    if key == nodeAssign {
        let typeIndex = statement.children[0]
        if typeIndex.nodeKind == nodeIdentifier {
            storeWasmAddress(typeIndex.auxiliary, typeIndex.slot)
            emitWasmExpression(statement.children[1])
            finishWasmStore(typeIndex.auxiliary, typeIndex.slot)
            return
        }
        if typeIndex.nodeKind == nodeMember {
            let scopeIndex = reserveWasmScratch(statement.line)
            emitWasmExpression(statement.children[1])                 // value first, then the object:
            setWasmScratch(scopeIndex)                      // the object must not be stale
            emitWasmExpression(typeIndex.children[0])
            emitWasmBoolean()
            getWasmScratch(scopeIndex)
            wasmFunctionBody.push(55)
            writeUnsignedLeb128(wasmFunctionBody, 3)
            writeUnsignedLeb128(wasmFunctionBody, 8 * typeIndex.slot)
            releaseWasmScratch()
            return
        }
        if typeIndex.nodeKind == nodeIndex {
            if typeKinds[typeIndex.children[0].typeIndex] == kindMap {
                let result = reserveWasmRoot(statement.line)
                let keySlot = reserveWasmScratch(statement.line)
                emitWasmExpression(typeIndex.children[0])
                storeWasmRoot(result)
                emitWasmExpression(typeIndex.children[1])
                setWasmScratch(keySlot)
                loadWasmRoot(result)
                getWasmScratch(keySlot)
                emitWasmExpression(statement.children[1])
                callWasmFunction(mapSetterFunction(typeIndex.children[0].typeIndex))
                wasmFunctionBody.push(26)
                releaseWasmScratch()
                releaseWasmRoot()
                return
            }
            let scopeIndex = reserveWasmScratch(statement.line)
            emitWasmExpression(statement.children[1])
            setWasmScratch(scopeIndex)
            emitWasmIndexAddress(typeIndex.children[0], typeIndex.children[1], statement.line)
            getWasmScratch(scopeIndex)
            wasmFunctionBody.push(55)
            writeUnsignedLeb128(wasmFunctionBody, 3)
            writeUnsignedLeb128(wasmFunctionBody, 0)
            releaseWasmScratch()
            return
        }
        failCompilation(statement.line, "--wasm: unsupported assignment target")
    }
    if key == nodeExpressionStatement {
        emitWasmExpression(statement.children[0])
        wasmFunctionBody.push(26)                          // drop
        return
    }
    if key == nodeReturn {
        if statement.children[0].nodeKind != nodeNone { emitWasmExpression(statement.children[0]) } else { emitWasmInteger(0) }
        restoreWasmStack()
        wasmFunctionBody.push(15)                          // return
        return
    }
    if key == nodeIf {
        emitWasmExpression(statement.children[0])
        emitWasmBoolean()
        wasmFunctionBody.push(4)                           // if
        wasmFunctionBody.push(64)                          // void
        wasmControlDepth += 1
        emitWasmBlock(statement.children[1])
        if statement.children[2].nodeKind != nodeNone {
            wasmFunctionBody.push(5)                       // else
            emitWasmBlock(statement.children[2])
        }
        wasmControlDepth -= 1
        wasmFunctionBody.push(11)                          // end
        return
    }
    if key == nodeWhile {
        wasmFunctionBody.push(2)                           // block: break target
        wasmFunctionBody.push(64)
        wasmControlDepth += 1
        let breakLabel = wasmControlDepth
        wasmFunctionBody.push(3)                           // loop: continue target
        wasmFunctionBody.push(64)
        wasmControlDepth += 1
        let continueLabel = wasmControlDepth
        emitWasmExpression(statement.children[0])
        emitWasmBoolean()
        wasmFunctionBody.push(69)                          // i32.eqz
        wasmFunctionBody.push(13)                          // br_if -> leave the block
        writeUnsignedLeb128(wasmFunctionBody, wasmControlDepth - breakLabel)
        wasmBreakDepths.push(breakLabel)
        wasmContinueDepths.push(continueLabel)
        emitWasmBlock(statement.children[1])
        let value1 = wasmBreakDepths.pop()
        let value2 = wasmContinueDepths.pop()
        emitWasmBranch(continueLabel)
        wasmControlDepth -= 1
        wasmFunctionBody.push(11)
        wasmControlDepth -= 1
        wasmFunctionBody.push(11)
        return
    }
    if key == nodeRangeLoop {
        storeWasmAddress(identifierKindLocal, statement.slot)
        emitWasmExpression(statement.children[0])
        finishWasmStore(identifierKindLocal, statement.slot)
        storeWasmAddress(identifierKindLocal, statement.auxiliary)
        emitWasmExpression(statement.children[1])
        finishWasmStore(identifierKindLocal, statement.auxiliary)
        // Three nested structures, because `continue` must reach the increment
        // rather than the condition: an outer block to break out of, the loop
        // itself for the back edge, and an inner block whose END is where
        // `continue` lands -- falling straight into i += 1.
        wasmFunctionBody.push(2)                           // block: break target
        wasmFunctionBody.push(64)
        wasmControlDepth += 1
        let breakLabel = wasmControlDepth
        wasmFunctionBody.push(3)                           // loop: back edge
        wasmFunctionBody.push(64)
        wasmControlDepth += 1
        let back = wasmControlDepth
        wasmFunctionBody.push(2)                           // block: continue target
        wasmFunctionBody.push(64)
        wasmControlDepth += 1
        let continueLabel = wasmControlDepth
        loadWasmSlot(identifierKindLocal, statement.slot)
        loadWasmSlot(identifierKindLocal, statement.auxiliary)
        wasmFunctionBody.push(83)                          // i64.lt_s
        wasmFunctionBody.push(69)                          // i32.eqz
        wasmFunctionBody.push(13)
        writeUnsignedLeb128(wasmFunctionBody, wasmControlDepth - breakLabel)
        wasmBreakDepths.push(breakLabel)
        wasmContinueDepths.push(continueLabel)
        emitWasmBlock(statement.children[2])
        let value1 = wasmBreakDepths.pop()
        let value2 = wasmContinueDepths.pop()
        wasmControlDepth -= 1
        wasmFunctionBody.push(11)                          // end continue-block
        storeWasmAddress(identifierKindLocal, statement.slot)
        loadWasmSlot(identifierKindLocal, statement.slot)
        emitWasmInteger(1)
        wasmFunctionBody.push(124)                         // i64.add
        finishWasmStore(identifierKindLocal, statement.slot)
        emitWasmBranch(back)
        wasmControlDepth -= 1
        wasmFunctionBody.push(11)                          // end loop
        wasmControlDepth -= 1
        wasmFunctionBody.push(11)                          // end block
        return
    }
    if key == nodeIterableLoop {
        // hidden slots: s.aux holds the list (a frame slot, so it stays a GC
        // root for the whole loop), s.op the index, s.slot the element
        storeWasmAddress(identifierKindLocal, statement.auxiliary)
        emitWasmExpression(statement.children[0])
        finishWasmStore(identifierKindLocal, statement.auxiliary)
        storeWasmAddress(identifierKindLocal, statement.operator)
        emitWasmInteger(0)
        finishWasmStore(identifierKindLocal, statement.operator)
        wasmFunctionBody.push(2)                           // block: break target
        wasmFunctionBody.push(64)
        wasmControlDepth += 1
        let breakLabel = wasmControlDepth
        wasmFunctionBody.push(3)                           // loop: back edge
        wasmFunctionBody.push(64)
        wasmControlDepth += 1
        let back = wasmControlDepth
        wasmFunctionBody.push(2)                           // block: continue target
        wasmFunctionBody.push(64)
        wasmControlDepth += 1
        let continueLabel = wasmControlDepth
        loadWasmSlot(identifierKindLocal, statement.operator)
        loadWasmSlot(identifierKindLocal, statement.auxiliary)
        emitWasmBoolean()
        wasmFunctionBody.push(41)                          // i64.load: length
        writeUnsignedLeb128(wasmFunctionBody, 3)
        writeUnsignedLeb128(wasmFunctionBody, 0)
        wasmFunctionBody.push(89)                          // i64.ge_s
        wasmFunctionBody.push(13)                          // br_if -> leave the loop
        writeUnsignedLeb128(wasmFunctionBody, wasmControlDepth - breakLabel)
        storeWasmAddress(identifierKindLocal, statement.slot)        // elem = data[index]
        loadWasmSlot(identifierKindLocal, statement.auxiliary)
        emitWasmBoolean()
        wasmFunctionBody.push(41)
        writeUnsignedLeb128(wasmFunctionBody, 3)
        writeUnsignedLeb128(wasmFunctionBody, 16)
        loadWasmSlot(identifierKindLocal, statement.operator)
        emitWasmInteger(8)
        wasmFunctionBody.push(126)
        wasmFunctionBody.push(124)
        emitWasmBoolean()
        wasmFunctionBody.push(41)
        writeUnsignedLeb128(wasmFunctionBody, 3)
        writeUnsignedLeb128(wasmFunctionBody, 0)
        finishWasmStore(identifierKindLocal, statement.slot)
        wasmBreakDepths.push(breakLabel)
        wasmContinueDepths.push(continueLabel)
        emitWasmBlock(statement.children[1])
        let value1 = wasmBreakDepths.pop()
        let value2 = wasmContinueDepths.pop()
        wasmControlDepth -= 1
        wasmFunctionBody.push(11)                          // end continue-block
        storeWasmAddress(identifierKindLocal, statement.operator)
        loadWasmSlot(identifierKindLocal, statement.operator)
        emitWasmInteger(1)
        wasmFunctionBody.push(124)
        finishWasmStore(identifierKindLocal, statement.operator)
        emitWasmBranch(back)
        wasmControlDepth -= 1
        wasmFunctionBody.push(11)
        wasmControlDepth -= 1
        wasmFunctionBody.push(11)
        return
    }
    if key == nodeBreak {
        emitWasmBranch(wasmBreakDepths[wasmBreakDepths.len() - 1 - statement.integerValue])
        return
    }
    if key == nodeContinue {
        emitWasmBranch(wasmContinueDepths[wasmContinueDepths.len() - 1 - statement.integerValue])
        return
    }
    if key == nodeInline {
        wasmFunctionBody.push(2)                           // block: every IRET branches to its end
        wasmFunctionBody.push(64)
        wasmControlDepth += 1
        wasmInlineDepths.push(wasmControlDepth)
        wasmInlineSlots.push(statement.slot)
        for sourceType in statement.children { emitWasmStatement(sourceType) }
        let value1 = wasmInlineDepths.pop()
        let value2 = wasmInlineSlots.pop()
        wasmControlDepth -= 1
        wasmFunctionBody.push(11)
        return
    }
    if key == nodeInlineReturn {
        let slot = wasmInlineSlots[wasmInlineSlots.len() - 1]
        storeWasmAddress(identifierKindLocal, slot)
        if statement.children[0].nodeKind != nodeNone { emitWasmExpression(statement.children[0]) } else { emitWasmInteger(0) }
        finishWasmStore(identifierKindLocal, slot)
        emitWasmBranch(wasmInlineDepths[wasmInlineDepths.len() - 1])
        return
    }
    failCompilation(statement.line, "--wasm: unsupported statement kind {key}")
}

fn emitWasmBlock(rightNode: Node) {
    for statement in rightNode.children { emitWasmStatement(statement) }
}

fn emitWasmFunctionBody(slotCount: int, parameterCount: int, statements: [Node]) {
    wasmFunctionBody = newWasmByteBuffer()
    wasmSlotCount = slotCount
    wasmParameterCount = parameterCount
    wasmFramePointerLocal = parameterCount                          // locals: params, then fp, then scratch
    wasmFrameSize = 8 * (slotCount + parameterCount + wasmRoots + 1)   // +1 for the closure env
    if wasmFrameSize % 16 != 0 { wasmFrameSize += 8 }
    wasmScratchCount = 0
    wasmRootCount = 0
    writeUnsignedLeb128(wasmFunctionBody, 2)
    writeUnsignedLeb128(wasmFunctionBody, 1)
    wasmFunctionBody.push(127)                             // one i32: the frame pointer
    writeUnsignedLeb128(wasmFunctionBody, wasmScratch)
    wasmFunctionBody.push(126)                             // the i64 scratch pool
    wasmFunctionBody.push(35)                              // global.get __sp
    writeUnsignedLeb128(wasmFunctionBody, 0)
    emitWasmInteger32(wasmFrameSize)
    wasmFunctionBody.push(107)                             // i32.sub
    wasmFunctionBody.push(34)                              // local.tee fp
    writeUnsignedLeb128(wasmFunctionBody, wasmFramePointerLocal)
    wasmFunctionBody.push(36)                              // global.set __sp
    writeUnsignedLeb128(wasmFunctionBody, 0)
    for i in 0..parameterCount {                    // params into the frame, where the GC can see them
        emitWasmFrameAddress()
        wasmFunctionBody.push(32)
        writeUnsignedLeb128(wasmFunctionBody, i)
        wasmFunctionBody.push(55)
        writeUnsignedLeb128(wasmFunctionBody, 3)
        writeUnsignedLeb128(wasmFunctionBody, wasmSlotOffset(identifierKindParameter, i))
    }
    emitWasmFrameAddress()                            // and the closure env alongside them
    wasmFunctionBody.push(35)                              // global.get __env
    writeUnsignedLeb128(wasmFunctionBody, 1)
    wasmFunctionBody.push(55)
    writeUnsignedLeb128(wasmFunctionBody, 3)
    writeUnsignedLeb128(wasmFunctionBody, wasmEnvironmentOffset())
    for statement in statements { emitWasmStatement(statement) }
    restoreWasmStack()
    emitWasmInteger(0)
    wasmFunctionBody.push(11)                              // end
}

fn writeWasmString(rightValue: [int], text: str) {
    writeUnsignedLeb128(rightValue, text.len())
    for i in 0..text.len() { rightValue.push(text.byte(i)) }
}

// wasm function index for a runtime helper called by name, the way rcall()
// names them on x86.
fn findWasmFunction(name: str) -> int {
    let functionIndex = findFunction(name)
    if functionIndex < 0 { return 0 - 1 }
    return wasmFunctionIndices[functionIndex]
}

fn callWasmFunction(name: str) {
    let index = findWasmFunction(name)
    if index < 0 { panic("--wasm: the runtime function " + name + " is missing (compile with --rt)") }
    wasmFunctionBody.push(16)
    writeUnsignedLeb128(wasmFunctionBody, index)
}

fn writeWasmDataByte(value: int) { wasmDataBytes.push(value % 256) }

fn writeWasmData64Bits(value: int) {
    var valueLocal = value
    for i in 0..8 {
        writeWasmDataByte(valueLocal % 256)
        valueLocal = valueLocal / 256
    }
}

fn alignWasmData() {
    while wasmDataBytes.len() % 8 != 0 { writeWasmDataByte(0) }
}

fn wasmDataAddress() -> int { return wasmData + wasmDataBytes.len() }

// Lay out every constant the program needs at a fixed address. Mirrors the
// .rdata emission in generateProgram, except the addresses are absolute, which is
// why codegen has to run once first to discover which literals exist.
fn layoutWasmData() {
    // string literals: [len][bytes]
    for i in 0..dataStringLiterals.len() {
        alignWasmData()
        wasmStringAddresses.push(wasmDataAddress())
        writeWasmData64Bits(dataStringLiterals[i].len())
        for j in 0..dataStringLiterals[i].len() { writeWasmDataByte(dataStringLiterals[i].byte(j)) }
    }
    // Type descriptors. The loop grows descriptors as it walks, exactly like the
    // native emitter, so descriptors reachable only from other descriptors get
    // addresses too. Cross-references are recorded as patches rather than
    // written inline, because the target addresses are not known until the
    // whole table has been walked.
    var destinationIndex = 0
    while destinationIndex < descriptors.len() {
        alignWasmData()
        wasmTypeAddresses.push(wasmDataAddress())
        let typeIndex = descriptors[destinationIndex]
        let key = typeKinds[typeIndex]
        if key == kindList and typeKinds[typeElementIds[typeIndex]] == kindByte {
            writeWasmData64Bits(10)
        } else if key == kindList and typeKinds[typeElementIds[typeIndex]] == kindFloat32 {
            writeWasmData64Bits(11)
        } else if key == kindList {
            writeWasmData64Bits(4)
            patchWasmAddress(0, typeDescriptorIndex(typeElementIds[typeIndex]))
        } else if key == kindStruct and isUnion(typeIndex) {
            let structIndex = structDefinitions[typeDefinitionIds[typeIndex]]
            writeWasmData64Bits(9)
            writeWasmData64Bits(structIndex.variants.len())
            for value in structIndex.variants { patchWasmAddress(0, typeDescriptorIndex(structTypeOf(value))) }
        } else if key == kindStruct {
            let structIndex = structDefinitions[typeDefinitionIds[typeIndex]]
            writeWasmData64Bits(5)
            patchWasmAddress(1, addCString(structBaseName(structIndex)))
            writeWasmData64Bits(structIndex.fieldNames.len())
            for j in 0..structIndex.fieldNames.len() {
                patchWasmAddress(1, addCString(structIndex.fieldNames[j]))
                patchWasmAddress(0, typeDescriptorIndex(structIndex.fieldTypes[j]))
            }
        } else if key == kindOptional {
            writeWasmData64Bits(8)
            patchWasmAddress(0, typeDescriptorIndex(typeElementIds[typeIndex]))
        } else if key == kindMap {
            writeWasmData64Bits(7)
            patchWasmAddress(0, typeDescriptorIndex(typeDefinitionIds[typeIndex]))
            patchWasmAddress(0, typeDescriptorIndex(typeElementIds[typeIndex]))
        } else if key == kindEnum {
            let enumIndex = enumDefinitions[typeDefinitionIds[typeIndex]]
            writeWasmData64Bits(6)
            writeWasmData64Bits(enumIndex.members.len())
            for j in 0..enumIndex.members.len() { patchWasmAddress(1, addCString(enumIndex.members[j])) }
        } else {
            writeWasmData64Bits(key)
        }
        destinationIndex += 1
    }
    // Interface vtables. On x86 the slots hold code addresses; here they hold
    // function-TABLE indices, which is what call_indirect takes. wasmFunctionIndices is
    // still populated from pass one at this point, so they are known.
    for i in 0..dispatchStructIndices.len() {
        alignWasmData()
        wasmDispatchAddresses.push(wasmDataAddress())
        let symbolName = structDefinitions[dispatchStructIndices[i]].name
        let identifierFunction = interfaceDefinitions[dispatchInterfaceIndices[i]]
        for mapValue in 0..identifierFunction.methodNames.len() {
            let memberIndex = findFunction(symbolName + "." + identifierFunction.methodNames[mapValue])
            if memberIndex < 0 { panic("--wasm: missing interface method " + symbolName + "." + identifierFunction.methodNames[mapValue]) }
            writeWasmData64Bits(wasmFunctionIndices[memberIndex])
        }
    }
    for i in 0..cStringLiterals.len() {
        wasmCStringAddresses.push(wasmDataAddress())
        for j in 0..cStringLiterals[i].len() { writeWasmDataByte(cStringLiterals[i].byte(j)) }
        writeWasmDataByte(0)
    }
    // now every target has an address, so the recorded cross-references resolve
    for i in 0..wasmPatchOffsets.len() {
        if wasmPatchKinds[i] == 0 { fixWasmDataAddress(wasmPatchOffsets[i], wasmTypeAddresses[wasmPatchIndices[i]]) }
        else { fixWasmDataAddress(wasmPatchOffsets[i], wasmCStringAddresses[wasmPatchIndices[i]]) }
    }

    alignWasmData()
    wasmGlobalsAddress = wasmDataAddress()
    for i in 0..globalCount { writeWasmData64Bits(0) }
    wasmStackBottom = wasmData + wasmDataBytes.len()
    if wasmStackBottom % 16 != 0 { wasmStackBottom += 16 - wasmStackBottom % 16 }
    // Round the heap base to a page so it is exactly the initial memory end;
    // the OS shim can then track committed memory without asking for its size.
    wasmStackTop = wasmStackBottom + wasmStackBytes
    if wasmStackTop % 65536 != 0 { wasmStackTop += 65536 - wasmStackTop % 65536 }
    wasmPageCount = wasmStackTop / 65536
}

// reserve an 8-byte slot whose value is an address only known later:
// kind 0 = the address of type descriptor idx, kind 1 = of C string idx
fn patchWasmAddress(kind: int, index: int) {
    wasmPatchOffsets.push(wasmDataBytes.len())
    wasmPatchKinds.push(kind)
    wasmPatchIndices.push(index)
    writeWasmData64Bits(0)
}

fn fixWasmDataAddress(offset: int, value: int) {
    var valueLocal = value
    for i in 0..8 {
        wasmDataBytes[offset + i] = valueLocal % 256
        valueLocal = valueLocal / 256
    }
}

fn generateWasm(program: Node) {
    var order: [int] = []
    for count in program.children {
        if count.nodeKind == nodeFunction {
            let functionDefinition = functionDefinitions[count.referenceIndex]
            if functionDefinition.typeParameters.len() > 0 { continue }      // a template emits no code
            order.push(count.referenceIndex)
        }
    }
    for i in 0..instantiatedFunctions.len() { order.push(instantiatedFunctions[i]) }
    for i in 0..functionDefinitions.len() { wasmFunctionIndices.push(0) }
    for i in 0..order.len() {
        wasmFunctionIndices[order[i]] = 5 + i            // wasm indices 0-4 are the imports
        wasmFunctionArities.push(functionDefinitions[order[i]].parameterNames.len())
    }
    wasmFunctionArities.push(0)                         // zephyr_main, emitted last

    var bodyCount = 0
    for i in 0..order.len() {
        let functionDefinition = functionDefinitions[order[i]]
        emitWasmFunctionBody(functionDefinition.slotCount, functionDefinition.parameterNames.len(), functionDefinition.body.children)
        writeUnsignedLeb128(wasmCodeBytes, wasmFunctionBody.len())
        appendWasmBytes(wasmCodeBytes, wasmFunctionBody)
        bodyCount += 1
    }
    var top: [Node] = []
    for count in program.children {
        if count.nodeKind != nodeFunction and count.nodeKind != nodeStructDefinition and count.nodeKind != nodeEnumDefinition and count.nodeKind != nodeInterface { top.push(count) }
    }
    emitWasmFunctionBody(topLevelSlotCount, 0, top)
    writeUnsignedLeb128(wasmCodeBytes, wasmFunctionBody.len())
    appendWasmBytes(wasmCodeBytes, wasmFunctionBody)
    bodyCount += 1

    var head: [int] = []
    writeUnsignedLeb128(head, bodyCount)
    appendWasmBytes(head, wasmCodeBytes)
    wasmCodeBytes = head
}

fn truncateWasmStrings(items: [str]) {
    while items.len() > 0 { let value = items.pop() }
}

fn truncateWasmIntegers(items: [int]) {
    while items.len() > 0 { let value = items.pop() }
}

// Two passes. Codegen is what discovers which string literals and type
// descriptors a program uses, but wasm needs their absolute addresses while
// generating -- so run it once to populate the tables, lay the data out, then
// throw the code away and generate it again for real.
fn generateWasmTwice(program: Node) {
    generateWasm(program)
    layoutWasmData()
    truncateWasmStrings(dataStringLiterals)                      // addDstr does not dedupe: reset it
    // descriptors is kept: typeDescriptorIndex dedupes, so pass two gets pass one's indices back,
    // which are the ones wlayout gave addresses to
    truncateWasmIntegers(wasmFunctionIndices)
    truncateWasmIntegers(wasmFunctionArities)
    truncateWasmIntegers(wasmCodeBytes)
    wasmPass = 2
    generateWasm(program)
}

fn writeWasm(path: str) {
    wasmOutputBytes.push(0)
    wasmOutputBytes.push(97)
    wasmOutputBytes.push(115)
    wasmOutputBytes.push(109)
    wasmOutputBytes.push(1)
    wasmOutputBytes.push(0)
    wasmOutputBytes.push(0)
    wasmOutputBytes.push(0)

    var maxar = 0
    for i in 0..wasmFunctionArities.len() {
        if wasmFunctionArities[i] > maxar { maxar = wasmFunctionArities[i] }
    }
    // types 0-4 belong to the imports; type 5+a is (i64 x a) -> i64
    var typeSection: [int] = []
    writeUnsignedLeb128(typeSection, 6 + maxar)
    typeSection.push(96)
    writeUnsignedLeb128(typeSection, 1)
    typeSection.push(126)
    writeUnsignedLeb128(typeSection, 0)                              // 0: print_i64
    typeSection.push(96)
    writeUnsignedLeb128(typeSection, 1)
    typeSection.push(124)
    writeUnsignedLeb128(typeSection, 0)                              // 1: print_f64
    typeSection.push(96)
    writeUnsignedLeb128(typeSection, 1)
    typeSection.push(126)
    writeUnsignedLeb128(typeSection, 0)                              // 2: print_bool
    typeSection.push(96)
    writeUnsignedLeb128(typeSection, 3)
    typeSection.push(126)
    typeSection.push(126)
    typeSection.push(126)
    writeUnsignedLeb128(typeSection, 0)                              // 3: write(fd, ptr, len)
    typeSection.push(96)
    writeUnsignedLeb128(typeSection, 1)
    typeSection.push(126)
    writeUnsignedLeb128(typeSection, 0)                              // 4: exit(code)
    for leftValue in 0..maxar + 1 {
        typeSection.push(96)
        writeUnsignedLeb128(typeSection, leftValue)
        for j in 0..leftValue { typeSection.push(126) }
        writeUnsignedLeb128(typeSection, 1)
        typeSection.push(126)
    }
    writeWasmSection(1, typeSection)

    var importSection: [int] = []
    writeUnsignedLeb128(importSection, 5)
    writeWasmString(importSection, "env")
    writeWasmString(importSection, "print_i64")
    importSection.push(0)
    writeUnsignedLeb128(importSection, 0)
    writeWasmString(importSection, "env")
    writeWasmString(importSection, "print_f64")
    importSection.push(0)
    writeUnsignedLeb128(importSection, 1)
    writeWasmString(importSection, "env")
    writeWasmString(importSection, "print_bool")
    importSection.push(0)
    writeUnsignedLeb128(importSection, 2)
    writeWasmString(importSection, "env")
    writeWasmString(importSection, "write")
    importSection.push(0)
    writeUnsignedLeb128(importSection, 3)
    writeWasmString(importSection, "env")
    writeWasmString(importSection, "exit")
    importSection.push(0)
    writeUnsignedLeb128(importSection, 4)
    writeWasmSection(2, importSection)

    var functionSection: [int] = []
    writeUnsignedLeb128(functionSection, wasmFunctionArities.len())
    for i in 0..wasmFunctionArities.len() { writeUnsignedLeb128(functionSection, 5 + wasmFunctionArities[i]) }
    writeWasmSection(3, functionSection)

    // one funcref table holding every function, so a table index and a function
    // index are the same number and a fn value can just carry it
    let totalCount = 5 + wasmFunctionArities.len()
    var tbsec: [int] = []
    writeUnsignedLeb128(tbsec, 1)
    tbsec.push(112)                          // funcref
    tbsec.push(0)                            // no maximum
    writeUnsignedLeb128(tbsec, totalCount)
    writeWasmSection(4, tbsec)

    var memorySection: [int] = []
    writeUnsignedLeb128(memorySection, 1)
    memorySection.push(0)                             // no maximum: the GC grows memory
    writeUnsignedLeb128(memorySection, wasmPageCount)
    writeWasmSection(5, memorySection)

    var globalSection: [int] = []
    writeUnsignedLeb128(globalSection, 2)
    globalSection.push(127)                           // 0: i32 __sp
    globalSection.push(1)                             // mutable
    writeWasmInteger32(globalSection, wasmStackTop)
    globalSection.push(11)
    globalSection.push(126)                           // 1: i64 __env, the closure environment
    globalSection.push(1)
    globalSection.push(66)
    writeSignedLeb128(globalSection, 0)
    globalSection.push(11)
    writeWasmSection(6, globalSection)

    var exportSection: [int] = []
    writeUnsignedLeb128(exportSection, 2)
    writeWasmString(exportSection, "main")
    exportSection.push(0)
    writeUnsignedLeb128(exportSection, 4 + wasmFunctionArities.len())             // zephyr_main is the last function
    writeWasmString(exportSection, "memory")
    exportSection.push(2)
    writeUnsignedLeb128(exportSection, 0)
    writeWasmSection(7, exportSection)

    var elseClause: [int] = []
    writeUnsignedLeb128(elseClause, 1)
    writeUnsignedLeb128(elseClause, 0)                             // active segment, table 0
    writeWasmInteger32(elseClause, 0)
    elseClause.push(11)
    writeUnsignedLeb128(elseClause, totalCount)
    for i in 0..totalCount { writeUnsignedLeb128(elseClause, i) }      // identity: table[i] == function i
    writeWasmSection(9, elseClause)

    writeWasmSection(10, wasmCodeBytes)

    // one active data segment at offset 8: the three memory-map constants the
    // OS shim reads, then every literal and descriptor
    var dataSection: [int] = []
    writeUnsignedLeb128(dataSection, 1)
    writeUnsignedLeb128(dataSection, 0)                              // memory 0
    writeWasmInteger32(dataSection, wasmMetaHeap)
    dataSection.push(11)
    var meta: [int] = []
    var save = wasmDataBytes
    wasmDataBytes = meta
    writeWasmData64Bits(wasmStackTop)                          // heap base sits above the stack
    writeWasmData64Bits(wasmStackBottom)
    writeWasmData64Bits(wasmStackTop)
    wasmDataBytes = save
    writeUnsignedLeb128(dataSection, meta.len() + wasmDataBytes.len())
    appendWasmBytes(dataSection, meta)
    appendWasmBytes(dataSection, wasmDataBytes)
    writeWasmSection(11, dataSection)

    serializeWasmModule(path)
}

// Fill one counted byte string instead of allocating a string for every byte.
fn serializeWasmModule(path: str) {
    let data = chr(0).repeat(wasmOutputBytes.len())
    for i in 0..wasmOutputBytes.len() { store8(addr(data) + 8 + i, wasmOutputBytes[i]) }
    write_file(path, data)
}

// Writing an executable, each function's asm is assembled as soon as it is
// generated and its text dropped. A self-compile otherwise held ~1M lines,
// about 65 MB, until the very end. The lines reach assembleLine in the same order
// either way; a .s output still needs them all, so it does not stream.
fn streamAssembledLines() {
    if not streamAssembly { return }
    for line in assemblyLines { assembleLine(line) }
    var noLines: [str] = []
    assemblyLines = noLines
}

fn assembleAndLink(path: str) {
    if wasmTargetEnabled {
        writeWasm(path)
        return
    }
    currentAssemblySection = sectionText
    for i in 0..assemblyLines.len() {
        assembleLine(assemblyLines[i])
    }
    if linuxTargetEnabled { writeElf(path) } else { writePe(path) }
    if debugEnabled and not linuxTargetEnabled { writeDebugSymbols(path + ".zdbg") }
}

// ---------------- driver ----------------
let commandLineArguments = args()
var includeRuntime = false
var showVersion = false
var runTests = false
var inputPath = ""
var outputPath = ""
var argumentIndex = 1
while argumentIndex < commandLineArguments.len() {
    let a = commandLineArguments[argumentIndex]
    if a == "--rt" { includeRuntime = true }
    else if a == "--linux" { linuxTargetEnabled = true }
    else if a == "--wasm" { wasmTargetEnabled = true }
    else if a == "--version" { showVersion = true }
    else if a == "-g" or a == "--debug" { debugEnabled = true }
    else if a == "--test" {                  // run the main file's test blocks instead of main()
        runTests = true
        includeRuntime = true
    }
    else if inputPath == "" { inputPath = a }
    else { outputPath = a }
    argumentIndex += 1
}
if showVersion {
    print("zc 0.2 -- the Zephyr compiler, written in Zephyr")
}
if inputPath == "" and showVersion {
    // --version alone: nothing to compile
} else {
    if inputPath == "" or outputPath == "" {
        panic("usage: zc [--rt] [--test] [--linux | --wasm] [-g] [--version] <input.zeph> <output.exe|output.s|output.wasm>")
    }
    currentSourceFile = baseName(inputPath)
    cachedExecutableDirectory = executableDirectory()
    var prog = parse(tokenizeSource(read_file(inputPath), 1))
    let tests = collectTests(prog)
    scopeModule(prog, baseName(inputPath), "")
    if runTests { addTestRunner(prog, tests) }
    else { callMain(prog) }
    prog = expandImports(prog, directoryName(inputPath))
    var firstUserNode = 0
    currentSourceFile = baseName(inputPath)
    if includeRuntime {
        // prepend the Zephyr runtime so rt_* resolve locally (kernel32-only
        // output). A runtime.zeph next to the compiler, then one in the current
        // directory, overrides the copy embedded in the binary.
        var rtsrc = ""
        if cachedExecutableDirectory != "" and pathExists(cachedExecutableDirectory + "compiler/runtime.zeph") {
            currentSourceFile = "compiler/runtime.zeph"
            rtsrc = read_file(cachedExecutableDirectory + "compiler/runtime.zeph")
        } else if cachedExecutableDirectory != "" and pathExists(cachedExecutableDirectory + "runtime.zeph") {
            currentSourceFile = "runtime.zeph"
            rtsrc = read_file(cachedExecutableDirectory + "runtime.zeph")
        } else if pathExists("runtime.zeph") {
            currentSourceFile = "runtime.zeph"
            rtsrc = read_file("runtime.zeph")
        } else {
            currentSourceFile = "runtime.zeph (embedded)"
            rtsrc = embedded_runtime()
            if rtsrc == "" { panic("runtime.zeph not found next to zc.exe or in the current directory, and this build has no embedded runtime") }
        }
        // --linux: the kernel32 entry points the runtime calls are provided as
        // ordinary Zephyr functions over syscalls, so runtime.zeph itself needs
        // no #ifdef and no platform fork.
        if linuxTargetEnabled or wasmTargetEnabled {
            var osname = "lib/os/linux.zeph"
            if wasmTargetEnabled { osname = "lib/os/wasm.zeph" }
            var ospath = cachedExecutableDirectory + osname
            if not pathExists(ospath) { ospath = osname }
            if not pathExists(ospath) { panic("this target needs " + osname + " next to zc.exe") }
            currentSourceFile = osname
            rtsrc = read_file(ospath) + rtsrc
        }
        if not wasmTargetEnabled {
            // The runtime source stays untouched on disk; only failure branches
            // of helpers reached from native code receive the caller's site.
            rtsrc = rtsrc.replace("fn rt_str_to_int(s: int) -> int \{", "fn rt_str_to_int(s: int, site: str) -> int \{")
            rtsrc = rtsrc.replace("fn rt_str_to_float(s: int) -> int \{", "fn rt_str_to_float(s: int, site: str) -> int \{")
            rtsrc = rtsrc.replace("fn rt_list_pop(l: int) -> int \{", "fn rt_list_pop(l: int, site: str) -> int \{")
            rtsrc = rtsrc.replace("fn rt_map_get(m: int, k: int) -> int \{", "fn rt_map_get(m: int, k: int, site: str) -> int \{")
            rtsrc = rtsrc.replace("fn rt_read_file(path: int) -> int \{", "fn rt_read_file(path: int, site: str) -> int \{")
            rtsrc = rtsrc.replace("fn rt_write_file(path: int, data: int) \{", "fn rt_write_file(path: int, data: int, site: str) \{")
            rtsrc = rtsrc.replace("rt_die(\"cannot convert to int\")", "rt_die(site + \"cannot convert to int\")")
            rtsrc = rtsrc.replace("rt_die(\"cannot convert to float\")", "rt_die(site + \"cannot convert to float\")")
            rtsrc = rtsrc.replace("rt_die(\"pop from empty list\")", "rt_die(site + \"pop from empty list\")")
            rtsrc = rtsrc.replace("rt_die(\"map key not found\")", "rt_die(site + \"map key not found\")")
            rtsrc = rtsrc.replace("rt_die(\"cannot read file\")", "rt_die(site + \"cannot read file\")")
            rtsrc = rtsrc.replace("rt_die(\"cannot write file\")", "rt_die(site + \"cannot write file\")")
            rtsrc += "\nfn rt_panic_at(site: str, msg: str) \{ rt_die(site + msg) \}\n"
        }
        let rtprog = parse(tokenizeSource(rtsrc, 1))
        var merged: [Node] = []
        for i in 0..rtprog.children.len() {
            let n = rtprog.children[i]
            if n.nodeKind != nodeFunction and n.nodeKind != nodeStructDefinition and n.nodeKind != nodeEnumDefinition { runtimeStatementCount += 1 }
            merged.push(n)
        }
        for i in 0..prog.children.len() { merged.push(prog.children[i]) }
        prog.children = merged
        currentSourceFile = baseName(inputPath)
        firstUserNode = rtprog.children.len()
    }
    hoistConstants(prog, firstUserNode)
    desugarExtern(prog)
    desugarOop(prog)
    lowerDefers(prog)
    check(prog)
    currentSourceFile = baseName(inputPath)
    foldGlobals(prog)
    inlinePass(prog)
    constantFoldFoldAll(prog)                       // fold what inlined literal args exposed
    let isS = outputPath.len() > 2 and outputPath.sub(outputPath.len() - 2, outputPath.len()) == ".s"
    // -g only affects native exe output; keep .zloc markers out of .s (gcc path)
    mainSourceFile = inputPath
    if isS { debugEnabled = false }
    if wasmTargetEnabled {
        // wasm is not a register machine, so none of the x86 passes apply here
        generateWasmTwice(prog)
        writeWasm(outputPath)
    } else {
        streamAssembly = not isS
        generateProgram(prog)
        if isS {
            write_file(outputPath, assemblyLines.join())
        } else {
            assembleAndLink(outputPath)
        }
    }
}
