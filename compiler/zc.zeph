    p.push("    store64(slot + 8, 0)\n")
    p.push("    store64(slot + 16, 0)\n")
    p.push("\}\n")
    p.push("fn runtimeMapKeys(mapAddress: int) -> int \{\n")
    p.push("    let capacity = load64(mapAddress + 8)\n")
    p.push("    let slots = load64(mapAddress + 16)\n")
    p.push("    let keyIsReference = runtimeMapKeyIsReference(mapAddress)\n")
    p.push("    var listDescriptor = runtimeValueListDescriptor\n")
    p.push("    if keyIsReference == 1 \{ listDescriptor = runtimeReferenceListDescriptor \}\n")
