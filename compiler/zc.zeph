// zc â€” the Zephyr compiler, written in Zephyr.
// Same pipeline as src/zephyr.c: lex -> parse -> typecheck -> x86-64 assembly.
// Usage: zc <input.zeph> <output.s>   (assemble/link with gcc + runtime.o)

// ---------------- token kinds ----------------
let T_EOF = 0
let T_NL = 1
let T_INTLIT = 2
let T_FLOATLIT = 3
let T_STRTOK = 4
let T_IDENT = 5
let T_FN = 6
let T_LET = 7
let T_VAR = 8
let T_IF = 9
let T_ELSE = 10
let T_WHILE = 11
let T_FOR = 12
let T_IN = 13
let T_RETURN = 14
let T_STRUCT = 15
let T_AS = 16
let T_TRUE = 17
let T_FALSE = 18
let T_AND = 19
let T_OR = 20
let T_NOT = 21
let T_BREAK = 22
let T_CONTINUE = 23
let T_LP = 24
let T_RP = 25
let T_LB = 26
let T_RB = 27
let T_LS = 28
let T_RS = 29
let T_COMMA = 30
let T_COLON = 31
let T_DOT = 32
let T_DOTDOT = 33
let T_PLUS = 34
let T_MINUS = 35
let T_STAR = 36
let T_SLASH = 37
let T_PCT = 38
let T_LT = 39
let T_GT = 40
let T_LE = 41
let T_GE = 42
let T_EQEQ = 43
let T_NE = 44
let T_ASSIGN = 45
let T_ARROW = 46
let T_PLUSEQ = 47
let T_MINUSEQ = 48
let T_STAREQ = 49
let T_SLASHEQ = 50
let T_AMP = 51
let T_PIPE = 52
let T_CARET = 53
let T_SHL = 54
let T_SHR = 55
let T_ENUM = 56
let T_IMPORT = 57
let T_QUES = 58
let T_NONE = 59
let T_IMPL = 60
let T_INTERFACE = 61
let T_EXTERN = 62

let TOKNAMES = ["end of file", "newline", "int literal", "float literal", "string",
    "identifier", "fn", "let", "var", "if", "else", "while", "for", "in", "return",
    "struct", "as", "true", "false", "and", "or", "not", "break", "continue",
    "(", ")", "\{", "\}", "[", "]", ",", ":", ".", "..",
    "+", "-", "*", "/", "%", "<", ">", "<=", ">=", "==", "!=", "=", "->",
    "+=", "-=", "*=", "/=", "&", "|", "^", "<<", ">>", "enum", "import", "?", "none",
    "impl", "interface", "extern"]

// ---------------- node kinds ----------------
let N_NONE = 0
let N_PROG = 1
let N_FN = 2
let N_STRUCTDEF = 3
let N_PARAM = 4
let N_FIELDDEF = 5
let N_DECL = 6
let N_ASSIGN = 7
let N_IF = 8
let N_WHILE = 9
let N_FORR = 10
let N_FORIN = 11
let N_RET = 12
let N_BRK = 13
let N_CONT = 14
let N_EXPRST = 15
let N_INT = 16
let N_FLOAT = 17
let N_BOOL = 18
let N_STRLIT = 19
let N_STRTXT = 20
let N_INTERP = 21
let N_ID = 22
let N_LIST = 23
let N_SLIT = 24
let N_FIELDINIT = 25
let N_NEG = 26
let N_NOT = 27
let N_BIN = 28
let N_CAST = 29
let N_INDEX = 30
let N_MEMBER = 31
let N_CALL = 32
let N_TYNAME = 33
let N_TYLIST = 34
let N_ENUMDEF = 35
let N_TYMAP = 36
let N_MAPLIT = 37
let N_IMPORT = 38
let N_TYFN = 39
let N_TYOPT = 40
let N_NONELIT = 41
let N_SOME = 42
let N_FNLIT = 43     // fn(x: int) -> int { ... } -- closure literal
let N_INLINE = 44    // produced by the inliner: inlined body stmts, slot = result temp
let N_IRET = 45      // an inlined body's return: result -> rax, jmp to the inline end
let N_IMPL = 46      // impl Type { methods } -- desugared into plain functions
let N_INTERFACE = 47 // interface Name { method signatures }
let N_IBOX = 48      // box a struct into an interface value {vtable, data}; refi=iface, op=vtable idx
let N_EXTERN = 49    // extern fn f(...) from "dll" -- desugared into a lazily-resolving wrapper

// ---------------- type kinds & table ----------------
let K_INT = 0
let K_FLOAT = 1
let K_BOOL = 2
let K_STR = 3
let K_VOID = 4
let K_LIST = 5
let K_STRUCT = 6
let K_ENUM = 7
let K_MAP = 8      // ty_el = value type, ty_sd = key type
let K_FN = 9       // ty_sd = index into g_fnsigs
let K_OPT = 10     // ty_el = the wrapped type; represented as a pointer, 0 = none
let K_NONE = 11    // the type of the `none` literal; fits any optional
let K_IFACE = 12   // interface; ty_sd = index into g_ifaces. A value is a {vtable, data} cell.

// types are indices into these parallel tables
var ty_kind: [int] = []
var ty_el: [int] = []
var ty_sd: [int] = []
ty_kind.push(K_INT)
ty_el.push(0)
ty_sd.push(0)
ty_kind.push(K_FLOAT)
ty_el.push(0)
ty_sd.push(0)
ty_kind.push(K_BOOL)
ty_el.push(0)
ty_sd.push(0)
ty_kind.push(K_STR)
ty_el.push(0)
ty_sd.push(0)
ty_kind.push(K_VOID)
ty_el.push(0)
ty_sd.push(0)
ty_kind.push(K_NONE)
ty_el.push(0)
ty_sd.push(0)
let TI_INT = 0
let TI_FLOAT = 1
let TI_BOOL = 2
let TI_STR = 3
let TI_VOID = 4
let TI_NONE = 5

// call kinds
let CK_USER = 0
let CK_PRINT = 1
let CK_PANIC = 2
let CK_SQRT = 3
let CK_LEN = 4
let CK_PUSH = 5
let CK_POP = 6
let CK_ARGS = 7
let CK_READF = 8
let CK_WRITEF = 9
let CK_CHR = 10
let CK_BYTE = 11
let CK_SUB = 12
let CK_JOIN = 13
let CK_BITS = 14
let CK_EMIT = 15
let CK_LOAD64 = 16
let CK_LOAD8 = 17
let CK_STORE64 = 18
let CK_STORE32 = 19
let CK_STORE8 = 20
let CK_STACKPTR = 21
let CK_WIN = 22
let CK_ZEROS = 23
let CK_RTCALL = 24    // generic method -> rt_ call; e.name holds the rt function
let CK_ASSERT = 25
let CK_ABS = 26
let CK_MIN = 27
let CK_MAX = 28
let CK_POW = 29
let CK_INDIRECT = 30   // call through a function value
let CK_OPT_HAS = 31
let CK_OPT_GET = 32
let CK_OPT_OR = 33
let CK_IDISPATCH = 34  // virtual call through an interface value's vtable; slot = method index
let CK_CALLPTR = 35    // Win64 call through a raw code address (GetProcAddress & friends)
let CK_SYSCALL = 36    // Linux: `syscall` instruction, System V argument registers
let CK_WGROW = 37      // wasm: memory.grow
let CK_WWRITE = 38     // wasm: host import that takes (fd, ptr, len)
let CK_WEXIT = 39      // wasm: host import that ends the program
// cast kinds
let C_NOP = 0
let C_TRUNC = 1
let C_I2F = 2
let C_TOSTR = 3
let C_S2I = 4
let C_S2F = 5
// binop operand categories
let BC_INT = 0
let BC_FLOAT = 1
let BC_STR = 2
let BC_BOOL = 3
// identifier kinds
let ID_LOCAL = 0
let ID_PARAM = 1
let ID_GLOBAL = 2
let ID_FUNC = 3     // N_ID naming a function used as a value (refi = g_fns index)
let ID_CAPTURE = 4  // N_ID captured by the enclosing closure (slot = capture index)

// ---------------- data structures ----------------
struct Part { is_expr: bool, text: str, line: int }
struct Tok { t: int, line: int, s: str, i: int, f: float, parts: [Part] }
struct Node {
    k: int, line: int, op: int,
    name: str, ival: int, fval: float,
    kids: [Node],
    ty: int, slot: int, aux: int, refi: int, mut: bool,
    file: str    // source file this node was parsed from (for -g debug info)
}
struct VarInfo { name: str, ty: int, mut: bool, kind: int, idx: int }
struct SDef { name: str, fnames: [str], ftypes: [int], line: int }
struct EDef { name: str, members: [str], line: int }
// an interface: method names + their signatures (K_FN types, self excluded)
struct IDef { name: str, mnames: [str], msigs: [int], line: int }
struct FnSig { ptypes: [int], ret: int }
// A generic function is a template: its ptypes/ret are NOT resolved (they mention
// type parameters), and `node` is kept so each instantiation can clone the body.
struct FDef { name: str, pnames: [str], ptypes: [int], ret: int, body: Node, nslots: int, line: int,
              tparams: [str], node: Node, label: str, has_env: bool,
              pristine: Node, prist_ok: bool, prist_nslots: int }
// one pending monomorphisation: check fi's body with tnames bound to ttypes
struct Inst { fi: int, tnames: [str], ttypes: [int] }

// ---------------- compiler state ----------------
var g_file = ""
// -g debug info: line -> .text offset table, captured during assembly
var g_debug = false
var g_main_file = ""
var g_wasm = false    // --wasm: emit a WebAssembly module instead of a native executable
var g_linux = false   // --linux: emit a static ELF64 that talks to the kernel by syscall
var dbg_off: [int] = []
var dbg_line: [int] = []
var g_cur_user = false    // generating a main-file function body right now?
// parser
var P_toks: [Tok] = []
var P_pos = 0
var P_nostruct = 0
// checker
var g_structs: [SDef] = []
var g_enums: [EDef] = []
var g_ifaces: [IDef] = []
var g_fnsigs: [FnSig] = []
var g_fns: [FDef] = []
// interface vtables to emit: parallel (struct-def index, interface index) pairs
var g_vt_sd: [int] = []
var g_vt_if: [int] = []
// generics: instantiation cache (structural key -> g_fns index), pending bodies,
// and the active type-parameter bindings consulted by resolve_type
var g_inst_keys: [str] = []
var g_inst_fis: [int] = []
var g_pending: [Inst] = []
var g_insts: [int] = []          // g_fns indices to code-generate after prog.kids
var g_tbind_names: [str] = []
var g_tbind_types: [int] = []
// closures: one entry per lambda currently being checked. A name resolving to a
// local/param declared below g_lam_base is captured by value.
var g_lam_base: [int] = []
var g_lam_names: [[str]] = []
var g_lam_types: [[int]] = []
var g_lam_nodes: [[Node]] = []
var g_descs: [int] = []
var g_scopes: [[VarInfo]] = []
var g_ret = 4                 // current fn return type (TI_VOID)
var g_is_top = true
var g_in_loop = 0
var g_nslots = 0
var g_at_global = false
var g_nglobals = 0
// codegen
var g_lines: [str] = []
var g_label = 0
var g_brk: [int] = []
var g_cont: [int] = []
var g_cur_nparams = 0
var g_cur_nslots = 0
var g_cur_regcall = false   // current fn is rt_*: params arrive in rcx/rdx/r8/r9
var g_fn_regcall: [bool] = []   // per-function: register convention (see compute_regcall)
var g_next_regcall = false
var g_fdepth = 0            // float spill-stack depth: intermediates live in xmm2+

// ---- register promotion ----
// The hottest non-pointer locals/params of each function live in callee-saved
// registers for the whole body. Only int/float/bool/enum slots are eligible:
// the conservative GC finds roots by scanning the machine stack and has no
// register spill, so anything pointer-shaped must stay in memory.
// rsi/rdi are callee-saved on Win64 and free here: the only other user is
// try_fill's rep-stosq kernel, which saves and restores rdi itself.
let PROMO_REGS = ["rbx", "r13", "r14", "r15", "rsi", "rdi"]
// callee-saved xmm regs (Win64: xmm6-15 non-volatile) for hot FLOAT locals.
// Non-volatile => promoted floats survive calls, including FFI. xmm2-5 stay
// free for gen_fexpr's spill stack.
let FPROMO_REGS = ["xmm6", "xmm7", "xmm8", "xmm9", "xmm10", "xmm11"]
var g_lreg: [str] = []      // local slot -> GPR name ("" = in memory)
var g_preg: [str] = []      // param idx  -> GPR name ("" = in memory)
var g_lxreg: [str] = []     // local slot -> xmm name for a promoted float ("")
var g_pxreg: [str] = []     // param idx  -> xmm name for a promoted float ("")
var g_lcount: [int] = []
var g_pcount: [int] = []
var g_lfcount: [int] = []   // float-typed ref counts (loop-weighted)
var g_pfcount: [int] = []
var g_lbad: [bool] = []     // slot ever referenced with a pointer-kind type
var g_pbad: [bool] = []
var g_npromo = 0
var g_nfpromo = 0

// ---- runtime-reciprocal division ----
// For div/mod sites inside a loop whose divisor is loop-invariant (a positive
// constant OR a local/param never assigned in the loop), compute the magic
// reciprocal M = floor((2^64-1)/d) ONCE at loop entry with a single hardware
// div, then each site does q0 = mulhi(n, M) + one conditional fixup instead of
// a ~26-cycle idiv. Exact for every dividend n >= 0 (signed => n < 2^63, so
// the estimate is off by at most 1); n < 0 or d <= 0 fall back to idiv, so
// semantics are preserved bit-for-bit. gcc/LLVM only do this for compile-time
// constants; doing it for runtime-invariant divisors is normally manual
// libdivide territory.
var g_div_next = 0          // scratch pairs claimed by enclosing loops (max 2)
var g_div_base = 0          // frame offset (in slots) of the 4-slot scratch area
var g_dstrs: [str] = []
var g_cstrs: [str] = []

// ---------------- small helpers ----------------
fn no_parts() -> [Part] {
    var v: [Part] = []
    return v
}

fn no_nodes() -> [Node] {
    var v: [Node] = []
    return v
}

fn no_strs() -> [str] {
    var v: [str] = []
    return v
}

fn tok(t: int, line: int) -> Tok {
    return Tok{t: t, line: line, s: "", i: 0, f: 0.0, parts: no_parts()}
}

fn nnode(k: int, line: int) -> Node {
    return Node{k: k, line: line, op: 0, name: "", ival: 0, fval: 0.0,
                kids: no_nodes(), ty: 0, slot: 0, aux: 0, refi: 0, mut: false, file: g_file}
}

fn die(line: int, msg: str) {
    panic("{g_file}:{line}: error: {msg}")
}

fn is_digit(c: int) -> bool { return c >= 48 and c <= 57 }
fn is_id_start(c: int) -> bool {
    return (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or c == 95
}
fn is_id_char(c: int) -> bool { return is_id_start(c) or is_digit(c) }

fn byte_at(s: str, i: int) -> int {
    if i >= s.len() { return 0 }
    return s.byte(i)
}

// ---------------- lexer ----------------
// Looking ahead from just past a newline: does the next real token start with a
// `.` that continues the current statement? Skips blank lines, indentation and
// line comments; rejects `..` (range) and `.5` (float).
fn dot_continues(src: str, from: int) -> bool {
    let n = src.len()
    var i = from
    while i < n {
        let c = src.byte(i)
        if c == 32 or c == 9 or c == 13 or c == 10 {
            i += 1
        } else if c == 47 and byte_at(src, i + 1) == 47 {
            while i < n and src.byte(i) != 10 { i += 1 }
        } else {
            if c != 46 { return false }
            let d = byte_at(src, i + 1)
            if d == 46 or is_digit(d) { return false }
            return true
        }
    }
    return false
}

fn kw_lookup(w: str) -> int {
    if w == "fn" { return T_FN }
    if w == "let" { return T_LET }
    if w == "var" { return T_VAR }
    if w == "if" { return T_IF }
    if w == "else" { return T_ELSE }
    if w == "while" { return T_WHILE }
    if w == "for" { return T_FOR }
    if w == "in" { return T_IN }
    if w == "return" { return T_RETURN }
    if w == "struct" { return T_STRUCT }
    if w == "enum" { return T_ENUM }
    if w == "impl" { return T_IMPL }
    if w == "interface" { return T_INTERFACE }
    if w == "extern" { return T_EXTERN }
    if w == "import" { return T_IMPORT }
    if w == "none" { return T_NONE }
    if w == "as" { return T_AS }
    if w == "true" { return T_TRUE }
    if w == "false" { return T_FALSE }
    if w == "and" { return T_AND }
    if w == "or" { return T_OR }
    if w == "not" { return T_NOT }
    if w == "break" { return T_BREAK }
    if w == "continue" { return T_CONTINUE }
    return T_IDENT
}

// two-character punctuation; returns -1 if none
fn punct2(a: int, b: int) -> int {
    if a == 60 and b == 60 { return T_SHL }
    if a == 62 and b == 62 { return T_SHR }
    if a == 45 and b == 62 { return T_ARROW }
    if a == 46 and b == 46 { return T_DOTDOT }
    if a == 61 and b == 61 { return T_EQEQ }
    if a == 33 and b == 61 { return T_NE }
    if a == 60 and b == 61 { return T_LE }
    if a == 62 and b == 61 { return T_GE }
    if a == 43 and b == 61 { return T_PLUSEQ }
    if a == 45 and b == 61 { return T_MINUSEQ }
    if a == 42 and b == 61 { return T_STAREQ }
    if a == 47 and b == 61 { return T_SLASHEQ }
    return -1
}

fn punct1(a: int) -> int {
    if a == 63 { return T_QUES }
    if a == 40 { return T_LP }
    if a == 41 { return T_RP }
    if a == 123 { return T_LB }
    if a == 125 { return T_RB }
    if a == 91 { return T_LS }
    if a == 93 { return T_RS }
    if a == 44 { return T_COMMA }
    if a == 58 { return T_COLON }
    if a == 46 { return T_DOT }
    if a == 43 { return T_PLUS }
    if a == 45 { return T_MINUS }
    if a == 42 { return T_STAR }
    if a == 47 { return T_SLASH }
    if a == 37 { return T_PCT }
    if a == 60 { return T_LT }
    if a == 62 { return T_GT }
    if a == 61 { return T_ASSIGN }
    if a == 38 { return T_AMP }
    if a == 124 { return T_PIPE }
    if a == 94 { return T_CARET }
    return -1
}

fn lex_src(src: str, start_line: int) -> [Tok] {
    var out: [Tok] = []
    var i = 0
    var line = start_line
    var depth = 0
    var dstack: [int] = []      // paren depth saved at each open brace
    let n = src.len()
    while i < n {
        let c = src.byte(i)
        let tl = line
        if c == 10 {
            // A following line that begins with `.` continues this statement, so
            // a method chain can be written one call per line. `..` is the range
            // operator and a digit after the dot is a float, so neither counts.
            if depth == 0 and not dot_continues(src, i + 1) { out.push(tok(T_NL, line)) }
            i += 1
            line += 1
            continue
        }
        if c == 32 or c == 9 or c == 13 {
            i += 1
            continue
        }
        if c == 47 and byte_at(src, i + 1) == 47 {
            while i < n and src.byte(i) != 10 { i += 1 }
            continue
        }
        if is_digit(c) {
            var j = i
            while j < n and is_digit(byte_at(src, j)) { j += 1 }
            var isf = false
            if byte_at(src, j) == 46 and byte_at(src, j + 1) != 46 and is_digit(byte_at(src, j + 1)) {
                isf = true
                j += 1
                while j < n and is_digit(byte_at(src, j)) { j += 1 }
            }
            let text = src.sub(i, j)
            var t = tok(T_INTLIT, tl)
            if isf {
                t = tok(T_FLOATLIT, tl)
                t.f = text as float
            } else {
                t.i = text as int
            }
            out.push(t)
            i = j
            continue
        }
        if c == 34 {
            i += 1
            var parts: [Part] = []
            var buf: [str] = []
            var open = true
            while open {
                if i >= n or src.byte(i) == 10 { die(tl, "unterminated string") }
                let ch = src.byte(i)
                if ch == 34 {
                    i += 1
                    open = false
                    continue
                }
                if ch == 92 {
                    let e = byte_at(src, i + 1)
                    if e == 110 { buf.push(chr(10)) }
                    else if e == 116 { buf.push(chr(9)) }
                    else if e == 92 { buf.push(chr(92)) }
                    else if e == 34 { buf.push(chr(34)) }
                    else if e == 123 { buf.push(chr(123)) }
                    else if e == 125 { buf.push(chr(125)) }
                    else { die(line, "unknown escape \\{chr(e)}") }
                    i += 2
                    continue
                }
                if ch == 123 {
                    if buf.len() > 0 {
                        parts.push(Part{is_expr: false, text: buf.join(), line: line})
                        buf = no_strs()
                    }
                    var d = 1
                    var j = i + 1
                    while j < n and d > 0 {
                        let b = src.byte(j)
                        if b == 123 { d += 1 }
                        else if b == 125 {
                            d -= 1
                            if d == 0 { break }
                        }
                        else if b == 10 { die(line, "unterminated interpolation") }
                        j += 1
                    }
                    if d > 0 { die(line, "unterminated interpolation") }
                    parts.push(Part{is_expr: true, text: src.sub(i + 1, j), line: line})
                    i = j + 1
                    continue
                }
                buf.push(src.sub(i, i + 1))
                i += 1
            }
            if buf.len() > 0 or parts.len() == 0 {
                parts.push(Part{is_expr: false, text: buf.join(), line: line})
            }
            var t = tok(T_STRTOK, tl)
            t.parts = parts
            out.push(t)
            continue
        }
        if is_id_start(c) {
            var j = i
            while j < n and is_id_char(byte_at(src, j)) { j += 1 }
            let w = src.sub(i, j)
            let kt = kw_lookup(w)
            var t = tok(kt, tl)
            t.s = w                      // keywords keep their text too, so they
                                         // can still be used as member names
            out.push(t)
            i = j
            continue
        }
        var pt = punct2(c, byte_at(src, i + 1))
        var plen = 2
        if pt < 0 {
            pt = punct1(c)
            plen = 1
        }
        if pt < 0 { die(tl, "unexpected character '{chr(c)}'") }
        if pt == T_LP or pt == T_LS { depth += 1 }
        if pt == T_RP or pt == T_RS {
            if depth > 0 { depth -= 1 }
        }
        // A brace opens a fresh statement context: newlines inside `(`/`[` are
        // suppressed so argument lists can wrap, but a block body nested in them
        // -- a closure passed as an argument -- still needs its statement
        // terminators. Struct and map literals tolerate the extra newlines.
        if pt == T_LB {
            dstack.push(depth)
            depth = 0
        }
        if pt == T_RB {
            if dstack.len() > 0 { depth = dstack.pop() }
        }
        out.push(tok(pt, tl))
        i += plen
    }
    out.push(tok(T_EOF, line))
    return out
}

// ---------------- parser ----------------
fn peek() -> Tok { return P_toks[P_pos] }

fn pnext() -> Tok {
    let t = P_toks[P_pos]
    if P_pos < P_toks.len() - 1 { P_pos += 1 }
    return t
}

fn at(t: int) -> bool { return P_toks[P_pos].t == t }

fn tokdesc(t: Tok) -> str {
    if t.t == T_IDENT { return t.s }
    return TOKNAMES[t.t]
}

fn expect(t: int, what: str) -> Tok {
    let x = peek()
    if x.t != t { die(x.line, "expected {what}, got '{tokdesc(x)}'") }
    return pnext()
}

fn skip_nl() {
    while at(T_NL) { let x = pnext() }
}

fn terminator() {
    if at(T_EOF) or at(T_RB) { return }
    if at(T_NL) {
        skip_nl()
        return
    }
    die(peek().line, "expected newline after statement, got '{tokdesc(peek())}'")
}

fn else_ahead() -> bool {
    var k = P_pos
    while P_toks[k].t == T_NL { k += 1 }
    if P_toks[k].t == T_ELSE {
        P_pos = k
        return true
    }
    return false
}

fn p_type() -> Node {
    var base = p_type_base()
    while at(T_QUES) {                   // T?  (optional)
        let q = pnext()
        var n = nnode(N_TYOPT, q.line)
        n.kids.push(base)
        base = n
    }
    return base
}

fn p_type_base() -> Node {
    let t = peek()
    if t.t == T_FN {                     // fn(T, ...) -> R   (function value)
        let x = pnext()
        var n = nnode(N_TYFN, t.line)
        let a = expect(T_LP, "'(' in function type")
        while not at(T_RP) {
            n.kids.push(p_type())
            if at(T_COMMA) { let c = pnext() }
        }
        let b = expect(T_RP, "')'")
        var ret = nnode(N_NONE, t.line)
        if at(T_ARROW) {
            let c = pnext()
            ret = p_type()
        }
        n.kids.push(ret)                 // last kid is the return type (N_NONE = void)
        return n
    }
    if t.t == T_LS {
        let x = pnext()
        var n = nnode(N_TYLIST, t.line)
        n.kids.push(p_type())
        if at(T_COLON) {                 // [K: V] is a map type
            let c = pnext()
            n.k = N_TYMAP
            n.kids.push(p_type())
        }
        let y = expect(T_RS, "']'")
        return n
    }
    let id = expect(T_IDENT, "a type")
    var n = nnode(N_TYNAME, id.line)
    n.name = id.s
    return n
}

fn p_block() -> Node {
    let x = expect(T_LB, "'\{'")
    skip_nl()
    var blk = nnode(N_PROG, x.line)
    while not at(T_RB) {
        if at(T_EOF) { die(peek().line, "expected '\}'") }
        blk.kids.push(p_stmt())
        if not at(T_RB) { terminator() }
    }
    let y = expect(T_RB, "'\}'")
    return blk
}

fn p_header_expr() -> Node {
    P_nostruct += 1
    let e = p_expr(1)
    P_nostruct -= 1
    return e
}

fn p_fn() -> Node {
    let start = pnext()
    var n = nnode(N_FN, start.line)
    n.name = expect(T_IDENT, "function name").s
    var tparams = nnode(N_PROG, start.line)      // fn name[T, U](...) -- type parameters
    if at(T_LS) {
        let ls = pnext()
        var more = true
        while more {
            let tp = expect(T_IDENT, "type parameter name")
            var t = nnode(N_TYNAME, tp.line)
            t.name = tp.s
            tparams.kids.push(t)
            if at(T_COMMA) { let c = pnext() }
            else { more = false }
        }
        let rs = expect(T_RS, "']'")
    }
    let a = expect(T_LP, "'('")
    var params = nnode(N_PROG, start.line)
    if not at(T_RP) {
        var more = true
        while more {
            let pn = expect(T_IDENT, "parameter name")
            var p = nnode(N_PARAM, pn.line)
            p.name = pn.s
            // `self` inside an impl block needs no type; it is filled in with the
            // impl's struct type when the method is desugared into a function.
            if pn.s == "self" and not at(T_COLON) {
                var st = nnode(N_TYNAME, pn.line)
                st.name = "Self"
                p.kids.push(st)
            } else {
                let b = expect(T_COLON, "':'")
                p.kids.push(p_type())
            }
            params.kids.push(p)
            if at(T_COMMA) { let c = pnext() }
            else { more = false }
        }
    }
    let d = expect(T_RP, "')'")
    var ret = nnode(N_NONE, start.line)
    if at(T_ARROW) {
        let e = pnext()
        ret = p_type()
    }
    n.kids.push(params)
    n.kids.push(ret)
    n.kids.push(p_block())
    n.kids.push(tparams)                          // kids[3]: type params (empty = not generic)
    return n
}

// impl Type { fn method(self, ...) {...} ... }  -- methods on a struct.
// Each inner fn is desugared (in desugar_oop) into a plain function named
// "Type.method"; instance methods take the receiver as their first parameter.
fn p_impl() -> Node {
    let start = pnext()
    var n = nnode(N_IMPL, start.line)
    n.name = expect(T_IDENT, "type name").s
    let a = expect(T_LB, "'\{'")
    skip_nl()
    while not at(T_RB) {
        if not at(T_FN) { die(peek().line, "impl block may contain only functions") }
        n.kids.push(p_fn())
        skip_nl()
    }
    let d = expect(T_RB, "'\}'")
    return n
}

// interface Name { fn method(self, ...) -> T ... }  -- a set of method
// signatures (no bodies). Any struct with all the methods can be used as this
// interface, dispatched dynamically through a per-struct vtable.
fn p_interface() -> Node {
    let start = pnext()
    var n = nnode(N_INTERFACE, start.line)
    n.name = expect(T_IDENT, "interface name").s
    let a = expect(T_LB, "'\{'")
    skip_nl()
    while not at(T_RB) {
        let f = expect(T_FN, "'fn'")
        var m = nnode(N_FN, f.line)
        m.name = expect(T_IDENT, "method name").s
        let lp = expect(T_LP, "'('")
        var params = nnode(N_PROG, f.line)
        if not at(T_RP) {
            var more = true
            while more {
                let pn = expect(T_IDENT, "parameter name")
                var p = nnode(N_PARAM, pn.line)
                p.name = pn.s
                if pn.s == "self" and not at(T_COLON) {
                    var st = nnode(N_TYNAME, pn.line)
                    st.name = "Self"
                    p.kids.push(st)
                } else {
                    let b = expect(T_COLON, "':'")
                    p.kids.push(p_type())
                }
                params.kids.push(p)
                if at(T_COMMA) { let c = pnext() }
                else { more = false }
            }
        }
        let rp = expect(T_RP, "')'")
        var ret = nnode(N_NONE, f.line)
        if at(T_ARROW) {
            let e = pnext()
            ret = p_type()
        }
        m.kids.push(params)
        m.kids.push(ret)
        n.kids.push(m)
        skip_nl()
    }
    let d = expect(T_RB, "'\}'")
    return n
}

// extern fn Name(a: int, b: int) -> int from "some.dll"
// A foreign C-ABI function, resolved at runtime (LoadLibraryA + GetProcAddress,
// each cached on first call). Parameters must be `int` -- every foreign value is
// an address or a scalar, and floats would need XMM marshalling that callptr
// does not do yet.
//
// The return type is `int` (the raw 64-bit result) or `i32` (a signed 32-bit
// result, sign-extended on the way out). `i32` matters because a C function
// returning int32 leaves it in EAX, which the CPU zero-extends into RAX -- so a
// negative code such as VkResult -6 would otherwise arrive as 4294967290.
fn p_extern() -> Node {
    let start = pnext()
    let f = expect(T_FN, "'fn' after 'extern'")
    var n = nnode(N_EXTERN, start.line)
    n.name = expect(T_IDENT, "function name").s
    let lp = expect(T_LP, "'('")
    var params = nnode(N_PROG, start.line)
    if not at(T_RP) {
        var more = true
        while more {
            let pn = expect(T_IDENT, "parameter name")
            let cn = expect(T_COLON, "':'")
            var p = nnode(N_PARAM, pn.line)
            p.name = pn.s
            p.kids.push(p_type())
            params.kids.push(p)
            if at(T_COMMA) { let c = pnext() }
            else { more = false }
        }
    }
    let rp = expect(T_RP, "')'")
    var ret = nnode(N_NONE, start.line)
    if at(T_ARROW) {
        let a = pnext()
        ret = p_type()
    }
    // `from "dll"` -- `from` is an ordinary identifier, not a keyword
    let fromtok = expect(T_IDENT, "'from'")
    if fromtok.s != "from" { die(fromtok.line, "expected 'from \"some.dll\"' after an extern signature") }
    let s = p_primary()
    if s.k != N_STRLIT or s.kids.len() != 1 or s.kids[0].k != N_STRTXT {
        die(start.line, "extern needs a plain string DLL name, e.g. from \"vulkan-1.dll\"")
    }
    var dll = nnode(N_TYNAME, start.line)
    dll.name = s.kids[0].name
    n.kids.push(params)
    n.kids.push(ret)
    n.kids.push(dll)
    return n
}

// import "other.zeph"  -- splices that file's declarations in, once
fn p_import() -> Node {
    let start = pnext()
    var n = nnode(N_IMPORT, start.line)
    let s = p_primary()
    if s.k != N_STRLIT or s.kids.len() != 1 or s.kids[0].k != N_STRTXT {
        die(start.line, "import needs a plain string path, e.g. import \"util.zeph\"")
    }
    n.name = s.kids[0].name
    return n
}

// enum Name { A, B, C }  -- int-backed named constants
fn p_enumdef() -> Node {
    let start = pnext()
    var n = nnode(N_ENUMDEF, start.line)
    n.name = expect(T_IDENT, "enum name").s
    let a = expect(T_LB, "'\{'")
    skip_nl()
    while not at(T_RB) {
        let mnm = expect(T_IDENT, "enum member name")
        var m = nnode(N_FIELDDEF, mnm.line)
        m.name = mnm.s
        n.kids.push(m)
        if at(T_COMMA) { let c = pnext() }
        skip_nl()
    }
    let d = expect(T_RB, "'\}'")
    if n.kids.len() == 0 { die(n.line, "enum '{n.name}' has no members") }
    return n
}

fn p_structdef() -> Node {
    let start = pnext()
    var n = nnode(N_STRUCTDEF, start.line)
    n.name = expect(T_IDENT, "struct name").s
    let a = expect(T_LB, "'\{'")
    skip_nl()
    while not at(T_RB) {
        let fnm = expect(T_IDENT, "field name")
        let b = expect(T_COLON, "':'")
        var f = nnode(N_FIELDDEF, fnm.line)
        f.name = fnm.s
        f.kids.push(p_type())
        n.kids.push(f)
        if at(T_COMMA) { let c = pnext() }
        skip_nl()
    }
    let d = expect(T_RB, "'\}'")
    return n
}

fn p_if() -> Node {
    let t = pnext()
    var n = nnode(N_IF, t.line)
    n.kids.push(p_header_expr())
    n.kids.push(p_block())
    if else_ahead() {
        let e = pnext()
        var els = nnode(N_PROG, t.line)
        if at(T_IF) { els.kids.push(p_if()) }
        else { els = p_block() }
        n.kids.push(els)
    } else {
        n.kids.push(nnode(N_NONE, t.line))
    }
    return n
}

fn p_stmt() -> Node {
    let t = peek()
    if t.t == T_LET or t.t == T_VAR {
        let x = pnext()
        var n = nnode(N_DECL, t.line)
        n.mut = t.t == T_VAR
        n.name = expect(T_IDENT, "variable name").s
        var ann = nnode(N_NONE, t.line)
        if at(T_COLON) {
            let y = pnext()
            ann = p_type()
        }
        let z = expect(T_ASSIGN, "'='")
        n.kids.push(p_expr(1))
        n.kids.push(ann)
        return n
    }
    if t.t == T_IF { return p_if() }
    if t.t == T_WHILE {
        let x = pnext()
        var n = nnode(N_WHILE, t.line)
        n.kids.push(p_header_expr())
        n.kids.push(p_block())
        return n
    }
    if t.t == T_FOR {
        let x = pnext()
        let name = expect(T_IDENT, "loop variable").s
        let y = expect(T_IN, "'in'")
        let first = p_header_expr()
        if at(T_DOTDOT) {
            let z = pnext()
            var n = nnode(N_FORR, t.line)
            n.name = name
            n.kids.push(first)
            n.kids.push(p_header_expr())
            n.kids.push(p_block())
            return n
        }
        var n = nnode(N_FORIN, t.line)
        n.name = name
        n.kids.push(first)
        n.kids.push(p_block())
        return n
    }
    if t.t == T_RETURN {
        let x = pnext()
        var n = nnode(N_RET, t.line)
        if at(T_NL) or at(T_RB) or at(T_EOF) { n.kids.push(nnode(N_NONE, t.line)) }
        else { n.kids.push(p_expr(1)) }
        return n
    }
    if t.t == T_BREAK {
        let x = pnext()
        return nnode(N_BRK, t.line)
    }
    if t.t == T_CONTINUE {
        let x = pnext()
        return nnode(N_CONT, t.line)
    }
    if t.t == T_FN or t.t == T_STRUCT {
        die(t.line, "'{TOKNAMES[t.t]}' declarations are only allowed at the top level")
    }
    let e = p_expr(1)
    let nx = peek()
    var desugar = 0
    if nx.t == T_PLUSEQ { desugar = T_PLUS }
    if nx.t == T_MINUSEQ { desugar = T_MINUS }
    if nx.t == T_STAREQ { desugar = T_STAR }
    if nx.t == T_SLASHEQ { desugar = T_SLASH }
    if nx.t == T_ASSIGN or desugar != 0 {
        let x = pnext()
        if e.k != N_ID and e.k != N_MEMBER and e.k != N_INDEX {
            die(nx.line, "invalid assignment target")
        }
        var n = nnode(N_ASSIGN, nx.line)
        var rhs = p_expr(1)
        if desugar != 0 {
            var b = nnode(N_BIN, nx.line)
            b.op = desugar
            b.kids.push(e)
            b.kids.push(rhs)
            rhs = b
        }
        n.kids.push(e)
        n.kids.push(rhs)
        return n
    }
    var n = nnode(N_EXPRST, e.line)
    n.kids.push(e)
    return n
}

fn binprec(t: int) -> int {
    if t == T_OR { return 1 }
    if t == T_AND { return 2 }
    if t == T_EQEQ or t == T_NE { return 3 }
    if t == T_LT or t == T_LE or t == T_GT or t == T_GE { return 4 }
    if t == T_PLUS or t == T_MINUS or t == T_PIPE or t == T_CARET { return 5 }
    if t == T_STAR or t == T_SLASH or t == T_PCT or t == T_AMP or t == T_SHL or t == T_SHR { return 6 }
    if t == T_AS { return 7 }
    return 0
}

fn p_expr(minbp: int) -> Node {
    var lhs = p_unary()
    var going = true
    while going {
        let t = peek()
        let bp = binprec(t.t)
        if bp == 0 or bp < minbp {
            going = false
            continue
        }
        let x = pnext()
        if t.t == T_AS {
            var n = nnode(N_CAST, t.line)
            n.kids.push(lhs)
            n.kids.push(p_type())
            lhs = n
            continue
        }
        var n = nnode(N_BIN, t.line)
        n.op = t.t
        n.kids.push(lhs)
        n.kids.push(p_expr(bp + 1))
        lhs = n
    }
    return lhs
}

fn p_unary() -> Node {
    let t = peek()
    if t.t == T_MINUS {
        let x = pnext()
        var n = nnode(N_NEG, t.line)
        n.kids.push(p_unary())
        return n
    }
    if t.t == T_NOT {
        let x = pnext()
        var n = nnode(N_NOT, t.line)
        n.kids.push(p_unary())
        return n
    }
    return p_postfix()
}

fn p_postfix() -> Node {
    var e = p_primary()
    var going = true
    while going {
        if at(T_LP) {
            let t = pnext()
            var n = nnode(N_CALL, t.line)
            n.kids.push(e)
            let save = P_nostruct
            P_nostruct = 0
            if not at(T_RP) {
                var more = true
                while more {
                    n.kids.push(p_expr(1))
                    if at(T_COMMA) { let x = pnext() }
                    else { more = false }
                }
            }
            P_nostruct = save
            let y = expect(T_RP, "')'")
            e = n
        } else if at(T_LS) {
            let t = pnext()
            var n = nnode(N_INDEX, t.line)
            n.kids.push(e)
            let save = P_nostruct
            P_nostruct = 0
            n.kids.push(p_expr(1))
            P_nostruct = save
            let y = expect(T_RS, "']'")
            e = n
        } else if at(T_DOT) {
            let x = pnext()
            let name = pnext()               // a keyword may follow '.' (e.g. .or())
            if name.s == "" { die(name.line, "expected a member name, got '{tokdesc(name)}'") }
            var n = nnode(N_MEMBER, name.line)
            n.name = name.s
            n.kids.push(e)
            e = n
        } else {
            going = false
        }
    }
    return e
}

fn p_slit(name: str, line: int) -> Node {
    let a = expect(T_LB, "'\{'")
    skip_nl()
    var n = nnode(N_SLIT, line)
    n.name = name
    while not at(T_RB) {
        let fnm = expect(T_IDENT, "field name")
        let b = expect(T_COLON, "':'")
        var f = nnode(N_FIELDINIT, fnm.line)
        f.name = fnm.s
        let save = P_nostruct
        P_nostruct = 0
        f.kids.push(p_expr(1))
        P_nostruct = save
        n.kids.push(f)
        if at(T_COMMA) { let c = pnext() }
        skip_nl()
    }
    let d = expect(T_RB, "'\}'")
    return n
}

fn parse_interp(text: str, line: int) -> Node {
    let save_toks = P_toks
    let save_pos = P_pos
    let save_ns = P_nostruct
    P_toks = lex_src(text, line)
    P_pos = 0
    P_nostruct = 0
    skip_nl()
    let e = p_expr(1)
    skip_nl()
    if not at(T_EOF) { die(line, "unexpected token in string interpolation") }
    P_toks = save_toks
    P_pos = save_pos
    P_nostruct = save_ns
    return e
}

fn p_primary() -> Node {
    let t = peek()
    if t.t == T_INTLIT {
        let x = pnext()
        var n = nnode(N_INT, t.line)
        n.ival = t.i
        return n
    }
    if t.t == T_FLOATLIT {
        let x = pnext()
        var n = nnode(N_FLOAT, t.line)
        n.fval = t.f
        return n
    }
    if t.t == T_TRUE or t.t == T_FALSE {
        let x = pnext()
        var n = nnode(N_BOOL, t.line)
        if t.t == T_TRUE { n.ival = 1 }
        return n
    }
    if t.t == T_NONE {
        let x = pnext()
        return nnode(N_NONELIT, t.line)
    }
    if t.t == T_FN {                       // closure literal: fn(x: int) -> int { ... }
        let x = pnext()
        var n = nnode(N_FNLIT, t.line)
        let a = expect(T_LP, "'(' in closure")
        var params = nnode(N_PROG, t.line)
        if not at(T_RP) {
            var more = true
            while more {
                let pn = expect(T_IDENT, "parameter name")
                let b = expect(T_COLON, "':'")
                var p = nnode(N_PARAM, pn.line)
                p.name = pn.s
                p.kids.push(p_type())
                params.kids.push(p)
                if at(T_COMMA) { let c = pnext() }
                else { more = false }
            }
        }
        let d = expect(T_RP, "')'")
        var ret = nnode(N_NONE, t.line)
        if at(T_ARROW) {
            let e2 = pnext()
            ret = p_type()
        }
        n.kids.push(params)
        n.kids.push(ret)
        n.kids.push(p_block())
        return n
    }
    if t.t == T_STRTOK {
        let x = pnext()
        var n = nnode(N_STRLIT, t.line)
        for p in t.parts {
            if p.is_expr {
                var w = nnode(N_INTERP, p.line)
                w.kids.push(parse_interp(p.text, p.line))
                n.kids.push(w)
            } else {
                var s = nnode(N_STRTXT, t.line)
                s.name = p.text
                n.kids.push(s)
            }
        }
        return n
    }
    if t.t == T_IDENT {
        let x = pnext()
        if at(T_LB) and P_nostruct == 0 { return p_slit(t.s, t.line) }
        var n = nnode(N_ID, t.line)
        n.name = t.s
        return n
    }
    if t.t == T_LP {
        let x = pnext()
        let save = P_nostruct
        P_nostruct = 0
        let e = p_expr(1)
        P_nostruct = save
        let y = expect(T_RP, "')'")
        return e
    }
    if t.t == T_LS {
        let x = pnext()
        var n = nnode(N_LIST, t.line)
        let save = P_nostruct
        P_nostruct = 0
        if at(T_COLON) {                      // [:] -- empty map literal
            let c = pnext()
            n.k = N_MAPLIT
        } else if not at(T_RS) {
            var more = true
            var first = true
            while more {
                n.kids.push(p_expr(1))
                if first and at(T_COLON) {    // [k: v, ...] -- map literal
                    n.k = N_MAPLIT
                }
                if n.k == N_MAPLIT {
                    let c = expect(T_COLON, "':' in map literal")
                    n.kids.push(p_expr(1))
                }
                first = false
                if at(T_COMMA) { let y = pnext() }
                else { more = false }
            }
        }
        P_nostruct = save
        let z = expect(T_RS, "']'")
        return n
    }
    die(t.line, "expected an expression, got '{tokdesc(t)}'")
    return nnode(N_NONE, t.line)
}

fn parse(toks: [Tok]) -> Node {
    P_toks = toks
    P_pos = 0
    P_nostruct = 0
    var prog = nnode(N_PROG, 1)
    skip_nl()
    while not at(T_EOF) {
        if at(T_FN) { prog.kids.push(p_fn()) }
        else if at(T_STRUCT) { prog.kids.push(p_structdef()) }
        else if at(T_ENUM) { prog.kids.push(p_enumdef()) }
        else if at(T_IMPL) { prog.kids.push(p_impl()) }
        else if at(T_INTERFACE) { prog.kids.push(p_interface()) }
        else if at(T_EXTERN) { prog.kids.push(p_extern()) }
        else if at(T_IMPORT) { prog.kids.push(p_import()) }
        else { prog.kids.push(p_stmt()) }
        terminator()
    }
    return prog
}

// ---------------- types ----------------
fn new_type(k: int, el: int, sd: int) -> int {
    ty_kind.push(k)
    ty_el.push(el)
    ty_sd.push(sd)
    return ty_kind.len() - 1
}

fn list_of(el: int) -> int { return new_type(K_LIST, el, 0) }
fn struct_of(sd: int) -> int { return new_type(K_STRUCT, 0, sd) }
fn enum_of(ed: int) -> int { return new_type(K_ENUM, 0, ed) }
fn map_of(k: int, v: int) -> int { return new_type(K_MAP, v, k) }
fn opt_of(el: int) -> int { return new_type(K_OPT, el, 0) }
fn fn_of(ptypes: [int], ret: int) -> int {
    g_fnsigs.push(FnSig{ptypes: ptypes, ret: ret})
    return new_type(K_FN, 0, g_fnsigs.len() - 1)
}

fn type_eq(a: int, b: int) -> bool {
    if ty_kind[a] != ty_kind[b] { return false }
    if ty_kind[a] == K_OPT { return type_eq(ty_el[a], ty_el[b]) }
    if ty_kind[a] == K_LIST { return type_eq(ty_el[a], ty_el[b]) }
    if ty_kind[a] == K_MAP { return type_eq(ty_sd[a], ty_sd[b]) and type_eq(ty_el[a], ty_el[b]) }
    if ty_kind[a] == K_STRUCT { return ty_sd[a] == ty_sd[b] }
    if ty_kind[a] == K_ENUM { return ty_sd[a] == ty_sd[b] }
    if ty_kind[a] == K_IFACE { return ty_sd[a] == ty_sd[b] }
    if ty_kind[a] == K_FN {
        let sa = g_fnsigs[ty_sd[a]]
        let sb = g_fnsigs[ty_sd[b]]
        if sa.ptypes.len() != sb.ptypes.len() { return false }
        if not type_eq(sa.ret, sb.ret) { return false }
        for i in 0..sa.ptypes.len() {
            if not type_eq(sa.ptypes[i], sb.ptypes[i]) { return false }
        }
        return true
    }
    return true
}

// keys need value equality: int/bool/enum compare by value, str structurally
fn valid_map_key(t: int) -> bool {
    let k = ty_kind[t]
    return k == K_INT or k == K_BOOL or k == K_STR or k == K_ENUM
}
fn map_keykind(t: int) -> int {
    if ty_kind[ty_sd[t]] == K_STR { return 1 }
    return 0
}
// the map records its key kind at creation, so one set/get serves both
fn map_setfn(t: int) -> str { return "rt_map_set" }
fn map_getfn(t: int) -> str { return "rt_map_get" }

fn type_str(t: int) -> str {
    let k = ty_kind[t]
    if k == K_INT { return "int" }
    if k == K_FLOAT { return "float" }
    if k == K_BOOL { return "bool" }
    if k == K_STR { return "str" }
    if k == K_VOID { return "void" }
    if k == K_NONE { return "none" }
    if k == K_OPT { return type_str(ty_el[t]) + "?" }
    if k == K_LIST { return "[{type_str(ty_el[t])}]" }
    if k == K_MAP { return "[{type_str(ty_sd[t])}: {type_str(ty_el[t])}]" }
    if k == K_ENUM { return g_enums[ty_sd[t]].name }
    if k == K_IFACE { return g_ifaces[ty_sd[t]].name }
    if k == K_FN {
        let sg = g_fnsigs[ty_sd[t]]
        var parts: [str] = []
        parts.push("fn(")
        for i in 0..sg.ptypes.len() {
            if i > 0 { parts.push(", ") }
            parts.push(type_str(sg.ptypes[i]))
        }
        parts.push(")")
        if ty_kind[sg.ret] != K_VOID { parts.push(" -> " + type_str(sg.ret)) }
        return parts.join()
    }
    return g_structs[ty_sd[t]].name
}

fn find_enum(name: str) -> int {
    for i in 0..g_enums.len() {
        if g_enums[i].name == name { return i }
    }
    return 0 - 1
}

fn is_num(t: int) -> bool { return ty_kind[t] == K_INT or ty_kind[t] == K_FLOAT }

fn fits(want: int, got: int) -> bool {
    if type_eq(want, got) { return true }
    if ty_kind[want] == K_OPT {                 // none, or the wrapped type, fits T?
        if ty_kind[got] == K_NONE { return true }
        return fits(ty_el[want], got)
    }
    if ty_kind[want] == K_IFACE and ty_kind[got] == K_STRUCT {   // struct implementing it
        return struct_implements(ty_sd[got], ty_sd[want])
    }
    return ty_kind[want] == K_FLOAT and ty_kind[got] == K_INT
}

fn find_struct(name: str) -> int {
    for i in 0..g_structs.len() {
        if g_structs[i].name == name { return i }
    }
    return -1
}

fn find_fn(name: str) -> int {
    for i in 0..g_fns.len() {
        if g_fns[i].name == name { return i }
    }
    return -1
}

fn is_builtin_name(n: str) -> bool {
    if n == "print" or n == "panic" or n == "sqrt" { return true }
    if n == "len" or n == "push" or n == "pop" { return true }
    if n == "args" or n == "read_file" or n == "write_file" { return true }
    if n == "chr" or n == "byte" or n == "sub" or n == "join" or n == "bits" { return true }
    if n == "emit" or n == "frombits" or n == "zeros" or n == "assert" { return true }
    if n == "abs" or n == "min" or n == "max" or n == "pow" { return true }
    if n == "load64" or n == "load8" or n == "store64" or n == "store32" or n == "store8" { return true }
    if n == "stackptr" or n == "win" or n == "addr" { return true }
    return false
}

fn td_index(t: int) -> int {
    for i in 0..g_descs.len() {
        if type_eq(g_descs[i], t) { return i }
    }
    g_descs.push(t)
    return g_descs.len() - 1
}

fn resolve_type(te: Node) -> int {
    if te.k == N_TYOPT {
        let inner = resolve_type(te.kids[0])
        if ty_kind[inner] == K_OPT { die(te.line, "'??' is not a type; an optional cannot wrap an optional") }
        return opt_of(inner)
    }
    if te.k == N_TYFN {
        var ps: [int] = []
        for i in 0..te.kids.len() - 1 { ps.push(resolve_type(te.kids[i])) }
        let rk = te.kids[te.kids.len() - 1]
        var ret = TI_VOID
        if rk.k != N_NONE { ret = resolve_type(rk) }
        return fn_of(ps, ret)
    }
    if te.k == N_TYLIST { return list_of(resolve_type(te.kids[0])) }
    if te.k == N_TYMAP {
        let kt = resolve_type(te.kids[0])
        if not valid_map_key(kt) { die(te.line, "{type_str(kt)} cannot be a map key (use int, str, bool, or an enum)") }
        return map_of(kt, resolve_type(te.kids[1]))
    }
    let n = te.name
    if n == "int" { return TI_INT }
    if n == "float" { return TI_FLOAT }
    if n == "bool" { return TI_BOOL }
    if n == "str" { return TI_STR }
    if n == "void" { die(te.line, "'void' is not a usable type") }
    var b = g_tbind_names.len() - 1          // innermost binding wins
    while b >= 0 {
        if g_tbind_names[b] == n { return g_tbind_types[b] }
        b -= 1
    }
    let ed = find_enum(n)
    if ed >= 0 { return enum_of(ed) }
    let ifc = find_iface(n)
    if ifc >= 0 { return iface_of(ifc) }
    let sd = find_struct(n)
    if sd < 0 { die(te.line, "unknown type '{n}'") }
    return struct_of(sd)
}

// ---------------- environment ----------------
fn env_push() {
    var s: [VarInfo] = []
    g_scopes.push(s)
}

fn env_pop() {
    let x = g_scopes.pop()
}

// returns scope_index * 1000000 + var_index, or -1
fn env_find(name: str) -> int {
    var si = g_scopes.len() - 1
    while si >= 0 {
        let scope = g_scopes[si]
        for vi in 0..scope.len() {
            if scope[vi].name == name { return si * 1000000 + vi }
        }
        si -= 1
    }
    return -1
}

fn env_get(h: int) -> VarInfo { return g_scopes[h / 1000000][h % 1000000] }

fn env_find_here(name: str) -> bool {
    let scope = g_scopes[g_scopes.len() - 1]
    for vi in 0..scope.len() {
        if scope[vi].name == name { return true }
    }
    return false
}

fn env_add(name: str, ty: int, mut: bool, kind: int, idx: int) {
    g_scopes[g_scopes.len() - 1].push(VarInfo{name: name, ty: ty, mut: mut, kind: kind, idx: idx})
}

// ---------------- checker ----------------
fn coerce(e: Node, want: int, what: str) -> Node {
    if type_eq(want, e.ty) { return e }
    if ty_kind[want] == K_OPT {
        if ty_kind[e.ty] == K_NONE {            // `none` is the null pointer already
            e.ty = want
            return e
        }
        if fits(ty_el[want], e.ty) {            // wrap the value in an optional cell
            let inner = coerce(e, ty_el[want], what)
            var s = nnode(N_SOME, e.line)
            s.kids.push(inner)
            s.ty = want
            return s
        }
    }
    if ty_kind[want] == K_FLOAT and ty_kind[e.ty] == K_INT {
        var c = nnode(N_CAST, e.line)
        c.kids.push(e)
        c.kids.push(nnode(N_NONE, e.line))
        c.aux = C_I2F
        c.ty = TI_FLOAT
        return c
    }
    if ty_kind[want] == K_IFACE and ty_kind[e.ty] == K_STRUCT {   // box the struct
        let sd = ty_sd[e.ty]
        let ifc = ty_sd[want]
        if not struct_implements(sd, ifc) {
            die(e.line, "{type_str(e.ty)} does not implement {g_ifaces[ifc].name}")
        }
        var b = nnode(N_IBOX, e.line)
        b.kids.push(e)
        b.refi = ifc
        b.op = vtable_index(sd, ifc)
        b.ty = want
        return b
    }
    die(e.line, "{what}: expected {type_str(want)}, got {type_str(e.ty)}")
    return e
}

fn check_bin(e: Node) -> int {
    let op = e.op
    let x1 = ce(e.kids[0])
    let x2 = ce(e.kids[1])
    let lt = e.kids[0].ty
    let rt = e.kids[1].ty
    if op == T_AND or op == T_OR {
        if ty_kind[lt] != K_BOOL or ty_kind[rt] != K_BOOL {
            die(e.line, "'{TOKNAMES[op]}' needs bool operands, got {type_str(lt)} and {type_str(rt)}")
        }
        return TI_BOOL
    }
    if op == T_EQEQ or op == T_NE {
        if is_num(lt) and is_num(rt) {
            if ty_kind[lt] == K_FLOAT or ty_kind[rt] == K_FLOAT {
                e.kids[0] = coerce(e.kids[0], TI_FLOAT, "comparison")
                e.kids[1] = coerce(e.kids[1], TI_FLOAT, "comparison")
                e.aux = BC_FLOAT
            } else { e.aux = BC_INT }
        } else if type_eq(lt, rt) and ty_kind[lt] == K_BOOL { e.aux = BC_BOOL }
        else if type_eq(lt, rt) and ty_kind[lt] == K_STR { e.aux = BC_STR }
        else if type_eq(lt, rt) and ty_kind[lt] == K_ENUM { e.aux = BC_INT }
        else { die(e.line, "'{TOKNAMES[op]}' is not defined for {type_str(lt)} and {type_str(rt)}") }
        return TI_BOOL
    }
    if op == T_LT or op == T_LE or op == T_GT or op == T_GE {
        if is_num(lt) and is_num(rt) {
            if ty_kind[lt] == K_FLOAT or ty_kind[rt] == K_FLOAT {
                e.kids[0] = coerce(e.kids[0], TI_FLOAT, "comparison")
                e.kids[1] = coerce(e.kids[1], TI_FLOAT, "comparison")
                e.aux = BC_FLOAT
            } else { e.aux = BC_INT }
        } else if ty_kind[lt] == K_STR and ty_kind[rt] == K_STR { e.aux = BC_STR }
        else { die(e.line, "'{TOKNAMES[op]}' needs two numbers or two strings, got {type_str(lt)} and {type_str(rt)}") }
        return TI_BOOL
    }
    if op == T_AMP or op == T_PIPE or op == T_CARET or op == T_SHL or op == T_SHR {
        if ty_kind[lt] != K_INT or ty_kind[rt] != K_INT {
            die(e.line, "'{TOKNAMES[op]}' needs int operands, got {type_str(lt)} and {type_str(rt)}")
        }
        e.aux = BC_INT
        return TI_INT
    }
    if op == T_PLUS and ty_kind[lt] == K_STR and ty_kind[rt] == K_STR {
        e.aux = BC_STR
        return TI_STR
    }
    if not is_num(lt) or not is_num(rt) {
        die(e.line, "'{TOKNAMES[op]}' needs numeric operands, got {type_str(lt)} and {type_str(rt)}")
    }
    if ty_kind[lt] == K_FLOAT or ty_kind[rt] == K_FLOAT {
        if op == T_PCT { die(e.line, "'%' is not defined for float") }
        e.kids[0] = coerce(e.kids[0], TI_FLOAT, "arithmetic")
        e.kids[1] = coerce(e.kids[1], TI_FLOAT, "arithmetic")
        e.aux = BC_FLOAT
        return TI_FLOAT
    }
    e.aux = BC_INT
    return TI_INT
}

fn check_method(e: Node) -> int {
    let c = e.kids[0]
    // associated function: `Type.func(args)` -- the receiver is a struct type
    // name, not a value, so no `self` is passed.
    let recv = c.kids[0]
    if recv.k == N_ID and env_find(recv.name) < 0 and find_struct(recv.name) >= 0 {
        let mname = recv.name + "." + c.name
        let fi = find_fn(mname)
        if fi < 0 { die(e.line, "'{recv.name}' has no associated function '{c.name}'") }
        let f = g_fns[fi]
        let nargs = e.kids.len() - 1
        if nargs != f.ptypes.len() { die(e.line, "'{mname}' expects {f.ptypes.len()} argument(s), got {nargs}") }
        for i in 0..nargs {
            let x = ce_expect(e.kids[i + 1], f.ptypes[i])
            e.kids[i + 1] = coerce(e.kids[i + 1], f.ptypes[i], "argument {i + 1}")
        }
        e.aux = CK_USER
        e.refi = fi
        e.op = 0
        return f.ret
    }
    let ot = ce(c.kids[0])
    let nargs = e.kids.len() - 1
    if ty_kind[ot] == K_STRUCT {
        let sd = g_structs[ty_sd[ot]]
        for i in 0..sd.fnames.len() {
            if sd.fnames[i] == c.name { die(e.line, "'{c.name}' is a field, not a method") }
        }
    }
    // virtual dispatch through an interface value's vtable
    if ty_kind[ot] == K_IFACE {
        let idf = g_ifaces[ty_sd[ot]]
        for m in 0..idf.mnames.len() {
            if idf.mnames[m] == c.name {
                let sig = g_fnsigs[ty_sd[idf.msigs[m]]]
                if nargs != sig.ptypes.len() {
                    die(e.line, "'{idf.name}.{c.name}' expects {sig.ptypes.len()} argument(s), got {nargs}")
                }
                for i in 0..nargs {
                    let x = ce_expect(e.kids[i + 1], sig.ptypes[i])
                    e.kids[i + 1] = coerce(e.kids[i + 1], sig.ptypes[i], "argument {i + 1}")
                }
                e.aux = CK_IDISPATCH
                e.slot = m
                return sig.ret
            }
        }
        die(e.line, "interface '{idf.name}' has no method '{c.name}'")
    }
    // A method defined in an `impl` block shadows any builtin method name (len,
    // push, contains, ...) for that struct type.
    if ty_kind[ot] == K_STRUCT {
        let mi = find_fn(g_structs[ty_sd[ot]].name + "." + c.name)
        if mi >= 0 {
            let f = g_fns[mi]
            if nargs + 1 != f.ptypes.len() {
                die(e.line, "'{f.name}' expects {f.ptypes.len()} argument(s), got {nargs + 1}")
            }
            c.kids[0] = coerce(c.kids[0], f.ptypes[0], "argument 1")
            for i in 0..nargs {
                let x = ce_expect(e.kids[i + 1], f.ptypes[i + 1])
                e.kids[i + 1] = coerce(e.kids[i + 1], f.ptypes[i + 1], "argument {i + 2}")
            }
            e.aux = CK_USER
            e.refi = mi
            e.op = 1
            return f.ret
        }
    }
    if c.name == "len" {
        if ty_kind[ot] == K_MAP {
            if nargs != 0 { die(e.line, ".len() takes no arguments") }
            e.aux = CK_LEN                 // map header starts with the live count
            return TI_INT
        }
        if ty_kind[ot] != K_LIST and ty_kind[ot] != K_STR {
            die(e.line, ".len() needs a list, str, or map, got {type_str(ot)}")
        }
        if nargs != 0 { die(e.line, ".len() takes no arguments") }
        e.aux = CK_LEN
        return TI_INT
    }
    // --- map methods ---
    if ty_kind[ot] == K_MAP {
        if c.name == "has" or c.name == "remove" {
            if nargs != 1 { die(e.line, ".{c.name}(key) takes one argument") }
            let kt = ce(e.kids[1])
            e.kids[1] = coerce(e.kids[1], ty_sd[ot], "map key")
            e.aux = CK_RTCALL
            if c.name == "has" {
                e.name = "rt_map_has"
                return TI_BOOL
            }
            e.name = "rt_map_remove"
            return TI_VOID
        }
        if c.name == "get" {                   // safe lookup: none when absent
            if nargs != 1 { die(e.line, ".get(key) takes one argument") }
            let kt = ce(e.kids[1])
            e.kids[1] = coerce(e.kids[1], ty_sd[ot], "map key")
            e.aux = CK_RTCALL
            e.name = "rt_map_get_opt"
            return opt_of(ty_el[ot])
        }
        if c.name == "keys" {
            if nargs != 0 { die(e.line, ".keys() takes no arguments") }
            e.aux = CK_RTCALL
            e.name = "rt_map_keys"
            return list_of(ty_sd[ot])
        }
        if c.name == "values" {
            if nargs != 0 { die(e.line, ".values() takes no arguments") }
            e.aux = CK_RTCALL
            e.name = "rt_map_values"
            return list_of(ty_el[ot])
        }
    }
    if c.name == "push" {
        if ty_kind[ot] != K_LIST { die(e.line, ".push() needs a list, got {type_str(ot)}") }
        if nargs != 1 { die(e.line, ".push(value) takes exactly one argument") }
        let x = ce(e.kids[1])
        e.kids[1] = coerce(e.kids[1], ty_el[ot], "push")
        e.aux = CK_PUSH
        return TI_VOID
    }
    if c.name == "pop" {
        if ty_kind[ot] != K_LIST { die(e.line, ".pop() needs a list, got {type_str(ot)}") }
        if nargs != 0 { die(e.line, ".pop() takes no arguments") }
        e.aux = CK_POP
        return ty_el[ot]
    }
    if c.name == "byte" {
        if ty_kind[ot] != K_STR { die(e.line, ".byte(i) needs a str, got {type_str(ot)}") }
        if nargs != 1 { die(e.line, ".byte(i) takes exactly one int argument") }
        if ty_kind[ce(e.kids[1])] != K_INT { die(e.line, ".byte(i) index must be int") }
        e.aux = CK_BYTE
        return TI_INT
    }
    if c.name == "sub" {
        if ty_kind[ot] != K_STR { die(e.line, ".sub(lo, hi) needs a str, got {type_str(ot)}") }
        if nargs != 2 { die(e.line, ".sub(lo, hi) takes exactly two int arguments") }
        if ty_kind[ce(e.kids[1])] != K_INT or ty_kind[ce(e.kids[2])] != K_INT {
            die(e.line, ".sub(lo, hi) bounds must be int")
        }
        e.aux = CK_SUB
        return TI_STR
    }
    if c.name == "join" {
        if ty_kind[ot] != K_LIST { die(e.line, ".join() needs a [str], got {type_str(ot)}") }
        if ty_kind[ty_el[ot]] != K_STR { die(e.line, ".join() needs a [str], got {type_str(ot)}") }
        if nargs != 0 { die(e.line, ".join() takes no arguments") }
        e.aux = CK_JOIN
        return TI_STR
    }
    // --- optional methods ---
    if ty_kind[ot] == K_OPT {
        if c.name == "has" {
            if nargs != 0 { die(e.line, ".has() takes no arguments") }
            e.aux = CK_OPT_HAS
            return TI_BOOL
        }
        if c.name == "get" {
            if nargs != 0 { die(e.line, ".get() takes no arguments") }
            e.aux = CK_OPT_GET
            return ty_el[ot]
        }
        if c.name == "or" {
            if nargs != 1 { die(e.line, ".or(default) takes one argument") }
            let dt = ce(e.kids[1])
            e.kids[1] = coerce(e.kids[1], ty_el[ot], "or default")
            // allocation sinking: `m.get(k).or(d)` never needs the optional
            // cell -- call rt_map_get_or directly (the same Option-elimination
            // LLVM does for Rust). Only when d is pure: .or's default is
            // evaluated lazily, and fusing makes it unconditional.
            let recv = e.kids[0].kids[0]
            if recv.k == N_CALL and recv.aux == CK_RTCALL and recv.name == "rt_map_get_opt" and strict_pure(e.kids[1]) {
                let d = e.kids[1]
                var fused: [Node] = []
                fused.push(recv.kids[0])       // the map.get member node: kids[0] is the map
                fused.push(recv.kids[1])       // key
                fused.push(d)                  // default
                e.kids = fused
                e.aux = CK_RTCALL
                e.name = "rt_map_get_or"
                return ty_el[ot]
            }
            e.aux = CK_OPT_OR
            return ty_el[ot]
        }
        die(e.line, "{type_str(ot)} has no method '{c.name}' (use .has(), .get(), or .or(default))")
    }
    // --- string methods (require the Zephyr runtime, --rt) ---
    if ty_kind[ot] == K_STR {
        if c.name == "contains" or c.name == "starts_with" or c.name == "ends_with" {
            if nargs != 1 or ty_kind[ce(e.kids[1])] != K_STR { die(e.line, ".{c.name}(s) takes one str") }
            e.aux = CK_RTCALL
            if c.name == "contains" { e.name = "rt_str_contains" }
            else if c.name == "starts_with" { e.name = "rt_str_starts_with" }
            else { e.name = "rt_str_ends_with" }
            return TI_BOOL
        }
        if c.name == "index_of" {
            if nargs != 1 or ty_kind[ce(e.kids[1])] != K_STR { die(e.line, ".index_of(s) takes one str") }
            e.aux = CK_RTCALL
            e.name = "rt_str_index_of"
            return TI_INT
        }
        if c.name == "split" {
            if nargs != 1 or ty_kind[ce(e.kids[1])] != K_STR { die(e.line, ".split(sep) takes one str") }
            e.aux = CK_RTCALL
            e.name = "rt_str_split"
            return list_of(TI_STR)
        }
        if c.name == "replace" {
            if nargs != 2 or ty_kind[ce(e.kids[1])] != K_STR or ty_kind[ce(e.kids[2])] != K_STR { die(e.line, ".replace(old, new) takes two str") }
            e.aux = CK_RTCALL
            e.name = "rt_str_replace"
            return TI_STR
        }
        if c.name == "upper" or c.name == "lower" or c.name == "trim" {
            if nargs != 0 { die(e.line, ".{c.name}() takes no arguments") }
            e.aux = CK_RTCALL
            if c.name == "upper" { e.name = "rt_str_upper" }
            else if c.name == "lower" { e.name = "rt_str_lower" }
            else { e.name = "rt_str_trim" }
            return TI_STR
        }
        if c.name == "repeat" {
            if nargs != 1 or ty_kind[ce(e.kids[1])] != K_INT { die(e.line, ".repeat(n) takes one int") }
            e.aux = CK_RTCALL
            e.name = "rt_str_repeat"
            return TI_STR
        }
    }
    // --- list methods ---
    // contains / index_of / reverse / slice used to live here. They were only
    // builtins because the language had no way to say "for any element type";
    // with generics they are ordinary library code in std/list.zeph, reached by
    // UFCS. `sort` stays native: it is a real algorithm, not a one-liner the
    // type system was blocking.
    if ty_kind[ot] == K_LIST {
        if c.name == "sort" {
            if nargs != 0 { die(e.line, ".sort() takes no arguments") }
            let ek = ty_kind[ty_el[ot]]
            e.aux = CK_RTCALL
            if ek == K_STR { e.name = "rt_list_sort_str" }
            else if ek == K_FLOAT { e.name = "rt_list_sort_float" }
            else if ek == K_INT or ek == K_BOOL or ek == K_ENUM { e.name = "rt_list_sort_int" }
            else { die(e.line, ".sort() needs a list of int, float, str, bool, or enum; use sort_by(cmp) from std/list.zeph") }
            return TI_VOID
        }
    }
    // Method lookup: a type-scoped method (`Struct.f` from an impl block) wins;
    // otherwise fall back to plain UFCS -- obj.f(a) == f(obj, a).
    var fi = 0 - 1
    if ty_kind[ot] == K_STRUCT { fi = find_fn(g_structs[ty_sd[ot]].name + "." + c.name) }
    if fi < 0 { fi = find_fn(c.name) }
    if fi < 0 { die(e.line, "unknown method or function '{c.name}'") }
    let f = g_fns[fi]
    if f.tparams.len() > 0 {
        let r = check_generic_call(e, fi, c.kids[0])
        e.op = 1
        return r
    }
    if nargs + 1 != f.ptypes.len() {
        die(e.line, "'{f.name}' expects {f.ptypes.len()} argument(s), got {nargs + 1}")
    }
    c.kids[0] = coerce(c.kids[0], f.ptypes[0], "argument 1")
    for i in 0..nargs {
        let x = ce_expect(e.kids[i + 1], f.ptypes[i + 1])
        e.kids[i + 1] = coerce(e.kids[i + 1], f.ptypes[i + 1], "argument {i + 2}")
    }
    e.aux = CK_USER
    e.refi = fi
    e.op = 1
    return f.ret
}

// ---------------- closures ----------------
// If we're inside a closure and `h` resolves to a local/param declared outside it,
// register it as a capture and return its index; otherwise -1. Globals need no
// capture (fixed address), and neither do the closure's own locals.
fn capture_of(e: Node, h: int, v: VarInfo) -> int {
    if g_lam_base.len() == 0 { return 0 - 1 }
    if v.kind != ID_LOCAL and v.kind != ID_PARAM and v.kind != ID_CAPTURE { return 0 - 1 }
    if h / 1000000 >= g_lam_base[g_lam_base.len() - 1] { return 0 - 1 }   // ours already
    let li = g_lam_names.len() - 1
    var cn = g_lam_names[li]
    var ct = g_lam_types[li]
    var cno = g_lam_nodes[li]
    for i in 0..cn.len() {
        if cn[i] == e.name { return i }
    }
    let k = cn.len()
    cn.push(e.name)
    ct.push(v.ty)
    var idn = nnode(N_ID, e.line)      // re-resolved later in the ENCLOSING scope,
    idn.name = e.name                  // which is what makes nested capture work
    cno.push(idn)
    return k
}

// Check a closure literal: capture by value, lift the body to a top-level
// function that takes a hidden env pointer as a trailing (deepest) argument.
fn check_fnlit(e: Node) -> int {
    var pnames: [str] = []
    var ptypes: [int] = []
    for p in e.kids[0].kids {
        for k in 0..pnames.len() {
            if pnames[k] == p.name { die(p.line, "duplicate parameter '{p.name}'") }
        }
        pnames.push(p.name)
        ptypes.push(resolve_type(p.kids[0]))
    }
    var ret = TI_VOID
    if e.kids[1].k != N_NONE { ret = resolve_type(e.kids[1]) }

    var capnames: [str] = []
    var captypes: [int] = []
    var capnodes: [Node] = []
    g_lam_names.push(capnames)
    g_lam_types.push(captypes)
    g_lam_nodes.push(capnodes)
    env_push()
    g_lam_base.push(g_scopes.len() - 1)
    for j in 0..pnames.len() { env_add(pnames[j], ptypes[j], false, ID_PARAM, j) }

    let save_ret = g_ret
    let save_top = g_is_top
    let save_loop = g_in_loop
    let save_slots = g_nslots
    let save_glob = g_at_global
    g_ret = ret
    g_is_top = false
    g_in_loop = 0
    g_nslots = 0
    g_at_global = false
    check_block(e.kids[2])
    let nslots = g_nslots
    g_ret = save_ret
    g_is_top = save_top
    g_in_loop = save_loop
    g_nslots = save_slots
    g_at_global = save_glob

    let b = g_lam_base.pop()
    let cn = g_lam_names.pop()
    let ct = g_lam_types.pop()
    let cno = g_lam_nodes.pop()
    env_pop()

    if ty_kind[ret] != K_VOID and not always_returns(e.kids[2].kids) {
        die(e.line, "closure must return {type_str(ret)} on all paths")
    }
    let idx = g_fns.len()
    var no_tp: [str] = []
    g_fns.push(FDef{name: "closure", pnames: pnames, ptypes: ptypes, ret: ret,
                    body: e.kids[2], nslots: nslots, line: e.line,
                    tparams: no_tp, node: e, label: "cl__" + (idx as str), has_env: true,
                    pristine: e, prist_ok: false, prist_nslots: 0})
    g_insts.push(idx)
    e.refi = idx
    // Resolve each captured name in the enclosing scope, now that the closure's
    // context is popped. If we're nested, this registers an outer capture too.
    for i in 0..cno.len() {
        let t = ce(cno[i])
        e.kids.push(cno[i])            // kids[3..] = the values to snapshot
    }
    return fn_of(ptypes, ret)
}

// ---------------- generics (monomorphisation) ----------------
// Deep-copy an AST. Instantiations are always cloned from the pristine template,
// never from a body that has already been checked (checking mutates nodes).
fn clone_node(n: Node) -> Node {
    var c = nnode(n.k, n.line)
    c.op = n.op
    c.name = n.name
    c.ival = n.ival
    c.fval = n.fval
    c.ty = n.ty
    c.slot = n.slot
    c.aux = n.aux
    c.refi = n.refi
    c.mut = n.mut
    c.file = n.file    // preserve source origin so -g line info isn't misattributed after inlining/monomorphisation
    for kid in n.kids { c.kids.push(clone_node(kid)) }
    return c
}

// Unify a declared type AST against a concrete type, recording type-parameter
// bindings into names/types. Returns false if the shapes don't match.
fn unify_tp(te: Node, got: int, tparams: [str], names: [str], types: [int]) -> bool {
    if te.k == N_TYNAME {
        for i in 0..tparams.len() {
            if tparams[i] == te.name {
                for j in 0..names.len() {
                    if names[j] == te.name { return type_eq(types[j], got) }  // bound: must agree
                }
                names.push(te.name)
                types.push(got)
                return true
            }
        }
        return type_eq(resolve_type(te), got)          // a concrete name
    }
    if te.k == N_TYLIST {
        if ty_kind[got] != K_LIST { return false }
        return unify_tp(te.kids[0], ty_el[got], tparams, names, types)
    }
    if te.k == N_TYMAP {
        if ty_kind[got] != K_MAP { return false }
        if not unify_tp(te.kids[0], ty_sd[got], tparams, names, types) { return false }
        return unify_tp(te.kids[1], ty_el[got], tparams, names, types)
    }
    if te.k == N_TYOPT {
        if ty_kind[got] != K_OPT { return false }
        return unify_tp(te.kids[0], ty_el[got], tparams, names, types)
    }
    if te.k == N_TYFN {
        if ty_kind[got] != K_FN { return false }
        let sg = g_fnsigs[ty_sd[got]]
        if te.kids.len() - 1 != sg.ptypes.len() { return false }
        for i in 0..sg.ptypes.len() {
            if not unify_tp(te.kids[i], sg.ptypes[i], tparams, names, types) { return false }
        }
        let rk = te.kids[te.kids.len() - 1]
        if rk.k == N_NONE { return ty_kind[sg.ret] == K_VOID }
        return unify_tp(rk, sg.ret, tparams, names, types)
    }
    return false
}

// Get (or create) the monomorphisation of generic fi for these bindings.
// Every value is 64 bits, so an instantiation is just the body re-checked with
// T bound â€” which also gives each one the right ==, <, and print for its T.
fn instantiate(fi: int, names: [str], types: [int]) -> int {
    let f = g_fns[fi]
    var kp: [str] = []
    kp.push(f.name)
    for i in 0..types.len() {
        kp.push("|")
        kp.push(type_str(types[i]))              // structural key, not type index
    }
    let key = kp.join()
    for i in 0..g_inst_keys.len() {
        if g_inst_keys[i] == key { return g_inst_fis[i] }
    }
    for i in 0..names.len() {                    // bind, resolve the signature
        g_tbind_names.push(names[i])
        g_tbind_types.push(types[i])
    }
    let node = f.node
    var pnames: [str] = []
    var ptypes: [int] = []
    for p in node.kids[0].kids {
        pnames.push(p.name)
        ptypes.push(resolve_type(p.kids[0]))
    }
    var ret = TI_VOID
    if node.kids[1].k != N_NONE { ret = resolve_type(node.kids[1]) }
    for i in 0..names.len() {
        let a = g_tbind_names.pop()
        let b = g_tbind_types.pop()
    }
    var no_tp: [str] = []
    let idx = g_fns.len()
    g_fns.push(FDef{name: f.name, pnames: pnames, ptypes: ptypes, ret: ret,
                    body: clone_node(f.body), nslots: 0, line: f.line,
                    tparams: no_tp, node: node, label: f.name + "__" + (idx as str), has_env: false,
                    pristine: node, prist_ok: false, prist_nslots: 0})
    g_inst_keys.push(key)                        // cache before checking, so a
    g_inst_fis.push(idx)                         // recursive generic terminates
    g_insts.push(idx)
    g_pending.push(Inst{fi: idx, tnames: names, ttypes: types})
    return idx
}

// Resolve a call to a generic function: infer its type parameters from the
// argument types, then retarget the call at the monomorphisation.
// `recv` is the UFCS receiver (or N_NONE); `first` indexes the first real arg.
fn check_generic_call(e: Node, fi: int, recv: Node) -> int {
    let f = g_fns[fi]
    let ps = f.node.kids[0].kids
    var argv: [Node] = []
    if recv.k != N_NONE { argv.push(recv) }
    for i in 1..e.kids.len() { argv.push(e.kids[i]) }
    if argv.len() != ps.len() {
        die(e.line, "'{f.name}' expects {ps.len()} argument(s), got {argv.len()}")
    }
    var names: [str] = []
    var types: [int] = []
    for i in 0..argv.len() {
        let argt = ce(argv[i])
        if not unify_tp(ps[i].kids[0], argt, f.tparams, names, types) {   // N_PARAM -> its type AST
            die(e.line, "'{f.name}': argument {i + 1} is {type_str(argt)}, which does not match the declared type")
        }
    }
    if names.len() != f.tparams.len() {
        die(e.line, "cannot infer every type parameter of '{f.name}' from the arguments")
    }
    let ii = instantiate(fi, names, types)
    let g = g_fns[ii]
    if recv.k != N_NONE {
        e.kids[0].kids[0] = coerce(recv, g.ptypes[0], "argument 1")
        for i in 1..e.kids.len() { e.kids[i] = coerce(e.kids[i], g.ptypes[i], "argument {i + 1}") }
    } else {
        for i in 1..e.kids.len() { e.kids[i] = coerce(e.kids[i], g.ptypes[i - 1], "argument {i}") }
    }
    e.aux = CK_USER
    e.refi = ii
    return g.ret
}

// call through a function value: check arity/arg types against the signature
fn check_indirect(e: Node, vt: int) -> int {
    if ty_kind[vt] != K_FN { die(e.line, "cannot call a {type_str(vt)}") }
    let sg = g_fnsigs[ty_sd[vt]]
    let nargs = e.kids.len() - 1
    if nargs != sg.ptypes.len() {
        die(e.line, "this {type_str(vt)} expects {sg.ptypes.len()} argument(s), got {nargs}")
    }
    for i in 0..nargs {
        let x = ce_expect(e.kids[i + 1], sg.ptypes[i])
        e.kids[i + 1] = coerce(e.kids[i + 1], sg.ptypes[i], "argument {i + 1}")
    }
    e.aux = CK_INDIRECT
    return sg.ret
}

fn check_call(e: Node) -> int {
    let c = e.kids[0]
    if c.k == N_MEMBER { return check_method(e) }
    if c.k != N_ID { return check_indirect(e, ce(c)) }   // any expression of fn type
    var nargs = e.kids.len() - 1
    if c.name == "print" {
        if nargs != 1 { die(e.line, "print(value) takes exactly one argument") }
        let t = ce(e.kids[1])
        if ty_kind[t] == K_VOID { die(e.line, "cannot print a void expression") }
        if ty_kind[t] == K_IFACE { die(e.line, "cannot print an interface value; call one of its methods") }
        e.aux = CK_PRINT
        e.slot = td_index(t)
        return TI_VOID
    }
    if c.name == "panic" {
        if nargs != 1 { die(e.line, "panic(message) takes exactly one str argument") }
        if ty_kind[ce(e.kids[1])] != K_STR { die(e.line, "panic message must be str") }
        e.aux = CK_PANIC
        return TI_VOID
    }
    if c.name == "sqrt" {
        if nargs != 1 { die(e.line, "sqrt(x) takes exactly one argument") }
        if not is_num(ce(e.kids[1])) { die(e.line, "sqrt needs a number") }
        e.kids[1] = coerce(e.kids[1], TI_FLOAT, "sqrt")
        e.aux = CK_SQRT
        return TI_FLOAT
    }
    if c.name == "args" {
        if nargs != 0 { die(e.line, "args() takes no arguments") }
        e.aux = CK_ARGS
        return list_of(TI_STR)
    }
    if c.name == "zeros" {
        if nargs != 1 { die(e.line, "zeros(n) takes exactly one int argument") }
        if ty_kind[ce(e.kids[1])] != K_INT { die(e.line, "zeros size must be int") }
        e.aux = CK_ZEROS
        return list_of(TI_INT)
    }
    if c.name == "abs" {
        if nargs != 1 { die(e.line, "abs(x) takes one argument") }
        let t = ce(e.kids[1])
        if not is_num(t) { die(e.line, "abs needs a number") }
        e.aux = CK_ABS
        return t
    }
    if c.name == "min" or c.name == "max" {
        if nargs != 2 { die(e.line, "{c.name}(a, b) takes two arguments") }
        let a = ce(e.kids[1])
        let b = ce(e.kids[2])
        if not is_num(a) or not is_num(b) { die(e.line, "{c.name} needs numbers") }
        if c.name == "min" { e.aux = CK_MIN } else { e.aux = CK_MAX }
        if ty_kind[a] == K_FLOAT or ty_kind[b] == K_FLOAT {
            e.kids[1] = coerce(e.kids[1], TI_FLOAT, c.name)
            e.kids[2] = coerce(e.kids[2], TI_FLOAT, c.name)
            e.op = 1
            return TI_FLOAT
        }
        e.op = 0
        return TI_INT
    }
    if c.name == "pow" {
        if nargs != 2 { die(e.line, "pow(base, exp) takes two int arguments") }
        if ty_kind[ce(e.kids[1])] != K_INT or ty_kind[ce(e.kids[2])] != K_INT { die(e.line, "pow(base, exp) takes two int") }
        e.aux = CK_POW
        return TI_INT
    }
    if c.name == "assert" {
        if nargs != 1 and nargs != 2 { die(e.line, "assert(cond) or assert(cond, msg)") }
        if ty_kind[ce(e.kids[1])] != K_BOOL { die(e.line, "assert condition must be bool") }
        if nargs == 2 and ty_kind[ce(e.kids[2])] != K_STR { die(e.line, "assert message must be str") }
        e.aux = CK_ASSERT
        return TI_VOID
    }
    if c.name == "read_file" {
        if nargs != 1 { die(e.line, "read_file(path) takes exactly one str argument") }
        if ty_kind[ce(e.kids[1])] != K_STR { die(e.line, "read_file path must be str") }
        e.aux = CK_READF
        return TI_STR
    }
    if c.name == "write_file" {
        if nargs != 2 { die(e.line, "write_file(path, data) takes two str arguments") }
        if ty_kind[ce(e.kids[1])] != K_STR or ty_kind[ce(e.kids[2])] != K_STR {
            die(e.line, "write_file arguments must be str")
        }
        e.aux = CK_WRITEF
        return TI_VOID
    }
    if c.name == "chr" {
        if nargs != 1 { die(e.line, "chr(code) takes exactly one int argument") }
        if ty_kind[ce(e.kids[1])] != K_INT { die(e.line, "chr code must be int") }
        e.aux = CK_CHR
        return TI_STR
    }
    if c.name == "bits" {
        if nargs != 1 { die(e.line, "bits(x) takes exactly one float argument") }
        if ty_kind[ce(e.kids[1])] != K_FLOAT { die(e.line, "bits argument must be float") }
        e.aux = CK_BITS
        return TI_INT
    }
    if c.name == "frombits" {
        if nargs != 1 { die(e.line, "frombits(x) takes exactly one int argument") }
        if ty_kind[ce(e.kids[1])] != K_INT { die(e.line, "frombits argument must be int") }
        e.aux = CK_BITS                      // identity: same bits, retyped as float
        return TI_FLOAT
    }
    if c.name == "emit" {
        if nargs != 1 { die(e.line, "emit(s) takes exactly one str argument") }
        if ty_kind[ce(e.kids[1])] != K_STR { die(e.line, "emit argument must be str") }
        e.aux = CK_EMIT
        return TI_VOID
    }
    // unsafe low-level intrinsics (for the Zephyr runtime)
    if c.name == "load64" or c.name == "load8" {
        if nargs != 1 { die(e.line, "{c.name}(addr) takes one int argument") }
        if ty_kind[ce(e.kids[1])] != K_INT { die(e.line, "{c.name} argument must be int") }
        if c.name == "load64" { e.aux = CK_LOAD64 } else { e.aux = CK_LOAD8 }
        return TI_INT
    }
    if c.name == "store64" or c.name == "store32" or c.name == "store8" {
        if nargs != 2 { die(e.line, "{c.name}(addr, val) takes two int arguments") }
        if ty_kind[ce(e.kids[1])] != K_INT or ty_kind[ce(e.kids[2])] != K_INT {
            die(e.line, "{c.name} arguments must be int")
        }
        if c.name == "store64" { e.aux = CK_STORE64 }
        else if c.name == "store32" { e.aux = CK_STORE32 }
        else { e.aux = CK_STORE8 }
        return TI_VOID
    }
    if c.name == "stackptr" {
        if nargs != 0 { die(e.line, "stackptr() takes no arguments") }
        e.aux = CK_STACKPTR
        return TI_INT
    }
    if c.name == "addr" {
        if nargs != 1 { die(e.line, "addr(x) takes one argument") }
        let t = ce(e.kids[1])
        // A function value is a {code, env} cell, so its address is what a
        // native callback thunk needs in order to call back into Zephyr.
        if ty_kind[t] != K_STR and ty_kind[t] != K_LIST and ty_kind[t] != K_STRUCT and ty_kind[t] != K_FN {
            die(e.line, "addr() needs a str, list, struct, or function value")
        }
        e.aux = CK_BITS                      // identity: the reference is the pointer
        return TI_INT
    }
    if g_wasm and (c.name == "memgrow" or c.name == "hostwrite" or c.name == "hostexit") {
        // wasm-only intrinsics, used by lib/os/wasm.zeph and nothing else
        for j in 1..e.kids.len() {
            if ty_kind[ce(e.kids[j])] != K_INT { die(e.line, "{c.name}() arguments must be int") }
        }
        if c.name == "memgrow" {
            if nargs != 1 { die(e.line, "memgrow(pages) takes one argument") }
            e.aux = CK_WGROW
        } else if c.name == "hostwrite" {
            if nargs != 3 { die(e.line, "hostwrite(fd, ptr, len) takes three arguments") }
            e.aux = CK_WWRITE
        } else {
            if nargs != 1 { die(e.line, "hostexit(code) takes one argument") }
            e.aux = CK_WEXIT
        }
        return TI_INT
    }
    if c.name == "syscall" {
        // syscall(number, args...) -- raw Linux syscall, up to 6 arguments
        if nargs < 1 or nargs > 7 { die(e.line, "syscall(n, args...) takes 1-7 arguments") }
        for j in 1..e.kids.len() {
            if ty_kind[ce(e.kids[j])] != K_INT { die(e.line, "syscall() arguments must be int") }
        }
        e.aux = CK_SYSCALL
        return TI_INT
    }
    if c.name == "win" and (g_linux or g_wasm) {
        // Neither target has an import table. Rewrite win("Foo", a, b) into a
        // plain call to k32_Foo(a, b); lib/os/linux.zeph implements that handful
        // of kernel32 entry points over syscalls and lib/os/wasm.zeph over
        // linear memory. The runtime itself stays byte-for-byte neutral.
        let nm0 = e.kids[1]
        if nm0.k != N_STRLIT or nm0.kids.len() != 1 or nm0.kids[0].k != N_STRTXT {
            die(e.line, "win() first argument must be a plain string literal")
        }
        let wn = nm0.kids[0].name
        for j in 0..wn.len() {
            if wn.byte(j) == 33 { die(e.line, "win(\"{wn}\") targets a non-kernel32 DLL; not available on Linux") }
        }
        c.name = "k32_" + wn
        var nk: [Node] = []
        nk.push(e.kids[0])
        for j in 2..e.kids.len() { nk.push(e.kids[j]) }
        e.kids = nk
        nargs = e.kids.len() - 1
    }
    if c.name == "win" {
        if nargs < 1 or nargs > 16 { die(e.line, "win(name, args...) takes 1-16 arguments") }
        let nm = e.kids[1]
        if nm.k != N_STRLIT or nm.kids.len() != 1 or nm.kids[0].k != N_STRTXT {
            die(e.line, "win() first argument must be a plain string literal")
        }
        for j in 2..e.kids.len() {
            if ty_kind[ce(e.kids[j])] != K_INT { die(e.line, "win() call arguments must be int") }
        }
        e.aux = CK_WIN
        return TI_INT
    }
    if c.name == "callptr" {
        // callptr(addr, args...) -- a Win64 call to an address obtained at
        // runtime (GetProcAddress, wglGetProcAddress, a COM vtable slot)
        if nargs < 1 or nargs > 16 { die(e.line, "callptr(addr, args...) takes 1-16 arguments") }
        for j in 1..e.kids.len() {
            if ty_kind[ce(e.kids[j])] != K_INT { die(e.line, "callptr() arguments must be int") }
        }
        e.aux = CK_CALLPTR
        return TI_INT
    }
    if env_find(c.name) >= 0 { return check_indirect(e, ce(c)) }   // variable holding a function
    let fi = find_fn(c.name)
    if fi < 0 { die(e.line, "unknown function '{c.name}'") }
    let f = g_fns[fi]
    if f.tparams.len() > 0 { return check_generic_call(e, fi, nnode(N_NONE, e.line)) }
    if nargs != f.ptypes.len() {
        die(e.line, "'{f.name}' expects {f.ptypes.len()} argument(s), got {nargs}")
    }
    for i in 0..nargs {
        let x = ce_expect(e.kids[i + 1], f.ptypes[i])
        e.kids[i + 1] = coerce(e.kids[i + 1], f.ptypes[i], "argument {i + 1}")
    }
    e.aux = CK_USER
    e.refi = fi
    return f.ret
}

fn ce_inner(e: Node) -> int {
    if e.k == N_INT { return TI_INT }
    if e.k == N_FLOAT { return TI_FLOAT }
    if e.k == N_BOOL { return TI_BOOL }
    if e.k == N_STRLIT {
        for p in e.kids {
            if p.k == N_INTERP {
                let t = ce(p.kids[0])
                if ty_kind[t] == K_VOID { die(p.line, "cannot interpolate a void expression") }
                if ty_kind[t] == K_IFACE { die(p.line, "cannot interpolate an interface value; call one of its methods") }
                p.slot = td_index(t)
            }
        }
        return TI_STR
    }
    if e.k == N_ID {
        let h = env_find(e.name)
        if h < 0 {
            let fi = find_fn(e.name)             // bare function name = function value
            if fi >= 0 {
                let f = g_fns[fi]
                if f.tparams.len() > 0 {
                    die(e.line, "'{e.name}' is generic; it has no single type, so it cannot be used as a value")
                }
                var ps: [int] = []
                for i in 0..f.ptypes.len() { ps.push(f.ptypes[i]) }
                e.aux = ID_FUNC
                e.refi = fi
                return fn_of(ps, f.ret)
            }
            if is_builtin_name(e.name) {
                die(e.line, "'{e.name}' is a builtin â€” call it with (...)")
            }
            die(e.line, "unknown variable '{e.name}'")
        }
        let v = env_get(h)
        let cap = capture_of(e, h, v)
        if cap >= 0 {
            e.aux = ID_CAPTURE
            e.slot = cap
            return v.ty
        }
        e.aux = v.kind
        e.slot = v.idx
        return v.ty
    }
    if e.k == N_NONELIT { return TI_NONE }
    if e.k == N_FNLIT { return check_fnlit(e) }
    if e.k == N_SOME { return e.ty }          // built by coerce; already typed
    if e.k == N_MAPLIT {
        if e.kids.len() == 0 {
            die(e.line, "cannot infer the type of an empty map literal; annotate the variable")
        }
        var kt = ce(e.kids[0])
        var vt = ce(e.kids[1])
        var i = 2
        while i < e.kids.len() {
            let k2 = ce(e.kids[i])
            let v2 = ce(e.kids[i + 1])
            if not fits(kt, k2) {
                if fits(k2, kt) { kt = k2 }
                else { die(e.line, "mixed key types in map: {type_str(kt)} and {type_str(k2)}") }
            }
            if not fits(vt, v2) {
                if fits(v2, vt) { vt = v2 }
                else { die(e.line, "mixed value types in map: {type_str(vt)} and {type_str(v2)}") }
            }
            i += 2
        }
        if not valid_map_key(kt) { die(e.line, "{type_str(kt)} cannot be a map key (use int, str, bool, or an enum)") }
        i = 0
        while i < e.kids.len() {
            e.kids[i] = coerce(e.kids[i], kt, "map key")
            e.kids[i + 1] = coerce(e.kids[i + 1], vt, "map value")
            i += 2
        }
        return map_of(kt, vt)
    }
    if e.k == N_LIST {
        if e.kids.len() == 0 {
            die(e.line, "cannot infer the type of an empty list literal; annotate the variable")
        }
        var el = ce(e.kids[0])
        for i in 1..e.kids.len() {
            let t = ce(e.kids[i])
            if fits(el, t) { continue }
            if fits(t, el) {
                el = t
                continue
            }
            die(e.line, "mixed element types in list: {type_str(el)} and {type_str(t)}")
        }
        for i in 0..e.kids.len() {
            e.kids[i] = coerce(e.kids[i], el, "list element")
        }
        return list_of(el)
    }
    if e.k == N_SLIT {
        let si = find_struct(e.name)
        if si < 0 { die(e.line, "unknown struct '{e.name}'") }
        let sd = g_structs[si]
        if e.kids.len() != sd.fnames.len() {
            die(e.line, "struct '{sd.name}' has {sd.fnames.len()} field(s), literal provides {e.kids.len()}")
        }
        var seen: [bool] = []
        for i in 0..sd.fnames.len() { seen.push(false) }
        for f in e.kids {
            var idx = -1
            for j in 0..sd.fnames.len() {
                if sd.fnames[j] == f.name { idx = j }
            }
            if idx < 0 { die(f.line, "struct '{sd.name}' has no field '{f.name}'") }
            if seen[idx] { die(f.line, "duplicate field '{f.name}'") }
            seen[idx] = true
            f.slot = idx
            let x = ce(f.kids[0])
            f.kids[0] = coerce(f.kids[0], sd.ftypes[idx], "struct field")
        }
        e.refi = si
        return struct_of(si)
    }
    if e.k == N_NEG {
        let t = ce(e.kids[0])
        if not is_num(t) { die(e.line, "unary '-' needs a number, got {type_str(t)}") }
        return t
    }
    if e.k == N_NOT {
        let t = ce(e.kids[0])
        if ty_kind[t] != K_BOOL { die(e.line, "'not' needs a bool, got {type_str(t)}") }
        return TI_BOOL
    }
    if e.k == N_BIN { return check_bin(e) }
    if e.k == N_CAST {
        let from = ce(e.kids[0])
        let to = resolve_type(e.kids[1])
        let f = ty_kind[from]
        let t = ty_kind[to]
        var cast = -1
        if f == t and f != K_LIST and f != K_STRUCT and f != K_ENUM { cast = C_NOP }
        else if f == K_ENUM and t == K_ENUM and type_eq(from, to) { cast = C_NOP }
        else if f == K_ENUM and t == K_INT { cast = C_NOP }    // enums are ints at runtime
        else if f == K_ENUM and t == K_STR { cast = C_TOSTR }  // member name
        else if f == K_INT and t == K_FLOAT { cast = C_I2F }
        else if f == K_FLOAT and t == K_INT { cast = C_TRUNC }
        else if (f == K_INT or f == K_FLOAT or f == K_BOOL) and t == K_STR { cast = C_TOSTR }
        else if f == K_STR and t == K_INT { cast = C_S2I }
        else if f == K_STR and t == K_FLOAT { cast = C_S2F }
        if cast < 0 { die(e.line, "no conversion from {type_str(from)} to {type_str(to)}") }
        e.aux = cast
        if cast == C_TOSTR { e.slot = td_index(from) }
        return to
    }
    if e.k == N_INDEX {
        let ot = ce(e.kids[0])
        if ty_kind[ot] == K_MAP {
            let kt = ce(e.kids[1])
            e.kids[1] = coerce(e.kids[1], ty_sd[ot], "map key")
            return ty_el[ot]
        }
        if ty_kind[ot] != K_LIST { die(e.line, "cannot index into {type_str(ot)}") }
        if ty_kind[ce(e.kids[1])] != K_INT { die(e.line, "list index must be int") }
        return ty_el[ot]
    }
    if e.k == N_MEMBER {
        // Enum member access: `Name.A` folds to its ordinal at compile time.
        // A variable of the same name shadows the enum type.
        if e.kids[0].k == N_ID and env_find(e.kids[0].name) < 0 {
            let ei = find_enum(e.kids[0].name)
            if ei >= 0 {
                let ed = g_enums[ei]
                for i in 0..ed.members.len() {
                    if ed.members[i] == e.name {
                        e.k = N_INT                  // becomes an int literal
                        e.ival = i
                        while e.kids.len() > 0 { let drop = e.kids.pop() }
                        return enum_of(ei)
                    }
                }
                die(e.line, "enum '{ed.name}' has no member '{e.name}'")
            }
        }
        let ot = ce(e.kids[0])
        if ty_kind[ot] == K_STRUCT {
            let sd = g_structs[ty_sd[ot]]
            for i in 0..sd.fnames.len() {
                if sd.fnames[i] == e.name {
                    e.slot = i
                    return sd.ftypes[i]
                }
            }
            die(e.line, "struct '{sd.name}' has no field '{e.name}'")
        }
        die(e.line, "{type_str(ot)} has no field '{e.name}'")
    }
    if e.k == N_CALL { return check_call(e) }
    die(e.line, "internal: unknown expression kind {e.k}")
    return TI_VOID
}

fn ce(e: Node) -> int {
    let t = ce_inner(e)
    e.ty = t
    return t
}

// Check an expression against a known expected type. Literals that carry no type
// of their own -- `[]`, `[:]` -- adopt it instead of erroring, and the elements
// of a list literal each coerce to the expected element type, which is what lets
// a `[Shape]` argument hold a mix of implementing structs.
fn ce_expect(e: Node, want: int) -> int {
    if e.k == N_LIST and e.kids.len() == 0 and ty_kind[want] == K_LIST {
        e.ty = want
        return want
    }
    if e.k == N_MAPLIT and e.kids.len() == 0 and ty_kind[want] == K_MAP {
        e.ty = want
        return want
    }
    if e.k == N_LIST and e.kids.len() > 0 and ty_kind[want] == K_LIST {
        let el = ty_el[want]
        if ty_kind[el] == K_IFACE {
            for i in 0..e.kids.len() {
                let t = ce(e.kids[i])
                e.kids[i] = coerce(e.kids[i], el, "list element")
            }
            e.ty = want
            return want
        }
    }
    return ce(e)
}

fn check_block(blk: Node) {
    env_push()
    let save = g_at_global
    g_at_global = false
    for s in blk.kids { check_stmt(s) }
    g_at_global = save
    env_pop()
}

fn check_stmt(s: Node) {
    if s.k == N_DECL {
        if env_find_here(s.name) { die(s.line, "'{s.name}' is already declared in this scope") }
        if is_builtin_name(s.name) { die(s.line, "'{s.name}' is a builtin name") }
        // a global may not collide with a function; a local may shadow one
        if g_at_global and find_fn(s.name) >= 0 { die(s.line, "'{s.name}' is already a function") }
        var ty = TI_VOID
        if s.kids[0].k == N_LIST and s.kids[0].kids.len() == 0 {
            if s.kids[1].k == N_NONE {
                die(s.line, "cannot infer the type of an empty list; annotate it")
            }
            ty = resolve_type(s.kids[1])
            if ty_kind[ty] != K_LIST { die(s.line, "empty list literal needs a list type") }
            s.kids[0].ty = ty
        } else if s.kids[0].k == N_MAPLIT and s.kids[0].kids.len() == 0 {
            if s.kids[1].k == N_NONE {
                die(s.line, "cannot infer the type of an empty map; annotate it")
            }
            ty = resolve_type(s.kids[1])
            if ty_kind[ty] != K_MAP { die(s.line, "empty map literal '[:]' needs a map type") }
            s.kids[0].ty = ty
        } else {
            let et = ce(s.kids[0])
            if ty_kind[et] == K_VOID { die(s.line, "cannot assign a void expression") }
            if ty_kind[et] == K_NONE and s.kids[1].k == N_NONE {
                die(s.line, "cannot infer the type of 'none'; annotate it, e.g. let {s.name}: int? = none")
            }
            ty = et
            if s.kids[1].k != N_NONE {
                ty = resolve_type(s.kids[1])
                s.kids[0] = coerce(s.kids[0], ty, "initializer")
            }
        }
        s.ty = ty
        if g_at_global {
            s.aux = ID_GLOBAL
            s.slot = g_nglobals
            g_nglobals += 1
        } else {
            s.aux = ID_LOCAL
            s.slot = g_nslots
            g_nslots += 1
        }
        env_add(s.name, ty, s.mut, s.aux, s.slot)
        return
    }
    if s.k == N_ASSIGN {
        let t = s.kids[0]
        let x = ce(s.kids[1])
        if t.k == N_ID {
            let h = env_find(t.name)
            if h < 0 { die(t.line, "unknown variable '{t.name}'") }
            let v = env_get(h)
            if not v.mut { die(t.line, "'{t.name}' is immutable (declared with 'let'; use 'var' to allow reassignment)") }
            if capture_of(t, h, v) >= 0 {
                die(t.line, "'{t.name}' is captured by this closure and cannot be assigned to; closures capture by value")
            }
            t.aux = v.kind
            t.slot = v.idx
            t.ty = v.ty
            s.kids[1] = coerce(s.kids[1], v.ty, "assignment")
        } else {
            let ft = ce(t)
            s.kids[1] = coerce(s.kids[1], ft, "assignment")
        }
        return
    }
    if s.k == N_IF {
        if ty_kind[ce(s.kids[0])] != K_BOOL { die(s.line, "if condition must be bool") }
        check_block(s.kids[1])
        if s.kids[2].k != N_NONE { check_block(s.kids[2]) }
        return
    }
    if s.k == N_WHILE {
        if ty_kind[ce(s.kids[0])] != K_BOOL { die(s.line, "while condition must be bool") }
        g_in_loop += 1
        check_block(s.kids[1])
        g_in_loop -= 1
        return
    }
    if s.k == N_FORR {
        if ty_kind[ce(s.kids[0])] != K_INT or ty_kind[ce(s.kids[1])] != K_INT {
            die(s.line, "range bounds must be int")
        }
        s.slot = g_nslots
        g_nslots += 1
        s.aux = g_nslots
        g_nslots += 1
        env_push()
        env_add(s.name, TI_INT, false, ID_LOCAL, s.slot)
        g_in_loop += 1
        check_block(s.kids[2])
        g_in_loop -= 1
        env_pop()
        return
    }
    if s.k == N_FORIN {
        let lt = ce(s.kids[0])
        if ty_kind[lt] != K_LIST { die(s.line, "for-in needs a list, got {type_str(lt)}") }
        s.slot = g_nslots
        g_nslots += 1
        s.aux = g_nslots
        g_nslots += 1
        s.op = g_nslots
        g_nslots += 1
        env_push()
        env_add(s.name, ty_el[lt], false, ID_LOCAL, s.slot)
        g_in_loop += 1
        check_block(s.kids[1])
        g_in_loop -= 1
        env_pop()
        return
    }
    if s.k == N_RET {
        if g_is_top { die(s.line, "'return' outside a function") }
        if ty_kind[g_ret] == K_VOID {
            if s.kids[0].k != N_NONE { die(s.line, "this function does not return a value") }
            return
        }
        if s.kids[0].k == N_NONE { die(s.line, "expected a return value of type {type_str(g_ret)}") }
        let x = ce_expect(s.kids[0], g_ret)
        s.kids[0] = coerce(s.kids[0], g_ret, "return")
        return
    }
    if s.k == N_BRK or s.k == N_CONT {
        if g_in_loop == 0 { die(s.line, "'break'/'continue' outside a loop") }
        return
    }
    if s.k == N_EXPRST {
        let x = ce(s.kids[0])
        return
    }
    die(s.line, "internal: unknown statement kind {s.k}")
}

fn always_returns(stmts: [Node]) -> bool {
    for s in stmts {
        if s.k == N_RET { return true }
        if s.k == N_IF and s.kids[2].k != N_NONE {
            if always_returns(s.kids[1].kids) and always_returns(s.kids[2].kids) { return true }
        }
    }
    return false
}

var g_top_nslots = 0
var g_rt_top = 0     // top-level statements contributed by runtime.zeph (--rt)

// Desugar `extern fn` declarations into ordinary Zephyr functions that resolve
// their target lazily and cache it: one LoadLibraryA per DLL, one
// GetProcAddress per symbol, then callptr (which already does the full Win64
// marshalling). Generated as source text and parsed, so this adds no codegen.
fn desugar_extern(prog: Node) {
    var dlls: [str] = []
    var externs: [Node] = []
    var out: [Node] = []
    for n in prog.kids {
        if n.k == N_EXTERN { externs.push(n) }
        else { out.push(n) }
    }
    if externs.len() == 0 { return }
    var src: [str] = []
    src.push("fn __xcstr(s: str) -> int \{\n")
    src.push("    let n = s.len()\n")
    src.push("    let p = win(\"VirtualAlloc\", 0, n + 1, 12288, 4)\n")
    src.push("    var i = 0\n")
    src.push("    while i < n \{\n        store8(p + i, s.byte(i))\n        i += 1\n    \}\n")
    src.push("    store8(p + n, 0)\n    return p\n\}\n")
    // EAX zero-extends into RAX, so a negative int32 result needs sign-extending
    src.push("fn __xsext32(v: int) -> int \{\n")
    src.push("    if v >= 2147483648 \{ return v - 4294967296 \}\n")
    src.push("    return v\n\}\n")
    for j in 0..externs.len() {
        let x = externs[j]
        let params = x.kids[0]
        let ret = x.kids[1]
        let dllname = x.kids[2].name
        // foreign values are addresses or scalars: int only (see p_extern)
        for p in params.kids {
            let t = p.kids[0]
            if t.k != N_TYNAME or t.name != "int" {
                die(p.line, "extern parameter '{p.name}' must be int (foreign arguments are addresses or scalars)")
            }
        }
        var sext = false
        if ret.k != N_NONE {
            if ret.k != N_TYNAME or (ret.name != "int" and ret.name != "i32") {
                die(x.line, "extern '{x.name}' must return int, i32, or nothing")
            }
            if ret.name == "i32" { sext = true }
        }
        var d = 0 - 1
        for i in 0..dlls.len() {
            if dlls[i] == dllname { d = i }
        }
        if d < 0 {
            dlls.push(dllname)
            d = dlls.len() - 1
            src.push("var __xh{d} = 0\n")
            src.push("fn __xd{d}() -> int \{\n")
            src.push("    if __xh{d} == 0 \{\n")
            src.push("        __xh{d} = win(\"LoadLibraryA\", __xcstr(\"{dllname}\"))\n")
            src.push("        if __xh{d} == 0 \{ panic(\"extern: cannot load {dllname}\") \}\n")
            src.push("    \}\n    return __xh{d}\n\}\n")
        }
        var sig: [str] = []
        var call: [str] = []
        for i in 0..params.kids.len() {
            if i > 0 {
                sig.push(", ")
                call.push(", ")
            }
            sig.push("a{i}: int")
            call.push("a{i}")
        }
        var arglist = ""
        if params.kids.len() > 0 { arglist = ", " + call.join() }
        src.push("var __xf{j} = 0\n")
        src.push("fn {x.name}(" + sig.join() + ")")
        if ret.k != N_NONE { src.push(" -> int") }
        src.push(" \{\n")
        src.push("    if __xf{j} == 0 \{\n")
        src.push("        __xf{j} = win(\"GetProcAddress\", __xd{d}(), __xcstr(\"{x.name}\"))\n")
        src.push("        if __xf{j} == 0 \{ panic(\"extern: {dllname} has no symbol {x.name}\") \}\n")
        src.push("    \}\n")
        if ret.k == N_NONE { src.push("    let __r = callptr(__xf{j}" + arglist + ")\n") }
        else if sext { src.push("    return __xsext32(callptr(__xf{j}" + arglist + "))\n") }
        else { src.push("    return callptr(__xf{j}" + arglist + ")\n") }
        src.push("\}\n")
    }
    let save = g_file
    g_file = "<extern>"
    let gen = parse(lex_src(src.join(), 1))
    g_file = save
    for n in gen.kids { out.push(n) }
    prog.kids = out
}

// Desugar impl blocks into plain functions. `impl Point { fn dist(self) {...} }`
// becomes a function named "Point.dist" (asm label "Point__dist") whose `self`
// parameter is typed as Point. Method and associated-call syntax then resolves
// to these mangled names. Interfaces are left in place for check() to register.
fn desugar_oop(prog: Node) {
    var out: [Node] = []
    for n in prog.kids {
        if n.k == N_IMPL {
            for m in n.kids {
                m.name = n.name + "." + m.name       // "Point.dist"
                let params = m.kids[0]
                if params.kids.len() > 0 and params.kids[0].name == "self" {
                    params.kids[0].kids[0].name = n.name   // self: Point
                }
                out.push(m)
            }
        } else {
            out.push(n)
        }
    }
    prog.kids = out
}

// asm-safe label for a function name that may contain a '.' (methods): the dot
// becomes '__'. (Written with primitives so the C seed can compile this file.)
fn fn_asm_label(name: str) -> str {
    var out: [str] = []
    for i in 0..name.len() {
        let c = name.byte(i)
        if c == 46 { out.push("__") }
        else { out.push(chr(c)) }
    }
    return out.join()
}

fn find_iface(name: str) -> int {
    for i in 0..g_ifaces.len() {
        if g_ifaces[i].name == name { return i }
    }
    return 0 - 1
}
fn iface_of(id: int) -> int { return new_type(K_IFACE, 0, id) }

// Does the struct (def index sd) provide every method of interface `ifc`,
// with a matching signature (self as the receiver, then the declared params)?
fn struct_implements(sd: int, ifc: int) -> bool {
    let idf = g_ifaces[ifc]
    let sname = g_structs[sd].name
    for m in 0..idf.mnames.len() {
        let fi = find_fn(sname + "." + idf.mnames[m])
        if fi < 0 { return false }
        let f = g_fns[fi]
        let sig = g_fnsigs[ty_sd[idf.msigs[m]]]
        if f.ptypes.len() != sig.ptypes.len() + 1 { return false }   // + self
        if ty_kind[f.ptypes[0]] != K_STRUCT or ty_sd[f.ptypes[0]] != sd { return false }
        for j in 0..sig.ptypes.len() {
            if not type_eq(f.ptypes[j + 1], sig.ptypes[j]) { return false }
        }
        if not type_eq(f.ret, sig.ret) { return false }
    }
    return true
}

// index of the (struct, interface) vtable to emit, creating it on first use
fn vtable_index(sd: int, ifc: int) -> int {
    for i in 0..g_vt_sd.len() {
        if g_vt_sd[i] == sd and g_vt_if[i] == ifc { return i }
    }
    g_vt_sd.push(sd)
    g_vt_if.push(ifc)
    return g_vt_sd.len() - 1
}

fn check(prog: Node) {
    // pass 0: enum names + members (int-backed, resolved at compile time)
    for n in prog.kids {
        if n.k == N_ENUMDEF {
            if find_enum(n.name) >= 0 { die(n.line, "duplicate enum '{n.name}'") }
            if find_struct(n.name) >= 0 { die(n.line, "'{n.name}' is already a struct") }
            var members: [str] = []
            for m in n.kids {
                for k in 0..members.len() {
                    if members[k] == m.name { die(m.line, "duplicate member '{m.name}' in enum '{n.name}'") }
                }
                members.push(m.name)
            }
            g_enums.push(EDef{name: n.name, members: members, line: n.line})
            n.refi = g_enums.len() - 1
        }
    }
    // pass 1a: struct names
    for n in prog.kids {
        if n.k == N_STRUCTDEF {
            if find_struct(n.name) >= 0 { die(n.line, "duplicate struct '{n.name}'") }
            if find_enum(n.name) >= 0 { die(n.line, "'{n.name}' is already an enum") }
            var fnames: [str] = []
            var ftypes: [int] = []
            g_structs.push(SDef{name: n.name, fnames: fnames, ftypes: ftypes, line: n.line})
            n.refi = g_structs.len() - 1
        }
    }
    // pass 1a.5: interface names + method signatures (self excluded from sigs)
    for n in prog.kids {
        if n.k == N_INTERFACE {
            if find_iface(n.name) >= 0 { die(n.line, "duplicate interface '{n.name}'") }
            if find_struct(n.name) >= 0 { die(n.line, "'{n.name}' is already a struct") }
            if find_enum(n.name) >= 0 { die(n.line, "'{n.name}' is already an enum") }
            var mnames: [str] = []
            var msigs: [int] = []
            for m in n.kids {
                for k in 0..mnames.len() {
                    if mnames[k] == m.name { die(m.line, "duplicate method '{m.name}' in interface '{n.name}'") }
                }
                let params = m.kids[0]
                if params.kids.len() == 0 or params.kids[0].name != "self" {
                    die(m.line, "interface method '{m.name}' must take 'self' as its first parameter")
                }
                var ps: [int] = []
                for i in 1..params.kids.len() { ps.push(resolve_type(params.kids[i].kids[0])) }
                var ret = TI_VOID
                if m.kids[1].k != N_NONE { ret = resolve_type(m.kids[1]) }
                mnames.push(m.name)
                msigs.push(fn_of(ps, ret))
            }
            g_ifaces.push(IDef{name: n.name, mnames: mnames, msigs: msigs, line: n.line})
            n.refi = g_ifaces.len() - 1
        }
    }
    // pass 1b: struct fields
    for n in prog.kids {
        if n.k == N_STRUCTDEF {
            let sd = g_structs[n.refi]
            for f in n.kids {
                for k in 0..sd.fnames.len() {
                    if sd.fnames[k] == f.name {
                        die(f.line, "duplicate field '{f.name}' in struct '{sd.name}'")
                    }
                }
                sd.fnames.push(f.name)
                sd.ftypes.push(resolve_type(f.kids[0]))
            }
        }
    }
    // pass 1c: function signatures
    for n in prog.kids {
        if n.k == N_FN {
            if find_fn(n.name) >= 0 { die(n.line, "duplicate function '{n.name}'") }
            if is_builtin_name(n.name) { die(n.line, "'{n.name}' is a builtin and cannot be redefined") }
            var tparams: [str] = []
            for t in n.kids[3].kids { tparams.push(t.name) }
            var pnames: [str] = []
            var ptypes: [int] = []
            for p in n.kids[0].kids {
                for k in 0..pnames.len() {
                    if pnames[k] == p.name { die(p.line, "duplicate parameter '{p.name}'") }
                }
                pnames.push(p.name)
                // a generic signature mentions type params, so it stays unresolved
                // until instantiation; we infer from the AST at the call site
                if tparams.len() == 0 { ptypes.push(resolve_type(p.kids[0])) }
            }
            var ret = TI_VOID
            if tparams.len() == 0 and n.kids[1].k != N_NONE { ret = resolve_type(n.kids[1]) }
            g_fns.push(FDef{name: n.name, pnames: pnames, ptypes: ptypes, ret: ret,
                            body: n.kids[2], nslots: 0, line: n.line,
                            tparams: tparams, node: n, label: fn_asm_label(n.name), has_env: false,
                            pristine: n, prist_ok: false, prist_nslots: 0})
            n.refi = g_fns.len() - 1
        }
    }
    // pass 2: bodies and top-level statements in source order
    env_push() // global scope
    g_is_top = true
    g_at_global = true
    for n in prog.kids {
        if n.k == N_STRUCTDEF or n.k == N_ENUMDEF or n.k == N_INTERFACE { continue }
        if n.k == N_FN {
            // a generic function is a template: nothing to check until it is
            // instantiated with concrete types
            if g_fns[n.refi].tparams.len() == 0 { check_fn_body(g_fns[n.refi]) }
            continue
        }
        check_stmt(n)
    }
    g_top_nslots = g_nslots
    drain_pending()
}

// check one function body with the current type bindings in effect
fn check_fn_body(f: FDef) {
    env_push()
    for j in 0..f.pnames.len() {
        env_add(f.pnames[j], f.ptypes[j], false, ID_PARAM, j)
    }
    let save_ret = g_ret
    let save_top = g_is_top
    let save_loop = g_in_loop
    let save_slots = g_nslots
    let save_glob = g_at_global
    g_ret = f.ret
    g_is_top = false
    g_in_loop = 0
    g_nslots = 0
    g_at_global = false
    check_block(f.body)
    f.nslots = g_nslots
    g_ret = save_ret
    g_is_top = save_top
    g_in_loop = save_loop
    g_nslots = save_slots
    g_at_global = save_glob
    env_pop()
    if ty_kind[f.ret] != K_VOID and not always_returns(f.body.kids) {
        die(f.line, "function '{f.name}' must return {type_str(f.ret)} on all paths")
    }
}

// Check the bodies of every monomorphisation queued during checking. Checking one
// may queue more (a generic calling a generic), so loop until the queue is empty.
fn drain_pending() {
    while g_pending.len() > 0 {
        let inst = g_pending.pop()
        for i in 0..inst.tnames.len() {
            g_tbind_names.push(inst.tnames[i])
            g_tbind_types.push(inst.ttypes[i])
        }
        check_fn_body(g_fns[inst.fi])
        for i in 0..inst.tnames.len() {
            let a = g_tbind_names.pop()
            let b = g_tbind_types.pop()
        }
    }
}

// ---------------- codegen ----------------
fn o(s: str) {
    // peephole: "movq rax, xmm0" then "movq xmm0, rax" reloads xmm0 with the
    // value it already holds -- a no-op. Drops the float-result round-trip that
    // appears between adjacent float ops (result -> rax -> xmm0 for next op).
    if s == "movq xmm0, rax" and g_lines.len() > 0 {
        if g_lines[g_lines.len() - 1] == "  movq rax, xmm0\n" { return }
    }
    g_lines.push("  " + s + "\n")
}
fn raw(s: str) { g_lines.push(s + "\n") }

// runtime functions keep bare names so they satisfy the codegen's rt_ calls
fn fn_label(name: str) -> str {
    if name.len() >= 3 and name.sub(0, 3) == "rt_" { return name }
    return "lm_" + name
}

fn newlabel() -> int {
    let l = g_label
    g_label += 1
    return l
}

fn lbl(l: int) -> str { return ".L{l}" }
fn olabel(l: int) { raw(".L{l}:") }

fn add_dstr(s: str) -> int {
    g_dstrs.push(s)
    return g_dstrs.len() - 1
}

// Float literals used to be materialized with `movabs rax, <bits>` + `movq
// xmm, rax`: two instructions, a GPR clobbered, and no chance for the SSE
// instruction to read the value in place. Parking them in .rdata makes
// `divsd xmm0, [rip + __fc3]` one instruction, which is what a C compiler
// emits. Deduped on the bit pattern, so -0.0 and 0.0 stay distinct.
var g_fconsts: [int] = []

fn add_fconst(v: float) -> int {
    let b = bits(v)
    for i in 0..g_fconsts.len() {
        if g_fconsts[i] == b { return i }
    }
    g_fconsts.push(b)
    return g_fconsts.len() - 1
}

fn fconst_ref(v: float) -> str { return "[rip + __fc{add_fconst(v)}]" }

fn add_cstr(s: str) -> int {
    for i in 0..g_cstrs.len() {
        if g_cstrs[i] == s { return i }
    }
    g_cstrs.push(s)
    return g_cstrs.len() - 1
}

fn rcall(f: str) {
    o("mov r12, rsp")
    o("and rsp, -16")
    o("sub rsp, 32")
    o("call " + f)
    o("mov rsp, r12")
}

fn slot_addr(kind: int, idx: int) -> str {
    if kind == ID_LOCAL {
        if idx < g_lreg.len() and g_lreg[idx] != "" { return g_lreg[idx] }
        return "[rbp - {16 + 8 * idx}]"
    }
    if kind == ID_GLOBAL { return "[rip + __zephyr_globals + {8 * idx}]" }
    // param: promoted params live in a register for the whole body
    if idx < g_preg.len() and g_preg[idx] != "" { return g_preg[idx] }
    // regcall functions spill args to home slots past the locals
    if g_cur_regcall { return "[rbp - {16 + 8 * g_cur_nslots + 8 * idx}]" }
    return "[rbp + {16 + 8 * (g_cur_nparams - 1 - idx)}]"
}

fn starts_rt(name: str) -> bool {
    return name.len() >= 3 and name.sub(0, 3) == "rt_"
}

// ---------------- reference counting ----------------
// Ownership contract of the x86 backend. gen_expr leaves an OWNED (+1) value
// in rax whenever the type is a reference. Every STORED slot -- local, global,
// field, element, capture -- owns +1 of what it holds, so a store goes through
// rx_assign (drop the old holder) and a function drops its locals on exit.
// Functions return owned values.
//
// PARAMETERS ARE BORROWED. A call takes no count and the callee releases
// nothing: the caller is holding the value for the duration, either in one of
// its own slots or in an owned temporary it keeps pushed across the call and
// drops afterwards. That is sound by induction, because every borrow bottoms
// out in one of those two and a suspended frame can release neither. It is
// also why reading a parameter still takes a count -- storing it anywhere that
// outlives the call goes through gen_expr, which dups. Zephyr parameters are
// immutable, so a borrowed slot is never written.
//
// Runtime rt_ entry points borrow their arguments and return owned results;
// rt_list_push and rt_map_set are the two that take ownership instead. A value
// needed only for one operation is fetched with gen_tmp, which skips the +1
// when something already pins it (borrow_ok) and otherwise tells the caller to
// drop it afterwards. borrow_ok's `safe` flag is the difference between "this
// expression is next" and "an arbitrary callee runs next": across a call only
// a constant or a local/param/capture may be borrowed, never a global or a
// container element the callee could remove.
// ponytail: values live until overwritten or function exit, not scope exit --
// a per-scope drop is the upgrade if loop temporaries ever hold too much.
fn is_ref(t: int) -> bool {
    let k = ty_kind[t]
    return k == K_STR or k == K_LIST or k == K_STRUCT or k == K_MAP or k == K_FN or k == K_OPT or k == K_IFACE or k == K_NONE
}
fn ref_bit(t: int) -> int {
    if is_ref(t) { return 1 }
    return 0
}

var g_borrow = false        // gen_expr: leave a borrowed value (no dup); consumed by the very next node
var g_dslots: [str] = []    // per-function frame-offset tables for the exit drop
var g_dts: [str] = []       // shape descriptors, ".quad" words comma-separated (layout: rx_drop_children)
var g_ia_tmp = 0            // gen_index_addr: 0 nothing pushed, 1 borrowed base at [rsp], 2 owned base at [rsp]
var g_refslot: [bool] = []  // per function: local slots holding a reference
var g_cur_ptypes: [int] = []

fn dt_add(words: str) -> int {
    for i in 0..g_dts.len() {
        if g_dts[i] == words { return i }
    }
    g_dts.push(words)
    return g_dts.len() - 1
}
// kind 1: n fixed slots, bitmask words saying which hold references
fn dt_slots(types: [int]) -> int {
    var w = "1, {types.len()}"
    var i = 0
    while i < types.len() {
        var mask = 0
        var b = 0
        while b < 64 and i + b < types.len() {
            if is_ref(types[i + b]) { mask = mask | (1 << b) }
            b += 1
        }
        w = w + ", {mask}"
        i += 64
    }
    return dt_add(w)
}
fn dt_list(t: int) -> int { return dt_add("2, {ref_bit(ty_el[t])}") }
fn dt_map(t: int) -> int { return dt_add("3, {ref_bit(ty_sd[t])}, {ref_bit(ty_el[t])}") }
fn dt_ref() -> str {                       // {code|vtable, ref} cells
    let i = dt_add("1, 2, 2")
    return "lea rdx, [rip + __dt{i}]"
}

// the value can be read without taking a +1: a local pins it, or it is a constant.
// `safe` says nothing that could drop it (a call, a store) runs before the use.
fn borrow_ok(x: Node, safe: bool) -> bool {
    if not is_ref(x.ty) { return true }
    if x.k == N_STRLIT { return x.kids.len() == 1 and x.kids[0].k == N_STRTXT }
    if x.k == N_NONELIT { return true }
    if x.k == N_ID { return x.aux == ID_LOCAL or x.aux == ID_PARAM or x.aux == ID_CAPTURE }
    if not safe { return false }
    if x.k == N_MEMBER { return borrow_ok(x.kids[0], true) }
    if x.k == N_INDEX and ty_kind[x.kids[0].ty] == K_LIST {
        return borrow_ok(x.kids[0], true) and not has_call(x.kids[1])
    }
    return false
}
// An inlined call's argument temporary IS a parameter, so it borrows like one.
// The hoisted decl, the inlined body and the statement that consumes the result
// are adjacent in the same block, so the caller's slot pins the value for
// exactly the span a real call would. Borrowing means the temp neither takes a
// count nor needs releasing, which keeps it out of the frame's exit-drop table
// -- and those temporaries were the bulk of it, one per argument per inlined
// call site, all still being visited on every return.
fn inl_borrow_decl(s: Node) -> bool {
    if s.k != N_DECL or s.aux != ID_LOCAL { return false }
    if s.name != "(inlined arg)" { return false }
    if not is_ref(s.ty) { return false }
    return borrow_ok(s.kids[0], false)
}

// value -> rax; true when it is an owned temporary the caller must drop
fn gen_tmp(x: Node, safe: bool) -> bool {
    if borrow_ok(x, safe) {
        g_borrow = true
        gen_expr(x)
        return false
    }
    gen_expr(x)
    return true
}
// Taking a count is the most frequent thing the counter does -- half of every
// call site in a reference-heavy program -- so it skips rcall's alignment
// dance. That is safe only because rx_dup is a leaf: a range check and an
// increment, no Win32 call, nothing that needs a 16-byte rsp or shadow space.
// Keep it a leaf. (Inlining it outright costs more than it saves: each site
// would need a label, and the assembler's symbol table is already two thirds
// full at this program size.)
fn dup_rax() {
    o("mov rcx, rax")
    o("call " + fn_label("rx_dup"))           // returns its argument: rax survives
}
fn drop_rax() {
    o("mov rcx, rax")
    rcall(fn_label("rx_drop"))
}
fn tmp_hold(t: bool) { if t { o("push rax") } }
fn tmp_done(t: bool) {
    if t {
        o("pop rcx")
        rcall(fn_label("rx_drop"))
    }
}
// the temp at [rsp] goes; rax (a result) stays
fn tmp_done_keep(t: bool) {
    if t {
        o("mov rcx, [rsp]")
        o("mov [rsp], rax")
        rcall(fn_label("rx_drop"))
        o("pop rax")
    }
}
// the value was pushed whether owned or not
fn tmp_pop(t: bool) {
    if t { tmp_done(t) } else { o("add rsp, 8") }
}
fn tmp_pop_keep(t: bool) {
    if t { tmp_done_keep(t) } else { o("add rsp, 8") }
}
// n values pushed in order sit at [rsp .. rsp+8n); release the owned ones, pop all, keep rax
fn drop_temps(owned: [bool]) {
    let n = owned.len()
    var any = false
    for i in 0..n { if owned[i] { any = true } }
    if any {
        o("push rax")
        for i in 0..n {
            if owned[i] {
                o("mov rcx, [rsp + {8 + 8 * (n - 1 - i)}]")
                rcall(fn_label("rx_drop"))
            }
        }
        o("pop rax")
    }
    if n > 0 { o("add rsp, {8 * n}") }
}
// rax -> the reference slot, releasing what it held
fn store_ref(kind: int, idx: int) {
    // A reference slot must live in memory: rx_assign takes its address, and
    // `lea` on a register is not an instruction. compute_promotions is what
    // guarantees this, by refusing to promote anything mark_ref_slots claimed.
    if not addr_is_mem(slot_addr(kind, idx)) {
        panic("internal: reference slot {kind}/{idx} was register-promoted")
    }
    o("lea rcx, " + slot_addr(kind, idx))
    o("mov rdx, rax")
    rcall(fn_label("rx_assign"))
}
// finish an element access that gen_index_addr left a base for; rax stays
fn index_fin_keep() {
    if g_ia_tmp == 2 { tmp_done_keep(true) }
    else if g_ia_tmp == 1 { o("add rsp, 8") }
    g_ia_tmp = 0
}
// ---- ownership inference: move on last use ----
// A reference read that is the LAST read of its local needs no new count: the
// slot hands over the one it already holds, and is cleared so the exit drop
// finds nothing. That removes the dup/drop pair around the shape this compiler
// is built out of -- allocate a node, fill it in, then store or return it.
//
// Three things make it sound:
//  * the counter is decremented as reads are EMITTED, so the decision never
//    depends on textual order matching evaluation order (the backend reorders
//    operands freely, though only for non-reference types today);
//  * a read inside a loop the declaration sits outside of runs many times
//    against one initialisation, so any such read disqualifies the slot;
//  * everything else errs safe. A read scanned but never emitted (a branch the
//    backend replaced with a vector kernel), or emitted but never scanned,
//    only leaves the counter above zero, and no move happens.
// Borrowed reads still decrement but never move: the slot keeps its count and
// the exit drop releases it, which is already optimal.
var g_reads: [int] = []     // reads of each local the body contains
var g_left: [int] = []      // ... still to be emitted
var g_movable: [bool] = []  // no read sits in a loop the declaration is outside of
var g_decld: [int] = []     // loop depth of the declaration, -1 if never seen

fn mv_scan(e: Node, depth: int) {
    if e.k == N_ID {
        if e.aux == ID_LOCAL and e.slot < g_reads.len() and is_ref(e.ty) {
            g_reads[e.slot] += 1
            if g_decld[e.slot] != depth { g_movable[e.slot] = false }
        }
        return
    }
    if e.k == N_FNLIT {                     // only the captures run in this frame
        var ci = 3
        while ci < e.kids.len() {
            mv_scan(e.kids[ci], depth)
            ci += 1
        }
        return
    }
    if e.k == N_DECL and e.aux == ID_LOCAL and e.slot < g_decld.len() {
        // a borrowed temporary holds no count of its own, so it has none to give
        if inl_borrow_decl(e) { g_decld[e.slot] = 0 - 2 } else { g_decld[e.slot] = depth }
    }
    if e.k == N_INLINE and e.slot < g_decld.len() { g_decld[e.slot] = depth }
    if e.k == N_WHILE {
        mv_scan(e.kids[0], depth)
        mv_scan(e.kids[1], depth + 1)
        return
    }
    if e.k == N_FORR {
        mv_scan(e.kids[0], depth)
        mv_scan(e.kids[1], depth)
        mv_scan(e.kids[2], depth + 1)
        return
    }
    if e.k == N_FORIN {
        mv_scan(e.kids[0], depth)           // the list expression runs once, outside
        // the element variable is stored afresh on every iteration, so as far as
        // ownership goes it is declared inside the body
        if e.slot < g_decld.len() { g_decld[e.slot] = depth + 1 }
        mv_scan(e.kids[1], depth + 1)
        return
    }
    for c in e.kids { mv_scan(c, depth) }
}

fn mv_reset(nslots: int, stmts: [Node]) {
    iclear(g_reads)
    iclear(g_left)
    iclear(g_decld)
    bclear(g_movable)
    for i in 0..nslots {
        g_reads.push(0)
        g_decld.push(0 - 1)
        g_movable.push(true)
    }
    for s in stmts { mv_scan(s, 0) }
    for i in 0..nslots { g_left.push(g_reads[i]) }
}

// account for one emitted read; true when it was the last one and may move
fn mv_use(slot: int) -> bool {
    if slot >= g_left.len() { return false }
    if g_left[slot] <= 0 { return false }      // emitted more than scanned: never move
    g_left[slot] -= 1
    return g_left[slot] == 0 and g_movable[slot]
}

fn mark_ref_slots(e: Node) {
    if e.k == N_DECL and e.aux == ID_LOCAL {
        if is_ref(e.ty) and not inl_borrow_decl(e) { g_refslot[e.slot] = true }
    } else if e.k == N_FORIN {
        if is_ref(ty_el[e.kids[0].ty]) { g_refslot[e.slot] = true }
        g_refslot[e.aux] = true
    } else if e.k == N_INLINE {
        if is_ref(e.ty) { g_refslot[e.slot] = true }
    } else if e.k == N_FNLIT {                 // only the captures run in this frame
        var ci = 3
        while ci < e.kids.len() {
            mark_ref_slots(e.kids[ci])
            ci += 1
        }
        return
    }
    for c in e.kids { mark_ref_slots(c) }
}

fn addr_is_mem(a: str) -> bool { return a.byte(0) == 91 }   // '['

// increment a slot in place, whether it lives in memory or a register
fn inc_slot(a: str) {
    if addr_is_mem(a) { o("inc qword ptr " + a) }
    else { o("add " + a + ", 1") }
}

// store xmm0 to a slot, whether it lives in memory or a (promoted) register
fn store_float_slot(a: str) {
    if addr_is_mem(a) { o("movsd " + a + ", xmm0") }
    else { o("movq " + a + ", xmm0") }
}

// `x = <expr>` where x lives in a promoted xmm register: build the value in
// that register instead of in xmm0 followed by a movapd. Returns false when
// the expression shape isn't covered (nothing emitted).
fn gen_store_float_direct(kind: int, idx: int, v: Node) -> bool {
    let fr = float_reg(kind, idx)
    if fr == "" { return false }
    if has_call(v) { return false }        // a call would clobber a volatile temp
    gen_fexpr_into(v, fr)
    return true
}

// store xmm0 to a float local/param, honoring xmm promotion
fn store_float(kind: int, idx: int) {
    let fr = float_reg(kind, idx)
    if fr != "" {
        o("movapd " + fr + ", xmm0")
        return
    }
    store_float_slot(slot_addr(kind, idx))
}

// ints/bools/enums promote to GPRs. (Pointer kinds are excluded for GC
// visibility -- the conservative collector scans the stack, not registers.)
fn promo_safe_kind(k: int) -> bool {
    return k == K_INT or k == K_BOOL or k == K_ENUM
}

// weighted reference count of locals/params; loop bodies count x8 (capped).
// Float refs go into a separate tally for xmm promotion.
fn count_refs(e: Node, w0: int) {
    var w = w0
    if e.k == N_ID {
        if e.aux == ID_LOCAL and e.slot < g_lcount.len() {
            if promo_safe_kind(ty_kind[e.ty]) { g_lcount[e.slot] += w }
            else if ty_kind[e.ty] == K_FLOAT { g_lfcount[e.slot] += w }
            else { g_lbad[e.slot] = true }
        } else if e.aux == ID_PARAM and e.slot < g_pcount.len() {
            if promo_safe_kind(ty_kind[e.ty]) { g_pcount[e.slot] += w }
            else if ty_kind[e.ty] == K_FLOAT { g_pfcount[e.slot] += w }
            else { g_pbad[e.slot] = true }
        }
        return
    }
    if e.k == N_FNLIT {
        // only the captured-value expressions run in this function; the body
        // is a different function with its own slots
        var ci = 3
        while ci < e.kids.len() {
            count_refs(e.kids[ci], w)
            ci += 1
        }
        return
    }
    if e.k == N_WHILE or e.k == N_FORR or e.k == N_FORIN {
        var bw = w * 8
        if bw > 4096 { bw = 4096 }
        for i in 0..e.kids.len() {
            if i == e.kids.len() - 1 { count_refs(e.kids[i], bw) }
            else { count_refs(e.kids[i], w) }
        }
        return
    }
    for c in e.kids { count_refs(c, w) }
}

// note: monomorphic clears, not clear[T] -- this file stays compilable by the
// C seed, which predates generics
fn sclear(xs: [str]) {
    while xs.len() > 0 { let x = xs.pop() }
}
fn iclear(xs: [int]) {
    while xs.len() > 0 { let x = xs.pop() }
}
fn bclear(xs: [bool]) {
    while xs.len() > 0 { let x = xs.pop() }
}

fn compute_promotions(stmts: [Node], nslots: int, nparams: int) {
    sclear(g_lreg)
    sclear(g_preg)
    sclear(g_lxreg)
    sclear(g_pxreg)
    iclear(g_lcount)
    iclear(g_pcount)
    iclear(g_lfcount)
    iclear(g_pfcount)
    bclear(g_lbad)
    bclear(g_pbad)
    g_npromo = 0
    g_nfpromo = 0
    for i in 0..nslots {
        g_lreg.push("")
        g_lxreg.push("")
        g_lcount.push(0)
        g_lfcount.push(0)
        g_lbad.push(false)
    }
    for i in 0..nparams {
        g_preg.push("")
        g_pxreg.push("")
        g_pcount.push(0)
        g_pfcount.push(0)
        g_pbad.push(false)
    }
    for s in stmts { count_refs(s, 1) }
    // reference slots stay in memory whatever the reads say
    for i in 0..nslots {
        if i < g_refslot.len() and g_refslot[i] { g_lbad[i] = true }
    }
    for i in 0..nparams {
        if i < g_cur_ptypes.len() and is_ref(g_cur_ptypes[i]) { g_pbad[i] = true }
    }
    // A register-convention function receives its arguments in registers, so a
    // param that stays in one costs nothing to set up -- only the callee-saved
    // register's save/restore. Promote those on any use at all, rather than
    // waiting for the loop-hot threshold that a stack-convention param needs to
    // repay its prologue load.
    var thresh = 7                       // loop-hot only: a count of 8 means the
                                         // slot is referenced inside a loop body
    if g_next_regcall { thresh = 7 }
    // int/bool/enum locals -> callee-saved GPRs
    var gdone = false
    while g_npromo < 6 and not gdone {
        var best = thresh
        var bl = 0 - 1
        var bp = 0 - 1
        for i in 0..nslots {
            if g_lreg[i] == "" and not g_lbad[i] and g_lcount[i] > best {
                best = g_lcount[i]
                bl = i
                bp = 0 - 1
            }
        }
        for i in 0..nparams {
            if g_preg[i] == "" and not g_pbad[i] and g_pcount[i] > best {
                best = g_pcount[i]
                bp = i
                bl = 0 - 1
            }
        }
        if bl < 0 and bp < 0 { gdone = true }
        else {
            if bl >= 0 { g_lreg[bl] = PROMO_REGS[g_npromo] }
            else { g_preg[bp] = PROMO_REGS[g_npromo] }
            g_npromo += 1
        }
    }
    // hot float locals -> callee-saved xmm registers
    var fdone = false
    while g_nfpromo < 6 and not fdone {
        var best = 7
        var bl = 0 - 1
        var bp = 0 - 1
        for i in 0..nslots {
            if g_lxreg[i] == "" and g_lfcount[i] > best {
                best = g_lfcount[i]
                bl = i
                bp = 0 - 1
            }
        }
        for i in 0..nparams {
            if g_pxreg[i] == "" and g_pfcount[i] > best {
                best = g_pfcount[i]
                bp = i
                bl = 0 - 1
            }
        }
        if bl < 0 and bp < 0 { fdone = true }
        else {
            if bl >= 0 { g_lxreg[bl] = FPROMO_REGS[g_nfpromo] }
            else { g_pxreg[bp] = FPROMO_REGS[g_nfpromo] }
            g_nfpromo += 1
        }
    }
}

// xmm register a promoted float local/param lives in, or "" if in memory
fn float_reg(kind: int, idx: int) -> str {
    if kind == ID_LOCAL {
        if idx < g_lxreg.len() { return g_lxreg[idx] }
    } else if kind == ID_PARAM {
        if idx < g_pxreg.len() { return g_pxreg[idx] }
    }
    return ""
}

// ---- inliner ----
// Expands calls to small user functions in place, after checking and before
// codegen. A call is hoisted out of an expression into `param decls +
// N_INLINE stmts + result temp` only along a pure evaluation prefix, so the
// observable order of side effects is preserved.
var g_inl_fi = 0 - 1        // g_fns index whose slots we allocate from (-1 = top level)
var g_hoisted: [Node] = []
var g_inlend: [int] = []    // codegen: label stack for nested N_INLINE ends

fn node_count(n: Node) -> int {
    var c = 1
    for k in n.kids { c += node_count(k) }
    return c
}

fn inl_slots(n: int) -> int {
    if g_inl_fi < 0 {
        let b = g_top_nslots
        g_top_nslots += n
        return b
    }
    let f = g_fns[g_inl_fi]
    let b = f.nslots
    f.nslots = f.nslots + n
    return b
}

// no calls, no panics, no side effects anywhere in the tree
fn strict_pure(e: Node) -> bool {
    let k = e.k
    if k == N_INT or k == N_FLOAT or k == N_BOOL or k == N_ID { return true }
    if k == N_NEG or k == N_NOT or k == N_MEMBER { return strict_pure(e.kids[0]) }
    if k == N_CAST {
        if e.aux == C_NOP or e.aux == C_I2F or e.aux == C_TRUNC { return strict_pure(e.kids[0]) }
        return false
    }
    if k == N_BIN {
        if e.op == T_SLASH or e.op == T_PCT { return false }   // may panic
        return strict_pure(e.kids[0]) and strict_pure(e.kids[1])
    }
    return false
}

// deep copy of a pristine body statement with slot remapping:
// params -> fresh locals at pbase, locals shifted by lbase, returns -> N_IRET
fn inl_clone(n: Node, pbase: int, lbase: int, res: int, depth: int) -> Node {
    var c = nnode(n.k, n.line)
    c.op = n.op
    c.name = n.name
    c.ival = n.ival
    c.fval = n.fval
    c.ty = n.ty
    c.slot = n.slot
    c.aux = n.aux
    c.refi = n.refi
    c.mut = n.mut
    for kid in n.kids { c.kids.push(inl_clone(kid, pbase, lbase, res, depth)) }
    if c.k == N_ID {
        if c.aux == ID_PARAM {
            c.aux = ID_LOCAL
            c.slot = pbase + c.slot
        } else if c.aux == ID_LOCAL {
            c.slot += lbase
        }
    } else if c.k == N_DECL {
        if c.aux == ID_LOCAL { c.slot += lbase }
    } else if c.k == N_FORR {
        c.slot += lbase
        c.aux += lbase
    } else if c.k == N_FORIN {
        c.slot += lbase
        c.aux += lbase
        c.op += lbase
    } else if c.k == N_RET {
        c.k = N_IRET
        c.slot = res
    } else if c.k == N_IRET or c.k == N_INLINE {
        c.slot += lbase
    } else if c.k == N_CALL and c.aux == CK_USER {
        c.ival = depth
    }
    return c
}

var g_inl_hits = 0          // expansions in the function being walked this round

fn inlinable_call(e: Node) -> bool {
    if e.k != N_CALL or e.aux != CK_USER or e.ival >= 4 { return false }
    if g_inl_fi >= 0 and g_fns[g_inl_fi].nslots > 600 { return false }   // frame safety valve
    return g_fns[e.refi].prist_ok
}

fn inl_mkdecl(slot: int, val: Node, line: int) {
    var d = nnode(N_DECL, line)
    d.name = "(inlined arg)"
    d.aux = ID_LOCAL
    d.slot = slot
    d.ty = val.ty
    d.kids.push(val)
    g_hoisted.push(d)
}

// expand an inlinable call at parent.kids[i]: hoist param decls + inlined
// body, replace the call with the result temp
fn expand_call(parent: Node, i: int) {
    let call = parent.kids[i]
    let f = g_fns[call.refi]
    let depth = call.ival + 1
    let pbase = inl_slots(f.pnames.len())
    let lbase = inl_slots(f.prist_nslots)
    let res = inl_slots(1)
    var pi = 0
    if call.op == 1 {                       // UFCS receiver is param 0
        let x = try_kid(call.kids[0], 0)
        inl_mkdecl(pbase + pi, call.kids[0].kids[0], call.line)
        pi += 1
    }
    for ai in 1..call.kids.len() {
        let x = try_kid(call, ai)
        inl_mkdecl(pbase + pi, call.kids[ai], call.line)
        pi += 1
    }
    var inl = nnode(N_INLINE, call.line)
    inl.name = f.name
    inl.slot = res
    inl.ty = call.ty
    for st in f.pristine.kids { inl.kids.push(inl_clone(st, pbase, lbase, res, depth)) }
    g_hoisted.push(inl)
    g_inl_hits += 1
    var id = nnode(N_ID, call.line)
    id.aux = ID_LOCAL
    id.slot = res
    id.ty = call.ty
    parent.kids[i] = id
}

// walk parent.kids[i] left-to-right; expand inlinable calls reachable through
// a pure prefix; true if the (rewritten) expression is now strictly pure
fn try_kid(parent: Node, i: int) -> bool {
    let e = parent.kids[i]
    let k = e.k
    if k == N_INT or k == N_FLOAT or k == N_BOOL or k == N_ID { return true }
    if k == N_NEG or k == N_NOT or k == N_MEMBER { return try_kid(e, 0) }
    if k == N_CAST {
        if not try_kid(e, 0) { return false }
        return e.aux == C_NOP or e.aux == C_I2F or e.aux == C_TRUNC
    }
    if k == N_BIN {
        if e.op == T_AND or e.op == T_OR {
            // rhs evaluates conditionally: hands off unless it is already pure
            if not try_kid(e, 0) { return false }
            return strict_pure(e.kids[1])
        }
        if not try_kid(e, 0) { return false }
        if not try_kid(e, 1) { return false }
        return e.op != T_SLASH and e.op != T_PCT
    }
    if k == N_CALL {
        if inlinable_call(e) {
            expand_call(parent, i)
            return true
        }
        return false
    }
    return false
}

fn hoist_stmt(s: Node) {
    let k = s.k
    if k == N_DECL {
        let x = try_kid(s, 0)
        return
    }
    if k == N_ASSIGN {
        // target parts are evaluated before the value; only touch the value
        // when the target cannot observe the reorder
        let t = s.kids[0]
        if t.k == N_ID or (t.k == N_MEMBER and strict_pure(t.kids[0])) {
            let x = try_kid(s, 1)
        }
        return
    }
    if k == N_RET or k == N_IRET {
        if s.kids[0].k != N_NONE { let x = try_kid(s, 0) }
        return
    }
    if k == N_EXPRST {
        let x = try_kid(s, 0)
        return
    }
    if k == N_IF {
        let x = try_kid(s, 0)
        hoist_block(s.kids[1])
        if s.kids[2].k != N_NONE { hoist_block(s.kids[2]) }
        return
    }
    if k == N_WHILE {                       // condition re-evaluates: hands off
        hoist_block(s.kids[1])
        return
    }
    if k == N_FORR {
        if try_kid(s, 0) { let x = try_kid(s, 1) }
        hoist_block(s.kids[2])
        return
    }
    if k == N_FORIN {
        let x = try_kid(s, 0)
        hoist_block(s.kids[1])
        return
    }
    if k == N_INLINE {
        hoist_block(s)
        return
    }
}

fn hoist_block(blk: Node) {
    var out = no_nodes()
    for s in blk.kids {
        let save = g_hoisted
        g_hoisted = no_nodes()
        if s.k != N_FN { hoist_stmt(s) }
        for h in g_hoisted { out.push(h) }
        g_hoisted = save
        out.push(s)
    }
    blk.kids = out
}

// ---- constant globals ----
// A top-level `let` bound to a literal (or to arithmetic over earlier such
// lets) can never change, so every read of it is a compile-time constant.
// Without this each use compiled to a load from the globals block and a
// runtime operation -- `k * CAP + s` with `let CAP = 40` became a memory load
// plus an imul. Folding them lets the existing immediate/strength-reduction
// paths see the actual values.
var g_cf_slot: [int] = []
var g_cf_k: [int] = []           // N_INT / N_FLOAT / N_BOOL
var g_cf_i: [int] = []
var g_cf_f: [float] = []

fn cf_find(slot: int) -> int {
    for i in 0..g_cf_slot.len() {
        if g_cf_slot[i] == slot { return i }
    }
    return 0 - 1
}

// evaluate e to a literal node, or return an N_NONE node meaning "not constant"
fn cf_eval(e: Node) -> Node {
    if e.k == N_INT or e.k == N_FLOAT or e.k == N_BOOL {
        var c = nnode(e.k, e.line)
        c.ival = e.ival
        c.fval = e.fval
        c.ty = e.ty
        return c
    }
    if e.k == N_ID and e.aux == ID_GLOBAL {
        let x = cf_find(e.slot)
        if x >= 0 {
            var c = nnode(g_cf_k[x], e.line)
            c.ival = g_cf_i[x]
            c.fval = g_cf_f[x]
            c.ty = e.ty
            return c
        }
        return nnode(N_NONE, e.line)
    }
    if e.k == N_CAST and e.aux == C_I2F {
        let a = cf_eval(e.kids[0])
        if a.k != N_INT { return nnode(N_NONE, e.line) }
        var c = nnode(N_FLOAT, e.line)
        c.fval = a.ival as float
        c.ty = TI_FLOAT
        return c
    }
    if e.k == N_NEG {
        let a = cf_eval(e.kids[0])
        if a.k == N_INT {
            var c = nnode(N_INT, e.line)
            c.ival = 0 - a.ival
            c.ty = TI_INT
            return c
        }
        if a.k == N_FLOAT {
            var c = nnode(N_FLOAT, e.line)
            c.fval = 0.0 - a.fval
            c.ty = TI_FLOAT
            return c
        }
        return nnode(N_NONE, e.line)
    }
    if e.k == N_BIN {
        let a = cf_eval(e.kids[0])
        let b = cf_eval(e.kids[1])
        if a.k == N_INT and b.k == N_INT {
            var v = 0
            let op = e.op
            if op == T_PLUS { v = a.ival + b.ival }
            else if op == T_MINUS { v = a.ival - b.ival }
            else if op == T_STAR { v = a.ival * b.ival }
            else if op == T_SLASH {
                if b.ival == 0 { return nnode(N_NONE, e.line) }
                v = a.ival / b.ival
            } else if op == T_PCT {
                if b.ival == 0 { return nnode(N_NONE, e.line) }
                v = a.ival % b.ival
            } else { return nnode(N_NONE, e.line) }
            var c = nnode(N_INT, e.line)
            c.ival = v
            c.ty = TI_INT
            return c
        }
        if a.k == N_FLOAT and b.k == N_FLOAT {
            var v = 0.0
            let op = e.op
            if op == T_PLUS { v = a.fval + b.fval }
            else if op == T_MINUS { v = a.fval - b.fval }
            else if op == T_STAR { v = a.fval * b.fval }
            else if op == T_SLASH {
                if b.fval == 0.0 { return nnode(N_NONE, e.line) }
                v = a.fval / b.fval
            } else { return nnode(N_NONE, e.line) }
            var c = nnode(N_FLOAT, e.line)
            c.fval = v
            c.ty = TI_FLOAT
            return c
        }
        return nnode(N_NONE, e.line)
    }
    return nnode(N_NONE, e.line)
}

// rewrite every read of a constant global into its literal
fn cf_subst(e: Node) {
    if e.k == N_ID and e.aux == ID_GLOBAL {
        let x = cf_find(e.slot)
        if x >= 0 {
            e.k = g_cf_k[x]
            e.ival = g_cf_i[x]
            e.fval = g_cf_f[x]
        }
        return
    }
    for i in 0..e.kids.len() { cf_subst(e.kids[i]) }
}

// Fold constant arithmetic in place, bottom-up. Substituting constant globals
// leaves literal-only subtrees behind (`RADIUS * RADIUS` becomes `7.0 * 7.0`),
// and nothing folded those -- the multiply was recomputed every iteration of
// the loop it sat in. Runs over every tree, so literal arithmetic written out
// by hand folds too.
fn cf_fold(e: Node) {
    for i in 0..e.kids.len() { cf_fold(e.kids[i]) }
    if e.k != N_BIN and e.k != N_NEG and e.k != N_CAST { return }
    let v = cf_eval(e)
    if v.k != N_INT and v.k != N_FLOAT and v.k != N_BOOL { return }
    e.k = v.k
    e.ival = v.ival
    e.fval = v.fval
    e.op = 0
    e.aux = 0
    nclear(e.kids)
}

fn cf_fold_all(prog: Node) {
    for i in 0..prog.kids.len() {
        let s = prog.kids[i]
        if s.k != N_FN { cf_fold(s) }
    }
    for i in 0..g_fns.len() {
        let f = g_fns[i]
        if f.body.k != N_NONE { cf_fold(f.body) }
    }
}

fn fold_globals(prog: Node) {
    // pass 1: collect, in order, so a later const can be defined from earlier ones
    for i in 0..prog.kids.len() {
        let s = prog.kids[i]
        if s.k == N_DECL and s.aux == ID_GLOBAL and not s.mut and s.kids.len() > 0 {
            if s.ty == TI_INT or s.ty == TI_FLOAT or s.ty == TI_BOOL {
                let v = cf_eval(s.kids[0])
                if v.k == N_INT or v.k == N_FLOAT or v.k == N_BOOL {
                    g_cf_slot.push(s.slot)
                    g_cf_k.push(v.k)
                    g_cf_i.push(v.ival)
                    g_cf_f.push(v.fval)
                }
            }
        }
    }
    // pass 2: substitute everywhere (the decls themselves keep their
    // initializers, so the globals block still holds the same values)
    if g_cf_slot.len() > 0 {
        for i in 0..prog.kids.len() {
            let s = prog.kids[i]
            if s.k == N_FN { cf_subst(s) }
            else if s.k == N_DECL {
                for j in 0..s.kids.len() { cf_subst(s.kids[j]) }
            } else { cf_subst(s) }
        }
        for i in 0..g_fns.len() {
            let f = g_fns[i]
            if f.body.k != N_NONE { cf_subst(f.body) }
        }
    }
    // pass 3: fold the literal arithmetic those substitutions exposed
    cf_fold_all(prog)
}

fn inline_pass(prog: Node) {
    // capture pristine bodies before anything gets rewritten. Closures are
    // excluded (only ever called indirectly); generic templates too (their
    // instantiations are ordinary FDefs and do participate).
    for i in 0..g_fns.len() {
        let f = g_fns[i]
        if not f.has_env and f.tparams.len() == 0 and node_count(f.body) <= 128 {
            f.pristine = clone_node(f.body)
            f.prist_ok = true
            f.prist_nslots = f.nslots
        }
    }
    // NOTE: top-level statements are NOT hoisted -- inserting statements into
    // prog.kids would shift the g_rt_top boundary where rt_set_globals is
    // emitted (the GC-root registration point). Function bodies only.
    // Dirty tracking: a function is only re-walked while it keeps expanding;
    // round 1 does the bulk, later rounds touch only the recursive chains.
    var dirty: [bool] = []
    for i in 0..g_fns.len() { dirty.push(true) }
    for round in 0..4 {
        for i in 0..g_fns.len() {
            let f = g_fns[i]
            if f.tparams.len() == 0 and dirty[i] {
                g_inl_fi = i
                g_inl_hits = 0
                hoist_block(f.body)
                dirty[i] = g_inl_hits > 0
            }
        }
    }
}

// ---- runtime-reciprocal division pass ----
var g_dc_keys: [str] = []
var g_dc_nodes: [Node] = []

fn nclear(xs: [Node]) {
    while xs.len() > 0 { let x = xs.pop() }
}

fn div_mslot(p: int) -> str { return "[rbp - {16 + 8 * (g_div_base + 2 * p)}]" }
fn div_dslot(p: int) -> str { return "[rbp - {16 + 8 * (g_div_base + 2 * p + 1)}]" }

// does this subtree contain any integer div/mod at all? Functions without one
// skip the 4-slot reciprocal scratch area entirely.
fn div_present(e: Node) -> bool {
    if e.k == N_FNLIT { return false }
    if e.k == N_BIN and (e.op == T_SLASH or e.op == T_PCT) and e.aux != BC_FLOAT and e.aux != BC_STR { return true }
    for c in e.kids { if div_present(c) { return true } }
    return false
}

// identity key of an eligible divisor node, "" if not eligible
fn div_key(e: Node, d: Node) -> str {
    if e.aux == BC_FLOAT or e.aux == BC_STR { return "" }
    if d.k == N_INT and d.ival >= 1 { return "c{d.ival}" }
    if d.k == N_ID and (d.aux == ID_LOCAL or d.aux == ID_PARAM) and ty_kind[d.ty] == K_INT {
        return "v{d.aux}_{d.slot}"
    }
    return ""
}

// is the given local/param slot written anywhere in this subtree?
fn div_assigned_in(e: Node, kind: int, slot: int) -> bool {
    if e.k == N_FNLIT { return false }        // closure body is another function
    if e.k == N_ASSIGN {
        let t = e.kids[0]
        if t.k == N_ID and t.aux == kind and t.slot == slot { return true }
    }
    if e.k == N_DECL and e.aux == kind and e.slot == slot { return true }   // slot reuse
    // an inlined call writes its result temp (a local) via the N_INLINE store
    if kind == ID_LOCAL and e.k == N_INLINE and e.slot == slot { return true }
    if kind == ID_LOCAL {
        if e.k == N_FORR and (e.slot == slot or e.aux == slot) { return true }
        if e.k == N_FORIN and (e.slot == slot or e.aux == slot or e.op == slot) { return true }
    }
    for c in e.kids { if div_assigned_in(c, kind, slot) { return true } }
    return false
}

// collect distinct eligible divisors of unmarked div/mod sites in the subtree
fn div_scan(e: Node) {
    if e.k == N_FNLIT { return }
    if e.k == N_BIN and (e.op == T_SLASH or e.op == T_PCT) and e.slot == 0 {
        let key = div_key(e, e.kids[1])
        if key != "" {
            var found = false
            for k in g_dc_keys { if k == key { found = true } }
            if not found {
                g_dc_keys.push(key)
                g_dc_nodes.push(e.kids[1])
            }
        }
    }
    for c in e.kids { div_scan(c) }
}

fn div_mark(e: Node, key: str, pair: int) {
    if e.k == N_FNLIT { return }
    if e.k == N_BIN and (e.op == T_SLASH or e.op == T_PCT) and e.slot == 0 {
        if div_key(e, e.kids[1]) == key { e.slot = pair + 1 }
    }
    for c in e.kids { div_mark(c, key, pair) }
}

// at loop entry: d <= 0 -> M = 0 (sites take the exact idiv path);
// else M = floor((2^64-1)/d) via one unsigned hardware div
fn emit_div_setup(pair: int, dv: Node) {
    let lz = newlabel()
    let ld = newlabel()
    gen_leaf("rax", dv)
    o("test rax, rax")
    o("jle {lbl(lz)}")
    o("mov " + div_dslot(pair) + ", rax")
    o("mov rcx, rax")
    o("xor eax, eax")
    o("sub rax, 1")               // rax = 2^64 - 1
    o("xor edx, edx")
    o("div rcx")
    o("mov " + div_mslot(pair) + ", rax")
    o("jmp {lbl(ld)}")
    olabel(lz)
    o("mov qword ptr " + div_mslot(pair) + ", 0")
    olabel(ld)
}

// ---------------- loop-invariant list bases ----------------
// Reading xs[i] costs three DEPENDENT loads: the list variable, then the
// length at [obj] for the bounds check, then the data pointer at [obj+16].
// Inside a loop where the list can't change, the last two are invariant, so
// hoist them into scratch slots once at loop entry. Each access then becomes
// one independent load of the data pointer plus the element load, which is
// what a C compiler's register-held base does.
//
// "Can't change" means: the variable is not assigned in the loop, and the body
// makes no real call -- a callee could reassign a global, and a push could
// reallocate the data block out from under the cached pointer. Builtins that
// compile to inline instructions (sqrt, len, load/store, abs/min/max) are not
// real calls and don't disqualify the loop. Caching into stack slots rather
// than registers means an unrelated call would be harmless anyway.
let LB_MAX = 6
var g_lb_next = 0
var g_lb_base = 0
var g_lb_keys: [str] = []
var g_lb_nodes: [Node] = []

fn lb_dslot(p: int) -> str { return "[rbp - {16 + 8 * (g_lb_base + 2 * p)}]" }
fn lb_lslot(p: int) -> str { return "[rbp - {16 + 8 * (g_lb_base + 2 * p + 1)}]" }

fn inline_ck(a: int) -> bool {
    if a == CK_SQRT or a == CK_LEN or a == CK_BITS { return true }
    if a == CK_LOAD64 or a == CK_LOAD8 { return true }
    if a == CK_STORE64 or a == CK_STORE32 or a == CK_STORE8 { return true }
    if a == CK_STACKPTR or a == CK_ABS or a == CK_MIN or a == CK_MAX { return true }
    return false
}

// true if the subtree contains anything that could reassign or reallocate a list
fn lb_unsafe(e: Node) -> bool {
    if e.k == N_CALL {
        if not inline_ck(e.aux) { return true }
    }
    if e.k == N_FNLIT { return true }
    for c in e.kids { if lb_unsafe(c) { return true } }
    return false
}

fn lb_scan(e: Node) {
    if e.k == N_INDEX and e.op == 0 and e.kids[0].k == N_ID and ty_kind[e.kids[0].ty] == K_LIST {
        let v = e.kids[0]
        if v.aux == ID_LOCAL or v.aux == ID_GLOBAL or v.aux == ID_PARAM {
            let key = "{v.aux}_{v.slot}"
            var seen = false
            for i in 0..g_lb_keys.len() { if g_lb_keys[i] == key { seen = true } }
            if not seen {
                g_lb_keys.push(key)
                g_lb_nodes.push(v)
            }
        }
    }
    for c in e.kids { lb_scan(c) }
}

fn lb_mark(e: Node, aux: int, slot: int, pair: int) {
    if e.k == N_INDEX and e.op == 0 and e.kids[0].k == N_ID {
        let v = e.kids[0]
        if v.aux == aux and v.slot == slot and ty_kind[v.ty] == K_LIST { e.op = pair + 1 }
    }
    for c in e.kids { lb_mark(c, aux, slot, pair) }
}

fn emit_lb_setup(pair: int, v: Node) {
    gen_leaf("rcx", v)                     // the list object
    o("mov rdx, [rcx]")                    // length
    o("mov " + lb_lslot(pair) + ", rdx")
    o("mov rcx, [rcx + 16]")               // data pointer
    o("mov " + lb_dslot(pair) + ", rcx")
}

// hoist up to (LB_MAX - g_lb_next) list bases for a loop body; returns how many
// were claimed (the caller releases them after the loop)
fn lb_promote_loop(body: Node) -> int {
    if g_lb_next >= LB_MAX { return 0 }
    if lb_unsafe(body) { return 0 }
    sclear(g_lb_keys)
    nclear(g_lb_nodes)
    lb_scan(body)
    var took = 0
    var ci = 0
    while ci < g_lb_keys.len() and g_lb_next < LB_MAX {
        let v = g_lb_nodes[ci]
        if not div_assigned_in(body, v.aux, v.slot) {
            lb_mark(body, v.aux, v.slot, g_lb_next)
            emit_lb_setup(g_lb_next, v)
            g_lb_next += 1
            took += 1
        }
        ci += 1
    }
    return took
}

// does this function contain a loop with an indexed access? (frame reservation)
fn lb_present(e: Node) -> bool {
    if e.k == N_WHILE or e.k == N_FORR or e.k == N_FORIN {
        if has_index(e) { return true }
    }
    for c in e.kids { if lb_present(c) { return true } }
    return false
}
fn has_index(e: Node) -> bool {
    if e.k == N_INDEX { return true }
    for c in e.kids { if has_index(c) { return true } }
    return false
}

// promote up to (2 - g_div_next) invariant divisors for a loop body; returns
// how many pairs were claimed (caller releases them after the loop)
fn div_promote_loop(body: Node) -> int {
    if g_div_next >= 2 { return 0 }
    sclear(g_dc_keys)
    nclear(g_dc_nodes)
    div_scan(body)
    var took = 0
    var ci = 0
    while ci < g_dc_keys.len() and g_div_next < 2 {
        let d = g_dc_nodes[ci]
        var ok = true
        if d.k == N_ID { ok = not div_assigned_in(body, d.aux, d.slot) }
        if ok {
            div_mark(body, g_dc_keys[ci], g_div_next)
            emit_div_setup(g_div_next, d)
            g_div_next += 1
            took += 1
        }
        ci += 1
    }
    return took
}

// q0 = mulhi(n, M) is q or q-1 for any n >= 0 (signed => n < 2^63); one
// conditional fixup makes it exact. n < 0 or M == 0 -> the ordinary idiv path.
fn gen_div_fast(e: Node) {
    let p = e.slot - 1
    let slow = newlabel()
    let qok = newlabel()
    let end = newlabel()
    // The remainder needs a scratch register. It MUST come from the temp
    // allocator: this used to be a hardcoded r10, which is one of TMP_REGS, so
    // a division nested inside an expression that had already parked a value
    // there silently destroyed it (`(i+2) + ((i/d) + ((i%d) + (i*3)))` lost the
    // i*3 term). With none free, take the exact idiv path instead.
    let sv = scratch_take()
    if sv == "" {
        gen_int_operands(e.kids[0], e.kids[1])
        let ok0 = newlabel()
        o("test rcx, rcx")
        o("jne {lbl(ok0)}")
        if e.op == T_SLASH { rcall("rt_div_zero") }
        else { rcall("rt_mod_zero") }
        olabel(ok0)
        o("cqo")
        o("idiv rcx")
        if e.op == T_PCT { o("mov rax, rdx") }
        return
    }
    gen_expr(e.kids[0])           // n -> rax
    o("mov rcx, " + div_mslot(p))
    o("test rcx, rcx")
    o("je {lbl(slow)}")
    o("test rax, rax")
    o("js {lbl(slow)}")
    o("mov " + sv + ", rax")      // save n
    o("mul rcx")                  // rdx = mulhi(n, M)
    o("mov rax, rdx")             // q0
    o("mov rcx, " + div_dslot(p))
    o("mov rdx, rax")
    o("imul rdx, rcx")            // q0 * d
    o("sub " + sv + ", rdx")      // r = n - q0*d
    o("cmp " + sv + ", rcx")
    o("jb {lbl(qok)}")
    o("add rax, 1")               // estimate was one short
    o("sub " + sv + ", rcx")
    olabel(qok)
    if e.op == T_PCT { o("mov rax, " + sv) }
    scratch_free(sv)
    o("jmp {lbl(end)}")
    olabel(slow)
    gen_leaf("rcx", e.kids[1])    // divisor is a leaf by construction
    let ok = newlabel()
    o("test rcx, rcx")
    o("jne {lbl(ok)}")
    if e.op == T_SLASH { rcall("rt_div_zero") }
    else { rcall("rt_mod_zero") }
    olabel(ok)
    o("cqo")
    o("idiv rcx")
    if e.op == T_PCT { o("mov rax, rdx") }
    olabel(end)
}

// Bounds checks are everywhere, and the failure path is straight-line code
// that never runs -- but inline it still costs fetch/decode bandwidth in the
// hot loop it sits in (7 instructions per access). Emit only the branch here
// and park the panic sequence at the end of the function, where it costs
// nothing. rt_bounds_fail never returns, so nothing jumps back.
var g_cold: [str] = []          // deferred out-of-line blocks for this function

fn gen_bounds_check(listreg: str, idxreg: str) {
    let fail = newlabel()
    o("cmp {idxreg}, [{listreg}]")
    o("jae {lbl(fail)}")
    g_cold.push(".L{fail}:\n")
    if idxreg == "rax" {
        g_cold.push("  mov rdx, [{listreg}]\n")
        g_cold.push("  mov rcx, rax\n")
    } else {
        g_cold.push("  mov r8, [rcx]\n")
        g_cold.push("  mov rcx, {idxreg}\n")
        g_cold.push("  mov rdx, r8\n")
    }
    // the same rsp-alignment dance rcall() emits, spelled out for the cold block
    g_cold.push("  mov r12, rsp\n")
    g_cold.push("  and rsp, -16\n")
    g_cold.push("  sub rsp, 32\n")
    g_cold.push("  call rt_bounds_fail\n")
    g_cold.push("  mov rsp, r12\n")
}

// bounds check against a cached length in a frame slot (hoisted list base)
fn gen_bounds_check_slot(lenslot: str, idxreg: str) {
    let fail = newlabel()
    o("cmp {idxreg}, " + lenslot)
    o("jae {lbl(fail)}")
    g_cold.push(".L{fail}:\n")
    g_cold.push("  mov rdx, " + lenslot + "\n")
    g_cold.push("  mov rcx, {idxreg}\n")
    g_cold.push("  mov r12, rsp\n")
    g_cold.push("  and rsp, -16\n")
    g_cold.push("  sub rsp, 32\n")
    g_cold.push("  call rt_bounds_fail\n")
    g_cold.push("  mov rsp, r12\n")
}

// flush the cold blocks collected while generating one function body
fn flush_cold() {
    for i in 0..g_cold.len() { g_lines.push(g_cold[i]) }
    var e: [str] = []
    g_cold = e
}

fn cc_of(op: int) -> str {
    if op == T_EQEQ { return "e" }
    if op == T_NE { return "ne" }
    if op == T_LT { return "l" }
    if op == T_LE { return "le" }
    if op == T_GT { return "g" }
    return "ge"
}

fn neg_cc(cc: str) -> str {
    if cc == "e" { return "ne" }
    if cc == "ne" { return "e" }
    if cc == "l" { return "ge" }
    if cc == "ge" { return "l" }
    if cc == "le" { return "g" }
    return "le"                    // g -> le
}

// load a float binop's two operands into xmm0 (left) and xmm1 (right) without
// the rax/rcx round-trip and push/pop when an operand is a leaf. Keeps values
// in xmm across the expression instead of shuttling every result through a GPR.
// load a float leaf straight into an xmm register: a variable via movsd from its
// slot (no memory->rax->xmm detour), a literal via rax.
// where a float leaf already lives, as an operand an SSE arithmetic
// instruction can read directly ("" if it must be materialized first)
fn float_operand(e: Node) -> str {
    if e.k == N_FLOAT { return fconst_ref(e.fval) }
    if e.k != N_ID or e.aux == ID_FUNC or e.aux == ID_CAPTURE { return "" }
    if ty_kind[e.ty] != K_FLOAT { return "" }
    let fr = float_reg(e.aux, e.slot)
    if fr != "" { return fr }
    let a = slot_addr(e.aux, e.slot)
    if addr_is_mem(a) { return a }
    return ""
}

fn gen_float_leaf(xreg: str, e: Node) {
    if e.k == N_ID and e.aux != ID_FUNC {
        let fr = float_reg(e.aux, e.slot)
        if fr != "" {
            if fr != xreg { o("movapd {xreg}, " + fr) }   // promoted float local -> xmm
        } else if e.aux == ID_CAPTURE {
            o("mov rax, " + env_addr())
            o("movsd {xreg}, [rax + {8 * e.slot}]")
        } else {
            let a = slot_addr(e.aux, e.slot)
            if addr_is_mem(a) { o("movsd {xreg}, " + a) }
            else { o("movq {xreg}, " + a) }
        }
    } else if e.k == N_FLOAT {
        o("movsd {xreg}, " + fconst_ref(e.fval))
    } else {
        gen_leaf("rax", e)         // float literal (bits) -> rax -> xmm
        o("movq {xreg}, rax")
    }
}
fn gen_float_operands(a: Node, b: Node) {
    if is_leaf(a) and is_leaf(b) {
        gen_float_leaf("xmm0", a)
        gen_float_leaf("xmm1", b)
    } else if is_leaf(b) {
        gen_fexpr(a)               // left -> xmm0
        gen_float_leaf("xmm1", b)
    } else if is_leaf(a) {
        gen_fexpr(b)               // right -> xmm0
        o("movapd xmm1, xmm0")
        gen_float_leaf("xmm0", a)
    } else {
        gen_fexpr(a)               // left -> xmm0
        o("movq rax, xmm0")
        o("push rax")
        gen_fexpr(b)               // right -> xmm0
        o("movapd xmm1, xmm0")
        o("pop rax")
        o("movq xmm0, rax")
    }
}

// does evaluating e emit a call? Such a call may clobber the volatile xmm
// registers we use as the float spill stack, so those subtrees spill to memory.
fn has_call(e: Node) -> bool {
    let k = e.k
    // builtins that compile to inline instructions (sqrt, min/max, abs, len,
    // the load/store intrinsics) touch only xmm0/xmm1, so they do not force a
    // float subtree onto the slow memory-spill path.
    if k == N_CALL and inline_ck(e.aux) {
        for c in e.kids { if has_call(c) { return true } }   // args may still call
        return false
    }
    if k == N_CALL or k == N_STRLIT or k == N_FNLIT or k == N_SOME or k == N_MAPLIT or k == N_LIST or k == N_IBOX { return true }
    if k == N_INLINE or k == N_IRET { return true }   // inlined body may make an FFI call that clobbers xmm
    if k == N_CAST and (e.aux == C_TOSTR or e.aux == C_S2I or e.aux == C_S2F) { return true }
    if k == N_INDEX and ty_kind[e.kids[0].ty] == K_MAP { return true }
    if k == N_BIN and e.aux == BC_STR { return true }
    if is_ref(e.ty) and not borrow_ok(e, true) { return true }   // takes a +1 through rx_dup
    for c in e.kids { if has_call(c) { return true } }
    return false
}

fn is_float_arith(e: Node) -> bool {
    if e.k != N_BIN or e.aux != BC_FLOAT { return false }
    let op = e.op
    return op == T_PLUS or op == T_MINUS or op == T_STAR or op == T_SLASH
}

// float-native evaluator: computes a float expression leaving the result in
// xmm0, keeping intermediates in xmm registers (xmm2.. as a spill stack) instead
// of round-tripping every value through rax and the integer stack.
// Destination-driven float codegen for the simple shapes: build the value in
// the register that will hold it rather than in xmm0 followed by a movapd.
// Returns false when the shape isn't covered, so the caller falls back.
fn fop_emit(op: int, x: str, ro: str) {
    if op == T_PLUS { o("addsd " + x + ", " + ro) }
    else if op == T_MINUS { o("subsd " + x + ", " + ro) }
    else if op == T_STAR { o("mulsd " + x + ", " + ro) }
    else { o("divsd " + x + ", " + ro) }
}

fn gen_fexpr_into(e: Node, x: str) {
    if x != "xmm0" {
        if is_leaf(e) and ty_kind[e.ty] == K_FLOAT {
            gen_float_leaf(x, e)
            return
        }
        // a float list element: the address arithmetic is all in GPRs, so the
        // load can land straight in the destination register
        if e.k == N_INDEX and ty_kind[e.ty] == K_FLOAT and ty_kind[e.kids[0].ty] == K_LIST {
            let ir = gen_index_addr(e)
            o("movsd " + x + ", [rcx + " + ir + "*8]")
            index_fin_keep()           // x is callee-saved or a spill: the drop cannot touch it
            return
        }
        if is_float_arith(e) and not has_call(e) {
            let ro = float_operand(e.kids[1])
            if ro != "" and ro != x {
                gen_fexpr_into(e.kids[0], x)
                fop_emit(e.op, x, ro)
                return
            }
            if ro == "" and 2 + g_fdepth <= 5 {
                let sp = "xmm{2 + g_fdepth}"
                if sp != x {
                    g_fdepth += 1
                    gen_fexpr_into(e.kids[1], sp)   // right into the spill register
                    gen_fexpr_into(e.kids[0], x)    // left into the destination
                    g_fdepth -= 1
                    fop_emit(e.op, x, sp)
                    return
                }
            }
        }
    }
    gen_fexpr(e)
    if x != "xmm0" { o("movapd " + x + ", xmm0") }
}

fn gen_fexpr(e: Node) {
    if e.k == N_FLOAT {
        o("movsd xmm0, " + fconst_ref(e.fval))
        return
    }
    if e.k == N_ID and e.aux != ID_FUNC {
        let fr = float_reg(e.aux, e.slot)
        if fr != "" {
            o("movapd xmm0, " + fr)              // promoted float local
        } else if e.aux == ID_CAPTURE {
            o("mov rax, " + env_addr())
            o("movsd xmm0, [rax + {8 * e.slot}]")
        } else {
            let a = slot_addr(e.aux, e.slot)
            if addr_is_mem(a) { o("movsd xmm0, " + a) }
            else { o("movq xmm0, " + a) }
        }
        return
    }
    if e.k == N_CAST and e.aux == C_I2F {
        gen_expr(e.kids[0])
        o("cvtsi2sd xmm0, rax")
        return
    }
    // a float list element: load it straight into xmm instead of bouncing the
    // bits through rax (mov + movq becomes one movsd)
    if e.k == N_INDEX and ty_kind[e.ty] == K_FLOAT and ty_kind[e.kids[0].ty] == K_LIST {
        let ir = gen_index_addr(e)
        o("movsd xmm0, [rcx + " + ir + "*8]")
        if g_ia_tmp == 2 {                 // releasing the base is a call: bounce through rax
            o("movq rax, xmm0")
            index_fin_keep()
            o("movq xmm0, rax")
        } else {
            index_fin_keep()
        }
        return
    }
    // sqrt is one instruction: keep it in xmm instead of the generic path's
    // movq rax / movq xmm0 round trip on the way in and out
    if e.k == N_CALL and e.aux == CK_SQRT {
        gen_fexpr(e.kids[1])
        o("sqrtsd xmm0, xmm0")
        return
    }
    if is_float_arith(e) {
        let b = e.kids[1]
        // right operand already in an xmm register or a frame slot: let the
        // arithmetic read it in place instead of staging it through xmm1
        let bop = float_operand(b)
        if bop != "" {
            gen_fexpr(e.kids[0])            // left -> xmm0
            if e.op == T_PLUS { o("addsd xmm0, " + bop) }
            else if e.op == T_MINUS { o("subsd xmm0, " + bop) }
            else if e.op == T_STAR { o("mulsd xmm0, " + bop) }
            else { o("divsd xmm0, " + bop) }
            return
        }
        if is_leaf(b) {
            gen_fexpr(e.kids[0])            // left -> xmm0
            gen_float_leaf("xmm1", b)       // right leaf -> xmm1
        } else if 2 + g_fdepth <= 5 and not has_call(b) and not has_call(e.kids[0]) {
            // Both sides are call-free, so evaluate the RIGHT one first and park
            // it in the spill register: the left then lands in xmm0 last and the
            // arithmetic reads the spill in place. One movapd instead of three,
            // and it works for the non-commutative operators too.
            let sp = 2 + g_fdepth
            g_fdepth += 1
            gen_fexpr_into(b, "xmm{sp}")    // right into the spill register
            gen_fexpr(e.kids[0])            // left -> xmm0
            g_fdepth -= 1
            let ro = "xmm{sp}"
            if e.op == T_PLUS { o("addsd xmm0, " + ro) }
            else if e.op == T_MINUS { o("subsd xmm0, " + ro) }
            else if e.op == T_STAR { o("mulsd xmm0, " + ro) }
            else { o("divsd xmm0, " + ro) }
            return
        } else if 2 + g_fdepth <= 5 and not has_call(b) {   // xmm2-5 spill; xmm6+ reserved for promotion
            let sp = 2 + g_fdepth
            gen_fexpr(e.kids[0])            // left -> xmm0
            o("movapd xmm{sp}, xmm0")        // spill left into a free xmm
            g_fdepth += 1
            gen_fexpr(b)                    // right -> xmm0
            o("movapd xmm1, xmm0")           // right -> xmm1
            g_fdepth -= 1
            o("movapd xmm0, xmm{sp}")        // restore left
        } else {
            gen_fexpr(e.kids[0])            // left -> xmm0
            o("movq rax, xmm0")
            o("push rax")                   // spill via memory (right may call)
            gen_fexpr(b)                    // right -> xmm0
            o("movapd xmm1, xmm0")
            o("pop rax")
            o("movq xmm0, rax")
        }
        if e.op == T_PLUS { o("addsd xmm0, xmm1") }
        else if e.op == T_MINUS { o("subsd xmm0, xmm1") }
        else if e.op == T_STAR { o("mulsd xmm0, xmm1") }
        else { o("divsd xmm0, xmm1") }
        return
    }
    // any other float-producing node: evaluate generically (result in rax) and
    // move it into xmm0.
    gen_expr(e)
    o("movq xmm0, rax")
}

fn gen_binop(e: Node) {
    let op = e.op
    if op == T_AND or op == T_OR {
        let skip = newlabel()
        let end = newlabel()
        gen_expr(e.kids[0])
        o("test rax, rax")
        if op == T_AND { o("je {lbl(skip)}") }
        else { o("jne {lbl(skip)}") }
        gen_expr(e.kids[1])
        o("jmp {lbl(end)}")
        olabel(skip)
        if op == T_AND { o("xor eax, eax") }
        else { o("mov eax, 1") }
        olabel(end)
        return
    }
    let cat = e.aux
    // div/mod site with a loop-invariant divisor promoted at loop entry
    if (op == T_SLASH or op == T_PCT) and e.slot > 0 {
        gen_div_fast(e)
        return
    }
    // whole subtree is an addressing mode: one lea instead of shift/mov/add
    if op == T_PLUS {
        let m = mem_operand(e)
        if m != "" {
            o("lea rax, " + m)
            return
        }
    }
    // integer immediate fast path: fold a small literal right operand into the
    // instruction instead of materializing it in rcx.
    if cat != BC_STR and cat != BC_FLOAT and is_imm32(e.kids[1]) {
        let v = e.kids[1].ival
        var alu = ""
        if op == T_PLUS { alu = "add" }
        else if op == T_MINUS { alu = "sub" }
        else if op == T_AMP { alu = "and" }
        else if op == T_PIPE { alu = "or" }
        else if op == T_CARET { alu = "xor" }
        if alu != "" {
            gen_expr(e.kids[0])
            o("{alu} rax, {v}")
            return
        }
        if op == T_SHL or op == T_SHR {
            if v >= 0 and v <= 63 {
                gen_expr(e.kids[0])
                if op == T_SHL { o("shl rax, {v}") }
                else { o("sar rax, {v}") }
                return
            }
        }
        if op == T_STAR {
            // register-resident left operand: multiply straight out of it, no
            // `mov rax, reg` first. lea covers *2/*3/*5/*9 in one cycle.
            let lr = leaf_reg(e.kids[0])
            if lr != "" and v != 0 and v != 1 {
                if v == 2 or v == 3 or v == 5 or v == 9 {
                    o("lea rax, [" + lr + " + " + lr + "*{v - 1}]")
                } else {
                    o("imul rax, " + lr + ", {v}")
                }
                return
            }
            gen_expr(e.kids[0])
            if not mul_imm("rax", v) { o("imul rax, rax, {v}") }
            return
        }
        if op == T_EQEQ or op == T_NE or op == T_LT or op == T_LE or op == T_GT or op == T_GE {
            gen_expr(e.kids[0])
            o("cmp rax, {v}")
            o("set{cc_of(op)} al")
            o("movzx eax, al")
            return
        }
    }
    // right operand already in a register or slot: apply it in place. This is
    // what makes index arithmetic like `k * CAP + s` two instructions instead
    // of four (the movs into rax/rcx were pure staging).
    var rhs_at = ""
    if cat != BC_STR and cat != BC_FLOAT { rhs_at = cmp_operand(e.kids[1]) }
    if rhs_at != "" {
        let r = rhs_at
        var alu = ""
        if op == T_PLUS { alu = "add" }
        else if op == T_MINUS { alu = "sub" }
        else if op == T_AMP { alu = "and" }
        else if op == T_PIPE { alu = "or" }
        else if op == T_CARET { alu = "xor" }
        else if op == T_STAR { alu = "imul" }
        if alu != "" {
            gen_expr(e.kids[0])
            o("{alu} rax, " + r)
            return
        }
        if op == T_EQEQ or op == T_NE or op == T_LT or op == T_LE or op == T_GT or op == T_GE {
            gen_expr(e.kids[0])
            o("cmp rax, " + r)
            o("set{cc_of(op)} al")
            o("movzx eax, al")
            return
        }
    }
    // commutative op with a leaf LEFT operand and a complex right one:
    // evaluate the complex side into rax, then apply the leaf directly --
    // no push/pop round-trip.
    if cat != BC_STR and cat != BC_FLOAT and is_leaf(e.kids[0]) and not is_leaf(e.kids[1]) {
        if op == T_PLUS or op == T_STAR or op == T_AMP or op == T_PIPE or op == T_CARET {
            gen_expr(e.kids[1])
            gen_leaf("rcx", e.kids[0])
            if op == T_PLUS { o("add rax, rcx") }
            else if op == T_STAR { o("imul rax, rcx") }
            else if op == T_AMP { o("and rax, rcx") }
            else if op == T_PIPE { o("or rax, rcx") }
            else { o("xor rax, rcx") }
            return
        }
    }
    // everything above is a tuned special case; this is the general one, and
    // where the stack machine used to show. Evaluate in place instead.
    if cat != BC_STR and cat != BC_FLOAT {
        if gen_into_try(e, "rax") { return }
    }
    if cat == BC_STR {                 // both operands are only read
        var owned: [bool] = []
        owned.push(gen_tmp(e.kids[0], not has_call(e.kids[1])))
        o("push rax")
        owned.push(gen_tmp(e.kids[1], true))
        o("push rax")
        o("mov rdx, [rsp]")
        o("mov rcx, [rsp + 8]")
        if op == T_PLUS {
            rcall("rt_str_concat")
        } else if op == T_EQEQ or op == T_NE {
            rcall("rt_str_eq")
            if op == T_NE { o("xor rax, 1") }
        } else {
            rcall("rt_str_cmp")
            o("cmp rax, 0")
            o("set{cc_of(op)} al")
            o("movzx eax, al")
        }
        drop_temps(owned)
        return
    }
    if cat == BC_FLOAT {
        gen_float_operands(e.kids[0], e.kids[1])
    } else {
        gen_int_operands(e.kids[0], e.kids[1])
    }
    if cat == BC_FLOAT {
        if op == T_PLUS { o("addsd xmm0, xmm1") }
        else if op == T_MINUS { o("subsd xmm0, xmm1") }
        else if op == T_STAR { o("mulsd xmm0, xmm1") }
        else if op == T_SLASH { o("divsd xmm0, xmm1") }
        else if op == T_GT {
            o("comisd xmm0, xmm1")
            o("seta al")
            o("movzx eax, al")
            return
        } else if op == T_GE {
            o("comisd xmm0, xmm1")
            o("setae al")
            o("movzx eax, al")
            return
        } else if op == T_LT {
            o("comisd xmm1, xmm0")
            o("seta al")
            o("movzx eax, al")
            return
        } else if op == T_LE {
            o("comisd xmm1, xmm0")
            o("setae al")
            o("movzx eax, al")
            return
        } else if op == T_EQEQ {
            o("ucomisd xmm0, xmm1")
            o("setnp al")
            o("sete cl")
            o("and al, cl")
            o("movzx eax, al")
            return
        } else if op == T_NE {
            o("ucomisd xmm0, xmm1")
            o("setp al")
            o("setne cl")
            o("or al, cl")
            o("movzx eax, al")
            return
        }
        o("movq rax, xmm0")
        return
    }
    // int / bool
    if op == T_PLUS {
        o("add rax, rcx")
        return
    }
    if op == T_MINUS {
        o("sub rax, rcx")
        return
    }
    if op == T_STAR {
        o("imul rax, rcx")
        return
    }
    if op == T_AMP {
        o("and rax, rcx")
        return
    }
    if op == T_PIPE {
        o("or rax, rcx")
        return
    }
    if op == T_CARET {
        o("xor rax, rcx")
        return
    }
    if op == T_SHL {
        o("shl rax, cl")
        return
    }
    if op == T_SHR {
        o("sar rax, cl")
        return
    }
    if op == T_SLASH or op == T_PCT {
        let ok = newlabel()
        o("test rcx, rcx")
        o("jne {lbl(ok)}")
        if op == T_SLASH { rcall("rt_div_zero") }
        else { rcall("rt_mod_zero") }
        olabel(ok)
        o("cqo")
        o("idiv rcx")
        if op == T_PCT { o("mov rax, rdx") }
        return
    }
    o("cmp rax, rcx")
    o("set{cc_of(op)} al")
    o("movzx eax, al")
}

fn is_leaf(e: Node) -> bool {
    if e.k == N_ID and e.aux == ID_FUNC { return false }   // allocates a closure cell
    return e.k == N_INT or e.k == N_FLOAT or e.k == N_BOOL or e.k == N_ID
}

// right operand is a non-negative literal fitting in a sign-extended imm32,
// so ALU ops can take it as an immediate instead of loading it into rcx.
fn is_imm32(e: Node) -> bool {
    return e.k == N_INT and e.ival >= 0 and e.ival <= 2147483647
}

// ---- expression temporaries in registers ----
//
// r8-r11 are unused by generated code and volatile, so they can hold expression
// temporaries as long as no call intervenes. One allocator owns them: a busy
// flag per register, taken for the lifetime of a value and released when it is
// consumed. Running out falls back to the stack, so nesting is never a
// correctness question, only a speed one.
let TMP_REGS = ["r8", "r9", "r10", "r11"]
var g_rheld = [false, false, false, false]

fn reg_idx(r: str) -> int {
    for i in 0..TMP_REGS.len() {
        if TMP_REGS[i] == r { return i }
    }
    return 0 - 1
}

fn scratch_take() -> str {
    for i in 0..TMP_REGS.len() {
        if not g_rheld[i] {
            g_rheld[i] = true
            return TMP_REGS[i]
        }
    }
    return ""
}

fn scratch_free(r: str) {
    let i = reg_idx(r)
    if i >= 0 { g_rheld[i] = false }
}

// Nothing here reaches a `call`, so a temporary in a volatile register survives.
// Deliberately a whitelist: string operators, list and map literals, indexing
// and interpolation all reach the runtime even though they are not N_CALL.
fn tmp_safe(e: Node) -> bool {
    if e.k == N_INT or e.k == N_FLOAT or e.k == N_BOOL { return true }
    if e.k == N_ID { return e.aux != ID_FUNC and not is_ref(e.ty) }
    if e.k == N_CALL {
        if e.aux != CK_LOAD64 and e.aux != CK_LOAD8 { return false }
    } else if e.k == N_BIN {
        if e.aux == BC_STR { return false }
    } else if e.k != N_NEG and e.k != N_NOT {
        return false
    }
    for i in 0..e.kids.len() {
        if not tmp_safe(e.kids[i]) { return false }
    }
    return true
}

// load a non-float binop's operands: left -> rax, right -> rcx. Skips the
// push/pop round-trip when the right operand is a leaf (constant/variable).
fn gen_int_operands(a: Node, b: Node) {
    if is_leaf(b) {
        gen_expr(a)
        gen_leaf("rcx", b)
        return
    }
    if tmp_safe(b) {
        let t = scratch_take()
        if t != "" {
            gen_expr(a)
            o("mov {t}, rax")
            gen_expr(b)
            o("mov rcx, rax")
            o("mov rax, {t}")
            scratch_free(t)
            return
        }
    }
    gen_expr(a)
    o("push rax")
    gen_expr(b)
    o("mov rcx, rax")
    o("pop rax")
}

// ---- destination-driven expression codegen ----
//
// gen_expr always produces its result in rax, so once temporaries live in
// registers every operand costs a mov in and a mov out. gen_into evaluates an
// expression straight into the register that will hold it, which is what turns
// `d ^ ((x ^ p) & (d ^ x))` from seven ALU ops plus fourteen movs through rax
// into seven ALU ops and three loads.
//
// Restricted to call-free subtrees (tmp_safe). That is not a tuning choice: a
// held temporary lives in a volatile register, and it also means the fallback
// path below can never run while another value is parked in r8-r11.

// dst = dst * v, for a literal v. Powers of two become a shift; 3, 5 and 9
// become a single lea, which matters because imul is three cycles of latency
// and multiplies by a small constant land on dependency chains.
fn mul_imm(dst: str, v: int) -> bool {
    if v == 1 { return true }
    if v == 0 {
        o("xor {dst}, {dst}")
        return true
    }
    if v == 3 or v == 5 or v == 9 {
        o("lea " + dst + ", [" + dst + " + " + dst + "*{v - 1}]")
        return true
    }
    var sh = 0 - 1
    var p2 = 1
    var b = 0
    while b < 63 {
        if p2 == v { sh = b }
        p2 = p2 * 2
        b += 1
    }
    if sh > 0 {
        o("shl {dst}, {sh}")
        return true
    }
    // v = odd * 2^k with odd in {3,5,9}: one lea plus a shift. `k * 40` (the
    // classic bucket-index multiply) becomes lea+shl instead of a 3-cycle imul.
    var m = v
    var k2 = 0
    while m > 0 and m % 2 == 0 and k2 < 62 {
        m = m / 2
        k2 += 1
    }
    if k2 > 0 and (m == 3 or m == 5 or m == 9) {
        o("lea " + dst + ", [" + dst + " + " + dst + "*{m - 1}]")
        o("shl {dst}, {k2}")
        return true
    }
    return false
}

// the ALU mnemonic for an integer binop, or "" if it has no in-place form
fn alu_of(op: int) -> str {
    if op == T_PLUS { return "add" }
    if op == T_MINUS { return "sub" }
    if op == T_AMP { return "and" }
    if op == T_PIPE { return "or" }
    if op == T_CARET { return "xor" }
    if op == T_STAR { return "imul" }
    return ""
}

fn gen_into(e: Node, dst: str) {
    let di = reg_idx(dst)
    var prev = false
    if di >= 0 {
        prev = g_rheld[di]
        g_rheld[di] = true                  // dst is live for the whole subtree
    }
    let ok = gen_into_try(e, dst)
    if di >= 0 { g_rheld[di] = prev }
    if ok { return }
    gen_expr(e)
    if dst != "rax" { o("mov {dst}, rax") }
}

fn gen_into_try(e: Node, dst: str) -> bool {
    if not tmp_safe(e) { return false }
    if is_leaf(e) {
        gen_leaf(dst, e)
        return true
    }
    if e.k == N_CALL and e.aux == CK_LOAD64 {
        let m = mem_operand(e.kids[1])
        if m == "" { return false }
        o("mov " + dst + ", " + m)
        return true
    }
    if e.k != N_BIN or e.aux == BC_FLOAT or e.aux == BC_STR { return false }
    let op = e.op
    // a whole address subtree collapses into one lea
    if op == T_PLUS {
        let m = mem_operand(e)
        if m != "" {
            o("lea " + dst + ", " + m)
            return true
        }
    }
    let r = e.kids[1]
    if op == T_SHL or op == T_SHR {
        if r.k != N_INT or r.ival < 0 or r.ival > 63 { return false }
        gen_into(e.kids[0], dst)
        if op == T_SHL { o("shl {dst}, {r.ival}") } else { o("sar {dst}, {r.ival}") }
        return true
    }
    let alu = alu_of(op)
    if alu == "" { return false }           // comparisons need setcc on a byte reg
    if is_imm32(r) {
        gen_into(e.kids[0], dst)
        if alu != "imul" {
            o("{alu} {dst}, {r.ival}")
            return true
        }
        if not mul_imm(dst, r.ival) { o("imul {dst}, {dst}, {r.ival}") }
        return true
    }
    let ro = cmp_operand(r)
    if ro != "" and ro != dst {
        // ro == dst would read the value we are about to overwrite: `h = (h>>13) + h`
        // must not become `sar dst,13` then `add dst,dst`. Falls through to a scratch.
        gen_into(e.kids[0], dst)
        o(alu + " " + dst + ", " + ro)
        return true
    }
    // General case: the right operand needs a register of its own. Claim it
    // before emitting anything, so failing here is a clean fallback.
    //
    // The right operand is generated FIRST. dst is not necessarily protected
    // from the sibling's evaluation -- when dst is rax it cannot be, since every
    // fallback path lands there -- so whatever goes to dst has to go last.
    // Swapping the order is sound precisely because tmp_safe means no calls,
    // hence no side effects to reorder.
    let s = scratch_take()
    if s == "" { return false }
    gen_into(r, s)
    gen_into(e.kids[0], dst)
    o(alu + " " + dst + ", " + s)
    scratch_free(s)
    return true
}

// true if e is an integer/bool comparison -- the case we can fuse into a
// cmp+conditional-jump. Float (comisd) and string (call) comparisons are excluded.
fn is_int_relop(e: Node) -> bool {
    if e.k != N_BIN { return false }
    if e.aux == BC_FLOAT or e.aux == BC_STR { return false }
    let op = e.op
    return op == T_EQEQ or op == T_NE or op == T_LT or op == T_LE or op == T_GT or op == T_GE
}

// true if e is an ordered float comparison (<, <=, >, >=) -- fusable to
// comisd + conditional-jump. == / != need parity handling, so are left generic.
fn is_float_relop(e: Node) -> bool {
    if e.k != N_BIN or e.aux != BC_FLOAT { return false }
    let op = e.op
    return op == T_LT or op == T_LE or op == T_GT or op == T_GE
}

// emit a branch to `target` taken when `cond` is false (jfalse) or true.
// For integer comparisons this fuses to cmp + jcc instead of materializing a
// boolean in rax and testing it.
var g_cmp_l = ""
var g_cmp_r = ""
fn cond_ops_ok(cond: Node) -> bool {
    g_cmp_l = cmp_operand(cond.kids[0])
    if g_cmp_l == "" { return false }
    g_cmp_r = cmp_operand(cond.kids[1])
    return g_cmp_r != ""
}

fn gen_cond(cond: Node, target: int, jfalse: bool) {
    // short-circuit and/or lowered directly to branches -- no boolean is ever
    // materialized, so the comparisons inside fuse to cmp/comisd + jcc.
    if cond.k == N_BIN and cond.op == T_AND {
        if jfalse {
            gen_cond(cond.kids[0], target, true)
            gen_cond(cond.kids[1], target, true)
        } else {
            let cont = newlabel()
            gen_cond(cond.kids[0], cont, true)
            gen_cond(cond.kids[1], target, false)
            olabel(cont)
        }
        return
    }
    if cond.k == N_BIN and cond.op == T_OR {
        if jfalse {
            let cont = newlabel()
            gen_cond(cond.kids[0], cont, false)
            gen_cond(cond.kids[1], target, true)
            olabel(cont)
        } else {
            gen_cond(cond.kids[0], target, false)
            gen_cond(cond.kids[1], target, false)
        }
        return
    }
    if is_int_relop(cond) {
        if is_imm32(cond.kids[1]) {
            // compare the left side where it already lives -- a promoted
            // register or its frame slot -- instead of loading it into rax
            // first. `n < 256` on a register local is one instruction.
            let lop = cmp_operand(cond.kids[0])
            if lop != "" {
                o("cmp " + lop + ", {cond.kids[1].ival}")
            } else {
                gen_expr(cond.kids[0])
                o("cmp rax, {cond.kids[1].ival}")
            }
        } else if cond_ops_ok(cond) {
            // both sides already live in a register or a frame slot: compare
            // them where they are instead of staging both through rax/rcx
            let l = g_cmp_l
            let r = g_cmp_r
            if starts_with(l, "[") and starts_with(r, "[") {
                o("mov rax, " + l)             // x86 has no mem,mem compare
                o("cmp rax, " + r)
            } else {
                o("cmp " + l + ", " + r)
            }
        } else if cmp_operand(cond.kids[0]) != "" and not has_call(cond.kids[1]) {
            // left is register- or slot-resident and the right side is a real
            // expression: build the right side in rax and compare against the
            // left where it sits. `gy <= cy + 1` becomes three instructions
            // instead of seven. Safe to evaluate right-first because it makes
            // no call, so nothing can write the left slot meanwhile.
            let lop = cmp_operand(cond.kids[0])
            gen_expr(cond.kids[1])
            o("cmp " + lop + ", rax")
        } else {
            gen_int_operands(cond.kids[0], cond.kids[1])
            o("cmp rax, rcx")
        }
        var cc = cc_of(cond.op)
        if jfalse { cc = neg_cc(cc) }
        o("j{cc} {lbl(target)}")
        return
    }
    if is_float_relop(cond) {
        let op = cond.op
        // pick comisd order + cc so "cc taken" means the comparison is true.
        // The operand that must come SECOND can be read from memory (a .rdata
        // constant or a frame slot) instead of being staged into xmm1.
        var cc = "a"
        if op == T_GE or op == T_LE { cc = "ae" }
        var done = false
        if op == T_GT or op == T_GE {
            let ro = float_operand(cond.kids[1])
            if ro != "" {
                gen_fexpr(cond.kids[0])                  // left -> xmm0
                o("comisd xmm0, " + ro)                  // left vs right
                done = true
            }
        } else {
            let lo = float_operand(cond.kids[0])
            if lo != "" and not has_call(cond.kids[1]) {
                gen_fexpr(cond.kids[1])                  // right -> xmm0
                o("comisd xmm0, " + lo)                  // right vs left
                done = true
            }
        }
        if not done {
            gen_float_operands(cond.kids[0], cond.kids[1])   // xmm0 = left, xmm1 = right
            if op == T_GT or op == T_GE {
                o("comisd xmm0, xmm1")                   // left vs right
            } else {
                o("comisd xmm1, xmm0")                   // right vs left
            }
        }
        // negating for jump-when-false: a->be, ae->b. NaN sets CF=ZF=1, which
        // makes the false-branch taken -- correct (an ordered compare is false).
        if jfalse {
            if cc == "a" { cc = "be" } else { cc = "b" }
        }
        o("j{cc} {lbl(target)}")
        return
    }
    gen_expr(cond)
    o("test rax, rax")
    if jfalse { o("je {lbl(target)}") }
    else { o("jne {lbl(target)}") }
}

// a closure's captured values live in the env pointer the caller pushed as the
// deepest argument, at [rbp + 16 + 8*nparams]
fn env_addr() -> str { return "[rbp + {16 + 8 * g_cur_nparams}]" }

// load a leaf expression directly into reg, no push/pop
// address a list element: leaves the data pointer in rcx and the index in rax,
// bounds already checked. Shared by the integer and float element loads.
fn gen_index_addr(e: Node) -> str {
    // if the index is already sitting in a promoted register, address off that
    // register instead of copying it into rax first
    var ir = "rax"
    let iop = cmp_operand(e.kids[1])
    var inreg = false
    if iop != "" {
        if not starts_with(iop, "[") { inreg = true }
    }
    if e.op > 0 {                      // base hoisted out of the enclosing loop
        let p = e.op - 1
        if inreg { ir = iop } else { gen_expr(e.kids[1]) }
        gen_bounds_check_slot(lb_lslot(p), ir)
        o("mov rcx, " + lb_dslot(p))
        g_ia_tmp = 0                   // nothing parked: every caller ends with index_fin_keep
        return ir
    }
    if is_leaf(e.kids[0]) {            // list is a simple var: no stack shuffle
        if inreg { ir = iop } else { gen_expr(e.kids[1]) }
        gen_leaf("rcx", e.kids[0])     // list ptr -> rcx
        g_ia_tmp = 0
    } else {
        // the base stays at [rsp] until the caller's index_fin_keep
        let t = gen_tmp(e.kids[0], not has_call(e.kids[1]))
        o("push rax")
        gen_expr(e.kids[1])
        o("mov rcx, [rsp]")
        g_ia_tmp = 1
        if t { g_ia_tmp = 2 }
    }
    gen_bounds_check("rcx", ir)
    o("mov rcx, [rcx + 16]")
    return ir
}

// operand string for a leaf that already lives somewhere addressable (a
// promoted register or a frame slot), or "" if it must be materialized first.
// Floats promoted to xmm and captured variables need real instructions, so
// they are excluded.
fn cmp_operand(e: Node) -> str {
    if e.k != N_ID { return "" }
    if e.aux == ID_CAPTURE or e.aux == ID_FUNC { return "" }
    if ty_kind[e.ty] != K_INT and ty_kind[e.ty] != K_BOOL and ty_kind[e.ty] != K_ENUM { return "" }
    if float_reg(e.aux, e.slot) != "" { return "" }
    return slot_addr(e.aux, e.slot)
}

// ---- x86 addressing-mode folding ----
//
// `data + r * 8` is four instructions as a stack-machine expression (mov, shl,
// mov, add) and zero as an addressing mode. Recognising the [base + index*scale]
// shape lets the instruction that consumes the address absorb the arithmetic:
// the sort inner loop computes three such addresses per iteration.

// the register a leaf lives in, or "" if it isn't an int local held in one
fn leaf_reg(e: Node) -> str {
    if e.k != N_ID { return "" }
    if e.aux == ID_CAPTURE or e.aux == ID_FUNC { return "" }
    if ty_kind[e.ty] != K_INT and ty_kind[e.ty] != K_BOOL { return "" }
    if float_reg(e.aux, e.slot) != "" { return "" }
    let a = slot_addr(e.aux, e.slot)
    if addr_is_mem(a) { return "" }
    return a
}

// `leaf * K` or `leaf << k` where the factor is a legal SIB scale; else 0
fn scale_of(e: Node) -> int {
    if e.k != N_BIN or e.aux == BC_FLOAT or e.aux == BC_STR { return 0 }
    if e.kids[1].k != N_INT { return 0 }
    let v = e.kids[1].ival
    if e.op == T_STAR {
        if v == 1 or v == 2 or v == 4 or v == 8 { return v }
        return 0
    }
    if e.op == T_SHL {
        if v == 0 { return 1 }
        if v == 1 { return 2 }
        if v == 2 { return 4 }
        if v == 3 { return 8 }
    }
    return 0
}

// "[base + index*scale]" for an address expression, or "" if it doesn't fit.
// Every part must be a register-resident leaf, so building the operand reads no
// memory and has no evaluation order to preserve.
fn mem_operand(e: Node) -> str {
    if e.k != N_BIN or e.op != T_PLUS { return "" }
    if e.aux == BC_FLOAT or e.aux == BC_STR { return "" }
    var basen = e.kids[0]
    var idxn = e.kids[1]
    var sc = scale_of(idxn)
    if sc == 0 {
        // the scaled term may be on either side: r*8 + data is the same address
        sc = scale_of(basen)
        if sc == 0 {
            // unscaled [base + index] still saves the add
            let b0 = leaf_reg(basen)
            let i0 = leaf_reg(idxn)
            if b0 == "" or i0 == "" { return "" }
            return "[" + b0 + " + " + i0 + "]"
        }
        basen = e.kids[1]
        idxn = e.kids[0]
    }
    let br = leaf_reg(basen)
    if br == "" { return "" }
    let ir = leaf_reg(idxn.kids[0])
    if ir == "" { return "" }
    return "[" + br + " + " + ir + "*{sc}]"
}

// A folded store computes its address at the point of the store rather than
// before the value, so the value must not be able to disturb the locals the
// address reads. No calls means no way to reach them.
fn addr_safe_value(e: Node) -> bool {
    if e.k == N_CALL {
        let a = e.aux
        if a != CK_LOAD64 and a != CK_LOAD8 { return false }
    }
    for i in 0..e.kids.len() {
        if not addr_safe_value(e.kids[i]) { return false }
    }
    return true
}

// `x = x OP y` where x lives in a register: do the ALU op in place instead of
// evaluating into rax and storing back. This is every `i += 1` and every
// accumulator update in a loop -- three instructions collapsing to one.
fn try_accum(t: Node, rhs: Node) -> bool {
    if rhs.k != N_BIN or rhs.aux == BC_FLOAT or rhs.aux == BC_STR { return false }
    if float_reg(t.aux, t.slot) != "" { return false }
    let ta = slot_addr(t.aux, t.slot)
    if addr_is_mem(ta) { return false }
    let l = rhs.kids[0]
    if l.k != N_ID or l.aux != t.aux or l.slot != t.slot { return false }
    let op = rhs.op
    let r = rhs.kids[1]
    var alu = ""
    if op == T_PLUS { alu = "add" }
    else if op == T_MINUS { alu = "sub" }
    else if op == T_AMP { alu = "and" }
    else if op == T_PIPE { alu = "or" }
    else if op == T_CARET { alu = "xor" }
    else if op == T_STAR { alu = "imul" }
    if alu != "" {
        if is_imm32(r) and alu != "imul" {           // imul has no two-operand imm form
            o("{alu} {ta}, {r.ival}")
            return true
        }
        let ro = cmp_operand(r)
        if ro != "" {
            o("{alu} " + ta + ", " + ro)
            return true
        }
        // Anything else: evaluate it first, then fold into the target. Reading x
        // inside the operand is fine -- the target is only written afterwards --
        // and every promotion register is callee-saved, so a call in there is
        // harmless too.
        gen_expr(r)
        o("{alu} {ta}, rax")
        return true
    }
    if op == T_SHL or op == T_SHR {
        if r.k == N_INT and r.ival >= 0 and r.ival <= 63 {
            if op == T_SHL { o("shl {ta}, {r.ival}") } else { o("sar {ta}, {r.ival}") }
            return true
        }
    }
    return false
}

// `x = <expr>` where x lives in a register: build the value in that register
// instead of in rax and copying.
//
// The value is allowed to read x. gen_into generates the right operand first at
// every level, so dst is written exactly once, at the leftmost leaf -- which is
// the LAST thing emitted. Every read of the old value has already happened by
// then. The one exception is an `alu dst, dst` fold, guarded in gen_into_try.
fn gen_store_direct(kind: int, slot: int, val: Node) -> bool {
    if float_reg(kind, slot) != "" { return false }
    let ta = slot_addr(kind, slot)
    if addr_is_mem(ta) { return false }
    if not tmp_safe(val) { return false }
    return gen_into_try(val, ta)
}

fn gen_leaf(reg: str, e: Node) {
    if e.k == N_INT { o("movabs {reg}, {e.ival}") }
    else if e.k == N_FLOAT { o("movabs {reg}, {bits(e.fval)}") }
    else if e.k == N_BOOL { o("mov {reg}, {e.ival}") }
    else if e.aux == ID_CAPTURE {
        o("mov {reg}, " + env_addr())
        o("mov {reg}, [{reg} + {8 * e.slot}]")
    }
    else {                                                  // N_ID
        // borrowed, never moved -- but it is still a read, so it counts
        if e.k == N_ID and e.aux == ID_LOCAL and is_ref(e.ty) { let x = mv_use(e.slot) }
        // a float local promoted into an xmm register has no live memory slot;
        // pull its bits straight out of the register
        let fr = float_reg(e.aux, e.slot)
        if fr != "" { o("movq {reg}, " + fr) }
        else {
            let src = slot_addr(e.aux, e.slot)
            // destination-driven codegen asks for `x` into x's own register
            // whenever x is the leftmost leaf of its own assignment
            if src != reg { o("mov {reg}, " + src) }
        }
    }
}

fn gen_call(e: Node) {
    let k = e.aux
    if k == CK_PRINT {
        let t = gen_tmp(e.kids[1], true)
        tmp_hold(t)
        o("mov rcx, rax")
        o("lea rdx, [rip + __td{e.slot}]")
        rcall("rt_print_val")
        tmp_done(t)
        return
    }
    if k == CK_PANIC {
        let t = gen_tmp(e.kids[1], true)       // borrowed; the process does not come back
        o("mov rcx, rax")
        rcall("rt_panic_str")
        return
    }
    if k == CK_SQRT {
        gen_expr(e.kids[1])
        o("movq xmm0, rax")
        o("sqrtsd xmm0, xmm0")
        o("movq rax, xmm0")
        return
    }
    if k == CK_LEN {
        let t = gen_tmp(e.kids[0].kids[0], true)
        tmp_hold(t)
        o("mov rax, [rax]")
        tmp_done_keep(t)
        return
    }
    if k == CK_PUSH {
        let t = gen_tmp(e.kids[0].kids[0], not has_call(e.kids[1]))
        o("push rax")
        gen_expr(e.kids[1])              // owned: the list takes it
        o("mov rdx, rax")
        o("mov rcx, [rsp]")
        rcall("rt_list_push")
        tmp_pop(t)
        return
    }
    if k == CK_POP {
        let t = gen_tmp(e.kids[0].kids[0], true)
        tmp_hold(t)
        o("mov rcx, rax")
        rcall("rt_list_pop")             // ownership moves out of the list
        tmp_done_keep(t)
        return
    }
    if k == CK_ARGS {
        rcall("rt_args")
        return
    }
    if k == CK_ZEROS {          // preallocated [int] of n zeros (rt_list_new zeroes it)
        gen_expr(e.kids[1])
        o("mov rcx, rax")
        rcall("rt_list_new")
        return
    }
    if k == CK_OPT_HAS {
        let t = gen_tmp(e.kids[0].kids[0], true)
        tmp_hold(t)
        o("cmp rax, 0")
        o("setne al")
        o("movzx eax, al")
        tmp_done_keep(t)
        return
    }
    if k == CK_OPT_GET {
        let t = gen_tmp(e.kids[0].kids[0], true)
        tmp_hold(t)
        let ok = newlabel()
        o("cmp rax, 0")
        o("jne {lbl(ok)}")
        let msgi = add_dstr("called .get() on a none value")
        o("lea rcx, [rip + __s{msgi}]")
        rcall("rt_panic_str")
        olabel(ok)
        o("mov rax, [rax]")
        if is_ref(e.ty) { dup_rax() }
        tmp_done_keep(t)
        return
    }
    if k == CK_OPT_OR {
        let t = gen_tmp(e.kids[0].kids[0], true)
        tmp_hold(t)
        let done = newlabel()
        let isnone = newlabel()
        o("cmp rax, 0")
        o("je {lbl(isnone)}")
        o("mov rax, [rax]")
        if is_ref(e.ty) { dup_rax() }
        o("jmp {lbl(done)}")
        olabel(isnone)
        gen_expr(e.kids[1])
        olabel(done)
        tmp_done_keep(t)
        return
    }
    if k == CK_INDIRECT {
        // Call through a {code, env} cell. env is pushed FIRST so it lands deepest,
        // at [rbp + 16 + 8*nparams] â€” past the args. A plain function simply never
        // looks there; a closure reads its captures from it.
        var csafe = true
        for i in 1..e.kids.len() { if has_call(e.kids[i]) { csafe = false } }
        let ct = gen_tmp(e.kids[0], csafe)     // rax = cell
        o("push rax")                          // keep the cell (also a GC root)
        o("mov rax, [rsp]")
        o("mov rax, [rax + 8]")
        o("push rax")                          // env
        var owned: [bool] = []
        var n = 0
        for i in 1..e.kids.len() {
            owned.push(gen_tmp(e.kids[i], false))   // borrowed, like any call
            o("push rax")
            n += 1
        }
        o("mov rax, [rsp + {8 * (n + 1)}]")    // the cell, under args+env
        o("mov rax, [rax]")                    // code pointer
        o("call rax")
        drop_temps(owned)                      // owned args go, then all n pop
        o("add rsp, 8")                        // env
        tmp_pop_keep(ct)                       // drop the cell (rax holds the result)
        return
    }
    if k == CK_IDISPATCH {
        // Virtual call. The interface value is a {vtable, data} cell. Push the
        // data (self) then the args (stack convention, like any user method),
        // then call through the vtable slot. The cell is parked deepest so we
        // can still reach its vtable after the args are pushed.
        var dsafe = true
        for i in 1..e.kids.len() { if has_call(e.kids[i]) { dsafe = false } }
        let ct = gen_tmp(e.kids[0].kids[0], dsafe)   // rax = cell
        o("push rax")                          // cell (deepest; a GC root too)
        o("mov rax, [rax + 8]")                // data = self, borrowed: the cell holds it
        o("push rax")                          // self = arg 0
        var owned: [bool] = []
        owned.push(false)                      // self
        for i in 1..e.kids.len() {
            owned.push(gen_tmp(e.kids[i], false))
            o("push rax")
        }
        let np = e.kids.len()                  // self + args pushed above the cell
        o("mov rax, [rsp + {8 * np}]")         // the cell
        o("mov rax, [rax]")                    // vtable
        o("mov rax, [rax + {8 * e.slot}]")     // method code pointer
        o("call rax")
        drop_temps(owned)                      // owned args go, then self + args pop
        tmp_pop_keep(ct)                       // drop the cell (rax = result)
        return
    }
    if k == CK_RTCALL {         // method -> rt_ call: receiver + args in rcx/rdx/r8/r9; all borrowed
        var owned: [bool] = []
        var n = 0
        for i in 0..e.kids.len() {
            var a = e.kids[i]
            if i == 0 { a = a.kids[0] }
            var safe = true
            for j in (i + 1)..e.kids.len() { if has_call(e.kids[j]) { safe = false } }
            owned.push(gen_tmp(a, safe))
            o("push rax")
            n += 1
        }
        let ar = ["rcx", "rdx", "r8", "r9"]
        for i in 0..n { o("mov " + ar[i] + ", [rsp + {8 * (n - 1 - i)}]") }
        o("call {fn_label(e.name)}")
        drop_temps(owned)
        return
    }
    if k == CK_ABS {
        gen_expr(e.kids[1])
        if ty_kind[e.ty] == K_FLOAT {
            o("movabs rcx, 9223372036854775807")   // clear sign bit
            o("and rax, rcx")
        } else {
            o("mov rcx, rax")                       // branchless int abs
            o("sar rcx, 63")
            o("xor rax, rcx")
            o("sub rax, rcx")
        }
        return
    }
    if k == CK_MIN or k == CK_MAX {
        gen_expr(e.kids[1])
        o("push rax")
        gen_expr(e.kids[2])
        if e.op == 1 {                              // float
            o("movq xmm1, rax")
            o("pop rax")
            o("movq xmm0, rax")
            if k == CK_MIN { o("minsd xmm0, xmm1") } else { o("maxsd xmm0, xmm1") }
            o("movq rax, xmm0")
        } else {                                    // int
            o("mov rcx, rax")
            o("pop rax")
            let done = newlabel()
            o("cmp rax, rcx")
            if k == CK_MIN { o("jle {lbl(done)}") } else { o("jge {lbl(done)}") }
            o("mov rax, rcx")
            olabel(done)
        }
        return
    }
    if k == CK_POW {
        gen_expr(e.kids[1])
        o("push rax")
        gen_expr(e.kids[2])
        o("mov rdx, rax")
        o("pop rcx")
        o("call " + fn_label("rt_ipow"))
        return
    }
    if k == CK_ASSERT {
        gen_expr(e.kids[1])
        let ok = newlabel()
        o("test rax, rax")
        o("jne {lbl(ok)}")
        if e.kids.len() > 2 {
            gen_expr(e.kids[2])
            o("mov rcx, rax")
        } else {
            let msgi = add_dstr("assertion failed")
            o("lea rcx, [rip + __s{msgi}]")
        }
        rcall("rt_panic_str")
        olabel(ok)
        return
    }
    if k == CK_BITS {
        // ponytail: addr()/bits() of an owned temporary is never dropped -- the
        // raw address outlives no one that way. A local costs nothing.
        let t = gen_tmp(e.kids[1], true)
        return
    }
    if k == CK_READF {
        let t = gen_tmp(e.kids[1], true)
        tmp_hold(t)
        o("mov rcx, rax")
        rcall("rt_read_file")
        tmp_done_keep(t)
        return
    }
    if k == CK_WRITEF {
        var owned: [bool] = []
        owned.push(gen_tmp(e.kids[1], not has_call(e.kids[2])))
        o("push rax")
        owned.push(gen_tmp(e.kids[2], true))
        o("push rax")
        o("mov rdx, [rsp]")
        o("mov rcx, [rsp + 8]")
        rcall("rt_write_file")
        drop_temps(owned)
        return
    }
    if k == CK_CHR {
        gen_expr(e.kids[1])
        o("mov rcx, rax")
        rcall("rt_chr")
        return
    }
    if k == CK_EMIT {
        let t = gen_tmp(e.kids[1], true)
        tmp_hold(t)
        o("mov rcx, rax")
        rcall("rt_emit")
        tmp_done(t)
        return
    }
    if k == CK_LOAD64 {
        let m = mem_operand(e.kids[1])
        if m != "" {
            o("mov rax, " + m)
            return
        }
        gen_expr(e.kids[1])
        o("mov rax, [rax]")
        return
    }
    if k == CK_LOAD8 {
        let m = mem_operand(e.kids[1])
        if m != "" {
            o("movzx eax, byte ptr " + m)
            return
        }
        gen_expr(e.kids[1])
        o("movzx eax, byte ptr [rax]")
        return
    }
    if k == CK_STORE64 {
        let m = mem_operand(e.kids[1])
        if m != "" and addr_safe_value(e.kids[2]) {
            let vr = leaf_reg(e.kids[2])
            if vr != "" {                        // register source: no staging at all
                o("mov " + m + ", " + vr)
                return
            }
            gen_expr(e.kids[2])
            o("mov " + m + ", rax")
            return
        }
        gen_expr(e.kids[1])
        o("push rax")
        gen_expr(e.kids[2])
        o("pop rcx")
        o("mov [rcx], rax")
        return
    }
    if k == CK_STORE32 {
        gen_expr(e.kids[1])
        o("push rax")
        gen_expr(e.kids[2])
        o("pop rcx")
        o("mov [rcx], eax")
        return
    }
    if k == CK_STORE8 {
        gen_expr(e.kids[1])
        o("push rax")
        gen_expr(e.kids[2])
        o("pop rcx")
        o("mov [rcx], al")
        return
    }
    if k == CK_STACKPTR {
        o("mov rax, rsp")
        return
    }
    if k == CK_CALLPTR {
        // same Win64 marshalling as CK_WIN, but the target is a value: the
        // address is pushed first (deepest) and called out of r10
        let nargs = e.kids.len() - 2      // kids[0]=callee, kids[1]=target address
        gen_expr(e.kids[1])
        o("push rax")
        for i in 0..nargs {
            gen_expr(e.kids[i + 2])
            o("push rax")
        }
        if nargs > 0 { o("mov rcx, [rsp + {8 * (nargs - 1)}]") }
        if nargs > 1 { o("mov rdx, [rsp + {8 * (nargs - 2)}]") }
        if nargs > 2 { o("mov r8, [rsp + {8 * (nargs - 3)}]") }
        if nargs > 3 { o("mov r9, [rsp + {8 * (nargs - 4)}]") }
        o("mov r10, [rsp + {8 * nargs}]")
        o("mov r12, rsp")
        o("and rsp, -16")
        var pstackargs = 0
        if nargs > 4 { pstackargs = nargs - 4 }
        var pframe = 32 + 8 * pstackargs
        pframe = (pframe + 15) & (0 - 16)
        o("sub rsp, {pframe}")
        var pk = 0
        while pk < pstackargs {
            o("mov rax, [r12 + {8 * (nargs - 5 - pk)}]")
            o("mov [rsp + {32 + 8 * pk}], rax")
            pk += 1
        }
        o("call r10")
        o("mov rsp, r12")
        o("add rsp, {8 * (nargs + 1)}")
        return
    }
    if k == CK_SYSCALL {
        // System V syscall convention: number in rax, args in rdi rsi rdx r10 r8 r9.
        // No shadow space and no alignment requirement -- the kernel doesn't care.
        //
        // rsi and rdi are callee-saved on Windows, which is why PROMO_REGS parks
        // promoted locals in them; here they are argument registers, so they have
        // to be saved around the call. (rcx and r11, which `syscall` itself
        // destroys, are only ever scratch in generated code.)
        let sn = e.kids.len() - 1         // kids[0]=callee, kids[1]=number, kids[2..]=args
        o("push rdi")
        o("push rsi")
        for i in 0..sn {
            gen_expr(e.kids[i + 1])
            o("push rax")
        }
        let SREG = ["rdi", "rsi", "rdx", "r10", "r8", "r9"]
        o("mov rax, [rsp + {8 * (sn - 1)}]")
        for i in 1..sn {
            o("mov {SREG[i - 1]}, [rsp + {8 * (sn - 1 - i)}]")
        }
        o("syscall")
        o("add rsp, {8 * sn}")
        o("pop rsi")
        o("pop rdi")
        return
    }
    if k == CK_WIN {
        let nargs = e.kids.len() - 2      // kids[0]=callee, kids[1]=name literal
        for i in 0..nargs {
            gen_expr(e.kids[i + 2])
            o("push rax")
        }
        if nargs > 0 { o("mov rcx, [rsp + {8 * (nargs - 1)}]") }
        if nargs > 1 { o("mov rdx, [rsp + {8 * (nargs - 2)}]") }
        if nargs > 2 { o("mov r8, [rsp + {8 * (nargs - 3)}]") }
        if nargs > 3 { o("mov r9, [rsp + {8 * (nargs - 4)}]") }
        o("mov r12, rsp")
        o("and rsp, -16")
        var stackargs = 0
        if nargs > 4 { stackargs = nargs - 4 }
        var frame = 32 + 8 * stackargs
        frame = (frame + 15) & (0 - 16)
        o("sub rsp, {frame}")
        var kk = 0
        while kk < stackargs {
            o("mov rax, [r12 + {8 * (nargs - 5 - kk)}]")
            o("mov [rsp + {32 + 8 * kk}], rax")
            kk += 1
        }
        // name may carry a "dll!func" prefix to pick the DLL (default kernel32)
        let wname = e.kids[1].kids[0].name
        var pfx = "__imp_k_"
        var fname = wname
        if starts_with(wname, "user32!") {
            pfx = "__imp_u_"
            fname = wname.sub(7, wname.len())
        } else if starts_with(wname, "gdi32!") {
            pfx = "__imp_g_"
            fname = wname.sub(6, wname.len())
        } else if starts_with(wname, "opengl32!") {
            pfx = "__imp_o_"
            fname = wname.sub(9, wname.len())
        } else if starts_with(wname, "kernel32!") {
            fname = wname.sub(9, wname.len())
        }
        o("call {pfx}{fname}")
        o("mov rsp, r12")
        if nargs > 0 { o("add rsp, {8 * nargs}") }
        return
    }
    if k == CK_BYTE {
        let t = gen_tmp(e.kids[0].kids[0], not has_call(e.kids[1]))
        o("push rax")
        gen_expr(e.kids[1])
        o("mov rcx, [rsp]")
        gen_bounds_check("rcx", "rax")
        o("movzx eax, byte ptr [rcx + rax + 8]")
        tmp_pop_keep(t)
        return
    }
    if k == CK_SUB {
        let t = gen_tmp(e.kids[0].kids[0], not has_call(e.kids[1]) and not has_call(e.kids[2]))
        o("push rax")
        gen_expr(e.kids[1])
        o("push rax")
        gen_expr(e.kids[2])
        o("mov r8, rax")
        o("pop rdx")
        o("mov rcx, [rsp]")
        rcall("rt_str_sub")
        tmp_pop_keep(t)
        return
    }
    if k == CK_JOIN {
        let t = gen_tmp(e.kids[0].kids[0], true)
        tmp_hold(t)
        o("mov rcx, rax")
        rcall("rt_join")
        tmp_done_keep(t)
        return
    }
    // user function (plain or UFCS)
    let f = g_fns[e.refi]
    var cargs: [Node] = []
    if e.op == 1 { cargs.push(e.kids[0].kids[0]) }        // UFCS receiver
    for i in 1..e.kids.len() { cargs.push(e.kids[i]) }
    var ncargs = cargs.len()
    // Arguments are BORROWED (see the ownership contract above is_ref): the
    // callee is handed a reference the caller is already keeping alive, so no
    // count changes hands and the callee drops nothing on the way out. That is
    // sound by induction -- every borrow bottoms out in a caller's local slot
    // or a caller's owned temporary, and a suspended frame cannot release
    // either while the call runs.
    //
    // borrow_ok(a, false) is what decides it. An argument the caller does not
    // already pin -- a fresh allocation, a call result, a global, a container
    // element the callee could remove out from under us -- is materialised as
    // an owned temporary that stays pushed across the call and is dropped
    // after it.
    //
    // Register convention with no stack traffic: every argument after the
    // first is a leaf, so it can be loaded straight into its register after
    // the first one has been evaluated (leaves only read slots and promoted
    // registers, never the argument registers).
    if fn_is_regcall(e.refi) and ncargs > 0 and ncargs <= 4 {
        var tail_simple = borrow_ok(cargs[0], false)
        for i in 1..ncargs {
            if not is_leaf(cargs[i]) or not borrow_ok(cargs[i], false) { tail_simple = false }
        }
        if tail_simple {
            let ar = ["rcx", "rdx", "r8", "r9"]
            let t0 = gen_tmp(cargs[0], false)      // borrowed: no count taken
            var i = ncargs - 1
            while i >= 1 {
                gen_leaf(ar[i], cargs[i])          // borrowed likewise -- gen_leaf never dups
                i -= 1
            }
            o("mov rcx, rax")
            o("call {fn_label(f.label)}")
            return
        }
    }
    var owned: [bool] = []
    for i in 0..ncargs {
        owned.push(gen_tmp(cargs[i], false))
        o("push rax")
    }
    if starts_rt(f.name) or fn_is_regcall(e.refi) {   // register convention
        let ar = ["rcx", "rdx", "r8", "r9"]
        for i in 0..ncargs { o("mov " + ar[i] + ", [rsp + {8 * (ncargs - 1 - i)}]") }
        o("call {fn_label(f.label)}")
    } else {                        // stack convention
        o("call {fn_label(f.label)}")
    }
    drop_temps(owned)               // releases the owned ones, then pops them all
}

fn gen_expr(e: Node) {
    let bor = g_borrow          // set by gen_tmp for this node only
    g_borrow = false
    if e.k == N_INT {
        o("movabs rax, {e.ival}")
        return
    }
    if e.k == N_FLOAT {
        o("movabs rax, {bits(e.fval)}")
        return
    }
    if e.k == N_BOOL {
        o("mov eax, {e.ival}")
        return
    }
    if e.k == N_STRLIT {
        // a lone text part is a constant string -- no building needed
        if e.kids.len() == 1 and e.kids[0].k == N_STRTXT {
            o("lea rax, [rip + __s{add_dstr(e.kids[0].name)}]")
            return
        }
        // Build straight into the runtime's string builder: append each part
        // and materialise ONE string at the end, instead of a chain of
        // rt_str_concat calls that each allocate and copy (O(n^2), n allocs).
        // The accumulator lives in the global sb buffer, so nothing on the heap
        // needs rooting across the part evaluations.
        rcall("rt_sb_begin")             // rax = mark (an sb offset, not a pointer)
        o("push rax")
        for i in 0..e.kids.len() {
            let p = e.kids[i]
            if p.k == N_STRTXT {
                o("lea rcx, [rip + __s{add_dstr(p.name)}]")
                rcall("rt_sb_txt")
            } else {
                let t = gen_tmp(p.kids[0], true)   // value -> rax (may itself build a string; sb nests via marks)
                tmp_hold(t)
                o("mov rcx, rax")
                o("lea rdx, [rip + __td{p.slot}]")
                rcall("rt_sb_val")
                tmp_done(t)
            }
        }
        o("pop rcx")                     // mark
        rcall("rt_sb_end")               // rax = finished string
        return
    }
    if e.k == N_ID {
        if e.aux == ID_FUNC {                    // plain function as a value: {code, 0}
            o("mov rcx, 16")
            rcall("rt_alloc")
            o("lea rdx, [rip + " + fn_label(g_fns[e.refi].label) + "]")
            o("mov [rax], rdx")
            o("mov qword ptr [rax + 8], 0")
            return
        }
        if e.aux == ID_CAPTURE {                 // captured by value into the env
            o("mov rax, " + env_addr())
            o("mov rax, [rax + {8 * e.slot}]")
            if is_ref(e.ty) and not bor { dup_rax() }
            return
        }
        let fr = float_reg(e.aux, e.slot)
        if fr != "" {                            // promoted float: xmm -> rax bits
            o("movq rax, " + fr)
            return
        }
        let sa = slot_addr(e.aux, e.slot)
        o("mov rax, " + sa)
        if is_ref(e.ty) {
            var last = false
            if e.aux == ID_LOCAL { last = mv_use(e.slot) }
            if not bor {
                if last { o("mov qword ptr " + sa + ", 0") }   // moved: the slot gives up its count
                else { dup_rax() }
            }
        }
        return
    }
    if e.k == N_FNLIT {                          // closure: snapshot captures, build {code, env}
        let f = g_fns[e.refi]
        let ncap = e.kids.len() - 3
        var captypes: [int] = []
        for i in 0..ncap { captypes.push(e.kids[3 + i].ty) }
        o("mov rcx, {8 * ncap}")
        o("lea rdx, [rip + __dt{dt_slots(captypes)}]")
        rcall("rt_alloc_d")
        o("push rax")                            // env stays at [rsp] (a GC root)
        for i in 0..ncap {
            gen_expr(e.kids[3 + i])
            o("mov rdx, [rsp]")
            o("mov [rdx + {8 * i}], rax")
        }
        o("mov rcx, 16")
        o(dt_ref())
        rcall("rt_alloc_d")                      // rax = cell
        o("pop rcx")                             // env
        o("mov [rax + 8], rcx")
        o("lea rdx, [rip + " + fn_label(f.label) + "]")
        o("mov [rax], rdx")
        return
    }
    if e.k == N_NONELIT {
        o("xor eax, eax")                  // none is the null pointer
        return
    }
    if e.k == N_SOME {                     // box the value in a 1-word cell
        gen_expr(e.kids[0])
        o("push rax")
        o("mov rcx, 8")
        var boxt: [int] = []
        boxt.push(e.kids[0].ty)
        o("lea rdx, [rip + __dt{dt_slots(boxt)}]")
        rcall("rt_alloc_d")
        o("pop rcx")
        o("mov [rax], rcx")
        return
    }
    if e.k == N_IBOX {                      // interface value: {vtable, data} cell
        gen_expr(e.kids[0])                 // rax = struct pointer (data)
        o("push rax")
        o("mov rcx, 16")
        o(dt_ref())
        rcall("rt_alloc_d")
        o("pop rcx")                        // data
        o("mov [rax + 8], rcx")
        o("lea rdx, [rip + __vt{e.op}]")
        o("mov [rax], rdx")
        return
    }
    if e.k == N_MAPLIT {
        let setfn = map_setfn(e.ty)
        o("mov rcx, {map_keykind(e.ty)}")
        o("lea rdx, [rip + __dt{dt_map(e.ty)}]")
        rcall("rt_map_new_d")
        o("push rax")                      // map stays at [rsp]
        var mi = 0
        while mi < e.kids.len() {
            gen_expr(e.kids[mi])           // key
            o("push rax")
            gen_expr(e.kids[mi + 1])       // value
            o("mov r8, rax")
            o("pop rdx")                   // key
            o("mov rcx, [rsp]")            // map
            rcall(setfn)
            mi += 2
        }
        o("pop rax")
        return
    }
    if e.k == N_LIST {
        o("mov rcx, {e.kids.len()}")
        o("lea rdx, [rip + __dt{dt_list(e.ty)}]")
        rcall("rt_list_new_d")
        o("push rax")
        for i in 0..e.kids.len() {
            gen_expr(e.kids[i])
            o("mov rdx, [rsp]")
            o("mov rdx, [rdx + 16]")
            o("mov [rdx + {8 * i}], rax")
        }
        o("pop rax")
        return
    }
    if e.k == N_SLIT {
        let sd = g_structs[e.refi]
        o("mov rcx, {8 * sd.fnames.len()}")
        o("lea rdx, [rip + __dt{dt_slots(sd.ftypes)}]")
        rcall("rt_alloc_d")
        o("push rax")
        for f in e.kids {
            gen_expr(f.kids[0])
            o("mov rdx, [rsp]")
            o("mov [rdx + {8 * f.slot}], rax")
        }
        o("pop rax")
        return
    }
    if e.k == N_NEG {
        gen_expr(e.kids[0])
        if ty_kind[e.ty] == K_FLOAT {
            o("movabs rcx, {bits(-0.0)}")
            o("xor rax, rcx")
        } else {
            o("neg rax")
        }
        return
    }
    if e.k == N_NOT {
        gen_expr(e.kids[0])
        o("xor rax, 1")
        return
    }
    if e.k == N_BIN {
        if is_float_arith(e) {
            gen_fexpr(e)           // keep the whole float subtree in xmm registers
            o("movq rax, xmm0")    // honor gen_expr's "result in rax" contract
            return
        }
        gen_binop(e)
        return
    }
    if e.k == N_CAST {
        let c = e.aux
        if c == C_TOSTR or c == C_S2I or c == C_S2F {   // the source is only read
            let t = gen_tmp(e.kids[0], true)
            tmp_hold(t)
            o("mov rcx, rax")
            if c == C_TOSTR {
                o("lea rdx, [rip + __td{e.slot}]")
                rcall("rt_to_str")
            } else if c == C_S2I {
                rcall("rt_str_to_int")
            } else {
                rcall("rt_str_to_float")
            }
            tmp_done_keep(t)
            return
        }
        gen_expr(e.kids[0])
        if c == C_I2F {
            o("cvtsi2sd xmm0, rax")
            o("movq rax, xmm0")
        } else if c == C_TRUNC {
            o("movq xmm0, rax")
            o("cvttsd2si rax, xmm0")
        } else if c == C_TOSTR {
            o("mov rcx, rax")
            o("lea rdx, [rip + __td{e.slot}]")
            rcall("rt_to_str")
        } else if c == C_S2I {
            o("mov rcx, rax")
            rcall("rt_str_to_int")
        } else if c == C_S2F {
            o("mov rcx, rax")
            rcall("rt_str_to_float")
        }
        return
    }
    if e.k == N_INDEX {
        if ty_kind[e.kids[0].ty] == K_MAP {
            var owned: [bool] = []
            owned.push(gen_tmp(e.kids[0], not has_call(e.kids[1])))
            o("push rax")
            owned.push(gen_tmp(e.kids[1], true))
            o("push rax")
            o("mov rdx, [rsp]")        // key
            o("mov rcx, [rsp + 8]")    // map
            rcall(map_getfn(e.kids[0].ty))   // hands back its own +1
            drop_temps(owned)
            return
        }
        let ir = gen_index_addr(e)     // data pointer -> rcx, index in ir
        o("mov rax, [rcx + " + ir + "*8]")
        if is_ref(e.ty) and not bor { dup_rax() }
        index_fin_keep()
        return
    }
    if e.k == N_MEMBER {
        let t = gen_tmp(e.kids[0], true)
        tmp_hold(t)
        o("mov rax, [rax + {8 * e.slot}]")
        if is_ref(e.ty) and not bor { dup_rax() }
        tmp_done_keep(t)
        return
    }
    if e.k == N_CALL {
        gen_call(e)
        return
    }
    die(e.line, "internal: cannot generate expression kind {e.k}")
}

// ---------------- AVX2 kernel for the AXPY inner-loop pattern ----------------
// Recognizes  for j in lo..hi { C[iC + j] += S * B[iB + j] }  over i64 lists and
// emits a 4-wide AVX2 kernel (vs Rust's 2-wide SSE2), with a bounds pre-check
// and a scalar remainder loop. Bytes go out as .byte via a 3-byte VEX encoder.
fn abyteN(bs: [int]) {
    var s = ".byte "
    for i in 0..bs.len() {
        if i > 0 { s = s + "," }
        s = s + ((bs[i] & 255) as str)
    }
    o(s)
}
// one AVX2 instruction via 3-byte VEX. map:1=0F,2=0F38. pp:0,1=66,2=F3.
// reg=ModRM.reg (ymm dest or /ext); vvvv=src1 ymm (0 if none); rm is either a
// ymm reg (base<0) or memory [base+disp]. imm>=0 appends an imm8.
fn avx(map: int, pp: int, W: int, opcode: int, reg: int, vvvv: int, rmreg: int, base: int, disp: int, imm: int) {
    var b: [int] = []
    let R = (reg >> 3) & 1
    let mem = base >= 0
    var rmlow = rmreg
    if mem { rmlow = base }
    let B = (rmlow >> 3) & 1
    b.push(196)                                              // 0xC4
    b.push(((R ^ 1) << 7) | (1 << 6) | ((B ^ 1) << 5) | map) // ~X=1
    b.push((W << 7) | ((vvvv ^ 15) << 3) | (1 << 2) | pp)    // L=1 (256-bit)
    b.push(opcode)
    if mem {
        var md = 2
        var dsz = 4
        if disp == 0 and (base & 7) != 5 {
            md = 0
            dsz = 0
        } else if disp >= -128 and disp <= 127 {
            md = 1
            dsz = 1
        }
        let rm = base & 7
        if rm == 4 {
            b.push((md << 6) | ((reg & 7) << 3) | 4)
            b.push((4 << 3) | rm)                            // SIB: no index, base=rm
        } else {
            b.push((md << 6) | ((reg & 7) << 3) | rm)
        }
        if dsz == 1 { b.push(disp & 255) }
        else if dsz == 4 {
            for i in 0..4 { b.push((disp >> (8 * i)) & 255) }
        }
    } else {
        b.push((3 << 6) | ((reg & 7) << 3) | (rmreg & 7))
    }
    if imm >= 0 { b.push(imm & 255) }
    abyteN(b)
}
fn v_load(d: int, base: int, disp: int) { avx(1, 2, 0, 111, d, 0, 0, base, disp, 0 - 1) }   // 0x6F
fn v_store(base: int, disp: int, s: int) { avx(1, 2, 0, 127, s, 0, 0, base, disp, 0 - 1) }  // 0x7F
fn v_muludq(d: int, s1: int, s2: int) { avx(1, 1, 0, 244, d, s1, s2, 0 - 1, 0, 0 - 1) }     // 0xF4
fn v_addq(d: int, s1: int, s2: int) { avx(1, 1, 0, 212, d, s1, s2, 0 - 1, 0, 0 - 1) }       // 0xD4
fn v_srlq(d: int, s: int, imm: int) { avx(1, 1, 0, 115, 2, d, s, 0 - 1, 0, imm) }           // 0x73 /2
fn v_sllq(d: int, s: int, imm: int) { avx(1, 1, 0, 115, 6, d, s, 0 - 1, 0, imm) }           // 0x73 /6
fn v_zeroupper() { abyteN([197, 248, 119]) }                                                // C5 F8 77
fn v_zero(d: int) { avx(1, 1, 0, 239, d, d, d, 0 - 1, 0, 0 - 1) }                            // vpxor d,d,d
fn v_addq_mem(d: int, s1: int, base: int, disp: int) { avx(1, 1, 0, 212, d, s1, 0, base, disp, 0 - 1) }  // vpaddq d,s1,[mem]

fn uses_local(e: Node, slot: int) -> bool {
    if e.k == N_ID and e.aux == ID_LOCAL and e.slot == slot { return true }
    for i in 0..e.kids.len() {
        if uses_local(e.kids[i], slot) { return true }
    }
    return false
}
// idx == INV + j : return which kid is the invariant addend (0 or 1), else -1
fn axpy_inv(idx: Node, jslot: int) -> int {
    if idx.k != N_BIN or idx.op != T_PLUS { return 0 - 1 }
    let a = idx.kids[0]
    let b = idx.kids[1]
    let aj = a.k == N_ID and a.aux == ID_LOCAL and a.slot == jslot
    let bj = b.k == N_ID and b.aux == ID_LOCAL and b.slot == jslot
    if aj and not uses_local(b, jslot) { return 1 }
    if bj and not uses_local(a, jslot) { return 0 }
    return 0 - 1
}
// structural equality (enough to confirm C[iC+j] read == write cell)
fn expr_eq(a: Node, b: Node) -> bool {
    if a.k != b.k { return false }
    if a.k == N_ID { return a.aux == b.aux and a.slot == b.slot }
    if a.k == N_INT { return a.ival == b.ival }
    if a.k == N_MEMBER { return a.slot == b.slot and expr_eq(a.kids[0], b.kids[0]) }
    if a.k == N_BIN {
        return a.op == b.op and expr_eq(a.kids[0], b.kids[0]) and expr_eq(a.kids[1], b.kids[1])
    }
    if a.k == N_INDEX {
        return expr_eq(a.kids[0], b.kids[0]) and expr_eq(a.kids[1], b.kids[1])
    }
    return false
}

// AVX2 fill: for i in lo..hi { L[i] = K }  (K a loop-invariant leaf). Stores 4
// 8 bytes per element via `rep stosq` (ERMSB â€” same path memset uses). Bounds
// pre-check; scalar loop fallback when the range can't be proven in-bounds.
fn try_fill(s: Node, retlabel: int) -> bool {
    let jslot = s.slot
    let body = s.kids[2]
    if body.kids.len() != 1 { return false }
    let asn = body.kids[0]
    if asn.k != N_ASSIGN { return false }
    let tgt = asn.kids[0]
    if tgt.k != N_INDEX or tgt.kids[0].k != N_ID { return false }
    let ix = tgt.kids[1]
    if ix.k != N_ID or ix.aux != ID_LOCAL or ix.slot != jslot { return false }
    let val = asn.kids[1]
    if not is_leaf(val) or uses_local(val, jslot) { return false }
    let L = tgt.kids[0]
    let ja = slot_addr(ID_LOCAL, jslot)
    let scal = newlabel()
    let sloop = newlabel()
    let sdone = newlabel()
    o("sub rsp, 64")
    o("mov [rsp + 40], rdi")             // save nonvolatile rdi
    gen_expr(L)
    o("mov rcx, [rax + 16]")
    o("mov [rsp + 0], rcx")              // dataptr
    o("mov rcx, [rax]")
    o("mov [rsp + 8], rcx")              // len
    gen_expr(s.kids[0])
    o("mov [rsp + 16], rax")             // lo
    gen_expr(s.kids[1])
    o("mov [rsp + 24], rax")             // hi
    gen_leaf("rax", val)
    o("mov [rsp + 32], rax")             // value
    o("mov rax, [rsp + 24]")
    o("mov {ja}, rax")                   // i = hi (exit value)
    o("mov rax, [rsp + 16]")             // pre-check lo>=0
    o("cmp rax, 0")
    o("jl {lbl(scal)}")
    o("mov rax, [rsp + 24]")             // hi>=lo
    o("cmp rax, [rsp + 16]")
    o("jl {lbl(scal)}")
    o("mov rax, [rsp + 24]")             // hi<=len
    o("cmp rax, [rsp + 8]")
    o("jg {lbl(scal)}")
    o("mov rdi, [rsp + 0]")              // rdi = dataptr + lo*8
    o("mov rax, [rsp + 16]")
    o("lea rdi, [rdi + rax*8]")
    o("mov rcx, [rsp + 24]")             // rcx = hi - lo
    o("sub rcx, [rsp + 16]")
    o("mov rax, [rsp + 32]")             // rax = value
    abyteN([243, 72, 171])               // rep stosq
    o("jmp {lbl(sdone)}")
    olabel(scal)                         // scalar fallback (per-element, checked)
    o("mov rax, [rsp + 16]")
    o("mov {ja}, rax")
    olabel(sloop)
    o("mov rax, {ja}")
    o("cmp rax, [rsp + 24]")
    o("jge {lbl(sdone)}")
    gen_block(body, retlabel)
    inc_slot(ja)
    o("jmp {lbl(sloop)}")
    olabel(sdone)
    o("mov rdi, [rsp + 40]")             // restore rdi
    o("add rsp, 64")
    return true
}

// AVX2 index-weighted reduction: for i in lo..hi { acc += L[i] * i }.  gcc/LLVM
// leave this scalar; we do 4-wide (full i64 product) and horizontal-sum at the
// end. Bounds pre-check + scalar remainder.
fn try_reduce(s: Node, retlabel: int) -> bool {
    let jslot = s.slot
    let body = s.kids[2]
    if body.kids.len() != 1 { return false }
    let asn = body.kids[0]
    if asn.k != N_ASSIGN { return false }
    let acc = asn.kids[0]
    if acc.k != N_ID or ty_kind[acc.ty] != K_INT { return false }
    let ex = asn.kids[1]
    if ex.k != N_BIN or ex.op != T_PLUS { return false }
    if not expr_eq(ex.kids[0], acc) { return false }        // acc = acc + (...)
    let mul = ex.kids[1]
    if mul.k != N_BIN or mul.op != T_STAR { return false }
    var idxnode = mul.kids[0]
    var ivar = mul.kids[1]
    if mul.kids[0].k == N_INDEX and mul.kids[1].k == N_ID {
        idxnode = mul.kids[0]
        ivar = mul.kids[1]
    } else if mul.kids[1].k == N_INDEX and mul.kids[0].k == N_ID {
        idxnode = mul.kids[1]
        ivar = mul.kids[0]
    } else {
        return false
    }
    if ivar.aux != ID_LOCAL or ivar.slot != jslot { return false }   // the other factor is i
    if idxnode.kids[0].k != N_ID or ty_kind[idxnode.ty] != K_INT { return false }
    let iix = idxnode.kids[1]
    if iix.k != N_ID or iix.aux != ID_LOCAL or iix.slot != jslot { return false }  // L[i]
    let L = idxnode.kids[0]
    let accaddr = slot_addr(acc.aux, acc.slot)
    let ja = slot_addr(ID_LOCAL, jslot)
    let scal = newlabel()
    let sdone = newlabel()
    let vloop = newlabel()
    let vskip = newlabel()
    o("sub rsp, 128")
    gen_expr(L)
    o("mov rcx, [rax + 16]")
    o("mov [rsp + 64], rcx")             // dataptr
    o("mov rcx, [rax]")
    o("mov [rsp + 72], rcx")             // len
    gen_expr(s.kids[0])
    o("mov [rsp + 80], rax")             // lo
    gen_expr(s.kids[1])
    o("mov [rsp + 88], rax")             // hi
    o("mov rax, [rsp + 88]")
    o("sub rax, [rsp + 80]")
    o("and rax, -4")
    o("mov [rsp + 96], rax")             // bulk
    o("mov rax, [rsp + 80]")
    o("add rax, [rsp + 96]")
    o("mov [rsp + 104], rax")            // vend
    o("mov rax, [rsp + 80]")
    o("mov {ja}, rax")                   // i = lo default
    o("mov rax, [rsp + 96]")
    o("cmp rax, 0")
    o("jle {lbl(vskip)}")
    o("mov rax, [rsp + 80]")
    o("cmp rax, 0")
    o("jl {lbl(vskip)}")
    o("mov rcx, [rsp + 80]")
    o("add rcx, [rsp + 96]")
    o("cmp rcx, [rsp + 72]")
    o("jg {lbl(vskip)}")
    o("mov rax, [rsp + 88]")             // indices fit in 32 bits? (else scalar)
    o("cmp rax, 2147483647")
    o("jg {lbl(vskip)}")
    o("mov qword ptr [rsp + 32], 4")     // fourv = [4,4,4,4]
    o("mov qword ptr [rsp + 40], 4")
    o("mov qword ptr [rsp + 48], 4")
    o("mov qword ptr [rsp + 56], 4")
    o("mov rax, [rsp + 80]")             // idxv = [lo, lo+1, lo+2, lo+3]
    o("mov [rsp + 0], rax")
    o("add rax, 1")
    o("mov [rsp + 8], rax")
    o("add rax, 1")
    o("mov [rsp + 16], rax")
    o("add rax, 1")
    o("mov [rsp + 24], rax")
    o("mov r10, [rsp + 64]")
    o("mov rax, [rsp + 80]")
    o("lea r10, [r10 + rax*8]")          // gridptr = dataptr + lo*8
    o("mov rax, [rsp + 96]")
    o("sar rax, 2")                      // groups
    v_zero(0)                            // accv = 0
    v_load(1, 4, 0)                      // idxv = [rsp+0]
    olabel(vloop)
    v_load(2, 10, 0)                     // gridv = [r10]
    v_muludq(3, 2, 1)                    // grid_lo * idx   (idx fits in 32 bits)
    v_srlq(4, 2, 32)                     // grid_hi
    v_muludq(4, 4, 1)                    // grid_hi * idx
    v_sllq(4, 4, 32)
    v_addq(3, 3, 4)                      // product = grid * idx (low 64)
    v_addq(0, 0, 3)                      // accv += product
    v_addq_mem(1, 1, 4, 32)              // idxv += fourv ([rsp+32])
    o("add r10, 32")
    o("sub rax, 1")
    o("jne {lbl(vloop)}")
    v_store(4, 0, 0)                     // [rsp+0] = accv
    v_zeroupper()
    o("mov rax, [rsp + 0]")              // horizontal sum of 4 lanes
    o("add rax, [rsp + 8]")
    o("add rax, [rsp + 16]")
    o("add rax, [rsp + 24]")
    o("add {accaddr}, rax")
    o("mov rax, [rsp + 104]")
    o("mov {ja}, rax")                   // i = vend
    olabel(vskip)
    olabel(scal)
    o("mov rax, {ja}")
    o("cmp rax, [rsp + 88]")
    o("jge {lbl(sdone)}")
    gen_block(body, retlabel)
    inc_slot(ja)
    o("jmp {lbl(scal)}")
    olabel(sdone)
    o("add rsp, 128")
    return true
}

fn try_axpy(s: Node, retlabel: int) -> bool {
    let jslot = s.slot
    let body = s.kids[2]
    if body.kids.len() != 1 { return false }
    let asn = body.kids[0]
    if asn.k != N_ASSIGN { return false }
    let tgt = asn.kids[0]                                     // C[iC+j]
    if tgt.k != N_INDEX or tgt.kids[0].k != N_ID or ty_kind[tgt.ty] != K_INT { return false }
    let ci = axpy_inv(tgt.kids[1], jslot)
    if ci < 0 { return false }
    let iC = tgt.kids[1].kids[ci]
    let ex = asn.kids[1]                                      // C[iC+j] + (S * B[iB+j])
    if ex.k != N_BIN or ex.op != T_PLUS { return false }
    if not expr_eq(ex.kids[0], tgt) { return false }
    let mul = ex.kids[1]
    if mul.k != N_BIN or mul.op != T_STAR { return false }
    var S = mul.kids[0]
    var Bacc = mul.kids[1]
    if mul.kids[1].k == N_INDEX {
        S = mul.kids[0]
        Bacc = mul.kids[1]
    } else if mul.kids[0].k == N_INDEX {
        S = mul.kids[1]
        Bacc = mul.kids[0]
    } else {
        return false
    }
    if Bacc.kids[0].k != N_ID or ty_kind[Bacc.ty] != K_INT { return false }
    let bi = axpy_inv(Bacc.kids[1], jslot)
    if bi < 0 { return false }
    let iB = Bacc.kids[1].kids[bi]
    if uses_local(S, jslot) { return false }

    let LC = tgt.kids[0]
    let LB = Bacc.kids[0]
    if LC.aux == LB.aux and LC.slot == LB.slot { return false }   // same array: avoid aliasing
    let scal = newlabel()
    let sdone = newlabel()
    let vloop = newlabel()
    let vskip = newlabel()
    let ja = slot_addr(ID_LOCAL, jslot)
    // frame: [rsp+0..31] S broadcast; temps at fixed offsets
    o("sub rsp, 128")
    gen_expr(LC)
    o("mov rcx, [rax + 16]")
    o("mov [rsp + 32], rcx")
    o("mov rcx, [rax]")
    o("mov [rsp + 40], rcx")
    gen_expr(LB)
    o("mov rcx, [rax + 16]")
    o("mov [rsp + 48], rcx")
    o("mov rcx, [rax]")
    o("mov [rsp + 56], rcx")
    gen_expr(iC)
    o("mov [rsp + 64], rax")
    gen_expr(iB)
    o("mov [rsp + 72], rax")
    gen_expr(s.kids[0])
    o("mov [rsp + 80], rax")                                  // lo
    gen_expr(s.kids[1])
    o("mov [rsp + 88], rax")                                  // hi
    gen_expr(S)
    o("mov [rsp + 0], rax")
    o("mov [rsp + 8], rax")
    o("mov [rsp + 16], rax")
    o("mov [rsp + 24], rax")
    o("mov rax, [rsp + 64]")
    o("add rax, [rsp + 80]")
    o("mov [rsp + 96], rax")                                  // startC = iC+lo
    o("mov rax, [rsp + 72]")
    o("add rax, [rsp + 80]")
    o("mov [rsp + 104], rax")                                 // startB = iB+lo
    o("mov rax, [rsp + 88]")
    o("sub rax, [rsp + 80]")
    o("and rax, -4")
    o("mov [rsp + 112], rax")                                 // bulk
    o("mov rax, [rsp + 80]")
    o("add rax, [rsp + 112]")
    o("mov [rsp + 120], rax")                                 // vend = lo+bulk
    o("mov rax, [rsp + 80]")
    o("mov {ja}, rax")                                        // j = lo (scalar default)
    // bounds pre-check; any failure -> scalar loop (which checks per element)
    o("mov rax, [rsp + 112]")
    o("cmp rax, 0")
    o("jle {lbl(vskip)}")
    o("mov rax, [rsp + 96]")
    o("cmp rax, 0")
    o("jl {lbl(vskip)}")
    o("mov rcx, [rsp + 96]")
    o("add rcx, [rsp + 112]")
    o("cmp rcx, [rsp + 40]")
    o("jg {lbl(vskip)}")
    o("mov rax, [rsp + 104]")
    o("cmp rax, 0")
    o("jl {lbl(vskip)}")
    o("mov rcx, [rsp + 104]")
    o("add rcx, [rsp + 112]")
    o("cmp rcx, [rsp + 56]")
    o("jg {lbl(vskip)}")
    // vector kernel: r10=C ptr, r11=B ptr, rax=group count
    o("mov r10, [rsp + 32]")
    o("mov rax, [rsp + 96]")
    o("lea r10, [r10 + rax*8]")
    o("mov r11, [rsp + 48]")
    o("mov rax, [rsp + 104]")
    o("lea r11, [r11 + rax*8]")
    o("mov rax, [rsp + 112]")
    o("sar rax, 2")                                           // groups = bulk/4
    v_load(0, 4, 0)                                           // ymm0 = broadcast S ([rsp])
    v_srlq(5, 0, 32)                                          // ymm5 = S >> 32
    olabel(vloop)
    v_load(1, 11, 0)                                          // ymm1 = B[4] ([r11])
    v_srlq(3, 1, 32)                                          // ymm3 = B >> 32
    v_muludq(2, 0, 1)                                         // Slo*Blo
    v_muludq(4, 0, 3)                                         // Slo*Bhi
    v_muludq(3, 5, 1)                                         // Shi*Blo
    v_addq(4, 4, 3)                                           // cross
    v_sllq(4, 4, 32)
    v_addq(2, 2, 4)                                           // product
    v_load(1, 10, 0)                                          // ymm1 = C[4] ([r10])
    v_addq(1, 1, 2)
    v_store(10, 0, 1)                                         // C[4] = result
    o("add r11, 32")
    o("add r10, 32")
    o("sub rax, 1")
    o("jne {lbl(vloop)}")
    v_zeroupper()
    o("mov rax, [rsp + 120]")
    o("mov {ja}, rax")                                        // j = vend
    olabel(vskip)
    // scalar remainder (or full loop if pre-check failed): while j < hi
    olabel(scal)
    o("mov rax, {ja}")
    o("cmp rax, [rsp + 88]")
    o("jge {lbl(sdone)}")
    gen_block(body, retlabel)
    inc_slot(ja)
    o("jmp {lbl(scal)}")
    olabel(sdone)
    o("add rsp, 128")
    return true
}

fn gen_stmt(s: Node, retlabel: int) {
    // -g: mark the .text position of each main-file statement (skips runtime/std/imports)
    if g_debug and g_cur_user and s.file == g_main_file and s.line > 0 { raw(".zloc {s.line}") }
    if s.k == N_DECL {
        if is_ref(s.ty) and inl_borrow_decl(s) {
            let t = gen_tmp(s.kids[0], false)          // borrowed: nothing to release
            o("mov " + slot_addr(s.aux, s.slot) + ", rax")
        } else if is_ref(s.ty) {
            gen_expr(s.kids[0])
            store_ref(s.aux, s.slot)         // the slot may hold a previous iteration's value
        } else if ty_kind[s.kids[0].ty] == K_FLOAT {
            if not gen_store_float_direct(s.aux, s.slot, s.kids[0]) {
                gen_fexpr(s.kids[0])
                store_float(s.aux, s.slot)
            }
        } else if not gen_store_direct(s.aux, s.slot, s.kids[0]) {
            gen_expr(s.kids[0])
            o("mov " + slot_addr(s.aux, s.slot) + ", rax")
        }
        return
    }
    if s.k == N_ASSIGN {
        let t = s.kids[0]
        if t.k == N_ID {
            if is_ref(t.ty) {
                gen_expr(s.kids[1])
                store_ref(t.aux, t.slot)
            } else if ty_kind[s.kids[1].ty] == K_FLOAT {
                if not gen_store_float_direct(t.aux, t.slot, s.kids[1]) {
                    gen_fexpr(s.kids[1])
                    store_float(t.aux, t.slot)
                }
            } else if not try_accum(t, s.kids[1]) and not gen_store_direct(t.aux, t.slot, s.kids[1]) {
                gen_expr(s.kids[1])
                o("mov " + slot_addr(t.aux, t.slot) + ", rax")
            }
        } else if t.k == N_MEMBER {
            let bt = gen_tmp(t.kids[0], not has_call(s.kids[1]))
            o("push rax")
            gen_expr(s.kids[1])
            if is_ref(t.ty) {
                o("mov rdx, rax")
                o("mov rcx, [rsp]")
                o("add rcx, {8 * t.slot}")
                rcall(fn_label("rx_assign"))
            } else {
                o("mov rcx, [rsp]")
                o("mov [rcx + {8 * t.slot}], rax")
            }
            tmp_pop(bt)
        } else if ty_kind[t.kids[0].ty] == K_MAP {
            let mt = gen_tmp(t.kids[0], not has_call(t.kids[1]) and not has_call(s.kids[1]))
            o("push rax")                    // map
            gen_expr(t.kids[1])              // key (owned: the map takes it)
            o("push rax")
            gen_expr(s.kids[1])              // value (owned: the map takes it)
            o("mov r8, rax")
            o("pop rdx")                     // key
            o("mov rcx, [rsp]")              // map
            rcall(map_setfn(t.kids[0].ty))
            tmp_pop(mt)
        } else {
            if try_index_rmw(t, s.kids[1]) { return }
            var ixr = "rdx"
            // an index already sitting in a promoted register needs no staging
            // at all: those registers are callee-saved, so evaluating the value
            // cannot disturb it. `a[i] = <expr>` loses its push/pop pair.
            let iop = cmp_operand(t.kids[1])
            if iop != "" and not starts_with(iop, "[") { ixr = iop }
            var bt = false
            var pushed = false
            if is_leaf(t.kids[0]) {          // list is a var: load it last, skip its push/pop
                if ixr != "rdx" {
                    gen_expr(s.kids[1])      // value -> rax
                } else {
                    gen_expr(t.kids[1])      // index -> rax
                    if is_leaf(s.kids[1]) and not is_ref(t.ty) {   // a ref leaf needs its +1 (a call)
                        o("mov rdx, rax")        // index -> rdx
                        gen_leaf("rax", s.kids[1]) // value -> rax
                    } else {
                        o("push rax")            // save index
                        gen_expr(s.kids[1])      // value -> rax
                        o("pop rdx")             // index
                    }
                }
                if t.op == 0 { gen_leaf("rcx", t.kids[0]) }   // list -> rcx
            } else {
                bt = gen_tmp(t.kids[0], not has_call(t.kids[1]) and not has_call(s.kids[1]))
                pushed = true
                o("push rax")                // base stays at [rsp] until the store is done
                gen_expr(t.kids[1])
                o("push rax")
                gen_expr(s.kids[1])
                o("pop rdx")
                o("mov rcx, [rsp]")
                ixr = "rdx"
            }
            if t.op > 0 {                       // hoisted base (see lb_promote_loop)
                let p = t.op - 1
                gen_bounds_check_slot(lb_lslot(p), ixr)
                o("mov r8, " + lb_dslot(p))
            } else {
                gen_bounds_check("rcx", ixr)
                o("mov r8, [rcx + 16]")
            }
            if is_ref(t.ty) {
                o("lea rcx, [r8 + " + ixr + "*8]")
                o("mov rdx, rax")
                rcall(fn_label("rx_assign"))
            } else {
                o("mov [r8 + " + ixr + "*8], rax")
            }
            if pushed { tmp_pop(bt) }
        }
        return
    }
    if s.k == N_IF {
        let els = newlabel()
        let end = newlabel()
        gen_cond(s.kids[0], els, true)
        gen_block(s.kids[1], retlabel)
        if s.kids[2].k != N_NONE { o("jmp {lbl(end)}") }
        olabel(els)
        if s.kids[2].k != N_NONE {
            gen_block(s.kids[2], retlabel)
            olabel(end)
        }
        return
    }
    if s.k == N_WHILE {
        let top = newlabel()
        let end = newlabel()
        let ndp = div_promote_loop(s.kids[1])
        let nlb = lb_promote_loop(s.kids[1])
        olabel(top)
        gen_cond(s.kids[0], end, true)
        g_brk.push(end)
        g_cont.push(top)
        gen_block(s.kids[1], retlabel)
        let x1 = g_brk.pop()
        let x2 = g_cont.pop()
        o("jmp {lbl(top)}")
        olabel(end)
        g_div_next -= ndp
        g_lb_next -= nlb
        return
    }
    if s.k == N_FORR {
        if try_fill(s, retlabel) { return }    // AVX2 memset: L[i] = K
        if try_reduce(s, retlabel) { return }  // AVX2 index-weighted reduction: acc += L[i]*i
        if try_axpy(s, retlabel) { return }    // AVX2 fast path for the AXPY idiom
        let top = newlabel()
        let cont = newlabel()
        let end = newlabel()
        let ndp = div_promote_loop(s.kids[2])
        let nlb = lb_promote_loop(s.kids[2])
        let iv = slot_addr(ID_LOCAL, s.slot)     // loop var (may be promoted)
        let hv = slot_addr(ID_LOCAL, s.aux)      // limit (hidden, never promoted)
        gen_expr(s.kids[0])
        o("mov " + iv + ", rax")
        gen_expr(s.kids[1])
        o("mov " + hv + ", rax")
        olabel(top)
        // the limit slot is always memory, so a promoted loop var can be
        // compared where it sits -- one instruction per iteration, every loop
        if addr_is_mem(iv) {
            o("mov rax, " + iv)                // x86 has no mem,mem compare
            o("cmp rax, " + hv)
        } else {
            o("cmp " + iv + ", " + hv)
        }
        o("jge {lbl(end)}")
        g_brk.push(end)
        g_cont.push(cont)
        gen_block(s.kids[2], retlabel)
        let x1 = g_brk.pop()
        let x2 = g_cont.pop()
        olabel(cont)
        inc_slot(iv)
        o("jmp {lbl(top)}")
        olabel(end)
        g_div_next -= ndp
        g_lb_next -= nlb
        return
    }
    if s.k == N_FORIN {
        let top = newlabel()
        let cont = newlabel()
        let end = newlabel()
        let ndp = div_promote_loop(s.kids[1])
        let lv = slot_addr(ID_LOCAL, s.aux)      // list ptr (hidden, stays in memory: GC root)
        let xv = slot_addr(ID_LOCAL, s.op)       // index (hidden, never promoted)
        let ev = slot_addr(ID_LOCAL, s.slot)     // element var (may be promoted)
        let eref = is_ref(ty_el[s.kids[0].ty])
        gen_expr(s.kids[0])
        store_ref(ID_LOCAL, s.aux)               // the hidden slot owns the list for the loop
        o("mov qword ptr " + xv + ", 0")
        olabel(top)
        o("mov rcx, " + lv)
        o("mov rax, " + xv)
        o("cmp rax, [rcx]")
        o("jge {lbl(end)}")
        o("mov rdx, [rcx + 16]")
        o("mov rax, [rdx + rax*8]")
        if eref {
            dup_rax()
            store_ref(ID_LOCAL, s.slot)
        } else {
            o("mov " + ev + ", rax")
        }
        // A float element variable may live in a promoted xmm register, which
        // reads never take from the memory slot -- so publish it there too, or
        // every iteration of `for x in someFloatList` sees 0.
        let efr = float_reg(ID_LOCAL, s.slot)
        if efr != "" { o("movq " + efr + ", rax") }
        g_brk.push(end)
        g_cont.push(cont)
        gen_block(s.kids[1], retlabel)
        let x1 = g_brk.pop()
        let x2 = g_cont.pop()
        olabel(cont)
        inc_slot(xv)
        o("jmp {lbl(top)}")
        olabel(end)
        g_div_next -= ndp
        return
    }
    if s.k == N_RET {
        if s.kids[0].k != N_NONE { gen_expr(s.kids[0]) }
        o("jmp {lbl(retlabel)}")
        return
    }
    if s.k == N_INLINE {
        // contract: every IRET leaves the result in rax and jumps here;
        // one store at the end label instead of one per return path
        let iend = newlabel()
        g_inlend.push(iend)
        for st in s.kids { gen_stmt(st, retlabel) }
        let x = g_inlend.pop()
        olabel(iend)
        let fr = float_reg(ID_LOCAL, s.slot)   // only floats get xmm-promoted, so
        if fr != "" { o("movq " + fr + ", rax") }   // a promoted result is a float
        else if is_ref(s.ty) { store_ref(ID_LOCAL, s.slot) }
        else { o("mov " + slot_addr(ID_LOCAL, s.slot) + ", rax") }
        return
    }
    if s.k == N_IRET {
        if s.kids[0].k != N_NONE { gen_expr(s.kids[0]) }
        o("jmp {lbl(g_inlend[g_inlend.len() - 1])}")
        return
    }
    if s.k == N_BRK {
        o("jmp {lbl(g_brk[g_brk.len() - 1])}")
        return
    }
    if s.k == N_CONT {
        o("jmp {lbl(g_cont[g_cont.len() - 1])}")
        return
    }
    if s.k == N_EXPRST {
        let t = gen_tmp(s.kids[0], true)  // an owned result nobody keeps
        if t { drop_rax() }
        return
    }
    die(s.line, "internal: cannot generate statement kind {s.k}")
}

fn gen_block(blk: Node, retlabel: int) {
    for s in blk.kids { gen_stmt(s, retlabel) }
}

fn no_lines() -> [str] {
    var a: [str] = []
    return a
}

// does this emitted line mention r12? (byte scan: the C seed, which must be
// able to compile this file, has no .contains())
fn line_uses_r12(s: str) -> bool {
    var i = 0
    while i + 2 < s.len() {
        if s.byte(i) == 114 and s.byte(i + 1) == 49 and s.byte(i + 2) == 50 { return true }
        i += 1
    }
    return false
}

// `a[i] op= rhs` desugars to `a[i] = a[i] op rhs`, which used to generate the
// index expression, the bounds check and the data-pointer load TWICE -- once
// for the read and once for the write. Evaluating the right-hand side first
// (it must be call-free, so nothing can reallocate the list or run the GC in
// between) lets the load, the operation and the store share one address.
fn try_index_rmw(t: Node, v: Node) -> bool {
    if v.k != N_BIN { return false }
    if not expr_eq(v.kids[0], t) { return false }
    if has_call(v.kids[1]) or has_call(t.kids[1]) or has_call(t.kids[0]) { return false }
    let rhs = v.kids[1]
    if ty_kind[t.ty] == K_FLOAT {
        if v.aux != BC_FLOAT { return false }
        let op = v.op
        if op != T_PLUS and op != T_MINUS and op != T_STAR and op != T_SLASH { return false }
        if 2 + g_fdepth > 5 { return false }
        let sp = "xmm{2 + g_fdepth}"
        g_fdepth += 1
        gen_fexpr_into(rhs, sp)
        g_fdepth -= 1
        let ir = gen_index_addr(t)
        o("movsd xmm0, [rcx + " + ir + "*8]")
        fop_emit(op, "xmm0", sp)
        o("movsd [rcx + " + ir + "*8], xmm0")
        index_fin_keep()
        return true
    }
    if v.aux == BC_STR or v.aux == BC_FLOAT { return false }
    let alu = alu_of(v.op)
    if alu == "" { return false }
    let sr = scratch_take()
    if sr == "" { return false }
    let dr = scratch_take()          // the loaded value needs a register that
    if dr == "" {                    // is not the index register (often rax)
        scratch_free(sr)
        return false
    }
    gen_into(rhs, sr)
    let ir = gen_index_addr(t)
    o("mov " + dr + ", [rcx + " + ir + "*8]")
    o(alu + " " + dr + ", " + sr)
    o("mov [rcx + " + ir + "*8], " + dr)
    index_fin_keep()
    scratch_free(dr)
    scratch_free(sr)
    return true
}

fn gen_fn_body(label: str, nslots: int, nparams: int, stmts: [Node]) {
    g_cur_regcall = starts_rt(label) or g_next_regcall
    g_cur_nslots = nslots
    g_cur_nparams = nparams
    // Which slots hold references is decided BEFORE promotion, because
    // compute_promotions has to leave those slots in memory (see store_ref).
    // The inliner is why this cannot be inferred from the reads alone: a
    // hoisted result temp is written by an N_INLINE and read through nodes
    // whose type need not agree with the statement that stores to it.
    bclear(g_refslot)
    for i in 0..nslots { g_refslot.push(false) }
    // The counting primitives themselves get no slot bookkeeping: a release
    // routine that released its own frame on the way out would call itself
    // forever. Their only reference slots hold the string literal an inlined
    // rt_die carries, which never lives on the heap.
    var rc_core = label == "lm_rx_drop" or label == "lm_rx_dup" or label == "lm_rx_assign" or label == "lm_rx_drop_child"
    if label == "lm_rx_drop_slots" or label == "lm_rx_release" or label == "lm_rx_drop_children" { rc_core = true }
    if not rc_core {
        for s in stmts { mark_ref_slots(s) }
    }
    mv_reset(nslots, stmts)
    if rc_core {
        for i in 0..nslots { g_movable[i] = false }   // no bookkeeping in the counter itself
    }
    compute_promotions(stmts, nslots, nparams)
    var base = nslots
    if g_cur_regcall { base += nparams }    // home slots for register params
    let xbase = base + g_npromo             // callee-saved xmm save area
    g_div_base = xbase + g_nfpromo          // 4 scratch slots for div reciprocals
    g_div_next = 2                          // block promotion in div-free functions
    var dslots = 0
    for s in stmts {
        if div_present(s) {
            dslots = 4
            g_div_next = 0
        }
    }
    // The collector's register spill: the runtime keeps heap pointers in
    // int-typed variables, and register promotion can lift such a pointer into
    // a callee-saved register where the conservative stack scan cannot see it.
    // rx_collect therefore dumps EVERY callee-saved GPR into its own frame at
    // entry (the setjmp trick), so any promoted caller value is inside the
    // scanned stack region for the duration of the collection.
    var nspill = 0
    if label == "lm_rx_collect" { nspill = 6 }
    let spillbase = g_div_base + dslots
    var lbslots = 0
    for s in stmts {
        if lb_present(s) { lbslots = 2 * LB_MAX }
    }
    g_lb_base = spillbase + nspill
    g_lb_next = 0
    let frame = xbase + g_nfpromo + dslots + nspill + lbslots
    // generate the body into a side buffer first: r12 is only needed by
    // functions that make a runtime/FFI call (the rsp-alignment dance), and a
    // leaf function shouldn't pay push/pop r12 on every single call.
    let outer = g_lines
    g_lines = no_lines()
    // slots are addressed from [rbp-16] down, which assumes the 8 bytes that
    // "push r12" occupies. If it turns out we can skip that push, the space
    // still has to be reserved -- Windows x64 has no red zone, so a slot below
    // rsp would be clobbered by any call or interrupt.
    o("sub rsp, {8 * (frame + 1)}")
    for k in 0..nspill { o("mov [rbp - {16 + 8 * (spillbase + k)}], {PROMO_REGS[k]}") }
    for k in 0..g_npromo { o("mov [rbp - {16 + 8 * (base + k)}], {PROMO_REGS[k]}") }
    for k in 0..g_nfpromo { o("movsd [rbp - {16 + 8 * (xbase + k)}], {FPROMO_REGS[k]}") }
    if g_cur_regcall {
        let ar = ["rcx", "rdx", "r8", "r9"]
        for i in 0..nparams {
            o("mov " + slot_addr(ID_PARAM, i) + ", " + ar[i])
            if g_pxreg[i] != "" { o("movq {g_pxreg[i]}, " + ar[i]) }   // promoted float param
        }
    } else {
        // stack-convention promoted params: pull them off the caller's stack
        for i in 0..nparams {
            if g_preg[i] != "" { o("mov {g_preg[i]}, [rbp + {16 + 8 * (nparams - 1 - i)}]") }
            if g_pxreg[i] != "" { o("movsd {g_pxreg[i]}, [rbp + {16 + 8 * (nparams - 1 - i)}]") }
        }
    }
    // reference slots start empty: a drop on exit (or on a re-declaration
    // inside a loop) must never see whatever the frame held before
    var ndrop = 0
    for i in 0..nslots {
        if g_refslot[i] {
            o("mov qword ptr " + slot_addr(ID_LOCAL, i) + ", 0")
            ndrop += 1
        }
    }
    // Parameters are NOT dropped: they are borrowed from the caller, which is
    // keeping them alive for the whole call. Zephyr parameters are immutable,
    // so a borrowed slot is never written either -- nothing to release.
    let retlabel = newlabel()
    // Register the globals array as a GC root set. This must land *after* the
    // runtime's own top-level initializers, or they would overwrite the
    // pointer we just handed it (they run as ordinary statements too). The
    // runtime's initializers never allocate, so no collection can happen first.
    let is_main = label == "zephyr_main" and g_nglobals > 0
    var si = 0
    for s in stmts {
        if is_main and si == g_rt_top {
            o("lea rcx, [rip + __zephyr_globals]")
            o("mov rdx, {g_nglobals}")
            rcall("rt_set_globals")
        }
        gen_stmt(s, retlabel)
        si += 1
    }
    if is_main and g_rt_top >= stmts.len() {
        o("lea rcx, [rip + __zephyr_globals]")
        o("mov rdx, {g_nglobals}")
        rcall("rt_set_globals")
    }
    olabel(retlabel)
    if ndrop > 0 {                    // the locals go; the result in rax stays
        o("push rax")
        if ndrop > 1 {
            // one call and a loop over a static offset table, instead of a call
            // per slot on every return -- see rx_drop_slots
            var offs = ""
            for i in 0..nslots {
                if g_refslot[i] {
                    if offs != "" { offs = offs + ", " }
                    offs = offs + "{16 + 8 * i}"
                }
            }
            g_dslots.push(offs)
            o("mov rcx, rbp")
            o("lea rdx, [rip + __ds{g_dslots.len() - 1}]")
            o("mov r8, {ndrop}")
            rcall(fn_label("rx_drop_slots"))
        } else {
            for i in 0..nslots {
                if g_refslot[i] {
                    o("mov rcx, " + slot_addr(ID_LOCAL, i))
                    rcall(fn_label("rx_drop"))
                }
            }
        }
        o("pop rax")
    }
    for k in 0..g_npromo { o("mov {PROMO_REGS[k]}, [rbp - {16 + 8 * (base + k)}]") }
    for k in 0..g_nfpromo { o("movsd {FPROMO_REGS[k]}, [rbp - {16 + 8 * (xbase + k)}]") }
    // does the body really use r12? (the out-of-line bounds-failure blocks may,
    // but they end in a panic that never returns, so they don't count)
    var uses_r12 = false
    for i in 0..g_lines.len() {
        if line_uses_r12(g_lines[i]) { uses_r12 = true }
    }
    let body = g_lines
    g_lines = outer
    raw(label + ":")
    o("push rbp")
    o("mov rbp, rsp")
    if uses_r12 { o("push r12") }
    for i in 0..body.len() { g_lines.push(body[i]) }
    if uses_r12 {
        o("lea rsp, [rbp - 8]")
        o("pop r12")
    } else {
        o("mov rsp, rbp")
    }
    o("pop rbp")
    o("ret")
    flush_cold()                // never-taken bounds-failure blocks, out of line
    raw("")
}

fn emit_bytes(s: str) {
    var i = 0
    while i < s.len() {
        var parts: [str] = []
        parts.push("  .byte ")
        var j = i
        while j < s.len() and j < i + 16 {
            if j > i { parts.push(",") }
            parts.push(s.byte(j) as str)
            j += 1
        }
        parts.push("\n")
        g_lines.push(parts.join())
        i += 16
    }
}

// ---------------- register calling convention for user functions ----------------
// rt_ functions have always taken their arguments in rcx/rdx/r8/r9; ordinary
// user functions pushed theirs on the stack, so every call paid a store plus a
// load in the callee. Give the register convention to any function whose
// address is never taken -- if it can only be called directly, both sides agree
// on the convention. Functions used as values, interface methods (reached
// through a vtable) and anything over four parameters keep the stack
// convention, since indirect calls must all look the same.
fn rc_scan_addr(e: Node) {
    // a function's address escapes either as a plain name used as a value or
    // as a closure literal; both are reached through indirect calls, which
    // push their arguments, so those bodies must keep the stack convention
    if e.k == N_ID and e.aux == ID_FUNC {
        if e.refi >= 0 and e.refi < g_fn_regcall.len() { g_fn_regcall[e.refi] = false }
    }
    if e.k == N_FNLIT {
        if e.refi >= 0 and e.refi < g_fn_regcall.len() { g_fn_regcall[e.refi] = false }
    }
    for c in e.kids { rc_scan_addr(c) }
}

fn compute_regcall(prog: Node) {
    var i = 0
    while i < g_fns.len() {
        let f = g_fns[i]
        var ok = f.pnames.len() <= 4
        if f.tparams.len() > 0 { ok = false }        // template: no code, no callers
        if f.has_env { ok = false }                  // closure body: called indirectly
        if starts_rt(f.label) { ok = false }          // already register-convention
        g_fn_regcall.push(ok)
        i += 1
    }
    rc_scan_addr(prog)
    for j in 0..g_fns.len() {
        let b = g_fns[j].body
        if b.k != N_NONE { rc_scan_addr(b) }
    }
    // interface methods are called through a vtable: keep them uniform
    for v in 0..g_vt_sd.len() {
        let sname = g_structs[g_vt_sd[v]].name
        let idf = g_ifaces[g_vt_if[v]]
        for m in 0..idf.mnames.len() {
            let mi = find_fn(sname + "." + idf.mnames[m])
            if mi >= 0 { g_fn_regcall[mi] = false }
        }
    }
}

fn fn_is_regcall(idx: int) -> bool {
    if idx < 0 or idx >= g_fn_regcall.len() { return false }
    return g_fn_regcall[idx]
}

fn gen_program(prog: Node) {
    compute_regcall(prog)
    raw(".intel_syntax noprefix")
    raw(".text")
    raw(".globl zephyr_main")
    raw("")
    for n in prog.kids {
        if n.k == N_FN {
            let f = g_fns[n.refi]
            if f.tparams.len() > 0 { continue }        // a template emits no code
            g_cur_user = f.body.file == g_main_file
            g_next_regcall = fn_is_regcall(n.refi)
            g_cur_ptypes = f.ptypes
            gen_fn_body(fn_label(f.label), f.nslots, f.pnames.len(), f.body.kids)
        }
    }
    for i in 0..g_insts.len() {                        // one body per monomorphisation
        let f = g_fns[g_insts[i]]
        g_cur_user = f.body.file == g_main_file
        g_next_regcall = fn_is_regcall(g_insts[i])
        g_cur_ptypes = f.ptypes
        gen_fn_body(fn_label(f.label), f.nslots, f.pnames.len(), f.body.kids)
    }
    var top: [Node] = []
    for n in prog.kids {
        if n.k != N_FN and n.k != N_STRUCTDEF and n.k != N_ENUMDEF and n.k != N_INTERFACE { top.push(n) }
    }
    g_cur_user = true    // main body: per-node file filter keeps only main-file top statements
    g_next_regcall = false
    var no_ptypes: [int] = []
    g_cur_ptypes = no_ptypes
    gen_fn_body("zephyr_main", g_top_nslots, 0, top)

    raw(".section .rdata")
    for i in 0..g_fconsts.len() {
        raw(".balign 8")
        raw("__fc{i}:")
        o(".quad {g_fconsts[i]}")
    }
    for i in 0..g_dstrs.len() {
        raw(".balign 8")
        raw("__s{i}:")
        o(".quad {g_dstrs[i].len()}")
        emit_bytes(g_dstrs[i])
    }
    var di = 0
    while di < g_descs.len() {
        let t = g_descs[di]
        let k = ty_kind[t]
        raw(".balign 8")
        raw("__td{di}:")
        if k == K_LIST {
            o(".quad 4")
            o(".quad __td{td_index(ty_el[t])}")
        } else if k == K_STRUCT {
            let sd = g_structs[ty_sd[t]]
            o(".quad 5")
            o(".quad __c{add_cstr(sd.name)}")
            o(".quad {sd.fnames.len()}")
            for j in 0..sd.fnames.len() {
                o(".quad __c{add_cstr(sd.fnames[j])}")
                o(".quad __td{td_index(sd.ftypes[j])}")
            }
        } else if k == K_OPT {
            o(".quad 8")
            o(".quad __td{td_index(ty_el[t])}")
        } else if k == K_MAP {
            o(".quad 7")
            o(".quad __td{td_index(ty_sd[t])}")   // key type
            o(".quad __td{td_index(ty_el[t])}")   // value type
        } else if k == K_ENUM {
            let ed = g_enums[ty_sd[t]]
            o(".quad 6")
            o(".quad {ed.members.len()}")
            for j in 0..ed.members.len() {
                o(".quad __c{add_cstr(ed.members[j])}")
            }
        } else {
            o(".quad {k}")
        }
        di += 1
    }
    for i in 0..g_dts.len() {          // shape descriptors for the reference counter
        raw(".balign 8")
        raw("__dt{i}:")
        for w in g_dts[i].split(", ") { o(".quad " + w) }
    }
    for i in 0..g_dslots.len() {       // frame-offset tables for the exit drop
        raw(".balign 8")
        raw("__ds{i}:")
        for w in g_dslots[i].split(", ") { o(".quad " + w) }
    }
    // interface vtables: one per (struct, interface) pair, method code pointers
    // in interface declaration order.
    for i in 0..g_vt_sd.len() {
        raw(".balign 8")
        raw("__vt{i}:")
        let sname = g_structs[g_vt_sd[i]].name
        let idf = g_ifaces[g_vt_if[i]]
        for m in 0..idf.mnames.len() {
            let mi = find_fn(sname + "." + idf.mnames[m])
            o(".quad " + fn_label(g_fns[mi].label))
        }
    }
    for i in 0..g_cstrs.len() {
        raw("__c{i}:")
        emit_bytes(g_cstrs[i])
        o(".byte 0")
    }
    if g_nglobals > 0 {
        raw(".section .bss")
        raw(".balign 8")
        raw("__zephyr_globals:")
        o(".space {8 * g_nglobals}")
    }
}

// ---------------- assembler ----------------
// Same design as the C compiler's: encodes exactly the vocabulary our own
// code generator emits. No bitwise operators in Zephyr, so byte math is done
// with floor-division arithmetic (two's-complement adjusted).
let SEC_TEXT = 0
let SEC_RDATA = 1
let SEC_BSS = 2
let FX_REL32 = 0
let FX_IAT32 = 1
let FX_ABS64 = 2
let OPK_REG = 1
let OPK_XMM = 2
let OPK_IMM = 3
let OPK_MEM = 4
let OPK_SYM = 5

struct ASym { name: str, sect: int, off: int, defined: bool, predef: bool }
struct AFix { off: int, sect: int, kind: int, sym: int, addend: int }
struct Op { kind: int, reg: int, size: int, imm: int, base: int, index: int, scale: int, disp: int, sym: str }

var t_bytes: [int] = []
var r_bytes: [int] = []
var a_bss = 0
var a_sect = 0
var a_syms: [ASym] = []
var a_symhash: [int] = []
for i in 0..65536 { a_symhash.push(0) }
var a_fixes: [AFix] = []
var a_imports: [str] = []
var a_import_dll: [int] = []      // 0 = zephyr_rt.dll, 1 = kernel32.dll
var g_trail = 0
var a_curline = ""

let REG64 = ["rax", "rcx", "rdx", "rbx", "rsp", "rbp", "rsi", "rdi",
             "r8", "r9", "r10", "r11", "r12", "r13", "r14", "r15"]

fn asm_fail(msg: str) { panic("assembler: {msg} | line: {a_curline}") }

fn tb(v: int) { t_bytes.push(v) }
fn tb32(v: int) {
    var x = v
    for i in 0..4 {
        var b = x % 256
        if b < 0 { b += 256 }
        t_bytes.push(b)
        x = (x - b) / 256
    }
}
fn tb64(v: int) {
    var x = v
    for i in 0..8 {
        var b = x % 256
        if b < 0 { b += 256 }
        t_bytes.push(b)
        x = (x - b) / 256
    }
}
fn rb32(v: int) {
    var x = v
    for i in 0..4 {
        var b = x % 256
        if b < 0 { b += 256 }
        r_bytes.push(b)
        x = (x - b) / 256
    }
}
fn rb64(v: int) {
    var x = v
    for i in 0..8 {
        var b = x % 256
        if b < 0 { b += 256 }
        r_bytes.push(b)
        x = (x - b) / 256
    }
}

fn strhash(s: str) -> int {
    var h = 0
    for i in 0..s.len() { h = (h * 31 + s.byte(i)) % 65536 }
    return h
}

fn sym_intern(name: str) -> int {
    var h = strhash(name)
    while a_symhash[h] != 0 {
        let idx = a_symhash[h] - 1
        if a_syms[idx].name == name { return idx }
        h = (h + 1) % 65536
    }
    a_syms.push(ASym{name: name, sect: 0, off: 0, defined: false, predef: false})
    a_symhash[h] = a_syms.len()
    return a_syms.len() - 1
}

// read-only: is `name` a locally defined/pre-scanned label?
fn sym_is_local(name: str) -> bool {
    var h = strhash(name)
    while a_symhash[h] != 0 {
        let idx = a_symhash[h] - 1
        if a_syms[idx].name == name { return a_syms[idx].predef or a_syms[idx].defined }
        h = (h + 1) % 65536
    }
    return false
}

fn import_intern2(name: str, dll: int) -> int {
    for i in 0..a_imports.len() {
        if a_imports[i] == name { return i }
    }
    a_imports.push(name)
    a_import_dll.push(dll)
    return a_imports.len() - 1
}
fn import_intern(name: str) -> int { return import_intern2(name, 0) }

fn add_fix(kind: int, sym: int, addend: int) {
    var off = t_bytes.len()
    if a_sect == SEC_RDATA { off = r_bytes.len() }
    a_fixes.push(AFix{off: off, sect: a_sect, kind: kind, sym: sym, addend: addend})
}

fn starts_with(s: str, p: str) -> bool {
    if s.len() < p.len() { return false }
    return s.sub(0, p.len()) == p
}

// returns reg + size*16, or -1
fn reg_lookup(s: str) -> int {
    for i in 0..16 {
        if REG64[i] == s { return i + 64 * 16 }
    }
    if s == "eax" { return 0 + 32 * 16 }
    if s == "ecx" { return 1 + 32 * 16 }
    if s == "edx" { return 2 + 32 * 16 }
    if s == "ebx" { return 3 + 32 * 16 }
    if s == "esi" { return 6 + 32 * 16 }
    if s == "edi" { return 7 + 32 * 16 }
    if s == "al" { return 0 + 8 * 16 }
    if s == "cl" { return 1 + 8 * 16 }
    if s == "dl" { return 2 + 8 * 16 }
    return -1
}

fn is_digit_b(c: int) -> bool { return c >= 48 and c <= 57 }

fn parse_operand(text0: str) -> Op {
    var op = Op{kind: 0, reg: 0, size: 64, imm: 0, base: -1, index: -1, scale: 0, disp: 0, sym: ""}
    var text = text0
    while text.len() > 0 and text.byte(0) == 32 { text = text.sub(1, text.len()) }
    if starts_with(text, "qword ptr ") { text = text.sub(10, text.len()) }
    else if starts_with(text, "byte ptr ") {
        op.size = 8
        text = text.sub(9, text.len())
    }
    if text.byte(0) == 91 { // '['
        op.kind = OPK_MEM
        var close = -1
        for i in 0..text.len() {
            if text.byte(i) == 93 { close = i }
        }
        if close < 0 { asm_fail("missing ]") }
        let inner = text.sub(1, close)
        var p = 0
        var sign = 1
        while p < inner.len() {
            let c = inner.byte(p)
            if c == 32 {
                p += 1
                continue
            }
            if c == 43 {          // +
                sign = 1
                p += 1
                continue
            }
            if c == 45 {          // -
                sign = -1
                p += 1
                continue
            }
            var q = p
            while q < inner.len() {
                let cq = inner.byte(q)
                if cq == 32 or cq == 43 or cq == 45 { break }
                q += 1
            }
            let tkn = inner.sub(p, q)
            p = q
            if is_digit_b(tkn.byte(0)) {
                op.disp += sign * (tkn as int)
            } else if tkn == "rip" {
                op.base = -2
            } else {
                var star = -1
                for i in 0..tkn.len() {
                    if tkn.byte(i) == 42 { star = i } // '*'
                }
                if star >= 0 {
                    let r = reg_lookup(tkn.sub(0, star))
                    if r < 0 { asm_fail("bad index register") }
                    op.index = r % 16
                    op.scale = tkn.sub(star + 1, tkn.len()) as int
                } else {
                    let r = reg_lookup(tkn)
                    if r >= 0 {
                        if op.base == -1 { op.base = r % 16 }
                        else {
                            op.index = r % 16
                            op.scale = 1
                        }
                    } else {
                        op.sym = tkn
                    }
                }
            }
            sign = 1
        }
        return op
    }
    let c0 = text.byte(0)
    if is_digit_b(c0) or c0 == 45 {
        op.kind = OPK_IMM
        op.imm = text as int
        return op
    }
    if starts_with(text, "xmm") {
        op.kind = OPK_XMM
        op.reg = text.sub(3, text.len()) as int
        return op
    }
    let r = reg_lookup(text)
    if r >= 0 {
        op.kind = OPK_REG
        op.reg = r % 16
        op.size = r / 16
        return op
    }
    op.kind = OPK_SYM
    op.sym = text
    return op
}

// emit REX + opcodes + modrm/sib/disp; opc2 < 0 means single-byte opcode
fn enc_rm(rexw: int, opc1: int, opc2: int, reg: int, rm: Op, pfx66: bool, pfxF2: bool) {
    if pfx66 { tb(102) }
    if pfxF2 { tb(242) }
    var rex = 0
    if rexw == 1 { rex = 8 }
    rex += (reg / 8) * 4
    var modv = 3
    var modrm_rm = 0
    var sib = -1
    var disp = rm.disp
    var dispsz = 0
    var ripfix = false
    if rm.kind == OPK_MEM {
        if rm.base == -2 {
            modv = 0
            modrm_rm = 5
            dispsz = 4
            ripfix = true
        } else {
            let base = rm.base
            if rm.index >= 0 {
                var ss = 0
                if rm.scale == 8 { ss = 3 }
                else if rm.scale == 4 { ss = 2 }
                else if rm.scale == 2 { ss = 1 }
                sib = ss * 64 + (rm.index % 8) * 8 + base % 8
                rex += (rm.index / 8) * 2
                modrm_rm = 4
            } else if base % 8 == 4 {
                sib = 4 * 8 + base % 8
                modrm_rm = 4
            } else {
                modrm_rm = base % 8
            }
            rex += base / 8
            if disp == 0 and base % 8 != 5 { modv = 0 }
            else if disp >= -128 and disp <= 127 {
                modv = 1
                dispsz = 1
            } else {
                modv = 2
                dispsz = 4
            }
        }
    } else {
        modrm_rm = rm.reg % 8
        rex += rm.reg / 8
    }
    if rex != 0 { tb(64 + rex) }
    tb(opc1)
    if opc2 >= 0 { tb(opc2) }
    tb(modv * 64 + (reg % 8) * 8 + modrm_rm)
    if sib >= 0 { tb(sib) }
    if ripfix {
        add_fix(FX_REL32, sym_intern(rm.sym), disp - g_trail)
        tb32(0)
    } else if dispsz == 1 {
        var b = disp
        if b < 0 { b += 256 }
        tb(b)
    } else if dispsz == 4 {
        tb32(disp)
    }
    g_trail = 0
}

fn enc_rr(rexw: int, opc1: int, opc2: int, reg: int, rmreg: int, pfx66: bool, pfxF2: bool) {
    enc_rm(rexw, opc1, opc2, reg, Op{kind: OPK_REG, reg: rmreg, size: 64, imm: 0, base: -1, index: -1, scale: 0, disp: 0, sym: ""}, pfx66, pfxF2)
}

fn cc_code(cc: str) -> int {
    if cc == "e" { return 4 }
    if cc == "ne" { return 5 }
    if cc == "l" { return 12 }
    if cc == "le" { return 14 }
    if cc == "g" { return 15 }
    if cc == "ge" { return 13 }
    if cc == "a" { return 7 }
    if cc == "ae" { return 3 }
    if cc == "b" { return 2 }
    if cc == "be" { return 6 }
    if cc == "p" { return 10 }
    if cc == "np" { return 11 }
    if cc == "s" { return 8 }
    if cc == "ns" { return 9 }
    return -1
}

let ALU_NAMES = ["add", "or", "and", "sub", "xor", "cmp"]
let ALU_RM_R = [1, 9, 33, 41, 49, 57]     // 0x01 0x09 0x21 0x29 0x31 0x39
let ALU_R_RM = [3, 11, 35, 43, 51, 59]
let ALU_EXT = [0, 1, 4, 5, 6, 7]

fn asm_ins(mn: str, ops: [Op], nops: int) {
    if mn == "push" {
        if ops[0].reg >= 8 { tb(65) }
        tb(80 + ops[0].reg % 8)
        return
    }
    if mn == "pop" {
        if ops[0].reg >= 8 { tb(65) }
        tb(88 + ops[0].reg % 8)
        return
    }
    if mn == "ret" {
        tb(195)
        return
    }
    if mn == "cqo" {
        tb(72)
        tb(153)
        return
    }
    if mn == "syscall" {
        tb(15)
        tb(5)
        return
    }
    if mn == "movabs" {
        tb(64 + 8 + ops[0].reg / 8)
        tb(184 + ops[0].reg % 8)
        tb64(ops[1].imm)
        return
    }
    if mn == "mov" {
        let a = ops[0]
        let b = ops[1]
        if a.kind == OPK_REG and b.kind == OPK_IMM {
            if a.size == 32 {
                if a.reg >= 8 { tb(65) }
                tb(184 + a.reg % 8)
                tb32(b.imm)
            } else {
                enc_rm(1, 199, -1, 0, a, false, false)
                tb32(b.imm)
            }
            return
        }
        if a.kind == OPK_MEM and b.kind == OPK_IMM {
            g_trail = 4
            enc_rm(1, 199, -1, 0, a, false, false)
            tb32(b.imm)
            return
        }
        if a.kind == OPK_REG and b.kind == OPK_REG {
            enc_rr(1, 137, -1, b.reg, a.reg, false, false)
            return
        }
        if a.kind == OPK_REG and b.kind == OPK_MEM {
            enc_rm(1, 139, -1, a.reg, b, false, false)
            return
        }
        if a.kind == OPK_MEM and b.kind == OPK_REG {   // store; honor source width
            var opc = 137
            var w = 1
            if b.size == 8 {
                opc = 136
                w = 0
            } else if b.size == 32 {
                w = 0
            }
            enc_rm(w, opc, -1, b.reg, a, false, false)
            return
        }
        asm_fail("mov form")
    }
    for k in 0..6 {
        if mn == ALU_NAMES[k] {
            let a = ops[0]
            let b = ops[1]
            var w = 1
            if a.size == 32 or a.size == 8 { w = 0 }
            if b.kind == OPK_IMM {
                var opc = 129
                if a.size == 8 { opc = 128 }
                if a.size == 8 { g_trail = 1 } else { g_trail = 4 }
                enc_rm(w, opc, -1, ALU_EXT[k], a, false, false)
                if a.size == 8 {
                    var bb = b.imm % 256
                    if bb < 0 { bb += 256 }
                    tb(bb)
                } else {
                    tb32(b.imm)
                }
                return
            }
            if a.kind == OPK_REG and b.kind == OPK_MEM {
                enc_rm(w, ALU_R_RM[k], -1, a.reg, b, false, false)
                return
            }
            var opc = ALU_RM_R[k]
            if a.size == 8 { opc = opc - 1 }
            enc_rm(w, opc, -1, b.reg, a, false, false)
            return
        }
    }
    if mn == "test" {
        enc_rr(1, 133, -1, ops[1].reg, ops[0].reg, false, false)
        return
    }
    if mn == "imul" {
        if nops == 1 {
            enc_rm(1, 247, -1, 5, ops[0], false, false)
            return
        }
        if nops == 3 {
            g_trail = 4
            enc_rm(1, 105, -1, ops[0].reg, ops[1], false, false)
            tb32(ops[2].imm)
            return
        }
        enc_rm(1, 15, 175, ops[0].reg, ops[1], false, false)
        return
    }
    if mn == "idiv" {
        enc_rm(1, 247, -1, 7, ops[0], false, false)
        return
    }
    if mn == "div" {                       // unsigned divide, F7 /6
        enc_rm(1, 247, -1, 6, ops[0], false, false)
        return
    }
    if mn == "mul" {                       // unsigned multiply, F7 /4 (rdx:rax = rax * r/m)
        enc_rm(1, 247, -1, 4, ops[0], false, false)
        return
    }
    if mn == "neg" {
        enc_rm(1, 247, -1, 3, ops[0], false, false)
        return
    }
    if mn == "inc" {
        enc_rm(1, 255, -1, 0, ops[0], false, false)
        return
    }
    if mn == "sar" or mn == "shl" or mn == "shr" or mn == "sal" {
        var ext = 7                             // sar
        if mn == "shl" or mn == "sal" { ext = 4 }
        else if mn == "shr" { ext = 5 }
        if ops[1].kind == OPK_IMM {             // OP r/m64, imm8
            g_trail = 1
            enc_rm(1, 193, -1, ext, ops[0], false, false)
            var b = ops[1].imm % 256
            if b < 0 { b += 256 }
            tb(b)
        } else {                                // OP r/m64, cl
            enc_rm(1, 211, -1, ext, ops[0], false, false)
        }
        return
    }
    if mn == "movzx" {
        enc_rm(0, 15, 182, ops[0].reg, ops[1], false, false)
        return
    }
    if mn == "lea" {
        enc_rm(1, 141, -1, ops[0].reg, ops[1], false, false)
        return
    }
    if starts_with(mn, "set") {
        let cc = cc_code(mn.sub(3, mn.len()))
        if cc < 0 { asm_fail("bad setcc") }
        enc_rm(0, 15, 144 + cc, 0, ops[0], false, false)
        return
    }
    if mn == "jmp" {
        tb(233)
        add_fix(FX_REL32, sym_intern(ops[0].sym), 0)
        tb32(0)
        return
    }
    if mn.byte(0) == 106 { // 'j' conditional
        let cc = cc_code(mn.sub(1, mn.len()))
        if cc < 0 { asm_fail("bad jcc") }
        tb(15)
        tb(128 + cc)
        add_fix(FX_REL32, sym_intern(ops[0].sym), 0)
        tb32(0)
        return
    }
    if mn == "call" {
        if ops[0].kind == OPK_REG {                // call through a register (fn value)
            enc_rm(0, 255, -1, 2, ops[0], false, false)
            return
        }
        if starts_with(ops[0].sym, "__imp_k_") {   // kernel32 import (indirect)
            tb(255)
            tb(21)
            add_fix(FX_IAT32, import_intern2(ops[0].sym.sub(8, ops[0].sym.len()), 1), 0)
            tb32(0)
        } else if starts_with(ops[0].sym, "__imp_u_") {   // user32 import
            tb(255)
            tb(21)
            add_fix(FX_IAT32, import_intern2(ops[0].sym.sub(8, ops[0].sym.len()), 2), 0)
            tb32(0)
        } else if starts_with(ops[0].sym, "__imp_g_") {   // gdi32 import
            tb(255)
            tb(21)
            add_fix(FX_IAT32, import_intern2(ops[0].sym.sub(8, ops[0].sym.len()), 3), 0)
            tb32(0)
        } else if starts_with(ops[0].sym, "__imp_o_") {   // opengl32 import
            tb(255)
            tb(21)
            add_fix(FX_IAT32, import_intern2(ops[0].sym.sub(8, ops[0].sym.len()), 4), 0)
            tb32(0)
        } else if starts_with(ops[0].sym, "rt_") and not sym_is_local(ops[0].sym) {
            tb(255)                                 // zephyr_rt.dll import (indirect)
            tb(21)
            add_fix(FX_IAT32, import_intern(ops[0].sym), 0)
            tb32(0)
        } else {                                    // local function (direct rel32)
            tb(232)
            add_fix(FX_REL32, sym_intern(ops[0].sym), 0)
            tb32(0)
        }
        return
    }
    if mn == "movq" {
        if ops[0].kind == OPK_XMM {
            enc_rm(1, 15, 110, ops[0].reg, ops[1], true, false)
        } else {
            enc_rm(1, 15, 126, ops[1].reg, ops[0], true, false)
        }
        return
    }
    if mn == "movsd" {
        if ops[0].kind == OPK_XMM {
            enc_rm(0, 15, 16, ops[0].reg, ops[1], false, true)   // movsd xmm, xmm/m64  (F2 0F 10)
        } else {
            enc_rm(0, 15, 17, ops[1].reg, ops[0], false, true)   // movsd xmm/m64, xmm  (F2 0F 11)
        }
        return
    }
    if mn == "movapd" {                                          // xmm<-xmm copy, no partial-reg merge
        enc_rm(0, 15, 40, ops[0].reg, ops[1], true, false)       // 66 0F 28 /r
        return
    }
    if mn == "addsd" {
        enc_rm(0, 15, 88, ops[0].reg, ops[1], false, true)   // xmm, xmm/m64
        return
    }
    if mn == "subsd" {
        enc_rm(0, 15, 92, ops[0].reg, ops[1], false, true)   // xmm, xmm/m64
        return
    }
    if mn == "mulsd" {
        enc_rm(0, 15, 89, ops[0].reg, ops[1], false, true)   // xmm, xmm/m64
        return
    }
    if mn == "divsd" {
        enc_rm(0, 15, 94, ops[0].reg, ops[1], false, true)   // xmm, xmm/m64
        return
    }
    if mn == "minsd" {
        enc_rm(0, 15, 93, ops[0].reg, ops[1], false, true)   // xmm, xmm/m64
        return
    }
    if mn == "maxsd" {
        enc_rm(0, 15, 95, ops[0].reg, ops[1], false, true)   // xmm, xmm/m64
        return
    }
    if mn == "sqrtsd" {
        enc_rr(0, 15, 81, ops[0].reg, ops[1].reg, false, true)
        return
    }
    if mn == "comisd" {
        enc_rm(0, 15, 47, ops[0].reg, ops[1], true, false)   // xmm, xmm/m64
        return
    }
    if mn == "ucomisd" {
        enc_rr(0, 15, 46, ops[0].reg, ops[1].reg, true, false)
        return
    }
    if mn == "cvtsi2sd" {
        enc_rr(1, 15, 42, ops[0].reg, ops[1].reg, false, true)
        return
    }
    if mn == "cvttsd2si" {
        enc_rr(1, 15, 44, ops[0].reg, ops[1].reg, false, true)
        return
    }
    asm_fail("unknown mnemonic '{mn}'")
}

fn asm_label(name: str) {
    let si = sym_intern(name)
    if a_syms[si].defined { asm_fail("duplicate label {name}") }
    a_syms[si].defined = true
    a_syms[si].sect = a_sect
    var off = t_bytes.len()
    if a_sect == SEC_RDATA { off = r_bytes.len() }
    if a_sect == SEC_BSS { off = a_bss }
    a_syms[si].off = off
}

fn asm_line(line: str) {
    a_curline = line
    if line.len() == 0 { return }
    if line.byte(0) != 32 { // label or directive
        if line.byte(0) == 46 { // '.'
            if starts_with(line, ".section .rdata") {
                a_sect = SEC_RDATA
                return
            }
            if starts_with(line, ".section .bss") {
                a_sect = SEC_BSS
                return
            }
            if line == ".text" {
                a_sect = SEC_TEXT
                return
            }
            if starts_with(line, ".balign") {
                let al = line.sub(8, line.len()) as int
                if a_sect == SEC_RDATA {
                    while r_bytes.len() % al != 0 { r_bytes.push(0) }
                } else if a_sect == SEC_BSS {
                    while a_bss % al != 0 { a_bss += 1 }
                }
                return
            }
            if starts_with(line, ".intel_syntax") or starts_with(line, ".globl") { return }
            if starts_with(line, ".zloc ") { // -g: record current .text offset for this source line
                dbg_off.push(t_bytes.len())
                dbg_line.push(line.sub(6, line.len()) as int)
                return
            }
            if line.byte(line.len() - 1) == 58 { // .L label
                asm_label(line.sub(0, line.len() - 1))
                return
            }
            asm_fail("unknown directive")
        }
        if line.byte(line.len() - 1) != 58 { asm_fail("expected label") }
        asm_label(line.sub(0, line.len() - 1))
        return
    }
    let p = line.sub(2, line.len())
    if p.byte(0) == 46 { // data directive
        if starts_with(p, ".quad ") {
            let v = p.sub(6, p.len())
            let c0 = v.byte(0)
            if is_digit_b(c0) or c0 == 45 {
                rb64(v as int)
            } else {
                add_fix(FX_ABS64, sym_intern(v), 0)
                rb64(0)
            }
            return
        }
        if starts_with(p, ".byte ") {
            var q = 6
            while q < p.len() {
                var e = q
                while e < p.len() and p.byte(e) != 44 { e += 1 }
                let v = p.sub(q, e) as int
                if a_sect == SEC_TEXT { t_bytes.push(v) } else { r_bytes.push(v) }
                q = e + 1
            }
            return
        }
        if starts_with(p, ".space ") {
            a_bss += p.sub(7, p.len()) as int
            return
        }
        asm_fail("unknown data directive")
    }
    // instruction
    var sp = 0
    while sp < p.len() and p.byte(sp) != 32 { sp += 1 }
    let mn = p.sub(0, sp)
    var rest = ""
    if sp < p.len() { rest = p.sub(sp + 1, p.len()) }
    var ops: [Op] = []
    var q = 0
    while q < rest.len() and ops.len() < 3 {
        var depth = 0
        var e = q
        while e < rest.len() {
            let c = rest.byte(e)
            if c == 91 { depth += 1 }
            if c == 93 { depth -= 1 }
            if c == 44 and depth == 0 { break }
            e += 1
        }
        var t = rest.sub(q, e)
        while t.len() > 0 and t.byte(t.len() - 1) == 32 { t = t.sub(0, t.len() - 1) }
        ops.push(parse_operand(t))
        q = e + 1
        while q < rest.len() and rest.byte(q) == 32 { q += 1 }
    }
    asm_ins(mn, ops, ops.len())
}

// ---------------- PE writer ----------------
var pe_out: [int] = []

fn pw(v: int) { pe_out.push(v) }
fn pw2(v: int) {
    pe_out.push(v % 256)
    pe_out.push((v / 256) % 256)
}
fn pw4(v: int) {
    var x = v
    for i in 0..4 {
        var b = x % 256
        if b < 0 { b += 256 }
        pe_out.push(b)
        x = (x - b) / 256
    }
}
fn pw8(v: int) {
    var x = v
    for i in 0..8 {
        var b = x % 256
        if b < 0 { b += 256 }
        pe_out.push(b)
        x = (x - b) / 256
    }
}
fn pw_pad(target: int) {
    while pe_out.len() < target { pe_out.push(0) }
}
fn pe_align(v: int, al: int) -> int {
    return ((v + al - 1) / al) * al
}

fn patch4(buf: [int], off: int, v: int) {
    var x = v
    for i in 0..4 {
        var b = x % 256
        if b < 0 { b += 256 }
        buf[off + i] = b
        x = (x - b) / 256
    }
}
fn patch8(buf: [int], off: int, v: int) {
    var x = v
    for i in 0..8 {
        var b = x % 256
        if b < 0 { b += 256 }
        buf[off + i] = b
        x = (x - b) / 256
    }
}

// ---------------- imports ----------------
var g_imported: [str] = []

// directory part of a path, including the trailing separator ("" if none)
fn dirname(p: str) -> str {
    var i = p.len() - 1
    while i >= 0 {
        let c = p.byte(i)
        if c == 47 or c == 92 { return p.sub(0, i + 1) }
        i -= 1
    }
    return ""
}

fn is_abs_path(p: str) -> bool {
    if p.len() == 0 { return false }
    if p.byte(0) == 47 or p.byte(0) == 92 { return true }      // /foo, \foo
    if p.len() > 2 and p.byte(1) == 58 { return true }         // C:\foo
    return false
}

// ---- embedded sources ----
// The runtime and the std library are baked into the compiler binary so a lone
// zc.exe is self-sufficient. tools/embed-gen.ps1 regenerates the section
// between the EMBED markers from runtime.zeph and std/*.zeph; the disk files,
// when present next to the exe or in the cwd, still take priority (dev override).

fn str_ends(s: str, t: str) -> bool {
    if t.len() > s.len() { return false }
    let off = s.len() - t.len()
    var i = 0
    while i < t.len() {
        if s.byte(off + i) != t.byte(i) { return false }
        i += 1
    }
    return true
}

// index of the embedded file an import name refers to, or -1.
// "std/list.zeph", "../std/list.zeph" and "..\std\list.zeph" all match.
fn embed_match(name: str) -> int {
    var i = 0
    while i < embedded_count() {
        let k = embedded_name(i)
        if name == k { return i }
        if str_ends(name, "/" + k) { return i }
        if str_ends(name, "\\" + k) { return i }
        i += 1
    }
    return 0 - 1
}

