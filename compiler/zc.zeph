    p.push("\}\n")
    p.push("\n")
    p.push("// ---- sorting (heapsort: in place, O(n log n), no recursion) ----\n")
    p.push("// kind: 0 = by value (int/bool/enum), 1 = str, 2 = float.  Kept free of\n")
    p.push("// function values so the C seed can still compile this file.\n")
    p.push("fn runtimeCompareValuesByKind(kind: int, leftValue: int, rightValue: int) -> int \{\n")
    p.push("    if kind == 1 \{ return runtimeCompareStrings(leftValue, rightValue) \}\n")
    p.push("    if kind == 2 \{\n")
    p.push("        let leftFloat = frombits(leftValue)\n")
    p.push("        let rightFloat = frombits(rightValue)\n")
    p.push("        if leftFloat < rightFloat \{ return 0 - 1 \}\n")
    p.push("        if leftFloat > rightFloat \{ return 1 \}\n")
    p.push("        return 0\n")
    p.push("    \}\n")
    p.push("    if leftValue < rightValue \{ return 0 - 1 \}\n")
    p.push("    if leftValue > rightValue \{ return 1 \}\n")
    p.push("    return 0\n")
    p.push("\}\n")
    p.push("fn runtimeSiftHeap(data: int, count: int, start: int, kind: int) \{\n")
    p.push("    var root = start\n")
    p.push("    var going = true\n")
    p.push("    while going \{\n")
    p.push("        let child = 2 * root + 1\n")
    p.push("        if child >= count \{\n")
    p.push("            going = false\n")
    p.push("            continue\n")
    p.push("        \}\n")
    p.push("        var largestIndex = root\n")
    p.push("        if runtimeCompareValuesByKind(kind, load64(data + largestIndex * 8), load64(data + child * 8)) < 0 \{ largestIndex = child \}\n")
    p.push("        if child + 1 < count \{\n")
    p.push("            if runtimeCompareValuesByKind(kind, load64(data + largestIndex * 8), load64(data + child * 8 + 8)) < 0 \{ largestIndex = child + 1 \}\n")
    p.push("        \}\n")
    p.push("        if largestIndex == root \{\n")
    p.push("            going = false\n")
    p.push("            continue\n")
    p.push("        \}\n")
    p.push("        let savedValue = load64(data + root * 8)\n")
    p.push("        store64(data + root * 8, load64(data + largestIndex * 8))\n")
    p.push("        store64(data + largestIndex * 8, savedValue)\n")
    p.push("        root = largestIndex\n")
    p.push("    \}\n")
    p.push("\}\n")
    p.push("fn runtimeSwapSortElements(data: int, index: int, otherIndex: int) \{\n")
    p.push("    let savedValue = load64(data + index * 8)\n")
    p.push("    store64(data + index * 8, load64(data + otherIndex * 8))\n")
    p.push("    store64(data + otherIndex * 8, savedValue)\n")
    p.push("\}\n")
    p.push("// heapsort restricted to [lo, hi] -- the introsort depth-limit fallback that\n")
    p.push("// keeps the worst case O(n log n).\n")
    p.push("fn runtimeHeapSortRange(data: int, lowerBound: int, upperBound: int, kind: int) \{\n")
    p.push("    let rangeAddress = data + lowerBound * 8\n")
    p.push("    let rangeLength = upperBound - lowerBound + 1\n")
    p.push("    var index = rangeLength / 2 - 1\n")
    p.push("    while index >= 0 \{\n")
    p.push("        runtimeSiftHeap(rangeAddress, rangeLength, index, kind)\n")
    p.push("        index -= 1\n")
    p.push("    \}\n")
    p.push("    var heapEnd = rangeLength - 1\n")
    p.push("    while heapEnd > 0 \{\n")
    p.push("        let savedValue = load64(rangeAddress)\n")
    p.push("        store64(rangeAddress, load64(rangeAddress + heapEnd * 8))\n")
    p.push("        store64(rangeAddress + heapEnd * 8, savedValue)\n")
    p.push("        runtimeSiftHeap(rangeAddress, heapEnd, 0, kind)\n")
    p.push("        heapEnd -= 1\n")
    p.push("    \}\n")
    p.push("\}\n")
    p.push("// median-of-three Hoare partition; pivot is an element value so it always\n")
    p.push("// terminates. Returns the split index j: [lo, j] and [j+1, hi].\n")
    p.push("fn runtimePartition(data: int, lowerBound: int, upperBound: int, kind: int) -> int \{\n")
    p.push("    let middleIndex = lowerBound + (upperBound - lowerBound) / 2\n")
    p.push("    if runtimeCompareValuesByKind(kind, load64(data + middleIndex * 8), load64(data + lowerBound * 8)) < 0 \{ runtimeSwapSortElements(data, lowerBound, middleIndex) \}\n")
    p.push("    if runtimeCompareValuesByKind(kind, load64(data + upperBound * 8), load64(data + lowerBound * 8)) < 0 \{ runtimeSwapSortElements(data, lowerBound, upperBound) \}\n")
    p.push("    if runtimeCompareValuesByKind(kind, load64(data + upperBound * 8), load64(data + middleIndex * 8)) < 0 \{ runtimeSwapSortElements(data, middleIndex, upperBound) \}\n")
    p.push("    let pivot = load64(data + middleIndex * 8)\n")
    p.push("    var index = lowerBound - 1\n")
    p.push("    var otherIndex = upperBound + 1\n")
    p.push("    var result = 0\n")
    p.push("    var done = false\n")
    p.push("    while not done \{\n")
    p.push("        index += 1\n")
    p.push("        while runtimeCompareValuesByKind(kind, load64(data + index * 8), pivot) < 0 \{ index += 1 \}\n")
    p.push("        otherIndex -= 1\n")
    p.push("        while runtimeCompareValuesByKind(kind, load64(data + otherIndex * 8), pivot) > 0 \{ otherIndex -= 1 \}\n")
    p.push("        if index >= otherIndex \{\n")
    p.push("            result = otherIndex\n")
    p.push("            done = true\n")
    p.push("        \} else \{\n")
    p.push("            runtimeSwapSortElements(data, index, otherIndex)\n")
    p.push("        \}\n")
    p.push("    \}\n")
    p.push("    return result\n")
    p.push("\}\n")
    p.push("// introsort: quicksort, recursing into the smaller partition and looping on the\n")
    p.push("// larger (stack depth O(log n)); drop to heapsort when recursion gets too deep.\n")
    p.push("fn runtimeIntrospectiveSort(data: int, initialLowerBound: int, initialUpperBound: int, initialDepth: int, kind: int) \{\n")
    p.push("    var lowerBound = initialLowerBound\n")
    p.push("    var upperBound = initialUpperBound\n")
    p.push("    var depth = initialDepth\n")
    p.push("    while upperBound - lowerBound > 16 \{\n")
    p.push("        if depth <= 0 \{\n")
    p.push("            runtimeHeapSortRange(data, lowerBound, upperBound, kind)\n")
    p.push("            return\n")
    p.push("        \}\n")
    p.push("        depth -= 1\n")
    p.push("        let partitionIndex = runtimePartition(data, lowerBound, upperBound, kind)\n")
    p.push("        if partitionIndex - lowerBound < upperBound - partitionIndex - 1 \{\n")
    p.push("            runtimeIntrospectiveSort(data, lowerBound, partitionIndex, depth, kind)\n")
    p.push("            lowerBound = partitionIndex + 1\n")
    p.push("        \} else \{\n")
    p.push("            runtimeIntrospectiveSort(data, partitionIndex + 1, upperBound, depth, kind)\n")
    p.push("            upperBound = partitionIndex\n")
    p.push("        \}\n")
    p.push("    \}\n")
    p.push("\}\n")
    p.push("// finishing pass: ranges left <= 16 wide by introsort are nearly sorted, so one\n")
    p.push("// insertion sort over the whole array is O(n) with a tiny constant.\n")
    p.push("fn runtimeInsertionSort(data: int, lowerBound: int, upperBound: int, kind: int) \{\n")
    p.push("    var index = lowerBound + 1\n")
    p.push("    while index <= upperBound \{\n")
    p.push("        let value = load64(data + index * 8)\n")
    p.push("        var otherIndex = index - 1\n")
    p.push("        var going = true\n")
    p.push("        while going and otherIndex >= lowerBound \{\n")
    p.push("            if runtimeCompareValuesByKind(kind, load64(data + otherIndex * 8), value) > 0 \{\n")
    p.push("                store64(data + (otherIndex + 1) * 8, load64(data + otherIndex * 8))\n")
    p.push("                otherIndex -= 1\n")
    p.push("            \} else \{\n")
    p.push("                going = false\n")
    p.push("            \}\n")
    p.push("        \}\n")
    p.push("        store64(data + (otherIndex + 1) * 8, value)\n")
    p.push("        index += 1\n")
    p.push("    \}\n")
    p.push("\}\n")
    p.push("// ---- int-specialized introsort: same structure, but comparisons are inline\n")
    p.push("// `<`/`>` on loaded values instead of a call to runtimeCompareValuesByKind per compare. The\n")
    p.push("// call overhead dominates a generic sort, so this is the path that matters. ----\n")
    p.push("fn runtimeHeapSortIntegerRange(data: int, lowerBound: int, upperBound: int) \{\n")
    p.push("    let rangeAddress = data + lowerBound * 8\n")
    p.push("    let rangeLength = upperBound - lowerBound + 1\n")
    p.push("    var index = rangeLength / 2 - 1\n")
    p.push("    while index >= 0 \{\n")
    p.push("        var root = index\n")
    p.push("        var going = true\n")
    p.push("        while going \{\n")
    p.push("            let child = 2 * root + 1\n")
    p.push("            if child >= rangeLength \{\n")
    p.push("                going = false\n")
    p.push("            \} else \{\n")
    p.push("                var largestIndex = root\n")
    p.push("                if load64(rangeAddress + largestIndex * 8) < load64(rangeAddress + child * 8) \{ largestIndex = child \}\n")
    p.push("                if child + 1 < rangeLength and load64(rangeAddress + largestIndex * 8) < load64(rangeAddress + child * 8 + 8) \{ largestIndex = child + 1 \}\n")
    p.push("                if largestIndex == root \{\n")
    p.push("                    going = false\n")
    p.push("                \} else \{\n")
    p.push("                    runtimeSwapSortElements(rangeAddress, root, largestIndex)\n")
    p.push("                    root = largestIndex\n")
    p.push("                \}\n")
    p.push("            \}\n")
    p.push("        \}\n")
    p.push("        index -= 1\n")
    p.push("    \}\n")
    p.push("    var heapEnd = rangeLength - 1\n")
    p.push("    while heapEnd > 0 \{\n")
    p.push("        runtimeSwapSortElements(rangeAddress, 0, heapEnd)\n")
    p.push("        var root = 0\n")
    p.push("        var going = true\n")
    p.push("        while going \{\n")
    p.push("            let child = 2 * root + 1\n")
    p.push("            if child >= heapEnd \{\n")
    p.push("                going = false\n")
    p.push("            \} else \{\n")
    p.push("                var largestIndex = root\n")
    p.push("                if load64(rangeAddress + largestIndex * 8) < load64(rangeAddress + child * 8) \{ largestIndex = child \}\n")
    p.push("                if child + 1 < heapEnd and load64(rangeAddress + largestIndex * 8) < load64(rangeAddress + child * 8 + 8) \{ largestIndex = child + 1 \}\n")
    p.push("                if largestIndex == root \{\n")
    p.push("                    going = false\n")
    p.push("                \} else \{\n")
    p.push("                    runtimeSwapSortElements(rangeAddress, root, largestIndex)\n")
    p.push("                    root = largestIndex\n")
    p.push("                \}\n")
    p.push("            \}\n")
    p.push("        \}\n")
    p.push("        heapEnd -= 1\n")
    p.push("    \}\n")
    p.push("\}\n")
    p.push("// Branchless Lomuto partition (the pdqsort / Alexandrescu technique). The\n")
    p.push("// median-of-3 pivot is parked at a[hi]; the scan swaps a[r] and a[w]\n")
    p.push("// UNCONDITIONALLY -- when a[r] >= pivot both slots hold >=pivot elements, so\n")
    p.push("// the exchange is harmless -- and advances w by the comparison RESULT computed\n")
    p.push("// arithmetically (overflow-safe signed less-than via sign bits). Zero\n")
    p.push("// data-dependent branches: random data costs no branch mispredictions, which\n")
    p.push("// is where a classic Hoare scan loses half its time. Returns w with the pivot\n")
    p.push("// fixed at a[w]: [lo, w-1] < pivot, [w+1, hi] >= pivot.\n")
    p.push("fn runtimePartitionInteger(data: int, lowerBound: int, upperBound: int) -> int \{\n")
    p.push("    let middleIndex = lowerBound + (upperBound - lowerBound) / 2\n")
    p.push("    if load64(data + middleIndex * 8) < load64(data + lowerBound * 8) \{ runtimeSwapSortElements(data, lowerBound, middleIndex) \}\n")
    p.push("    if load64(data + upperBound * 8) < load64(data + lowerBound * 8) \{ runtimeSwapSortElements(data, lowerBound, upperBound) \}\n")
    p.push("    if load64(data + upperBound * 8) < load64(data + middleIndex * 8) \{ runtimeSwapSortElements(data, middleIndex, upperBound) \}\n")
    p.push("    runtimeSwapSortElements(data, middleIndex, upperBound)               // park the median at hi\n")
    p.push("    let pivotValue = load64(data + upperBound * 8)\n")
    p.push("    var writeIndex = lowerBound\n")
    p.push("    var readIndex = lowerBound\n")
    p.push("    while readIndex < upperBound \{\n")
    p.push("        // one temp only, so register promotion covers every hot value here\n")
    p.push("        // (data, w, r, p, x, hi -> six callee-saved registers, zero spills)\n")
    p.push("        let value = load64(data + readIndex * 8)\n")
    p.push("        store64(data + readIndex * 8, load64(data + writeIndex * 8))\n")
    p.push("        store64(data + writeIndex * 8, value)\n")
    p.push("        writeIndex += ((((value - pivotValue) ^ ((value ^ pivotValue) & ((value - pivotValue) ^ value))) >> 63) & 1)   // w += (x < p)\n")
    p.push("        readIndex += 1\n")
    p.push("    \}\n")
    p.push("    runtimeSwapSortElements(data, writeIndex, upperBound)                 // pivot into its final slot\n")
    p.push("    return writeIndex\n")
    p.push("\}\n")
    p.push("fn runtimeIntrospectiveSortIntegers(data: int, initialLowerBound: int, initialUpperBound: int, initialDepth: int) \{\n")
    p.push("    var lowerBound = initialLowerBound\n")
    p.push("    var upperBound = initialUpperBound\n")
    p.push("    var depth = initialDepth\n")
    p.push("    while upperBound - lowerBound > 24 \{\n")
    p.push("        if depth <= 0 \{\n")
    p.push("            runtimeHeapSortIntegerRange(data, lowerBound, upperBound)\n")
    p.push("            return\n")
    p.push("        \}\n")
    p.push("        depth -= 1\n")
    p.push("        let pivotIndex = runtimePartitionInteger(data, lowerBound, upperBound)     // pivot is FIXED at a[w]\n")
    p.push("        // skip the run of pivot-equal elements after w: with many duplicates\n")
    p.push("        // (or an all-equal range) this is what keeps the right side shrinking\n")
    p.push("        let pivotValue = load64(data + pivotIndex * 8)\n")
    p.push("        var rightStart = pivotIndex + 1\n")
    p.push("        while rightStart <= upperBound and load64(data + rightStart * 8) == pivotValue \{ rightStart += 1 \}\n")
    p.push("        if pivotIndex - lowerBound < upperBound - rightStart \{\n")
    p.push("            runtimeIntrospectiveSortIntegers(data, lowerBound, pivotIndex - 1, depth)\n")
    p.push("            lowerBound = rightStart\n")
    p.push("        \} else \{\n")
    p.push("            runtimeIntrospectiveSortIntegers(data, rightStart, upperBound, depth)\n")
    p.push("            upperBound = pivotIndex - 1\n")
    p.push("        \}\n")
    p.push("    \}\n")
    p.push("\}\n")
    p.push("fn runtimeInsertionSortIntegers(data: int, lowerBound: int, upperBound: int) \{\n")
    p.push("    var index = lowerBound + 1\n")
    p.push("    while index <= upperBound \{\n")
    p.push("        let value = load64(data + index * 8)\n")
    p.push("        var otherIndex = index - 1\n")
    p.push("        var going = true\n")
    p.push("        while going and otherIndex >= lowerBound \{\n")
    p.push("            if load64(data + otherIndex * 8) > value \{\n")
    p.push("                store64(data + (otherIndex + 1) * 8, load64(data + otherIndex * 8))\n")
    p.push("                otherIndex -= 1\n")
    p.push("            \} else \{\n")
    p.push("                going = false\n")
    p.push("            \}\n")
    p.push("        \}\n")
    p.push("        store64(data + (otherIndex + 1) * 8, value)\n")
    p.push("        index += 1\n")
    p.push("    \}\n")
    p.push("\}\n")
    p.push("fn runtimeSortListValues(listAddress: int, kind: int) \{\n")
    p.push("    let count = load64(listAddress)\n")
    p.push("    if count < 2 \{ return \}\n")
    p.push("    let data = load64(listAddress + 16)\n")
    p.push("    var depth = 0\n")
    p.push("    var remainingLength = count\n")
    p.push("    while remainingLength > 0 \{\n")
    p.push("        depth += 1\n")
    p.push("        remainingLength = remainingLength / 2\n")
    p.push("    \}\n")
    p.push("    depth = depth * 2\n")
    p.push("    if kind == 0 \{\n")
    p.push("        runtimeIntrospectiveSortIntegers(data, 0, count - 1, depth)\n")
    p.push("        runtimeInsertionSortIntegers(data, 0, count - 1)\n")
    p.push("    \} else \{\n")
    p.push("        runtimeIntrospectiveSort(data, 0, count - 1, depth, kind)\n")
    p.push("        runtimeInsertionSort(data, 0, count - 1, kind)\n")
    p.push("    \}\n")
    p.push("\}\n")
    p.push("fn runtimeListSortInteger(listAddress: int) \{ runtimeSortListValues(listAddress, 0) \}\n")
    p.push("fn runtimeListSortString(listAddress: int) \{ runtimeSortListValues(listAddress, 1) \}\n")
    p.push("fn runtimeListSortFloat(listAddress: int) \{ runtimeSortListValues(listAddress, 2) \}\n")
    p.push("\n")
    p.push("fn runtimeListIndexOf(listAddress: int, value: int) -> int \{\n")
    p.push("    let count = load64(listAddress)\n")
    p.push("    let data = load64(listAddress + 16)\n")
    p.push("    var index = 0\n")
    p.push("    while index < count \{\n")
    p.push("        if load64(data + index * 8) == value \{ return index \}\n")
    p.push("        index += 1\n")
    p.push("    \}\n")
    p.push("    return 0 - 1\n")
    p.push("\}\n")
    p.push("fn runtimeListIndexOfString(listAddress: int, value: int) -> int \{\n")
    p.push("    let count = load64(listAddress)\n")
    p.push("    let data = load64(listAddress + 16)\n")
    p.push("    var index = 0\n")
    p.push("    while index < count \{\n")
    p.push("        if runtimeStringsEqual(load64(data + index * 8), value) == 1 \{ return index \}\n")
    p.push("        index += 1\n")
    p.push("    \}\n")
    p.push("    return 0 - 1\n")
    p.push("\}\n")
    p.push("fn runtimeListReverse(listAddress: int) \{\n")
    p.push("    let count = load64(listAddress)\n")
    p.push("    let data = load64(listAddress + 16)\n")
    p.push("    var index = 0\n")
    p.push("    var otherIndex = count - 1\n")
    p.push("    while index < otherIndex \{\n")
    p.push("        let leftValue = load64(data + index * 8)\n")
    p.push("        let rightValue = load64(data + otherIndex * 8)\n")
    p.push("        store64(data + index * 8, rightValue)\n")
    p.push("        store64(data + otherIndex * 8, leftValue)\n")
    p.push("        index += 1\n")
    p.push("        otherIndex -= 1\n")
    p.push("    \}\n")
    p.push("\}\n")
    p.push("fn runtimeListSlice(listAddress: int, lowerBound: int, upperBound: int) -> int \{\n")
    p.push("    let count = load64(listAddress)\n")
    p.push("    if lowerBound < 0 or upperBound < lowerBound or upperBound > count \{ runtimeFail(\"invalid slice\") \}\n")
    p.push("    let data = load64(listAddress + 16)\n")
    p.push("    let output = runtimeNewDescribedList(upperBound - lowerBound, load64(listAddress - 16))\n")
    p.push("    runtimeCopyMemory(load64(output + 16), data + lowerBound * 8, (upperBound - lowerBound) * 8)\n")
    p.push("    if runtimeMapKeyIsReference(listAddress) == 1 \{                  // kind 2: [8] is the element flag\n")
    p.push("        var index = lowerBound\n")
    p.push("        while index < upperBound \{\n")
    p.push("            let retainedValue = runtimeRetainReference(load64(data + index * 8))\n")
    p.push("            index += 1\n")
    p.push("        \}\n")
    p.push("    \}\n")
    p.push("    return output\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn runtimeJoinStringList(listAddress: int) -> int \{\n")
    p.push("    let count = load64(listAddress)\n")
    p.push("    let data = load64(listAddress + 16)\n")
    p.push("    var total = 0\n")
    p.push("    var index = 0\n")
    p.push("    while index < count \{\n")
    p.push("        total += load64(load64(data + index * 8))\n")
    p.push("        index += 1\n")
    p.push("    \}\n")
    p.push("    let result = runtimeAllocateString(total)\n")
    p.push("    var offset = 0\n")
    p.push("    index = 0\n")
    p.push("    while index < count \{\n")
    p.push("        let part = load64(data + index * 8)\n")
    p.push("        let partLength = load64(part)\n")
    p.push("        runtimeCopyMemory(result + 8 + offset, part + 8, partLength)\n")
    p.push("        offset += partLength\n")
    p.push("        index += 1\n")
    p.push("    \}\n")
    p.push("    return result\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// xs.join(separator)\n")
    p.push("fn runtimeJoinStringListWithSeparator(listAddress: int, separator: int) -> int \{\n")
    p.push("    let count = load64(listAddress)\n")
    p.push("    let data = load64(listAddress + 16)\n")
    p.push("    let separatorLength = load64(separator)\n")
    p.push("    var total = 0\n")
    p.push("    var index = 0\n")
    p.push("    while index < count \{\n")
    p.push("        total += load64(load64(data + index * 8))\n")
    p.push("        index += 1\n")
    p.push("    \}\n")
    p.push("    if count > 1 \{ total += separatorLength * (count - 1) \}\n")
    p.push("    let result = runtimeAllocateString(total)\n")
    p.push("    var offset = 0\n")
    p.push("    index = 0\n")
    p.push("    while index < count \{\n")
    p.push("        if index > 0 \{\n")
    p.push("            runtimeCopyMemory(result + 8 + offset, separator + 8, separatorLength)\n")
    p.push("            offset += separatorLength\n")
    p.push("        \}\n")
    p.push("        let part = load64(data + index * 8)\n")
    p.push("        let partLength = load64(part)\n")
    p.push("        runtimeCopyMemory(result + 8 + offset, part + 8, partLength)\n")
    p.push("        offset += partLength\n")
    p.push("        index += 1\n")
    p.push("    \}\n")
    p.push("    return result\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn runtimeStringToInteger(stringAddress: int) -> int \{\n")
    p.push("    let stringLength = load64(stringAddress)\n")
    p.push("    var index = 0\n")
    p.push("    while index < stringLength and load8(stringAddress + 8 + index) == 32 \{ index += 1 \}\n")
    p.push("    var isNegative = false\n")
    p.push("    if index < stringLength and (load8(stringAddress + 8 + index) == 43 or load8(stringAddress + 8 + index) == 45) \{\n")
    p.push("        if load8(stringAddress + 8 + index) == 45 \{ isNegative = true \}\n")
    p.push("        index += 1\n")
    p.push("    \}\n")
    p.push("    var value = 0\n")
    p.push("    var sawDigit = false\n")
    p.push("    while index < stringLength \{\n")
    p.push("        let character = load8(stringAddress + 8 + index)\n")
    p.push("        if character < 48 or character > 57 \{ break \}\n")
    p.push("        value = value * 10 + (character - 48)\n")
    p.push("        sawDigit = true\n")
    p.push("        index += 1\n")
    p.push("    \}\n")
    p.push("    while index < stringLength and load8(stringAddress + 8 + index) == 32 \{ index += 1 \}\n")
    p.push("    if not sawDigit or index != stringLength \{ runtimeFail(\"cannot convert to int\") \}\n")
    p.push("    if isNegative \{ return 0 - value \}\n")
    p.push("    return value\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// decimal float parser (sign, integer part, fraction; no exponent yet).\n")
    p.push("// returns the IEEE-754 bit pattern, which is what a float value is.\n")
    p.push("fn runtimeStringToFloat(stringAddress: int) -> int \{\n")
    p.push("    let stringLength = load64(stringAddress)\n")
    p.push("    var index = 0\n")
    p.push("    while index < stringLength and load8(stringAddress + 8 + index) == 32 \{ index += 1 \}\n")
    p.push("    var isNegative = false\n")
    p.push("    if index < stringLength and (load8(stringAddress + 8 + index) == 43 or load8(stringAddress + 8 + index) == 45) \{\n")
    p.push("        if load8(stringAddress + 8 + index) == 45 \{ isNegative = true \}\n")
    p.push("        index += 1\n")
    p.push("    \}\n")
    p.push("    // Collect every digit into an integer mantissa and count the fractional\n")
    p.push("    // ones, then divide ONCE. Both the mantissa (< 2^53) and 10^k (k <= 22)\n")
    p.push("    // are exactly representable, so a single rounding lands on the same double\n")
    p.push("    // strtod would produce -- accumulating digit-by-digit with a 0.1 scale\n")
    p.push("    // instead lets a rounding error compound per digit, which put literals\n")
    p.push("    // like 1.72 and 0.09 one or two ulp off every other language's value.\n")
    p.push("    var mantissa = 0\n")
    p.push("    var mantissaDigitCount = 0                                     // digits kept in mant\n")
    p.push("    var fractionalDigitCount = 0                                      // fractional digits\n")
    p.push("    var droppedDigitCount = 0                                  // integer digits dropped\n")
    p.push("    var sawDigit = false\n")
    p.push("    while index < stringLength and load8(stringAddress + 8 + index) >= 48 and load8(stringAddress + 8 + index) <= 57 \{\n")
    p.push("        let integerDigit = load8(stringAddress + 8 + index) - 48\n")
    p.push("        if mantissa == 0 and integerDigit == 0 \{\n")
    p.push("            // a leading zero carries no information; spending mantissa budget on\n")
    p.push("            // it would push real digits off the end\n")
    p.push("        \} else if mantissaDigitCount < 17 \{\n")
    p.push("            mantissa = mantissa * 10 + integerDigit\n")
    p.push("            mantissaDigitCount += 1\n")
    p.push("        \} else \{\n")
    p.push("            droppedDigitCount += 1                             // too big for exact mantissa\n")
    p.push("        \}\n")
    p.push("        sawDigit = true\n")
    p.push("        index += 1\n")
    p.push("    \}\n")
    p.push("    if index < stringLength and load8(stringAddress + 8 + index) == 46 \{          // '.'\n")
    p.push("        index += 1\n")
    p.push("        while index < stringLength and load8(stringAddress + 8 + index) >= 48 and load8(stringAddress + 8 + index) <= 57 \{\n")
    p.push("            let fractionDigit = load8(stringAddress + 8 + index) - 48\n")
    p.push("            if mantissa == 0 and fractionDigit == 0 \{\n")
    p.push("                fractionalDigitCount += 1                             // shifts the value, adds no digit\n")
    p.push("            \} else if mantissaDigitCount < 17 \{\n")
    p.push("                mantissa = mantissa * 10 + fractionDigit\n")
    p.push("                mantissaDigitCount += 1\n")
    p.push("                fractionalDigitCount += 1\n")
    p.push("            \}\n")
    p.push("            sawDigit = true\n")
    p.push("            index += 1\n")
    p.push("        \}\n")
    p.push("    \}\n")
    p.push("    // optional exponent: e/E, a sign, digits\n")
    p.push("    var exponent = 0\n")
    p.push("    if sawDigit and index < stringLength and (load8(stringAddress + 8 + index) == 101 or load8(stringAddress + 8 + index) == 69) \{\n")
    p.push("        var exponentIndex = index + 1\n")
    p.push("        var exponentNegative = false\n")
    p.push("        if exponentIndex < stringLength and (load8(stringAddress + 8 + exponentIndex) == 43 or load8(stringAddress + 8 + exponentIndex) == 45) \{\n")
    p.push("            if load8(stringAddress + 8 + exponentIndex) == 45 \{ exponentNegative = true \}\n")
    p.push("            exponentIndex += 1\n")
    p.push("        \}\n")
    p.push("        if exponentIndex < stringLength and load8(stringAddress + 8 + exponentIndex) >= 48 and load8(stringAddress + 8 + exponentIndex) <= 57 \{\n")
    p.push("            while exponentIndex < stringLength and load8(stringAddress + 8 + exponentIndex) >= 48 and load8(stringAddress + 8 + exponentIndex) <= 57 \{\n")
    p.push("                if exponent < 100000 \{ exponent = exponent * 10 + load8(stringAddress + 8 + exponentIndex) - 48 \}\n")
    p.push("                exponentIndex += 1\n")
    p.push("            \}\n")
    p.push("            if exponentNegative \{ exponent = 0 - exponent \}\n")
    p.push("            index = exponentIndex\n")
    p.push("        \}\n")
    p.push("    \}\n")
    p.push("    // One multiply or divide by an exact power of ten (10^22 and below are\n")
    p.push("    // exact) rounds once, landing on strtod's answer. Larger scales go in\n")
    p.push("    // exact 10^22 steps and may be off by an ulp.\n")
    p.push("    var value = mantissa as float\n")
    p.push("    var scale = droppedDigitCount - fractionalDigitCount + exponent\n")
    p.push("    while scale > 22 \{\n")
    p.push("        value = value * 10000000000000000000000.0\n")
    p.push("        scale -= 22\n")
    p.push("    \}\n")
    p.push("    while scale < -22 \{\n")
    p.push("        value = value / 10000000000000000000000.0\n")
    p.push("        scale += 22\n")
    p.push("    \}\n")
    p.push("    var power = 1.0\n")
    p.push("    var steps = 0\n")
    p.push("    var magnitude = scale\n")
    p.push("    if magnitude < 0 \{ magnitude = 0 - magnitude \}\n")
    p.push("    while steps < magnitude \{\n")
    p.push("        power = power * 10.0\n")
    p.push("        steps += 1\n")
    p.push("    \}\n")
    p.push("    if scale > 0 \{ value = value * power \}\n")
    p.push("    if scale < 0 \{ value = value / power \}\n")
    p.push("    while index < stringLength and load8(stringAddress + 8 + index) == 32 \{ index += 1 \}\n")
    p.push("    if not sawDigit or index != stringLength \{ runtimeFail(\"cannot convert to float\") \}\n")
    p.push("    if isNegative \{ value = -value \}                  // not 0.0 - val: \"-0\" must parse as -0.0\n")
    p.push("    return bits(value)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// ---- lists ----  (a list value points to \{i64 len; i64 cap; i64 data\})\n")
    p.push("// Called by name from the compiler; a list whose elements it will not drop.\n")
    p.push("fn runtimeListNew(initialLength: int) -> int \{\n")
    p.push("    return runtimeNewDescribedList(initialLength, 0)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// `desc` is a kind-2 descriptor saying whether the elements are references.\n")
    p.push("fn runtimeNewDescribedList(initialLength: int, descriptor: int) -> int \{\n")
    p.push("    var shapeDescriptor = descriptor\n")
    p.push("    if shapeDescriptor == 0 \{ shapeDescriptor = runtimeValueListDescriptor \}    // the data buffer still has to go when the list does\n")
    p.push("    let listAddress = runtimeAllocateDescribedObject(24, shapeDescriptor)\n")
    p.push("    var capacity = initialLength\n")
    p.push("    if capacity < 4 \{ capacity = 4 \}\n")
    p.push("    let data = runtimeAllocateObject(capacity * 8)\n")
    p.push("    store64(listAddress, initialLength)\n")
    p.push("    store64(listAddress + 8, capacity)\n")
    p.push("    store64(listAddress + 16, data)\n")
    p.push("    return listAddress\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn runtimeListPush(listAddress: int, value: int) \{\n")
    p.push("    let count = load64(listAddress)\n")
    p.push("    let capacity = load64(listAddress + 8)\n")
    p.push("    if count == capacity \{\n")
    p.push("        let newCapacity = capacity * 2\n")
    p.push("        let newData = runtimeAllocateObject(newCapacity * 8)\n")
    p.push("        let oldData = load64(listAddress + 16)\n")
    p.push("        runtimeCopyMemory(newData, oldData, count * 8)\n")
    p.push("        store64(listAddress + 8, newCapacity)\n")
    p.push("        store64(listAddress + 16, newData)\n")
    p.push("        runtimeReleaseReference(oldData)                       // the cell was the buffer's only holder\n")
    p.push("    \}\n")
    p.push("    store64(load64(listAddress + 16) + count * 8, value)\n")
    p.push("    store64(listAddress, count + 1)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn runtimeListPop(listAddress: int) -> int \{\n")
    p.push("    let count = load64(listAddress)\n")
    p.push("    if count == 0 \{ runtimeFail(\"pop from empty list\") \}\n")
    p.push("    store64(listAddress, count - 1)\n")
    p.push("    return load64(load64(listAddress + 16) + (count - 1) * 8)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// ---- packed lists: [u8] and [f32] ----\n")
    p.push("// The list header \{len, cap, data\}, but with 1- or 4-byte elements. An f32 is\n")
    p.push("// stored as its 32-bit pattern and enters Zephyr as a float (a double):\n")
    p.push("// runtimeWidenFloat32Bits on the way out, runtimeNarrowFloat32Bits (round to nearest even) on the way in.\n")
    p.push("fn runtimeNewPackedList(elementCount: int, width: int) -> int \{\n")
    p.push("    let listAddress = runtimeAllocateDescribedObject(24, runtimeValueListDescriptor)\n")
    p.push("    var capacity = elementCount\n")
    p.push("    if capacity < 4 \{ capacity = 4 \}\n")
    p.push("    store64(listAddress, elementCount)\n")
    p.push("    store64(listAddress + 8, capacity)\n")
    p.push("    store64(listAddress + 16, runtimeAllocateObject(capacity * width))\n")
    p.push("    return listAddress\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn runtimeFailPackedAccess(site: str, message: str) \{\n")
    p.push("    let handle = win(\"GetStdHandle\", 0 - 12)   // stderr\n")
    p.push("    runtimeWriteOutputBytes(handle, addr(\"panic: \") + 8, 7)\n")
    p.push("    runtimeWriteOutputBytes(handle, addr(site) + 8, site.len())\n")
    p.push("    runtimeWriteOutputBytes(handle, addr(message) + 8, message.len())\n")
    p.push("    runtimeWriteOutputBytes(handle, addr(\"\\n\") + 8, 1)\n")
    p.push("    let result = win(\"ExitProcess\", 1)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn runtimeWidenFloat32Bits(bits32: int) -> int \{\n")
    p.push("    let sign = (bits32 >> 31) & 1\n")
    p.push("    var exponent = (bits32 >> 23) & 255\n")
    p.push("    var mantissa = bits32 & 8388607\n")
    p.push("    if exponent == 255 \{ return (sign << 63) | (2047 << 52) | (mantissa << 29) \}   // inf, nan\n")
    p.push("    if exponent == 0 \{\n")
    p.push("        if mantissa == 0 \{ return sign << 63 \}\n")
    p.push("        exponent = 1                      // subnormal: normalize the mantissa\n")
    p.push("        while mantissa & 8388608 == 0 \{\n")
    p.push("            mantissa = mantissa << 1\n")
    p.push("            exponent -= 1\n")
    p.push("        \}\n")
    p.push("        mantissa = mantissa & 8388607\n")
    p.push("    \}\n")
    p.push("    return (sign << 63) | ((exponent + 896) << 52) | (mantissa << 29)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn runtimeNarrowFloat32Bits(bits: int) -> int \{\n")
    p.push("    let sign = (bits >> 63) & 1\n")
    p.push("    let exponent = (bits >> 52) & 2047\n")
    p.push("    let mantissa = bits & 4503599627370495\n")
    p.push("    if exponent == 2047 \{\n")
    p.push("        if mantissa == 0 \{ return (sign << 31) | (255 << 23) \}\n")
    p.push("        return (sign << 31) | (255 << 23) | 4194304 | (mantissa >> 29)   // a quiet nan\n")
    p.push("    \}\n")
    p.push("    let biased = exponent - 896\n")
    p.push("    if biased >= 255 \{ return (sign << 31) | (255 << 23) \}             // too large: infinity\n")
    p.push("    if biased <= 0 \{                                                    // an f32 subnormal, or zero\n")
    p.push("        if biased < 0 - 24 \{ return sign << 31 \}\n")
    p.push("        let full = mantissa | 4503599627370496\n")
    p.push("        let shift = 30 - biased\n")
    p.push("        let kept = full >> shift\n")
    p.push("        let dropped = full & ((1 << shift) - 1)\n")
    p.push("        let half = 1 << (shift - 1)\n")
    p.push("        var rounded = kept\n")
    p.push("        if dropped > half or (dropped == half and kept & 1 == 1) \{ rounded += 1 \}\n")
    p.push("        return (sign << 31) | rounded\n")
    p.push("    \}\n")
    p.push("    let kept = mantissa >> 29\n")
    p.push("    let dropped = mantissa & 536870911\n")
    p.push("    var result = (biased << 23) | kept\n")
    p.push("    if dropped > 268435456 or (dropped == 268435456 and kept & 1 == 1) \{ result += 1 \}   // may carry to infinity\n")
    p.push("    return (sign << 31) | result\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn runtimePackedLoad(listAddress: int, index: int, width: int) -> int \{\n")
    p.push("    if width == 1 \{ return load8(load64(listAddress + 16) + index) \}\n")
    p.push("    return runtimeWidenFloat32Bits(load32(load64(listAddress + 16) + index * 4) & 4294967295)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn runtimePackedStore(listAddress: int, index: int, value: int, width: int) \{\n")
    p.push("    if width == 1 \{ store8(load64(listAddress + 16) + index, value & 255) \}\n")
    p.push("    else \{ store32(load64(listAddress + 16) + index * 4, runtimeNarrowFloat32Bits(value)) \}\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn runtimePackedGet(listAddress: int, index: int, width: int, site: str) -> int \{\n")
    p.push("    if index < 0 or index >= load64(listAddress) \{ runtimeFailPackedAccess(site, \"index out of bounds\") \}\n")
    p.push("    return runtimePackedLoad(listAddress, index, width)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn runtimePackedSet(listAddress: int, index: int, value: int, width: int, site: str) \{\n")
    p.push("    if index < 0 or index >= load64(listAddress) \{ runtimeFailPackedAccess(site, \"index out of bounds\") \}\n")
    p.push("    runtimePackedStore(listAddress, index, value, width)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn runtimePackedPush(listAddress: int, value: int, width: int) \{\n")
    p.push("    let count = load64(listAddress)\n")
    p.push("    let capacity = load64(listAddress + 8)\n")
    p.push("    if count == capacity \{\n")
    p.push("        let newCapacity = capacity * 2\n")
    p.push("        let newData = runtimeAllocateObject(newCapacity * width)\n")
    p.push("        let oldData = load64(listAddress + 16)\n")
    p.push("        runtimeCopyMemory(newData, oldData, count * width)\n")
    p.push("        store64(listAddress + 8, newCapacity)\n")
    p.push("        store64(listAddress + 16, newData)\n")
    p.push("        runtimeReleaseReference(oldData)\n")
    p.push("    \}\n")
    p.push("    store64(listAddress, count + 1)\n")
    p.push("    runtimePackedStore(listAddress, count, value, width)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn runtimePackedPop(listAddress: int, width: int, site: str) -> int \{\n")
    p.push("    let count = load64(listAddress)\n")
    p.push("    if count == 0 \{ runtimeFailPackedAccess(site, \"pop from empty list\") \}\n")
    p.push("    store64(listAddress, count - 1)\n")
    p.push("    return runtimePackedLoad(listAddress, count - 1, width)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn runtimeU8Get(listAddress: int, index: int, site: str) -> int \{ return runtimePackedGet(listAddress, index, 1, site) \}\n")
    p.push("fn runtimeF32Get(listAddress: int, index: int, site: str) -> int \{ return runtimePackedGet(listAddress, index, 4, site) \}\n")
    p.push("fn runtimeU8Set(listAddress: int, index: int, value: int, site: str) \{ runtimePackedSet(listAddress, index, value, 1, site) \}\n")
    p.push("fn runtimeF32Set(listAddress: int, index: int, value: int, site: str) \{ runtimePackedSet(listAddress, index, value, 4, site) \}\n")
    p.push("fn runtimeU8Push(listAddress: int, value: int) \{ runtimePackedPush(listAddress, value, 1) \}\n")
    p.push("fn runtimeF32Push(listAddress: int, value: int) \{ runtimePackedPush(listAddress, value, 4) \}\n")
    p.push("fn runtimeU8Pop(listAddress: int, site: str) -> int \{ return runtimePackedPop(listAddress, 1, site) \}\n")
    p.push("fn runtimeF32Pop(listAddress: int, site: str) -> int \{ return runtimePackedPop(listAddress, 4, site) \}\n")
    p.push("\n")
    p.push("// [int] as [u8] (low 8 bits), [float] as [f32]\n")
    p.push("fn runtimePackedFromList(source: int, width: int) -> int \{\n")
    p.push("    let count = load64(source)\n")
    p.push("    let packedList = runtimeNewPackedList(count, width)\n")
    p.push("    var index = 0\n")
    p.push("    while index < count \{\n")
    p.push("        runtimePackedStore(packedList, index, load64(load64(source + 16) + index * 8), width)\n")
    p.push("        index += 1\n")
    p.push("    \}\n")
    p.push("    return packedList\n")
    p.push("\}\n")
    p.push("fn runtimeU8FromList(source: int) -> int \{ return runtimePackedFromList(source, 1) \}\n")
    p.push("fn runtimeF32FromList(source: int) -> int \{ return runtimePackedFromList(source, 4) \}\n")
    p.push("\n")
    p.push("// [u8] as [int], [f32] as [float]\n")
    p.push("fn runtimePackedToList(source: int, width: int) -> int \{\n")
    p.push("    let count = load64(source)\n")
    p.push("    let listAddress = runtimeListNew(count)\n")
    p.push("    var index = 0\n")
    p.push("    while index < count \{\n")
    p.push("        store64(load64(listAddress + 16) + index * 8, runtimePackedLoad(source, index, width))\n")
    p.push("        index += 1\n")
    p.push("    \}\n")
    p.push("    return listAddress\n")
    p.push("\}\n")
    p.push("fn runtimeU8ToList(source: int) -> int \{ return runtimePackedToList(source, 1) \}\n")
    p.push("fn runtimeF32ToList(source: int) -> int \{ return runtimePackedToList(source, 4) \}\n")
    p.push("\n")
    p.push("fn runtimeU8FromString(stringAddress: int) -> int \{\n")
    p.push("    let stringLength = load64(stringAddress)\n")
    p.push("    let packedList = runtimeNewPackedList(stringLength, 1)\n")
    p.push("    runtimeCopyMemory(load64(packedList + 16), stringAddress + 8, stringLength)\n")
    p.push("    return packedList\n")
    p.push("\}\n")
    p.push("fn runtimeU8ToString(listAddress: int) -> int \{\n")
    p.push("    let byteCount = load64(listAddress)\n")
    p.push("    let text = runtimeAllocateString(byteCount)\n")
    p.push("    runtimeCopyMemory(text + 8, load64(listAddress + 16), byteCount)\n")
    p.push("    return text\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// ---- output: unbuffered WriteFile ----\n")
    p.push("var runtimeOutputScratchAddress = 0\n")
    p.push("var runtimeStandardOutputHandle = 0\n")
    p.push("\n")
    p.push("fn runtimeWriteOutputBytes(fileHandle: int, bytesAddress: int, byteCount: int) \{\n")
    p.push("    if runtimeOutputScratchAddress == 0 \{ runtimeOutputScratchAddress = runtimeAllocateObject(16) \}\n")
    p.push("    let result = win(\"WriteFile\", fileHandle, bytesAddress, byteCount, runtimeOutputScratchAddress, 0)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn runtimeGetStandardOutputHandle() -> int \{\n")
    p.push("    if runtimeStandardOutputHandle == 0 \{ runtimeStandardOutputHandle = win(\"GetStdHandle\", 0 - 11) \}\n")
    p.push("    return runtimeStandardOutputHandle\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn runtimeWriteOutputString(stringAddress: int) \{\n")
    p.push("    runtimeWriteOutputBytes(runtimeGetStandardOutputHandle(), stringAddress + 8, load64(stringAddress))\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// ---- panics ----\n")
    p.push("fn runtimeFail(message: str) \{\n")
    p.push("    let handle = win(\"GetStdHandle\", 0 - 12)   // stderr\n")
    p.push("    runtimeWriteOutputBytes(handle, addr(\"panic: \") + 8, 7)\n")
    p.push("    runtimeWriteOutputBytes(handle, addr(message) + 8, message.len())\n")
    p.push("    runtimeWriteOutputBytes(handle, addr(\"\\n\") + 8, 1)\n")
    p.push("    let result = win(\"ExitProcess\", 1)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn runtimePanicWithString(text: str) \{\n")
    p.push("    runtimeFail(text)                             // a str value already is its pointer\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn runtimeFailBoundsCheck(index: int, count: int) \{\n")
    p.push("    runtimeFail(\"index out of bounds\")\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn runtimeFailDivisionByZero() \{\n")
    p.push("    runtimeFail(\"division by zero\")\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn runtimeFailRemainderByZero() \{\n")
    p.push("    runtimeFail(\"modulo by zero\")\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// ---- formatting into the interpolation buffer ----\n")
    p.push("// The builder is per-thread. Its state is a 24-byte block -- [0] buffer,\n")
    p.push("// [8] length, [16] capacity -- reached through TLS once a second thread exists.\n")
    p.push("// The single-threaded fast path returns runtimeMainStringBuilder, which is also what the main\n")
    p.push("// thread's TLS slot holds, so the two paths cannot disagree about which block a\n")
    p.push("// half-finished interpolation is building into.\n")
    p.push("var runtimeMainStringBuilder = 0\n")
    p.push("var runtimeStringBuilderThreadLocalIndex = 0\n")
    p.push("\n")
    p.push("fn runtimeInitializeStringBuilders() \{\n")
    p.push("    if runtimeMainStringBuilder != 0 \{ return \}\n")
    p.push("    runtimeMainStringBuilder = win(\"VirtualAlloc\", 0, 64, 12288, 4)\n")
    p.push("    store64(runtimeMainStringBuilder, win(\"VirtualAlloc\", 0, 65536, 12288, 4))\n")
    p.push("    store64(runtimeMainStringBuilder + 8, 0)\n")
    p.push("    store64(runtimeMainStringBuilder + 16, 65536)\n")
    p.push("    runtimeStringBuilderThreadLocalIndex = win(\"TlsAlloc\")\n")
    p.push("    let result = win(\"TlsSetValue\", runtimeStringBuilderThreadLocalIndex, runtimeMainStringBuilder)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn runtimeGetStringBuilder() -> int \{\n")
    p.push("    // Formatting can happen before the first allocation (print(5) reaches the\n")
    p.push("    // builder without ever calling runtimeAllocateObject), so this guard cannot be dropped\n")
    p.push("    // in favour of initialising from runtimeInitializeHeap alone.\n")
    p.push("    if runtimeMainStringBuilder == 0 \{ runtimeInitializeStringBuilders() \}\n")
    p.push("    if runtimeRegisteredThreadCount == 0 \{ return runtimeMainStringBuilder \}\n")
    p.push("    var builderAddress = win(\"TlsGetValue\", runtimeStringBuilderThreadLocalIndex)\n")
    p.push("    if builderAddress == 0 \{\n")
    p.push("        builderAddress = win(\"VirtualAlloc\", 0, 64, 12288, 4)\n")
    p.push("        store64(builderAddress, win(\"VirtualAlloc\", 0, 65536, 12288, 4))\n")
    p.push("        store64(builderAddress + 8, 0)\n")
    p.push("        store64(builderAddress + 16, 65536)\n")
    p.push("        let result = win(\"TlsSetValue\", runtimeStringBuilderThreadLocalIndex, builderAddress)\n")
    p.push("    \}\n")
    p.push("    return builderAddress\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn runtimeEnsureStringBuilderCapacity(builderAddress: int, extra: int) \{\n")
    p.push("    let usedLength = load64(builderAddress + 8)\n")
    p.push("    let capacity = load64(builderAddress + 16)\n")
    p.push("    if usedLength + extra <= capacity \{ return \}\n")
    p.push("    var newCapacity = capacity * 2\n")
    p.push("    if newCapacity < 65536 \{ newCapacity = 65536 \}\n")
    p.push("    while newCapacity < usedLength + extra \{ newCapacity = newCapacity * 2 \}\n")
    p.push("    // VirtualAlloc, not runtimeAllocateObject: the builder must not itself allocate on the\n")
    p.push("    // GC heap, or formatting could trigger a collection mid-interpolation.\n")
    p.push("    let newBuffer = win(\"VirtualAlloc\", 0, newCapacity, 12288, 4)\n")
    p.push("    runtimeCopyMemory(newBuffer, load64(builderAddress), usedLength)\n")
    p.push("    store64(builderAddress, newBuffer)\n")
    p.push("    store64(builderAddress + 16, newCapacity)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn runtimeAppendStringBuilderByte(character: int) \{\n")
    p.push("    let builderAddress = runtimeGetStringBuilder()\n")
    p.push("    runtimeEnsureStringBuilderCapacity(builderAddress, 1)\n")
    p.push("    store8(load64(builderAddress) + load64(builderAddress + 8), character)\n")
    p.push("    store64(builderAddress + 8, load64(builderAddress + 8) + 1)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn runtimeAppendStringBuilderBytes(bytesAddress: int, byteCount: int) \{\n")
    p.push("    let builderAddress = runtimeGetStringBuilder()\n")
    p.push("    runtimeEnsureStringBuilderCapacity(builderAddress, byteCount)\n")
    p.push("    runtimeCopyMemory(load64(builderAddress) + load64(builderAddress + 8), bytesAddress, byteCount)\n")
    p.push("    store64(builderAddress + 8, load64(builderAddress + 8) + byteCount)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn runtimeAppendStringBuilderInteger(value: int) \{\n")
    p.push("    if value == 0 \{\n")
    p.push("        runtimeAppendStringBuilderByte(48)\n")
    p.push("        return\n")
    p.push("    \}\n")
    p.push("    let isNegative = value < 0\n")
    p.push("    // work in the non-positive domain so i64 MIN never overflows a negate\n")
    p.push("    var remainingValue = value\n")
    p.push("    if remainingValue > 0 \{ remainingValue = 0 - remainingValue \}\n")
    p.push("    var digitCount = 0\n")
    p.push("    var remainingDigits = remainingValue\n")
    p.push("    while remainingDigits < 0 \{\n")
    p.push("        digitCount += 1\n")
    p.push("        remainingDigits = remainingDigits / 10\n")
    p.push("    \}\n")
    p.push("    var total = digitCount\n")
    p.push("    if isNegative \{ total += 1 \}\n")
    p.push("    let builderAddress = runtimeGetStringBuilder()\n")
    p.push("    runtimeEnsureStringBuilderCapacity(builderAddress, total)\n")
    p.push("    let buffer = load64(builderAddress)\n")
    p.push("    let usedLength = load64(builderAddress + 8)\n")
    p.push("    var position = usedLength + total - 1\n")
    p.push("    while remainingValue < 0 \{\n")
    p.push("        store8(buffer + position, 48 - remainingValue % 10)      // x%10 is <= 0, so -(x%10) is the digit\n")
    p.push("        position -= 1\n")
    p.push("        remainingValue = remainingValue / 10\n")
    p.push("    \}\n")
    p.push("    if isNegative \{ store8(buffer + usedLength, 45) \}\n")
    p.push("    store64(builderAddress + 8, usedLength + total)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// td kinds: 0 int, 1 float, 2 bool, 3 str, 4 list, 5 struct\n")
    p.push("fn runtimeFormatValueIntoBuilder(value: int, typeDescriptor: int, representation: int) \{\n")
    p.push("    let kind = load64(typeDescriptor)\n")
    p.push("    if kind == 0 \{\n")
    p.push("        runtimeAppendStringBuilderInteger(value)\n")
    p.push("    \} else if kind == 2 \{\n")
    p.push("        if value != 0 \{ runtimeAppendStringBuilderBytes(addr(\"true\") + 8, 4) \}\n")
    p.push("        else \{ runtimeAppendStringBuilderBytes(addr(\"false\") + 8, 5) \}\n")
    p.push("    \} else if kind == 3 \{\n")
    p.push("        if representation != 0 \{ runtimeAppendStringBuilderByte(34) \}\n")
    p.push("        let count = load64(value)\n")
    p.push("        var index = 0\n")
    p.push("        while index < count \{\n")
    p.push("            let character = load8(value + 8 + index)\n")
    p.push("            if representation != 0 and (character == 34 or character == 92) \{\n")
    p.push("                runtimeAppendStringBuilderByte(92)\n")
    p.push("                runtimeAppendStringBuilderByte(character)\n")
    p.push("            \} else if representation != 0 and character == 10 \{\n")
    p.push("                runtimeAppendStringBuilderByte(92)\n")
    p.push("                runtimeAppendStringBuilderByte(110)\n")
    p.push("            \} else \{\n")
    p.push("                runtimeAppendStringBuilderByte(character)\n")
    p.push("            \}\n")
    p.push("            index += 1\n")
    p.push("        \}\n")
    p.push("        if representation != 0 \{ runtimeAppendStringBuilderByte(34) \}\n")
    p.push("    \} else if kind == 4 \{\n")
    p.push("        let elementDescriptor = load64(typeDescriptor + 8)\n")
    p.push("        let count = load64(value)\n")
    p.push("        let data = load64(value + 16)\n")
    p.push("        runtimeAppendStringBuilderByte(91)\n")
    p.push("        var index = 0\n")
    p.push("        while index < count \{\n")
    p.push("            if index > 0 \{\n")
    p.push("                runtimeAppendStringBuilderByte(44)\n")
    p.push("                runtimeAppendStringBuilderByte(32)\n")
    p.push("            \}\n")
    p.push("            runtimeFormatValueIntoBuilder(load64(data + index * 8), elementDescriptor, 1)\n")
    p.push("            index += 1\n")
    p.push("        \}\n")
    p.push("        runtimeAppendStringBuilderByte(93)\n")
    p.push("    \} else if kind == 5 \{\n")
    p.push("        let structName = load64(typeDescriptor + 8)\n")
    p.push("        let structFieldCount = load64(typeDescriptor + 16)\n")
    p.push("        let isTuple = load8(structName) == 40     // tuples are structs named \"(int, str)\"\n")
