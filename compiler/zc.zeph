    p.push("    var t = m as int\n")
    p.push("    while t > 0 \{\n")
    p.push("        dg.push(t % 10)\n")
    p.push("        t = t / 10\n")
    p.push("    \}\n")
    p.push("    if dg.len() == 0 \{ dg.push(0) \}\n")
