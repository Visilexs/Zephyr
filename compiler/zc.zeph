    p.push("\n")
    p.push("// Gudermannian: links circular and hyperbolic angle without complex numbers.\n")
    p.push("// 2*atan(tanh(x/2)) is the stable form; 2*atan(e^x) - pi/2 cancels at zero.\n")
    p.push("fn gd(x: float) -> float \{ return 2.0 * fatan(tanh(x / 2.0)) \}\n")
    p.push("\n")
    p.push("// inverse Gudermannian, which is also the antiderivative of sec\n")
