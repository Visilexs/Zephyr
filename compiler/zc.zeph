    p.push("fn read_line() -> str? \{\n")
    p.push("    let inputHandle = win(\"GetStdHandle\", -10)\n")
    p.push("    let buffer = Bytes.new(8)\n")
    p.push("    let countBuffer = Bytes.new(8)\n")
    p.push("    var pieces: [str] = []\n")
