    p.push("    let index = runtimeFindMapEntry(mapAddress, key)\n")
    p.push("    if index < 0 \{ return 0 \}\n")
    p.push("    let value = load64(load64(mapAddress + 16) + index * 24 + 16)\n")
    p.push("    var cell = 0\n")
    p.push("    if runtimeMapValueIsReference(mapAddress) == 1 \{\n")
    p.push("        cell = runtimeAllocateDescribedObject(8, runtimeReferenceBoxDescriptor)\n")
    p.push("        let retainedValue = runtimeRetainReference(value)\n")
    p.push("    \} else \{\n")
    p.push("        cell = runtimeAllocateDescribedObject(8, runtimeValueBoxDescriptor)\n")
    p.push("    \}\n")
    p.push("    store64(cell, value)\n")
    p.push("    return cell\n")
    p.push("\}\n")
    p.push("fn runtimeMapHas(mapAddress: int, key: int) -> int \{\n")
    p.push("    if runtimeFindMapEntry(mapAddress, key) >= 0 \{ return 1 \}\n")
    p.push("    return 0\n")
    p.push("\}\n")
    p.push("fn runtimeMapRemove(mapAddress: int, key: int) \{\n")
    p.push("    let index = runtimeFindMapEntry(mapAddress, key)\n")
