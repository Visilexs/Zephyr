    p.push("    if index < 0 \{ runtimeFail(\"map key not found\") \}\n")
    p.push("    let value = load64(load64(mapAddress + 16) + index * 24 + 16)\n")
    p.push("    if runtimeMapValueIsReference(mapAddress) == 1 \{ let retainedValue = runtimeRetainReference(value) \}\n")
    p.push("    return value\n")
    p.push("\}\n")
    p.push("// fused m.get(k).or(d): the value or the default, no optional cell allocated\n")
    p.push("fn runtimeMapGetOrReference(mapAddress: int, key: int, fallbackValue: int) -> int \{\n")
    p.push("    let index = runtimeFindMapEntry(mapAddress, key)\n")
    p.push("    var value = fallbackValue\n")
    p.push("    if index >= 0 \{ value = load64(load64(mapAddress + 16) + index * 24 + 16) \}\n")
    p.push("    if runtimeMapValueIsReference(mapAddress) == 1 \{ let retainResult = runtimeRetainReference(value) \}\n")
    p.push("    return value\n")
    p.push("\}\n")
    p.push("// The compiler selects this when neither keys nor values need reference handling.\n")
