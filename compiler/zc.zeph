// zc -- the Zephyr compiler, written in Zephyr.
// Same pipeline as src/zephyr.c: lex -> parse -> typecheck -> x86-64 assembly.
// Usage: zc <input.zeph> <output.s>   (assemble/link with gcc + runtime.o)

