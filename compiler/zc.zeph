    p.push("// Cody-Waite split of 2pi, as for ln2 above. HI has its low 20 mantissa bits\n")
    p.push("// clear, so k*HI is exact out to k = 2^20 and the reduced argument does not\n")
    p.push("// inherit k ulps of error from a single rounded TWO_PI.\n")
