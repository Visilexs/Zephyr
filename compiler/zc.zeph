let nodeInterpolation = 21
let nodeIdentifier = 22
let nodeList = 23
let nodeStructLiteral = 24
let nodeFieldInitializer = 25
let nodeNegate = 26
let nodeNot = 27
let nodeBinary = 28
let nodeCast = 29
let nodeIndex = 30
let nodeMember = 31
let nodeCall = 32      // ival: before checking, 1 + the type the context expects (0 = none)
let nodeTypeName = 33
let nodeListType = 34
let nodeEnumDefinition = 35
let nodeMapType = 36
let nodeMapLiteral = 37
let nodeImport = 38
let nodeFunctionType = 39
let nodeOptionalType = 40
let nodeNoneLiteral = 41
let nodeSome = 42
let nodeFunctionLiteral = 43     // fn(x: int) -> int { ... } -- closure literal
let nodeInline = 44    // produced by the inliner: inlined body stmts, slot = result temp
let nodeInlineReturn = 45      // an inlined body's return: result -> rax, jmp to the inline end
let nodeImpl = 46      // impl Type { methods } -- desugared into plain functions
let nodeInterface = 47 // interface Name { method signatures }
let nodeInterfaceBox = 48      // box a struct into an interface value {vtable, data}; refi=iface, op=vtable idx
let nodeExtern = 49    // extern fn f(...) from "dll" -- desugared into a lazily-resolving wrapper
let nodeIfExpression = 50    // if c { a } else { b } as a value: kids = [cond, a, b]
let nodeLetExpression = 51   // a hidden local, then a value: kids = [nodeDeclaration, value]
let nodeMatch = 52     // match statement (parse only; lowered by the checker): kids = [subject, nodeArm...]
let nodeMatchExpression = 53 // match as a value (parse only)
let nodeArm = 54       // one match arm: kids = [body, patterns...]; mut = the else arm
let nodeKeyValueLoop = 55      // for a, b in xs (parse only): name = a; kids = [xs, body, nodeTypeName b]
let nodeOptionalBinding = 56     // if let name = optional (parse only): kids = [optional, then, else or nodeNone]
let nodeDefer = 57     // defer block (parse only; lowered before checking): kids = [block]
let nodeTypeAlias = 58   // type Name = T (top level): kids = [type]
let nodeTupleType = 59   // (A, B) tuple type: kids = element types
let nodeTuple = 60     // (a, b) tuple literal: kids = elements; checked into an nodeStructLiteral
let nodeGroup = 61     // several statements from one (let (a, b) = t); spliced by the parser
let nodeIs = 62        // x is Member (parse only): kids = [value, nodeIdentifier or nodeMember]
let nodePrivate = 63   // private <declaration> (parse only; scopeModule renames it): kids = [decl]
let nodeTest = 64      // test "name" { ... } (parse only): name = the test's name, kids = [block]

