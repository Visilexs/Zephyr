    p.push("        if slotState == 0 \{ return 0 - 1 \}\n")
    p.push("        if slotState == 1 and load64(slot + 8) == key \{ return index \}\n")
    p.push("        index = (index + 1) & (capacity - 1)\n")
    p.push("    \}\n")
    p.push("    return 0 - 1\n")
    p.push("\}\n")
    p.push("fn runtimeIntegerMapInsert(mapAddress: int, key: int, value: int) \{\n")
    p.push("    let capacity = load64(mapAddress + 8)\n")
    p.push("    let slots = load64(mapAddress + 16)\n")
    p.push("    var index = ((key * -7046029254386353131) >> load64(mapAddress + 40)) & (capacity - 1)\n")
    p.push("    var tombstoneIndex = 0 - 1\n")
    p.push("    while true \{\n")
    p.push("        let slot = slots + index * 24\n")
