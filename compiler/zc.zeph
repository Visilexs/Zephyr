}
fn embedded_runtime() -> str { return __emb_rt() }
fn embedded_count() -> int { return 11 }
fn __emb_0() -> str {
    var p: [str] = []
    p.push("// Raw byte buffers: a fixed-size, GC-managed, non-moving region you can lay C\n")
    p.push("// structs into. Backed by a `zeros()` list, so the collector owns it -- no\n")
    p.push("// manual free, and the mark-sweep collector never moves objects.\n")
    p.push("//\n")
    p.push("// PINNING RULE: any address handed to a foreign library must belong to a Bytes\n")
    p.push("// that is still reachable from a Zephyr variable for as long as that library\n")
    p.push("// may use it. The collector never moves and never frees reachable objects, so\n")
    p.push("// that is the entire contract.\n")
    p.push("//\n")
    p.push("// Every accessor is bounds-checked and panics on violation, like list indexing.\n")
    p.push("\n")
    p.push("struct Bytes \{\n")
    p.push("    mem: [int],     // the backing allocation -- keeps the data alive for the GC\n")
    p.push("    p: int,         // 16-byte-aligned address of byte 0\n")
    p.push("    n: int          // usable size in bytes\n")
    p.push("\}\n")
    p.push("\n")
    p.push("impl Bytes \{\n")
    p.push("    // n zero-filled bytes, aligned to 16 so any C struct laid at offset 0 is aligned\n")
    p.push("    fn new(n: int) -> Bytes \{\n")
    p.push("        assert(n >= 0, \"Bytes.new: negative size\")\n")
    p.push("        var m = zeros(n / 8 + 4)                 // slack for the alignment bump\n")
    p.push("        let base = load64(addr(m) + 16)          // list layout: [0]len [8]cap [16]data\n")
    p.push("        let p = (base + 15) & (0 - 16)\n")
    p.push("        return Bytes\{mem: m, p: p, n: n\}\n")
    p.push("    \}\n")
    p.push("\n")
    p.push("    fn len(self) -> int \{ return self.n \}\n")
    p.push("    fn addr(self) -> int \{ return self.p \}\n")
    p.push("\n")
    p.push("    // address of byte `off`, for passing an interior pointer to a foreign call\n")
    p.push("    fn at(self, off: int) -> int \{\n")
    p.push("        assert(off >= 0 and off <= self.n, \"Bytes.at: offset out of range\")\n")
    p.push("        return self.p + off\n")
    p.push("    \}\n")
    p.push("\n")
    p.push("    fn put8(self, off: int, v: int) \{\n")
    p.push("        assert(off >= 0 and off + 1 <= self.n, \"Bytes.put8: out of range\")\n")
    p.push("        store8(self.p + off, v)\n")
    p.push("    \}\n")
    p.push("    fn get8(self, off: int) -> int \{\n")
    p.push("        assert(off >= 0 and off + 1 <= self.n, \"Bytes.get8: out of range\")\n")
    p.push("        return load8(self.p + off)\n")
    p.push("    \}\n")
    p.push("\n")
    p.push("    fn put16(self, off: int, v: int) \{\n")
    p.push("        assert(off >= 0 and off + 2 <= self.n, \"Bytes.put16: out of range\")\n")
    p.push("        store8(self.p + off, v & 255)\n")
    p.push("        store8(self.p + off + 1, (v >> 8) & 255)\n")
    p.push("    \}\n")
    p.push("    fn get16(self, off: int) -> int \{\n")
    p.push("        assert(off >= 0 and off + 2 <= self.n, \"Bytes.get16: out of range\")\n")
    p.push("        return load8(self.p + off) + load8(self.p + off + 1) * 256\n")
    p.push("    \}\n")
    p.push("\n")
    p.push("    fn put32(self, off: int, v: int) \{\n")
    p.push("        assert(off >= 0 and off + 4 <= self.n, \"Bytes.put32: out of range\")\n")
    p.push("        store32(self.p + off, v)\n")
    p.push("    \}\n")
    p.push("    // zero-extends: Vulkan's 32-bit fields are enums, flags and counts\n")
    p.push("    fn get32(self, off: int) -> int \{\n")
    p.push("        assert(off >= 0 and off + 4 <= self.n, \"Bytes.get32: out of range\")\n")
    p.push("        let lo = load8(self.p + off) + load8(self.p + off + 1) * 256\n")
    p.push("        return lo + load8(self.p + off + 2) * 65536 + load8(self.p + off + 3) * 16777216\n")
    p.push("    \}\n")
    p.push("\n")
    p.push("    fn put64(self, off: int, v: int) \{\n")
    p.push("        assert(off >= 0 and off + 8 <= self.n, \"Bytes.put64: out of range\")\n")
    p.push("        store64(self.p + off, v)\n")
    p.push("    \}\n")
    p.push("    fn get64(self, off: int) -> int \{\n")
    p.push("        assert(off >= 0 and off + 8 <= self.n, \"Bytes.get64: out of range\")\n")
    p.push("        return load64(self.p + off)\n")
    p.push("    \}\n")
    p.push("\n")
    p.push("    fn putf32(self, off: int, x: float) \{ self.put32(off, f32_bits(x)) \}\n")
    p.push("    fn getf32(self, off: int) -> float \{ return f32_from(self.get32(off)) \}\n")
    p.push("\n")
    p.push("    fn putf64(self, off: int, x: float) \{ self.put64(off, bits(x)) \}\n")
    p.push("    fn getf64(self, off: int) -> float \{ return frombits(self.get64(off)) \}\n")
    p.push("\n")
    p.push("    // copy a Zephyr string in and NUL-terminate it -- a C `const char*`\n")
    p.push("    fn put_cstr(self, off: int, s: str) \{\n")
    p.push("        assert(off >= 0 and off + s.len() + 1 <= self.n, \"Bytes.put_cstr: out of range\")\n")
    p.push("        for i in 0..s.len() \{ store8(self.p + off + i, s.byte(i)) \}\n")
    p.push("        store8(self.p + off + s.len(), 0)\n")
    p.push("    \}\n")
    p.push("\n")
    p.push("    // copy raw bytes of a str (e.g. a .spv file read with read_file) in\n")
    p.push("    fn put_str(self, off: int, s: str) \{\n")
    p.push("        assert(off >= 0 and off + s.len() <= self.n, \"Bytes.put_str: out of range\")\n")
    p.push("        for i in 0..s.len() \{ store8(self.p + off + i, s.byte(i)) \}\n")
    p.push("    \}\n")
    p.push("\n")
    p.push("    // read `n` bytes back out as a str\n")
    p.push("    fn get_str(self, off: int, n: int) -> str \{\n")
    p.push("        assert(off >= 0 and off + n <= self.n, \"Bytes.get_str: out of range\")\n")
    p.push("        var parts: [str] = []\n")
    p.push("        for i in 0..n \{ parts.push(chr(load8(self.p + off + i))) \}\n")
    p.push("        return parts.join()\n")
    p.push("    \}\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// a standalone NUL-terminated C string; hold the returned Bytes to keep it alive\n")
    p.push("fn cbytes(s: str) -> Bytes \{\n")
    p.push("    var b = Bytes.new(s.len() + 1)\n")
    p.push("    b.put_cstr(0, s)\n")
    p.push("    return b\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// ---- array plumbing for C APIs that take count + pointer ----\n")
    p.push("\n")
    p.push("// a contiguous array of 64-bit values (handles, pointers)\n")
    p.push("fn u64s(xs: [int]) -> Bytes \{\n")
    p.push("    var b = Bytes.new(8 * xs.len() + 8)\n")
    p.push("    for i in 0..xs.len() \{ b.put64(i * 8, xs[i]) \}\n")
    p.push("    return b\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// a contiguous array of 32-bit values (indices, enum values)\n")
    p.push("fn u32s(xs: [int]) -> Bytes \{\n")
    p.push("    var b = Bytes.new(4 * xs.len() + 4)\n")
    p.push("    for i in 0..xs.len() \{ b.put32(i * 4, xs[i]) \}\n")
    p.push("    return b\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// Lay several equally-sized structs out back to back, which is what an API\n")
    p.push("// wanting `count, pStructs` expects. Pass each builder's .raw().\n")
    p.push("fn pack(items: [Bytes]) -> Bytes \{\n")
    p.push("    if items.len() == 0 \{ return Bytes.new(8) \}\n")
    p.push("    let stride = items[0].len()\n")
    p.push("    var out = Bytes.new(stride * items.len() + 8)\n")
    p.push("    for i in 0..items.len() \{\n")
    p.push("        for j in 0..stride \{ out.put8(i * stride + j, items[i].get8(j)) \}\n")
    p.push("    \}\n")
    p.push("    return out\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// A `const char* const*`. The individual strings must outlive the call, so the\n")
    p.push("// array and its buffers are held together.\n")
    p.push("struct CStrs \{ ptrs: Bytes, bufs: [Bytes] \}\n")
    p.push("fn cstrs(xs: [str]) -> CStrs \{\n")
    p.push("    var bufs: [Bytes] = []\n")
    p.push("    var ptrs = Bytes.new(8 * xs.len() + 8)\n")
    p.push("    for i in 0..xs.len() \{\n")
    p.push("        var b = cbytes(xs[i])\n")
    p.push("        bufs.push(b)\n")
    p.push("        ptrs.put64(i * 8, b.addr())\n")
    p.push("    \}\n")
    p.push("    return CStrs\{ptrs: ptrs, bufs: bufs\}\n")
    p.push("\}\n")
    p.push("impl CStrs \{\n")
    p.push("    fn addr(self) -> int \{\n")
    p.push("        if self.bufs.len() == 0 \{ return 0 \}\n")
    p.push("        return self.ptrs.addr()\n")
    p.push("    \}\n")
    p.push("    fn len(self) -> int \{ return self.bufs.len() \}\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// ---- IEEE-754 double <-> single conversion (Zephyr floats are all doubles) ----\n")
    p.push("// Rounds to nearest, ties to even -- the same rule the hardware uses for a\n")
    p.push("// double->float store, so results match what a C `(float)x` would produce.\n")
    p.push("fn f32_bits(x: float) -> int \{\n")
    p.push("    let b = bits(x)\n")
    p.push("    let sign = (b >> 63) & 1\n")
    p.push("    let exp = (b >> 52) & 2047\n")
    p.push("    let man = b & 4503599627370495                  // 2^52 - 1\n")
    p.push("    if exp == 0 \{ return sign << 31 \}               // zero / subnormal -> signed zero\n")
    p.push("    if exp == 2047 \{                                // inf / NaN\n")
    p.push("        if man != 0 \{ return (sign << 31) | (255 << 23) | 4194303 \}\n")
    p.push("        return (sign << 31) | (255 << 23)\n")
    p.push("    \}\n")
    p.push("    var e = exp - 1023 + 127\n")
    p.push("    if e >= 255 \{ return (sign << 31) | (255 << 23) \}   // overflow -> inf\n")
    p.push("    if e <= 0 \{\n")
    p.push("        // Below the smallest normal float, but a subnormal may still represent\n")
    p.push("        // it: value = m * 2^-149, so shift the 53-bit significand down to suit.\n")
    p.push("        let shift = 30 - e\n")
    p.push("        if shift > 53 \{ return sign << 31 \}             // truly zero\n")
    p.push("        let full = 4503599627370496 + man               // 2^52 + mantissa\n")
    p.push("        var sm = full >> shift\n")
    p.push("        let sdrop = full & ((1 << shift) - 1)\n")
    p.push("        let shalf = 1 << (shift - 1)\n")
    p.push("        if sdrop > shalf or (sdrop == shalf and (sm & 1) == 1) \{ sm += 1 \}\n")
    p.push("        // carrying out of the mantissa lands on the smallest normal, which this\n")
    p.push("        // encoding already expresses correctly (exponent 1, mantissa 0)\n")
    p.push("        return (sign << 31) | sm\n")
    p.push("    \}\n")
    p.push("    // 52 mantissa bits down to 23: 29 bits are dropped. Round to nearest, and on\n")
    p.push("    // an exact tie pick the even significand.\n")
    p.push("    var m = man >> 29\n")
    p.push("    let dropped = man & 536870911                   // 2^29 - 1\n")
    p.push("    let half = 268435456                            // 2^28\n")
    p.push("    if dropped > half or (dropped == half and (m & 1) == 1) \{\n")
    p.push("        m += 1\n")
    p.push("        if m == 8388608 \{                           // mantissa overflowed: bump exponent\n")
    p.push("            m = 0\n")
    p.push("            e += 1\n")
    p.push("            if e >= 255 \{ return (sign << 31) | (255 << 23) \}\n")
    p.push("        \}\n")
    p.push("    \}\n")
    p.push("    return (sign << 31) | (e << 23) | m\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn f32_from(v: int) -> float \{\n")
    p.push("    let sign = (v >> 31) & 1\n")
    p.push("    let exp = (v >> 23) & 255\n")
    p.push("    let man = v & 8388607                           // 2^23 - 1\n")
    p.push("    if exp == 0 \{\n")
    p.push("        if man == 0 \{ return frombits(sign << 63) \}\n")
    p.push("        // subnormal: man * 2^-149, renormalised into a double\n")
    p.push("        var p = 22\n")
    p.push("        while p > 0 and (man & (1 << p)) == 0 \{ p -= 1 \}\n")
    p.push("        let dexp = 0 - 149 + p + 1023\n")
    p.push("        let dman = (man << (52 - p)) & 4503599627370495\n")
    p.push("        return frombits((sign << 63) | (dexp << 52) | dman)\n")
    p.push("    \}\n")
    p.push("    if exp == 255 \{\n")
    p.push("        if man != 0 \{ return frombits((sign << 63) | (2047 << 52) | 1) \}\n")
    p.push("        return frombits((sign << 63) | (2047 << 52))\n")
    p.push("    \}\n")
    p.push("    return frombits((sign << 63) | ((exp - 127 + 1023) << 52) | (man << 29))\n")
    p.push("\}\n")
    p.push("\n")
    return p.join()
}
