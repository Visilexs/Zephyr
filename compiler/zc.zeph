    p.push("    if e <= 0 \{\n")
    p.push("        // Below the smallest normal float, but a subnormal may still represent\n")
    p.push("        // it: value = m * 2^-149, so shift the 53-bit significand down to suit.\n")
    p.push("        let shift = 30 - e\n")
    p.push("        if shift > 53 \{ return sign << 31 \}             // truly zero\n")
    p.push("        let full = 4503599627370496 + man               // 2^52 + mantissa\n")
    p.push("        var sm = full >> shift\n")
    p.push("        let sdrop = full & ((1 << shift) - 1)\n")
    p.push("        let shalf = 1 << (shift - 1)\n")
    p.push("        if sdrop > shalf or (sdrop == shalf and (sm & 1) == 1) \{ sm += 1 \}\n")
    p.push("        // carrying out of the mantissa lands on the smallest normal, which this\n")
    p.push("        // encoding already expresses correctly (exponent 1, mantissa 0)\n")
