    p.push("    if x > 0.0 \{ return fatan(1.0 / x) \}\n")
    p.push("    return PI + fatan(1.0 / x)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn fasec(x: float) -> float \{\n")
    p.push("    if x < 1.0 and x > -1.0 \{ return NAN \}\n")
    p.push("    return facos(1.0 / x)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn facsc(x: float) -> float \{\n")
    p.push("    if x < 1.0 and x > -1.0 \{ return NAN \}\n")
