    p.push("\}\n")
    p.push("\n")
    p.push("// Releasing a frame's reference slots. A function with several of them used to\n")
    p.push("// pay a call per slot on every single return, which measured at 403M calls --\n")
    p.push("// 80% of all counting work -- to free something only 2.5% of the time. The\n")
    p.push("// compiler emits the slot offsets as a static table instead, so a return costs\n")
    p.push("// one call and a loop, with rx_drop's body inlined here.\n")
    p.push("fn rx_drop_slots(fp: int, tbl: int, n: int) \{\n")
    p.push("    var i = 0\n")
    p.push("    while i < n \{\n")
    p.push("        let v = load64(fp - load64(tbl + i * 8))\n")
    p.push("        if v >= __hbase and v < __hbump \{\n")
    p.push("            let rc = load64(v - 24)\n")
    p.push("            if rc > 1 \{\n")
    p.push("                store64(v - 24, rc - 1)\n")
    p.push("            \} else \{\n")
    p.push("                if rc < 1 \{ rt_die(\"reference count underflow\") \}\n")
    p.push("                store64(v - 24, 0)\n")
    p.push("                rx_release(v)\n")
    p.push("            \}\n")
    p.push("        \}\n")
    p.push("        i += 1\n")
    p.push("    \}\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// A child reference losing its holder: decrement, and queue it for release\n")
    p.push("// when that was the last one. Queuing instead of recursing is what keeps a\n")
    p.push("// million-element linked structure from overflowing the stack.\n")
    p.push("fn rx_drop_child(c: int) \{\n")
    p.push("    if c < __hbase or c >= __hbump \{ return \}\n")
    p.push("    let rc = load64(c - 24)\n")
    p.push("    if rc > 1 \{\n")
    p.push("        store64(c - 24, rc - 1)\n")
    p.push("        return\n")
    p.push("    \}\n")
    p.push("    if rc < 1 \{ rt_die(\"reference count underflow\") \}\n")
    p.push("    store64(c - 24, 0)\n")
    p.push("    rx_wl_push(c)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// Frees `v` and, transitively, everything only it kept alive. Shares the\n")
    p.push("// collector's worklist; the two never run at once because the collector is only\n")
    p.push("// ever entered from allocation, which release never performs.\n")
    p.push("fn rx_release(v: int) \{\n")
    p.push("    rt_lock()\n")
    p.push("    rx_wl_push(v)\n")
    p.push("    while __wltop > 0 \{\n")
    p.push("        __wltop -= 1\n")
    p.push("        let obj = load64(__wl + __wltop * 8)\n")
    p.push("        let desc = load64(obj - 16)\n")
    p.push("        if desc != 0 \{ rx_drop_children(obj, desc) \}\n")
    p.push("        let size = load64(obj - 8) & (0 - 8)\n")
    p.push("        store64(obj - 8, size | F_FREE)\n")
    p.push("        rx_free_push(obj, size)\n")
    p.push("    \}\n")
    p.push("    rt_unlock()\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// Shape descriptors. The compiler emits one per type into the data section; the\n")
    p.push("// runtime keeps a few of its own (rx_desc_init) for the objects it builds itself.\n")
    p.push("//   [0] kind   1 = fixed slots: [8] slot count, [16..] bitmask, bit i = slot i is a reference\n")
    p.push("//              2 = list cell \{len, cap, data\}: [8] 1 if the elements are references\n")
    p.push("//              3 = map: [8] 1 if keys are references, [16] 1 if values are\n")
    p.push("fn rx_drop_children(obj: int, desc: int) \{\n")
    p.push("    let kind = load64(desc)\n")
    p.push("    if kind == 1 \{\n")
    p.push("        let n = load64(desc + 8)\n")
    p.push("        var i = 0\n")
    p.push("        while i < n \{\n")
    p.push("            if (load64(desc + 16 + (i >> 6) * 8) >> (i & 63)) & 1 == 1 \{\n")
    p.push("                rx_drop_child(load64(obj + i * 8))\n")
    p.push("            \}\n")
    p.push("            i += 1\n")
    p.push("        \}\n")
    p.push("    \} else if kind == 2 \{\n")
    p.push("        let data = load64(obj + 16)\n")
    p.push("        if load64(desc + 8) == 1 \{\n")
    p.push("            let n = load64(obj)\n")
    p.push("            var i = 0\n")
    p.push("            while i < n \{\n")
    p.push("                rx_drop_child(load64(data + i * 8))\n")
    p.push("                i += 1\n")
    p.push("            \}\n")
    p.push("        \}\n")
    p.push("        rx_drop_child(data)\n")
    p.push("    \} else if kind == 3 \{\n")
    p.push("        let cap = load64(obj + 8)\n")
    p.push("        let keys = load64(obj + 16)\n")
    p.push("        let vals = load64(obj + 24)\n")
    p.push("        let state = load64(obj + 32)\n")
    p.push("        let kref = load64(desc + 8)\n")
    p.push("        let vref = load64(desc + 16)\n")
    p.push("        var i = 0\n")
    p.push("        while i < cap \{\n")
    p.push("            if load8(state + i) == 1 \{\n")
    p.push("                if kref == 1 \{ rx_drop_child(load64(keys + i * 8)) \}\n")
    p.push("                if vref == 1 \{ rx_drop_child(load64(vals + i * 8)) \}\n")
    p.push("            \}\n")
    p.push("            i += 1\n")
    p.push("        \}\n")
    p.push("        rx_drop_child(keys)\n")
    p.push("        rx_drop_child(vals)\n")
    p.push("        rx_drop_child(state)\n")
    p.push("    \}\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// The runtime's own descriptors, on one off-heap page.\n")
    p.push("var __d_list_val = 0\n")
    p.push("var __d_list_ref = 0\n")
    p.push("var __d_box_val = 0\n")
    p.push("var __d_box_ref = 0\n")
    p.push("var __d_map_val = 0\n")
    p.push("fn rx_desc_init() \{\n")
    p.push("    let page = win(\"VirtualAlloc\", 0, 4096, 12288, 4)\n")
    p.push("    if page == 0 \{ rt_die(\"out of memory\") \}\n")
    p.push("    __d_map_val = page + 128         // kind 3, plain keys and values\n")
    p.push("    store64(page + 128, 3)\n")
    p.push("    __d_list_val = page              // kind 2, elements are values\n")
    p.push("    store64(page, 2)\n")
    p.push("    __d_list_ref = page + 32         // kind 2, elements are references\n")
    p.push("    store64(page + 32, 2)\n")
    p.push("    store64(page + 40, 1)\n")
    p.push("    __d_box_val = page + 64          // kind 1, one slot, not a reference\n")
    p.push("    store64(page + 64, 1)\n")
    p.push("    store64(page + 72, 1)\n")
    p.push("    __d_box_ref = page + 96          // kind 1, one slot, a reference\n")
    p.push("    store64(page + 96, 1)\n")
    p.push("    store64(page + 104, 1)\n")
    p.push("    store64(page + 112, 1)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// a small scratch page for out-params (never freed, not on the GC heap)\n")
    p.push("var __scratchp = 0\n")
    p.push("fn rx_scratch() -> int \{\n")
    p.push("    if __scratchp == 0 \{\n")
    p.push("        __scratchp = win(\"VirtualAlloc\", 0, 4096, 12288, 4)\n")
    p.push("        if __scratchp == 0 \{ rt_die(\"out of memory\") \}\n")
    p.push("    \}\n")
    p.push("    return __scratchp\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// Take a block off the free lists, or 0 if none fits. Small sizes come off\n")
    p.push("// their exact-size class in O(1); large ones use first fit with splitting.\n")
    p.push("fn rx_take_free(need: int) -> int \{\n")
    p.push("    let cls = need >> 3\n")
    p.push("    if cls <= NCLASS \{\n")
    p.push("        let head = load64(__fl + cls * 8)\n")
    p.push("        if head == 0 \{ return 0 \}\n")
    p.push("        store64(__fl + cls * 8, load64(head))        // pop\n")
    p.push("        store64(head - 8, need)                      // live again, flags cleared\n")
    p.push("        rx_zero(head, need)\n")
    p.push("        return head\n")
    p.push("    \}\n")
    p.push("    var prev = 0\n")
    p.push("    var cur = __flbig\n")
    p.push("    while cur != 0 \{\n")
    p.push("        let sz = load64(cur - 8) & (0 - 8)\n")
    p.push("        let nxt = load64(cur)\n")
    p.push("        if sz >= need \{\n")
    p.push("            if prev == 0 \{ __flbig = nxt \} else \{ store64(prev, nxt) \}\n")
    p.push("            if sz >= need + HDR + 8 \{                // split off the tail\n")
    p.push("                let rest = sz - need - HDR\n")
    p.push("                store64(cur - 8, need)\n")
    p.push("                let nb = cur + need + HDR            // payload of the remainder\n")
    p.push("                store64(nb - 8, rest | F_FREE)\n")
    p.push("                rx_bit_set(__startb, (nb - __hbase) >> 3)\n")
    p.push("                rx_free_push(nb, rest)\n")
    p.push("            \} else \{\n")
    p.push("                store64(cur - 8, sz)\n")
    p.push("            \}\n")
    p.push("            rx_zero(cur, load64(cur - 8) & (0 - 8))\n")
    p.push("            return cur\n")
    p.push("        \}\n")
    p.push("        prev = cur\n")
    p.push("        cur = nxt\n")
    p.push("    \}\n")
    p.push("    return 0\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// An object with no children (a string, a list's data buffer). The compiler\n")
    p.push("// still calls this by name, so the signature must not change.\n")
    p.push("fn rt_alloc(size: int) -> int \{\n")
    p.push("    return rt_alloc_d(size, 0)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// An object whose payload holds references: `desc` (see rx_drop_children) says\n")
    p.push("// which words, so dropping it can drop them. Count starts at 1 - the caller\n")
    p.push("// owns the fresh object.\n")
    p.push("fn rt_alloc_d(size: int, desc: int) -> int \{\n")
    p.push("    rt_lock()\n")
    p.push("    let r = rx_alloc_body(size)\n")
    p.push("    store64(r - 24, 1)\n")
    p.push("    store64(r - 16, desc)\n")
    p.push("    rt_unlock()\n")
    p.push("    return r\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn rx_alloc_body(size: int) -> int \{\n")
    p.push("    if __gc_on == 0 \{ rx_heap_init() \}\n")
    p.push("    var need = (size + 7) & (0 - 8)\n")
    p.push("    if need == 0 \{ need = 8 \}\n")
    p.push("    let a = rx_take_free(need)\n")
    p.push("    if a != 0 \{ return a \}\n")
    p.push("    // free list exhausted and the heap has doubled: collect, then retry.\n")
    p.push("    // ponytail: first-fit over one free list; size-segregated lists would let\n")
    p.push("    // us collect more often without the O(n) search, but this is correct and\n")
    p.push("    // halves peak memory as is.\n")
    p.push("    if __hbump >= __gc_at \{\n")
    p.push("        rx_collect()\n")
    p.push("        // Proportional trigger (Go-style): allow the bump pointer to advance by\n")
    p.push("        // another `live` bytes before the next collection, so the heap peaks at\n")
    p.push("        // ~2x the live set. The target is measured from the CURRENT bump, i.e.\n")
    p.push("        // from growth-since-this-collection -- NOT from __hbase, which is the\n")
    p.push("        // all-time high-water extent and never shrinks. Keying on the extent\n")
    p.push("        // meant that once it passed 2x live, every free-list miss collected\n")
    p.push("        // (a full mark that reclaimed nothing new), which is O(live) per\n")
    p.push("        // allocation whenever the live set pins its size class's free list empty.\n")
    p.push("        // The 256 KiB floor only bites when the live set is tiny (a churn loop\n")
    p.push("        // whose garbage dies immediately): it collects a little more often to\n")
    p.push("        // keep the peak low, and each such collection is cheap precisely because\n")
    p.push("        // little is live. A larger floor traded ~8 MiB of extra peak for no time.\n")
    p.push("        var headroom = __live\n")
    p.push("        if headroom < 262144 \{ headroom = 262144 \}\n")
    p.push("        __gc_at = __hbump + headroom\n")
    p.push("        let b = rx_take_free(need)\n")
    p.push("        if b != 0 \{ return b \}\n")
    p.push("    \}\n")
    p.push("    // bump\n")
    p.push("    rx_grow(__hbump + HDR + need)\n")
    p.push("    let obj = __hbump + HDR\n")
    p.push("    store64(obj - 8, need)\n")
    p.push("    __hbump = obj + need\n")
    p.push("    rx_bit_set(__startb, (obj - __hbase) >> 3)\n")
    p.push("    return obj                                       // committed pages start zeroed\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn rx_zero(p: int, n: int) \{\n")
    p.push("    var i = 0\n")
    p.push("    while i < n \{\n")
    p.push("        store64(p + i, 0)\n")
    p.push("        i += 8\n")
    p.push("    \}\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// records the globals array so the collector can scan it as a root set\n")
    p.push("fn rt_set_globals(p: int, n: int) \{\n")
    p.push("    __groots = p\n")
    p.push("    __ngroots = n\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// ---- raw byte copy ----\n")
    p.push("fn rx_mcopy(dst: int, src: int, n: int) \{\n")
    p.push("    var i = 0\n")
    p.push("    while i + 8 <= n \{\n")
    p.push("        store64(dst + i, load64(src + i))\n")
    p.push("        i += 8\n")
    p.push("    \}\n")
    p.push("    while i < n \{\n")
    p.push("        store8(dst + i, load8(src + i))\n")
    p.push("        i += 1\n")
    p.push("    \}\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// ---- strings ----  (a str value is a pointer to \{i64 len; bytes\})\n")
    p.push("fn rx_str_alloc(slen: int) -> int \{\n")
    p.push("    let p = rt_alloc(8 + slen)\n")
    p.push("    store64(p, slen)\n")
    p.push("    return p\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn rt_str_concat(a: int, b: int) -> int \{\n")
    p.push("    let la = load64(a)\n")
    p.push("    let lb = load64(b)\n")
    p.push("    let s = rx_str_alloc(la + lb)\n")
    p.push("    rx_mcopy(s + 8, a + 8, la)\n")
    p.push("    rx_mcopy(s + 8 + la, b + 8, lb)\n")
    p.push("    return s\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn rt_str_eq(a: int, b: int) -> int \{\n")
    p.push("    let la = load64(a)\n")
    p.push("    if la != load64(b) \{ return 0 \}\n")
    p.push("    var i = 0\n")
    p.push("    while i < la \{\n")
    p.push("        if load8(a + 8 + i) != load8(b + 8 + i) \{ return 0 \}\n")
    p.push("        i += 1\n")
    p.push("    \}\n")
    p.push("    return 1\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn rt_str_cmp(a: int, b: int) -> int \{\n")
    p.push("    let la = load64(a)\n")
    p.push("    let lb = load64(b)\n")
    p.push("    var n = la\n")
    p.push("    if lb < n \{ n = lb \}\n")
    p.push("    var i = 0\n")
    p.push("    while i < n \{\n")
    p.push("        let ca = load8(a + 8 + i)\n")
    p.push("        let cb = load8(b + 8 + i)\n")
    p.push("        if ca < cb \{ return 0 - 1 \}\n")
    p.push("        if ca > cb \{ return 1 \}\n")
    p.push("        i += 1\n")
    p.push("    \}\n")
    p.push("    if la < lb \{ return 0 - 1 \}\n")
    p.push("    if la > lb \{ return 1 \}\n")
    p.push("    return 0\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn rt_str_sub(s: int, lo: int, hi: int) -> int \{\n")
    p.push("    let n = load64(s)\n")
    p.push("    if lo < 0 or hi < lo or hi > n \{ rt_die(\"invalid substring\") \}\n")
    p.push("    let r = rx_str_alloc(hi - lo)\n")
    p.push("    rx_mcopy(r + 8, s + 8 + lo, hi - lo)\n")
    p.push("    return r\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn rt_chr(c: int) -> int \{\n")
    p.push("    if c < 0 or c > 255 \{ rt_die(\"chr out of range\") \}\n")
    p.push("    let s = rx_str_alloc(1)\n")
    p.push("    store8(s + 8, c)\n")
    p.push("    return s\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// ---- stdlib: string / list / math helpers ----\n")
    p.push("fn rt_ipow(base: int, exp: int) -> int \{\n")
    p.push("    if exp < 0 \{ return 0 \}\n")
    p.push("    var r = 1\n")
    p.push("    var b = base\n")
    p.push("    var e = exp\n")
    p.push("    while e > 0 \{\n")
    p.push("        if e & 1 == 1 \{ r = r * b \}\n")
    p.push("        b = b * b\n")
    p.push("        e = e >> 1\n")
    p.push("    \}\n")
    p.push("    return r\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn rt_str_index_of(s: int, sub: int) -> int \{\n")
    p.push("    let n = load64(s)\n")
    p.push("    let m = load64(sub)\n")
    p.push("    if m == 0 \{ return 0 \}\n")
    p.push("    var i = 0\n")
    p.push("    while i + m <= n \{\n")
    p.push("        var j = 0\n")
    p.push("        while j < m and load8(s + 8 + i + j) == load8(sub + 8 + j) \{ j += 1 \}\n")
    p.push("        if j == m \{ return i \}\n")
    p.push("        i += 1\n")
    p.push("    \}\n")
    p.push("    return 0 - 1\n")
    p.push("\}\n")
    p.push("fn rt_str_contains(s: int, sub: int) -> int \{\n")
    p.push("    if rt_str_index_of(s, sub) >= 0 \{ return 1 \}\n")
    p.push("    return 0\n")
    p.push("\}\n")
    p.push("fn rt_str_starts_with(s: int, p: int) -> int \{\n")
    p.push("    let n = load64(s)\n")
    p.push("    let m = load64(p)\n")
    p.push("    if m > n \{ return 0 \}\n")
    p.push("    var j = 0\n")
    p.push("    while j < m \{\n")
    p.push("        if load8(s + 8 + j) != load8(p + 8 + j) \{ return 0 \}\n")
    p.push("        j += 1\n")
    p.push("    \}\n")
    p.push("    return 1\n")
    p.push("\}\n")
    p.push("fn rt_str_ends_with(s: int, p: int) -> int \{\n")
    p.push("    let n = load64(s)\n")
    p.push("    let m = load64(p)\n")
    p.push("    if m > n \{ return 0 \}\n")
    p.push("    var j = 0\n")
    p.push("    while j < m \{\n")
    p.push("        if load8(s + 8 + n - m + j) != load8(p + 8 + j) \{ return 0 \}\n")
    p.push("        j += 1\n")
    p.push("    \}\n")
    p.push("    return 1\n")
    p.push("\}\n")
    p.push("fn rt_str_split(s: int, sep: int) -> int \{\n")
    p.push("    let n = load64(s)\n")
    p.push("    let m = load64(sep)\n")
    p.push("    let out = rt_list_new_d(0, __d_list_ref)\n")
    p.push("    if m == 0 \{\n")
    p.push("        var i = 0\n")
    p.push("        while i < n \{\n")
    p.push("            let piece = rx_str_alloc(1)\n")
    p.push("            store8(piece + 8, load8(s + 8 + i))\n")
    p.push("            rt_list_push(out, piece)\n")
    p.push("            i += 1\n")
    p.push("        \}\n")
    p.push("        return out\n")
    p.push("    \}\n")
    p.push("    var start = 0\n")
    p.push("    var i = 0\n")
    p.push("    while i + m <= n \{\n")
    p.push("        var j = 0\n")
    p.push("        while j < m and load8(s + 8 + i + j) == load8(sep + 8 + j) \{ j += 1 \}\n")
    p.push("        if j == m \{\n")
    p.push("            rt_list_push(out, rt_str_sub(s, start, i))\n")
    p.push("            i += m\n")
    p.push("            start = i\n")
    p.push("        \} else \{\n")
    p.push("            i += 1\n")
    p.push("        \}\n")
    p.push("    \}\n")
    p.push("    rt_list_push(out, rt_str_sub(s, start, n))\n")
    p.push("    return out\n")
    p.push("\}\n")
    p.push("fn rt_str_replace(s: int, old: int, rep: int) -> int \{\n")
    p.push("    let n = load64(s)\n")
    p.push("    let m = load64(old)\n")
    p.push("    if m == 0 \{ return s \}\n")
    p.push("    var out = rx_str_alloc(0)\n")
    p.push("    var start = 0\n")
    p.push("    var i = 0\n")
    p.push("    while i + m <= n \{\n")
    p.push("        var j = 0\n")
    p.push("        while j < m and load8(s + 8 + i + j) == load8(old + 8 + j) \{ j += 1 \}\n")
    p.push("        if j == m \{\n")
    p.push("            out = rt_str_concat(out, rt_str_sub(s, start, i))\n")
    p.push("            out = rt_str_concat(out, rep)\n")
    p.push("            i += m\n")
    p.push("            start = i\n")
    p.push("        \} else \{\n")
    p.push("            i += 1\n")
    p.push("        \}\n")
    p.push("    \}\n")
    p.push("    out = rt_str_concat(out, rt_str_sub(s, start, n))\n")
    p.push("    return out\n")
    p.push("\}\n")
    p.push("fn rt_str_upper(s: int) -> int \{\n")
    p.push("    let n = load64(s)\n")
    p.push("    let r = rx_str_alloc(n)\n")
    p.push("    var i = 0\n")
    p.push("    while i < n \{\n")
    p.push("        var c = load8(s + 8 + i)\n")
    p.push("        if c >= 97 and c <= 122 \{ c -= 32 \}\n")
    p.push("        store8(r + 8 + i, c)\n")
    p.push("        i += 1\n")
    p.push("    \}\n")
    p.push("    return r\n")
    p.push("\}\n")
    p.push("fn rt_str_lower(s: int) -> int \{\n")
    p.push("    let n = load64(s)\n")
    p.push("    let r = rx_str_alloc(n)\n")
    p.push("    var i = 0\n")
    p.push("    while i < n \{\n")
    p.push("        var c = load8(s + 8 + i)\n")
    p.push("        if c >= 65 and c <= 90 \{ c += 32 \}\n")
    p.push("        store8(r + 8 + i, c)\n")
    p.push("        i += 1\n")
    p.push("    \}\n")
    p.push("    return r\n")
    p.push("\}\n")
    p.push("fn rx_is_ws(c: int) -> int \{\n")
    p.push("    if c == 32 or c == 9 or c == 10 or c == 13 \{ return 1 \}\n")
    p.push("    return 0\n")
    p.push("\}\n")
    p.push("fn rt_str_trim(s: int) -> int \{\n")
    p.push("    let n = load64(s)\n")
    p.push("    var lo = 0\n")
    p.push("    while lo < n and rx_is_ws(load8(s + 8 + lo)) == 1 \{ lo += 1 \}\n")
    p.push("    var hi = n\n")
    p.push("    while hi > lo and rx_is_ws(load8(s + 8 + hi - 1)) == 1 \{ hi -= 1 \}\n")
    p.push("    return rt_str_sub(s, lo, hi)\n")
    p.push("\}\n")
    p.push("fn rt_str_repeat(s: int, k: int) -> int \{\n")
    p.push("    let n = load64(s)\n")
    p.push("    var cnt = k\n")
    p.push("    if cnt < 0 \{ cnt = 0 \}\n")
    p.push("    let r = rx_str_alloc(n * cnt)\n")
    p.push("    var i = 0\n")
    p.push("    while i < cnt \{\n")
    p.push("        rx_mcopy(r + 8 + i * n, s + 8, n)\n")
    p.push("        i += 1\n")
    p.push("    \}\n")
    p.push("    return r\n")
    p.push("\}\n")
    p.push("fn rt_list_contains(l: int, v: int) -> int \{\n")
    p.push("    let n = load64(l)\n")
    p.push("    let data = load64(l + 16)\n")
    p.push("    var i = 0\n")
    p.push("    while i < n \{\n")
    p.push("        if load64(data + i * 8) == v \{ return 1 \}\n")
    p.push("        i += 1\n")
    p.push("    \}\n")
    p.push("    return 0\n")
    p.push("\}\n")
    p.push("fn rt_list_contains_str(l: int, v: int) -> int \{\n")
    p.push("    let n = load64(l)\n")
    p.push("    let data = load64(l + 16)\n")
    p.push("    var i = 0\n")
    p.push("    while i < n \{\n")
    p.push("        if rt_str_eq(load64(data + i * 8), v) == 1 \{ return 1 \}\n")
    p.push("        i += 1\n")
    p.push("    \}\n")
    p.push("    return 0\n")
    p.push("\}\n")
    p.push("// ---- hash map ----\n")
    p.push("// layout: [0]count [8]cap(pow2) [16]keys [24]vals [32]state(bytes) [40]keykind\n")
    p.push("// state: 0 = empty, 1 = live, 2 = tombstone.  keykind: 0 = by value, 1 = str.\n")
    p.push("// Called by name from the compiler; a map whose keys and values it will not drop.\n")
    p.push("fn rt_map_new(keykind: int) -> int \{\n")
    p.push("    return rt_map_new_d(keykind, 0)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// `desc` is a kind-3 descriptor saying whether keys and values are references.\n")
    p.push("fn rt_map_new_d(keykind: int, desc: int) -> int \{\n")
    p.push("    var d = desc\n")
    p.push("    if d == 0 \{ d = __d_map_val \}     // the buffers still have to go when the map does\n")
    p.push("    let m = rt_alloc_d(48, d)\n")
    p.push("    let cap = 8\n")
    p.push("    store64(m, 0)\n")
    p.push("    store64(m + 8, cap)\n")
    p.push("    store64(m + 16, rt_alloc(cap * 8))\n")
    p.push("    store64(m + 24, rt_alloc(cap * 8))\n")
    p.push("    store64(m + 32, rt_alloc(cap))\n")
    p.push("    store64(m + 40, keykind)\n")
    p.push("    return m\n")
    p.push("\}\n")
    p.push("fn rx_hash_int(k: int) -> int \{\n")
    p.push("    var h = k * 1000003\n")
    p.push("    h = h ^ (h >> 31)\n")
    p.push("    h = h * 2654435761\n")
    p.push("    h = h ^ (h >> 29)\n")
    p.push("    return h & 9223372036854775807\n")
    p.push("\}\n")
    p.push("fn rx_hash_str(s: int) -> int \{\n")
    p.push("    let n = load64(s)\n")
    p.push("    var h = 2166136261\n")
    p.push("    var i = 0\n")
    p.push("    while i < n \{\n")
    p.push("        h = h ^ load8(s + 8 + i)\n")
    p.push("        h = h * 16777619\n")
    p.push("        i += 1\n")
    p.push("    \}\n")
    p.push("    return h & 9223372036854775807\n")
    p.push("\}\n")
    p.push("fn rx_map_hash(m: int, k: int) -> int \{\n")
    p.push("    if load64(m + 40) == 1 \{ return rx_hash_str(k) \}\n")
    p.push("    return rx_hash_int(k)\n")
    p.push("\}\n")
    p.push("fn rx_key_eq(m: int, a: int, b: int) -> int \{\n")
    p.push("    if load64(m + 40) == 1 \{ return rt_str_eq(a, b) \}\n")
    p.push("    if a == b \{ return 1 \}\n")
    p.push("    return 0\n")
    p.push("\}\n")
    p.push("// slot holding k, or -1\n")
    p.push("fn rx_map_lookup(m: int, k: int) -> int \{\n")
    p.push("    let cap = load64(m + 8)\n")
    p.push("    let keys = load64(m + 16)\n")
    p.push("    let state = load64(m + 32)\n")
    p.push("    var i = rx_map_hash(m, k) & (cap - 1)\n")
    p.push("    var probes = 0\n")
    p.push("    while probes < cap \{\n")
    p.push("        let st = load8(state + i)\n")
    p.push("        if st == 0 \{ return 0 - 1 \}\n")
    p.push("        if st == 1 and rx_key_eq(m, load64(keys + i * 8), k) == 1 \{ return i \}\n")
    p.push("        i = (i + 1) & (cap - 1)\n")
    p.push("        probes += 1\n")
    p.push("    \}\n")
    p.push("    return 0 - 1\n")
    p.push("\}\n")
    p.push("fn rx_map_insert(m: int, k: int, v: int) \{\n")
    p.push("    let cap = load64(m + 8)\n")
    p.push("    let keys = load64(m + 16)\n")
    p.push("    let vals = load64(m + 24)\n")
    p.push("    let state = load64(m + 32)\n")
    p.push("    var i = rx_map_hash(m, k) & (cap - 1)\n")
    p.push("    var tomb = 0 - 1\n")
    p.push("    var probes = 0\n")
    p.push("    while probes < cap \{\n")
    p.push("        let st = load8(state + i)\n")
    p.push("        if st == 1 and rx_key_eq(m, load64(keys + i * 8), k) == 1 \{\n")
    p.push("            if rx_vref(m) == 1 \{ rx_assign(vals + i * 8, v) \}   // update in place\n")
    p.push("            else \{ store64(vals + i * 8, v) \}\n")
    p.push("            if rx_kref(m) == 1 \{ rx_drop(k) \}                    // the old key stays\n")
    p.push("            return\n")
    p.push("        \}\n")
    p.push("        if st == 2 and tomb < 0 \{ tomb = i \}\n")
    p.push("        if st == 0 \{\n")
    p.push("            var slot = i\n")
    p.push("            if tomb >= 0 \{ slot = tomb \}\n")
    p.push("            store64(keys + slot * 8, k)\n")
    p.push("            store64(vals + slot * 8, v)\n")
    p.push("            store8(state + slot, 1)\n")
    p.push("            store64(m, load64(m) + 1)\n")
    p.push("            return\n")
    p.push("        \}\n")
    p.push("        i = (i + 1) & (cap - 1)\n")
    p.push("        probes += 1\n")
    p.push("    \}\n")
    p.push("    rt_die(\"map overflow\")\n")
    p.push("\}\n")
    p.push("fn rx_map_grow(m: int) \{\n")
    p.push("    let oldcap = load64(m + 8)\n")
    p.push("    let oldkeys = load64(m + 16)\n")
    p.push("    let oldvals = load64(m + 24)\n")
    p.push("    let oldstate = load64(m + 32)\n")
    p.push("    let ncap = oldcap * 2\n")
    p.push("    store64(m + 8, ncap)\n")
    p.push("    store64(m + 16, rt_alloc(ncap * 8))\n")
    p.push("    store64(m + 24, rt_alloc(ncap * 8))\n")
    p.push("    store64(m + 32, rt_alloc(ncap))       // fresh pages are zero = all empty\n")
    p.push("    store64(m, 0)\n")
    p.push("    let isint = load64(m + 40) == 0\n")
    p.push("    var i = 0\n")
    p.push("    while i < oldcap \{\n")
    p.push("        if load8(oldstate + i) == 1 \{\n")
    p.push("            if isint \{ rx_iinsert(m, load64(oldkeys + i * 8), load64(oldvals + i * 8)) \}\n")
    p.push("            else \{ rx_map_insert(m, load64(oldkeys + i * 8), load64(oldvals + i * 8)) \}\n")
    p.push("        \}\n")
    p.push("        i += 1\n")
    p.push("    \}\n")
    p.push("    // The entries moved, not their counts: only the old arrays themselves die.\n")
    p.push("    rx_drop(oldkeys)\n")
    p.push("    rx_drop(oldvals)\n")
    p.push("    rx_drop(oldstate)\n")
    p.push("\}\n")
    p.push("// ---- int-key fast paths: hash and == inlined, no call per probe ----\n")
    p.push("fn rx_ilookup(m: int, k: int) -> int \{\n")
    p.push("    let cap = load64(m + 8)\n")
    p.push("    let keys = load64(m + 16)\n")
    p.push("    let state = load64(m + 32)\n")
    p.push("    var h = k * 1000003\n")
    p.push("    h = h ^ (h >> 31)\n")
    p.push("    h = h * 2654435761\n")
    p.push("    h = h ^ (h >> 29)\n")
    p.push("    var i = h & 9223372036854775807 & (cap - 1)\n")
    p.push("    var probes = 0\n")
    p.push("    while probes < cap \{\n")
    p.push("        let st = load8(state + i)\n")
    p.push("        if st == 0 \{ return 0 - 1 \}\n")
    p.push("        if st == 1 and load64(keys + i * 8) == k \{ return i \}\n")
    p.push("        i = (i + 1) & (cap - 1)\n")
    p.push("        probes += 1\n")
    p.push("    \}\n")
    p.push("    return 0 - 1\n")
    p.push("\}\n")
    p.push("fn rx_iinsert(m: int, k: int, v: int) \{\n")
    p.push("    let cap = load64(m + 8)\n")
    p.push("    let keys = load64(m + 16)\n")
    p.push("    let vals = load64(m + 24)\n")
    p.push("    let state = load64(m + 32)\n")
    p.push("    var h = k * 1000003\n")
    p.push("    h = h ^ (h >> 31)\n")
    p.push("    h = h * 2654435761\n")
    p.push("    h = h ^ (h >> 29)\n")
    p.push("    var i = h & 9223372036854775807 & (cap - 1)\n")
    p.push("    var tomb = 0 - 1\n")
    p.push("    var probes = 0\n")
    p.push("    while probes < cap \{\n")
    p.push("        let st = load8(state + i)\n")
    p.push("        if st == 1 and load64(keys + i * 8) == k \{\n")
    p.push("            if rx_vref(m) == 1 \{ rx_assign(vals + i * 8, v) \}\n")
    p.push("            else \{ store64(vals + i * 8, v) \}\n")
    p.push("            return\n")
    p.push("        \}\n")
    p.push("        if st == 2 and tomb < 0 \{ tomb = i \}\n")
    p.push("        if st == 0 \{\n")
    p.push("            var slot = i\n")
    p.push("            if tomb >= 0 \{ slot = tomb \}\n")
    p.push("            store64(keys + slot * 8, k)\n")
    p.push("            store64(vals + slot * 8, v)\n")
    p.push("            store8(state + slot, 1)\n")
    p.push("            store64(m, load64(m) + 1)\n")
    p.push("            return\n")
    p.push("        \}\n")
    p.push("        i = (i + 1) & (cap - 1)\n")
    p.push("        probes += 1\n")
    p.push("    \}\n")
    p.push("    rt_die(\"map overflow\")\n")
    p.push("\}\n")
    p.push("fn rt_map_set(m: int, k: int, v: int) \{\n")
    p.push("    if (load64(m) + 1) * 10 >= load64(m + 8) * 7 \{ rx_map_grow(m) \}   // grow at 70%\n")
    p.push("    if load64(m + 40) == 0 \{\n")
    p.push("        rx_iinsert(m, k, v)\n")
    p.push("        return\n")
    p.push("    \}\n")
    p.push("    rx_map_insert(m, k, v)\n")
    p.push("\}\n")
    p.push("// Lookups hand back a +1 of their own when the values are references: the\n")
    p.push("// caller owns what it gets, the map keeps what it holds. rt_map_set and\n")
    p.push("// rt_list_push are the only runtime entry points that take ownership of an\n")
    p.push("// argument; everything else borrows.\n")
    p.push("fn rt_map_get(m: int, k: int) -> int \{\n")
    p.push("    let i = rx_lookup(m, k)\n")
    p.push("    if i < 0 \{ rt_die(\"map key not found\") \}\n")
    p.push("    let v = load64(load64(m + 24) + i * 8)\n")
    p.push("    if rx_vref(m) == 1 \{ let d = rx_dup(v) \}\n")
    p.push("    return v\n")
    p.push("\}\n")
    p.push("// fused m.get(k).or(d): the value or the default, no optional cell allocated\n")
    p.push("fn rt_map_get_or(m: int, k: int, d: int) -> int \{\n")
    p.push("    let i = rx_lookup(m, k)\n")
    p.push("    var v = d\n")
    p.push("    if i >= 0 \{ v = load64(load64(m + 24) + i * 8) \}\n")
    p.push("    if rx_vref(m) == 1 \{ let d = rx_dup(v) \}\n")
    p.push("    return v\n")
    p.push("\}\n")
    p.push("// dispatch: int-keyed maps take the inlined fast path\n")
    p.push("fn rx_lookup(m: int, k: int) -> int \{\n")
    p.push("    if load64(m + 40) == 0 \{ return rx_ilookup(m, k) \}\n")
    p.push("    return rx_map_lookup(m, k)\n")
    p.push("\}\n")
    p.push("// safe lookup: returns an optional cell (0 = none)\n")
    p.push("fn rt_map_get_opt(m: int, k: int) -> int \{\n")
    p.push("    let i = rx_lookup(m, k)\n")
    p.push("    if i < 0 \{ return 0 \}\n")
    p.push("    let v = load64(load64(m + 24) + i * 8)\n")
    p.push("    var cell = 0\n")
    p.push("    if rx_vref(m) == 1 \{\n")
    p.push("        cell = rt_alloc_d(8, __d_box_ref)\n")
    p.push("        let d = rx_dup(v)\n")
    p.push("    \} else \{\n")
    p.push("        cell = rt_alloc_d(8, __d_box_val)\n")
    p.push("    \}\n")
    p.push("    store64(cell, v)\n")
    p.push("    return cell\n")
    p.push("\}\n")
    p.push("fn rt_map_has(m: int, k: int) -> int \{\n")
    p.push("    if rx_lookup(m, k) >= 0 \{ return 1 \}\n")
    p.push("    return 0\n")
    p.push("\}\n")
    p.push("fn rt_map_remove(m: int, k: int) \{\n")
    p.push("    let i = rx_lookup(m, k)\n")
    p.push("    if i < 0 \{ return \}\n")
    p.push("    store8(load64(m + 32) + i, 2)         // tombstone\n")
    p.push("    store64(m, load64(m) - 1)\n")
    p.push("    if rx_kref(m) == 1 \{ rx_drop(load64(load64(m + 16) + i * 8)) \}\n")
    p.push("    if rx_vref(m) == 1 \{ rx_drop(load64(load64(m + 24) + i * 8)) \}\n")
    p.push("\}\n")
    p.push("fn rt_map_keys(m: int) -> int \{\n")
    p.push("    let cap = load64(m + 8)\n")
    p.push("    let keys = load64(m + 16)\n")
    p.push("    let state = load64(m + 32)\n")
    p.push("    var ld = __d_list_val\n")
    p.push("    if rx_kref(m) == 1 \{ ld = __d_list_ref \}\n")
    p.push("    let out = rt_list_new_d(0, ld)\n")
    p.push("    var i = 0\n")
    p.push("    while i < cap \{\n")
    p.push("        if load8(state + i) == 1 \{ rt_list_push(out, rx_dup(load64(keys + i * 8))) \}\n")
    p.push("        i += 1\n")
    p.push("    \}\n")
    p.push("    return out\n")
    p.push("\}\n")
    p.push("fn rt_map_values(m: int) -> int \{\n")
    p.push("    let cap = load64(m + 8)\n")
    p.push("    let vals = load64(m + 24)\n")
    p.push("    let state = load64(m + 32)\n")
    p.push("    var ld = __d_list_val\n")
    p.push("    if rx_vref(m) == 1 \{ ld = __d_list_ref \}\n")
    p.push("    let out = rt_list_new_d(0, ld)\n")
    p.push("    var i = 0\n")
    p.push("    while i < cap \{\n")
    p.push("        if load8(state + i) == 1 \{ rt_list_push(out, rx_dup(load64(vals + i * 8))) \}\n")
    p.push("        i += 1\n")
    p.push("    \}\n")
    p.push("    return out\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// ---- sorting (heapsort: in place, O(n log n), no recursion) ----\n")
    p.push("// kind: 0 = by value (int/bool/enum), 1 = str, 2 = float.  Kept free of\n")
    p.push("// function values so the C seed can still compile this file.\n")
    p.push("fn rx_cmp_kind(kind: int, a: int, b: int) -> int \{\n")
    p.push("    if kind == 1 \{ return rt_str_cmp(a, b) \}\n")
    p.push("    if kind == 2 \{\n")
    p.push("        let x = frombits(a)\n")
    p.push("        let y = frombits(b)\n")
    p.push("        if x < y \{ return 0 - 1 \}\n")
    p.push("        if x > y \{ return 1 \}\n")
    p.push("        return 0\n")
    p.push("    \}\n")
    p.push("    if a < b \{ return 0 - 1 \}\n")
    p.push("    if a > b \{ return 1 \}\n")
    p.push("    return 0\n")
    p.push("\}\n")
    p.push("fn rx_sift(data: int, n: int, start: int, kind: int) \{\n")
    p.push("    var root = start\n")
    p.push("    var going = true\n")
    p.push("    while going \{\n")
    p.push("        let child = 2 * root + 1\n")
    p.push("        if child >= n \{\n")
    p.push("            going = false\n")
    p.push("            continue\n")
    p.push("        \}\n")
    p.push("        var big = root\n")
    p.push("        if rx_cmp_kind(kind, load64(data + big * 8), load64(data + child * 8)) < 0 \{ big = child \}\n")
    p.push("        if child + 1 < n \{\n")
    p.push("            if rx_cmp_kind(kind, load64(data + big * 8), load64(data + child * 8 + 8)) < 0 \{ big = child + 1 \}\n")
    p.push("        \}\n")
    p.push("        if big == root \{\n")
    p.push("            going = false\n")
    p.push("            continue\n")
    p.push("        \}\n")
    p.push("        let t = load64(data + root * 8)\n")
    p.push("        store64(data + root * 8, load64(data + big * 8))\n")
    p.push("        store64(data + big * 8, t)\n")
    p.push("        root = big\n")
    p.push("    \}\n")
    p.push("\}\n")
    p.push("fn rx_swap(data: int, i: int, j: int) \{\n")
    p.push("    let t = load64(data + i * 8)\n")
    p.push("    store64(data + i * 8, load64(data + j * 8))\n")
    p.push("    store64(data + j * 8, t)\n")
    p.push("\}\n")
    p.push("// heapsort restricted to [lo, hi] -- the introsort depth-limit fallback that\n")
    p.push("// keeps the worst case O(n log n).\n")
    p.push("fn rx_heapsort_range(data: int, lo: int, hi: int, kind: int) \{\n")
    p.push("    let base = data + lo * 8\n")
    p.push("    let n = hi - lo + 1\n")
    p.push("    var i = n / 2 - 1\n")
    p.push("    while i >= 0 \{\n")
    p.push("        rx_sift(base, n, i, kind)\n")
    p.push("        i -= 1\n")
    p.push("    \}\n")
    p.push("    var e = n - 1\n")
    p.push("    while e > 0 \{\n")
    p.push("        let t = load64(base)\n")
    p.push("        store64(base, load64(base + e * 8))\n")
    p.push("        store64(base + e * 8, t)\n")
    p.push("        rx_sift(base, e, 0, kind)\n")
    p.push("        e -= 1\n")
    p.push("    \}\n")
    p.push("\}\n")
    p.push("// median-of-three Hoare partition; pivot is an element value so it always\n")
    p.push("// terminates. Returns the split index j: [lo, j] and [j+1, hi].\n")
    p.push("fn rx_partition(data: int, lo: int, hi: int, kind: int) -> int \{\n")
    p.push("    let mid = lo + (hi - lo) / 2\n")
    p.push("    if rx_cmp_kind(kind, load64(data + mid * 8), load64(data + lo * 8)) < 0 \{ rx_swap(data, lo, mid) \}\n")
    p.push("    if rx_cmp_kind(kind, load64(data + hi * 8), load64(data + lo * 8)) < 0 \{ rx_swap(data, lo, hi) \}\n")
    p.push("    if rx_cmp_kind(kind, load64(data + hi * 8), load64(data + mid * 8)) < 0 \{ rx_swap(data, mid, hi) \}\n")
    p.push("    let pivot = load64(data + mid * 8)\n")
    p.push("    var i = lo - 1\n")
    p.push("    var j = hi + 1\n")
    p.push("    var res = 0\n")
    p.push("    var done = false\n")
    p.push("    while not done \{\n")
    p.push("        i += 1\n")
    p.push("        while rx_cmp_kind(kind, load64(data + i * 8), pivot) < 0 \{ i += 1 \}\n")
    p.push("        j -= 1\n")
    p.push("        while rx_cmp_kind(kind, load64(data + j * 8), pivot) > 0 \{ j -= 1 \}\n")
    p.push("        if i >= j \{\n")
    p.push("            res = j\n")
    p.push("            done = true\n")
    p.push("        \} else \{\n")
    p.push("            rx_swap(data, i, j)\n")
    p.push("        \}\n")
    p.push("    \}\n")
    p.push("    return res\n")
    p.push("\}\n")
    p.push("// introsort: quicksort, recursing into the smaller partition and looping on the\n")
    p.push("// larger (stack depth O(log n)); drop to heapsort when recursion gets too deep.\n")
    p.push("fn rx_introsort(data: int, lo0: int, hi0: int, depth0: int, kind: int) \{\n")
    p.push("    var lo = lo0\n")
    p.push("    var hi = hi0\n")
    p.push("    var depth = depth0\n")
    p.push("    while hi - lo > 16 \{\n")
    p.push("        if depth <= 0 \{\n")
    p.push("            rx_heapsort_range(data, lo, hi, kind)\n")
    p.push("            return\n")
    p.push("        \}\n")
    p.push("        depth -= 1\n")
    p.push("        let p = rx_partition(data, lo, hi, kind)\n")
    p.push("        if p - lo < hi - p - 1 \{\n")
    p.push("            rx_introsort(data, lo, p, depth, kind)\n")
    p.push("            lo = p + 1\n")
    p.push("        \} else \{\n")
    p.push("            rx_introsort(data, p + 1, hi, depth, kind)\n")
    p.push("            hi = p\n")
    p.push("        \}\n")
    p.push("    \}\n")
    p.push("\}\n")
    p.push("// finishing pass: ranges left <= 16 wide by introsort are nearly sorted, so one\n")
    p.push("// insertion sort over the whole array is O(n) with a tiny constant.\n")
    p.push("fn rx_insertion(data: int, lo: int, hi: int, kind: int) \{\n")
    p.push("    var i = lo + 1\n")
    p.push("    while i <= hi \{\n")
    p.push("        let v = load64(data + i * 8)\n")
    p.push("        var j = i - 1\n")
    p.push("        var going = true\n")
    p.push("        while going and j >= lo \{\n")
    p.push("            if rx_cmp_kind(kind, load64(data + j * 8), v) > 0 \{\n")
    p.push("                store64(data + (j + 1) * 8, load64(data + j * 8))\n")
    p.push("                j -= 1\n")
    p.push("            \} else \{\n")
    p.push("                going = false\n")
    p.push("            \}\n")
    p.push("        \}\n")
    p.push("        store64(data + (j + 1) * 8, v)\n")
    p.push("        i += 1\n")
    p.push("    \}\n")
    p.push("\}\n")
    p.push("// ---- int-specialized introsort: same structure, but comparisons are inline\n")
    p.push("// `<`/`>` on loaded values instead of a call to rx_cmp_kind per compare. The\n")
    p.push("// call overhead dominates a generic sort, so this is the path that matters. ----\n")
    p.push("fn rx_heapsort_range_int(data: int, lo: int, hi: int) \{\n")
    p.push("    let base = data + lo * 8\n")
    p.push("    let n = hi - lo + 1\n")
    p.push("    var i = n / 2 - 1\n")
    p.push("    while i >= 0 \{\n")
    p.push("        var root = i\n")
    p.push("        var going = true\n")
    p.push("        while going \{\n")
    p.push("            let child = 2 * root + 1\n")
    p.push("            if child >= n \{\n")
    p.push("                going = false\n")
    p.push("            \} else \{\n")
    p.push("                var big = root\n")
    p.push("                if load64(base + big * 8) < load64(base + child * 8) \{ big = child \}\n")
    p.push("                if child + 1 < n and load64(base + big * 8) < load64(base + child * 8 + 8) \{ big = child + 1 \}\n")
    p.push("                if big == root \{\n")
    p.push("                    going = false\n")
    p.push("                \} else \{\n")
    p.push("                    rx_swap(base, root, big)\n")
    p.push("                    root = big\n")
    p.push("                \}\n")
    p.push("            \}\n")
    p.push("        \}\n")
    p.push("        i -= 1\n")
    p.push("    \}\n")
    p.push("    var e = n - 1\n")
    p.push("    while e > 0 \{\n")
    p.push("        rx_swap(base, 0, e)\n")
    p.push("        var root = 0\n")
    p.push("        var going = true\n")
    p.push("        while going \{\n")
    p.push("            let child = 2 * root + 1\n")
    p.push("            if child >= e \{\n")
    p.push("                going = false\n")
    p.push("            \} else \{\n")
    p.push("                var big = root\n")
    p.push("                if load64(base + big * 8) < load64(base + child * 8) \{ big = child \}\n")
    p.push("                if child + 1 < e and load64(base + big * 8) < load64(base + child * 8 + 8) \{ big = child + 1 \}\n")
    p.push("                if big == root \{\n")
    p.push("                    going = false\n")
    p.push("                \} else \{\n")
    p.push("                    rx_swap(base, root, big)\n")
    p.push("                    root = big\n")
    p.push("                \}\n")
    p.push("            \}\n")
    p.push("        \}\n")
    p.push("        e -= 1\n")
    p.push("    \}\n")
    p.push("\}\n")
    p.push("// Branchless Lomuto partition (the pdqsort / Alexandrescu technique). The\n")
    p.push("// median-of-3 pivot is parked at a[hi]; the scan swaps a[r] and a[w]\n")
    p.push("// UNCONDITIONALLY -- when a[r] >= pivot both slots hold >=pivot elements, so\n")
    p.push("// the exchange is harmless -- and advances w by the comparison RESULT computed\n")
    p.push("// arithmetically (overflow-safe signed less-than via sign bits). Zero\n")
    p.push("// data-dependent branches: random data costs no branch mispredictions, which\n")
    p.push("// is where a classic Hoare scan loses half its time. Returns w with the pivot\n")
    p.push("// fixed at a[w]: [lo, w-1] < pivot, [w+1, hi] >= pivot.\n")
    p.push("fn rx_partition_int(data: int, lo: int, hi: int) -> int \{\n")
    p.push("    let mid = lo + (hi - lo) / 2\n")
    p.push("    if load64(data + mid * 8) < load64(data + lo * 8) \{ rx_swap(data, lo, mid) \}\n")
    p.push("    if load64(data + hi * 8) < load64(data + lo * 8) \{ rx_swap(data, lo, hi) \}\n")
    p.push("    if load64(data + hi * 8) < load64(data + mid * 8) \{ rx_swap(data, mid, hi) \}\n")
    p.push("    rx_swap(data, mid, hi)               // park the median at hi\n")
    p.push("    let p = load64(data + hi * 8)\n")
    p.push("    var w = lo\n")
    p.push("    var r = lo\n")
    p.push("    while r < hi \{\n")
    p.push("        // one temp only, so register promotion covers every hot value here\n")
    p.push("        // (data, w, r, p, x, hi -> six callee-saved registers, zero spills)\n")
    p.push("        let x = load64(data + r * 8)\n")
    p.push("        store64(data + r * 8, load64(data + w * 8))\n")
    p.push("        store64(data + w * 8, x)\n")
    p.push("        w += ((((x - p) ^ ((x ^ p) & ((x - p) ^ x))) >> 63) & 1)   // w += (x < p)\n")
    p.push("        r += 1\n")
    p.push("    \}\n")
    p.push("    rx_swap(data, w, hi)                 // pivot into its final slot\n")
    p.push("    return w\n")
    p.push("\}\n")
    p.push("fn rx_introsort_int(data: int, lo0: int, hi0: int, depth0: int) \{\n")
    p.push("    var lo = lo0\n")
    p.push("    var hi = hi0\n")
    p.push("    var depth = depth0\n")
    p.push("    while hi - lo > 24 \{\n")
    p.push("        if depth <= 0 \{\n")
    p.push("            rx_heapsort_range_int(data, lo, hi)\n")
    p.push("            return\n")
    p.push("        \}\n")
    p.push("        depth -= 1\n")
    p.push("        let w = rx_partition_int(data, lo, hi)     // pivot is FIXED at a[w]\n")
    p.push("        // skip the run of pivot-equal elements after w: with many duplicates\n")
    p.push("        // (or an all-equal range) this is what keeps the right side shrinking\n")
    p.push("        let p = load64(data + w * 8)\n")
    p.push("        var rl = w + 1\n")
    p.push("        while rl <= hi and load64(data + rl * 8) == p \{ rl += 1 \}\n")
    p.push("        if w - lo < hi - rl \{\n")
    p.push("            rx_introsort_int(data, lo, w - 1, depth)\n")
    p.push("            lo = rl\n")
    p.push("        \} else \{\n")
    p.push("            rx_introsort_int(data, rl, hi, depth)\n")
    p.push("            hi = w - 1\n")
    p.push("        \}\n")
    p.push("    \}\n")
    p.push("\}\n")
    p.push("fn rx_insertion_int(data: int, lo: int, hi: int) \{\n")
    p.push("    var i = lo + 1\n")
    p.push("    while i <= hi \{\n")
    p.push("        let v = load64(data + i * 8)\n")
    p.push("        var j = i - 1\n")
    p.push("        var going = true\n")
    p.push("        while going and j >= lo \{\n")
    p.push("            if load64(data + j * 8) > v \{\n")
    p.push("                store64(data + (j + 1) * 8, load64(data + j * 8))\n")
    p.push("                j -= 1\n")
    p.push("            \} else \{\n")
    p.push("                going = false\n")
    p.push("            \}\n")
    p.push("        \}\n")
    p.push("        store64(data + (j + 1) * 8, v)\n")
    p.push("        i += 1\n")
    p.push("    \}\n")
    p.push("\}\n")
    p.push("fn rx_sort(l: int, kind: int) \{\n")
    p.push("    let n = load64(l)\n")
    p.push("    if n < 2 \{ return \}\n")
    p.push("    let data = load64(l + 16)\n")
    p.push("    var depth = 0\n")
    p.push("    var t = n\n")
    p.push("    while t > 0 \{\n")
    p.push("        depth += 1\n")
    p.push("        t = t / 2\n")
    p.push("    \}\n")
    p.push("    depth = depth * 2\n")
    p.push("    if kind == 0 \{\n")
    p.push("        rx_introsort_int(data, 0, n - 1, depth)\n")
    p.push("        rx_insertion_int(data, 0, n - 1)\n")
    p.push("    \} else \{\n")
    p.push("        rx_introsort(data, 0, n - 1, depth, kind)\n")
    p.push("        rx_insertion(data, 0, n - 1, kind)\n")
    p.push("    \}\n")
    p.push("\}\n")
    p.push("fn rt_list_sort_int(l: int) \{ rx_sort(l, 0) \}\n")
    p.push("fn rt_list_sort_str(l: int) \{ rx_sort(l, 1) \}\n")
    p.push("fn rt_list_sort_float(l: int) \{ rx_sort(l, 2) \}\n")
    p.push("\n")
    p.push("fn rt_list_index_of(l: int, v: int) -> int \{\n")
    p.push("    let n = load64(l)\n")
    p.push("    let data = load64(l + 16)\n")
    p.push("    var i = 0\n")
    p.push("    while i < n \{\n")
    p.push("        if load64(data + i * 8) == v \{ return i \}\n")
    p.push("        i += 1\n")
    p.push("    \}\n")
    p.push("    return 0 - 1\n")
    p.push("\}\n")
    p.push("fn rt_list_index_of_str(l: int, v: int) -> int \{\n")
    p.push("    let n = load64(l)\n")
    p.push("    let data = load64(l + 16)\n")
    p.push("    var i = 0\n")
    p.push("    while i < n \{\n")
    p.push("        if rt_str_eq(load64(data + i * 8), v) == 1 \{ return i \}\n")
    p.push("        i += 1\n")
    p.push("    \}\n")
    p.push("    return 0 - 1\n")
    p.push("\}\n")
    p.push("fn rt_list_reverse(l: int) \{\n")
    p.push("    let n = load64(l)\n")
    p.push("    let data = load64(l + 16)\n")
    p.push("    var i = 0\n")
    p.push("    var j = n - 1\n")
    p.push("    while i < j \{\n")
    p.push("        let a = load64(data + i * 8)\n")
    p.push("        let b = load64(data + j * 8)\n")
    p.push("        store64(data + i * 8, b)\n")
    p.push("        store64(data + j * 8, a)\n")
    p.push("        i += 1\n")
    p.push("        j -= 1\n")
    p.push("    \}\n")
    p.push("\}\n")
    p.push("fn rt_list_slice(l: int, lo: int, hi: int) -> int \{\n")
    p.push("    let n = load64(l)\n")
    p.push("    if lo < 0 or hi < lo or hi > n \{ rt_die(\"invalid slice\") \}\n")
    p.push("    let data = load64(l + 16)\n")
    p.push("    let out = rt_list_new_d(hi - lo, load64(l - 16))\n")
    p.push("    rx_mcopy(load64(out + 16), data + lo * 8, (hi - lo) * 8)\n")
    p.push("    if rx_kref(l) == 1 \{                  // kind 2: [8] is the element flag\n")
    p.push("        var i = lo\n")
    p.push("        while i < hi \{\n")
    p.push("            let d = rx_dup(load64(data + i * 8))\n")
    p.push("            i += 1\n")
    p.push("        \}\n")
    p.push("    \}\n")
    p.push("    return out\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn rt_join(l: int) -> int \{\n")
    p.push("    let n = load64(l)\n")
    p.push("    let data = load64(l + 16)\n")
    p.push("    var total = 0\n")
    p.push("    var i = 0\n")
    p.push("    while i < n \{\n")
    p.push("        total += load64(load64(data + i * 8))\n")
    p.push("        i += 1\n")
    p.push("    \}\n")
    p.push("    let r = rx_str_alloc(total)\n")
    p.push("    var off = 0\n")
    p.push("    i = 0\n")
    p.push("    while i < n \{\n")
    p.push("        let part = load64(data + i * 8)\n")
    p.push("        let pl = load64(part)\n")
    p.push("        rx_mcopy(r + 8 + off, part + 8, pl)\n")
    p.push("        off += pl\n")
    p.push("        i += 1\n")
    p.push("    \}\n")
    p.push("    return r\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn rt_str_to_int(s: int) -> int \{\n")
    p.push("    let n = load64(s)\n")
    p.push("    var i = 0\n")
    p.push("    while i < n and load8(s + 8 + i) == 32 \{ i += 1 \}\n")
    p.push("    var neg = false\n")
    p.push("    if i < n and (load8(s + 8 + i) == 43 or load8(s + 8 + i) == 45) \{\n")
    p.push("        if load8(s + 8 + i) == 45 \{ neg = true \}\n")
    p.push("        i += 1\n")
    p.push("    \}\n")
    p.push("    var v = 0\n")
    p.push("    var any = false\n")
    p.push("    while i < n \{\n")
    p.push("        let c = load8(s + 8 + i)\n")
    p.push("        if c < 48 or c > 57 \{ break \}\n")
    p.push("        v = v * 10 + (c - 48)\n")
    p.push("        any = true\n")
    p.push("        i += 1\n")
    p.push("    \}\n")
    p.push("    while i < n and load8(s + 8 + i) == 32 \{ i += 1 \}\n")
    p.push("    if not any or i != n \{ rt_die(\"cannot convert to int\") \}\n")
    p.push("    if neg \{ return 0 - v \}\n")
    p.push("    return v\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// decimal float parser (sign, integer part, fraction; no exponent yet).\n")
    p.push("// returns the IEEE-754 bit pattern, which is what a float value is.\n")
    p.push("fn rt_str_to_float(s: int) -> int \{\n")
    p.push("    let n = load64(s)\n")
    p.push("    var i = 0\n")
    p.push("    while i < n and load8(s + 8 + i) == 32 \{ i += 1 \}\n")
    p.push("    var neg = false\n")
    p.push("    if i < n and (load8(s + 8 + i) == 43 or load8(s + 8 + i) == 45) \{\n")
    p.push("        if load8(s + 8 + i) == 45 \{ neg = true \}\n")
    p.push("        i += 1\n")
    p.push("    \}\n")
    p.push("    // Collect every digit into an integer mantissa and count the fractional\n")
    p.push("    // ones, then divide ONCE. Both the mantissa (< 2^53) and 10^k (k <= 22)\n")
    p.push("    // are exactly representable, so a single rounding lands on the same double\n")
    p.push("    // strtod would produce -- accumulating digit-by-digit with a 0.1 scale\n")
    p.push("    // instead lets a rounding error compound per digit, which put literals\n")
    p.push("    // like 1.72 and 0.09 one or two ulp off every other language's value.\n")
    p.push("    var mant = 0\n")
    p.push("    var nd = 0                                     // digits kept in mant\n")
    p.push("    var k = 0                                      // fractional digits\n")
    p.push("    var extra = 0                                  // integer digits dropped\n")
    p.push("    var any = false\n")
    p.push("    while i < n and load8(s + 8 + i) >= 48 and load8(s + 8 + i) <= 57 \{\n")
    p.push("        let d0 = load8(s + 8 + i) - 48\n")
    p.push("        if mant == 0 and d0 == 0 \{\n")
    p.push("            // a leading zero carries no information; spending mantissa budget on\n")
    p.push("            // it would push real digits off the end\n")
    p.push("        \} else if nd < 17 \{\n")
    p.push("            mant = mant * 10 + d0\n")
    p.push("            nd += 1\n")
    p.push("        \} else \{\n")
    p.push("            extra += 1                             // too big for exact mantissa\n")
    p.push("        \}\n")
    p.push("        any = true\n")
    p.push("        i += 1\n")
    p.push("    \}\n")
    p.push("    if i < n and load8(s + 8 + i) == 46 \{          // '.'\n")
    p.push("        i += 1\n")
    p.push("        while i < n and load8(s + 8 + i) >= 48 and load8(s + 8 + i) <= 57 \{\n")
    p.push("            let d1 = load8(s + 8 + i) - 48\n")
    p.push("            if mant == 0 and d1 == 0 \{\n")
    p.push("                k += 1                             // shifts the value, adds no digit\n")
    p.push("            \} else if nd < 17 \{\n")
    p.push("                mant = mant * 10 + d1\n")
    p.push("                nd += 1\n")
    p.push("                k += 1\n")
    p.push("            \}\n")
    p.push("            any = true\n")
    p.push("            i += 1\n")
    p.push("        \}\n")
    p.push("    \}\n")
    p.push("    var val = mant as float\n")
    p.push("    if extra > 0 \{\n")
    p.push("        // more integer digits than fit: scale back up (loses exactness, but\n")
    p.push("        // such a literal has already lost it)\n")
    p.push("        var e = 0\n")
    p.push("        while e < extra \{\n")
    p.push("            val = val * 10.0\n")
    p.push("            e += 1\n")
    p.push("        \}\n")
    p.push("    \}\n")
    p.push("    if k > 0 \{\n")
    p.push("        if k <= 22 \{\n")
    p.push("            var p = 1.0                            // 10^k is exact through 10^22\n")
    p.push("            var e2 = 0\n")
    p.push("            while e2 < k \{\n")
    p.push("                p = p * 10.0\n")
    p.push("                e2 += 1\n")
    p.push("            \}\n")
    p.push("            val = val / p\n")
    p.push("        \} else \{\n")
    p.push("            var e3 = 0\n")
    p.push("            while e3 < k \{\n")
    p.push("                val = val / 10.0\n")
    p.push("                e3 += 1\n")
    p.push("            \}\n")
    p.push("        \}\n")
    p.push("    \}\n")
    p.push("    while i < n and load8(s + 8 + i) == 32 \{ i += 1 \}\n")
    p.push("    if not any or i != n \{ rt_die(\"cannot convert to float\") \}\n")
    p.push("    if neg \{ val = 0.0 - val \}\n")
    p.push("    return bits(val)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// ---- lists ----  (a list value points to \{i64 len; i64 cap; i64 data\})\n")
    p.push("// Called by name from the compiler; a list whose elements it will not drop.\n")
    p.push("fn rt_list_new(n: int) -> int \{\n")
    p.push("    return rt_list_new_d(n, 0)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// `desc` is a kind-2 descriptor saying whether the elements are references.\n")
    p.push("fn rt_list_new_d(n: int, desc: int) -> int \{\n")
    p.push("    var d = desc\n")
    p.push("    if d == 0 \{ d = __d_list_val \}    // the data buffer still has to go when the list does\n")
    p.push("    let l = rt_alloc_d(24, d)\n")
    p.push("    var cap = n\n")
    p.push("    if cap < 4 \{ cap = 4 \}\n")
    p.push("    let data = rt_alloc(cap * 8)\n")
    p.push("    store64(l, n)\n")
    p.push("    store64(l + 8, cap)\n")
    p.push("    store64(l + 16, data)\n")
    p.push("    return l\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn rt_list_push(l: int, v: int) \{\n")
    p.push("    let n = load64(l)\n")
    p.push("    let cap = load64(l + 8)\n")
    p.push("    if n == cap \{\n")
    p.push("        let ncap = cap * 2\n")
    p.push("        let nd = rt_alloc(ncap * 8)\n")
    p.push("        let od = load64(l + 16)\n")
    p.push("        rx_mcopy(nd, od, n * 8)\n")
    p.push("        store64(l + 8, ncap)\n")
    p.push("        store64(l + 16, nd)\n")
    p.push("        rx_drop(od)                       // the cell was the buffer's only holder\n")
    p.push("    \}\n")
    p.push("    store64(load64(l + 16) + n * 8, v)\n")
    p.push("    store64(l, n + 1)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn rt_list_pop(l: int) -> int \{\n")
    p.push("    let n = load64(l)\n")
    p.push("    if n == 0 \{ rt_die(\"pop from empty list\") \}\n")
    p.push("    store64(l, n - 1)\n")
    p.push("    return load64(load64(l + 16) + (n - 1) * 8)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// ---- output: unbuffered WriteFile ----\n")
    p.push("var __scratch = 0\n")
    p.push("var __stdout = 0\n")
    p.push("\n")
    p.push("fn rx_out(fd: int, ptr: int, n: int) \{\n")
    p.push("    if __scratch == 0 \{ __scratch = rt_alloc(16) \}\n")
    p.push("    let r = win(\"WriteFile\", fd, ptr, n, __scratch, 0)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn rx_stdout_h() -> int \{\n")
    p.push("    if __stdout == 0 \{ __stdout = win(\"GetStdHandle\", 0 - 11) \}\n")
    p.push("    return __stdout\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn rx_out_str(s: int) \{\n")
    p.push("    rx_out(rx_stdout_h(), s + 8, load64(s))\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// ---- panics ----\n")
    p.push("fn rt_die(msg: str) \{\n")
    p.push("    let h = win(\"GetStdHandle\", 0 - 12)   // stderr\n")
    p.push("    rx_out(h, addr(\"panic: \") + 8, 7)\n")
    p.push("    rx_out(h, addr(msg) + 8, msg.len())\n")
    p.push("    rx_out(h, addr(\"\\n\") + 8, 1)\n")
    p.push("    let r = win(\"ExitProcess\", 1)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn rt_panic_str(s: str) \{\n")
    p.push("    rt_die(s)                             // a str value already is its pointer\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn rt_bounds_fail(i: int, n: int) \{\n")
    p.push("    rt_die(\"index out of bounds\")\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn rt_div_zero() \{\n")
    p.push("    rt_die(\"division by zero\")\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn rt_mod_zero() \{\n")
    p.push("    rt_die(\"modulo by zero\")\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// ---- formatting into the interpolation buffer ----\n")
    p.push("// The builder is per-thread. Its state is a 24-byte block -- [0] buffer,\n")
    p.push("// [8] length, [16] capacity -- reached through TLS once a second thread exists.\n")
    p.push("// The single-threaded fast path returns __sbmain, which is also what the main\n")
    p.push("// thread's TLS slot holds, so the two paths cannot disagree about which block a\n")
    p.push("// half-finished interpolation is building into.\n")
    p.push("var __sbmain = 0\n")
    p.push("var __tlsidx = 0\n")
    p.push("\n")
    p.push("fn rx_sb_init() \{\n")
    p.push("    if __sbmain != 0 \{ return \}\n")
    p.push("    __sbmain = win(\"VirtualAlloc\", 0, 64, 12288, 4)\n")
    p.push("    store64(__sbmain, win(\"VirtualAlloc\", 0, 65536, 12288, 4))\n")
    p.push("    store64(__sbmain + 8, 0)\n")
    p.push("    store64(__sbmain + 16, 65536)\n")
    p.push("    __tlsidx = win(\"TlsAlloc\")\n")
    p.push("    let r = win(\"TlsSetValue\", __tlsidx, __sbmain)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn rx_sb_p() -> int \{\n")
    p.push("    // Formatting can happen before the first allocation (print(5) reaches the\n")
    p.push("    // builder without ever calling rt_alloc), so this guard cannot be dropped\n")
    p.push("    // in favour of initialising from rx_heap_init alone.\n")
    p.push("    if __sbmain == 0 \{ rx_sb_init() \}\n")
    p.push("    if __nthr == 0 \{ return __sbmain \}\n")
    p.push("    var p = win(\"TlsGetValue\", __tlsidx)\n")
    p.push("    if p == 0 \{\n")
    p.push("        p = win(\"VirtualAlloc\", 0, 64, 12288, 4)\n")
    p.push("        store64(p, win(\"VirtualAlloc\", 0, 65536, 12288, 4))\n")
    p.push("        store64(p + 8, 0)\n")
    p.push("        store64(p + 16, 65536)\n")
    p.push("        let r = win(\"TlsSetValue\", __tlsidx, p)\n")
    p.push("    \}\n")
    p.push("    return p\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn rx_sb_ensure(p: int, extra: int) \{\n")
    p.push("    let cur = load64(p + 8)\n")
    p.push("    let cap = load64(p + 16)\n")
    p.push("    if cur + extra <= cap \{ return \}\n")
    p.push("    var ncap = cap * 2\n")
    p.push("    if ncap < 65536 \{ ncap = 65536 \}\n")
    p.push("    while ncap < cur + extra \{ ncap = ncap * 2 \}\n")
    p.push("    // VirtualAlloc, not rt_alloc: the builder must not itself allocate on the\n")
    p.push("    // GC heap, or formatting could trigger a collection mid-interpolation.\n")
    p.push("    let nb = win(\"VirtualAlloc\", 0, ncap, 12288, 4)\n")
    p.push("    rx_mcopy(nb, load64(p), cur)\n")
    p.push("    store64(p, nb)\n")
    p.push("    store64(p + 16, ncap)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn rx_sb_byte(c: int) \{\n")
    p.push("    let p = rx_sb_p()\n")
    p.push("    rx_sb_ensure(p, 1)\n")
    p.push("    store8(load64(p) + load64(p + 8), c)\n")
    p.push("    store64(p + 8, load64(p + 8) + 1)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn rx_sb_bytes(ptr: int, n: int) \{\n")
    p.push("    let p = rx_sb_p()\n")
    p.push("    rx_sb_ensure(p, n)\n")
    p.push("    rx_mcopy(load64(p) + load64(p + 8), ptr, n)\n")
    p.push("    store64(p + 8, load64(p + 8) + n)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn rx_sb_int(v: int) \{\n")
    p.push("    if v == 0 \{\n")
    p.push("        rx_sb_byte(48)\n")
    p.push("        return\n")
    p.push("    \}\n")
    p.push("    let neg = v < 0\n")
    p.push("    // work in the non-positive domain so i64 MIN never overflows a negate\n")
    p.push("    var x = v\n")
    p.push("    if x > 0 \{ x = 0 - x \}\n")
    p.push("    var digits = 0\n")
    p.push("    var t = x\n")
    p.push("    while t < 0 \{\n")
    p.push("        digits += 1\n")
    p.push("        t = t / 10\n")
    p.push("    \}\n")
    p.push("    var total = digits\n")
    p.push("    if neg \{ total += 1 \}\n")
    p.push("    let p = rx_sb_p()\n")
    p.push("    rx_sb_ensure(p, total)\n")
    p.push("    let buf = load64(p)\n")
    p.push("    let cur = load64(p + 8)\n")
    p.push("    var pos = cur + total - 1\n")
    p.push("    while x < 0 \{\n")
    p.push("        store8(buf + pos, 48 - x % 10)      // x%10 is <= 0, so -(x%10) is the digit\n")
    p.push("        pos -= 1\n")
    p.push("        x = x / 10\n")
    p.push("    \}\n")
    p.push("    if neg \{ store8(buf + cur, 45) \}\n")
    p.push("    store64(p + 8, cur + total)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// td kinds: 0 int, 1 float, 2 bool, 3 str, 4 list, 5 struct\n")
    p.push("fn rx_fmt_val(v: int, td: int, repr: int) \{\n")
    p.push("    let kind = load64(td)\n")
    p.push("    if kind == 0 \{\n")
    p.push("        rx_sb_int(v)\n")
    p.push("    \} else if kind == 2 \{\n")
    p.push("        if v != 0 \{ rx_sb_bytes(addr(\"true\") + 8, 4) \}\n")
    p.push("        else \{ rx_sb_bytes(addr(\"false\") + 8, 5) \}\n")
    p.push("    \} else if kind == 3 \{\n")
    p.push("        if repr != 0 \{ rx_sb_byte(34) \}\n")
    p.push("        let n = load64(v)\n")
    p.push("        var i = 0\n")
    p.push("        while i < n \{\n")
    p.push("            let c = load8(v + 8 + i)\n")
    p.push("            if repr != 0 and (c == 34 or c == 92) \{\n")
    p.push("                rx_sb_byte(92)\n")
    p.push("                rx_sb_byte(c)\n")
    p.push("            \} else if repr != 0 and c == 10 \{\n")
    p.push("                rx_sb_byte(92)\n")
    p.push("                rx_sb_byte(110)\n")
    p.push("            \} else \{\n")
    p.push("                rx_sb_byte(c)\n")
    p.push("            \}\n")
    p.push("            i += 1\n")
    p.push("        \}\n")
    p.push("        if repr != 0 \{ rx_sb_byte(34) \}\n")
    p.push("    \} else if kind == 4 \{\n")
    p.push("        let eltd = load64(td + 8)\n")
    p.push("        let n = load64(v)\n")
    p.push("        let data = load64(v + 16)\n")
    p.push("        rx_sb_byte(91)\n")
    p.push("        var i = 0\n")
    p.push("        while i < n \{\n")
    p.push("            if i > 0 \{\n")
    p.push("                rx_sb_byte(44)\n")
    p.push("                rx_sb_byte(32)\n")
    p.push("            \}\n")
    p.push("            rx_fmt_val(load64(data + i * 8), eltd, 1)\n")
    p.push("            i += 1\n")
    p.push("        \}\n")
    p.push("        rx_sb_byte(93)\n")
    p.push("    \} else if kind == 5 \{\n")
    p.push("        let name = load64(td + 8)\n")
    p.push("        let nf = load64(td + 16)\n")
    p.push("        rx_sb_bytes(name, rx_cstrlen(name))\n")
    p.push("        rx_sb_byte(123)\n")
    p.push("        var f = 0\n")
    p.push("        while f < nf \{\n")
    p.push("            if f > 0 \{\n")
    p.push("                rx_sb_byte(44)\n")
    p.push("                rx_sb_byte(32)\n")
    p.push("            \}\n")
    p.push("            let fname = load64(td + 24 + f * 16)\n")
    p.push("            let ftd = load64(td + 32 + f * 16)\n")
    p.push("            rx_sb_bytes(fname, rx_cstrlen(fname))\n")
    p.push("            rx_sb_byte(58)\n")
    p.push("            rx_sb_byte(32)\n")
    p.push("            rx_fmt_val(load64(v + f * 8), ftd, 1)\n")
    p.push("            f += 1\n")
    p.push("        \}\n")
    p.push("        rx_sb_byte(125)\n")
    p.push("    \} else if kind == 8 \{                 // optional: none, or the wrapped value\n")
    p.push("        if v == 0 \{\n")
    p.push("            rx_sb_bytes(addr(\"none\") + 8, 4)\n")
    p.push("        \} else \{\n")
    p.push("            rx_fmt_val(load64(v), load64(td + 8), repr)\n")
    p.push("        \}\n")
    p.push("    \} else if kind == 7 \{                 // map: \{k: v, ...\}\n")
    p.push("        let ktd = load64(td + 8)\n")
    p.push("        let vtd = load64(td + 16)\n")
    p.push("        let cap = load64(v + 8)\n")
    p.push("        let keys = load64(v + 16)\n")
    p.push("        let vals = load64(v + 24)\n")
    p.push("        let state = load64(v + 32)\n")
    p.push("        rx_sb_byte(123)\n")
    p.push("        var shown = 0\n")
    p.push("        var i = 0\n")
    p.push("        while i < cap \{\n")
    p.push("            if load8(state + i) == 1 \{\n")
    p.push("                if shown > 0 \{\n")
    p.push("                    rx_sb_byte(44)\n")
    p.push("                    rx_sb_byte(32)\n")
    p.push("                \}\n")
    p.push("                rx_fmt_val(load64(keys + i * 8), ktd, 1)\n")
    p.push("                rx_sb_byte(58)\n")
    p.push("                rx_sb_byte(32)\n")
    p.push("                rx_fmt_val(load64(vals + i * 8), vtd, 1)\n")
    p.push("                shown += 1\n")
    p.push("            \}\n")
    p.push("            i += 1\n")
    p.push("        \}\n")
    p.push("        rx_sb_byte(125)\n")
    p.push("    \} else if kind == 6 \{                 // enum: print the member name\n")
    p.push("        let nm = load64(td + 8)\n")
    p.push("        if v < 0 or v >= nm \{\n")
    p.push("            rx_sb_int(v)\n")
    p.push("        \} else \{\n")
    p.push("            let nameptr = load64(td + 16 + v * 8)\n")
    p.push("            rx_sb_bytes(nameptr, rx_cstrlen(nameptr))\n")
    p.push("        \}\n")
    p.push("    \} else \{\n")
    p.push("        rx_sb_float(v)\n")
    p.push("    \}\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn rx_pow10(k: int) -> int \{\n")
    p.push("    var r = 1\n")
    p.push("    var i = 0\n")
    p.push("    while i < k \{\n")
    p.push("        r = r * 10\n")
    p.push("        i += 1\n")
    p.push("    \}\n")
    p.push("    return r\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// Format a double (given as its bit pattern) with up to 16 significant\n")
    p.push("// fractional digits, rounded, with trailing zeros trimmed (like %g). Handles\n")
    p.push("// magnitudes below 2^63; NaN and infinity are named.\n")
    p.push("// A double of magnitude >= 2^63 has no fractional bits, but its integer value\n")
    p.push("// does not fit in an i64 -- `y as int` saturates and the digit loop then\n")
    p.push("// generated negative digits (1e20 printed as \"0.-).0-*(+,))+(0(\"). Peel powers\n")
    p.push("// of two off until the mantissa fits, then double the decimal digits back k\n")
    p.push("// times. Exact for every finite double, including 1e300.\n")
    p.push("fn rx_sb_bigint_float(yin: float) \{\n")
    p.push("    var m = yin\n")
    p.push("    var k = 0\n")
    p.push("    while m >= 9223372036854775808.0 \{\n")
    p.push("        m = m / 2.0                       // exact: halving a normal double\n")
    p.push("        k += 1\n")
    p.push("    \}\n")
    p.push("    var dg: [int] = []\n")
    p.push("    var t = m as int\n")
    p.push("    while t > 0 \{\n")
    p.push("        dg.push(t % 10)\n")
    p.push("        t = t / 10\n")
    p.push("    \}\n")
    p.push("    if dg.len() == 0 \{ dg.push(0) \}\n")
    p.push("    var i = 0\n")
    p.push("    while i < k \{\n")
    p.push("        var carry = 0\n")
    p.push("        var j = 0\n")
    p.push("        while j < dg.len() \{\n")
    p.push("            let v = dg[j] * 2 + carry\n")
    p.push("            dg[j] = v % 10\n")
    p.push("            carry = v / 10\n")
    p.push("            j += 1\n")
    p.push("        \}\n")
    p.push("        while carry > 0 \{\n")
    p.push("            dg.push(carry % 10)\n")
    p.push("            carry = carry / 10\n")
    p.push("        \}\n")
    p.push("        i += 1\n")
    p.push("    \}\n")
    p.push("    var p = dg.len() - 1\n")
    p.push("    while p >= 0 \{\n")
    p.push("        rx_sb_byte(48 + dg[p])\n")
    p.push("        p -= 1\n")
    p.push("    \}\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn rx_sb_float(bitpat: int) \{\n")
    p.push("    let x = frombits(bitpat)\n")
    p.push("    if x != x \{                          // NaN\n")
    p.push("        rx_sb_byte(110)\n")
    p.push("        rx_sb_byte(97)\n")
    p.push("        rx_sb_byte(110)\n")
    p.push("        return\n")
    p.push("    \}\n")
    p.push("    var y = x\n")
    p.push("    if y < 0.0 \{\n")
    p.push("        rx_sb_byte(45)                   // '-'\n")
    p.push("        y = 0.0 - y\n")
    p.push("    \}\n")
    p.push("    let INF = frombits(9218868437227405312)   // 0x7FF0000000000000\n")
    p.push("    if y == INF \{\n")
    p.push("        rx_sb_byte(105)\n")
    p.push("        rx_sb_byte(110)\n")
    p.push("        rx_sb_byte(102)\n")
    p.push("        return\n")
    p.push("    \}\n")
    p.push("    if y >= 9223372036854775808.0 \{      // integer part too large for i64\n")
    p.push("        rx_sb_bigint_float(y)\n")
    p.push("        return\n")
    p.push("    \}\n")
    p.push("    var ip = y as int\n")
    p.push("    var frac = y - (ip as float)\n")
    p.push("    var di = 0                            // integer-part digit count\n")
    p.push("    var tmp = ip\n")
    p.push("    while tmp > 0 \{\n")
    p.push("        tmp = tmp / 10\n")
    p.push("        di += 1\n")
    p.push("    \}\n")
    p.push("    var nfrac = 15 - di                   // ~15 significant figures total (like %.15g)\n")
    p.push("    if nfrac < 1 \{ nfrac = 1 \}\n")
    p.push("    if nfrac > 16 \{ nfrac = 16 \}\n")
    p.push("    var fd = 0\n")
    p.push("    var f = frac\n")
    p.push("    var i = 0\n")
    p.push("    while i < nfrac \{\n")
    p.push("        f = f * 10.0\n")
    p.push("        let d = f as int\n")
    p.push("        fd = fd * 10 + d\n")
    p.push("        f = f - (d as float)\n")
    p.push("        i += 1\n")
    p.push("    \}\n")
    p.push("    f = f * 10.0                          // round on the next digit\n")
    p.push("    if (f as int) >= 5 \{ fd = fd + 1 \}\n")
    p.push("    let cap = rx_pow10(nfrac)\n")
    p.push("    if fd >= cap \{                        // carry rounded past the fraction\n")
    p.push("        fd = fd - cap\n")
    p.push("        ip = ip + 1\n")
    p.push("    \}\n")
    p.push("    rx_sb_int(ip)\n")
    p.push("    if fd == 0 \{ return \}                 // no fractional part (matches %g)\n")
    p.push("    rx_sb_byte(46)                        // '.'\n")
    p.push("    var last = nfrac - 1\n")
    p.push("    var t = fd\n")
    p.push("    while last > 0 and t % 10 == 0 \{      // trim trailing zeros\n")
    p.push("        t = t / 10\n")
    p.push("        last -= 1\n")
    p.push("    \}\n")
    p.push("    var p = 0\n")
    p.push("    while p <= last \{                     // emit MSD-first, keeping leading zeros\n")
    p.push("        let digit = (fd / rx_pow10(nfrac - 1 - p)) % 10\n")
    p.push("        rx_sb_byte(48 + digit)\n")
    p.push("        p += 1\n")
    p.push("    \}\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn rx_cstrlen(p: int) -> int \{\n")
    p.push("    var n = 0\n")
    p.push("    while load8(p + n) != 0 \{ n += 1 \}\n")
    p.push("    return n\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// ---- runtime entry points the code generator calls ----\n")
    p.push("fn rt_to_str(v: int, td: int) -> int \{\n")
    p.push("    let p = rx_sb_p()\n")
    p.push("    let mark = load64(p + 8)\n")
    p.push("    rx_fmt_val(v, td, 0)\n")
    p.push("    let outlen = load64(p + 8) - mark\n")
    p.push("    let s = rx_str_alloc(outlen)\n")
    p.push("    rx_mcopy(s + 8, load64(p) + mark, outlen)\n")
    p.push("    store64(p + 8, mark)\n")
    p.push("    return s\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn rt_print_val(v: int, td: int) \{\n")
    p.push("    if load64(td) == 3 \{                  // plain str: straight to stdout\n")
    p.push("        rx_out_str(v)\n")
    p.push("        rx_out(rx_stdout_h(), addr(\"\\n\") + 8, 1)\n")
    p.push("        return\n")
    p.push("    \}\n")
    p.push("    let p = rx_sb_p()\n")
    p.push("    let mark = load64(p + 8)\n")
    p.push("    rx_fmt_val(v, td, 0)\n")
    p.push("    rx_out(rx_stdout_h(), load64(p) + mark, load64(p + 8) - mark)\n")
    p.push("    store64(p + 8, mark)\n")
    p.push("    rx_out(rx_stdout_h(), addr(\"\\n\") + 8, 1)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn rt_emit(s: int) \{\n")
    p.push("    rx_out_str(s)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn rt_sb_begin() -> int \{\n")
    p.push("    return load64(rx_sb_p() + 8)\n")
    p.push("\}\n")
    p.push("fn rt_sb_txt(s: int) \{\n")
    p.push("    rx_sb_bytes(s + 8, load64(s))\n")
    p.push("\}\n")
    p.push("fn rt_sb_val(v: int, td: int) \{\n")
    p.push("    rx_fmt_val(v, td, 0)\n")
    p.push("\}\n")
    p.push("fn rt_sb_end(mark: int) -> int \{\n")
    p.push("    let p = rx_sb_p()\n")
    p.push("    let outlen = load64(p + 8) - mark\n")
    p.push("    let s = rx_str_alloc(outlen)\n")
    p.push("    rx_mcopy(s + 8, load64(p) + mark, outlen)\n")
    p.push("    store64(p + 8, mark)\n")
    p.push("    return s\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// ---- command-line args ----\n")
    p.push("fn rt_args() -> int \{\n")
    p.push("    let cl = win(\"GetCommandLineA\")       // LPSTR\n")
    p.push("    let l = rt_list_new_d(0, __d_list_ref)\n")
    p.push("    var i = 0\n")
    p.push("    var going = true\n")
    p.push("    while going \{\n")
    p.push("        while load8(cl + i) == 32 or load8(cl + i) == 9 \{ i += 1 \}\n")
    p.push("        if load8(cl + i) == 0 \{\n")
    p.push("            going = false\n")
    p.push("        \} else \{\n")
    p.push("            let start = i\n")
    p.push("            var quoted = false\n")
    p.push("            let buf = rt_alloc(2048)\n")
    p.push("            var bl = 0\n")
    p.push("            var scanning = true\n")
    p.push("            while scanning \{\n")
    p.push("                let c = load8(cl + i)\n")
    p.push("                if c == 0 \{ scanning = false \}\n")
    p.push("                else if c == 34 \{\n")
    p.push("                    if quoted \{ quoted = false \} else \{ quoted = true \}\n")
    p.push("                    i += 1\n")
    p.push("                \} else if (c == 32 or c == 9) and not quoted \{\n")
    p.push("                    scanning = false\n")
    p.push("                \} else \{\n")
    p.push("                    store8(buf + bl, c)\n")
    p.push("                    bl += 1\n")
    p.push("                    i += 1\n")
    p.push("                \}\n")
    p.push("            \}\n")
    p.push("            let s = rx_str_alloc(bl)\n")
    p.push("            rx_mcopy(s + 8, buf, bl)\n")
    p.push("            rt_list_push(l, s)\n")
    p.push("        \}\n")
    p.push("    \}\n")
    p.push("    return l\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// null-terminated copy of a str's bytes into fresh memory, for the Win32 *A apis\n")
    p.push("fn rx_cstr(s: int) -> int \{\n")
    p.push("    let n = load64(s)\n")
    p.push("    let p = rt_alloc(n + 1)\n")
    p.push("    rx_mcopy(p, s + 8, n)\n")
    p.push("    store8(p + n, 0)\n")
    p.push("    return p\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// rt_read_file(path) -> str with the whole file\n")
    p.push("fn rt_read_file(path: int) -> int \{\n")
    p.push("    let cp = rx_cstr(path)\n")
    p.push("    // CreateFileA(name, GENERIC_READ, FILE_SHARE_READ, 0, OPEN_EXISTING, 0, 0)\n")
    p.push("    let h = win(\"CreateFileA\", cp, 2147483648, 1, 0, 3, 0, 0)\n")
    p.push("    if h == 0 - 1 \{ rt_die(\"cannot read file\") \}\n")
    p.push("    let size = win(\"GetFileSize\", h, 0)\n")
    p.push("    let s = rx_str_alloc(size)\n")
    p.push("    if __scratch == 0 \{ __scratch = rt_alloc(16) \}\n")
    p.push("    var got = 0\n")
    p.push("    while got < size \{\n")
    p.push("        let r = win(\"ReadFile\", h, s + 8 + got, size - got, __scratch, 0)\n")
    p.push("        let n = load64(__scratch) & 4294967295\n")
    p.push("        if r == 0 or n == 0 \{ got = size \}\n")
    p.push("        else \{ got += n \}\n")
    p.push("    \}\n")
    p.push("    let c = win(\"CloseHandle\", h)\n")
    p.push("    return s\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn rt_write_file(path: int, data: int) \{\n")
    p.push("    let cp = rx_cstr(path)\n")
    p.push("    // CreateFileA(name, GENERIC_WRITE, 0, 0, CREATE_ALWAYS, 0, 0)\n")
    p.push("    let h = win(\"CreateFileA\", cp, 1073741824, 0, 0, 2, 0, 0)\n")
    p.push("    if h == 0 - 1 \{ rt_die(\"cannot write file\") \}\n")
    p.push("    rx_out(h, data + 8, load64(data))\n")
    p.push("    let c = win(\"CloseHandle\", h)\n")
    p.push("\}\n")
    p.push("\n")
    return p.join()
