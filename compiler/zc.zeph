    p.push("let TWO_PI_LO = 0.0000000002430840202602477\n")
    p.push("\n")
    p.push("// sin via range reduction to [-pi,pi] then Taylor. 13 terms reaches double\n")
    p.push("// precision at +-pi; the old 9 stopped at ~5e-10, which capped every\n")
    p.push("// reciprocal and inverse built on it (tan, csc, cot, gd_inv, digamma).\n")
