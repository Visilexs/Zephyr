    p.push("fn runtimeMapValues(mapAddress: int) -> int \{\n")
    p.push("    let capacity = load64(mapAddress + 8)\n")
    p.push("    let slots = load64(mapAddress + 16)\n")
    p.push("    let valueIsReference = runtimeMapValueIsReference(mapAddress)\n")
    p.push("    var listDescriptor = runtimeValueListDescriptor\n")
    p.push("    if valueIsReference == 1 \{ listDescriptor = runtimeReferenceListDescriptor \}\n")
    p.push("    let output = runtimeNewDescribedList(0, listDescriptor)\n")
    p.push("    var index = 0\n")
    p.push("    while index < capacity \{\n")
    p.push("        let slot = slots + index * 24\n")
    p.push("        if load64(slot) == 1 \{\n")
    p.push("            let value = load64(slot + 16)\n")
    p.push("            if valueIsReference == 1 \{ let retainedValue = runtimeRetainReference(value) \}\n")
    p.push("            runtimeListPush(output, value)\n")
