ty_sd.push(0)
ty_kind.push(K_BOOL)
ty_el.push(0)
ty_sd.push(0)
ty_kind.push(K_STR)
ty_el.push(0)
ty_sd.push(0)
ty_kind.push(K_VOID)
ty_el.push(0)
ty_sd.push(0)
ty_kind.push(K_NONE)
ty_el.push(0)
ty_sd.push(0)
ty_kind.push(K_U8)
ty_el.push(0)
ty_sd.push(0)
ty_kind.push(K_F32)
ty_el.push(0)
ty_sd.push(0)
