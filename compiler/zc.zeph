    p.push("fn io_cstring(value: str) -> Bytes \{\n")
    p.push("    for i in 0..value.len() \{ assert(value.byte(i) != 0, \"io: embedded NUL\") \}\n")
    p.push("    return cbytes(value)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// Reads one byte at a time so successive calls never consume the next line.\n")
    p.push("fn read_line() -> str? \{\n")
    p.push("    let inputHandle = win(\"GetStdHandle\", -10)\n")
    p.push("    let buffer = Bytes.new(8)\n")
    p.push("    let countBuffer = Bytes.new(8)\n")
    p.push("    var pieces: [str] = []\n")
    p.push("    while true \{\n")
    p.push("        let success = win(\"ReadFile\", inputHandle, buffer.addr(), 1, countBuffer.addr(), 0)\n")
    p.push("        // A closed anonymous pipe reports ERROR_BROKEN_PIPE rather than success.\n")
    p.push("        if success == 0 \{\n")
    p.push("            assert(win(\"GetLastError\") == 109, \"read_line: ReadFile failed\")\n")
    p.push("            countBuffer.put32(0, 0)\n")
    p.push("        \}\n")
    p.push("        if countBuffer.get32(0) == 0 \{\n")
    p.push("            if pieces.len() == 0 \{ return none \}\n")
    p.push("            break\n")
    p.push("        \}\n")
    p.push("        let byteValue = buffer.get8(0)\n")
    p.push("        if byteValue == 10 \{ break \}\n")
    p.push("        pieces.push(chr(byteValue))\n")
    p.push("    \}\n")
    p.push("    if pieces.len() > 0 and pieces[pieces.len() - 1] == chr(13) \{ pieces.pop() \}\n")
    p.push("    return pieces.join()\n")
