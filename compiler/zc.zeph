// Directory of the running zc.exe (with trailing separator), so `runtime.zeph`
// and the `std/` library resolve next to the compiler wherever it is installed
// -- not the current directory. Computed once into cachedExecutableDirectory.
var cachedExecutableDirectory = ""
fn executableDirectory() -> str {
    let buffer = zeros(64)                         // 512-byte path buffer (a [int] keeps its data alive)
    let bufferAddress = load64(addr(buffer) + 16)
    let pathLength = win("GetModuleFileNameA", 0, bufferAddress, 512)
    var path = ""
    var index = 0
    while index < pathLength {
        path = path + chr(load8(bufferAddress + index))
        index += 1
    }
    return directoryName(path)
}
// true if the file exists (GetFileAttributesA != INVALID_FILE_ATTRIBUTES)
fn pathExists(path: str) -> bool {
    let pathLength = path.len()
    let buffer = zeros(pathLength / 8 + 2)
    let bufferAddress = load64(addr(buffer) + 16)
    var index = 0
    while index < pathLength {
        store8(bufferAddress + index, path.byte(index))
        index += 1
    }
    store8(bufferAddress + pathLength, 0)                          // NUL-terminate for the Win32 call
    let attribute = win("GetFileAttributesA", bufferAddress)
    return (attribute & 4294967295) != 4294967295
}

// Compare disk imports by absolute Windows path, regardless of spelling.
fn canonicalPathKey(path: str) -> str {
    let buffer = zeros(path.len() / 8 + 2)
    let bufferAddress = load64(addr(buffer) + 16)
    for i in 0..path.len() { store8(bufferAddress + i, path.byte(i)) }
    store8(bufferAddress + path.len(), 0)
    let output = zeros(33)                        // 264 bytes for a 260-byte path
    let outputAddress = load64(addr(output) + 16)
    let fullPathLength = win("GetFullPathNameA", bufferAddress, 260, outputAddress, 0)
    if fullPathLength == 0 or fullPathLength >= 260 { return path.lower() }   // too long: n is the size it needed
    var key = ""
    for i in 0..fullPathLength { key = key + chr(load8(outputAddress + i)) }
    return key.lower()
}

// The main file's test blocks, in order (scopeModule drops them from the program).
fn collectTests(program: Node) -> [Node] {
