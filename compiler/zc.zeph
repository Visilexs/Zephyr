    p.push("fn fsec(x: float) -> float \{ return 1.0 / fcos(x) \}\n")
    p.push("fn fcot(x: float) -> float \{ return fcos(x) / fsin(x) \}\n")
    p.push("\n")
    p.push("// The one new primitive everything below needs. Fold to [0,1] by sign and\n")
    p.push("// reciprocal, then a pi/6 shift puts |t| under tan(pi/12) = 0.268, where the\n")
    p.push("// alternating series reaches full double precision in 13 terms.\n")
    p.push("fn fatan(x0: float) -> float \{\n")
    p.push("    var x = x0\n")
    p.push("    var neg = false\n")
