fn __emb_2() -> str {
    var p: [str] = []
    p.push("// std/list.zeph — generic list algorithms, written in Zephyr.\n")
    p.push("//\n")
    p.push("// These used to be compiler builtins, because without generics there was no way\n")
    p.push("// to write \"works for any element type\" in the language itself. They are plain\n")
    p.push("// library code now. Call them directly, or as methods via UFCS:\n")
    p.push("//\n")
    p.push("//     import \"std/list.zeph\"\n")
    p.push("//     print(items.contains(3))        // == contains(items, 3)\n")
    p.push("//\n")
    p.push("// Instantiation is what type-checks each use: `contains` compiles `item == target` for\n")
    p.push("// the concrete T, so it works for int/str/enum and is rejected for element types\n")
    p.push("// that have no ==. No trait system needed — the monomorphisation is the contract.\n")
    p.push("\n")
    p.push("fn contains[T](items: [T], target: T) -> bool \{\n")
    p.push("    for item in items \{\n")
    p.push("        if item == target \{ return true \}\n")
    p.push("    \}\n")
    p.push("    return false\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn index_of[T](items: [T], target: T) -> int \{\n")
    p.push("    for i in 0..items.len() \{\n")
    p.push("        if items[i] == target \{ return i \}\n")
    p.push("    \}\n")
    p.push("    return 0 - 1\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn reverse[T](items: [T]) \{\n")
    p.push("    var i = 0\n")
    p.push("    var j = items.len() - 1\n")
    p.push("    while i < j \{\n")
    p.push("        let saved = items[i]\n")
    p.push("        items[i] = items[j]\n")
    p.push("        items[j] = saved\n")
    p.push("        i += 1\n")
    p.push("        j -= 1\n")
    p.push("    \}\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn slice[T](items: [T], low: int, high: int) -> [T] \{\n")
    p.push("    if low < 0 or high < low or high > items.len() \{ panic(\"slice out of range\") \}\n")
    p.push("    var out: [T] = []\n")
    p.push("    for i in low..high \{ out.push(items[i]) \}\n")
    p.push("    return out\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn first[T](items: [T]) -> T? \{\n")
    p.push("    if items.len() == 0 \{ return none \}\n")
    p.push("    return items[0]\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn last[T](items: [T]) -> T? \{\n")
    p.push("    if items.len() == 0 \{ return none \}\n")
    p.push("    return items[items.len() - 1]\n")
    p.push("\}\n")
    p.push("\n")
