    p.push("    store64(mapAddress, load64(mapAddress) - 1)\n")
    p.push("    store64(mapAddress + 32, load64(mapAddress + 32) + 1)\n")
    p.push("    if runtimeMapKeyIsReference(mapAddress) == 1 \{ runtimeReleaseReference(load64(slot + 8)) \}\n")
    p.push("    if runtimeMapValueIsReference(mapAddress) == 1 \{ runtimeReleaseReference(load64(slot + 16)) \}\n")
