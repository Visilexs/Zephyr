    p.push("    var runStart = 0                                      // payload of the open run, 0 if none\n")
    p.push("    var runSize = 0\n")
    p.push("    while object < runtimeHeapBumpAddress \{\n")
    p.push("        let objectHeader = load64(object - 8)\n")
    p.push("        let size = objectHeader & (0 - 8)\n")
    p.push("        let bitIndex = (object - runtimeHeapBaseAddress) >> 3\n")
    p.push("        if runtimeGetBitmapBit(runtimeObjectMarkBitmap, bitIndex) == 0 \{\n")
    p.push("            // Unreachable but not yet freed: under reference counting that is\n")
    p.push("            // either a cycle or a missed drop. Counted so it can be reported.\n")
    p.push("            if (objectHeader & runtimeHeapFlagFree) == 0 \{ runtimeUnreleasedObjectCount += 1 \}\n")
    p.push("            if runStart == 0 \{\n")
    p.push("                runStart = object\n")
    p.push("                runSize = size\n")
    p.push("            \} else \{\n")
    p.push("                runtimeClearBitmapBit(runtimeObjectStartBitmap, bitIndex)            // no longer an object start\n")
    p.push("                runSize = runSize + runtimeObjectHeaderBytes + size\n")
    p.push("            \}\n")
    p.push("        \} else \{\n")
    p.push("            if runStart != 0 \{\n")
    p.push("                store64(runStart - 8, runSize | runtimeHeapFlagFree)\n")
    p.push("                runtimePushFreeBlock(runStart, runSize)\n")
    p.push("                runStart = 0\n")
    p.push("                runSize = 0\n")
    p.push("            \}\n")
    p.push("            store64(object - 8, size)                   // clear mark/free flags\n")
    p.push("            runtimeLiveHeapBytes += size + runtimeObjectHeaderBytes\n")
    p.push("        \}\n")
    p.push("        object = object + runtimeObjectHeaderBytes + size\n")
    p.push("    \}\n")
    p.push("    if runStart != 0 \{\n")
    p.push("        store64(runStart - 8, runSize | runtimeHeapFlagFree)\n")
    p.push("        runtimePushFreeBlock(runStart, runSize)\n")
    p.push("    \}\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// ---- reference counting ----\n")
    p.push("// Every reference-typed value the compiler holds carries one count. Locals and\n")
    p.push("// stored fields own theirs; parameters borrow the caller's. runtimeRetainReference and runtimeReleaseReference\n")
    p.push("// are what the compiler emits; nothing else touches the count. Both ignore\n")
    p.push("// addresses outside the heap, because a `str` may point at a literal in the\n")
    p.push("// data section and a closure's env may be 0.\n")
    p.push("fn runtimeRetainReference(value: int) -> int \{\n")
    p.push("    if value < runtimeHeapBaseAddress or value >= runtimeHeapBumpAddress \{ return value \}\n")
    p.push("    store64(value - 24, load64(value - 24) + 1)\n")
    p.push("    return value\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// `*addr = v` for a reference slot: the old holder's count goes away with it.\n")
    p.push("// runtimeReleaseReference's body is inlined rather than called -- this runs 37M times in a\n")
    p.push("// self-build, and the old value is very often 0 (a slot's first store) or a\n")
    p.push("// string literal outside the heap, where the whole job is one compare.\n")
    p.push("fn runtimeAssignReference(address: int, value: int) \{\n")
    p.push("    let oldValue = load64(address)\n")
    p.push("    store64(address, value)\n")
    p.push("    if oldValue >= runtimeHeapBaseAddress and oldValue < runtimeHeapBumpAddress \{\n")
    p.push("        let referenceCount = load64(oldValue - 24)\n")
    p.push("        if referenceCount > 1 \{\n")
    p.push("            store64(oldValue - 24, referenceCount - 1)\n")
    p.push("        \} else \{\n")
    p.push("            if referenceCount < 1 \{ runtimeFail(\"reference count underflow\") \}\n")
    p.push("            store64(oldValue - 24, 0)\n")
    p.push("            runtimeReleaseObject(oldValue)\n")
    p.push("        \}\n")
    p.push("    \}\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// whether a container's keys / values / elements are references, per its descriptor\n")
    p.push("fn runtimeMapKeyIsReference(mapAddress: int) -> int \{\n")
    p.push("    let descriptor = load64(mapAddress - 16)\n")
    p.push("    if descriptor == 0 \{ return 0 \}\n")
    p.push("    return load64(descriptor + 8)\n")
    p.push("\}\n")
    p.push("fn runtimeMapValueIsReference(mapAddress: int) -> int \{\n")
    p.push("    let descriptor = load64(mapAddress - 16)\n")
    p.push("    if descriptor == 0 \{ return 0 \}\n")
    p.push("    return load64(descriptor + 16)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn runtimeReleaseReference(value: int) \{\n")
    p.push("    if value < runtimeHeapBaseAddress or value >= runtimeHeapBumpAddress \{ return \}\n")
    p.push("    let referenceCount = load64(value - 24)\n")
    p.push("    if referenceCount > 1 \{\n")
    p.push("        store64(value - 24, referenceCount - 1)\n")
    p.push("        return\n")
    p.push("    \}\n")
    p.push("    if referenceCount < 1 \{ runtimeFail(\"reference count underflow\") \}\n")
    p.push("    store64(value - 24, 0)\n")
    p.push("    runtimeReleaseObject(value)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// Releasing a frame's reference slots. A function with several of them used to\n")
    p.push("// pay a call per slot on every single return, which measured at 403M calls --\n")
    p.push("// 80% of all counting work -- to free something only 2.5% of the time. The\n")
    p.push("// compiler emits the slot offsets as a static table instead, so a return costs\n")
    p.push("// one call and a loop, with runtimeReleaseReference's body inlined here.\n")
    p.push("fn runtimeReleaseFrameSlots(framePointer: int, slotOffsetTable: int, slotCount: int) \{\n")
    p.push("    var index = 0\n")
    p.push("    while index < slotCount \{\n")
    p.push("        let value = load64(framePointer - load64(slotOffsetTable + index * 8))\n")
    p.push("        if value >= runtimeHeapBaseAddress and value < runtimeHeapBumpAddress \{\n")
    p.push("            let referenceCount = load64(value - 24)\n")
    p.push("            if referenceCount > 1 \{\n")
    p.push("                store64(value - 24, referenceCount - 1)\n")
    p.push("            \} else \{\n")
    p.push("                if referenceCount < 1 \{ runtimeFail(\"reference count underflow\") \}\n")
    p.push("                store64(value - 24, 0)\n")
    p.push("                runtimeReleaseObject(value)\n")
    p.push("            \}\n")
    p.push("        \}\n")
    p.push("        index += 1\n")
    p.push("    \}\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// A child reference losing its holder: decrement, and queue it for release\n")
    p.push("// when that was the last one. Queuing instead of recursing is what keeps a\n")
    p.push("// million-element linked structure from overflowing the stack.\n")
    p.push("fn runtimeReleaseChildReference(childAddress: int) \{\n")
    p.push("    if childAddress < runtimeHeapBaseAddress or childAddress >= runtimeHeapBumpAddress \{ return \}\n")
    p.push("    let referenceCount = load64(childAddress - 24)\n")
    p.push("    if referenceCount > 1 \{\n")
    p.push("        store64(childAddress - 24, referenceCount - 1)\n")
    p.push("        return\n")
    p.push("    \}\n")
    p.push("    if referenceCount < 1 \{ runtimeFail(\"reference count underflow\") \}\n")
    p.push("    store64(childAddress - 24, 0)\n")
    p.push("    runtimePushMarkWorklist(childAddress)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// Frees `v` and, transitively, everything only it kept alive. Shares the\n")
    p.push("// collector's worklist; the two never run at once because the collector is only\n")
    p.push("// ever entered from allocation, which release never performs.\n")
    p.push("fn runtimeReleaseObject(value: int) \{\n")
    p.push("    runtimeLockHeap()\n")
    p.push("    runtimePushMarkWorklist(value)\n")
    p.push("    while runtimeWorklistCount > 0 \{\n")
    p.push("        runtimeWorklistCount -= 1\n")
    p.push("        let object = load64(runtimeMarkWorklist + runtimeWorklistCount * 8)\n")
    p.push("        let descriptor = load64(object - 16)\n")
    p.push("        if descriptor != 0 \{ runtimeReleaseObjectChildren(object, descriptor) \}\n")
    p.push("        let size = load64(object - 8) & (0 - 8)\n")
    p.push("        store64(object - 8, size | runtimeHeapFlagFree)\n")
    p.push("        runtimePushFreeBlock(object, size)\n")
    p.push("    \}\n")
    p.push("    runtimeUnlockHeap()\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// Shape descriptors. The compiler emits one per type into the data section; the\n")
    p.push("// runtime keeps a few of its own (runtimeInitializeShapeDescriptors) for the objects it builds itself.\n")
    p.push("//   [0] kind   1 = fixed slots: [8] slot count, [16..] bitmask, bit i = slot i is a reference\n")
    p.push("//              2 = list cell \{len, cap, data\}: [8] 1 if the elements are references\n")
    p.push("//              3 = map: [8] 1 if keys are references, [16] 1 if values are\n")
    p.push("fn runtimeReleaseObjectChildren(object: int, descriptor: int) \{\n")
    p.push("    let kind = load64(descriptor)\n")
    p.push("    if kind == 1 \{\n")
    p.push("        let count = load64(descriptor + 8)\n")
    p.push("        var index = 0\n")
    p.push("        while index < count \{\n")
    p.push("            if (load64(descriptor + 16 + (index >> 6) * 8) >> (index & 63)) & 1 == 1 \{\n")
    p.push("                runtimeReleaseChildReference(load64(object + index * 8))\n")
    p.push("            \}\n")
    p.push("            index += 1\n")
    p.push("        \}\n")
    p.push("    \} else if kind == 2 \{\n")
    p.push("        let data = load64(object + 16)\n")
    p.push("        if load64(descriptor + 8) == 1 \{\n")
    p.push("            let count = load64(object)\n")
    p.push("            var index = 0\n")
    p.push("            while index < count \{\n")
    p.push("                runtimeReleaseChildReference(load64(data + index * 8))\n")
    p.push("                index += 1\n")
    p.push("            \}\n")
    p.push("        \}\n")
    p.push("        runtimeReleaseChildReference(data)\n")
    p.push("    \} else if kind == 3 \{\n")
    p.push("        let capacity = load64(object + 8)\n")
    p.push("        let slots = load64(object + 16)\n")
    p.push("        let mapKeyIsReference = load64(descriptor + 8)\n")
    p.push("        let mapValueIsReference = load64(descriptor + 16)\n")
    p.push("        var index = 0\n")
    p.push("        while index < capacity \{\n")
    p.push("            let slot = slots + index * 24\n")
    p.push("            if load64(slot) == 1 \{\n")
    p.push("                if mapKeyIsReference == 1 \{ runtimeReleaseChildReference(load64(slot + 8)) \}\n")
    p.push("                if mapValueIsReference == 1 \{ runtimeReleaseChildReference(load64(slot + 16)) \}\n")
    p.push("            \}\n")
    p.push("            index += 1\n")
    p.push("        \}\n")
    p.push("        runtimeReleaseChildReference(slots)\n")
    p.push("    \}\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// The runtime's own descriptors, on one off-heap page.\n")
    p.push("var runtimeValueListDescriptor = 0\n")
    p.push("var runtimeReferenceListDescriptor = 0\n")
    p.push("var runtimeValueBoxDescriptor = 0\n")
    p.push("var runtimeReferenceBoxDescriptor = 0\n")
    p.push("var runtimeValueMapDescriptor = 0\n")
    p.push("fn runtimeInitializeShapeDescriptors() \{\n")
    p.push("    let page = win(\"VirtualAlloc\", 0, 4096, 12288, 4)\n")
    p.push("    if page == 0 \{ runtimeFail(\"out of memory\") \}\n")
    p.push("    runtimeValueMapDescriptor = page + 128         // kind 3, plain keys and values\n")
    p.push("    store64(page + 128, 3)\n")
    p.push("    runtimeValueListDescriptor = page              // kind 2, elements are values\n")
    p.push("    store64(page, 2)\n")
    p.push("    runtimeReferenceListDescriptor = page + 32         // kind 2, elements are references\n")
    p.push("    store64(page + 32, 2)\n")
    p.push("    store64(page + 40, 1)\n")
    p.push("    runtimeValueBoxDescriptor = page + 64          // kind 1, one slot, not a reference\n")
    p.push("    store64(page + 64, 1)\n")
    p.push("    store64(page + 72, 1)\n")
    p.push("    runtimeReferenceBoxDescriptor = page + 96          // kind 1, one slot, a reference\n")
    p.push("    store64(page + 96, 1)\n")
    p.push("    store64(page + 104, 1)\n")
    p.push("    store64(page + 112, 1)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// a small scratch page for out-params (never freed, not on the GC heap)\n")
    p.push("var runtimeScratchPageAddress = 0\n")
    p.push("fn runtimeGetScratchPage() -> int \{\n")
    p.push("    if runtimeScratchPageAddress == 0 \{\n")
    p.push("        runtimeScratchPageAddress = win(\"VirtualAlloc\", 0, 4096, 12288, 4)\n")
    p.push("        if runtimeScratchPageAddress == 0 \{ runtimeFail(\"out of memory\") \}\n")
    p.push("    \}\n")
    p.push("    return runtimeScratchPageAddress\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// Take a block off the free lists, or 0 if none fits. Small sizes come off\n")
    p.push("// their exact-size class in O(1); large ones use first fit with splitting.\n")
    p.push("fn runtimeTakeFreeBlock(need: int) -> int \{\n")
    p.push("    let sizeClass = need >> 3\n")
    p.push("    if sizeClass <= runtimeSmallAllocationClassCount \{\n")
    p.push("        let head = load64(runtimeFreeListHeads + sizeClass * 8)\n")
    p.push("        if head == 0 \{ return 0 \}\n")
    p.push("        store64(runtimeFreeListHeads + sizeClass * 8, load64(head))        // pop\n")
    p.push("        store64(head - 8, need)                      // live again, flags cleared\n")
    p.push("        runtimeZeroMemory(head, need)\n")
    p.push("        return head\n")
    p.push("    \}\n")
    p.push("    var previous = 0\n")
    p.push("    var current = runtimeLargeFreeBlocks\n")
    p.push("    while current != 0 \{\n")
    p.push("        let size = load64(current - 8) & (0 - 8)\n")
    p.push("        let nextBlock = load64(current)\n")
    p.push("        if size >= need \{\n")
    p.push("            if previous == 0 \{ runtimeLargeFreeBlocks = nextBlock \} else \{ store64(previous, nextBlock) \}\n")
    p.push("            if size >= need + runtimeObjectHeaderBytes + 8 \{                // split off the tail\n")
    p.push("                let remainderSize = size - need - runtimeObjectHeaderBytes\n")
    p.push("                store64(current - 8, need)\n")
    p.push("                let remainderAddress = current + need + runtimeObjectHeaderBytes            // payload of the remainder\n")
    p.push("                store64(remainderAddress - 8, remainderSize | runtimeHeapFlagFree)\n")
    p.push("                runtimeSetBitmapBit(runtimeObjectStartBitmap, (remainderAddress - runtimeHeapBaseAddress) >> 3)\n")
    p.push("                runtimePushFreeBlock(remainderAddress, remainderSize)\n")
    p.push("            \} else \{\n")
    p.push("                store64(current - 8, size)\n")
    p.push("            \}\n")
    p.push("            runtimeZeroMemory(current, load64(current - 8) & (0 - 8))\n")
    p.push("            return current\n")
    p.push("        \}\n")
    p.push("        previous = current\n")
    p.push("        current = nextBlock\n")
    p.push("    \}\n")
    p.push("    return 0\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// An object with no children (a string, a list's data buffer). The compiler\n")
    p.push("// still calls this by name, so the signature must not change.\n")
    p.push("fn runtimeAllocateObject(size: int) -> int \{\n")
    p.push("    return runtimeAllocateDescribedObject(size, 0)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// An object whose payload holds references: `desc` (see runtimeReleaseObjectChildren) says\n")
    p.push("// which words, so dropping it can drop them. Count starts at 1 - the caller\n")
    p.push("// owns the fresh object.\n")
    p.push("fn runtimeAllocateDescribedObject(size: int, descriptor: int) -> int \{\n")
    p.push("    runtimeLockHeap()\n")
    p.push("    let result = runtimeAllocateObjectPayload(size)\n")
    p.push("    store64(result - 24, 1)\n")
    p.push("    store64(result - 16, descriptor)\n")
    p.push("    runtimeUnlockHeap()\n")
    p.push("    return result\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn runtimeAllocateObjectPayload(size: int) -> int \{\n")
    p.push("    if runtimeHeapInitialized == 0 \{ runtimeInitializeHeap() \}\n")
    p.push("    var need = (size + 7) & (0 - 8)\n")
    p.push("    if need == 0 \{ need = 8 \}\n")
    p.push("    let freeBlock = runtimeTakeFreeBlock(need)\n")
    p.push("    if freeBlock != 0 \{ return freeBlock \}\n")
    p.push("    // free list exhausted and the heap has doubled: collect, then retry.\n")
    p.push("    // ponytail: first-fit over one free list; size-segregated lists would let\n")
    p.push("    // us collect more often without the O(n) search, but this is correct and\n")
    p.push("    // halves peak memory as is.\n")
    p.push("    if runtimeHeapBumpAddress >= runtimeNextCollectionAddress \{\n")
    p.push("        runtimeCollectGarbage()\n")
    p.push("        // Proportional trigger (Go-style): allow the bump pointer to advance by\n")
    p.push("        // another `live` bytes before the next collection, so the heap peaks at\n")
    p.push("        // ~2x the live set. The target is measured from the CURRENT bump, i.e.\n")
    p.push("        // from growth-since-this-collection -- NOT from runtimeHeapBaseAddress, which is the\n")
    p.push("        // all-time high-water extent and never shrinks. Keying on the extent\n")
    p.push("        // meant that once it passed 2x live, every free-list miss collected\n")
    p.push("        // (a full mark that reclaimed nothing new), which is O(live) per\n")
    p.push("        // allocation whenever the live set pins its size class's free list empty.\n")
    p.push("        // The 256 KiB floor only bites when the live set is tiny (a churn loop\n")
    p.push("        // whose garbage dies immediately): it collects a little more often to\n")
    p.push("        // keep the peak low, and each such collection is cheap precisely because\n")
    p.push("        // little is live. A larger floor traded ~8 MiB of extra peak for no time.\n")
    p.push("        //\n")
    p.push("        // Under reference counting most collections find nothing: counting has\n")
    p.push("        // already freed the acyclic garbage. A zc self-compile ran six, each\n")
    p.push("        // leaving 88-95% of the heap live, and they cost 14% of the run (the\n")
    p.push("        // last, over 191 MB live, took 80 ms). So a collection that leaves\n")
    p.push("        // under a quarter of the heap free doubles the growth allowed before\n")
    p.push("        // the next one, up to 4x live. One that frees more -- cyclic garbage,\n")
    p.push("        // or a fragmented heap worth coalescing -- resets it to 1x.\n")
    p.push("        let extent = runtimeHeapBumpAddress - runtimeHeapBaseAddress\n")
    p.push("        if (extent - runtimeLiveHeapBytes) * 4 < extent \{\n")
    p.push("            if runtimeCollectionGrowthFactor < 4 \{ runtimeCollectionGrowthFactor = runtimeCollectionGrowthFactor * 2 \}\n")
    p.push("        \} else \{\n")
    p.push("            runtimeCollectionGrowthFactor = 1\n")
    p.push("        \}\n")
    p.push("        var headroom = runtimeLiveHeapBytes * runtimeCollectionGrowthFactor\n")
    p.push("        if headroom < 262144 \{ headroom = 262144 \}\n")
    p.push("        runtimeNextCollectionAddress = runtimeHeapBumpAddress + headroom\n")
    p.push("        let reclaimedBlock = runtimeTakeFreeBlock(need)\n")
    p.push("        if reclaimedBlock != 0 \{ return reclaimedBlock \}\n")
    p.push("    \}\n")
    p.push("    // bump\n")
    p.push("    runtimeGrowHeap(runtimeHeapBumpAddress + runtimeObjectHeaderBytes + need)\n")
    p.push("    let object = runtimeHeapBumpAddress + runtimeObjectHeaderBytes\n")
    p.push("    store64(object - 8, need)\n")
    p.push("    runtimeHeapBumpAddress = object + need\n")
    p.push("    runtimeSetBitmapBit(runtimeObjectStartBitmap, (object - runtimeHeapBaseAddress) >> 3)\n")
    p.push("    return object                                       // committed pages start zeroed\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn runtimeZeroMemory(address: int, byteCount: int) \{\n")
    p.push("    var index = 0\n")
    p.push("    while index < byteCount \{\n")
    p.push("        store64(address + index, 0)\n")
    p.push("        index += 8\n")
    p.push("    \}\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// records the globals array so the collector can scan it as a root set\n")
    p.push("fn runtimeSetGlobalRoots(rootsAddress: int, rootCount: int) \{\n")
    p.push("    runtimeGlobalRootsAddress = rootsAddress\n")
    p.push("    runtimeGlobalRootCount = rootCount\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// ---- raw byte copy ----\n")
    p.push("fn runtimeCopyMemory(destination: int, source: int, byteCount: int) \{\n")
    p.push("    var index = 0\n")
    p.push("    while index + 8 <= byteCount \{\n")
    p.push("        store64(destination + index, load64(source + index))\n")
    p.push("        index += 8\n")
    p.push("    \}\n")
    p.push("    while index < byteCount \{\n")
    p.push("        store8(destination + index, load8(source + index))\n")
    p.push("        index += 1\n")
    p.push("    \}\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// ---- strings ----  (a str value is a pointer to \{i64 len; bytes\})\n")
    p.push("fn runtimeAllocateString(stringLength: int) -> int \{\n")
    p.push("    let stringAddress = runtimeAllocateObject(8 + stringLength)\n")
    p.push("    store64(stringAddress, stringLength)\n")
    p.push("    return stringAddress\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn runtimeConcatenateStrings(leftStringAddress: int, rightStringAddress: int) -> int \{\n")
    p.push("    let leftLength = load64(leftStringAddress)\n")
    p.push("    let rightLength = load64(rightStringAddress)\n")
    p.push("    let text = runtimeAllocateString(leftLength + rightLength)\n")
    p.push("    runtimeCopyMemory(text + 8, leftStringAddress + 8, leftLength)\n")
    p.push("    runtimeCopyMemory(text + 8 + leftLength, rightStringAddress + 8, rightLength)\n")
    p.push("    return text\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn runtimeStringsEqual(leftStringAddress: int, rightStringAddress: int) -> int \{\n")
    p.push("    let leftLength = load64(leftStringAddress)\n")
    p.push("    if leftLength != load64(rightStringAddress) \{ return 0 \}\n")
    p.push("    var index = 0\n")
    p.push("    while index < leftLength \{\n")
    p.push("        if load8(leftStringAddress + 8 + index) != load8(rightStringAddress + 8 + index) \{ return 0 \}\n")
    p.push("        index += 1\n")
    p.push("    \}\n")
    p.push("    return 1\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn runtimeCompareStrings(leftStringAddress: int, rightStringAddress: int) -> int \{\n")
    p.push("    let leftLength = load64(leftStringAddress)\n")
    p.push("    let rightLength = load64(rightStringAddress)\n")
    p.push("    var sharedLength = leftLength\n")
    p.push("    if rightLength < sharedLength \{ sharedLength = rightLength \}\n")
    p.push("    var index = 0\n")
    p.push("    while index < sharedLength \{\n")
    p.push("        let leftByte = load8(leftStringAddress + 8 + index)\n")
    p.push("        let rightByte = load8(rightStringAddress + 8 + index)\n")
    p.push("        if leftByte < rightByte \{ return 0 - 1 \}\n")
    p.push("        if leftByte > rightByte \{ return 1 \}\n")
    p.push("        index += 1\n")
    p.push("    \}\n")
    p.push("    if leftLength < rightLength \{ return 0 - 1 \}\n")
    p.push("    if leftLength > rightLength \{ return 1 \}\n")
    p.push("    return 0\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn runtimeSubstringValue(stringAddress: int, lowerBound: int, upperBound: int) -> int \{\n")
    p.push("    let stringLength = load64(stringAddress)\n")
