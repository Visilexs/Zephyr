    p.push("        let capacity = load64(leftValue + 8)\n")
    p.push("        let slots = load64(leftValue + 16)\n")
    p.push("        var index = 0\n")
    p.push("        while index < capacity \{\n")
    p.push("            let slot = slots + index * 24\n")
    p.push("            if load64(slot) == 1 \{\n")
    p.push("                let foundIndex = runtimeFindMapEntry(rightValue, load64(slot + 8))\n")
    p.push("                if foundIndex < 0 \{ return 0 \}\n")
    p.push("                if runtimeValueEquals(load64(slot + 16), load64(load64(rightValue + 16) + foundIndex * 24 + 16), valueTypeDescriptor) == 0 \{ return 0 \}\n")
    p.push("            \}\n")
    p.push("            index += 1\n")
    p.push("        \}\n")
    p.push("        return 1\n")
    p.push("    \}\n")
    p.push("    if leftValue == rightValue \{ return 1 \}\n")
    p.push("    return 0\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn runtimeHashMix(hash: int, value: int) -> int \{\n")
    p.push("    var mixed = (hash * 1000003) ^ (value * -7046029254386353131)\n")
    p.push("    mixed = mixed ^ (mixed >> 29)\n")
    p.push("    return mixed & 9223372036854775807\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// A hash consistent with runtimeValueEquals, for list/struct/optional map keys\n")
    p.push("// (float and map keys are rejected by the compiler).\n")
    p.push("fn runtimeHashTypedValue(value: int, typeDescriptor: int) -> int \{\n")
    p.push("    let kind = load64(typeDescriptor)\n")
    p.push("    if kind == 3 \{ return runtimeHashString(value) \}\n")
    p.push("    if kind == 4 \{\n")
    p.push("        let count = load64(value)\n")
    p.push("        let elementTypeDescriptor = load64(typeDescriptor + 8)\n")
    p.push("        let data = load64(value + 16)\n")
    p.push("        var hash = count\n")
    p.push("        var index = 0\n")
    p.push("        while index < count \{\n")
    p.push("            hash = runtimeHashMix(hash, runtimeHashTypedValue(load64(data + index * 8), elementTypeDescriptor))\n")
    p.push("            index += 1\n")
    p.push("        \}\n")
    p.push("        return hash\n")
    p.push("    \}\n")
    p.push("    if kind == 5 \{\n")
    p.push("        let fieldCount = load64(typeDescriptor + 16)\n")
    p.push("        var hash = fieldCount\n")
    p.push("        var index = 0\n")
    p.push("        while index < fieldCount \{\n")
    p.push("            hash = runtimeHashMix(hash, runtimeHashTypedValue(load64(value + index * 8), load64(typeDescriptor + 32 + index * 16)))\n")
    p.push("            index += 1\n")
    p.push("        \}\n")
    p.push("        return hash\n")
    p.push("    \}\n")
    p.push("    if kind == 8 \{\n")
    p.push("        if value == 0 \{ return 0 \}\n")
    p.push("        return runtimeHashMix(1, runtimeHashTypedValue(load64(value), load64(typeDescriptor + 8)))\n")
    p.push("    \}\n")
    p.push("    if kind == 9 \{ return runtimeHashTypedValue(value, load64(typeDescriptor + 16 + load64(value) * 8)) \}\n")
    p.push("    if kind == 10 \{                       // [u8]; [f32] cannot be a key\n")
    p.push("        let count = load64(value)\n")
    p.push("        var hash = count\n")
    p.push("        var index = 0\n")
    p.push("        while index < count \{\n")
    p.push("            hash = runtimeHashMix(hash, runtimePackedLoad(value, index, 1))\n")
    p.push("            index += 1\n")
    p.push("        \}\n")
    p.push("        return hash\n")
    p.push("    \}\n")
    p.push("    return runtimeHashMix(0, value)\n")
    p.push("\}\n")
    p.push("// slot holding k, or -1\n")
    p.push("fn runtimeFindGenericMapEntry(mapAddress: int, key: int) -> int \{\n")
    p.push("    let capacity = load64(mapAddress + 8)\n")
    p.push("    let slots = load64(mapAddress + 16)\n")
    p.push("    var index = runtimeMapHash(mapAddress, key) & (capacity - 1)\n")
    p.push("    while true \{\n")
    p.push("        let slot = slots + index * 24\n")
    p.push("        let slotState = load64(slot)\n")
    p.push("        if slotState == 0 \{ return 0 - 1 \}\n")
    p.push("        if slotState == 1 and runtimeKeyEquals(mapAddress, load64(slot + 8), key) == 1 \{ return index \}\n")
    p.push("        index = (index + 1) & (capacity - 1)\n")
    p.push("    \}\n")
    p.push("    return 0 - 1\n")
    p.push("\}\n")
    p.push("fn runtimeInsertGenericMapEntry(mapAddress: int, key: int, value: int) \{\n")
    p.push("    let capacity = load64(mapAddress + 8)\n")
    p.push("    let slots = load64(mapAddress + 16)\n")
    p.push("    var index = runtimeMapHash(mapAddress, key) & (capacity - 1)\n")
    p.push("    var tombstoneIndex = 0 - 1\n")
    p.push("    while true \{\n")
    p.push("        let slot = slots + index * 24\n")
    p.push("        let slotState = load64(slot)\n")
    p.push("        if slotState == 1 and runtimeKeyEquals(mapAddress, load64(slot + 8), key) == 1 \{\n")
    p.push("            if runtimeMapValueIsReference(mapAddress) == 1 \{ runtimeAssignReference(slot + 16, value) \}   // update in place\n")
    p.push("            else \{ store64(slot + 16, value) \}\n")
    p.push("            if runtimeMapKeyIsReference(mapAddress) == 1 \{ runtimeReleaseReference(key) \}                    // the old key stays\n")
    p.push("            return\n")
    p.push("        \}\n")
    p.push("        if slotState == 2 and tombstoneIndex < 0 \{ tombstoneIndex = index \}\n")
    p.push("        if slotState == 0 \{\n")
    p.push("            var destination = slot\n")
    p.push("            if tombstoneIndex >= 0 \{\n")
    p.push("                destination = slots + tombstoneIndex * 24\n")
    p.push("                store64(mapAddress + 32, load64(mapAddress + 32) - 1)\n")
    p.push("            \}\n")
    p.push("            store64(destination + 8, key)\n")
    p.push("            store64(destination + 16, value)\n")
    p.push("            store64(destination, 1)\n")
    p.push("            store64(mapAddress, load64(mapAddress) + 1)\n")
    p.push("            return\n")
    p.push("        \}\n")
    p.push("        index = (index + 1) & (capacity - 1)\n")
    p.push("    \}\n")
    p.push("\}\n")
    p.push("// Move every live entry into a fresh buffer, dropping tombstones, not references.\n")
    p.push("fn runtimeMapRehash(mapAddress: int, newCapacity: int) \{\n")
    p.push("    let oldCapacity = load64(mapAddress + 8)\n")
    p.push("    let oldSlots = load64(mapAddress + 16)\n")
    p.push("    // Allocate before changing the header; the collector still sees the old buffer.\n")
    p.push("    let newSlots = runtimeAllocateObject(newCapacity * 24)\n")
    p.push("    store64(mapAddress + 8, newCapacity)\n")
    p.push("    store64(mapAddress + 16, newSlots)              // zeroed = all empty\n")
    p.push("    store64(mapAddress, 0)\n")
    p.push("    store64(mapAddress + 32, 0)\n")
    p.push("    var shift = 64\n")
    p.push("    var shiftedCapacity = newCapacity\n")
    p.push("    while shiftedCapacity > 1 \{\n")
    p.push("        shift -= 1\n")
    p.push("        shiftedCapacity = shiftedCapacity >> 1\n")
    p.push("    \}\n")
    p.push("    store64(mapAddress + 40, shift)\n")
    p.push("    let isInteger = load64(mapAddress + 24) == 0\n")
    p.push("    var index = 0\n")
    p.push("    while index < oldCapacity \{\n")
    p.push("        let slot = oldSlots + index * 24\n")
    p.push("        if load64(slot) == 1 \{\n")
    p.push("            if isInteger \{ runtimeIntegerMapInsert(mapAddress, load64(slot + 8), load64(slot + 16)) \}\n")
    p.push("            else \{ runtimeInsertGenericMapEntry(mapAddress, load64(slot + 8), load64(slot + 16)) \}\n")
    p.push("        \}\n")
    p.push("        index += 1\n")
    p.push("    \}\n")
    p.push("    runtimeReleaseReference(oldSlots)\n")
    p.push("\}\n")
    p.push("// ---- int-key fast paths: hash and == inlined, no call per probe ----\n")
    p.push("fn runtimeIntegerMapLookup(mapAddress: int, key: int) -> int \{\n")
    p.push("    let capacity = load64(mapAddress + 8)\n")
    p.push("    let slots = load64(mapAddress + 16)\n")
    p.push("    var index = ((key * -7046029254386353131) >> load64(mapAddress + 40)) & (capacity - 1)\n")
    p.push("    while true \{\n")
    p.push("        let slot = slots + index * 24\n")
