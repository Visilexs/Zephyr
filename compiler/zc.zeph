    p.push("            var quoted = false\n")
    p.push("            let buf = rt_alloc(2048)\n")
    p.push("            var bl = 0\n")
    p.push("            var scanning = true\n")
    p.push("            while scanning \{\n")
    p.push("                let c = load8(cl + i)\n")
    p.push("                if c == 0 \{ scanning = false \}\n")
    p.push("                else if c == 34 \{\n")
    p.push("                    if quoted \{ quoted = false \} else \{ quoted = true \}\n")
    p.push("                    i += 1\n")
    p.push("                \} else if (c == 32 or c == 9) and not quoted \{\n")
    p.push("                    scanning = false\n")
    p.push("                \} else \{\n")
    p.push("                    store8(buf + bl, c)\n")
    p.push("                    bl += 1\n")
    p.push("                    i += 1\n")
    p.push("                \}\n")
    p.push("            \}\n")
    p.push("            let s = rx_str_alloc(bl)\n")
    p.push("            rx_mcopy(s + 8, buf, bl)\n")
    p.push("            rt_list_push(l, s)\n")
    p.push("        \}\n")
    p.push("    \}\n")
    p.push("    return l\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// null-terminated copy of a str's bytes into fresh memory, for the Win32 *A apis\n")
    p.push("fn rx_cstr(s: int) -> int \{\n")
    p.push("    let n = load64(s)\n")
    p.push("    let p = rt_alloc(n + 1)\n")
    p.push("    rx_mcopy(p, s + 8, n)\n")
    p.push("    store8(p + n, 0)\n")
    p.push("    return p\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// rt_read_file(path) -> str with the whole file\n")
    p.push("fn rt_read_file(path: int) -> int \{\n")
    p.push("    let cp = rx_cstr(path)\n")
    p.push("    // CreateFileA(name, GENERIC_READ, FILE_SHARE_READ, 0, OPEN_EXISTING, 0, 0)\n")
    p.push("    let h = win(\"CreateFileA\", cp, 2147483648, 1, 0, 3, 0, 0)\n")
    p.push("    if h == 0 - 1 \{ rt_die(\"cannot read file\") \}\n")
    p.push("    let size = win(\"GetFileSize\", h, 0)\n")
    p.push("    let s = rx_str_alloc(size)\n")
    p.push("    if __scratch == 0 \{ __scratch = rt_alloc(16) \}\n")
    p.push("    var got = 0\n")
    p.push("    while got < size \{\n")
    p.push("        let r = win(\"ReadFile\", h, s + 8 + got, size - got, __scratch, 0)\n")
    p.push("        let n = load64(__scratch) & 4294967295\n")
    p.push("        if r == 0 or n == 0 \{ got = size \}\n")
    p.push("        else \{ got += n \}\n")
    p.push("    \}\n")
    p.push("    let c = win(\"CloseHandle\", h)\n")
    p.push("    return s\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn rt_write_file(path: int, data: int) \{\n")
    p.push("    let cp = rx_cstr(path)\n")
    p.push("    // CreateFileA(name, GENERIC_WRITE, 0, 0, CREATE_ALWAYS, 0, 0)\n")
    p.push("    let h = win(\"CreateFileA\", cp, 1073741824, 0, 0, 2, 0, 0)\n")
    p.push("    if h == 0 - 1 \{ rt_die(\"cannot write file\") \}\n")
    p.push("    rx_out(h, data + 8, load64(data))\n")
    p.push("    let c = win(\"CloseHandle\", h)\n")
    p.push("\}\n")
    p.push("\n")
    return p.join()
