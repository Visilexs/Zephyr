    p.push("    let attributes = win(\"GetFileAttributesA\", filename.addr())\n")
    p.push("    return (attributes & 4294967295) != 4294967295\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn delete_file(path: str) -> bool \{\n")
    p.push("    let filename = io_cstring(path)\n")
    p.push("    return win(\"DeleteFileA\", filename.addr()) != 0\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// Enumerates immediate entry names in OS order, excluding dot entries.\n")
    p.push("fn list_dir(path: str) -> [str] \{\n")
    p.push("    let directory = io_cstring(path)\n")
    p.push("    let attributes = win(\"GetFileAttributesA\", directory.addr()) & 4294967295\n")
    p.push("    assert(attributes != 4294967295 and (attributes & 16) != 0, \"list_dir: not a directory\")\n")
    p.push("    let pattern = io_cstring(path + \"/*\")\n")
    p.push("    let entry = Bytes.new(320)\n")
    p.push("    var names: [str] = []\n")
    p.push("    let handle = win(\"FindFirstFileA\", pattern.addr(), entry.addr())\n")
    p.push("    if handle == -1 \{\n")
    p.push("        assert(win(\"GetLastError\") == 18 or win(\"GetLastError\") == 2, \"list_dir: enumeration failed\")\n")
    p.push("        return names\n")
    p.push("    \}\n")
    p.push("    var more = true\n")
    p.push("    while more \{\n")
    p.push("        var length = 0\n")
    p.push("        while length < 260 and entry.get8(44 + length) != 0 \{ length += 1 \}\n")
    p.push("        let name = entry.get_str(44, length)\n")
    p.push("        if name != \".\" and name != \"..\" \{ names.push(name) \}\n")
    p.push("        more = win(\"FindNextFileA\", handle, entry.addr()) != 0\n")
    p.push("    \}\n")
    p.push("    let lastError = win(\"GetLastError\")\n")
    p.push("    let closed = win(\"FindClose\", handle)\n")
    p.push("    assert(lastError == 18 and closed != 0, \"list_dir: enumeration failed\")\n")
    p.push("    return names\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// Preserve the distinction between an absent variable and a present empty value.\n")
    p.push("fn env(name: str) -> str? \{\n")
    p.push("    let variable = io_cstring(name)\n")
    p.push("    var capacity = 256\n")
    p.push("    while true \{\n")
    p.push("        let buffer = Bytes.new(capacity)\n")
    p.push("        let cleared = win(\"SetLastError\", 0)\n")
    p.push("        let length = win(\"GetEnvironmentVariableA\", variable.addr(), buffer.addr(), capacity)\n")
    p.push("        if length == 0 \{\n")
    p.push("            if win(\"GetLastError\") == 203 \{ return none \}\n")
    p.push("            assert(win(\"GetLastError\") == 0, \"env: lookup failed\")\n")
    p.push("            return \"\"\n")
    p.push("        \}\n")
    p.push("        if length < capacity \{ return buffer.get_str(0, length) \}\n")
    p.push("        capacity = length\n")
    p.push("    \}\n")
    p.push("    return none\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn now_ms() -> int \{ return win(\"GetTickCount64\") \}\n")
    p.push("\n")
    p.push("// Divide first, retaining the fractional tick count without overflowing ticks*1e9.\n")
    p.push("fn now_ns() -> int \{\n")
    p.push("    let counter = Bytes.new(8)\n")
    p.push("    let frequency = Bytes.new(8)\n")
    p.push("    assert(win(\"QueryPerformanceFrequency\", frequency.addr()) != 0, \"now_ns: no performance frequency\")\n")
    p.push("    assert(win(\"QueryPerformanceCounter\", counter.addr()) != 0, \"now_ns: no performance counter\")\n")
    p.push("    let ticks = counter.get64(0)\n")
    p.push("    let ticksPerSecond = frequency.get64(0)\n")
    p.push("    assert(ticksPerSecond > 0, \"now_ns: invalid frequency\")\n")
    p.push("    let remainder = ticks % ticksPerSecond\n")
    p.push("    var fraction = 0\n")
    p.push("    if ticksPerSecond <= 9223372036 \{ fraction = remainder * 1000000000 / ticksPerSecond \}\n")
    p.push("    else \{ fraction = ((remainder as float) * 1000000000.0 / (ticksPerSecond as float)) as int \}\n")
    p.push("    return (ticks / ticksPerSecond) * 1000000000 + fraction\n")
    p.push("\}\n")
    p.push("\n")
    p.push("fn sleep_ms(milliseconds: int) \{\n")
    p.push("    assert(milliseconds >= 0 and milliseconds < 4294967295, \"sleep_ms: duration out of range\")\n")
    p.push("    let ignored = win(\"Sleep\", milliseconds)\n")
    p.push("\}\n")
    p.push("\n")
    p.push("// Windows command line, no implicit shell; pass cmd.exe /c for shell commands.\n")
    p.push("fn run(command: str) -> int \{\n")
    p.push("    let commandBuffer = io_cstring(command)\n")
    p.push("    let startup = Bytes.new(104)\n")
    p.push("    startup.put32(0, 104)\n")
    p.push("    let process = Bytes.new(24)\n")
    p.push("    let created = win(\"CreateProcessA\", 0, commandBuffer.addr(), 0, 0, 0, 0, 0, 0, startup.addr(), process.addr())\n")
    p.push("    assert(created != 0, \"run: CreateProcess failed\")\n")
    p.push("    let threadClosed = win(\"CloseHandle\", process.get64(8))\n")
    p.push("    let waitResult = win(\"WaitForSingleObject\", process.get64(0), 4294967295)\n")
    p.push("    let result = Bytes.new(8)\n")
    p.push("    let success = win(\"GetExitCodeProcess\", process.get64(0), result.addr())\n")
    p.push("    let processClosed = win(\"CloseHandle\", process.get64(0))\n")
    p.push("    assert(threadClosed != 0 and waitResult == 0 and success != 0 and processClosed != 0, \"run: wait failed\")\n")
    p.push("    return result.get32(0)\n")
    p.push("\}\n")
    p.push("\n")
