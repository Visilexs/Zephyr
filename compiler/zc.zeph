    p.push("        if slotState == 1 and load64(slot + 8) == key \{\n")
    p.push("            if runtimeMapValueIsReference(mapAddress) == 1 \{ runtimeAssignReference(slot + 16, value) \}\n")
    p.push("            else \{ store64(slot + 16, value) \}\n")
    p.push("            return\n")
    p.push("        \}\n")
    p.push("        if slotState == 2 and tombstoneIndex < 0 \{ tombstoneIndex = index \}\n")
    p.push("        if slotState == 0 \{\n")
    p.push("            var destination = slot\n")
    p.push("            if tombstoneIndex >= 0 \{\n")
    p.push("                destination = slots + tombstoneIndex * 24\n")
    p.push("                store64(mapAddress + 32, load64(mapAddress + 32) - 1)\n")
    p.push("            \}\n")
    p.push("            store64(destination + 8, key)\n")
    p.push("            store64(destination + 16, value)\n")
    p.push("            store64(destination, 1)\n")
    p.push("            store64(mapAddress, load64(mapAddress) + 1)\n")
    p.push("            return\n")
    p.push("        \}\n")
    p.push("        index = (index + 1) & (capacity - 1)\n")
    p.push("    \}\n")
    p.push("\}\n")
    p.push("fn runtimeMapSet(mapAddress: int, key: int, value: int) \{\n")
    p.push("    // Rehash at 50% of slots in use, tombstones included. Double when the live\n")
    p.push("    // entries alone would fill over 25%; otherwise it is mostly tombstones, and\n")
    p.push("    // rebuilding at the same size clears them.\n")
    p.push("    let capacity = load64(mapAddress + 8)\n")
    p.push("    if (load64(mapAddress) + load64(mapAddress + 32) + 1) * 2 >= capacity \{\n")
    p.push("        if (load64(mapAddress) + 1) * 4 >= capacity \{ runtimeMapRehash(mapAddress, capacity * 2) \}\n")
    p.push("        else \{ runtimeMapRehash(mapAddress, capacity) \}\n")
