    if i == 2 { return "std/list.zeph" }
    if i == 3 { return "std/math.zeph" }
    if i == 4 { return "std/math_core.zeph" }
    if i == 5 { return "std/random.zeph" }
    if i == 6 { return "std/result.zeph" }
    if i == 7 { return "std/set.zeph" }
    if i == 8 { return "std/string.zeph" }
    if i == 9 { return "std/sync.zeph" }
    if i == 10 { return "std/thread.zeph" }
    return ""
}
fn embedded_src(i: int) -> str {
    if i == 0 { return __emb_0() }
    if i == 1 { return __emb_1() }
    if i == 2 { return __emb_2() }
    if i == 3 { return __emb_3() }
    if i == 4 { return __emb_4() }
    if i == 5 { return __emb_5() }
    if i == 6 { return __emb_6() }
    if i == 7 { return __emb_7() }
    if i == 8 { return __emb_8() }
    if i == 9 { return __emb_9() }
    if i == 10 { return __emb_10() }
    return ""
}
// <<<EMBED

// Directory of the running zc.exe (with trailing separator), so `runtime.zeph`
// and the `std/` library resolve next to the compiler wherever it is installed
// -- not the current directory. Computed once into g_exedir.
var g_exedir = ""
fn exe_dir() -> str {
    let buf = zeros(64)                         // 512-byte path buffer (a [int] keeps its data alive)
    let data = load64(addr(buf) + 16)
    let n = win("GetModuleFileNameA", 0, data, 512)
    var s = ""
    var i = 0
    while i < n {
        s = s + chr(load8(data + i))
        i += 1
    }
    return dirname(s)
}
// true if the file exists (GetFileAttributesA != INVALID_FILE_ATTRIBUTES)
fn path_exists(path: str) -> bool {
    let n = path.len()
    let buf = zeros(n / 8 + 2)
    let data = load64(addr(buf) + 16)
    var i = 0
    while i < n {
        store8(data + i, path.byte(i))
        i += 1
    }
    store8(data + n, 0)                          // NUL-terminate for the Win32 call
    let attr = win("GetFileAttributesA", data)
    return (attr & 4294967295) != 4294967295
}

// Compare disk imports by absolute Windows path, regardless of spelling.
fn canon_key(path: str) -> str {
    let buf = zeros(path.len() / 8 + 2)
    let data = load64(addr(buf) + 16)
    for i in 0..path.len() { store8(data + i, path.byte(i)) }
    store8(data + path.len(), 0)
    let out = zeros(33)                        // 264 bytes for a 260-byte path
    let dest = load64(addr(out) + 16)
    let n = win("GetFullPathNameA", data, 260, dest, 0)
    if n == 0 or n >= 260 { return path.lower() }   // too long: n is the size it needed
    var key = ""
    for i in 0..n { key = key + chr(load8(dest + i)) }
    return key.lower()
}

// The main file's test blocks, in order (scope_module drops them from the program).
fn collect_tests(prog: Node) -> [Node] {
    var tests: [Node] = []
    for n in prog.kids {
        if n.k == N_TEST { tests.push(n) }
    }
    return tests
}

// A main file that declares fn main() and never calls it at the top level
// gets the call appended, after every other top-level statement.
fn call_main(prog: Node) {
    var mainNode = nnode(N_NONE, 0)
    for n in prog.kids {
        if n.k == N_FN and n.name == "main" { mainNode = n }
        if n.k == N_EXPRST and n.kids[0].k == N_CALL and n.kids[0].kids[0].k == N_ID and n.kids[0].kids[0].name == "main" { return }
    }
    if mainNode.k == N_NONE { return }
    if mainNode.kids[0].kids.len() > 0 { die(mainNode.line, "main takes no parameters (read them with args())") }
    if mainNode.kids[3].kids.len() > 0 { die(mainNode.line, "main cannot be generic") }
    prog.kids.push(call_statement("main", mainNode.line))
}

fn call_statement(name: str, line: int) -> Node {
    var call = nnode(N_CALL, line)
    call.kids.push(name_node(name, line))
    var statement = nnode(N_EXPRST, line)
    statement.kids.push(call)
    return statement
}

// emit(text) or print(text) as a statement
fn text_statement(builtin: str, text: str, line: int) -> Node {
    var part = nnode(N_STRTXT, line)
    part.name = text
    var literal = nnode(N_STRLIT, line)
    literal.kids.push(part)
    var call = nnode(N_CALL, line)
    call.kids.push(name_node(builtin, line))
    call.kids.push(literal)
    var statement = nnode(N_EXPRST, line)
    statement.kids.push(call)
    return statement
}

// zc --test: each test block becomes a function, run in order after the
// top-level statements (main() is not called). A failing test panics, which
// ends the run at that test.
// ponytail: no isolation; the first failure stops the run. A process per test
// would let the rest run.
fn add_test_runner(prog: Node, tests: [Node]) {
    for i in 0..tests.len() {
        let test = tests[i]
        var body = nnode(N_FN, test.line)
        body.name = "__test{i}"
        body.kids.push(nnode(N_PROG, test.line))     // no parameters
        body.kids.push(nnode(N_NONE, test.line))     // returns nothing
        body.kids.push(test.kids[0])
        body.kids.push(nnode(N_PROG, test.line))     // not generic
        prog.kids.push(body)
    }
    for i in 0..tests.len() {
        prog.kids.push(text_statement("emit", "test {tests[i].name} ... ", tests[i].line))
        prog.kids.push(call_statement("__test{i}", tests[i].line))
        prog.kids.push(text_statement("print", "ok", tests[i].line))
    }
    var plural = "s"
    if tests.len() == 1 { plural = "" }
    prog.kids.push(text_statement("print", "{tests.len()} test{plural} passed", 0))
}

// splice each `import "path"` in place with that file's declarations.
// Each path is included once, so diamonds and cycles terminate.
fn expand_imports(prog: Node, basedir: str) -> Node {
    var out: [Node] = []
    for n in prog.kids {
        if n.k == N_IMPORT {
            var path = n.name
            var display = basename(n.name)
            if not is_abs_path(path) {
                display = dirname(n.file) + n.name
                path = basedir + n.name
                // Fall back to the compiler's own directory, then to lib/
                // beneath it, so `import "std/list.zeph"` or `import
                // "vk/gfx.zeph"` finds the shipped library from anywhere.
                if not path_exists(path) and g_exedir != "" {
                    if path_exists(g_exedir + n.name) {
                        path = g_exedir + n.name
                        display = n.name
                    } else if path_exists(g_exedir + "lib/" + n.name) {
                        path = g_exedir + "lib/" + n.name
                        display = "lib/" + n.name
                    }
                }
            }
            // not on disk anywhere: use the copy baked into the compiler
            var ei = 0 - 1
            if not path_exists(path) {
                ei = embed_match(n.name)
                if ei >= 0 {
                    path = "embed:" + embedded_name(ei)
                    display = "lib/" + embedded_name(ei)
                }
            }
            var key = path
            if ei < 0 { key = canon_key(path) }
            var seen = false
            for i in 0..g_imported.len() {
                if g_imported[i] == key { seen = true }
            }
            var prefix = ""
            if n.kids.len() > 0 { prefix = n.kids[0].name + "." }
            if seen {
                let earlier = g_import_prefix.get(key).or("")
                if prefix == "" and earlier != "" {
                    die(n.line, "'{n.name}' is imported with 'as' elsewhere, so its names are qualified; import it with 'as' here too")
                }
                prefix = earlier
            } else {
                g_import_prefix[key] = prefix
            }
            if n.kids.len() > 0 {
                let alias = n.kids[0].name
                if g_namespace_prefix.has(alias) and (g_namespace_prefix[alias] != prefix or not seen) {
                    die(n.line, "'{alias}' already names another import")
                }
                g_namespace_prefix[alias] = prefix
            }
            if not seen {
                g_imported.push(key)
                let prev = g_file
                if ei >= 0 {
                    g_file = display
                    let inner = parse(lex_src(embedded_src(ei), 1))
                    scope_module(inner, display, prefix)
                    let expanded = expand_imports(inner, "")
                    g_file = prev
                    for i in 0..expanded.kids.len() { out.push(expanded.kids[i]) }
                } else {
                    g_file = display
                    let inner = parse(lex_src(read_file(path), 1))
                    scope_module(inner, display, prefix)
                    let expanded = expand_imports(inner, dirname(path))
                    g_file = prev
                    for i in 0..expanded.kids.len() { out.push(expanded.kids[i]) }
                }
            }
        } else {
            out.push(n)
        }
    }
    prog.kids = out
    return prog
}

let IMAGE_BASE = 5368709120  // 0x140000000

fn write_pe(path: str) {
    let rt_mode = sym_is_local("rt_alloc")   // Zephyr runtime linked: kernel32-only
    let entry_off = t_len
    a_sect = SEC_TEXT
    if rt_mode {
        tb(72)                               // sub rsp, 40
        tb(131)
        tb(236)
        tb(40)
        tb(232)                              // call zephyr_main
        add_fix(FX_REL32, sym_intern("zephyr_main"), 0)
        tb32(0)
        tb(49)                               // xor ecx, ecx
        tb(201)
        tb(255)                              // call [rip+ExitProcess]
        tb(21)
        add_fix(FX_IAT32, import_intern2("ExitProcess", 1), 0)
        tb32(0)
        tb(204)
    } else {
        tb(72)                               // lea rcx, [rip+zephyr_main]
        tb(141)
        tb(13)
        add_fix(FX_REL32, sym_intern("zephyr_main"), 0)
        tb32(0)
        tb(72)                               // sub rsp, 40
        tb(131)
        tb(236)
        tb(40)
        tb(255)                              // call [rip+rt_start]
        tb(21)
        add_fix(FX_IAT32, import_intern("rt_start"), 0)
        tb32(0)
        tb(204)
    }

    // import layout, grouped by DLL; only DLLs with imports get a descriptor
    let nimp = a_imports.len()
    let DLLNAMES = ["zephyr_rt.dll", "kernel32.dll", "user32.dll", "gdi32.dll", "opengl32.dll"]
    var used: [bool] = [false, false, false, false, false]
    for i in 0..nimp { used[a_import_dll[i]] = true }
    var dmap: [int] = []
    for d in 0..DLLNAMES.len() {
        if used[d] { dmap.push(d) }
    }
    let ndll = dmap.len()
    var slot: [int] = []
    for i in 0..nimp { slot.push(0) }
    var grp_start: [int] = []
    var nentries = 0
    for gi in 0..ndll {
        grp_start.push(nentries)
        for i in 0..nimp {
            if a_import_dll[i] == dmap[gi] {
                slot[i] = nentries
                nentries += 1
            }
        }
        nentries += 1                        // per-DLL null terminator
    }
    let idt_sz = (ndll + 1) * 20
    let ilt_off = idt_sz
    let iat_off = ilt_off + 8 * nentries
    let names_off = iat_off + 8 * nentries
    var name_offs: [int] = []
    var no = names_off
    for i in 0..nimp {
        name_offs.push(no)
        no += 2 + a_imports[i].len() + 1
        if no % 2 == 1 { no += 1 }
    }
    var dll_off: [int] = []
    for gi in 0..ndll {
        dll_off.push(no)
        no += DLLNAMES[dmap[gi]].len() + 1
    }
    let idata_size = pe_align(no, 16)

    let text_rva = 4096
    let text_size = t_len
    let rdata_rva = pe_align(text_rva + text_size, 4096)
    let data_off = idata_size
    let rdata_size = idata_size + r_len
    let bss_rva = pe_align(rdata_rva + rdata_size, 4096)
    var image_size = pe_align(bss_rva, 4096)
    if a_bss > 0 { image_size = pe_align(bss_rva + a_bss, 4096) }
    let iat_rva = rdata_rva + iat_off

    // resolve fixups
    for i in 0..a_fixes.len() {
        let fx = a_fixes[i]
        var target = 0
        if fx.kind == FX_IAT32 {
            target = iat_rva + 8 * slot[fx.sym]
        } else {
            let s = a_syms[fx.sym]
            if not s.defined { asm_fail("undefined symbol {s.name}") }
            if s.sect == SEC_TEXT { target = text_rva + s.off }
            else if s.sect == SEC_RDATA { target = rdata_rva + data_off + s.off }
            else { target = bss_rva + s.off }
        }
        if fx.kind == FX_ABS64 {
            patch8(r_bytes, fx.off, IMAGE_BASE + target)
        } else {
            patch4(t_bytes, fx.off, target + fx.addend - (text_rva + fx.off + 4))
        }
    }

    var nsect = 2
    if a_bss > 0 { nsect = 3 }
    let hdrs_size = 1024
    let text_raw = hdrs_size
    let rdata_raw = text_raw + pe_align(text_size, 512)
    let file_size = rdata_raw + pe_align(rdata_size, 512)
    pe_out = chr(0).repeat(file_size)

    // DOS header
    pw(77)
    pw(90) // "MZ"
    pw_pad(60)
    pw4(64)
    // PE signature + COFF
    pw(80)
    pw(69)
    pw(0)
    pw(0)
    pw2(34404)                       // 0x8664
    pw2(nsect)
    pw4(0)
    pw4(0)
    pw4(0)
    pw2(240)
    pw2(34) // opt size, EXE | large-address-aware
    // optional header
    pw2(523)                         // 0x20B
    pw2(256)
    pw4(pe_align(text_size, 512))
    pw4(pe_align(rdata_size, 512))
    pw4(0)
    pw4(text_rva + entry_off)
    pw4(text_rva)
    pw8(IMAGE_BASE)
    pw4(4096)
    pw4(512)
    pw2(6)
    pw2(0)
    pw2(0)
    pw2(0)
    pw2(6)
    pw2(0)
    pw4(0)
    pw4(image_size)
    pw4(hdrs_size)
    pw4(0)
    pw2(3)                           // console
    pw2(33024)                       // 0x8100: NX + TS aware, no ASLR
    pw8(8388608)
    pw8(65536) // stack
    pw8(1048576)
    pw8(4096) // heap
    pw4(0)
    pw4(16)
    for i in 0..16 {
        if i == 1 {
            pw4(rdata_rva)
            pw4(idt_sz)
        } else if i == 12 {
            pw4(iat_rva)
            pw4(8 * nentries)
        } else {
            pw4(0)
            pw4(0)
        }
    }
    // section headers: name(8) vsz rva rsz raw 0 0 0 chr
    let SNAMES = [".text", ".rdata", ".bss"]
    var svsz: [int] = []
    var srva: [int] = []
    var srsz: [int] = []
    var sraw: [int] = []
    var schr: [int] = []
    svsz.push(text_size)
    srva.push(text_rva)
    srsz.push(pe_align(text_size, 512))
    sraw.push(text_raw)
    schr.push(1610612768)
    svsz.push(rdata_size)
    srva.push(rdata_rva)
    srsz.push(pe_align(rdata_size, 512))
    sraw.push(rdata_raw)
    schr.push(1073741888)
    svsz.push(a_bss)
    srva.push(bss_rva)
    srsz.push(0)
    sraw.push(0)
    schr.push(3221225600)
    for i in 0..nsect {
        let nm = SNAMES[i]
        for j in 0..8 {
            if j < nm.len() { pw(nm.byte(j)) } else { pw(0) }
        }
        pw4(svsz[i])
        pw4(srva[i])
        pw4(srsz[i])
        pw4(sraw[i])
        pw4(0)
        pw4(0)
        pw4(0)
        pw4(schr[i])
    }
    pw_pad(text_raw)
    pw_bytes(t_bytes, t_len)
    pw_pad(rdata_raw)
    // import descriptor table: one entry per used DLL, then a null entry
    for gi in 0..ndll {
        pw4(rdata_rva + ilt_off + 8 * grp_start[gi])   // OriginalFirstThunk
        pw4(0)
        pw4(0)
        pw4(rdata_rva + dll_off[gi])                   // Name
        pw4(rdata_rva + iat_off + 8 * grp_start[gi])   // FirstThunk
    }
    pw4(0)
    pw4(0)
    pw4(0)
    pw4(0)
    pw4(0)
    // ILT then IAT (identical on disk), grouped by DLL with null terminators
    for pass in 0..2 {
        for gi in 0..ndll {
            for i in 0..nimp {
                if a_import_dll[i] == dmap[gi] { pw8(rdata_rva + name_offs[i]) }
            }
            pw8(0)
        }
    }
    for i in 0..nimp {
        pw(0)
        pw(0)
        let nm = a_imports[i]
        for j in 0..nm.len() { pw(nm.byte(j)) }
        pw(0)
        if (pe_len - rdata_raw) % 2 == 1 { pw(0) }
    }
    for gi in 0..ndll {
        let dn = DLLNAMES[dmap[gi]]
        for j in 0..dn.len() { pw(dn.byte(j)) }
        pw(0)
    }
    pw_pad(rdata_raw + idata_size)
    pw_bytes(r_bytes, r_len)
    pw_pad(file_size)

    write_file(path, pe_out)
}

// ---------------- ELF writer (--linux) ----------------
//
// A static ET_EXEC with two PT_LOAD segments and nothing else: no interpreter,
// no dynamic section, no relocations, no section headers. Everything the
// program needs from the kernel it asks for with `syscall`, so there is no
// import table to build -- this is a good deal shorter than write_pe.
let ELF_BASE = 4194304   // 0x400000

fn ew8(v: int) {
    var x = v
    for i in 0..8 {
        pw(x % 256)
        x = x / 256
    }
}

fn write_elf(path: str) {
    let entry_off = t_len
    a_sect = SEC_TEXT
    tb(232)                              // call zephyr_main
    add_fix(FX_REL32, sym_intern("zephyr_main"), 0)
    tb32(0)
    tb(184)                              // mov eax, 231 (exit_group)
    tb32(231)
    tb(49)                               // xor edi, edi
    tb(255)
    tb(15)                               // syscall
    tb(5)

    let text_rva = 4096
    let text_size = t_len
    let rdata_rva = pe_align(text_rva + text_size, 4096)
    let rdata_size = r_len
    let bss_rva = pe_align(rdata_rva + rdata_size, 4096)
    pe_out = chr(0).repeat(rdata_rva + rdata_size)

    for i in 0..a_fixes.len() {
        let fx = a_fixes[i]
        if fx.kind == FX_IAT32 { asm_fail("DLL imports are not available on --linux") }
        let s = a_syms[fx.sym]
        if not s.defined { asm_fail("undefined symbol {s.name}") }
        var target = 0
        if s.sect == SEC_TEXT { target = text_rva + s.off }
        else if s.sect == SEC_RDATA { target = rdata_rva + s.off }
        else { target = bss_rva + s.off }
        if fx.kind == FX_ABS64 {
            patch8(r_bytes, fx.off, ELF_BASE + target)
        } else {
            patch4(t_bytes, fx.off, target + fx.addend - (text_rva + fx.off + 4))
        }
    }

    // ELF header
    pw(127)
    pw(69)
    pw(76)
    pw(70)                               // \x7fELF
    pw(2)                                // 64-bit
    pw(1)                                // little-endian
    pw(1)                                // version
    pw_pad(16)
    pw2(2)                               // ET_EXEC
    pw2(62)                              // EM_X86_64
    pw4(1)
    ew8(ELF_BASE + text_rva + entry_off) // e_entry
    ew8(64)                              // e_phoff
    ew8(0)                               // e_shoff
    pw4(0)
    pw2(64)                              // e_ehsize
    pw2(56)                              // e_phentsize
    pw2(2)                               // e_phnum
    pw2(64)
    pw2(0)
    pw2(0)

    // PT_LOAD r-x: the headers and .text, mapped from file offset 0
    pw4(1)
    pw4(5)
    ew8(0)
    ew8(ELF_BASE)
    ew8(ELF_BASE)
    ew8(text_rva + text_size)
    ew8(text_rva + text_size)
    ew8(4096)
    // PT_LOAD rw-: .rdata then .bss. File and virtual offsets are kept equal so
    // the p_offset == p_vaddr (mod page) requirement holds without arithmetic.
    pw4(1)
    pw4(6)
    ew8(rdata_rva)
    ew8(ELF_BASE + rdata_rva)
    ew8(ELF_BASE + rdata_rva)
    ew8(rdata_size)
    ew8(bss_rva - rdata_rva + a_bss)
    ew8(4096)

    pw_pad(text_rva)
    pw_bytes(t_bytes, t_len)
    pw_pad(rdata_rva)
    pw_bytes(r_bytes, r_len)

    write_file(path, pe_out)
}

fn is_label_char(c: int) -> bool {
    return c == 95 or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or (c >= 48 and c <= 57)
}

// Only rt_* calls distinguish forward local definitions from DLL imports.
// Record those labels during emission instead of scanning every assembly line.
fn asm_predefine(line: str) {
    let n = line.len()
    if not starts_with(line, "rt_") or line.byte(n - 1) != 58 { return }
    for i in 3..n - 1 {
        if not is_label_char(line.byte(i)) { return }
    }
    a_syms[sym_intern(line.sub(0, n - 1))].predef = true
}

// ---- .zdbg sidecar (little-endian) ----
fn z_u16(z: [int], v: int) {
    z.push(v % 256)
    z.push((v / 256) % 256)
}
fn z_u32(z: [int], v: int) {
    var x = v
    for i in 0..4 {
        z.push(x % 256)
        x = x / 256
    }
}
fn z_u64(z: [int], v: int) {
    var x = v
    for i in 0..8 {
        z.push(x % 256)
        x = x / 256
    }
}
fn z_bytes(z: [int], s: str) {
    for i in 0..s.len() { z.push(s.byte(i)) }
}

// Format: "ZDBG" | u16 version | u64 imagebase | u32 text_rva
//         | strtab: u32 nfiles, each (u16 len, bytes)
//         | lines:  u32 n, each (u32 rva, u32 fileIdx, u32 line)   sorted by rva
//         | funcs:  u32 n (0 for now)
// ponytail: text_rva mirrors write_pe's `let text_rva = 4096`; single main file only.
fn write_zdbg(path: str) {
    var z: [int] = []
    z_bytes(z, "ZDBG")
    z_u16(z, 1)
    z_u64(z, 5368709120)         // IMAGE_BASE (0x140000000)
    z_u32(z, 4096)               // text_rva
    z_u32(z, 1)                  // one source file
    z_u16(z, g_main_file.len())
    z_bytes(z, g_main_file)
    z_u32(z, dbg_off.len())
    for i in 0..dbg_off.len() {
        z_u32(z, 4096 + dbg_off[i])  // rva
        z_u32(z, 0)                  // fileIdx
        z_u32(z, dbg_line[i])        // line
    }
    z_u32(z, 0)                  // funcs: none yet
    var parts: [str] = []
    for i in 0..z.len() { parts.push(chr(z[i])) }
    write_file(path, parts.join())
}

// ================= WebAssembly backend (--wasm) =================
//
// The fourth binary format this compiler writes by hand, and the only target
// that is not a register machine. Two decisions shape everything below.
//
// 1. Zephyr locals live in a SHADOW STACK in linear memory, not in wasm locals.
//    Wasm locals and the operand stack are not addressable, so a conservative
//    collector cannot scan them -- and Zephyr's GC finds its roots by scanning
//    the machine stack. Putting frames in linear memory means the existing GC
//    works here completely unchanged. It costs a load per variable read; the
//    alternative is spilling pointer-typed locals at every safepoint, which is
//    a precise-rootset project in its own right.
//
// 2. Every Zephyr value is 64 bits, so every wasm value is i64. Floats are
//    already stored as bit patterns (bits/frombits), so float arithmetic just
//    reinterprets around the operation. Addresses wrap to i32 at the load/store.

var w_out: [int] = []

fn wu(b: [int], v0: int) {                   // LEB128, unsigned
    var v = v0
    var going = true
    while going {
        let lo = v & 127
        v = v >> 7
        if v != 0 { b.push(lo | 128) } else {
            b.push(lo)
            going = false
        }
    }
}

fn ws(b: [int], v0: int) {                   // LEB128, signed
    var v = v0
    var more = true
    while more {
        var lo = v & 127
        v = v >> 7
        let sign = lo & 64
        if (v == 0 and sign == 0) or (v == (0 - 1) and sign != 0) { more = false }
        else { lo = lo | 128 }
        b.push(lo)
    }
}

fn wcat(dst: [int], src: [int]) {
    for i in 0..src.len() { dst.push(src[i]) }
}

fn wsect(id: int, body: [int]) {
    if body.len() == 0 { return }
    w_out.push(id)
    wu(w_out, body.len())
    wcat(w_out, body)
}

// ---- linear memory map ----
// 0      eight reserved bytes, so address 0 can keep meaning "none"
// 8      heap base    ) three constants the OS shim loads, because only the
// 16     stack bottom ) compiler knows where the data segment ended
// 24     stack top    )
// 32     data: string literals, type descriptors, vtables, C strings
// ...    globals block (8 * g_nglobals), zero-initialised
// ...    shadow stack, W_STACK_BYTES, growing DOWN from the heap base
// ...    heap: reserved by the GC, committed through memory.grow
let W_META_HEAP = 8
let W_META_STKLO = 16
let W_META_STKTOP = 24
let W_DATA = 32
let W_STACK_BYTES = 1048576                  // 1 MiB of shadow stack

var g_wdata: [int] = []                      // the data segment, byte for byte
var g_wsaddr: [int] = []                     // address of each string literal
var g_wtaddr: [int] = []                     // address of each type descriptor
var g_wcaddr: [int] = []                     // address of each C string
var g_wpoff: [int] = []                      // deferred address slots in the data
var g_wpkind: [int] = []
var g_wpidx: [int] = []
var g_wvaddr: [int] = []                     // address of each interface vtable
var g_wpass = 1                              // pass 1 discovers literals; pass 2 emits
var g_wglobals = 0                           // address of the globals block
var g_wstklo = 0
var g_wstktop = 0
var g_wpages = 0

var wc: [int] = []                           // body being emitted
var g_wcode: [int] = []                      // all bodies, concatenated
var g_wfidx: [int] = []                      // FDef index -> wasm function index
var g_warity: [int] = []                     // wasm function index -> arity
var g_wnest = 0                              // control-structure nesting depth
var g_wbrk: [int] = []
var g_wcont: [int] = []
var g_winl: [int] = []                       // nest depth of each open inline block
var g_winlslot: [int] = []
var g_wfp = 0                                // wasm local index of the frame pointer
var g_wframe = 0
var g_wnslots = 0
var g_wnparams = 0

fn wnew() -> [int] {
    var a: [int] = []
    return a
}

// A small pool of i64 scratch locals. Needed wherever a value must outlive the
// evaluation of user code -- `.or()`'s default is lazy, so its receiver has to
// survive an arbitrary expression, and a single fixed local would collide with
// a nested `.or()`.
let W_SCRATCH = 8
var g_wsc = 0

// Temporary GC roots. A half-built list or map has to stay reachable while its
// elements are evaluated, and the wasm operand stack is NOT scanned -- so these
// live in the frame, past the locals, where the conservative scan will find
// them. This is the whole reason frames are in linear memory.
let W_ROOTS = 6
var g_wroot = 0

fn wroot_take(line: int) -> int {
    if g_wroot >= W_ROOTS { die(line, "--wasm: too many live temporaries in one expression") }
    let off = 8 * (g_wnslots + g_wnparams + g_wroot)
    g_wroot += 1
    return off
}

fn wroot_free() { g_wroot -= 1 }

fn wroot_store(off: int) {                   // value on the stack -> root slot
    let sc = wsc_take(0)
    wsc_set(sc)
    wframe_addr()
    wsc_get(sc)
    wc.push(55)                              // i64.store
    wu(wc, 3)
    wu(wc, off)
    wsc_free()
}

fn wroot_load(off: int) {
    wframe_addr()
    wc.push(41)                              // i64.load
    wu(wc, 3)
    wu(wc, off)
}

// The closure environment arrives in a global rather than as an extra parameter,
// which keeps every function's signature (i64 x arity) -> i64. The prologue
// copies it into the frame immediately, so it is a GC root and cannot be
// clobbered by a nested indirect call.
fn wenv_off() -> int { return 8 * (g_wnslots + g_wnparams + W_ROOTS) }

fn wenv_load() {
    wframe_addr()
    wc.push(41)
    wu(wc, 3)
    wu(wc, wenv_off())
}

fn wsc_take(line: int) -> int {
    if g_wsc >= W_SCRATCH { die(line, "--wasm: expression nests deeper than the scratch pool") }
    g_wsc += 1
    return g_wfp + g_wsc
}

fn wsc_free() { g_wsc -= 1 }

fn wsc_set(ix: int) {
    wc.push(33)                              // local.set
    wu(wc, ix)
}

fn wsc_get(ix: int) {
    wc.push(32)                              // local.get
    wu(wc, ix)
}

// During pass one the address tables are still empty and the code is discarded,
// so any placeholder will do.
fn wsaddr(i: int) -> int {
    if g_wpass == 1 { return 0 }
    return g_wsaddr[i]
}

fn wtaddr(i: int) -> int {
    if g_wpass == 1 { return 0 }
    return g_wtaddr[i]
}

fn wvaddr(i: int) -> int {
    if g_wpass == 1 { return 0 }
    return g_wvaddr[i]
}

fn wconst(v: int) {
    wc.push(66)                              // i64.const
    ws(wc, v)
}

fn wi32(v: int) {
    wc.push(65)                              // i32.const
    ws(wc, v)
}

fn wi32_into(b: [int], v: int) {
    b.push(65)
    ws(b, v)
}

fn wframe_addr() {
    wc.push(32)                              // local.get fp
    wu(wc, g_wfp)
}

fn wslot_off(kind: int, idx: int) -> int {
    if kind == ID_PARAM { return 8 * (g_wnslots + idx) }
    return 8 * idx
}

fn wload_slot(kind: int, idx: int) {
    if kind == ID_GLOBAL { wi32(g_wglobals + 8 * idx) } else { wframe_addr() }
    wc.push(41)                              // i64.load
    wu(wc, 3)
    wu(wc, wslot_off(kind, idx))
}

// stores are split: the address goes down first, then the value, then the op
fn wstore_addr(kind: int, idx: int) {
    if kind == ID_GLOBAL { wi32(g_wglobals + 8 * idx) } else { wframe_addr() }
}

fn wstore_fin(kind: int, idx: int) {
    wc.push(55)                              // i64.store
    wu(wc, 3)
    wu(wc, wslot_off(kind, idx))
}

fn wbr(target_nest: int) {
    wc.push(12)                              // br
    wu(wc, g_wnest - target_nest)
}

fn wsp_restore() {
    wframe_addr()
    wi32(g_wframe)
    wc.push(106)                             // i32.add
    wc.push(36)                              // global.set __sp
    wu(wc, 0)
}

// a bool-typed i64 narrowed to the i32 that if/br_if want. Safe because the
// typechecker guarantees conditions are bools, so only 0 and 1 reach here.
fn wtruth() { wc.push(167) }                 // i32.wrap_i64

// Leaves the address of list[index] on the stack as an i32, bounds-checked.
// One unsigned compare covers both ends: a negative index is a huge unsigned.
fn windex_addr(lst: Node, idx: Node, line: int) {
    let li = wsc_take(line)
    let ix = wsc_take(line)
    wexpr(lst)
    wsc_set(li)
    wexpr(idx)
    wsc_set(ix)
    wsc_get(ix)
    wsc_get(li)
    wtruth()
    wc.push(41)                              // i64.load: length
    wu(wc, 3)
    wu(wc, 0)
    wc.push(90)                              // i64.ge_u
    wc.push(4)                               // if
    wc.push(64)
    g_wnest += 1
    wsc_get(ix)
    wsc_get(li)
    wtruth()
    wc.push(41)
    wu(wc, 3)
    wu(wc, 0)
    wcall_named("rt_bounds_fail")
    wc.push(26)
    g_wnest -= 1
    wc.push(11)
    wsc_get(li)
    wtruth()
    wc.push(41)                              // i64.load: the data pointer
    wu(wc, 3)
    wu(wc, 16)
    wsc_get(ix)
    wconst(8)
    wc.push(126)                             // i64.mul
    wc.push(124)                             // i64.add
    wtruth()
    wsc_free()
    wsc_free()
}

fn wexpr(e: Node) {
    let k = e.k
    if k == N_INT or k == N_BOOL {
        wconst(e.ival)
        return
    }
    if k == N_IFEXPR {
        wexpr(e.kids[0])
        wtruth()
        wc.push(4)                           // if
        wc.push(126)                         // result i64
        g_wnest += 1
        wexpr(e.kids[1])
        wc.push(5)                           // else
        wexpr(e.kids[2])
        g_wnest -= 1
        wc.push(11)                          // end
        return
    }
    if k == N_LETEXPR {
        wstmt(e.kids[0])
        wexpr(e.kids[1])
        return
    }
    if k == N_FLOAT {
        wconst(bits(e.fval))
        return
    }
    if k == N_ID {
        if e.aux == ID_FUNC {                // plain function as a value: {code, 0}
            let r = wroot_take(e.line)
            wconst(16)
            wcall_named("rt_alloc")
            wroot_store(r)
            wroot_load(r)
            wtruth()
            wconst(g_wfidx[e.refi])          // the function-table index IS the code
            wc.push(55)
            wu(wc, 3)
            wu(wc, 0)
            wroot_load(r)
            wtruth()
            wconst(0)
            wc.push(55)
            wu(wc, 3)
            wu(wc, 8)
            wroot_load(r)
            wroot_free()
            return
        }
        if e.aux == ID_CAPTURE {             // captured by value into the env
            wenv_load()
            wtruth()
            wc.push(41)
            wu(wc, 3)
            wu(wc, 8 * e.slot)
            return
        }
        wload_slot(e.aux, e.slot)
        return
    }
    if k == N_FNLIT {                        // closure: snapshot captures, build {code, env}
        let f = g_fns[e.refi]
        let ncap = e.kids.len() - 3
        let renv = wroot_take(e.line)
        let rcell = wroot_take(e.line)
        wconst(8 * ncap)
        wcall_named("rt_alloc")
        wroot_store(renv)
        for i in 0..ncap {
            let sc = wsc_take(e.line)
            wexpr(e.kids[3 + i])
            wsc_set(sc)
            wroot_load(renv)
            wtruth()
            wsc_get(sc)
            wc.push(55)
            wu(wc, 3)
            wu(wc, 8 * i)
            wsc_free()
        }
        wconst(16)
        wcall_named("rt_alloc")
        wroot_store(rcell)
        wroot_load(rcell)
        wtruth()
        wconst(g_wfidx[e.refi])
        wc.push(55)
        wu(wc, 3)
        wu(wc, 0)
        wroot_load(rcell)
        wtruth()
        wroot_load(renv)
        wc.push(55)
        wu(wc, 3)
        wu(wc, 8)
        wroot_load(rcell)
        wroot_free()
        wroot_free()
        return
    }
    if k == N_IBOX {                         // interface value: {vtable, data} cell
        let rd = wroot_take(e.line)
        let rc = wroot_take(e.line)
        wexpr(e.kids[0])
        wroot_store(rd)
        wconst(16)
        wcall_named("rt_alloc")
        wroot_store(rc)
        wroot_load(rc)
        wtruth()
        wconst(wvaddr(e.op))
        wc.push(55)
        wu(wc, 3)
        wu(wc, 0)
        wroot_load(rc)
        wtruth()
        wroot_load(rd)
        wc.push(55)
        wu(wc, 3)
        wu(wc, 8)
        wroot_load(rc)
        wroot_free()
        wroot_free()
        return
    }
    if k == N_NEG {
        if e.ty == TI_FLOAT {
            // f64.neg flips the sign bit; 0.0 - x would turn -0.0 into +0.0
            wexpr(e.kids[0])
            wc.push(191)                     // f64.reinterpret_i64
            wc.push(154)                     // f64.neg
            wc.push(189)                     // i64.reinterpret_f64
            return
        }
        wconst(0)
        wexpr(e.kids[0])
        wc.push(125)                         // i64.sub
        return
    }
    if k == N_NOT {
        wexpr(e.kids[0])
        wc.push(80)                          // i64.eqz -> i32
        wc.push(173)                         // i64.extend_i32_u
        return
    }
    if k == N_STRLIT {
        // a lone text part is a constant: just its address in the data segment
        if e.kids.len() == 1 and e.kids[0].k == N_STRTXT {
            wconst(wsaddr(add_dstr(e.kids[0].name)))
            return
        }
        // otherwise build through the runtime's string builder and materialise
        // one string at the end -- the same shape the native backend uses
        // The mark rides the wasm operand stack across the parts: each part is
        // stack-balanced, so nested interpolation nests correctly with no
        // scratch local to collide over.
        wcall_named("rt_sb_begin")
        for i in 0..e.kids.len() {
            let p = e.kids[i]
            if p.k == N_STRTXT {
                wconst(wsaddr(add_dstr(p.name)))
                wcall_named("rt_sb_txt")
                wc.push(26)
            } else {
                wexpr(p.kids[0])
                wconst(wtaddr(p.slot))
                wcall_named("rt_sb_val")
                wc.push(26)
            }
        }
        wcall_named("rt_sb_end")
        return
    }
    if k == N_NONELIT {
        wconst(0)                            // none is the null pointer
        return
    }
    if k == N_LIST {
        let r = wroot_take(e.line)
        wconst(e.kids.len())
        wcall_named("rt_list_new")
        wroot_store(r)
        for i in 0..e.kids.len() {
            let sc = wsc_take(e.line)
            wexpr(e.kids[i])                 // may allocate; the list is rooted
            wsc_set(sc)
            wroot_load(r)
            wtruth()
            wc.push(41)                      // i64.load: the data pointer
            wu(wc, 3)
            wu(wc, 16)
            wtruth()
            wsc_get(sc)
            wc.push(55)
            wu(wc, 3)
            wu(wc, 8 * i)
            wsc_free()
        }
        wroot_load(r)
        wroot_free()
        return
    }
    if k == N_MAPLIT {
        let r = wroot_take(e.line)
        if map_keykind(e.ty) == 2 { wconst(wtaddr(td_index(ty_sd[e.ty]))) }
        else { wconst(map_keykind(e.ty)) }
        wcall_named("rt_map_new")
        wroot_store(r)
        let setfn = map_setfn(e.ty)
        var mi = 0
        while mi < e.kids.len() {
            let ks = wsc_take(e.line)
            let vs = wsc_take(e.line)
            wexpr(e.kids[mi])
            wsc_set(ks)
            wexpr(e.kids[mi + 1])
            wsc_set(vs)
            wroot_load(r)
            wsc_get(ks)
            wsc_get(vs)
            wcall_named(setfn)
            wc.push(26)
            wsc_free()
            wsc_free()
            mi += 2
        }
        wroot_load(r)
        wroot_free()
        return
    }
    if k == N_SLIT {
        let sd = g_structs[e.refi]
        let r = wroot_take(e.line)
        wconst(8 * sd.fnames.len())
        wcall_named("rt_alloc")
        wroot_store(r)
        for f in e.kids {
            let sc = wsc_take(e.line)
            wexpr(f.kids[0])
            wsc_set(sc)
            wroot_load(r)
            wtruth()
            wsc_get(sc)
            wc.push(55)
            wu(wc, 3)
            wu(wc, 8 * f.slot)
            wsc_free()
        }
        wroot_load(r)
        wroot_free()
        return
    }
    if k == N_INDEX {
        if ty_kind[e.kids[0].ty] == K_MAP {
            let r = wroot_take(e.line)
            wexpr(e.kids[0])
            wroot_store(r)
            wroot_load(r)
            wexpr(e.kids[1])
            wcall_named(map_getfn(e.kids[0].ty))
            wroot_free()
            return
        }
        windex_addr(e.kids[0], e.kids[1], e.line)
        wc.push(41)                          // i64.load
        wu(wc, 3)
        wu(wc, 0)
        return
    }
    if k == N_MEMBER {
        wexpr(e.kids[0])
        wtruth()
        wc.push(41)
        wu(wc, 3)
        wu(wc, 8 * e.slot)
        return
    }
    if k == N_CAST {
        wcast(e)
        return
    }
    if k == N_BIN {
        wbin(e)
        return
    }
    if k == N_CALL {
        wcall(e)
        return
    }
    die(e.line, "--wasm: unsupported expression kind {k}")
}

fn wcast(e: Node) {
    let ck = e.aux
    wexpr(e.kids[0])
    if ck == C_I2F {
        wc.push(185)                         // f64.convert_i64_s
        wc.push(189)                         // i64.reinterpret_f64
        return
    }
    if ck == C_TRUNC {
        wc.push(191)                         // f64.reinterpret_i64
        wc.push(176)                         // i64.trunc_f64_s
        return
    }
    if ck != C_NOP { die(e.line, "--wasm: unsupported cast kind {ck}") }
}

// float binop: reinterpret both operands, operate, reinterpret the result back
fn wfbin(e: Node, opc: int, isrel: bool) {
    wexpr(e.kids[0])
    wc.push(191)
    wexpr(e.kids[1])
    wc.push(191)
    wc.push(opc)
    if isrel { wc.push(173) } else { wc.push(189) }
}

fn wbin(e: Node) {
    let op = e.op
    if op == T_AND or op == T_OR {
        // short-circuit as a block that yields i64. The left value is kept in a
        // scratch local so the condition test can consume a copy of it.
        wc.push(2)                           // block
        wc.push(126)                         // result i64
        g_wnest += 1
        let sc = wsc_take(e.line)
        wexpr(e.kids[0])
        wsc_set(sc)
        wsc_get(sc)                          // candidate result
        wsc_get(sc)
        wtruth()
        if op == T_AND { wc.push(69) }       // i32.eqz: false short-circuits `and`
        wc.push(13)                          // br_if 0 -> leave the candidate
        wu(wc, 0)
        wc.push(26)                          // drop the candidate
        wsc_free()                           // the scratch is dead before the RHS
        wexpr(e.kids[1])
        g_wnest -= 1
        wc.push(11)                          // end
        return
    }
    let cat = e.aux
    if cat == BC_FLOAT {
        if op == T_PLUS {
            wfbin(e, 160, false)
            return
        }
        if op == T_MINUS {
            wfbin(e, 161, false)
            return
        }
        if op == T_STAR {
            wfbin(e, 162, false)
            return
        }
        if op == T_SLASH {
            wfbin(e, 163, false)
            return
        }
        if op == T_EQEQ {
            wfbin(e, 97, true)
            return
        }
        if op == T_NE {
            wfbin(e, 98, true)
            return
        }
        if op == T_LT {
            wfbin(e, 99, true)
            return
        }
        if op == T_GT {
            wfbin(e, 100, true)
            return
        }
        if op == T_LE {
            wfbin(e, 101, true)
            return
        }
        if op == T_GE {
            wfbin(e, 102, true)
            return
        }
        die(e.line, "--wasm: unsupported float operator")
    }
    if cat == BC_STR {
        // The left string has to survive evaluation of the right one, which can
        // allocate -- so it goes in a frame root, not on the operand stack.
        let r = wroot_take(e.line)
        wexpr(e.kids[0])
        wroot_store(r)
        wroot_load(r)
        wexpr(e.kids[1])
        wroot_free()
        if op == T_PLUS {
            wcall_named("rt_str_concat")
            return
        }
        if op == T_EQEQ or op == T_NE {
            if e.slot > 0 {
                wconst(wtaddr(e.slot - 1))
                wcall_named("rt_value_eq")
            } else {
                wcall_named("rt_str_eq")
            }
            if op == T_NE {
                wconst(1)
                wc.push(133)                 // i64.xor
            }
            return
        }
        wcall_named("rt_str_cmp")
        wconst(0)
        var srel = 0
        if op == T_LT { srel = 83 }
        else if op == T_GT { srel = 85 }
        else if op == T_LE { srel = 87 }
        else if op == T_GE { srel = 89 }
        if srel == 0 { die(e.line, "--wasm: unsupported string operator") }
        wc.push(srel)
        wc.push(173)
        return
    }
    wexpr(e.kids[0])
    wexpr(e.kids[1])
    if op == T_PLUS {
        wc.push(124)
        return
    }
    if op == T_MINUS {
        wc.push(125)
        return
    }
    if op == T_STAR {
        wc.push(126)
        return
    }
    if op == T_SLASH {
        wc.push(127)
        return
    }
    if op == T_PCT {
        wc.push(129)
        return
    }
    if op == T_AMP {
        wc.push(131)
        return
    }
    if op == T_PIPE {
        wc.push(132)
        return
    }
    if op == T_CARET {
        wc.push(133)
        return
    }
    if op == T_SHL {
        wc.push(134)
        return
    }
    if op == T_SHR {
        wc.push(135)
        return
    }
    var rel = 0
    if op == T_EQEQ { rel = 81 }
    else if op == T_NE { rel = 82 }
    else if op == T_LT { rel = 83 }
    else if op == T_GT { rel = 85 }
    else if op == T_LE { rel = 87 }
    else if op == T_GE { rel = 89 }
    if rel == 0 { die(e.line, "--wasm: unsupported operator") }
    wc.push(rel)
    wc.push(173)                             // i64.extend_i32_u
}

fn wcall(e: Node) {
    let k = e.aux
    if k == CK_USER {
        if e.op == 1 { wexpr(e.kids[0].kids[0]) }        // UFCS receiver is arg 0
        for i in 1..e.kids.len() { wexpr(e.kids[i]) }
        wc.push(16)                          // call
        wu(wc, g_wfidx[e.refi])
        return
    }
    if k == CK_PRINT {
        // with the runtime linked, print goes through it exactly as it does
        // natively, so formatting is identical across all three targets
        if wfn_named("rt_print_val") >= 0 {
            wexpr(e.kids[1])
            wconst(wtaddr(e.slot))
            wcall_named("rt_print_val")
            wc.push(26)                      // rt_print_val is void
            wconst(0)
            return
        }
        let t = e.kids[1].ty
        wexpr(e.kids[1])
        if t == TI_FLOAT {
            wc.push(191)                     // f64.reinterpret_i64
            wc.push(16)
            wu(wc, 1)
        } else if t == TI_BOOL {
            wc.push(16)
            wu(wc, 2)
        } else {
            wc.push(16)
            wu(wc, 0)
        }
        wconst(0)                            // print is void; every call yields i64
        return
    }
    if k == CK_WGROW {
        wexpr(e.kids[1])
        wtruth()
        wc.push(64)                          // memory.grow
        wc.push(0)
        wc.push(172)                         // i64.extend_i32_s
        return
    }
    if k == CK_WWRITE {
        for i in 1..e.kids.len() { wexpr(e.kids[i]) }
        wc.push(16)
        wu(wc, 3)
        wconst(0)
        return
    }
    if k == CK_WEXIT {
        wexpr(e.kids[1])
        wc.push(16)
        wu(wc, 4)
        wconst(0)
        return
    }
    if k == CK_RTCALL {
        wexpr(e.kids[0].kids[0])             // receiver
        for i in 1..e.kids.len() { wexpr(e.kids[i]) }
        wcall_named(e.name)
        return
    }
    if k == CK_LEN {
        wexpr(e.kids[0].kids[0])
        wtruth()
        wc.push(41)                          // i64.load: length is the first word
        wu(wc, 3)
        wu(wc, 0)
        return
    }
    if k == CK_PUSH {
        wexpr(e.kids[0].kids[0])
        wexpr(e.kids[1])
        wcall_named("rt_list_push")
        return
    }
    if k == CK_POP {
        wexpr(e.kids[0].kids[0])
        wcall_named("rt_list_pop")
        return
    }
    if k == CK_OPT_HAS {
        wexpr(e.kids[0].kids[0])
        wconst(0)
        wc.push(82)                          // i64.ne
        wc.push(173)
        return
    }
    if k == CK_OPT_GET {
        let sc = wsc_take(e.line)
        wexpr(e.kids[0].kids[0])
        wsc_set(sc)
        wsc_get(sc)
        wc.push(80)                          // i64.eqz
        wc.push(4)                           // if
        wc.push(64)
        g_wnest += 1
        wconst(wsaddr(add_dstr("called .get() on a none value")))
        wcall_named("rt_panic_str")
        wc.push(26)
        g_wnest -= 1
        wc.push(11)
        wsc_get(sc)
        wtruth()
        wc.push(41)
        wu(wc, 3)
        wu(wc, 0)
        wsc_free()
        return
    }
    if k == CK_OPT_OR {
        let sc = wsc_take(e.line)
        wexpr(e.kids[0].kids[0])
        wsc_set(sc)
        wc.push(2)                           // block (result i64)
        wc.push(126)
        g_wnest += 1
        wsc_get(sc)
        wc.push(80)                          // i64.eqz
        wc.push(4)                           // if
        wc.push(64)
        g_wnest += 1
        // none: the default is lazy, so it is only evaluated on this path
        wsc_free()
        wexpr(e.kids[1])
        wbr(g_wnest - 1)
        g_wnest -= 1
        wc.push(11)
        wsc_get(sc)
        wtruth()
        wc.push(41)
        wu(wc, 3)
        wu(wc, 0)
        g_wnest -= 1
        wc.push(11)
        return
    }
    if k == CK_ASSERT {
        wexpr(e.kids[1])
        wtruth()
        wc.push(69)                          // i32.eqz
        wc.push(4)
        wc.push(64)
        g_wnest += 1
        if e.kids.len() > 2 { wexpr(e.kids[2]) }
        else { wconst(wsaddr(add_dstr("assertion failed"))) }
        wcall_named("rt_panic_str")
        wc.push(26)
        g_wnest -= 1
        wc.push(11)
        wconst(0)
        return
    }
    if k == CK_MIN or k == CK_MAX {
        if e.ty == TI_FLOAT {
            wexpr(e.kids[1])
            wc.push(191)
            wexpr(e.kids[2])
            wc.push(191)
            if k == CK_MIN { wc.push(164) } else { wc.push(165) }
            wc.push(189)
            return
        }
        let a = wsc_take(e.line)
        let b = wsc_take(e.line)
        wexpr(e.kids[1])
        wsc_set(a)
        wexpr(e.kids[2])
        wsc_set(b)
        wsc_get(a)
        wsc_get(b)
        wsc_get(a)
        wsc_get(b)
        if k == CK_MIN { wc.push(83) } else { wc.push(85) }   // lt_s / gt_s
        wc.push(27)                          // select: a if the test holds
        wsc_free()
        wsc_free()
        return
    }
    if k == CK_ABS and e.ty != TI_FLOAT {
        let a = wsc_take(e.line)
        wexpr(e.kids[1])
        wsc_set(a)
        wsc_get(a)
        wconst(0)
        wsc_get(a)
        wc.push(125)                         // i64.sub: negated
        wsc_get(a)
        wconst(0)
        wc.push(89)                          // i64.ge_s
        wc.push(27)                          // select
        wsc_free()
        return
    }
    if k == CK_POW {
        wexpr(e.kids[1])
        wexpr(e.kids[2])
        wcall_named("rt_ipow")
        return
    }
    if k == CK_SUB {
        let r = wroot_take(e.line)
        wexpr(e.kids[0].kids[0])
        wroot_store(r)
        wroot_load(r)
        wexpr(e.kids[1])
        wexpr(e.kids[2])
        wcall_named("rt_str_sub")
        wroot_free()
        return
    }
    if k == CK_JOIN {
        wexpr(e.kids[0].kids[0])
        wcall_named("rt_join")
        return
    }
    if k == CK_BYTE {
        let sc = wsc_take(e.line)
        let ix = wsc_take(e.line)
        wexpr(e.kids[0].kids[0])
        wsc_set(sc)
        wexpr(e.kids[1])
        wsc_set(ix)
        wsc_get(ix)                          // bounds: one unsigned compare
        wsc_get(sc)
        wtruth()
        wc.push(41)
        wu(wc, 3)
        wu(wc, 0)
        wc.push(90)                          // i64.ge_u
        wc.push(4)
        wc.push(64)
        g_wnest += 1
        wsc_get(ix)
        wsc_get(sc)
        wtruth()
        wc.push(41)
        wu(wc, 3)
        wu(wc, 0)
        wcall_named("rt_bounds_fail")
        wc.push(26)
        g_wnest -= 1
        wc.push(11)
        wsc_get(sc)
        wsc_get(ix)
        wc.push(124)                         // i64.add
        wtruth()
        wc.push(49)                          // i64.load8_u, past the length word
        wu(wc, 0)
        wu(wc, 8)
        wsc_free()
        wsc_free()
        return
    }
    if k == CK_INDIRECT {
        // Call through a {code, env} cell. code is a function-table index; env
        // travels in a global that the callee's prologue immediately spills to
        // its frame. Arguments are evaluated BEFORE the global is set, so a
        // nested indirect call in an argument cannot clobber it.
        let r = wroot_take(e.line)
        var n = 0
        wexpr(e.kids[0])
        wroot_store(r)
        for i in 1..e.kids.len() {
            wexpr(e.kids[i])
            n += 1
        }
        wroot_load(r)
        wtruth()
        wc.push(41)                          // env = cell[8]
        wu(wc, 3)
        wu(wc, 8)
        wc.push(36)                          // global.set __env
        wu(wc, 1)
        wroot_load(r)
        wtruth()
        wc.push(41)                          // code = cell[0]
        wu(wc, 3)
        wu(wc, 0)
        wtruth()
        wc.push(17)                          // call_indirect
        wu(wc, 5 + n)
        wu(wc, 0)                            // table 0
        wroot_free()
        return
    }
    if k == CK_IDISPATCH {
        // Virtual call: the interface value is a {vtable, data} cell, and the
        // vtable slot holds a function-table index.
        let r = wroot_take(e.line)
        wexpr(e.kids[0].kids[0])
        wroot_store(r)
        wroot_load(r)
        wtruth()
        wc.push(41)                          // self = data
        wu(wc, 3)
        wu(wc, 8)
        for i in 1..e.kids.len() { wexpr(e.kids[i]) }
        wroot_load(r)
        wtruth()
        wc.push(41)                          // vtable
        wu(wc, 3)
        wu(wc, 0)
        wtruth()
        wc.push(41)                          // method index
        wu(wc, 3)
        wu(wc, 8 * e.slot)
        wtruth()
        wc.push(17)                          // call_indirect
        wu(wc, 5 + e.kids.len())             // self plus the declared arguments
        wu(wc, 0)
        wroot_free()
        return
    }
    if k == CK_READF {
        wexpr(e.kids[1])
        wcall_named("rt_read_file")
        return
    }
    if k == CK_WRITEF {
        let r = wroot_take(e.line)
        wexpr(e.kids[1])
        wroot_store(r)
        wroot_load(r)
        wexpr(e.kids[2])
        wcall_named("rt_write_file")
        wroot_free()
        return
    }
    if k == CK_EMIT {
        wexpr(e.kids[1])
        wcall_named("rt_emit")
        wc.push(26)
        wconst(0)
        return
    }
    if k == CK_PANIC {
        wexpr(e.kids[1])
        wcall_named("rt_panic_str")
        wc.push(26)
        wconst(0)
        return
    }
    if k == CK_ZEROS {
        wexpr(e.kids[1])
        wcall_named("rt_list_new")
        return
    }
    if k == CK_ARGS {
        wcall_named("rt_args")
        return
    }
    if k == CK_CHR {
        wexpr(e.kids[1])
        wcall_named("rt_chr")
        return
    }
    if k == CK_LOAD64 {
        wexpr(e.kids[1])
        wtruth()
        wc.push(41)
        wu(wc, 3)
        wu(wc, 0)
        return
    }
    if k == CK_LOAD8 {
        wexpr(e.kids[1])
        wtruth()
        wc.push(49)                          // i64.load8_u
        wu(wc, 0)
        wu(wc, 0)
        return
    }
    if k == CK_LOAD32 or k == CK_LOAD16 {
        wexpr(e.kids[1])
        wtruth()
        if k == CK_LOAD32 {
            wc.push(53)                      // i64.load32_u
            wu(wc, 2)
        } else {
            wc.push(51)                      // i64.load16_u
            wu(wc, 1)
        }
        wu(wc, 0)
        return
    }
    if k == CK_STORE64 or k == CK_STORE32 or k == CK_STORE8 {
        wexpr(e.kids[1])
        wtruth()
        wexpr(e.kids[2])
        if k == CK_STORE64 {
            wc.push(55)
            wu(wc, 3)
        } else if k == CK_STORE32 {
            wc.push(62)                      // i64.store32
            wu(wc, 2)
        } else {
            wc.push(60)                      // i64.store8
            wu(wc, 0)
        }
        wu(wc, 0)
        wconst(0)
        return
    }
    if k == CK_STACKPTR {
        wframe_addr()
        wc.push(172)                         // i64.extend_i32_s
        return
    }
    if k == CK_SQRT {
        wexpr(e.kids[1])
        wc.push(191)
        wc.push(159)                         // f64.sqrt
        wc.push(189)
        return
    }
    if k == CK_BITS {        // identity: values are bits
        wexpr(e.kids[1])
        return
    }
    if k == CK_ABS and e.ty == TI_FLOAT {
        wexpr(e.kids[1])
        wc.push(191)
        wc.push(153)                         // f64.abs
        wc.push(189)
        return
    }
    die(e.line, "--wasm: unsupported call kind {k}")
}

fn wstmt(s: Node) {
    let k = s.k
    if k == N_DECL {
        wstore_addr(s.aux, s.slot)
        wexpr(s.kids[0])
        wstore_fin(s.aux, s.slot)
        return
    }
    if k == N_ASSIGN {
        let t = s.kids[0]
        if t.k == N_ID {
            wstore_addr(t.aux, t.slot)
            wexpr(s.kids[1])
            wstore_fin(t.aux, t.slot)
            return
        }
        if t.k == N_MEMBER {
            let sc = wsc_take(s.line)
            wexpr(s.kids[1])                 // value first, then the object:
            wsc_set(sc)                      // the object must not be stale
            wexpr(t.kids[0])
            wtruth()
            wsc_get(sc)
            wc.push(55)
            wu(wc, 3)
            wu(wc, 8 * t.slot)
            wsc_free()
            return
        }
        if t.k == N_INDEX {
            if ty_kind[t.kids[0].ty] == K_MAP {
                let r = wroot_take(s.line)
                let ks = wsc_take(s.line)
                wexpr(t.kids[0])
                wroot_store(r)
                wexpr(t.kids[1])
                wsc_set(ks)
                wroot_load(r)
                wsc_get(ks)
                wexpr(s.kids[1])
                wcall_named(map_setfn(t.kids[0].ty))
                wc.push(26)
                wsc_free()
                wroot_free()
                return
            }
            let sc = wsc_take(s.line)
            wexpr(s.kids[1])
            wsc_set(sc)
            windex_addr(t.kids[0], t.kids[1], s.line)
            wsc_get(sc)
            wc.push(55)
            wu(wc, 3)
            wu(wc, 0)
            wsc_free()
            return
        }
        die(s.line, "--wasm: unsupported assignment target")
    }
    if k == N_EXPRST {
        wexpr(s.kids[0])
        wc.push(26)                          // drop
        return
    }
    if k == N_RET {
        if s.kids[0].k != N_NONE { wexpr(s.kids[0]) } else { wconst(0) }
        wsp_restore()
        wc.push(15)                          // return
        return
    }
    if k == N_IF {
        wexpr(s.kids[0])
        wtruth()
        wc.push(4)                           // if
        wc.push(64)                          // void
        g_wnest += 1
        wblock(s.kids[1])
        if s.kids[2].k != N_NONE {
            wc.push(5)                       // else
            wblock(s.kids[2])
        }
        g_wnest -= 1
        wc.push(11)                          // end
        return
    }
    if k == N_WHILE {
        wc.push(2)                           // block: break target
        wc.push(64)
        g_wnest += 1
        let brk = g_wnest
        wc.push(3)                           // loop: continue target
        wc.push(64)
        g_wnest += 1
        let cont = g_wnest
        wexpr(s.kids[0])
        wtruth()
        wc.push(69)                          // i32.eqz
        wc.push(13)                          // br_if -> leave the block
        wu(wc, g_wnest - brk)
        g_wbrk.push(brk)
        g_wcont.push(cont)
        wblock(s.kids[1])
        let x1 = g_wbrk.pop()
        let x2 = g_wcont.pop()
        wbr(cont)
        g_wnest -= 1
        wc.push(11)
        g_wnest -= 1
        wc.push(11)
        return
    }
    if k == N_FORR {
        wstore_addr(ID_LOCAL, s.slot)
        wexpr(s.kids[0])
        wstore_fin(ID_LOCAL, s.slot)
        wstore_addr(ID_LOCAL, s.aux)
        wexpr(s.kids[1])
        wstore_fin(ID_LOCAL, s.aux)
        // Three nested structures, because `continue` must reach the increment
        // rather than the condition: an outer block to break out of, the loop
        // itself for the back edge, and an inner block whose END is where
        // `continue` lands -- falling straight into i += 1.
        wc.push(2)                           // block: break target
        wc.push(64)
        g_wnest += 1
        let brk = g_wnest
        wc.push(3)                           // loop: back edge
        wc.push(64)
        g_wnest += 1
        let back = g_wnest
        wc.push(2)                           // block: continue target
        wc.push(64)
        g_wnest += 1
        let cont = g_wnest
        wload_slot(ID_LOCAL, s.slot)
        wload_slot(ID_LOCAL, s.aux)
        wc.push(83)                          // i64.lt_s
        wc.push(69)                          // i32.eqz
        wc.push(13)
        wu(wc, g_wnest - brk)
        g_wbrk.push(brk)
        g_wcont.push(cont)
        wblock(s.kids[2])
        let x1 = g_wbrk.pop()
        let x2 = g_wcont.pop()
        g_wnest -= 1
        wc.push(11)                          // end continue-block
        wstore_addr(ID_LOCAL, s.slot)
        wload_slot(ID_LOCAL, s.slot)
        wconst(1)
        wc.push(124)                         // i64.add
        wstore_fin(ID_LOCAL, s.slot)
        wbr(back)
        g_wnest -= 1
        wc.push(11)                          // end loop
        g_wnest -= 1
        wc.push(11)                          // end block
        return
    }
    if k == N_FORIN {
        // hidden slots: s.aux holds the list (a frame slot, so it stays a GC
        // root for the whole loop), s.op the index, s.slot the element
        wstore_addr(ID_LOCAL, s.aux)
        wexpr(s.kids[0])
        wstore_fin(ID_LOCAL, s.aux)
        wstore_addr(ID_LOCAL, s.op)
        wconst(0)
        wstore_fin(ID_LOCAL, s.op)
        wc.push(2)                           // block: break target
        wc.push(64)
        g_wnest += 1
        let brk = g_wnest
        wc.push(3)                           // loop: back edge
        wc.push(64)
        g_wnest += 1
        let back = g_wnest
        wc.push(2)                           // block: continue target
        wc.push(64)
        g_wnest += 1
        let cont = g_wnest
        wload_slot(ID_LOCAL, s.op)
        wload_slot(ID_LOCAL, s.aux)
        wtruth()
        wc.push(41)                          // i64.load: length
        wu(wc, 3)
        wu(wc, 0)
        wc.push(89)                          // i64.ge_s
        wc.push(13)                          // br_if -> leave the loop
        wu(wc, g_wnest - brk)
        wstore_addr(ID_LOCAL, s.slot)        // elem = data[index]
        wload_slot(ID_LOCAL, s.aux)
        wtruth()
        wc.push(41)
        wu(wc, 3)
        wu(wc, 16)
        wload_slot(ID_LOCAL, s.op)
        wconst(8)
        wc.push(126)
        wc.push(124)
        wtruth()
        wc.push(41)
        wu(wc, 3)
        wu(wc, 0)
        wstore_fin(ID_LOCAL, s.slot)
        g_wbrk.push(brk)
        g_wcont.push(cont)
        wblock(s.kids[1])
        let x1 = g_wbrk.pop()
        let x2 = g_wcont.pop()
        g_wnest -= 1
        wc.push(11)                          // end continue-block
        wstore_addr(ID_LOCAL, s.op)
        wload_slot(ID_LOCAL, s.op)
        wconst(1)
        wc.push(124)
        wstore_fin(ID_LOCAL, s.op)
        wbr(back)
        g_wnest -= 1
        wc.push(11)
        g_wnest -= 1
        wc.push(11)
        return
    }
    if k == N_BRK {
        wbr(g_wbrk[g_wbrk.len() - 1 - s.ival])
        return
    }
    if k == N_CONT {
        wbr(g_wcont[g_wcont.len() - 1 - s.ival])
        return
    }
    if k == N_INLINE {
        wc.push(2)                           // block: every IRET branches to its end
        wc.push(64)
        g_wnest += 1
        g_winl.push(g_wnest)
        g_winlslot.push(s.slot)
        for st in s.kids { wstmt(st) }
        let x1 = g_winl.pop()
        let x2 = g_winlslot.pop()
        g_wnest -= 1
        wc.push(11)
        return
    }
    if k == N_IRET {
        let slot = g_winlslot[g_winlslot.len() - 1]
        wstore_addr(ID_LOCAL, slot)
        if s.kids[0].k != N_NONE { wexpr(s.kids[0]) } else { wconst(0) }
        wstore_fin(ID_LOCAL, slot)
        wbr(g_winl[g_winl.len() - 1])
        return
    }
    die(s.line, "--wasm: unsupported statement kind {k}")
}

fn wblock(b: Node) {
    for s in b.kids { wstmt(s) }
}

fn wfn_body(nslots: int, nparams: int, stmts: [Node]) {
    wc = wnew()
    g_wnslots = nslots
    g_wnparams = nparams
    g_wfp = nparams                          // locals: params, then fp, then scratch
    g_wframe = 8 * (nslots + nparams + W_ROOTS + 1)   // +1 for the closure env
    if g_wframe % 16 != 0 { g_wframe += 8 }
    g_wsc = 0
    g_wroot = 0
    wu(wc, 2)
    wu(wc, 1)
    wc.push(127)                             // one i32: the frame pointer
    wu(wc, W_SCRATCH)
    wc.push(126)                             // the i64 scratch pool
    wc.push(35)                              // global.get __sp
    wu(wc, 0)
    wi32(g_wframe)
    wc.push(107)                             // i32.sub
    wc.push(34)                              // local.tee fp
    wu(wc, g_wfp)
    wc.push(36)                              // global.set __sp
    wu(wc, 0)
    for i in 0..nparams {                    // params into the frame, where the GC can see them
        wframe_addr()
        wc.push(32)
        wu(wc, i)
        wc.push(55)
        wu(wc, 3)
        wu(wc, wslot_off(ID_PARAM, i))
    }
    wframe_addr()                            // and the closure env alongside them
    wc.push(35)                              // global.get __env
    wu(wc, 1)
    wc.push(55)
    wu(wc, 3)
    wu(wc, wenv_off())
    for s in stmts { wstmt(s) }
    wsp_restore()
    wconst(0)
    wc.push(11)                              // end
}

fn wstr(b: [int], s: str) {
    wu(b, s.len())
    for i in 0..s.len() { b.push(s.byte(i)) }
}

// wasm function index for a runtime helper called by name, the way rcall()
// names them on x86.
fn wfn_named(name: str) -> int {
    let fi = find_fn(name)
    if fi < 0 { return 0 - 1 }
    return g_wfidx[fi]
}

fn wcall_named(name: str) {
    let ix = wfn_named(name)
    if ix < 0 { panic("--wasm: the runtime function " + name + " is missing (compile with --rt)") }
    wc.push(16)
    wu(wc, ix)
}

fn wd8(v: int) { g_wdata.push(v % 256) }

fn wd64(v: int) {
    var x = v
    for i in 0..8 {
        wd8(x % 256)
        x = x / 256
    }
}

fn wdalign() {
    while g_wdata.len() % 8 != 0 { wd8(0) }
}

fn wdaddr() -> int { return W_DATA + g_wdata.len() }

// Lay out every constant the program needs at a fixed address. Mirrors the
// .rdata emission in gen_program, except the addresses are absolute, which is
// why codegen has to run once first to discover which literals exist.
fn wlayout() {
    // string literals: [len][bytes]
    for i in 0..g_dstrs.len() {
        wdalign()
        g_wsaddr.push(wdaddr())
        wd64(g_dstrs[i].len())
        for j in 0..g_dstrs[i].len() { wd8(g_dstrs[i].byte(j)) }
    }
    // Type descriptors. The loop grows g_descs as it walks, exactly like the
    // native emitter, so descriptors reachable only from other descriptors get
    // addresses too. Cross-references are recorded as patches rather than
    // written inline, because the target addresses are not known until the
    // whole table has been walked.
    var di = 0
    while di < g_descs.len() {
        wdalign()
        g_wtaddr.push(wdaddr())
        let t = g_descs[di]
        let k = ty_kind[t]
        if k == K_LIST and ty_kind[ty_el[t]] == K_U8 {
            wd64(10)
        } else if k == K_LIST and ty_kind[ty_el[t]] == K_F32 {
            wd64(11)
        } else if k == K_LIST {
            wd64(4)
            wpatch(0, td_index(ty_el[t]))
        } else if k == K_STRUCT and is_union(t) {
            let sd = g_structs[ty_sd[t]]
            wd64(9)
            wd64(sd.variants.len())
            for v in sd.variants { wpatch(0, td_index(struct_of(v))) }
        } else if k == K_STRUCT {
            let sd = g_structs[ty_sd[t]]
            wd64(5)
            wpatch(1, add_cstr(struct_base_name(sd)))
            wd64(sd.fnames.len())
            for j in 0..sd.fnames.len() {
                wpatch(1, add_cstr(sd.fnames[j]))
                wpatch(0, td_index(sd.ftypes[j]))
            }
        } else if k == K_OPT {
            wd64(8)
            wpatch(0, td_index(ty_el[t]))
        } else if k == K_MAP {
            wd64(7)
            wpatch(0, td_index(ty_sd[t]))
            wpatch(0, td_index(ty_el[t]))
        } else if k == K_ENUM {
            let ed = g_enums[ty_sd[t]]
            wd64(6)
            wd64(ed.members.len())
            for j in 0..ed.members.len() { wpatch(1, add_cstr(ed.members[j])) }
        } else {
            wd64(k)
        }
        di += 1
    }
    // Interface vtables. On x86 the slots hold code addresses; here they hold
    // function-TABLE indices, which is what call_indirect takes. g_wfidx is
    // still populated from pass one at this point, so they are known.
    for i in 0..g_vt_sd.len() {
        wdalign()
        g_wvaddr.push(wdaddr())
        let sname = g_structs[g_vt_sd[i]].name
        let idf = g_ifaces[g_vt_if[i]]
        for m in 0..idf.mnames.len() {
            let mi = find_fn(sname + "." + idf.mnames[m])
            if mi < 0 { panic("--wasm: missing interface method " + sname + "." + idf.mnames[m]) }
            wd64(g_wfidx[mi])
        }
    }
    for i in 0..g_cstrs.len() {
        g_wcaddr.push(wdaddr())
        for j in 0..g_cstrs[i].len() { wd8(g_cstrs[i].byte(j)) }
        wd8(0)
    }
    // now every target has an address, so the recorded cross-references resolve
    for i in 0..g_wpoff.len() {
        if g_wpkind[i] == 0 { wfix(g_wpoff[i], g_wtaddr[g_wpidx[i]]) }
        else { wfix(g_wpoff[i], g_wcaddr[g_wpidx[i]]) }
    }

    wdalign()
    g_wglobals = wdaddr()
    for i in 0..g_nglobals { wd64(0) }
    g_wstklo = W_DATA + g_wdata.len()
    if g_wstklo % 16 != 0 { g_wstklo += 16 - g_wstklo % 16 }
    // Round the heap base to a page so it is exactly the initial memory end;
    // the OS shim can then track committed memory without asking for its size.
    g_wstktop = g_wstklo + W_STACK_BYTES
    if g_wstktop % 65536 != 0 { g_wstktop += 65536 - g_wstktop % 65536 }
    g_wpages = g_wstktop / 65536
}

// reserve an 8-byte slot whose value is an address only known later:
// kind 0 = the address of type descriptor idx, kind 1 = of C string idx
fn wpatch(kind: int, idx: int) {
    g_wpoff.push(g_wdata.len())
    g_wpkind.push(kind)
    g_wpidx.push(idx)
    wd64(0)
}

fn wfix(off: int, v: int) {
    var x = v
    for i in 0..8 {
        g_wdata[off + i] = x % 256
        x = x / 256
    }
}

fn gen_wasm(prog: Node) {
    var order: [int] = []
    for n in prog.kids {
        if n.k == N_FN {
            let f = g_fns[n.refi]
            if f.tparams.len() > 0 { continue }      // a template emits no code
            order.push(n.refi)
        }
    }
    for i in 0..g_insts.len() { order.push(g_insts[i]) }
    for i in 0..g_fns.len() { g_wfidx.push(0) }
    for i in 0..order.len() {
        g_wfidx[order[i]] = 5 + i            // wasm indices 0-4 are the imports
        g_warity.push(g_fns[order[i]].pnames.len())
    }
    g_warity.push(0)                         // zephyr_main, emitted last

    var nbodies = 0
    for i in 0..order.len() {
        let f = g_fns[order[i]]
        wfn_body(f.nslots, f.pnames.len(), f.body.kids)
        wu(g_wcode, wc.len())
        wcat(g_wcode, wc)
        nbodies += 1
    }
    var top: [Node] = []
    for n in prog.kids {
        if n.k != N_FN and n.k != N_STRUCTDEF and n.k != N_ENUMDEF and n.k != N_INTERFACE { top.push(n) }
    }
    wfn_body(g_top_nslots, 0, top)
    wu(g_wcode, wc.len())
    wcat(g_wcode, wc)
    nbodies += 1

    var head: [int] = []
    wu(head, nbodies)
    wcat(head, g_wcode)
    g_wcode = head
}

fn wtrunc_str(xs: [str]) {
    while xs.len() > 0 { let x = xs.pop() }
}

fn wtrunc_int(xs: [int]) {
    while xs.len() > 0 { let x = xs.pop() }
}

// Two passes. Codegen is what discovers which string literals and type
// descriptors a program uses, but wasm needs their absolute addresses while
// generating -- so run it once to populate the tables, lay the data out, then
// throw the code away and generate it again for real.
fn gen_wasm_twice(prog: Node) {
    gen_wasm(prog)
    wlayout()
    wtrunc_str(g_dstrs)                      // add_dstr does not dedupe: reset it
    // g_descs is kept: td_index dedupes, so pass two gets pass one's indices back,
    // which are the ones wlayout gave addresses to
    wtrunc_int(g_wfidx)
    wtrunc_int(g_warity)
    wtrunc_int(g_wcode)
    g_wpass = 2
    gen_wasm(prog)
}

fn write_wasm(path: str) {
    w_out.push(0)
    w_out.push(97)
    w_out.push(115)
    w_out.push(109)
    w_out.push(1)
    w_out.push(0)
    w_out.push(0)
    w_out.push(0)

    var maxar = 0
    for i in 0..g_warity.len() {
        if g_warity[i] > maxar { maxar = g_warity[i] }
    }
    // types 0-4 belong to the imports; type 5+a is (i64 x a) -> i64
    var tsec: [int] = []
    wu(tsec, 6 + maxar)
    tsec.push(96)
    wu(tsec, 1)
    tsec.push(126)
    wu(tsec, 0)                              // 0: print_i64
    tsec.push(96)
    wu(tsec, 1)
    tsec.push(124)
    wu(tsec, 0)                              // 1: print_f64
    tsec.push(96)
    wu(tsec, 1)
    tsec.push(126)
    wu(tsec, 0)                              // 2: print_bool
    tsec.push(96)
    wu(tsec, 3)
    tsec.push(126)
    tsec.push(126)
    tsec.push(126)
    wu(tsec, 0)                              // 3: write(fd, ptr, len)
    tsec.push(96)
    wu(tsec, 1)
    tsec.push(126)
    wu(tsec, 0)                              // 4: exit(code)
    for a in 0..maxar + 1 {
        tsec.push(96)
        wu(tsec, a)
        for j in 0..a { tsec.push(126) }
        wu(tsec, 1)
        tsec.push(126)
    }
    wsect(1, tsec)

    var isec: [int] = []
    wu(isec, 5)
    wstr(isec, "env")
    wstr(isec, "print_i64")
    isec.push(0)
    wu(isec, 0)
    wstr(isec, "env")
    wstr(isec, "print_f64")
    isec.push(0)
    wu(isec, 1)
    wstr(isec, "env")
    wstr(isec, "print_bool")
    isec.push(0)
    wu(isec, 2)
    wstr(isec, "env")
    wstr(isec, "write")
    isec.push(0)
    wu(isec, 3)
    wstr(isec, "env")
    wstr(isec, "exit")
    isec.push(0)
    wu(isec, 4)
    wsect(2, isec)

    var fsec: [int] = []
    wu(fsec, g_warity.len())
    for i in 0..g_warity.len() { wu(fsec, 5 + g_warity[i]) }
    wsect(3, fsec)

    // one funcref table holding every function, so a table index and a function
    // index are the same number and a fn value can just carry it
    let ntotal = 5 + g_warity.len()
    var tbsec: [int] = []
    wu(tbsec, 1)
    tbsec.push(112)                          // funcref
    tbsec.push(0)                            // no maximum
    wu(tbsec, ntotal)
    wsect(4, tbsec)

    var msec: [int] = []
    wu(msec, 1)
    msec.push(0)                             // no maximum: the GC grows memory
    wu(msec, g_wpages)
    wsect(5, msec)

    var gsec: [int] = []
    wu(gsec, 2)
    gsec.push(127)                           // 0: i32 __sp
    gsec.push(1)                             // mutable
    wi32_into(gsec, g_wstktop)
    gsec.push(11)
    gsec.push(126)                           // 1: i64 __env, the closure environment
    gsec.push(1)
    gsec.push(66)
    ws(gsec, 0)
    gsec.push(11)
    wsect(6, gsec)

    var esec: [int] = []
    wu(esec, 2)
    wstr(esec, "main")
    esec.push(0)
    wu(esec, 4 + g_warity.len())             // zephyr_main is the last function
    wstr(esec, "memory")
    esec.push(2)
    wu(esec, 0)
    wsect(7, esec)

    var elsec: [int] = []
    wu(elsec, 1)
    wu(elsec, 0)                             // active segment, table 0
    wi32_into(elsec, 0)
    elsec.push(11)
    wu(elsec, ntotal)
    for i in 0..ntotal { wu(elsec, i) }      // identity: table[i] == function i
    wsect(9, elsec)

    wsect(10, g_wcode)

    // one active data segment at offset 8: the three memory-map constants the
    // OS shim reads, then every literal and descriptor
    var dsec: [int] = []
    wu(dsec, 1)
    wu(dsec, 0)                              // memory 0
    wi32_into(dsec, W_META_HEAP)
    dsec.push(11)
    var meta: [int] = []
    var save = g_wdata
    g_wdata = meta
    wd64(g_wstktop)                          // heap base sits above the stack
    wd64(g_wstklo)
    wd64(g_wstktop)
    g_wdata = save
    wu(dsec, meta.len() + g_wdata.len())
    wcat(dsec, meta)
    wcat(dsec, g_wdata)
    wsect(11, dsec)

    wserialise(path)
}

// Fill one counted byte string instead of allocating a string for every byte.
fn wserialise(path: str) {
    let data = chr(0).repeat(w_out.len())
    for i in 0..w_out.len() { store8(addr(data) + 8 + i, w_out[i]) }
    write_file(path, data)
}

fn assemble_and_link(path: str) {
    if g_wasm {
        write_wasm(path)
        return
    }
    a_sect = SEC_TEXT
    for i in 0..g_lines.len() {
        asm_line(g_lines[i])
    }
    if g_linux { write_elf(path) } else { write_pe(path) }
    if g_debug and not g_linux { write_zdbg(path + ".zdbg") }
}

// ---------------- driver ----------------
let argv = args()
var d_rt = false
var d_version = false
var d_test = false
var d_in = ""
var d_out = ""
var ai = 1
while ai < argv.len() {
    let a = argv[ai]
    if a == "--rt" { d_rt = true }
    else if a == "--linux" { g_linux = true }
    else if a == "--wasm" { g_wasm = true }
    else if a == "--version" { d_version = true }
    else if a == "-g" or a == "--debug" { g_debug = true }
    else if a == "--test" {                  // run the main file's test blocks instead of main()
        d_test = true
        d_rt = true
    }
    else if d_in == "" { d_in = a }
    else { d_out = a }
    ai += 1
}
if d_version {
    print("zc 0.2 -- the Zephyr compiler, written in Zephyr")
}
if d_in == "" and d_version {
    // --version alone: nothing to compile
} else {
    if d_in == "" or d_out == "" {
        panic("usage: zc [--rt] [--test] [--linux | --wasm] [-g] [--version] <input.zeph> <output.exe|output.s|output.wasm>")
    }
    g_file = basename(d_in)
    g_exedir = exe_dir()
    var prog = parse(lex_src(read_file(d_in), 1))
    let tests = collect_tests(prog)
    scope_module(prog, basename(d_in), "")
    if d_test { add_test_runner(prog, tests) }
    else { call_main(prog) }
    prog = expand_imports(prog, dirname(d_in))
    var firstUserNode = 0
    g_file = basename(d_in)
    if d_rt {
        // prepend the Zephyr runtime so rt_* resolve locally (kernel32-only
        // output). A runtime.zeph next to the compiler, then one in the current
        // directory, overrides the copy embedded in the binary.
        var rtsrc = ""
        if g_exedir != "" and path_exists(g_exedir + "compiler/runtime.zeph") {
            g_file = "compiler/runtime.zeph"
            rtsrc = read_file(g_exedir + "compiler/runtime.zeph")
        } else if g_exedir != "" and path_exists(g_exedir + "runtime.zeph") {
            g_file = "runtime.zeph"
            rtsrc = read_file(g_exedir + "runtime.zeph")
        } else if path_exists("runtime.zeph") {
            g_file = "runtime.zeph"
            rtsrc = read_file("runtime.zeph")
        } else {
            g_file = "runtime.zeph (embedded)"
            rtsrc = embedded_runtime()
            if rtsrc == "" { panic("runtime.zeph not found next to zc.exe or in the current directory, and this build has no embedded runtime") }
        }
        // --linux: the kernel32 entry points the runtime calls are provided as
        // ordinary Zephyr functions over syscalls, so runtime.zeph itself needs
        // no #ifdef and no platform fork.
        if g_linux or g_wasm {
            var osname = "lib/os/linux.zeph"
            if g_wasm { osname = "lib/os/wasm.zeph" }
            var ospath = g_exedir + osname
            if not path_exists(ospath) { ospath = osname }
            if not path_exists(ospath) { panic("this target needs " + osname + " next to zc.exe") }
            g_file = osname
            rtsrc = read_file(ospath) + rtsrc
        }
        if not g_wasm {
            // The runtime source stays untouched on disk; only failure branches
            // of helpers reached from native code receive the caller's site.
            rtsrc = rtsrc.replace("fn rt_str_to_int(s: int) -> int \{", "fn rt_str_to_int(s: int, site: str) -> int \{")
            rtsrc = rtsrc.replace("fn rt_str_to_float(s: int) -> int \{", "fn rt_str_to_float(s: int, site: str) -> int \{")
            rtsrc = rtsrc.replace("fn rt_list_pop(l: int) -> int \{", "fn rt_list_pop(l: int, site: str) -> int \{")
            rtsrc = rtsrc.replace("fn rt_map_get(m: int, k: int) -> int \{", "fn rt_map_get(m: int, k: int, site: str) -> int \{")
            rtsrc = rtsrc.replace("fn rt_read_file(path: int) -> int \{", "fn rt_read_file(path: int, site: str) -> int \{")
            rtsrc = rtsrc.replace("fn rt_write_file(path: int, data: int) \{", "fn rt_write_file(path: int, data: int, site: str) \{")
            rtsrc = rtsrc.replace("rt_die(\"cannot convert to int\")", "rt_die(site + \"cannot convert to int\")")
            rtsrc = rtsrc.replace("rt_die(\"cannot convert to float\")", "rt_die(site + \"cannot convert to float\")")
            rtsrc = rtsrc.replace("rt_die(\"pop from empty list\")", "rt_die(site + \"pop from empty list\")")
            rtsrc = rtsrc.replace("rt_die(\"map key not found\")", "rt_die(site + \"map key not found\")")
            rtsrc = rtsrc.replace("rt_die(\"cannot read file\")", "rt_die(site + \"cannot read file\")")
            rtsrc = rtsrc.replace("rt_die(\"cannot write file\")", "rt_die(site + \"cannot write file\")")
            rtsrc += "\nfn rt_panic_at(site: str, msg: str) \{ rt_die(site + msg) \}\n"
        }
        let rtprog = parse(lex_src(rtsrc, 1))
        var merged: [Node] = []
        for i in 0..rtprog.kids.len() {
            let n = rtprog.kids[i]
            if n.k != N_FN and n.k != N_STRUCTDEF and n.k != N_ENUMDEF { g_rt_top += 1 }
            merged.push(n)
        }
        for i in 0..prog.kids.len() { merged.push(prog.kids[i]) }
        prog.kids = merged
        g_file = basename(d_in)
        firstUserNode = rtprog.kids.len()
    }
    hoist_consts(prog, firstUserNode)
    desugar_extern(prog)
    desugar_oop(prog)
    lower_defers(prog)
    check(prog)
    g_file = basename(d_in)
    fold_globals(prog)
    inline_pass(prog)
    cf_fold_all(prog)                       // fold what inlined literal args exposed
    let is_s = d_out.len() > 2 and d_out.sub(d_out.len() - 2, d_out.len()) == ".s"
    // -g only affects native exe output; keep .zloc markers out of .s (gcc path)
    g_main_file = d_in
    if is_s { g_debug = false }
    if g_wasm {
        // wasm is not a register machine, so none of the x86 passes apply here
        gen_wasm_twice(prog)
        write_wasm(d_out)
    } else {
        gen_program(prog)
        if is_s {
            write_file(d_out, g_lines.join())
        } else {
            assemble_and_link(d_out)
        }
    }
}
