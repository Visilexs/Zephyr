let TOKNAMES = ["end of file", "newline", "int literal", "float literal", "string",
    "identifier", "fn", "let", "var", "if", "else", "while", "for", "in", "return",
    "struct", "as", "true", "false", "and", "or", "not", "break", "continue",
    "(", ")", "\{", "\}", "[", "]", ",", ":", ".", "..",
    "+", "-", "*", "/", "%", "<", ">", "<=", ">=", "==", "!=", "=", "->",
    "+=", "-=", "*=", "/=", "&", "|", "^", "<<", ">>", "enum", "import", "?", "none",
    "impl", "interface", "extern", "const", "%=", "&=", "|=", "^=", "<<=", ">>=", "~", "match", "defer"]

// ---------------- node kinds ----------------
let N_NONE = 0
let N_PROG = 1
let N_FN = 2
let N_STRUCTDEF = 3
let N_PARAM = 4
let N_FIELDDEF = 5
let N_DECL = 6
let N_ASSIGN = 7
let N_IF = 8
let N_WHILE = 9
let N_FORR = 10
let N_FORIN = 11
let N_RET = 12
let N_BRK = 13
let N_CONT = 14
let N_EXPRST = 15
let N_INT = 16
let N_FLOAT = 17
let N_BOOL = 18
let N_STRLIT = 19
let N_STRTXT = 20
let N_INTERP = 21
let N_ID = 22
let N_LIST = 23
let N_SLIT = 24
let N_FIELDINIT = 25
let N_NEG = 26
let N_NOT = 27
let N_BIN = 28
let N_CAST = 29
let N_INDEX = 30
let N_MEMBER = 31
let N_CALL = 32      // ival: before checking, 1 + the type the context expects (0 = none)
let N_TYNAME = 33
let N_TYLIST = 34
let N_ENUMDEF = 35
let N_TYMAP = 36
let N_MAPLIT = 37
let N_IMPORT = 38
let N_TYFN = 39
let N_TYOPT = 40
let N_NONELIT = 41
let N_SOME = 42
let N_FNLIT = 43     // fn(x: int) -> int { ... } -- closure literal
let N_INLINE = 44    // produced by the inliner: inlined body stmts, slot = result temp
let N_IRET = 45      // an inlined body's return: result -> rax, jmp to the inline end
let N_IMPL = 46      // impl Type { methods } -- desugared into plain functions
let N_INTERFACE = 47 // interface Name { method signatures }
let N_IBOX = 48      // box a struct into an interface value {vtable, data}; refi=iface, op=vtable idx
let N_EXTERN = 49    // extern fn f(...) from "dll" -- desugared into a lazily-resolving wrapper
let N_IFEXPR = 50    // if c { a } else { b } as a value: kids = [cond, a, b]
let N_LETEXPR = 51   // a hidden local, then a value: kids = [N_DECL, value]
let N_MATCH = 52     // match statement (parse only; lowered by the checker): kids = [subject, N_ARM...]
let N_MATCHEXPR = 53 // match as a value (parse only)
let N_ARM = 54       // one match arm: kids = [body, patterns...]; mut = the else arm
let N_FOR2 = 55      // for a, b in xs (parse only): name = a; kids = [xs, body, N_TYNAME b]
let N_IFLET = 56     // if let name = optional (parse only): kids = [optional, then, else or N_NONE]
let N_DEFER = 57     // defer block (parse only; lowered before checking): kids = [block]
let N_TYALIAS = 58   // type Name = T (top level): kids = [type]
let N_TYTUPLE = 59   // (A, B) tuple type: kids = element types
let N_TUPLE = 60     // (a, b) tuple literal: kids = elements; checked into an N_SLIT
let N_GROUP = 61     // several statements from one (let (a, b) = t); spliced by the parser
let N_IS = 62        // x is Member (parse only): kids = [value, N_ID or N_MEMBER]
let N_PRIVATE = 63   // private <declaration> (parse only; scope_module renames it): kids = [decl]
let N_TEST = 64      // test "name" { ... } (parse only): name = the test's name, kids = [block]

// ---------------- type kinds & table ----------------
let K_INT = 0
let K_FLOAT = 1
let K_BOOL = 2
let K_STR = 3
let K_VOID = 4
let K_LIST = 5
let K_STRUCT = 6
let K_ENUM = 7
let K_MAP = 8      // ty_el = value type, ty_sd = key type
let K_FN = 9       // ty_sd = index into g_fnsigs
let K_OPT = 10     // ty_el = the wrapped type; represented as a pointer, 0 = none
let K_NONE = 11    // the type of the `none` literal; fits any optional
let K_IFACE = 12   // interface; ty_sd = index into g_ifaces. A value is a {vtable, data} cell.
let K_U8 = 13      // element of a packed [u8]; reads as int. Not a type of its own.
let K_F32 = 14     // element of a packed [f32]; reads as float.

// types are indices into these parallel tables
var ty_kind: [int] = []
var ty_el: [int] = []
var ty_sd: [int] = []
ty_kind.push(K_INT)
ty_el.push(0)
ty_sd.push(0)
