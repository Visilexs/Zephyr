    p.push("    if x == 0.0 or is_inf(x) or is_nan(x) \{ return x \}\n")
    p.push("    let magnitude = fabs(x)\n")
    p.push("    var estimate = fexp(fln(magnitude) / 3.0)\n")
    p.push("    for i in 0..3 \{ estimate = (2.0 * estimate + (magnitude / estimate) / estimate) / 3.0 \}\n")
    p.push("    if x < 0.0 \{ return 0.0 - estimate \}\n")
    p.push("    return estimate\n")
    p.push("\}\n")
    p.push("\n")
    return p.join()
}
fn __emb_4() -> str {
    var p: [str] = []
