// ================= optimizing tier (-O2 / the JIT's top tier) =================
//
// A second backend for hot code. The baseline generator walks the checked AST
// straight to accumulator-style x86: every value passes through rax, only six
// ints and six floats per function get a register, and nothing is known about
// a value beyond its type. This tier lowers the same checked AST into SSA form,
// optimizes it, allocates registers across the whole region, and emits x86
// through the same assembler.
//
// Unit of compilation: a REGION. Either a whole function, or one hot loop
// statement that is outlined into its own function and called from the
// baseline code of its parent. An outlined loop receives the parent's frame
// pointer in rcx and reads and writes the parent's slots in place; the parent
// keeps those slots out of registers (see optimizerExcludeSlots) so both
// sides agree where every variable lives. This is also the unit on-stack
// replacement uses: a loop header with every variable in a known frame slot.
//
// Anything the tier does not handle makes it back out (optimizerBail), and
// the baseline code is used instead, so correctness never depends on how much
// of the language this file covers.
//
// Reference-counting contract, as the baseline's (see isReferenceType): values
// of reference type are only ever BORROWED here. A reference is PINNED when
// something outside the region keeps it alive for the region's whole run -- a
// parameter, or a slot of the parent frame -- and merely borrowed when it was
// loaded out of a container or a global, which a callee could release. The
// tier never stores a reference anywhere the baseline would own it, never
// keeps an unpinned one live across a call, never passes one to a call, and
// never calls a function returning one, so it performs no count operations
// and the baseline's ownership invariants hold across the boundary.

// ---- IR opcodes ----
let irConstant = 1              // immediate
let irParameter = 2             // immediate = parameter index (whole-function) or 0 = parent frame (region)
let irPhi = 3                   // operands align with the block's predecessors
let irAdd = 4
let irSubtract = 5
let irMultiply = 6
let irDivide = 7
let irModulo = 8
let irBitAnd = 9
let irBitOr = 10
let irBitXor = 11
let irShiftLeft = 12
let irShiftRight = 13
let irNegate = 14
let irCompare = 15              // immediate = condition; int/bool operands -> 0/1
let irFloatAdd = 16
let irFloatSubtract = 17
let irFloatMultiply = 18
let irFloatDivide = 19
let irFloatNegate = 20
let irFloatCompare = 21         // immediate = condition; float operands -> 0/1
let irFloatSquareRoot = 22
let irFloatMinimum = 23
let irFloatMaximum = 24
let irFloatAbsolute = 25
let irIntegerToFloat = 26
let irFloatToInteger = 27       // truncating
let irFloatFromBits = 28        // GPR bits -> xmm
let irBitsFromFloat = 29        // xmm -> GPR bits
let irLoad = 30                 // [a + immediate]
let irLoadIndexed = 31          // [a + b*8 + immediate]
let irStore = 32                // [a + immediate] = b
let irStoreIndexed = 33         // [a + b*8 + immediate] = c
let irLoadGlobal = 34           // immediate = global index
let irStoreGlobal = 35          // immediate = global index, a = value
let irBoundsCheck = 36          // a = list, b = index; immediate = panic string index
let irZeroCheck = 37            // a = divisor; immediate = panic string index
let irCall = 38                 // immediate = functionDefinitions index; operands = arguments
let indirectStackCall = 1 << 40 // irCall immediate: operands[0] is the code address, the rest go on the stack
let irIntegerMinimum = 39
let irIntegerMaximum = 40
let irIntegerAbsolute = 41
let irLoadFrame = 42            // parent frame slot: a = frame, immediate = byte offset from rbp
let irStoreFrame = 43           // a = frame, b = value, immediate = byte offset
let irFloatLoad = 44            // float loads/stores (movsd), same addressing as the int ones
let irFloatLoadIndexed = 45
let irFloatStore = 46
let irFloatStoreIndexed = 47
let irFloatLoadGlobal = 48
let irFloatStoreGlobal = 49
let irFloatLoadFrame = 50
let irFloatStoreFrame = 51
let irFloatConstant = 52        // immediate = bits
let irCopy = 53                 // a (optimizations forward it away; never emitted)
let irDataAddress = 54          // immediate = data string index: lea of a string literal
let irDividePowerOfTwo = 55     // a / 2^immediate, rounding toward zero like idiv
let irModuloPowerOfTwo = 56     // a % 2^immediate, sign of the dividend like idiv
let irListLength = 57           // [a + 0]: a list's or string's length; immediate 1 = a string's, which never changes
let irListData = 58             // [a + 16]: a list's element array. Only runtime calls change it.
let irReciprocal = 59           // floor((2^64 - 1) / a) for a > 0, else 0: the multiplier for irDivideByInvariant
let irDivideByInvariant = 60    // a / b with c = irReciprocal(b): multiply-high plus one correction step
let irModuloByInvariant = 61
let irDivideByConstant = 62     // a / immediate, immediate > 1 and not a power of two
let irModuloByConstant = 63
let irLoadRaw64 = 65             // load64(a + immediate) and friends: raw memory, zero-extended
let irLoadRaw32 = 66
let irLoadRaw16 = 67
let irLoadRaw8 = 68
let irStoreRaw64 = 69            // store64(a + immediate, b) and friends
let irStoreRaw32 = 70
let irStoreRaw8 = 71
let irSymbolAddress = 72         // lea of regionSymbols[immediate]
let irLoadByte = 64              // zero-extended byte [a + b + 8]: a string's bytes (strings never change)
// terminators
let irJump = 100                // successors[0]
let irBranch = 101              // a != 0 -> successors[0] else successors[1]
let irBranchCompare = 102       // a cond b -> successors[0] else successors[1]; immediate = condition
let irBranchFloatCompare = 103
let irReturn = 104              // operands = [value] or []
let irUnreachable = 105         // panic with a fixed text: immediate = data string index
let irPanicAt = 106             // panic: a = message string, immediate = site string index

// conditions (shared by compares and branches)
let conditionEqual = 0
let conditionNotEqual = 1
let conditionLess = 2
let conditionLessOrEqual = 3
let conditionGreater = 4
let conditionGreaterOrEqual = 5
let conditionBelowOrEqual = 6      // unsigned
let conditionAbove = 7
let conditionBelow = 8
let conditionAboveOrEqual = 9

// value classes
let classInteger = 0            // int, bool, enum, pointer: a GPR
let classFloat = 1              // float: an xmm register

let identifierKindTemporary = 0 - 1        // a variable the lowering made up (join values, hidden indices)

// ---- IR storage (one region at a time) ----
var irOpcodes: [int] = []
var irClasses: [int] = []
var irOperands: [[int]] = []
var irImmediates: [int] = []
var irBlockOf: [int] = []
var irBorrowed: [bool] = []     // an unpinned reference: must not live across a call
var irReferenceArguments: [int] = []       // irCall: bit i set = argument i is a reference
var irUseCounts: [int] = []

var blockInstructions: [[int]] = []
var blockPredecessors: [[int]] = []
var blockSuccessors: [[int]] = []
var blockSealed: [bool] = []
var blockTerminated: [bool] = []
var blockLoopDepth: [int] = []
var loopHeaders: [int] = []                 // findLoops: one header per natural loop
var loopBlockSets: [[bool]] = []
var loopPreheaders: [int] = []

// SSA construction (Braun et al.): current definition of each variable per block
var variableKeys: [str: int] = [:]        // "l5" / "p2" / "g7" / "t3" -> variable number
var variableClasses: [int] = []
var variableHomeKind: [int] = []           // identifierKindLocal / Parameter / Global / Temporary
var variableHomeIndex: [int] = []
var variableWritten: [bool] = []
var variableIsReference: [bool] = []
var variableDeclaredInside: [bool] = []    // declared by the region itself (never written back if a reference)
var currentDefinitions: [[int]] = []       // [block][variable] -> value, -1 = none
var incompletePhis: [[int]] = []           // [block] -> phi values awaiting sealing
var incompletePhiVariables: [[int]] = []
var temporaryVariableCount = 0

var optimizerBailed = false
var optimizerBailReason = ""
var currentIrBlock = 0
var currentLoopDepth = 0
var regionIsFunction = true                // whole function, or an outlined loop
var regionFunctionIndex = 0 - 1
var regionEnvironmentValue = 0 - 1         // a closure body's env: its captures, by value, never reassigned
var regionParentSlotCount = 0
var regionParentParameterCount = 0
var regionParentRegisterCall = false
var regionFrameValue = 0 - 1               // the parent frame pointer (outlined loops)
var regionSymbols: [str] = []        // irSymbolAddress immediate i, or irCall immediate -1 - i (a Win64 import)
var regionGlobalsInMemory = false          // a callee may read or write globals: keep them in memory
var regionBreakTargets: [int] = []
var regionContinueTargets: [int] = []
var regionInlineEnds: [int] = []
var regionInlineSlots: [int] = []
var regionInlineTypes: [int] = []
var regionInlineScopeDepths: [int] = []     // ownedScopes an inline return leaves
var regionInlineTemporaryMarks: [int] = []  // pendingTemporaries an inline return releases
var regionReturnBlock = 0
var regionReturnVariable = 0 - 1
var regionReturnType = 4
var regionReturnScopeDepth = 0              // ownedScopes a return leaves: the region's, or an inlined body's
var regionReturnTemporaryMark = 0           // pendingTemporaries a return releases
var inliningEnabled = true
var inlinedCallCount = 0                    // calls this lowering inlined: a failed region retries without
var inlineStack: [int] = []                 // functions being inlined, innermost last
var inlineKeyPrefix = ""                    // variable-key namespace of the body being inlined
var inlineInstanceCount = 0
var variableIsInlineResult: [bool] = []     // the frontend's slot for an inlined call's result
var variableOwnsValue: [bool] = []          // an owned reference local (decided when the variable is made)
// closure literals this region made: the cell, its function, the values its env holds
var knownClosureCells: [int] = []
var knownClosureFunctions: [int] = []
var knownClosureCaptures: [[int]] = []
var variableKnownClosure: [int] = []        // an inlined parameter bound to a known closure (index above), else -1
var inlineCaptureValues: [int] = []
// spilled groups a loop reads but never writes, held in a register the whole
// loop leaves free: loaded once at the end of the preheader, read from the
// register in the loop's blocks. The slot stays current, so any other block reads it.
var blockPromotedGroups: [[int]] = []
var blockPromotedRegisters: [[int]] = []
var preheaderLoadGroups: [[int]] = []
var preheaderLoadRegisters: [[int]] = []
var emittingBlock = 0 - 1
var nonFreeingCalls: [int] = []             // vtable calls whose every implementation never frees; early releases of plain structs
var nextStackCallCannotFree = false         // an inlined closure body's captures
struct InlineFrame {
    prefix: str, ownedSlots: [int: bool], sourceMakesCalls: bool, returnBlock: int, returnVariable: int,
    returnType: int, returnScopeDepth: int, returnTemporaryMark: int, captureValues: [int]
}
var inlineFrames: [InlineFrame] = []       // what an inlined body saved of its caller's lowering state
var parameterValues: [int] = []

// ---- ownership: a fresh reference carries one count the region must hand on or drop ----
var pendingTemporaries: [int] = []         // fresh values the current statement has yet to consume or release
var movableVariables: [int] = []              // owned locals the current statement may hand their count over (findMovableVariables)
var movableLoweringDepth = 0                    // inline, loop and scope depth at that statement: deeper code runs repeatedly or conditionally
var earlyReleaseVariables: [int] = []         // owned locals the current list store releases once its source is lowered
var ownedLocalSlots: [int: bool] = [:]     // reference locals that own their value
var ownedScopes: [[int]] = []              // per open block: the owned variables it declared, in order
var regionLoopScopeDepths: [int] = []      // parallel to regionBreakTargets: ownedScopes.len() at the loop
var regionLoopTemporaryMarks: [int] = []   // parallel to regionBreakTargets: pendingTemporaries.len() at the loop
var irFromGlobal: [bool] = []              // a global's value: runtime primitives never reassign a global
var irScalarCandidates: [bool] = []        // a struct literal's allocation whose fields hold no references
var regionSourceMakesCalls = false         // the region's source calls something: loads may be freed under a local

fn optimizerBail(reason: str) {
    if not optimizerBailed {
        optimizerBailed = true
        optimizerBailReason = reason
    }
}

fn resetIr() {
    var emptyIntegers: [int] = []
    irOpcodes = [0]                          // value 0 is a placeholder: operands never name it
    irClasses = [0]
    irOperands = [emptyIntegers]
    irImmediates = [0]
    irBlockOf = [0]
    irBorrowed = [false]
    irFromGlobal = [false]
    irScalarCandidates = [false]
    irReferenceArguments = [0]
    irUseCounts = [0]
    var noLists: [[int]] = []
    blockInstructions = noLists
    var noPredecessors: [[int]] = []
    blockPredecessors = noPredecessors
    var noSuccessors: [[int]] = []
    blockSuccessors = noSuccessors
    var noSealed: [bool] = []
    blockSealed = noSealed
    var noTerminated: [bool] = []
    blockTerminated = noTerminated
    var noDepths: [int] = []
    blockLoopDepth = noDepths
    var noKeys: [str: int] = [:]
    variableKeys = noKeys
    var noClasses: [int] = []
    variableClasses = noClasses
    var noKinds: [int] = []
    variableHomeKind = noKinds
    var noIndices: [int] = []
    variableHomeIndex = noIndices
    var noWritten: [bool] = []
    variableWritten = noWritten
    var noReferences: [bool] = []
    variableIsReference = noReferences
    var noDeclared: [bool] = []
    variableDeclaredInside = noDeclared
    var noDefinitions: [[int]] = []
    currentDefinitions = noDefinitions
    var noPhis: [[int]] = []
    incompletePhis = noPhis
    var noPhiVariables: [[int]] = []
    incompletePhiVariables = noPhiVariables
    temporaryVariableCount = 0
    optimizerBailed = false
    optimizerBailReason = ""
    currentLoopDepth = 0
    var noBreaks: [int] = []
    regionBreakTargets = noBreaks
    var noContinues: [int] = []
    regionContinueTargets = noContinues
    var noEnds: [int] = []
    regionInlineEnds = noEnds
    var noSlots: [int] = []
    regionInlineSlots = noSlots
    var noTypes: [int] = []
    regionInlineTypes = noTypes
    var noInlineDepths: [int] = []
    regionInlineScopeDepths = noInlineDepths
    var noInlineMarks: [int] = []
    regionInlineTemporaryMarks = noInlineMarks
    regionFrameValue = 0 - 1
    regionReturnVariable = 0 - 1
    regionReturnScopeDepth = 0
    regionReturnTemporaryMark = 0
    inlinedCallCount = 0
    var noInlines: [int] = []
    inlineStack = noInlines
    var noFrames: [InlineFrame] = []
    inlineFrames = noFrames
    inlineKeyPrefix = ""
    var noOwnership: [bool] = []
    variableOwnsValue = noOwnership
    var noInlineResults: [bool] = []
    variableIsInlineResult = noInlineResults
    var noCells: [int] = []
    knownClosureCells = noCells
    var noClosureFunctions: [int] = []
    knownClosureFunctions = noClosureFunctions
    var noClosureCaptures: [[int]] = []
    knownClosureCaptures = noClosureCaptures
    var noKnownClosures: [int] = []
    variableKnownClosure = noKnownClosures
    var noCaptureValues: [int] = []
    inlineCaptureValues = noCaptureValues
    var noPreheaderLoads: [[int]] = []
    preheaderLoadGroups = noPreheaderLoads
    var noPromotedGroups: [[int]] = []
    blockPromotedGroups = noPromotedGroups
    var noNonFreeingCalls: [int] = []
    nonFreeingCalls = noNonFreeingCalls
    var noParameters: [int] = []
    parameterValues = noParameters
    var noPending: [int] = []
    pendingTemporaries = noPending
    var noOwnedSlots: [int: bool] = [:]
    ownedLocalSlots = noOwnedSlots
    var noScopes: [[int]] = []
    ownedScopes = noScopes
    var noScopeDepths: [int] = []
    regionLoopScopeDepths = noScopeDepths
    var noTemporaryMarks: [int] = []
    regionLoopTemporaryMarks = noTemporaryMarks
}

fn newBlock() -> int {
    var noIntegers: [int] = []
    blockInstructions.push(noIntegers)
    var noPredecessors: [int] = []
    blockPredecessors.push(noPredecessors)
    var noSuccessors: [int] = []
    blockSuccessors.push(noSuccessors)
    blockSealed.push(false)
    blockTerminated.push(false)
    blockLoopDepth.push(currentLoopDepth)
    var definitions: [int] = []
    for i in 0..variableClasses.len() { definitions.push(0 - 1) }
    currentDefinitions.push(definitions)
    var phis: [int] = []
    incompletePhis.push(phis)
    var phiVariables: [int] = []
    incompletePhiVariables.push(phiVariables)
    return blockInstructions.len() - 1
}

// append an instruction to a block (before its terminator if it has one)
fn addInstruction(block: int, opcode: int, valueClass: int, operands: [int], immediate: int) -> int {
    irOpcodes.push(opcode)
    irClasses.push(valueClass)
    irOperands.push(operands)
    irImmediates.push(immediate)
    irBlockOf.push(block)
    irBorrowed.push(false)
    irFromGlobal.push(false)
    irScalarCandidates.push(false)
    irReferenceArguments.push(0)
    irUseCounts.push(0)
    let value = irOpcodes.len() - 1
    if opcode == irPhi {
        // phis go first, ahead of every ordinary instruction
        let instructions = blockInstructions[block]
        var position = 0
        while position < instructions.len() and irOpcodes[instructions[position]] == irPhi { position += 1 }
        var reordered: [int] = []
        for i in 0..position { reordered.push(instructions[i]) }
        reordered.push(value)
        for i in position..instructions.len() { reordered.push(instructions[i]) }
        blockInstructions[block] = reordered
    } else if blockTerminated[block] {
        let instructions = blockInstructions[block]
        let terminator = instructions.pop()
        instructions.push(value)
        instructions.push(terminator)
    } else {
        blockInstructions[block].push(value)
    }
    return value
}

// code after a return/break/panic: give it a block nobody reaches
fn ensureOpenBlock() {
    if blockTerminated[currentIrBlock] {
        currentIrBlock = newBlock()
        blockSealed[currentIrBlock] = true
    }
}

fn emitIr(opcode: int, valueClass: int, operands: [int], immediate: int) -> int {
    ensureOpenBlock()
    return addInstruction(currentIrBlock, opcode, valueClass, operands, immediate)
}

fn emitIr0(opcode: int, valueClass: int, immediate: int) -> int {
    var noOperands: [int] = []
    return emitIr(opcode, valueClass, noOperands, immediate)
}
fn emitIr1(opcode: int, valueClass: int, first: int, immediate: int) -> int {
    return emitIr(opcode, valueClass, [first], immediate)
}
fn emitIr2(opcode: int, valueClass: int, first: int, second: int, immediate: int) -> int {
    return emitIr(opcode, valueClass, [first, second], immediate)
}
fn integerConstant(value: int) -> int { return emitIr0(irConstant, classInteger, value) }

fn addEdge(from: int, to: int) {
    blockSuccessors[from].push(to)
    blockPredecessors[to].push(from)
}

fn terminate(opcode: int, operands: [int], immediate: int, successors: [int]) {
    if blockTerminated[currentIrBlock] { return }       // already left (break/return): nothing to add
    let terminator = addInstruction(currentIrBlock, opcode, classInteger, operands, immediate)
    blockTerminated[currentIrBlock] = true
    for successor in successors { addEdge(currentIrBlock, successor) }
}

fn jumpTo(target: int) {
    var noOperands: [int] = []
    terminate(irJump, noOperands, 0, [target])
}

// ---- SSA variables ----
fn variableForKey(key: str, kind: int, index: int, valueClass: int, isReference: bool) -> int {
    if variableKeys.has(key) {
        let existing = variableKeys[key]
        // the inliner can type one hidden slot two ways; a slot read as both an
        // int and a float is not something registers can model
        if variableClasses[existing] != valueClass { optimizerBail("slot {key} used as int and float") }
        if isReference { variableIsReference[existing] = true }
        return existing
    }
    let number = variableClasses.len()
    variableKeys[key] = number
    variableClasses.push(valueClass)
    variableHomeKind.push(kind)
    variableHomeIndex.push(index)
    variableWritten.push(false)
    variableIsReference.push(isReference)
    variableDeclaredInside.push(false)
    variableOwnsValue.push(false)
    variableIsInlineResult.push(false)
    variableKnownClosure.push(0 - 1)
    for block in 0..currentDefinitions.len() { currentDefinitions[block].push(0 - 1) }
    return number
}

fn variableNumber(kind: int, index: int, valueClass: int, isReference: bool) -> int {
    var key = "l{index}"
    if kind == identifierKindParameter { key = "p{index}" }
    else if kind == identifierKindGlobal { key = "g{index}" }
    if inlineKeyPrefix != "" and kind != identifierKindGlobal {
        // an inlined body's own variables: region-private, never written back
        let isNew = not variableKeys.has(inlineKeyPrefix + key)
        let variable = variableForKey(inlineKeyPrefix + key, identifierKindTemporary, index, valueClass, isReference)
        if isNew {
            variableDeclaredInside[variable] = true
            variableOwnsValue[variable] = kind == identifierKindLocal and ownedLocalSlots.has(index)
        }
        return variable
    }
    let isNew = not variableKeys.has(key)
    let variable = variableForKey(key, kind, index, valueClass, isReference)
    if isNew { variableOwnsValue[variable] = kind == identifierKindLocal and ownedLocalSlots.has(index) }
    return variable
}

fn variableForSlot(kind: int, index: int, typeIndex: int) -> int {
    return variableNumber(kind, index, classOfType(typeIndex), isReferenceType(typeIndex))
}

fn temporaryVariable(valueClass: int, isReference: bool) -> int {
    temporaryVariableCount += 1
    let variable = variableForKey("t{temporaryVariableCount}", identifierKindTemporary, 0, valueClass, isReference)
    variableDeclaredInside[variable] = true
    return variable
}

fn writeVariable(variable: int, block: int, value: int) {
    currentDefinitions[block][variable] = value
}

fn readVariable(variable: int, block: int) -> int {
    let known = currentDefinitions[block][variable]
    if known >= 0 { return known }
    return readVariableRecursive(variable, block)
}

fn readVariableRecursive(variable: int, block: int) -> int {
    var value = 0
    var noOperands: [int] = []
    if not blockSealed[block] {
        value = addInstruction(block, irPhi, variableClasses[variable], noOperands, 0)
        incompletePhis[block].push(value)
        incompletePhiVariables[block].push(variable)
    } else if blockPredecessors[block].len() == 0 {
        value = loadVariableHome(variable, block)
    } else if blockPredecessors[block].len() == 1 {
        value = readVariable(variable, blockPredecessors[block][0])
    } else {
        value = addInstruction(block, irPhi, variableClasses[variable], noOperands, 0)
        writeVariable(variable, block, value)
        addPhiOperands(variable, value)
    }
    writeVariable(variable, block, value)
    return value
}

fn addPhiOperands(variable: int, phi: int) {
    let block = irBlockOf[phi]
    var operands: [int] = []
    for predecessor in blockPredecessors[block] { operands.push(readVariable(variable, predecessor)) }
    irOperands[phi] = operands
}

fn sealBlock(block: int) {
    if blockSealed[block] { return }
    for i in 0..incompletePhis[block].len() { addPhiOperands(incompletePhiVariables[block][i], incompletePhis[block][i]) }
    var noOperands: [int] = []
    incompletePhis[block] = noOperands
    var noVariables: [int] = []
    incompletePhiVariables[block] = noVariables
    blockSealed[block] = true
}

// The value a variable has on entry to the region: a parameter, a slot of the
// parent frame, or a global. Locals of a whole-function region have no value
// before their declaration; a phi may still ask (a loop-header phi for a
// variable first declared inside the loop), and gets a zero it never uses.
fn loadVariableHome(variable: int, block: int) -> int {
    let kind = variableHomeKind[variable]
    let index = variableHomeIndex[variable]
    let valueClass = variableClasses[variable]
    var noOperands: [int] = []
    var value = 0
    if kind == identifierKindGlobal {
        if valueClass == classFloat { value = addInstruction(block, irFloatLoadGlobal, classFloat, noOperands, index) }
        else { value = addInstruction(block, irLoadGlobal, classInteger, noOperands, index) }
        if variableIsReference[variable] and regionGlobalsInMemory and (index >= globalIsMutable.len() or globalIsMutable[index]) {
            irBorrowed[value] = true              // a callee may reassign the global (a `let` it never can)
            irFromGlobal[value] = true
        }
    } else if kind == identifierKindTemporary or (regionIsFunction and kind == identifierKindLocal) {
        if valueClass == classFloat { value = addInstruction(block, irFloatConstant, classFloat, noOperands, 0) }
        else { value = addInstruction(block, irConstant, classInteger, noOperands, 0) }
    } else if regionIsFunction {
        value = parameterValues[index]
    } else {
        let offset = parentSlotOffset(kind, index)
        if valueClass == classFloat { value = addInstruction(block, irFloatLoadFrame, classFloat, [regionFrameValue], offset) }
        else { value = addInstruction(block, irLoadFrame, classInteger, [regionFrameValue], offset) }
    }
    return value
}

// byte offset of a parent-frame variable from the parent's rbp
fn parentSlotOffset(kind: int, index: int) -> int {
    if kind == identifierKindLocal { return 0 - (16 + 8 * index) }
    if regionParentRegisterCall { return 0 - (16 + 8 * regionParentSlotCount + 8 * index) }
    return 16 + 8 * (regionParentParameterCount - 1 - index)
}

fn classOfType(typeIndex: int) -> int {
    if typeKinds[typeIndex] == kindFloat { return classFloat }
    return classInteger
}

// ================= lowering: checked AST -> SSA =================

fn panicStringIndex(expression: Node, message: str) -> int { return addDataString(panicSite(expression) + message) }

fn conditionForToken(operator: int) -> int {
    if operator == tokenEquals { return conditionEqual }
    if operator == tokenNotEquals { return conditionNotEqual }
    if operator == tokenLessThan { return conditionLess }
    if operator == tokenLessOrEqual { return conditionLessOrEqual }
    if operator == tokenGreaterThan { return conditionGreater }
    if operator == tokenGreaterOrEqual { return conditionGreaterOrEqual }
    return 0 - 1
}

fn integerOpcodeForToken(operator: int) -> int {
    if operator == tokenPlus { return irAdd }
    if operator == tokenMinus { return irSubtract }
    if operator == tokenStar { return irMultiply }
    if operator == tokenSlash { return irDivide }
    if operator == tokenPercent { return irModulo }
    if operator == tokenAmpersand { return irBitAnd }
    if operator == tokenPipe { return irBitOr }
    if operator == tokenCaret { return irBitXor }
    if operator == tokenShiftLeft { return irShiftLeft }
    if operator == tokenShiftRight { return irShiftRight }
    return 0 - 1
}

fn floatOpcodeForToken(operator: int) -> int {
    if operator == tokenPlus { return irFloatAdd }
    if operator == tokenMinus { return irFloatSubtract }
    if operator == tokenStar { return irFloatMultiply }
    if operator == tokenSlash { return irFloatDivide }
    return 0 - 1
}

fn identifierVariable(expression: Node) -> int {
    let kind = expression.auxiliary
    if kind != identifierKindLocal and kind != identifierKindParameter and kind != identifierKindGlobal {
        optimizerBail("identifier kind {kind}")
        return 0
    }
    return variableForSlot(kind, expression.slot, expression.typeIndex)
}

fn readVariableValue(variable: int) -> int {
    if variableHomeKind[variable] == identifierKindGlobal and regionGlobalsInMemory {
        ensureOpenBlock()
        return loadVariableHome(variable, currentIrBlock)
    }
    ensureOpenBlock()
    return readVariable(variable, currentIrBlock)
}

fn writeVariableValue(variable: int, value: int) {
    if irClasses[value] != variableClasses[variable] {
        optimizerBail("store of the wrong class")
        return
    }
    if variableHomeKind[variable] == identifierKindGlobal {
        if variableIsReference[variable] {
            optimizerBail("reference store to a global")
            return
        }
        if regionGlobalsInMemory {
            if variableClasses[variable] == classFloat { let stored = emitIr1(irFloatStoreGlobal, classFloat, value, variableHomeIndex[variable]) }
            else { let stored = emitIr1(irStoreGlobal, classInteger, value, variableHomeIndex[variable]) }
            return
        }
    }
    ensureOpenBlock()
    writeVariable(variable, currentIrBlock, value)
    variableWritten[variable] = true
}

// a region-declared variable: a reference one is SSA-only, never written back
fn declareVariable(variable: int, value: int) {
    if variableHomeKind[variable] != identifierKindGlobal { variableDeclaredInside[variable] = true }
    writeVariableValue(variable, value)
}

fn assignVariable(target: Node, value: int) {
    let variable = identifierVariable(target)
    if optimizerBailed { return }
    let isMemoryGlobal = variableHomeKind[variable] == identifierKindGlobal and regionGlobalsInMemory
    if variableIsReference[variable] and not regionIsFunction and not variableDeclaredInside[variable] and not isMemoryGlobal {
        optimizerBail("reference store to a parent slot")
        return
    }
    storeVariable(variable, value, false)
}

fn lowerBlock(block: Node) {
    var noVariables: [int] = []
    ownedScopes.push(noVariables)
    let outerMovable = movableVariables
    let outerMoveDepth = movableLoweringDepth
    let lastMentions = lastMentionIndices(block.children)
    var declarations: [int] = []
    for i in 0..block.children.len() {
        let statement = block.children[i]
        if statement.nodeKind == nodeDeclaration and statement.auxiliary == identifierKindLocal and isReferenceType(statement.typeIndex) { declarations.push(i) }
    }
    for i in 0..block.children.len() {
        if optimizerBailed { return }
        var dying: [int] = []
        for declarationIndex in declarations {
            if declarationIndex < i and lastMentionOf(lastMentions, block.children[declarationIndex].slot, declarationIndex) == i { dying.push(declarationIndex) }
        }
        earlyReleaseVariables = findEarlyReleases(block.children, i, dying)
        movableVariables = findMovableVariables(block.children, i, dying)
        movableLoweringDepth = movingDepth()
        lowerStatement(block.children[i])
    }
    movableVariables = outerMovable
    movableLoweringDepth = outerMoveDepth
    if not blockTerminated[currentIrBlock] { releaseScopesFrom(ownedScopes.len() - 1) }
    let closedScope = ownedScopes.pop()
}

// Owned plain-struct locals of this block whose last use is the source of
// statement `index`, a list element store: released once the source is
// lowered, so an element they were read from can be overwritten in place.
// `dying`: declarations whose last mention is that statement.
fn findEarlyReleases(statements: [Node], index: int, dying: [int]) -> [int] {
    var found: [int] = []
    if dying.len() == 0 { return found }
    let statement = statements[index]
    if statement.nodeKind != nodeAssign or statement.children[0].nodeKind != nodeIndex { return found }
    let target = statement.children[0]
    if typeKinds[target.children[0].typeIndex] == kindMap or not isPlainStruct(target.typeIndex) { return found }
    let scope = ownedScopes[ownedScopes.len() - 1]
    for declarationIndex in dying {
        let declaration = statements[declarationIndex]
        if not isPlainStruct(declaration.typeIndex) { continue }
        let slot = declaration.slot
        let variable = variableForSlot(identifierKindLocal, slot, declaration.typeIndex)
        if listContains(scope, variable) and mentionsSlot(statement.children[1], slot) and not mentionsSlot(target, slot) { found.push(variable) }
    }
    return found
}

// Owned locals of this block that statement `index` mentions last, once and
// on its straight-line path: a consumer taking their value takes the local's
// own count (takeOwnership).
fn findMovableVariables(statements: [Node], index: int, dying: [int]) -> [int] {
    var found: [int] = []
    let scope = ownedScopes[ownedScopes.len() - 1]
    for declarationIndex in dying {
        let declaration = statements[declarationIndex]
        let slot = declaration.slot
        let variable = variableForSlot(identifierKindLocal, slot, declaration.typeIndex)
        if listContains(scope, variable) and countStraightMentions(statements[index], slot, true) == 1 { found.push(variable) }
    }
    return found
}

// slot -> the last statement mentioning it; key -1: the last one holding a
// closure or an outlined loop, which may mention any slot
fn lastMentionIndices(statements: [Node]) -> [int: int] {
    var lastMentions: [int: int] = [:]
    for i in 0..statements.len() { markMentions(statements[i], i, lastMentions) }
    return lastMentions
}

fn markMentions(node: Node, index: int, lastMentions: [int: int]) {
    let kind = node.nodeKind
    if kind == nodeFunctionLiteral or kind == nodeOutlinedLoop {
        lastMentions[0 - 1] = index
        return
    }
    if kind == nodeIdentifier { lastMentions[node.slot] = index }
    for child in node.children { markMentions(child, index, lastMentions) }
}

fn lastMentionOf(lastMentions: [int: int], slot: int, declarationIndex: int) -> int {
    var last = declarationIndex
    if lastMentions.has(slot) { last = lastMentions[slot] }
    if lastMentions.has(0 - 1) and lastMentions[0 - 1] > last { last = lastMentions[0 - 1] }
    return last
}

// mentions of a local slot; one off the straight-line path (a branch, a loop,
// short-circuit, an inlined body, a closure) counts as two
fn countStraightMentions(node: Node, slot: int, straight: bool) -> int {
    let kind = node.nodeKind
    if kind == nodeFunctionLiteral or kind == nodeOutlinedLoop { return 2 }
    if kind == nodeIdentifier and node.slot == slot {
        if straight { return 1 }
        return 2
    }
    let childStraight = straight and (kind == nodeExpressionStatement or kind == nodeDeclaration or kind == nodeAssign or kind == nodeCall or kind == nodeStructLiteral or kind == nodeFieldInitializer or kind == nodeList or kind == nodeIndex or kind == nodeMember or kind == nodeCast)
    var count = 0
    for child in node.children { count += countStraightMentions(child, slot, childStraight) }
    return count
}

// conservative: closures and outlined loops count as mentioning every slot
fn mentionsSlot(node: Node, slot: int) -> bool {
    let kind = node.nodeKind
    if kind == nodeFunctionLiteral or kind == nodeOutlinedLoop { return true }
    if kind == nodeIdentifier and node.slot == slot { return true }
    for child in node.children {
        if mentionsSlot(child, slot) { return true }
    }
    return false
}

// release the variables findEarlyReleases chose; their scope forgets them
fn releaseEarly(variables: [int]) {
    if variables.len() == 0 { return }
    let scopeIndex = ownedScopes.len() - 1
    var kept: [int] = []
    for variable in ownedScopes[scopeIndex] {
        if listContains(variables, variable) {
            // frees at most the struct itself, whose last use is behind: a
            // borrowed pointer to it leans on some other holder's count
            nonFreeingCalls.push(lowerRuntimeCall("runtimeReleaseReference", [readVariableValue(variable)]))
        }
        else { kept.push(variable) }
    }
    ownedScopes[scopeIndex] = kept
}

fn lowerExpression(expression: Node) -> int {
    if optimizerBailed { return 0 }
    let kind = expression.nodeKind
    if kind == nodeInteger or kind == nodeBoolean { return integerConstant(expression.integerValue) }
    if kind == nodeFloat { return emitIr0(irFloatConstant, classFloat, bits(expression.floatValue)) }
    if isPlainLiteral(expression) { return emitIr0(irDataAddress, classInteger, addDataString(expression.children[0].name)) }   // static: never freed, safe anywhere
    if kind == nodeIdentifier and expression.auxiliary == identifierKindCapture {
        if inlineStack.len() > 0 and functionDefinitions[inlineStack[inlineStack.len() - 1]].hasEnvironment {
            return inlineCaptureValues[expression.slot]           // the env holds it, the caller holds the env
        }
        if regionEnvironmentValue < 0 or inlineStack.len() > 0 {
            optimizerBail("capture outside its closure body")
            return 0
        }
        ensureOpenBlock()
        if typeKinds[expression.typeIndex] == kindFloat { return emitIr1(irFloatLoad, classFloat, regionEnvironmentValue, 8 * expression.slot) }
        return emitIr1(irLoad, classInteger, regionEnvironmentValue, 8 * expression.slot)       // the env keeps it alive
    }
    if kind == nodeIdentifier and expression.auxiliary == identifierKindFunction {
        return lowerClosureCell(functionDefinitions[expression.referenceIndex], integerConstant(0))
    }
    if kind == nodeIdentifier {
        let variable = identifierVariable(expression)
        if optimizerBailed { return 0 }
        return readVariableValue(variable)
    }
    if kind == nodeNegate {
        let operand = lowerExpression(expression.children[0])
        if typeKinds[expression.typeIndex] == kindFloat { return emitIr1(irFloatNegate, classFloat, operand, 0) }
        return emitIr1(irNegate, classInteger, operand, 0)
    }
    if kind == nodeNot {
        let operand = lowerExpression(expression.children[0])
        return emitIr2(irBitXor, classInteger, operand, integerConstant(1), 0)
    }
    if kind == nodeBinary { return lowerBinary(expression) }
    if kind == nodeCast {
        let castKind = expression.auxiliary
        if castKind == castKindToString {
            var formatted = lowerExpression(expression.children[0])
            if optimizerBailed { return 0 }
            if irClasses[formatted] == classFloat { formatted = emitIr1(irBitsFromFloat, classInteger, formatted, 0) }
            return ownedTemporary(lowerRuntimeCall("runtimeFormatTypedValue", [formatted, symbolAddress("__td{expression.slot}")]))
        }
        if castKind == castKindStringToInteger or castKind == castKindStringToFloat {
            let text = lowerContainer(expression.children[0], [])
            if optimizerBailed { return 0 }
            let site = emitIr0(irDataAddress, classInteger, addDataString(panicSite(expression)))
            if castKind == castKindStringToInteger { return lowerRuntimeCall("runtimeStringToInteger", [text, site]) }
            return emitIr1(irFloatFromBits, classFloat, lowerRuntimeCall("runtimeStringToFloat", [text, site]), 0)
        }
        if castKind != castKindNoOperation and castKind != castKindIntegerToFloat and castKind != castKindTruncate {
            optimizerBail("cast kind {castKind}")
            return 0
        }
        let operand = lowerExpression(expression.children[0])
        if optimizerBailed { return 0 }
        if castKind == castKindIntegerToFloat { return emitIr1(irIntegerToFloat, classFloat, operand, 0) }
        if castKind == castKindTruncate { return emitIr1(irFloatToInteger, classInteger, operand, 0) }
        if irClasses[operand] != classOfType(expression.typeIndex) { optimizerBail("reinterpreting cast") }
        return operand
    }
    if kind == nodeIfExpression {
        let result = temporaryVariable(classOfType(expression.typeIndex), isReferenceType(expression.typeIndex))
        let thenBlock = newBlock()
        let elseBlock = newBlock()
        let joinBlock = newBlock()
        lowerCondition(expression.children[0], thenBlock, elseBlock)
        sealBlock(thenBlock)
        sealBlock(elseBlock)
        currentIrBlock = thenBlock
        lowerBranchValue(result, expression.children[1])
        jumpTo(joinBlock)
        currentIrBlock = elseBlock
        lowerBranchValue(result, expression.children[2])
        jumpTo(joinBlock)
        sealBlock(joinBlock)
        currentIrBlock = joinBlock
        return readVariableValue(result)
    }
    if kind == nodeLetExpression {
        // The hidden local dies with the expression. Left to the enclosing
        // scope, it would be released after a join, where on the paths that
        // never ran this arm its SSA value is an older, already released one.
        var letVariables: [int] = []
        ownedScopes.push(letVariables)
        lowerStatement(expression.children[0])
        var value = lowerExpression(expression.children[1])
        if optimizerBailed { return 0 }
        if ownedScopes[ownedScopes.len() - 1].len() > 0 and isReferenceType(expression.typeIndex) and not isPendingTemporary(value) {
            value = ownedTemporary(emitRetain(value))       // it may lean on the hidden local
        }
        if not blockTerminated[currentIrBlock] { releaseScopesFrom(ownedScopes.len() - 1) }
        let closedScope = ownedScopes.pop()
        return value
    }
    if kind == nodeIndex { return lowerIndexRead(expression) }
    if kind == nodeMember {
        if typeKinds[expression.children[0].typeIndex] != kindStruct {
            optimizerBail("member of a non-struct")
            return 0
        }
        let base = lowerExpression(expression.children[0])
        if typeKinds[expression.typeIndex] == kindFloat { return emitIr1(irFloatLoad, classFloat, base, 8 * expression.slot) }
        let value = emitIr1(irLoad, classInteger, base, 8 * expression.slot)
        if isReferenceType(expression.typeIndex) { irBorrowed[value] = true }   // a callee may reassign the field
        return value
    }
    if kind == nodeCall { return lowerCall(expression) }
    if kind == nodeStructLiteral { return lowerStructLiteral(expression) }
    if kind == nodeList { return lowerListLiteral(expression) }
    if kind == nodeInterfaceBox { return lowerInterfaceBox(expression) }
    if kind == nodeSome { return lowerSome(expression) }
    if kind == nodeMapLiteral { return lowerMapLiteral(expression) }
    if kind == nodeNoneLiteral { return integerConstant(0) }            // no cell: counting skips it
    if kind == nodeFunctionLiteral { return lowerFunctionLiteral(expression) }
    if kind == nodeStringLiteral { return lowerInterpolation(expression) }
    optimizerBail("expression kind {kind}")
    return 0
}

// [k: v, ...]: a fresh map, each pair's counts moving into it
fn lowerMapLiteral(expression: Node) -> int {
    let mapType = expression.typeIndex
    var keyKind = integerConstant(mapKeyKind(mapType))
    if mapKeyKind(mapType) == 2 { keyKind = symbolAddress("__td{typeDescriptorIndex(typeDefinitionIds[mapType])}") }
    let map = ownedTemporary(lowerRuntimeCall("runtimeNewDescribedMap", [keyKind, symbolAddress("__dt{mapShapeDescriptor(mapType)}")]))
    var keyIndex = 0
    while keyIndex < expression.children.len() {
        var key = lowerExpression(expression.children[keyIndex])
        if optimizerBailed { return 0 }
        if isReferenceType(expression.children[keyIndex].typeIndex) { key = takeOwnership(key) }
        if irClasses[key] == classFloat { key = emitIr1(irBitsFromFloat, classInteger, key, 0) }
        var value = lowerExpression(expression.children[keyIndex + 1])
        if optimizerBailed { return 0 }
        if isReferenceType(expression.children[keyIndex + 1].typeIndex) { value = takeOwnership(value) }
        if irClasses[value] == classFloat { value = emitIr1(irBitsFromFloat, classInteger, value, 0) }
        let stored = lowerRuntimeCall(mapSetterFunction(mapType), [map, key, value])
        keyIndex += 2
    }
    return map
}

// some(x): a one-word cell holding x (and its count, for a reference)
fn lowerSome(expression: Node) -> int {
    let valueType = expression.children[0].typeIndex
    var value = lowerExpression(expression.children[0])
    if optimizerBailed { return 0 }
    if isReferenceType(valueType) { value = takeOwnership(value) }
    let descriptor = symbolAddress("__dt{slotShapeDescriptor([valueType])}")
    let cell = ownedTemporary(lowerRuntimeCall("runtimeAllocateDescribedObject", [integerConstant(8), descriptor]))
    if irClasses[value] == classFloat { let storedFloat = emitIr2(irFloatStore, classFloat, cell, value, 0) }
    else { let stored = emitIr2(irStore, classInteger, cell, value, 0) }
    return cell
}

// an optional's value, borrowed from its cell like a list element
fn loadBoxedValue(cell: int, valueType: int) -> int {
    if typeKinds[valueType] == kindFloat { return emitIr1(irFloatLoad, classFloat, cell, 0) }
    let value = emitIr1(irLoad, classInteger, cell, 0)
    if isReferenceType(valueType) { irBorrowed[value] = true }
    return value
}

// "text {value} text": parts append to the runtime's string builder, one
// string at the end (as the baseline does); the parts' temporaries go with
// the statement
fn lowerInterpolation(expression: Node) -> int {
    var noOperands: [int] = []
    let mark = lowerRuntimeCall("runtimeBeginStringInterpolation", noOperands)
    for part in expression.children {
        if part.nodeKind == nodeStringText {
            let text = emitIr0(irDataAddress, classInteger, addDataString(part.name))
            let appendedText = lowerRuntimeCall("runtimeAppendInterpolationText", [text])
        } else {
            var value = lowerExpression(part.children[0])
            if optimizerBailed { return 0 }
            if irClasses[value] == classFloat { value = emitIr1(irBitsFromFloat, classInteger, value, 0) }
            let appendedValue = lowerRuntimeCall("runtimeAppendInterpolationValue", [value, symbolAddress("__td{part.slot}")])
        }
    }
    return ownedTemporary(lowerRuntimeCall("runtimeEndStringInterpolation", [mark]))
}

fn symbolAddress(symbol: str) -> int {
    regionSymbols.push(symbol)
    return emitIr0(irSymbolAddress, classInteger, regionSymbols.len() - 1)
}

// a fresh object: the fields' counts move into it
fn lowerStructLiteral(expression: Node) -> int {
    let structDefinition = structDefinitions[expression.referenceIndex]
    var holdsReferences = false
    for fieldType in structDefinition.fieldTypes {
        if isReferenceType(fieldType) { holdsReferences = true }
    }
    // no reference fields: descriptor 0, so a release frees it straight onto its free list
    var descriptor = integerConstant(0)
    if holdsReferences { descriptor = symbolAddress("__dt{slotShapeDescriptor(structDefinition.fieldTypes)}") }
    let object = ownedTemporary(lowerRuntimeCall("runtimeAllocateDescribedObject", [integerConstant(8 * structDefinition.fieldNames.len()), descriptor]))
    irScalarCandidates[object] = not holdsReferences
    for fieldInitializer in expression.children {
        var value = lowerExpression(fieldInitializer.children[0])
        if optimizerBailed { return 0 }
        if isReferenceType(structDefinition.fieldTypes[fieldInitializer.slot]) { value = takeOwnership(value) }
        if irClasses[value] == classFloat { let stored = emitIr2(irFloatStore, classFloat, object, value, 8 * fieldInitializer.slot) }
        else { let stored = emitIr2(irStore, classInteger, object, value, 8 * fieldInitializer.slot) }
    }
    return object
}

// A call through a code address, stack convention. An interface value is a
// {vtable, data} cell: self is the data, the code sits in the vtable's slot.
// A function value is a {code, env} cell: env goes deepest, past the arguments.
// The cell is borrowed for the call, as the baseline does.
fn lowerIndirectCall(expression: Node) -> int {
    let isDispatch = expression.auxiliary == callKindInterfaceDispatch
    var cellNode = expression.children[0]
    if isDispatch { cellNode = cellNode.children[0] }
    var arguments: [Node] = []
    for i in 1..expression.children.len() { arguments.push(expression.children[i]) }
    var pinned: [int] = []
    let knownClosure = knownClosureOfNode(cellNode)
    if optimizerBailed { return 0 }
    if not isDispatch and knownClosure >= 0 and canInlineWithin(knownClosureFunctions[knownClosure], 60) {
        let inlineArguments = lowerInlineArguments(arguments, pinned)
        if optimizerBailed { return 0 }
        let inlinedResult = lowerInlinedBody(knownClosureFunctions[knownClosure], inlineArguments, knownClosureCaptures[knownClosure])
        for value in pinned { emitRelease(value) }
        if isReferenceType(expression.typeIndex) { return ownedTemporary(inlinedResult) }
        return inlinedResult
    }
    let cell = pinBeforeLaterCalls(lowerExpression(cellNode), cellNode, arguments, pinned)
    if optimizerBailed { return 0 }
    var argumentValues: [int] = []
    for i in 0..arguments.len() {
        var value = lowerExpression(arguments[i])
        if optimizerBailed { return 0 }
        value = pinBeforeLaterCalls(value, arguments[i], argumentsAfter(arguments, i), pinned)
        argumentValues.push(value)
    }
    pinArguments(argumentValues, arguments, false, pinned)
    if argumentValues.len() > 60 {
        optimizerBail("too many arguments")
        return 0
    }
    // a closure or box never changes: its fields load next to the call, not across the arguments
    var operands: [int] = []
    if isDispatch {
        let vtable = emitIr1(irLoad, classInteger, cell, 0)
        operands.push(emitIr1(irLoad, classInteger, vtable, 8 * expression.slot))
        operands.push(emitIr1(irLoad, classInteger, cell, 8))             // self
    } else {
        operands.push(emitIr1(irLoad, classInteger, cell, 0))
        operands.push(emitIr1(irLoad, classInteger, cell, 8))             // env
    }
    var result = 0
    if isDispatch {
        nextStackCallCannotFree = not dispatchMayFree(expression)
        result = lowerGuardedDispatch(expression, cellNode, operands, argumentValues)
        nextStackCallCannotFree = false
    }
    else { result = lowerStackCall(operands, argumentValues, expression.typeIndex) }
    for value in pinned { emitRelease(value) }
    if isReferenceType(expression.typeIndex) { return ownedTemporary(result) }
    return result
}

// the call through operands[0] with [operands[1..], arguments...] on the stack, its result retyped
fn lowerStackCall(operands: [int], argumentValues: [int], resultType: int) -> int {
    var callOperands: [int] = []
    for operand in operands { callOperands.push(operand) }
    for value in argumentValues {
        if irClasses[value] == classFloat { callOperands.push(emitIr1(irBitsFromFloat, classInteger, value, 0)) }
        else { callOperands.push(value) }
    }
    let result = emitIr(irCall, classInteger, callOperands, indirectStackCall)
    irReferenceArguments[result] = 0
    if nextStackCallCannotFree { nonFreeingCalls.push(result) }
    nextStackCallCannotFree = false
    if typeKinds[resultType] == kindFloat { return emitIr1(irFloatFromBits, classFloat, result, 0) }
    return result
}

// a direct call (or the body inlined) of a known function on already-lowered values
fn lowerKnownCall(functionIndex: int, argumentValues: [int]) -> int {
    if canInline(functionIndex) { return lowerInlinedCall(functionIndex, argumentValues) }
    let functionDefinition = functionDefinitions[functionIndex]
    var operands: [int] = []
    for value in argumentValues {
        if irClasses[value] == classFloat { operands.push(emitIr1(irBitsFromFloat, classInteger, value, 0)) }
        else { operands.push(value) }
    }
    let result = emitIr(irCall, classInteger, operands, functionIndex)
    irReferenceArguments[result] = 0
    if typeKinds[functionDefinition.returnType] == kindFloat { return emitIr1(irFloatFromBits, classFloat, result, 0) }
    return result
}

// Guarded devirtualization: every (struct, interface) vtable is known by now,
// so a dispatch on an interface with a few implementors compares the vtable
// against each and calls (or inlines) that struct's method directly. The
// indirect call stays as the last resort.
fn lowerGuardedDispatch(expression: Node, cellNode: Node, operands: [int], argumentValues: [int]) -> int {
    let interfaceIndex = typeDefinitionIds[cellNode.typeIndex]
    let interfaceDefinition = interfaceDefinitions[interfaceIndex]
    let methodName = interfaceDefinition.methodNames[expression.slot]
    var tables: [int] = []
    var methods: [int] = []
    for table in 0..dispatchStructIndices.len() {
        if dispatchInterfaceIndices[table] != interfaceIndex { continue }
        let methodIndex = findFunction(structDefinitions[dispatchStructIndices[table]].name + "." + methodName)
        if methodIndex < 0 { return lowerStackCall(operands, argumentValues, expression.typeIndex) }
        tables.push(table)
        methods.push(methodIndex)
    }
    if tables.len() == 0 or tables.len() > 4 { return lowerStackCall(operands, argumentValues, expression.typeIndex) }
    let vtable = irOperands[operands[0]][0]           // operands[0] loads the code from the vtable
    var directArguments: [int] = [operands[1]]
    for value in argumentValues { directArguments.push(value) }
    let hasValue = typeKinds[expression.typeIndex] != kindVoid
    var result = 0 - 1
    if hasValue { result = temporaryVariable(classOfType(expression.typeIndex), false) }
    let joinBlock = newBlock()
    for i in 0..tables.len() {
        let matchBlock = newBlock()
        let nextBlock = newBlock()
        ensureOpenBlock()
        terminate(irBranchCompare, [vtable, symbolAddress("__vt{tables[i]}")], conditionEqual, [matchBlock, nextBlock])
        sealBlock(matchBlock)
        sealBlock(nextBlock)
        currentIrBlock = matchBlock
        let value = lowerKnownCall(methods[i], directArguments)
        if optimizerBailed { return 0 }
        if hasValue { writeVariableValue(result, value) }
        jumpTo(joinBlock)
        currentIrBlock = nextBlock
    }
    let fallback = lowerStackCall(operands, argumentValues, expression.typeIndex)
    if hasValue { writeVariableValue(result, fallback) }
    jumpTo(joinBlock)
    sealBlock(joinBlock)
    currentIrBlock = joinBlock
    if hasValue { return readVariableValue(result) }
    return 0
}

// a struct as an interface value: a fresh {vtable, data} cell that takes the data's count
fn lowerInterfaceBox(expression: Node) -> int {
    let data = takeOwnership(lowerExpression(expression.children[0]))
    if optimizerBailed { return 0 }
    let cellShape = addShapeDescriptor("1, 2, 2")
    let descriptor = symbolAddress("__dt{cellShape}")
    let cell = ownedTemporary(lowerRuntimeCall("runtimeAllocateDescribedObject", [integerConstant(16), descriptor]))
    let dataStored = emitIr2(irStore, classInteger, cell, data, 8)
    let vtableStored = emitIr2(irStore, classInteger, cell, symbolAddress("__vt{expression.operator}"), 0)
    return cell
}

// a function value: a fresh {code, env} cell; `environment`'s count moves into it
fn lowerClosureCell(functionDefinition: FunctionDefinition, environment: int) -> int {
    var cell = 0
    if isConstantValue(environment) { cell = ownedTemporary(lowerRuntimeCall("runtimeAllocateObject", [integerConstant(16)])) }      // no env: a plain function
    else {
        let cellShape = addShapeDescriptor("1, 2, 2")
        cell = ownedTemporary(lowerRuntimeCall("runtimeAllocateDescribedObject", [integerConstant(16), symbolAddress("__dt{cellShape}")]))
    }
    let environmentStored = emitIr2(irStore, classInteger, cell, environment, 8)
    let codeStored = emitIr2(irStore, classInteger, cell, symbolAddress(functionCodeLabel(functionDefinition.label)), 0)
    return cell
}

// a closure: its captures snapshot into a fresh env, which the cell owns
fn lowerFunctionLiteral(expression: Node) -> int {
    let captureCount = expression.children.len() - 3
    var captureTypes: [int] = []
    for i in 0..captureCount { captureTypes.push(expression.children[3 + i].typeIndex) }
    var captureValues: [int] = []
    let environmentDescriptor = symbolAddress("__dt{slotShapeDescriptor(captureTypes)}")
    let environment = ownedTemporary(lowerRuntimeCall("runtimeAllocateDescribedObject", [integerConstant(8 * captureCount), environmentDescriptor]))
    for i in 0..captureCount {
        var value = lowerExpression(expression.children[3 + i])
        if optimizerBailed { return 0 }
        if isReferenceType(captureTypes[i]) { value = takeOwnership(value) }
        if irClasses[value] == classFloat { let stored = emitIr2(irFloatStore, classFloat, environment, value, 8 * i) }
        else { let stored = emitIr2(irStore, classInteger, environment, value, 8 * i) }
        captureValues.push(value)
    }
    let cell = lowerClosureCell(functionDefinitions[expression.referenceIndex], takeOwnership(environment))
    knownClosureCells.push(cell)
    knownClosureFunctions.push(expression.referenceIndex)
    knownClosureCaptures.push(captureValues)
    return cell
}

// a fresh list of known length: the elements' counts move into it
fn lowerListLiteral(expression: Node) -> int {
    let descriptor = symbolAddress("__dt{listShapeDescriptor(expression.typeIndex)}")
    let list = ownedTemporary(lowerRuntimeCall("runtimeNewDescribedList", [integerConstant(expression.children.len()), descriptor]))
    for i in 0..expression.children.len() {
        let element = expression.children[i]
        var value = lowerExpression(element)
        if optimizerBailed { return 0 }
        if isReferenceType(element.typeIndex) { value = takeOwnership(value) }
        let data = emitIr1(irListData, classInteger, list, 0)
        if irClasses[value] == classFloat { let stored = emitIr2(irFloatStore, classFloat, data, value, 8 * i) }
        else { let stored = emitIr2(irStore, classInteger, data, value, 8 * i) }
    }
    return list
}

fn lowerBranchValue(result: int, branch: Node) {
    let mark = pendingTemporaries.len()
    writeVariableValue(result, lowerExpression(branch))
    if isReferenceType(branch.typeIndex) and pendingTemporaries.len() > mark {
        optimizerBail("fresh reference in a conditional branch")
        return
    }
    releaseTemporariesFrom(mark)
}

fn lowerBinary(expression: Node) -> int {
    let operator = expression.operator
    if operator == tokenAnd or operator == tokenOr {
        let result = temporaryVariable(classInteger, false)
        let rightBlock = newBlock()
        let shortBlock = newBlock()
        let joinBlock = newBlock()
        if operator == tokenAnd { lowerCondition(expression.children[0], rightBlock, shortBlock) }
        else { lowerCondition(expression.children[0], shortBlock, rightBlock) }
        sealBlock(rightBlock)
        sealBlock(shortBlock)
        currentIrBlock = rightBlock
        let rightMark = pendingTemporaries.len()
        writeVariableValue(result, lowerExpression(expression.children[1]))
        releaseTemporariesFrom(rightMark)
        jumpTo(joinBlock)
        currentIrBlock = shortBlock
        if operator == tokenAnd { writeVariableValue(result, integerConstant(0)) }
        else { writeVariableValue(result, integerConstant(1)) }
        jumpTo(joinBlock)
        sealBlock(joinBlock)
        currentIrBlock = joinBlock
        return readVariableValue(result)
    }
    let category = expression.auxiliary
    if category == binaryCategoryString { return lowerStringComparison(expression) }
    let left = lowerExpression(expression.children[0])
    let right = lowerExpression(expression.children[1])
    if optimizerBailed { return 0 }
    let condition = conditionForToken(operator)
    if category == binaryCategoryFloat {
        if condition >= 0 { return emitIr2(irFloatCompare, classInteger, left, right, condition) }
        let floatOpcode = floatOpcodeForToken(operator)
        if floatOpcode < 0 {
            optimizerBail("float operator {operator}")
            return 0
        }
        return emitIr2(floatOpcode, classFloat, left, right, 0)
    }
    if condition >= 0 { return emitIr2(irCompare, classInteger, left, right, condition) }
    let opcode = integerOpcodeForToken(operator)
    if opcode < 0 {
        optimizerBail("operator {operator}")
        return 0
    }
    if opcode == irDivide { let checked = emitIr1(irZeroCheck, classInteger, right, panicStringIndex(expression, "division by zero")) }
    if opcode == irModulo { let checked = emitIr1(irZeroCheck, classInteger, right, panicStringIndex(expression, "modulo by zero")) }
    return emitIr2(opcode, classInteger, left, right, 0)
}

// runtime functions that release no count and write no existing object (at
// most a fresh one, or a count): borrowed references stay valid across them,
// and loads need not be redone after them
fn keepsHeapIntact(name: str) -> bool {
    if name == "runtimeStringsEqual" or name == "runtimeCompareStrings" or name == "runtimeRetainReference" { return true }
    if name == "runtimeNewDescribedMap" or name == "runtimeFillWords" { return true }
    if name == "runtimeFormatTypedValue" or name == "runtimeStringToInteger" or name == "runtimeStringToFloat" { return true }
    if name == "runtimePrintTypedValue" or name == "runtimeJoinStringList" or name == "runtimeCharacterFromCode" or name == "runtimeListNew" { return true }
    if name == "runtimeBeginStringInterpolation" or name == "runtimeAppendInterpolationText" or name == "runtimeAppendInterpolationValue" or name == "runtimeEndStringInterpolation" { return true }   // they write the builder's own buffer
    if name == "runtimeMapGet" or name == "runtimeFindMapEntry" or name == "runtimeMapGetOrReference" or name == "runtimeMapGetOrValue" or name == "runtimeMapHas" { return true }     // lookups: they retain, never release
    return name == "runtimeSubstringValue" or name == "runtimeConcatenateStrings" or name == "runtimeAllocateDescribedObject" or name == "runtimeAllocateObject" or name == "runtimeNewDescribedList"
}

fn callKeepsHeapIntact(instruction: int) -> bool {
    let functionIndex = irImmediates[instruction]
    return functionIndex >= 0 and functionIndex != indirectStackCall and keepsHeapIntact(functionDefinitions[functionIndex].name)
}

// may this call drop a count a borrowed value leans on (it may still write memory)
fn irCallMayFree(instruction: int) -> bool {
    for call in nonFreeingCalls {
        if call == instruction { return false }
    }
    let functionIndex = irImmediates[instruction]
    if functionIndex == indirectStackCall { return true }
    if functionIndex < 0 { return true }
    return not callKeepsHeapIntact(instruction) and functionMayFree(functionIndex)
}

fn lowerRuntimeCall(name: str, operands: [int]) -> int {
    if not functionNameIndices.has(name) {
        optimizerBail("no {name}")
        return 0
    }
    let result = emitIr(irCall, classInteger, operands, functionNameIndices[name])
    irReferenceArguments[result] = 0
    return result
}

fn emitRetain(value: int) -> int { return lowerRuntimeCall("runtimeRetainReference", [value]) }   // returns its argument, now owned

fn emitRelease(value: int) {
    let released = lowerRuntimeCall("runtimeReleaseReference", [value])
}

// a fresh (+1) value: the statement must consume it or release it
fn ownedTemporary(value: int) -> int {
    pendingTemporaries.push(value)
    return value
}

fn isPendingTemporary(value: int) -> bool {
    for pending in pendingTemporaries {
        if pending == value { return true }
    }
    return false
}

// a count for a value about to be stored where it is owned: a pending
// temporary hands its own over, anything else is retained; returns the owned value
fn takeOwnership(value: int) -> int {
    var remaining: [int] = []
    var found = false
    for pending in pendingTemporaries {
        if pending == value and not found { found = true }
        else { remaining.push(pending) }
    }
    pendingTemporaries = remaining
    if found { return value }
    if movableVariables.len() > 0 and movableLoweringDepth == movingDepth() {
        for variable in movableVariables {
            if readVariableValue(variable) == value { return moveVariableCount(variable) }
        }
    }
    return emitRetain(value)
}

fn movingDepth() -> int { return (inlineStack.len() * 4096 + regionBreakTargets.len()) * 4096 + ownedScopes.len() }

// the statement's consumer takes the local's count: its scope forgets it
fn moveVariableCount(variable: int) -> int {
    var remainingMovable: [int] = []
    for other in movableVariables {
        if other != variable { remainingMovable.push(other) }
    }
    movableVariables = remainingMovable
    let scopeIndex = ownedScopes.len() - 1
    var kept: [int] = []
    for scoped in ownedScopes[scopeIndex] {
        if scoped != variable { kept.push(scoped) }
    }
    ownedScopes[scopeIndex] = kept
    return readVariableValue(variable)
}

// drop the temporaries made since `mark`: the statement or branch is over
fn releaseTemporariesFrom(mark: int) {
    while pendingTemporaries.len() > mark {
        let value = pendingTemporaries.pop()
        if not blockTerminated[currentIrBlock] { emitRelease(value) }
    }
}

// an early exit leaves them: release on this path only, the others still hold them
fn releaseTemporariesOnExit(mark: int) {
    var index = pendingTemporaries.len() - 1
    while index >= mark {
        emitRelease(pendingTemporaries[index])
        index -= 1
    }
}

fn releaseScopesFrom(depth: int) { releaseScopesExcept(depth, 0 - 1) }

// the owned locals of scopes from `depth` on, but `kept` (a count moving elsewhere)
fn releaseScopesExcept(depth: int, kept: int) {
    var scopeIndex = ownedScopes.len() - 1
    while scopeIndex >= depth {
        let variables = ownedScopes[scopeIndex]
        var index = variables.len() - 1
        while index >= 0 {
            if variables[index] != kept { emitRelease(readVariableValue(variables[index])) }
            index -= 1
        }
        scopeIndex -= 1
    }
}

// a declaration takes an inline call's result: the frontend's result slot, read
// once and owned in this same scope, hands its count over instead of keeping one
fn tookInlineResult(value: int) -> bool {
    if isPendingTemporary(value) { return false }
    let scope = ownedScopes[ownedScopes.len() - 1]
    var kept: [int] = []
    var found = false
    for variable in scope {
        if not found and variableIsInlineResult[variable] and readVariableValue(variable) == value { found = true }
        else { kept.push(variable) }
    }
    if found { ownedScopes[ownedScopes.len() - 1] = kept }
    return found
}

// the owned local `expression` names, when its scope is at or past `depth`
// (an exit about to release it), else -1
fn ownedVariableLeaving(expression: Node, depth: int) -> int {
    if expression.nodeKind != nodeIdentifier or expression.auxiliary != identifierKindLocal { return 0 - 1 }
    let variable = identifierVariable(expression)
    if optimizerBailed or not isOwnedVariable(variable) { return 0 - 1 }
    for scopeIndex in depth..ownedScopes.len() {
        for scoped in ownedScopes[scopeIndex] {
            if scoped == variable { return variable }
        }
    }
    return 0 - 1
}

fn isOwnedVariable(variable: int) -> bool { return variableOwnsValue[variable] }

// a local or parameter takes a value: an owned local holds a count of its own
// and drops the one it held before
fn storeVariable(variable: int, value: int, isDeclaration: bool) {
    if isOwnedVariable(variable) {
        if ownedScopes.len() == 0 {
            optimizerBail("owned local outside a block")
            return
        }
        var owned = value
        if not (isDeclaration and tookInlineResult(value)) { owned = takeOwnership(value) }
        if isDeclaration {
            declareVariable(variable, owned)
            ownedScopes[ownedScopes.len() - 1].push(variable)
        } else {
            let previous = readVariableValue(variable)
            writeVariableValue(variable, owned)
            emitRelease(previous)
        }
        return
    }
    if not isDeclaration and variableIsReference[variable] and variableHomeKind[variable] == identifierKindGlobal and regionGlobalsInMemory {
        // the global's slot takes a count and drops its old one; loads of it
        // are borrowed here, so one live across this store fails checkBorrows
        let slotAddress = emitIr2(irAdd, classInteger, symbolAddress("__zephyr_globals"), integerConstant(8 * variableHomeIndex[variable]), 0)
        let assigned = lowerRuntimeCall("runtimeAssignReference", [slotAddress, takeOwnership(value)])
        return
    }
    if isPendingTemporary(value) {
        optimizerBail("fresh value into a borrowed variable")
        return
    }
    if variableIsReference[variable] and variableHomeKind[variable] == identifierKindParameter {
        optimizerBail("reference parameter reassigned")
        return
    }
    if isDeclaration { declareVariable(variable, value) } else { writeVariableValue(variable, value) }
}

var declarationScopeMayFree = true            // markOwnedLocals: can the siblings after the current node free?

// Which reference locals own their value: those ever given a fresh one, or a
// copy of an owned one (a borrowed alias could outlive the count it leans on).
// Returns whether it marked any; run to a fixpoint.
fn markOwnedLocals(node: Node) -> bool {
    var changed = false
    var slot = 0 - 1
    var source = node
    if node.nodeKind == nodeDeclaration and node.auxiliary == identifierKindLocal and isReferenceType(node.typeIndex) {
        slot = node.slot
        source = node.children[0]
    }
    if node.nodeKind == nodeAssign and node.children[0].nodeKind == nodeIdentifier and node.children[0].auxiliary == identifierKindLocal and isReferenceType(node.children[0].typeIndex) {
        slot = node.children[0].slot
        source = node.children[1]
    }
    let scopeMayFree = declarationScopeMayFree
    if slot >= 0 and not ownedLocalSlots.has(slot) and needsOwnedHome(source) {
        // a declared load only needs a count when the rest of its block can free
        if node.nodeKind == nodeAssign or scopeMayFree or not isLoadSource(source) {
            ownedLocalSlots[slot] = true
            changed = true
        }
    }
    if node.nodeKind == nodeInline and isReferenceType(node.typeIndex) and not ownedLocalSlots.has(node.slot) {
        ownedLocalSlots[node.slot] = true             // an inlined call's result is fresh
        changed = true
    }
    var laterMayFree: [bool] = []                    // by child: can a sibling after it free?
    for child in node.children {
        if child.nodeKind == nodeDeclaration and isReferenceType(child.typeIndex) and regionSourceMakesCalls and isLoadSource(child.children[0]) {
            laterMayFree = siblingsAfterMayFree(node.children)
            break
        }
    }
    for i in 0..node.children.len() {
        declarationScopeMayFree = true
        if laterMayFree.len() > 0 { declarationScopeMayFree = laterMayFree[i] }
        if markOwnedLocals(node.children[i]) { changed = true }
    }
    return changed
}

// a value read out of a global, a field or an element: borrowed from its holder
fn isLoadSource(value: Node) -> bool {
    let kind = value.nodeKind
    return kind == nodeMember or kind == nodeIndex or (kind == nodeIdentifier and value.auxiliary == identifierKindGlobal)
}

fn siblingsAfterMayFree(siblings: [Node]) -> [bool] {
    var result: [bool] = []
    for sibling in siblings { result.push(true) }
    var later = false
    var i = siblings.len() - 1
    while i >= 0 {
        result[i] = later
        if not later { later = mayFreeOrReassign(siblings[i]) or assignsAnyReference(siblings[i]) }
        i -= 1
    }
    return result
}

// any reference store, a local's included: it releases what it overwrites
fn assignsAnyReference(node: Node) -> bool {
    if node.nodeKind == nodeAssign and (isReferenceType(node.children[0].typeIndex) or node.children[0].nodeKind == nodeIndex) { return true }
    for child in node.children {
        if assignsAnyReference(child) { return true }
    }
    return false
}

// borrowed sources: parameters, literals, globals and borrowed locals; loads
// too when the region makes no call that could free what they came from
fn needsOwnedHome(value: Node) -> bool {
    let kind = value.nodeKind
    if kind == nodeIdentifier and value.auxiliary == identifierKindGlobal { return regionSourceMakesCalls }   // a call or store may replace the global's value
    if kind == nodeIdentifier { return value.auxiliary == identifierKindLocal and ownedLocalSlots.has(value.slot) }
    if kind == nodeMember or kind == nodeIndex { return regionSourceMakesCalls }
    return not (isPlainLiteral(value) or kind == nodeNoneLiteral)
}


// can this subtree run a call that releases a count (user code, a runtime
// method, a list push or pop, a call through a value)?
// ---- which functions can drop a count some caller relies on ----
// A function frees if it (or anything it calls) stores a reference into memory
// that outlives it (a global, a field, an element, a map), pops, pushes, calls
// the runtime's freeing entry points, or calls through a value it cannot see.
// Releasing its own locals cannot free what a caller holds: whatever a caller
// lent it still has the caller's owner's count. Recursion counts as freeing.
var functionFreeStates: [int] = []          // by function: 0 unknown, 1 being scanned, 2 never frees, 3 may free

fn functionMayFree(functionIndex: int) -> bool {
    while functionFreeStates.len() < functionDefinitions.len() { functionFreeStates.push(0) }
    let state = functionFreeStates[functionIndex]
    if state == 1 or state == 3 { return true }
    if state == 2 { return false }
    let functionDefinition = functionDefinitions[functionIndex]
    if functionDefinition.name == "runtimeFail" { return false }
    if functionDefinition.name == "runtimeCollectGarbage" or keepsHeapIntact(functionDefinition.name) {
        functionFreeStates[functionIndex] = 3
        if keepsHeapIntact(functionDefinition.name) { functionFreeStates[functionIndex] = 2 }
        return functionFreeStates[functionIndex] == 3
    }
    functionFreeStates[functionIndex] = 1
    let frees = bodyMayFree(functionDefinition.body)
    functionFreeStates[functionIndex] = 2
    if frees { functionFreeStates[functionIndex] = 3 }
    return frees
}

// every implementation an interface call can reach, or true if one is unknown
fn dispatchMayFree(call: Node) -> bool {
    let cellType = call.children[0].children[0].typeIndex
    if typeKinds[cellType] != kindInterface { return true }
    let interfaceIndex = typeDefinitionIds[cellType]
    let methodName = interfaceDefinitions[interfaceIndex].methodNames[call.slot]
    for table in 0..dispatchStructIndices.len() {
        if dispatchInterfaceIndices[table] != interfaceIndex { continue }
        let methodIndex = findFunction(structDefinitions[dispatchStructIndices[table]].name + "." + methodName)
        if methodIndex < 0 or functionMayFree(methodIndex) { return true }
    }
    return false
}

fn bodyMayFree(node: Node) -> bool {
    let kind = node.nodeKind
    if kind == nodeFunctionLiteral {
        for i in 3..node.children.len() {                // only the captures run here
            if bodyMayFree(node.children[i]) { return true }
        }
        return false
    }
    if kind == nodeAssign {
        let target = node.children[0]
        if target.nodeKind == nodeIndex and typeKinds[target.children[0].typeIndex] == kindMap and isReferenceType(target.typeIndex) { return true }     // plain values: only the key count handed over drops
        if isReferenceType(target.typeIndex) and not (target.nodeKind == nodeIdentifier and target.auxiliary == identifierKindLocal) { return true }
    }
    if kind == nodeCall and callMayFree(node) { return true }
    for child in node.children {
        if bodyMayFree(child) { return true }
    }
    return false
}

// the call itself (its arguments aside)
fn callMayFree(node: Node) -> bool {
    let callKind = node.auxiliary
    if callKind == callKindUser { return functionMayFree(node.referenceIndex) }
    if callKind == callKindRuntimeCall { return not keepsHeapIntact(node.name) }
    if callKind == callKindInterfaceDispatch { return dispatchMayFree(node) }
    return callKind == callKindPush or callKind == callKindPop or callKind == callKindIndirect or callKind == callKindWindows or callKind == callKindFunctionPointerCall
}

fn mayCallFreeingCode(node: Node) -> bool {
    if node.nodeKind == nodeCall and callMayFree(node) { return true }
    for child in node.children {
        if mayCallFreeingCode(child) { return true }
    }
    return false
}

// can evaluating this subtree drop a count some other holder keeps: a freeing
// call, or an inlined body (its statements may assign)
fn mayFreeOrReassign(node: Node) -> bool {
    let kind = node.nodeKind
    if kind == nodeInline or kind == nodeInlineReturn or kind == nodeLetExpression or kind == nodeFunctionLiteral { return true }
    if kind == nodeCall and mayCallFreeingCode(node) { return true }
    for child in node.children {
        if mayFreeOrReassign(child) { return true }
    }
    return false
}

// a store that releases what it overwrites: a reference into a field, an
// element, a global or a map
fn storesReleasingReferences(node: Node) -> bool {
    if node.nodeKind == nodeAssign {
        let target = node.children[0]
        if target.nodeKind == nodeIndex and typeKinds[target.children[0].typeIndex] == kindMap and isReferenceType(target.typeIndex) { return true }     // plain values: only the key count handed over drops
        if isReferenceType(target.typeIndex) and not (target.nodeKind == nodeIdentifier and target.auxiliary == identifierKindLocal) { return true }
    }
    for child in node.children {
        if storesReleasingReferences(child) { return true }
    }
    return false
}

fn findOwnedLocals(root: Node) {
    regionSourceMakesCalls = mayCallFreeingCode(root) or storesReleasingReferences(root)
    var changed = true
    while changed {
        declarationScopeMayFree = true
        changed = markOwnedLocals(root)
    }
}

// an argument evaluated before a later one that calls: a borrowed reference
// takes a count so that call cannot free it first
fn pinBeforeLaterCalls(value: int, argument: Node, laterArguments: [Node], pinned: [int]) -> int {
    if not irBorrowed[value] or not isReferenceType(argument.typeIndex) { return value }
    for later in laterArguments {
        if mayFreeOrReassign(later) {
            let retained = emitRetain(value)
            pinned.push(retained)
            return retained
        }
    }
    return value
}

// a container read before an operand that calls: it holds a count until the statement ends
fn lowerContainer(container: Node, later: [Node]) -> int {
    let value = lowerExpression(container)
    if optimizerBailed or not irBorrowed[value] or not isReferenceType(container.typeIndex) { return value }
    for operand in later {
        if mayFreeOrReassign(operand) { return ownedTemporary(emitRetain(value)) }
    }
    return value
}

fn argumentsAfter(arguments: [Node], index: int) -> [Node] {
    var later: [Node] = []
    for i in (index + 1)..arguments.len() { later.push(arguments[i]) }
    return later
}

// Borrowed reference arguments get a count for the call: the callee may free
// the container they came from. Runtime primitives that call no user code
// never reassign a global, so a global's value may go as it is.
fn pinArguments(operands: [int], arguments: [Node], globalsStay: bool, pinned: [int]) {
    for i in 0..operands.len() {
        var value = operands[i]
        if irBorrowed[value] and isReferenceType(arguments[i].typeIndex) and not (globalsStay and irFromGlobal[value]) {
            value = emitRetain(value)
            pinned.push(value)
            operands[i] = value
        }
    }
}

// str == != < <= > >=: the runtime compares; + concatenates into a fresh string
// strings of different lengths differ: only equal lengths call the byte compare
fn lowerStringsEqual(left: int, right: int) -> int {
    let leftLength = emitIr1(irListLength, classInteger, left, 1)
    let rightLength = emitIr1(irListLength, classInteger, right, 1)
    let result = temporaryVariable(classInteger, false)
    writeVariableValue(result, integerConstant(0))
    let compareBlock = newBlock()
    let joinBlock = newBlock()
    terminate(irBranchCompare, [leftLength, rightLength], conditionEqual, [compareBlock, joinBlock])
    sealBlock(compareBlock)
    currentIrBlock = compareBlock
    writeVariableValue(result, lowerRuntimeCall("runtimeStringsEqual", [left, right]))
    jumpTo(joinBlock)
    sealBlock(joinBlock)
    currentIrBlock = joinBlock
    return readVariable(result, joinBlock)
}

// x = x + y on an owned str local: x's count goes to runtimeAppendString,
// which may grow the string in place (nothing else holds it then)
fn lowerStringAppend(target: Node, source: Node) -> bool {
    if source.nodeKind != nodeBinary or source.auxiliary != binaryCategoryString or source.operator != tokenPlus or source.slot > 0 { return false }
    if not sameVariableNode(source.children[0], target) or mayFreeOrReassign(source.children[1]) { return false }
    if target.auxiliary != identifierKindLocal or not functionNameIndices.has("runtimeAppendString") { return false }
    let variable = identifierVariable(target)
    if optimizerBailed or not isOwnedVariable(variable) or ownedScopes.len() == 0 { return false }
    if not regionIsFunction and not variableDeclaredInside[variable] { return false }     // a parent's slot: assignVariable bails
    let right = lowerExpression(source.children[1])
    if optimizerBailed { return true }
    let previous = readVariableValue(variable)
    let appended = lowerRuntimeCall("runtimeAppendString", [previous, right])
    writeVariableValue(variable, appended)
    return true
}

fn lowerStringComparison(expression: Node) -> int {
    let operator = expression.operator
    let condition = conditionForToken(operator)
    if (condition < 0 and operator != tokenPlus) or expression.slot > 0 {
        optimizerBail("string operator")
        return 0
    }
    let left = lowerContainer(expression.children[0], [expression.children[1]])      // pinned if the right side may free it
    let right = lowerExpression(expression.children[1])
    if optimizerBailed { return 0 }
    if operator == tokenPlus { return ownedTemporary(lowerRuntimeCall("runtimeConcatenateStrings", [left, right])) }
    if operator == tokenEquals or operator == tokenNotEquals {
        let equal = lowerStringsEqual(left, right)
        if operator == tokenEquals { return equal }
        return emitIr2(irBitXor, classInteger, equal, integerConstant(1), 0)
    }
    let order = lowerRuntimeCall("runtimeCompareStrings", [left, right])
    return emitIr2(irCompare, classInteger, order, integerConstant(0), condition)
}

// element type of a list the tier can address with 8-byte strides, or -1
fn plainListElement(listType: int) -> int {
    if typeKinds[listType] != kindList {
        optimizerBail("index into a non-list")
        return 0 - 1
    }
    let elementType = typeElementIds[listType]
    if typeKinds[elementType] == kindByte or typeKinds[elementType] == kindFloat32 {
        optimizerBail("packed list")
        return 0 - 1
    }
    return elementType
}

// bounds-checked element address: returns the data pointer; the caller indexes it
fn lowerElementAddress(list: int, index: int, site: Node) -> int {
    let length = emitIr1(irListLength, classInteger, list, 0)
    let checked = emitIr2(irBoundsCheck, classInteger, length, index, panicStringIndex(site, "index out of bounds"))
    let data = emitIr1(irListData, classInteger, list, 0)
    irBorrowed[data] = true                   // a push reallocates it
    return data
}

// m[k]: the map's lookup hands back a count of its own for a reference value
fn lowerMapRead(expression: Node) -> int {
    let map = lowerContainer(expression.children[0], [expression.children[1]])
    let key = lowerExpression(expression.children[1])
    if optimizerBailed { return 0 }
    let site = emitIr0(irDataAddress, classInteger, addDataString(panicSite(expression)))
    let value = lowerRuntimeCall("runtimeMapGet", [map, key, site])
    if typeKinds[expression.typeIndex] == kindFloat { return emitIr1(irFloatFromBits, classFloat, value, 0) }
    if isReferenceType(expression.typeIndex) { return ownedTemporary(value) }
    return value
}

// list.push(value), the list taking value's count: with room, store and
// bump the length inline; the runtime grows the buffer otherwise. The length
// is written with a raw store, which ends the shape epoch lengths are
// numbered in.
fn lowerListPush(list: int, value: int) {
    let count = emitIr1(irListLength, classInteger, list, 0)
    let capacity = emitIr1(irLoadRaw64, classInteger, list, 8)
    let roomBlock = newBlock()
    let growBlock = newBlock()
    let joinBlock = newBlock()
    terminate(irBranchCompare, [count, capacity], conditionLess, [roomBlock, growBlock])
    sealBlock(roomBlock)
    currentIrBlock = roomBlock
    let data = emitIr1(irListData, classInteger, list, 0)
    irBorrowed[data] = true
    let stored = emitIr(irStoreIndexed, classInteger, [data, count, value], 0)
    let lengthStored = emitIr2(irStoreRaw64, classInteger, list, emitIr2(irAdd, classInteger, count, integerConstant(1), 0), 0)
    jumpTo(joinBlock)
    sealBlock(growBlock)
    currentIrBlock = growBlock
    let pushed = lowerRuntimeCall("runtimeListPush", [list, value])
    jumpTo(joinBlock)
    sealBlock(joinBlock)
    currentIrBlock = joinBlock
}

fn sameVariableNode(left: Node, right: Node) -> bool {
    return left.nodeKind == nodeIdentifier and right.nodeKind == nodeIdentifier and left.auxiliary == right.auxiliary and left.slot == right.slot and left.auxiliary != identifierKindCapture and left.auxiliary != identifierKindFunction
}

// m[k] = m.get(k).or(d) + x (or - x) on int values: one probe. A hit updates
// the slot in place; a miss inserts d + x, the map taking a count of the key.
fn lowerMapUpdate(target: Node, source: Node) -> bool {
    if typeKinds[target.typeIndex] != kindInteger or source.nodeKind != nodeBinary or source.auxiliary != binaryCategoryInteger { return false }
    if source.operator != tokenPlus and source.operator != tokenMinus { return false }
    let lookup = source.children[0]
    let delta = source.children[1]
    if lookup.nodeKind != nodeCall or lookup.auxiliary != callKindRuntimeCall { return false }
    if lookup.name != "runtimeMapGetOrReference" and lookup.name != "runtimeMapGetOrValue" { return false }
    if not sameVariableNode(lookup.children[0].children[0], target.children[0]) or not sameVariableNode(lookup.children[1], target.children[1]) { return false }
    if hasCall(delta) or hasCall(lookup.children[2]) or not functionNameIndices.has("runtimeFindMapEntry") { return false }
    let map = lowerExpression(target.children[0])
    let key = lowerExpression(target.children[1])
    let fallback = lowerExpression(lookup.children[2])
    let deltaValue = lowerExpression(delta)
    if optimizerBailed { return true }
    var combine = irAdd
    if source.operator == tokenMinus { combine = irSubtract }
    let index = lowerRuntimeCall("runtimeFindMapEntry", [map, key])
    let hitBlock = newBlock()
    let missBlock = newBlock()
    let joinBlock = newBlock()
    terminate(irBranchCompare, [index, integerConstant(0)], conditionGreaterOrEqual, [hitBlock, missBlock])
    sealBlock(hitBlock)
    currentIrBlock = hitBlock
    let slots = emitIr1(irLoad, classInteger, map, 16)
    let slot = emitIr2(irAdd, classInteger, slots, emitIr2(irMultiply, classInteger, index, integerConstant(24), 0), 0)
    let updated = emitIr2(combine, classInteger, emitIr1(irLoad, classInteger, slot, 16), deltaValue, 0)
    let stored = emitIr2(irStore, classInteger, slot, updated, 16)
    jumpTo(joinBlock)
    sealBlock(missBlock)
    currentIrBlock = missBlock
    var ownedKey = key
    if isReferenceType(target.children[1].typeIndex) { ownedKey = emitRetain(key) }       // the map keeps the key
    let inserted = lowerRuntimeCall("runtimeMapSet", [map, ownedKey, emitIr2(combine, classInteger, fallback, deltaValue, 0)])
    nonFreeingCalls.push(inserted)
    jumpTo(joinBlock)
    sealBlock(joinBlock)
    currentIrBlock = joinBlock
    return true
}

// a reference into a field or list element: the slot takes the value's count
// and drops the one it held
fn lowerReferenceStore(target: Node, source: Node) {
    let releasing = earlyReleaseVariables
    var noVariables: [int] = []
    earlyReleaseVariables = noVariables
    var address = 0
    if target.nodeKind == nodeMember {
        if typeKinds[target.children[0].typeIndex] != kindStruct {
            optimizerBail("member store to a non-struct")
            return
        }
        let base = lowerContainer(target.children[0], [source])
        let value = takeOwnership(lowerExpression(source))
        if optimizerBailed { return }
        address = emitIr2(irAdd, classInteger, base, integerConstant(8 * target.slot), 0)
        let assigned = lowerRuntimeCall("runtimeAssignReference", [address, value])
        return
    }
    if target.nodeKind != nodeIndex {
        optimizerBail("assignment target kind {target.nodeKind}")
        return
    }
    let elementType = plainListElement(target.children[0].typeIndex)
    if optimizerBailed { return }
    let list = lowerContainer(target.children[0], [target.children[1], source])
    let index = lowerExpression(target.children[1])
    let value = takeOwnership(lowerExpression(source))
    if optimizerBailed { return }
    releaseEarly(releasing)
    let data = lowerElementAddress(list, index, target)
    let offset = emitIr2(irShiftLeft, classInteger, index, integerConstant(3), 0)
    address = emitIr2(irAdd, classInteger, data, offset, 0)
    if isPlainStruct(elementType) {
        lowerReusingStore(address, value, structDefinitions[typeDefinitionIds[elementType]])
        return
    }
    let assigned = lowerRuntimeCall("runtimeAssignReference", [address, value])
}

// a struct type none of whose fields is a reference
fn isPlainStruct(typeIndex: int) -> bool {
    if typeKinds[typeIndex] != kindStruct { return false }
    for fieldType in structDefinitions[typeDefinitionIds[typeIndex]].fieldTypes {
        if isReferenceType(fieldType) { return false }
    }
    return true
}

// *address = value (owned) for a plain struct. When the element it replaces
// has no other holder, the same shape and no descriptor, its fields are
// overwritten in place and value is released: once scalar replacement
// dissolves value, only the fallback allocates.
fn lowerReusingStore(address: int, value: int, structDefinition: StructDefinition) {
    let fieldCount = structDefinition.fieldTypes.len()
    let old = emitIr1(irLoadRaw64, classInteger, address, 0)
    let count = emitIr1(irLoadRaw64, classInteger, old, 0 - 24)
    let shapeBlock = newBlock()
    let reuseBlock = newBlock()
    let assignBlock = newBlock()
    let joinBlock = newBlock()
    terminate(irBranchCompare, [count, integerConstant(1)], conditionEqual, [shapeBlock, assignBlock])
    sealBlock(shapeBlock)
    currentIrBlock = shapeBlock
    let descriptor = emitIr1(irLoadRaw64, classInteger, old, 0 - 16)
    let size = emitIr1(irLoadRaw64, classInteger, old, 0 - 8)
    let mismatch = emitIr2(irBitOr, classInteger, descriptor, emitIr2(irBitXor, classInteger, size, integerConstant(8 * fieldCount), 0), 0)
    terminate(irBranchCompare, [mismatch, integerConstant(0)], conditionEqual, [reuseBlock, assignBlock])
    sealBlock(reuseBlock)
    currentIrBlock = reuseBlock
    for slot in 0..fieldCount {
        if typeKinds[structDefinition.fieldTypes[slot]] == kindFloat {
            let field = emitIr1(irFloatLoad, classFloat, value, 8 * slot)
            let stored = emitIr2(irFloatStore, classFloat, old, field, 8 * slot)
        } else {
            let field = emitIr1(irLoad, classInteger, value, 8 * slot)
            let stored = emitIr2(irStore, classInteger, old, field, 8 * slot)
        }
    }
    emitRelease(value)
    jumpTo(joinBlock)
    sealBlock(assignBlock)
    currentIrBlock = assignBlock
    let assigned = lowerRuntimeCall("runtimeAssignReference", [address, value])
    jumpTo(joinBlock)
    sealBlock(joinBlock)
    currentIrBlock = joinBlock
}

fn lowerIndexRead(expression: Node) -> int {
    if typeKinds[expression.children[0].typeIndex] == kindMap { return lowerMapRead(expression) }
    let elementType = plainListElement(expression.children[0].typeIndex)
    if optimizerBailed { return 0 }
    let list = lowerContainer(expression.children[0], [expression.children[1]])
    let index = lowerExpression(expression.children[1])
    if optimizerBailed { return 0 }
    let data = lowerElementAddress(list, index, expression)
    if typeKinds[elementType] == kindFloat { return emitIr2(irFloatLoadIndexed, classFloat, data, index, 0) }
    let value = emitIr2(irLoadIndexed, classInteger, data, index, 0)
    if isReferenceType(elementType) { irBorrowed[value] = true }
    return value
}

fn isPlainLiteral(expression: Node) -> bool {
    return expression.nodeKind == nodeStringLiteral and expression.children.len() == 1 and expression.children[0].nodeKind == nodeStringText
}

fn lowerPanicAt(expression: Node, message: Node) {
    var messageValue = 0
    if isPlainLiteral(message) { messageValue = emitIr0(irDataAddress, classInteger, addDataString(message.children[0].name)) }
    else { messageValue = lowerExpression(message) }       // a str the panic only reads
    if optimizerBailed { return }
    var noOperands: [int] = []
    terminate(irPanicAt, [messageValue], addDataString(panicSite(expression)), noOperands)
}

fn lowerFixedPanic(stringIndex: int) {
    ensureOpenBlock()
    var noOperands: [int] = []
    var noSuccessors: [int] = []
    terminate(irUnreachable, noOperands, stringIndex, noSuccessors)
}

fn lowerCall(expression: Node) -> int {
    let callKind = expression.auxiliary
    if callKind == callKindSquareRoot { return emitIr1(irFloatSquareRoot, classFloat, lowerExpression(expression.children[1]), 0) }
    if callKind == callKindAbsolute {
        let operand = lowerExpression(expression.children[1])
        if typeKinds[expression.typeIndex] == kindFloat { return emitIr1(irFloatAbsolute, classFloat, operand, 0) }
        return emitIr1(irIntegerAbsolute, classInteger, operand, 0)
    }
    if callKind == callKindMin or callKind == callKindMax {
        let left = lowerExpression(expression.children[1])
        let right = lowerExpression(expression.children[2])
        if expression.operator == 1 {
            if callKind == callKindMin { return emitIr2(irFloatMinimum, classFloat, left, right, 0) }
            return emitIr2(irFloatMaximum, classFloat, left, right, 0)
        }
        if callKind == callKindMin { return emitIr2(irIntegerMinimum, classInteger, left, right, 0) }
        return emitIr2(irIntegerMaximum, classInteger, left, right, 0)
    }
    if callKind == callKindLength {
        let receiver = expression.children[0].children[0]
        let receiverKind = typeKinds[receiver.typeIndex]
        if receiverKind != kindList and receiverKind != kindString and receiverKind != kindMap {
            optimizerBail("len of kind {receiverKind}")
            return 0
        }
        var immutable = 0
        if receiverKind == kindString { immutable = 1 }
        return emitIr1(irListLength, classInteger, lowerExpression(receiver), immutable)
    }
    if callKind == callKindLoad64 or callKind == callKindLoad32 or callKind == callKindLoad16 or callKind == callKindLoad8 {
        var addressNode = expression.children[1]
        let displacement = addressDisplacement(addressNode)
        if displacement != 0 { addressNode = addressBaseNode }
        let address = lowerExpression(addressNode)
        if optimizerBailed { return 0 }
        var opcode = irLoadRaw8
        if callKind == callKindLoad64 { opcode = irLoadRaw64 }
        if callKind == callKindLoad32 { opcode = irLoadRaw32 }
        if callKind == callKindLoad16 { opcode = irLoadRaw16 }
        return emitIr1(opcode, classInteger, address, displacement)
    }
    if callKind == callKindStore64 or callKind == callKindStore32 or callKind == callKindStore8 {
        var addressNode = expression.children[1]
        let displacement = addressDisplacement(addressNode)
        if displacement != 0 { addressNode = addressBaseNode }
        let address = lowerExpression(addressNode)
        let stored = lowerExpression(expression.children[2])
        if optimizerBailed { return 0 }
        var opcode = irStoreRaw8
        if callKind == callKindStore64 { opcode = irStoreRaw64 }
        if callKind == callKindStore32 { opcode = irStoreRaw32 }
        emitIr2(opcode, classInteger, address, stored, displacement)
        return 0
    }
    if callKind == callKindWindows {
        if linuxTargetEnabled or wasmTargetEnabled {
            optimizerBail("win() off Windows")
            return 0
        }
        var operands: [int] = []
        for i in 2..expression.children.len() {
            var argument = lowerExpression(expression.children[i])
            if optimizerBailed { return 0 }
            if irClasses[argument] == classFloat { argument = emitIr1(irBitsFromFloat, classInteger, argument, 0) }
            operands.push(argument)
        }
        regionSymbols.push(windowsImportSymbol(expression.children[1].children[0].name))
        let result = emitIr(irCall, classInteger, operands, 0 - regionSymbols.len())
        irReferenceArguments[result] = 0
        return result
    }
    if callKind == callKindInterfaceDispatch or callKind == callKindIndirect {
        return lowerIndirectCall(expression)
    }
    if callKind == callKindPush {
        var pinned: [int] = []
        let receiver = expression.children[0].children[0]
        let list = pinBeforeLaterCalls(lowerExpression(receiver), receiver, [expression.children[1]], pinned)
        var value = lowerExpression(expression.children[1])
        if optimizerBailed { return 0 }
        if isReferenceType(expression.children[1].typeIndex) { value = takeOwnership(value) }   // the list keeps the count
        if irClasses[value] == classFloat { value = emitIr1(irBitsFromFloat, classInteger, value, 0) }
        lowerListPush(list, value)
        for pinnedValue in pinned { emitRelease(pinnedValue) }
        return 0
    }
    if callKind == callKindOptionalHas {
        let optional = lowerContainer(expression.children[0].children[0], [])
        if optimizerBailed { return 0 }
        return emitIr2(irCompare, classInteger, optional, integerConstant(0), conditionNotEqual)
    }
    if callKind == callKindOptionalGet {
        let optional = lowerContainer(expression.children[0].children[0], [])
        if optimizerBailed { return 0 }
        let checked = emitIr1(irZeroCheck, classInteger, optional, panicStringIndex(expression, "called .get() on a none value"))
        return loadBoxedValue(optional, expression.typeIndex)
    }
    if callKind == callKindOptionalOr {
        let optional = lowerContainer(expression.children[0].children[0], [expression.children[1]])
        if optimizerBailed { return 0 }
        let result = temporaryVariable(classOfType(expression.typeIndex), isReferenceType(expression.typeIndex))
        let someBlock = newBlock()
        let noneBlock = newBlock()
        let joinBlock = newBlock()
        terminate(irBranchCompare, [optional, integerConstant(0)], conditionNotEqual, [someBlock, noneBlock])
        sealBlock(someBlock)
        sealBlock(noneBlock)
        currentIrBlock = someBlock
        writeVariableValue(result, loadBoxedValue(optional, expression.typeIndex))
        jumpTo(joinBlock)
        currentIrBlock = noneBlock
        lowerBranchValue(result, expression.children[1])
        jumpTo(joinBlock)
        sealBlock(joinBlock)
        currentIrBlock = joinBlock
        return readVariableValue(result)
    }
    if callKind == callKindPrint {
        var printed = lowerExpression(expression.children[1])
        if optimizerBailed { return 0 }
        if irClasses[printed] == classFloat { printed = emitIr1(irBitsFromFloat, classInteger, printed, 0) }
        let printedResult = lowerRuntimeCall("runtimePrintTypedValue", [printed, symbolAddress("__td{expression.slot}")])
        return 0
    }
    if callKind == callKindPop {
        let receiver = expression.children[0].children[0]
        let elementType = plainListElement(receiver.typeIndex)
        let list = lowerContainer(receiver, [])
        if optimizerBailed { return 0 }
        // inline: an empty list fails the check (count - 1 is not below count),
        // and the element's count moves out of the list
        let count = emitIr1(irListLength, classInteger, list, 0)
        let lastIndex = emitIr2(irSubtract, classInteger, count, integerConstant(1), 0)
        let checkedIndex = emitIr2(irBoundsCheck, classInteger, count, lastIndex, panicStringIndex(expression, "pop from empty list"))
        let data = emitIr1(irListData, classInteger, list, 0)
        irBorrowed[data] = true
        let lengthStored = emitIr2(irStoreRaw64, classInteger, list, lastIndex, 0)
        if typeKinds[elementType] == kindFloat { return emitIr2(irFloatLoadIndexed, classFloat, data, lastIndex, 0) }
        let popped = emitIr2(irLoadIndexed, classInteger, data, lastIndex, 0)
        if isReferenceType(elementType) { return ownedTemporary(popped) }
        return popped
    }
    if callKind == callKindReadFile or callKind == callKindWriteFile {
        let path = lowerExpression(expression.children[1])
        if optimizerBailed { return 0 }
        let site = emitIr0(irDataAddress, classInteger, addDataString(panicSite(expression)))
        if callKind == callKindReadFile { return ownedTemporary(lowerRuntimeCall("runtimeReadFile", [path, site])) }
        let data = lowerExpression(expression.children[2])
        if optimizerBailed { return 0 }
        let written = lowerRuntimeCall("runtimeWriteFile", [path, data, site])
        return 0
    }
    if callKind == callKindZeros {
        let zeroCount = lowerExpression(expression.children[1])
        if optimizerBailed { return 0 }
        return ownedTemporary(lowerRuntimeCall("runtimeListNew", [zeroCount]))
    }
    if callKind == callKindJoin {
        let joined = lowerContainer(expression.children[0].children[0], [])
        if optimizerBailed { return 0 }
        return ownedTemporary(lowerRuntimeCall("runtimeJoinStringList", [joined]))
    }
    if callKind == callKindCharacter {
        let code = lowerExpression(expression.children[1])
        if optimizerBailed { return 0 }
        let checkedCode = emitIr2(irBoundsCheck, classInteger, integerConstant(256), code, panicStringIndex(expression, "chr out of range"))
        return ownedTemporary(lowerRuntimeCall("runtimeCharacterFromCode", [code]))
    }
    if callKind == callKindSubstring {
        let text = lowerContainer(expression.children[0].children[0], [expression.children[1], expression.children[2]])
        let lower = lowerExpression(expression.children[1])
        let upper = lowerExpression(expression.children[2])
        if optimizerBailed { return 0 }
        let invalid = panicStringIndex(expression, "invalid substring")
        let length = emitIr1(irListLength, classInteger, text, 1)
        let upperChecked = emitIr2(irBoundsCheck, classInteger, emitIr2(irAdd, classInteger, length, integerConstant(1), 0), upper, invalid)   // 0 <= upper <= length
        let lowerChecked = emitIr2(irBoundsCheck, classInteger, emitIr2(irAdd, classInteger, upper, integerConstant(1), 0), lower, invalid)   // 0 <= lower <= upper
        return ownedTemporary(lowerRuntimeCall("runtimeSubstringValue", [text, lower, upper]))
    }
    if callKind == callKindRuntimeCall {         // a method the runtime implements: every argument borrowed
        if not functionNameIndices.has(expression.name) {
            optimizerBail("no {expression.name}")
            return 0
        }
        var arguments: [Node] = [expression.children[0].children[0]]
        for i in 1..expression.children.len() { arguments.push(expression.children[i]) }
        var operands: [int] = []
        var pinned: [int] = []
        let runtimeIndex = functionNameIndices[expression.name]
        if canInline(runtimeIndex) and not hasFunctionArgument(expression) {
            // a small runtime helper: its body in place, on the raw words
            var argumentValues = lowerInlineArguments(arguments, pinned)
            if optimizerBailed { return 0 }
            for i in 0..argumentValues.len() {
                if irClasses[argumentValues[i]] == classFloat { argumentValues[i] = emitIr1(irBitsFromFloat, classInteger, argumentValues[i], 0) }
            }
            let inlinedResult = lowerInlinedCall(runtimeIndex, argumentValues)
            for value in pinned { emitRelease(value) }
            if typeKinds[expression.typeIndex] == kindFloat { return emitIr1(irFloatFromBits, classFloat, inlinedResult, 0) }
            if isReferenceType(expression.typeIndex) { return ownedTemporary(inlinedResult) }
            return inlinedResult
        }
        for i in 0..arguments.len() {
            var value = lowerExpression(arguments[i])
            if optimizerBailed { return 0 }
            value = pinBeforeLaterCalls(value, arguments[i], argumentsAfter(arguments, i), pinned)
            if irClasses[value] == classFloat { value = emitIr1(irBitsFromFloat, classInteger, value, 0) }
            operands.push(value)
        }
        pinArguments(operands, arguments, not hasFunctionArgument(expression), pinned)
        let result = emitIr(irCall, classInteger, operands, functionNameIndices[expression.name])
        for value in pinned { emitRelease(value) }
        if typeKinds[expression.typeIndex] == kindFloat { return emitIr1(irFloatFromBits, classFloat, result, 0) }
        if isReferenceType(expression.typeIndex) { return ownedTemporary(result) }
        return result
    }
    if callKind == callKindByte {
        let text = lowerContainer(expression.children[0].children[0], [expression.children[1]])
        let index = lowerExpression(expression.children[1])
        if optimizerBailed { return 0 }
        let length = emitIr1(irListLength, classInteger, text, 1)
        emitIr2(irBoundsCheck, classInteger, length, index, panicStringIndex(expression, "index out of bounds"))
        return emitIr2(irLoadByte, classInteger, text, index, 0)
    }
    if callKind == callKindBits {                // bits() and floatFromBits(): same bits, retyped
        let operand = lowerExpression(expression.children[1])
        if optimizerBailed { return 0 }
        let resultClass = classOfType(expression.typeIndex)
        if irClasses[operand] == resultClass { return operand }
        if resultClass == classFloat { return emitIr1(irFloatFromBits, classFloat, operand, 0) }
        return emitIr1(irBitsFromFloat, classInteger, operand, 0)
    }
    if callKind == callKindPanic {
        lowerPanicAt(expression, expression.children[1])
        return 0
    }
    if callKind == callKindAssert {
        if expression.children[1].nodeKind == nodeBoolean and expression.children[1].integerValue == 1 { return 0 }
        let okBlock = newBlock()
        let failBlock = newBlock()
        lowerCondition(expression.children[1], okBlock, failBlock)
        sealBlock(okBlock)
        sealBlock(failBlock)
        currentIrBlock = failBlock
        if expression.children.len() > 2 { lowerPanicAt(expression, expression.children[2]) }
        else { lowerFixedPanic(panicStringIndex(expression, "assertion failed")) }
        currentIrBlock = okBlock
        return 0
    }
    if callKind != callKindUser {
        optimizerBail("call kind {callKind}")
        return 0
    }
    let functionDefinition = functionDefinitions[expression.referenceIndex]
    var callArguments: [Node] = []
    if expression.operator == 1 { callArguments.push(expression.children[0].children[0]) }        // UFCS receiver
    for i in 1..expression.children.len() { callArguments.push(expression.children[i]) }
    if functionDefinition.name == "runtimeFail" and callArguments.len() == 1 and isPlainLiteral(callArguments[0]) {
        lowerFixedPanic(panicStringIndex(expression, callArguments[0].children[0].name))
        return 0
    }
    if functionDefinition.hasEnvironment {
        optimizerBail("call to {functionDefinition.name}")
        return 0
    }
    var operands: [int] = []
    var pinned: [int] = []
    var referenceMask = 0
    if canInline(expression.referenceIndex) or (hasClosureArgument(callArguments) and canInlineWithin(expression.referenceIndex, 300)) {
        let argumentValues = lowerInlineArguments(callArguments, pinned)
        if optimizerBailed { return 0 }
        let inlinedResult = lowerInlinedCall(expression.referenceIndex, argumentValues)
        for value in pinned { emitRelease(value) }
        if isReferenceType(functionDefinition.returnType) { return ownedTemporary(inlinedResult) }
        return inlinedResult
    }
    for i in 0..callArguments.len() {
        var value = lowerExpression(callArguments[i])
        if optimizerBailed { return 0 }
        value = pinBeforeLaterCalls(value, callArguments[i], argumentsAfter(callArguments, i), pinned)
        if isReferenceType(callArguments[i].typeIndex) { referenceMask = referenceMask | (1 << i) }
        if irClasses[value] == classFloat { value = emitIr1(irBitsFromFloat, classInteger, value, 0) }
        operands.push(value)
    }
    if callArguments.len() > 60 {
        optimizerBail("too many arguments")
        return 0
    }
    pinArguments(operands, callArguments, false, pinned)
    let result = emitIr(irCall, classInteger, operands, expression.referenceIndex)
    irReferenceArguments[result] = referenceMask
    for value in pinned { emitRelease(value) }
    if typeKinds[functionDefinition.returnType] == kindFloat { return emitIr1(irFloatFromBits, classFloat, result, 0) }
    if isReferenceType(functionDefinition.returnType) { return ownedTemporary(result) }
    return result
}

fn countNodes(node: Node) -> int {
    var count = 1
    for child in node.children { count += countNodes(child) }
    return count
}

// small, non-recursive, no captured environment
let inlineRegionValueBudget = 16000
let regionValueLimit = 24000
var functionNodeCounts: [int: int] = [:]      // function index -> countNodes of its body, for inlining decisions

fn canInline(functionIndex: int) -> bool {
    if functionDefinitions[functionIndex].hasEnvironment { return false }
    return canInlineWithin(functionIndex, 60)
}

fn canInlineWithin(functionIndex: int, nodeLimit: int) -> bool {
    if not inliningEnabled or inlineStack.len() >= 3 or functionIndex == regionFunctionIndex { return false }
    let functionDefinition = functionDefinitions[functionIndex]
    if functionDefinition.name == "runtimeCollectGarbage" { return false }
    for active in inlineStack {
        if active == functionIndex { return false }
    }
    if irOpcodes.len() > inlineRegionValueBudget { return false }      // a huge region costs more to allocate than calls cost to run
    if not functionNodeCounts.has(functionIndex) { functionNodeCounts[functionIndex] = countNodes(functionDefinition.body) }
    return functionNodeCounts[functionIndex] <= nodeLimit
}

// a closure literal argument: inlining the callee lets its calls through it inline too
fn hasClosureArgument(callArguments: [Node]) -> bool {
    for argument in callArguments {
        if argument.nodeKind == nodeFunctionLiteral { return true }
    }
    return false
}


// switch lowering into a callee's key space, its parameters bound to the argument values
fn enterInlinedBody(functionIndex: int, argumentValues: [int], captureValues: [int]) {
    let functionDefinition = functionDefinitions[functionIndex]
    inlinedCallCount += 1
    inlineInstanceCount += 1
    inlineFrames.push(InlineFrame{prefix: inlineKeyPrefix, ownedSlots: ownedLocalSlots, sourceMakesCalls: regionSourceMakesCalls,
        returnBlock: regionReturnBlock, returnVariable: regionReturnVariable, returnType: regionReturnType,
        returnScopeDepth: regionReturnScopeDepth, returnTemporaryMark: regionReturnTemporaryMark, captureValues: inlineCaptureValues})
    inlineCaptureValues = captureValues
    inlineKeyPrefix = "i{inlineInstanceCount}:"
    var calleeOwnedSlots: [int: bool] = [:]
    ownedLocalSlots = calleeOwnedSlots
    findOwnedLocals(functionDefinition.body)
    inlineStack.push(functionIndex)
    for i in 0..argumentValues.len() {
        let parameter = variableForSlot(identifierKindParameter, i, functionDefinition.parameterTypes[i])
        if optimizerBailed { return }
        declareVariable(parameter, argumentValues[i])
        variableKnownClosure[parameter] = knownClosureOf(argumentValues[i])      // never reassigned: a reference parameter
    }
}

fn knownClosureOf(value: int) -> int {
    for i in 0..knownClosureCells.len() {
        if knownClosureCells[i] == value { return i }
    }
    return 0 - 1
}

// the known closure a call's function value is, else -1
fn knownClosureOfNode(cellNode: Node) -> int {
    if cellNode.nodeKind != nodeIdentifier or cellNode.auxiliary != identifierKindParameter or inlineKeyPrefix == "" { return 0 - 1 }
    let variable = identifierVariable(cellNode)
    if optimizerBailed { return 0 - 1 }
    return variableKnownClosure[variable]
}

fn leaveInlinedBody() {
    let frame = inlineFrames.pop()
    let poppedInline = inlineStack.pop()
    inlineKeyPrefix = frame.prefix
    ownedLocalSlots = frame.ownedSlots
    regionSourceMakesCalls = frame.sourceMakesCalls
    regionReturnBlock = frame.returnBlock
    regionReturnVariable = frame.returnVariable
    regionReturnType = frame.returnType
    regionReturnScopeDepth = frame.returnScopeDepth
    regionReturnTemporaryMark = frame.returnTemporaryMark
    inlineCaptureValues = frame.captureValues
}

// the callee's body, in place: its parameters are the argument values, its
// returns jump to one join block
fn lowerInlinedCall(functionIndex: int, argumentValues: [int]) -> int {
    var noCaptures: [int] = []
    return lowerInlinedBody(functionIndex, argumentValues, noCaptures)
}

fn lowerInlinedBody(functionIndex: int, argumentValues: [int], captureValues: [int]) -> int {
    let functionDefinition = functionDefinitions[functionIndex]
    enterInlinedBody(functionIndex, argumentValues, captureValues)
    if optimizerBailed { return 0 }
    regionReturnType = functionDefinition.returnType
    regionReturnBlock = newBlock()
    regionReturnScopeDepth = ownedScopes.len()
    regionReturnTemporaryMark = pendingTemporaries.len()
    let hasValue = typeKinds[regionReturnType] != kindVoid
    if hasValue { regionReturnVariable = temporaryVariable(classOfType(regionReturnType), false) }
    lowerBlock(functionDefinition.body)
    var result = 0
    if not optimizerBailed {
        jumpTo(regionReturnBlock)
        sealBlock(regionReturnBlock)
        currentIrBlock = regionReturnBlock
        if hasValue { result = readVariable(regionReturnVariable, currentIrBlock) }
    }
    leaveInlinedBody()
    return result
}

// `return <expression>` and nothing else
fn isSingleReturn(body: Node) -> bool {
    return body.children.len() == 1 and body.children[0].nodeKind == nodeReturn and body.children[0].children[0].nodeKind != nodeNone
}

fn callArgumentNodes(expression: Node) -> [Node] {
    var callArguments: [Node] = []
    if expression.operator == 1 { callArguments.push(expression.children[0].children[0]) }        // UFCS receiver
    for i in 1..expression.children.len() { callArguments.push(expression.children[i]) }
    return callArguments
}

// the argument values of an inlined call; borrowed references that need a count go in `pinned`
fn lowerInlineArguments(callArguments: [Node], pinned: [int]) -> [int] {
    var argumentValues: [int] = []
    for i in 0..callArguments.len() {
        let value = lowerExpression(callArguments[i])
        if optimizerBailed { return argumentValues }
        argumentValues.push(pinBeforeLaterCalls(value, callArguments[i], argumentsAfter(callArguments, i), pinned))
    }
    pinArguments(argumentValues, callArguments, false, pinned)
    return argumentValues
}

// branch to trueBlock or falseBlock; compares fuse into the branch
// the operand an integer compare tests against a literal: 0 or 1, else -1
fn comparedOperandIndex(compare: Node) -> int {
    if compare.nodeKind != nodeBinary or compare.auxiliary != binaryCategoryInteger or conditionForToken(compare.operator) < 0 { return 0 - 1 }
    if compare.children[1].nodeKind == nodeInteger and compare.children[0].nodeKind != nodeInteger { return 0 }
    if compare.children[0].nodeKind == nodeInteger and compare.children[1].nodeKind != nodeInteger { return 1 }
    return 0 - 1
}

// the smallest x `compare` admits (x >= c, x > c, c <= x, c < x), with found in bounds
var rangeBoundFound = false
fn lowerBoundOf(compare: Node, operandIndex: int) -> int {
    let operator = compare.operator
    rangeBoundFound = true
    if operandIndex == 0 {
        let constant = compare.children[1].integerValue
        if operator == tokenGreaterOrEqual { return constant }
        if operator == tokenGreaterThan { return constant + 1 }
    } else {
        let constant = compare.children[0].integerValue
        if operator == tokenLessOrEqual { return constant }
        if operator == tokenLessThan { return constant + 1 }
    }
    rangeBoundFound = false
    return 0
}

fn upperBoundOf(compare: Node, operandIndex: int) -> int {
    let operator = compare.operator
    rangeBoundFound = true
    if operandIndex == 0 {
        let constant = compare.children[1].integerValue
        if operator == tokenLessOrEqual { return constant }
        if operator == tokenLessThan { return constant - 1 }
    } else {
        let constant = compare.children[0].integerValue
        if operator == tokenGreaterOrEqual { return constant }
        if operator == tokenGreaterThan { return constant - 1 }
    }
    rangeBoundFound = false
    return 0
}

// `lo <= x and x <= hi` on one variable: (x - lo) <=u (hi - lo), one branch
fn lowerRangeCheck(condition: Node, trueBlock: int, falseBlock: int) -> bool {
    let first = condition.children[0]
    let second = condition.children[1]
    let firstIndex = comparedOperandIndex(first)
    let secondIndex = comparedOperandIndex(second)
    if firstIndex < 0 or secondIndex < 0 { return false }
    let operand = first.children[firstIndex]
    if not sameVariableNode(operand, second.children[secondIndex]) { return false }
    var low = lowerBoundOf(first, firstIndex)
    var lowFound = rangeBoundFound
    var high = upperBoundOf(second, secondIndex)
    var highFound = rangeBoundFound
    if not lowFound or not highFound {                    // x <= hi and x >= lo
        low = lowerBoundOf(second, secondIndex)
        lowFound = rangeBoundFound
        high = upperBoundOf(first, firstIndex)
        highFound = rangeBoundFound
    }
    if not lowFound or not highFound or low > high or low < 0 - 1073741824 or high > 1073741824 { return false }
    let value = lowerExpression(operand)
    if optimizerBailed { return true }
    ensureOpenBlock()
    let offset = emitIr2(irSubtract, classInteger, value, integerConstant(low), 0)
    terminate(irBranchCompare, [offset, integerConstant(high - low)], conditionBelowOrEqual, [trueBlock, falseBlock])
    return true
}

fn lowerCondition(condition: Node, trueBlock: int, falseBlock: int) {
    if optimizerBailed { return }
    let mark = pendingTemporaries.len()
    let kind = condition.nodeKind
    if kind == nodeBoolean {
        if condition.integerValue == 1 { jumpTo(trueBlock) } else { jumpTo(falseBlock) }
        return
    }
    if kind == nodeNot {
        lowerCondition(condition.children[0], falseBlock, trueBlock)
        return
    }
    if kind == nodeBinary and condition.operator == tokenAnd and lowerRangeCheck(condition, trueBlock, falseBlock) { return }
    if kind == nodeBinary and (condition.operator == tokenAnd or condition.operator == tokenOr) {
        let middleBlock = newBlock()
        if condition.operator == tokenAnd { lowerCondition(condition.children[0], middleBlock, falseBlock) }
        else { lowerCondition(condition.children[0], trueBlock, middleBlock) }
        sealBlock(middleBlock)
        currentIrBlock = middleBlock
        lowerCondition(condition.children[1], trueBlock, falseBlock)
        return
    }
    if kind == nodeBinary and conditionForToken(condition.operator) >= 0 and condition.auxiliary != binaryCategoryString {
        let left = lowerExpression(condition.children[0])
        let right = lowerExpression(condition.children[1])
        if optimizerBailed { return }
        ensureOpenBlock()
        releaseTemporariesFrom(mark)
        var opcode = irBranchCompare
        if condition.auxiliary == binaryCategoryFloat { opcode = irBranchFloatCompare }
        terminate(opcode, [left, right], conditionForToken(condition.operator), [trueBlock, falseBlock])
        return
    }
    if kind == nodeCall and condition.auxiliary == callKindUser and canInline(condition.referenceIndex) and isSingleReturn(functionDefinitions[condition.referenceIndex].body) {
        var pinned: [int] = []
        let argumentValues = lowerInlineArguments(callArgumentNodes(condition), pinned)
        if optimizerBailed { return }
        if pinned.len() == 0 and pendingTemporaries.len() == mark {
            var noCaptures: [int] = []
            enterInlinedBody(condition.referenceIndex, argumentValues, noCaptures)
            if optimizerBailed { return }
            lowerCondition(functionDefinitions[condition.referenceIndex].body.children[0].children[0], trueBlock, falseBlock)
            leaveInlinedBody()
            return
        }
        let inlinedResult = lowerInlinedCall(condition.referenceIndex, argumentValues)
        for pinnedValue in pinned { emitRelease(pinnedValue) }
        ensureOpenBlock()
        releaseTemporariesFrom(mark)
        terminate(irBranch, [inlinedResult], 0, [trueBlock, falseBlock])
        return
    }
    let value = lowerExpression(condition)
    if optimizerBailed { return }
    ensureOpenBlock()
    releaseTemporariesFrom(mark)
    terminate(irBranch, [value], 0, [trueBlock, falseBlock])
}

fn lowerStatement(statement: Node) {
    if optimizerBailed { return }
    let mark = pendingTemporaries.len()
    lowerStatementKind(statement)
    if optimizerBailed { return }
    releaseTemporariesFrom(mark)
}

fn pushLoopTargets(breakTarget: int, continueTarget: int) {
    regionBreakTargets.push(breakTarget)
    regionContinueTargets.push(continueTarget)
    regionLoopScopeDepths.push(ownedScopes.len())
    regionLoopTemporaryMarks.push(pendingTemporaries.len())
}

fn popLoopTargets() {
    let poppedBreak = regionBreakTargets.pop()
    let poppedContinue = regionContinueTargets.pop()
    let poppedDepth = regionLoopScopeDepths.pop()
    let poppedMark = regionLoopTemporaryMarks.pop()
}

// for i in lo..hi { L[i] = v }: leaf bounds and value, a list of plain values
fn isPlainFillLoop(statement: Node) -> bool {
    let body = statement.children[2]
    if body.children.len() != 1 or body.children[0].nodeKind != nodeAssign { return false }
    if not isLeaf(statement.children[0]) or not isLeaf(statement.children[1]) { return false }
    let target = body.children[0].children[0]
    let value = body.children[0].children[1]
    if target.nodeKind != nodeIndex or target.children[0].nodeKind != nodeIdentifier or typeKinds[target.children[0].typeIndex] != kindList { return false }
    let elementType = typeElementIds[target.children[0].typeIndex]
    let elementKind = typeKinds[elementType]
    if elementKind != kindInteger and elementKind != kindFloat and elementKind != kindBoolean { return false }
    let index = target.children[1]
    if index.nodeKind != nodeIdentifier or index.auxiliary != identifierKindLocal or index.slot != statement.slot { return false }
    return isLeaf(value) and not usesLocal(value, statement.slot)
}

var loweringFillFallback = false

// in range: one runtime fill; otherwise the plain loop, which fails at the right element
fn lowerFillLoop(statement: Node) {
    let assignment = statement.children[2].children[0]
    let list = lowerExpression(assignment.children[0].children[0])
    let low = lowerExpression(statement.children[0])
    let high = lowerExpression(statement.children[1])
    var value = lowerExpression(assignment.children[1])
    if optimizerBailed { return }
    if irClasses[value] == classFloat { value = emitIr1(irBitsFromFloat, classInteger, value, 0) }
    let checkLowBlock = newBlock()
    let checkHighBlock = newBlock()
    let fastBlock = newBlock()
    let slowBlock = newBlock()
    let joinBlock = newBlock()
    terminate(irBranchCompare, [low, high], conditionLess, [checkLowBlock, joinBlock])
    sealBlock(checkLowBlock)
    currentIrBlock = checkLowBlock
    terminate(irBranchCompare, [low, integerConstant(0)], conditionGreaterOrEqual, [checkHighBlock, slowBlock])
    sealBlock(checkHighBlock)
    currentIrBlock = checkHighBlock
    let length = emitIr1(irListLength, classInteger, list, 0)
    terminate(irBranchCompare, [high, length], conditionLessOrEqual, [fastBlock, slowBlock])
    sealBlock(fastBlock)
    currentIrBlock = fastBlock
    let data = emitIr1(irListData, classInteger, list, 0)
    irBorrowed[data] = true
    let address = emitIr2(irAdd, classInteger, data, emitIr2(irShiftLeft, classInteger, low, integerConstant(3), 0), 0)
    let filled = lowerRuntimeCall("runtimeFillWords", [address, value, emitIr2(irSubtract, classInteger, high, low, 0)])
    jumpTo(joinBlock)
    sealBlock(slowBlock)
    currentIrBlock = slowBlock
    loweringFillFallback = true
    lowerStatementKind(statement)
    loweringFillFallback = false
    if not blockTerminated[currentIrBlock] { jumpTo(joinBlock) }
    sealBlock(joinBlock)
    currentIrBlock = joinBlock
}

fn lowerStatementKind(statement: Node) {
    let kind = statement.nodeKind
    if kind == nodeDeclaration {
        let value = lowerExpression(statement.children[0])
        if optimizerBailed { return }
        let variable = variableForSlot(statement.auxiliary, statement.slot, statement.typeIndex)
        if optimizerBailed { return }
        storeVariable(variable, value, true)
        return
    }
    if kind == nodeAssign {
        let target = statement.children[0]
        if target.nodeKind == nodeIdentifier and lowerStringAppend(target, statement.children[1]) { return }
        if target.nodeKind == nodeIdentifier {
            let value = lowerExpression(statement.children[1])
            if optimizerBailed { return }
            assignVariable(target, value)
            return
        }
        if target.nodeKind == nodeIndex and typeKinds[target.children[0].typeIndex] == kindMap and lowerMapUpdate(target, statement.children[1]) { return }
        if target.nodeKind == nodeIndex and typeKinds[target.children[0].typeIndex] == kindMap {
            // the map takes the key's count and the value's
            let map = lowerContainer(target.children[0], [target.children[1], statement.children[1]])
            var key = lowerExpression(target.children[1])
            if optimizerBailed { return }
            if isReferenceType(target.children[1].typeIndex) { key = takeOwnership(key) }
            var value = lowerExpression(statement.children[1])
            if optimizerBailed { return }
            if isReferenceType(target.typeIndex) { value = takeOwnership(value) }
            if irClasses[value] == classFloat { value = emitIr1(irBitsFromFloat, classInteger, value, 0) }
            let stored = lowerRuntimeCall("runtimeMapSet", [map, key, value])
            if not isReferenceType(target.typeIndex) { nonFreeingCalls.push(stored) }    // it can only drop the key count it was handed
            return
        }
        if isReferenceType(target.typeIndex) {
            lowerReferenceStore(target, statement.children[1])
            return
        }
        if target.nodeKind == nodeMember {
            if typeKinds[target.children[0].typeIndex] != kindStruct {
                optimizerBail("member store to a non-struct")
                return
            }
            let base = lowerExpression(target.children[0])
            let value = lowerExpression(statement.children[1])
            if optimizerBailed { return }
            if irClasses[value] == classFloat { let stored = emitIr2(irFloatStore, classFloat, base, value, 8 * target.slot) }
            else { let stored = emitIr2(irStore, classInteger, base, value, 8 * target.slot) }
            return
        }
        if target.nodeKind == nodeIndex {
            let elementType = plainListElement(target.children[0].typeIndex)
            if optimizerBailed { return }
            let list = lowerExpression(target.children[0])
            let index = lowerExpression(target.children[1])
            let value = lowerExpression(statement.children[1])
            if optimizerBailed { return }
            let data = lowerElementAddress(list, index, target)
            if irClasses[value] == classFloat { let stored = emitIr(irFloatStoreIndexed, classFloat, [data, index, value], 0) }
            else { let stored = emitIr(irStoreIndexed, classInteger, [data, index, value], 0) }
            return
        }
        optimizerBail("assignment target kind {target.nodeKind}")
        return
    }
    if kind == nodeIf {
        let thenBlock = newBlock()
        let joinBlock = newBlock()
        var elseBlock = joinBlock
        let hasElse = statement.children[2].nodeKind != nodeNone
        if hasElse { elseBlock = newBlock() }
        lowerCondition(statement.children[0], thenBlock, elseBlock)
        sealBlock(thenBlock)
        currentIrBlock = thenBlock
        lowerBlock(statement.children[1])
        jumpTo(joinBlock)
        if hasElse {
            sealBlock(elseBlock)
            currentIrBlock = elseBlock
            lowerBlock(statement.children[2])
            jumpTo(joinBlock)
        }
        sealBlock(joinBlock)
        currentIrBlock = joinBlock
        return
    }
    if kind == nodeWhile {
        currentLoopDepth += 1
        let headerBlock = newBlock()
        let bodyBlock = newBlock()
        currentLoopDepth -= 1
        let exitBlock = newBlock()
        jumpTo(headerBlock)
        currentIrBlock = headerBlock
        lowerCondition(statement.children[0], bodyBlock, exitBlock)
        sealBlock(bodyBlock)
        pushLoopTargets(exitBlock, headerBlock)
        currentLoopDepth += 1
        currentIrBlock = bodyBlock
        lowerBlock(statement.children[1])
        jumpTo(headerBlock)
        currentLoopDepth -= 1
        popLoopTargets()
        sealBlock(headerBlock)
        sealBlock(exitBlock)
        currentIrBlock = exitBlock
        return
    }
    if kind == nodeRangeLoop and not loweringFillFallback and isPlainFillLoop(statement) {
        lowerFillLoop(statement)
        return
    }
    if kind == nodeRangeLoop {
        let start = lowerExpression(statement.children[0])
        let limit = lowerExpression(statement.children[1])
        if optimizerBailed { return }
        let loopVariable = variableNumber(identifierKindLocal, statement.slot, classInteger, false)
        declareVariable(loopVariable, start)
        currentLoopDepth += 1
        let headerBlock = newBlock()
        let bodyBlock = newBlock()
        let stepBlock = newBlock()
        currentLoopDepth -= 1
        let exitBlock = newBlock()
        jumpTo(headerBlock)
        currentIrBlock = headerBlock
        let current = readVariable(loopVariable, headerBlock)
        terminate(irBranchCompare, [current, limit], conditionLess, [bodyBlock, exitBlock])
        sealBlock(bodyBlock)
        pushLoopTargets(exitBlock, stepBlock)
        currentLoopDepth += 1
        currentIrBlock = bodyBlock
        lowerBlock(statement.children[2])
        jumpTo(stepBlock)
        sealBlock(stepBlock)
        currentIrBlock = stepBlock
        let incremented = emitIr2(irAdd, classInteger, readVariable(loopVariable, stepBlock), integerConstant(1), 0)
        writeVariableValue(loopVariable, incremented)
        jumpTo(headerBlock)
        currentLoopDepth -= 1
        popLoopTargets()
        sealBlock(headerBlock)
        sealBlock(exitBlock)
        currentIrBlock = exitBlock
        return
    }
    if kind == nodeIterableLoop {
        let elementType = plainListElement(statement.children[0].typeIndex)
        if optimizerBailed { return }
        // a body that can free: the list holds a count for the loop, each element one for its iteration
        let bodyMayFree = mayCallFreeingCode(statement.children[1]) or storesReleasingReferences(statement.children[1])
        var list = lowerExpression(statement.children[0])
        if optimizerBailed { return }
        if bodyMayFree and irBorrowed[list] { list = ownedTemporary(emitRetain(list)) }
        let indexVariable = temporaryVariable(classInteger, false)
        writeVariableValue(indexVariable, integerConstant(0))
        let elementVariable = variableForSlot(identifierKindLocal, statement.slot, elementType)
        if optimizerBailed { return }
        let elementOwned = isOwnedVariable(elementVariable) or (bodyMayFree and isReferenceType(elementType))
        variableOwnsValue[elementVariable] = elementOwned
        currentLoopDepth += 1
        let headerBlock = newBlock()
        let bodyBlock = newBlock()
        let stepBlock = newBlock()
        currentLoopDepth -= 1
        let exitBlock = newBlock()
        jumpTo(headerBlock)
        currentIrBlock = headerBlock
        let length = emitIr1(irListLength, classInteger, list, 0)
        terminate(irBranchCompare, [readVariable(indexVariable, headerBlock), length], conditionLess, [bodyBlock, exitBlock])
        sealBlock(bodyBlock)
        currentLoopDepth += 1
        currentIrBlock = bodyBlock
        let data = emitIr1(irListData, classInteger, list, 0)
        irBorrowed[data] = true
        let index = readVariable(indexVariable, bodyBlock)
        var element = 0
        if typeKinds[elementType] == kindFloat { element = emitIr2(irFloatLoadIndexed, classFloat, data, index, 0) }
        else {
            element = emitIr2(irLoadIndexed, classInteger, data, index, 0)
            if isReferenceType(elementType) { irBorrowed[element] = true }
        }
        pushLoopTargets(exitBlock, stepBlock)
        var elementScope: [int] = []
        if elementOwned {
            element = emitRetain(element)
            elementScope.push(elementVariable)
        }
        ownedScopes.push(elementScope)
        declareVariable(elementVariable, element)
        lowerBlock(statement.children[1])
        if not blockTerminated[currentIrBlock] { releaseScopesFrom(ownedScopes.len() - 1) }
        let closedElementScope = ownedScopes.pop()
        jumpTo(stepBlock)
        sealBlock(stepBlock)
        currentIrBlock = stepBlock
        let incremented = emitIr2(irAdd, classInteger, readVariable(indexVariable, stepBlock), integerConstant(1), 0)
        writeVariableValue(indexVariable, incremented)
        jumpTo(headerBlock)
        currentLoopDepth -= 1
        popLoopTargets()
        sealBlock(headerBlock)
        sealBlock(exitBlock)
        currentIrBlock = exitBlock
        return
    }
    if kind == nodeReturn {
        if not regionIsFunction and inlineStack.len() == 0 {
            optimizerBail("return inside an outlined loop")
            return
        }
        var movedVariable = 0 - 1
        if statement.children[0].nodeKind != nodeNone {
            var value = lowerExpression(statement.children[0])
            if optimizerBailed { return }
            if isReferenceType(regionReturnType) {                                    // the caller gets a count
                movedVariable = ownedVariableLeaving(statement.children[0], regionReturnScopeDepth)
                if movedVariable < 0 { value = takeOwnership(value) }                // a dying local hands its own over
            }
            writeVariableValue(regionReturnVariable, value)
        }
        ensureOpenBlock()
        releaseTemporariesOnExit(regionReturnTemporaryMark)
        releaseScopesExcept(regionReturnScopeDepth, movedVariable)
        jumpTo(regionReturnBlock)
        return
    }
    if kind == nodeBreak or kind == nodeContinue {
        let levels = statement.integerValue
        if levels >= regionBreakTargets.len() {
            optimizerBail("break/continue out of the region")
            return
        }
        let target = regionBreakTargets.len() - 1 - levels
        ensureOpenBlock()
        releaseTemporariesOnExit(regionLoopTemporaryMarks[target])
        releaseScopesFrom(regionLoopScopeDepths[target])
        if kind == nodeBreak { jumpTo(regionBreakTargets[target]) }
        else { jumpTo(regionContinueTargets[target]) }
        return
    }
    if kind == nodeInline {
        let endBlock = newBlock()
        regionInlineEnds.push(endBlock)
        regionInlineSlots.push(statement.slot)
        regionInlineTypes.push(statement.typeIndex)
        regionInlineScopeDepths.push(ownedScopes.len())
        regionInlineTemporaryMarks.push(pendingTemporaries.len())
        var bodyVariables: [int] = []
        ownedScopes.push(bodyVariables)                 // the body's own locals die at its end
        for innerStatement in statement.children {
            if optimizerBailed { return }
            lowerStatement(innerStatement)
        }
        if not blockTerminated[currentIrBlock] { releaseScopesFrom(ownedScopes.len() - 1) }
        let closedScope = ownedScopes.pop()
        jumpTo(endBlock)
        let poppedEnd = regionInlineEnds.pop()
        let poppedSlot = regionInlineSlots.pop()
        let poppedType = regionInlineTypes.pop()
        let poppedDepth = regionInlineScopeDepths.pop()
        let poppedMark = regionInlineTemporaryMarks.pop()
        sealBlock(endBlock)
        currentIrBlock = endBlock
        if isReferenceType(statement.typeIndex) {      // the result slot owns what the body returned, until its block ends
            let resultVariable = variableForSlot(identifierKindLocal, statement.slot, statement.typeIndex)
            variableOwnsValue[resultVariable] = true
            variableIsInlineResult[resultVariable] = true
            ownedScopes[ownedScopes.len() - 1].push(resultVariable)
        }
        return
    }
    if kind == nodeInlineReturn {
        if regionInlineEnds.len() == 0 {
            optimizerBail("inline return outside an inline")
            return
        }
        let last = regionInlineEnds.len() - 1
        var movedVariable = 0 - 1
        if statement.children[0].nodeKind != nodeNone {
            var value = lowerExpression(statement.children[0])
            if optimizerBailed { return }
            if isReferenceType(regionInlineTypes[last]) {
                movedVariable = ownedVariableLeaving(statement.children[0], regionInlineScopeDepths[last])
                if movedVariable < 0 { value = takeOwnership(value) }       // a dying local hands its count over instead
            }
            let variable = variableForSlot(identifierKindLocal, regionInlineSlots[last], statement.children[0].typeIndex)
            if optimizerBailed { return }
            declareVariable(variable, value)
        }
        ensureOpenBlock()
        releaseTemporariesOnExit(regionInlineTemporaryMarks[last])
        releaseScopesExcept(regionInlineScopeDepths[last], movedVariable)
        jumpTo(regionInlineEnds[last])
        return
    }
    if kind == nodeExpressionStatement {
        let discarded = lowerExpression(statement.children[0])
        return
    }
    if kind == nodeOutlinedLoop {                // a whole function that contains an outlined loop: lower the loop itself
        lowerStatement(statement.children[0])
        return
    }
    optimizerBail("statement kind {kind}")
}

// does any call in this subtree reach user code (which may touch globals)?
// a reference global assigned in the region: only memory mode can store it
fn assignsReferenceGlobal(node: Node) -> bool {
    if node.nodeKind == nodeAssign and node.children[0].nodeKind == nodeIdentifier and node.children[0].auxiliary == identifierKindGlobal and isReferenceType(node.children[0].typeIndex) { return true }
    for child in node.children {
        if assignsReferenceGlobal(child) { return true }
    }
    return false
}

// A callee that never reads or writes a global (nor calls one that does) can
// run while the region keeps globals in registers.
var functionGlobalStates: [int] = []        // by function: 0 unknown, 1 being scanned, 2 touches none, 3 touches some

fn functionTouchesGlobals(functionIndex: int) -> bool {
    while functionGlobalStates.len() < functionDefinitions.len() { functionGlobalStates.push(0) }
    let state = functionGlobalStates[functionIndex]
    if state == 1 or state == 3 { return true }
    if state == 2 { return false }
    functionGlobalStates[functionIndex] = 1
    let functionDefinition = functionDefinitions[functionIndex]
    let touches = functionDefinition.hasEnvironment or subtreeTouchesGlobals(functionDefinition.body)
    functionGlobalStates[functionIndex] = 2
    if touches { functionGlobalStates[functionIndex] = 3 }
    return touches
}

fn subtreeTouchesGlobals(node: Node) -> bool {
    if node.nodeKind == nodeIdentifier and node.auxiliary == identifierKindGlobal { return true }
    if node.nodeKind == nodeDeclaration and node.auxiliary == identifierKindGlobal { return true }
    if node.nodeKind == nodeFunctionLiteral { return true }
    if subtreeHasUserCallAt(node) { return true }
    for child in node.children {
        if subtreeTouchesGlobals(child) { return true }
    }
    return false
}

// this node itself: a call that may reach code touching the region's globals
fn subtreeHasUserCallAt(node: Node) -> bool {
    if node.nodeKind != nodeCall { return false }
    let callKind = node.auxiliary
    if callKind == callKindUser and functionDefinitions[node.referenceIndex].name != "runtimeFail" { return functionTouchesGlobals(node.referenceIndex) }
    if callKind == callKindIndirect or callKind == callKindInterfaceDispatch or callKind == callKindFunctionPointerCall or callKind == callKindWindows { return true }
    return callKind == callKindRuntimeCall and hasFunctionArgument(node)
}

fn subtreeHasUserCall(node: Node) -> bool {
    if node.nodeKind == nodeCall {
        let callKind = node.auxiliary
        if callKind == callKindUser and functionDefinitions[node.referenceIndex].name != "runtimeFail" and functionTouchesGlobals(node.referenceIndex) { return true }
        if callKind == callKindIndirect or callKind == callKindInterfaceDispatch or callKind == callKindFunctionPointerCall or callKind == callKindWindows { return true }
        if callKind == callKindRuntimeCall and hasFunctionArgument(node) { return true }
    }
    for child in node.children {
        if subtreeHasUserCall(child) { return true }
    }
    return false
}

// write the variables a region changed back to their homes, at an exit
fn writeBackVariables() {
    for variable in 0..variableClasses.len() {
        if not variableWritten[variable] or variableIsReference[variable] { continue }
        let kind = variableHomeKind[variable]
        if kind == identifierKindTemporary { continue }
        if kind == identifierKindGlobal {
            if regionGlobalsInMemory { continue }     // already stored where it was written
            let value = readVariable(variable, currentIrBlock)
            if variableClasses[variable] == classFloat { let stored = emitIr1(irFloatStoreGlobal, classFloat, value, variableHomeIndex[variable]) }
            else { let stored = emitIr1(irStoreGlobal, classInteger, value, variableHomeIndex[variable]) }
        } else if not regionIsFunction {
            let value = readVariable(variable, currentIrBlock)
            let offset = parentSlotOffset(kind, variableHomeIndex[variable])
            if variableClasses[variable] == classFloat { let stored = emitIr2(irFloatStoreFrame, classFloat, regionFrameValue, value, offset) }
            else { let stored = emitIr2(irStoreFrame, classInteger, regionFrameValue, value, offset) }
        }
    }
}

// lower one loop statement of a parent function into an outlined region
fn lowerLoopRegion(loopStatement: Node, parentSlotCount: int, parentParameterCount: int, parentRegisterCall: bool) -> bool {
    resetIr()
    regionIsFunction = false
    regionFunctionIndex = 0 - 1
    regionEnvironmentValue = 0 - 1
    regionParentSlotCount = parentSlotCount
    regionParentParameterCount = parentParameterCount
    regionParentRegisterCall = parentRegisterCall
    regionGlobalsInMemory = subtreeHasUserCall(loopStatement) or assignsReferenceGlobal(loopStatement)
    findOwnedLocals(loopStatement)
    let entryBlock = newBlock()
    blockSealed[entryBlock] = true
    currentIrBlock = entryBlock
    regionFrameValue = emitIr0(irParameter, classInteger, 0)
    lowerStatement(loopStatement)
    if optimizerBailed { return false }
    ensureOpenBlock()
    writeBackVariables()
    var noOperands: [int] = []
    var noSuccessors: [int] = []
    terminate(irReturn, noOperands, 0, noSuccessors)
    return not optimizerBailed
}

// lower a whole function body into a region
var lowerPreInlineBody = false             // lowerFunctionRegion: lower preInlineBodies[] instead of the body

fn lowerFunctionRegion(functionIndex: int) -> bool {
    resetIr()
    let functionDefinition = functionDefinitions[functionIndex]
    regionIsFunction = true
    regionFunctionIndex = functionIndex
    regionReturnType = functionDefinition.returnType
    var body = functionDefinition.body
    if lowerPreInlineBody { body = preInlineBodies[functionIndex] }
    regionGlobalsInMemory = subtreeHasUserCall(body) or assignsReferenceGlobal(body)
    findOwnedLocals(body)
    let entryBlock = newBlock()
    blockSealed[entryBlock] = true
    currentIrBlock = entryBlock
    // every parameter is defined at entry, all at once (the prologue moves them as one)
    for i in 0..functionDefinition.parameterNames.len() { parameterValues.push(emitIr0(irParameter, classInteger, i)) }
    regionEnvironmentValue = 0 - 1
    if functionDefinition.hasEnvironment {
        if functionIsRegisterCall(functionIndex) {
            optimizerBail("closure body with register arguments")
            return false
        }
        regionEnvironmentValue = emitIr0(irParameter, classInteger, functionDefinition.parameterNames.len())    // deepest, past the arguments
    }
    for i in 0..functionDefinition.parameterNames.len() {
        if typeKinds[functionDefinition.parameterTypes[i]] == kindFloat { parameterValues[i] = emitIr1(irFloatFromBits, classFloat, parameterValues[i], 0) }
    }
    regionReturnBlock = newBlock()
    let hasValue = typeKinds[regionReturnType] != kindVoid
    if hasValue { regionReturnVariable = temporaryVariable(classOfType(regionReturnType), false) }
    lowerBlock(body)
    if optimizerBailed { return false }
    jumpTo(regionReturnBlock)
    sealBlock(regionReturnBlock)
    currentIrBlock = regionReturnBlock
    writeBackVariables()
    var noSuccessors: [int] = []
    if hasValue {
        var value = readVariable(regionReturnVariable, currentIrBlock)
        if irClasses[value] == classFloat { value = emitIr1(irBitsFromFloat, classInteger, value, 0) }
        terminate(irReturn, [value], 0, noSuccessors)
    } else {
        var noOperands: [int] = []
        terminate(irReturn, noOperands, 0, noSuccessors)
    }
    return not optimizerBailed
}

// ================= cleanup passes =================
var blockReachable: [bool] = []
var valueForward: [int] = []
var valueDead: [bool] = []

fn isTerminatorOpcode(opcode: int) -> bool { return opcode >= irJump }

// instructions that may be deleted when nothing reads their result
fn isPureOpcode(opcode: int) -> bool {
    if opcode == irStore or opcode == irStoreIndexed or opcode == irStoreGlobal or opcode == irStoreFrame { return false }
    if opcode == irFloatStore or opcode == irFloatStoreIndexed or opcode == irFloatStoreGlobal or opcode == irFloatStoreFrame { return false }
    if opcode == irBoundsCheck or opcode == irZeroCheck or opcode == irCall { return false }
    if opcode == irStoreRaw64 or opcode == irStoreRaw32 or opcode == irStoreRaw8 { return false }
    return not isTerminatorOpcode(opcode)
}

fn producesValue(opcode: int) -> bool {
    if not isPureOpcode(opcode) { return opcode == irCall }
    return true
}

fn resolveValue(value: int) -> int {
    var current = value
    while valueForward[current] != current { current = valueForward[current] }
    return current
}

fn removeUnreachableBlocks() {
    let blockCount = blockInstructions.len()
    var reachable: [bool] = []
    for i in 0..blockCount { reachable.push(false) }
    var stack: [int] = [0]
    reachable[0] = true
    while stack.len() > 0 {
        let block = stack.pop()
        for successor in blockSuccessors[block] {
            if not reachable[successor] {
                reachable[successor] = true
                stack.push(successor)
            }
        }
    }
    for block in 0..blockCount {
        if not reachable[block] {
            var noInstructions: [int] = []
            blockInstructions[block] = noInstructions
            var noSuccessors: [int] = []
            blockSuccessors[block] = noSuccessors
            var noPredecessors: [int] = []
            blockPredecessors[block] = noPredecessors
            continue
        }
        let predecessors = blockPredecessors[block]
        var keptIndices: [int] = []
        var kept: [int] = []
        for i in 0..predecessors.len() {
            if reachable[predecessors[i]] {
                keptIndices.push(i)
                kept.push(predecessors[i])
            }
        }
        if kept.len() != predecessors.len() {
            for instruction in blockInstructions[block] {
                if irOpcodes[instruction] == irPhi {
                    var operands: [int] = []
                    for index in keptIndices { operands.push(irOperands[instruction][index]) }
                    irOperands[instruction] = operands
                }
            }
            blockPredecessors[block] = kept
        }
    }
    blockReachable = reachable
}

fn resetForwarding() {
    var identity: [int] = []
    for value in 0..irOpcodes.len() { identity.push(value) }
    valueForward = identity
    var noneDead: [bool] = []
    for value in 0..irOpcodes.len() { noneDead.push(false) }
    valueDead = noneDead
}

// point every operand at the value it was forwarded to, and drop dead instructions
fn rewriteOperands() {
    for block in 0..blockInstructions.len() {
        var kept: [int] = []
        var changed = false
        for instruction in blockInstructions[block] {
            if valueDead[instruction] or valueForward[instruction] != instruction {
                changed = true
                continue
            }
            let operands = irOperands[instruction]
            for i in 0..operands.len() { operands[i] = resolveValue(operands[i]) }
            kept.push(instruction)
        }
        if changed { blockInstructions[block] = kept }
    }
}

// a phi whose operands are all one value (or itself) is that value
fn removeTrivialPhis() {
    var changed = true
    while changed {
        changed = false
        for block in 0..blockInstructions.len() {
            for instruction in blockInstructions[block] {
                if irOpcodes[instruction] != irPhi or valueForward[instruction] != instruction { continue }
                var same = 0 - 1
                var trivial = true
                for operand in irOperands[instruction] {
                    let resolved = resolveValue(operand)
                    if resolved == instruction or resolved == same { continue }
                    if same >= 0 {
                        trivial = false
                        break
                    }
                    same = resolved
                }
                if trivial and same >= 0 {
                    valueForward[instruction] = same
                    changed = true
                }
            }
        }
    }
    rewriteOperands()
}

fn countUses() {
    for value in 0..irUseCounts.len() { irUseCounts[value] = 0 }
    for block in 0..blockInstructions.len() {
        for instruction in blockInstructions[block] {
            for operand in irOperands[instruction] { irUseCounts[operand] += 1 }
        }
    }
}

fn isInlineRetain(instruction: int) -> bool {
    return heapBumpGlobalIndex >= 0 and heapBaseGlobalIndex >= 0 and isRuntimeCallTo(instruction, "runtimeRetainReference")
}

fn isRuntimeCallTo(instruction: int, name: str) -> bool {
    return irOpcodes[instruction] == irCall and functionNameIndices.has(name) and irImmediates[instruction] == functionNameIndices[name]
}

fn usesValue(instruction: int, value: int) -> bool {
    for operand in irOperands[instruction] {
        if resolveValue(operand) == value { return true }
    }
    return false
}

// `r = retain(v) ... use(r) ... release(v)` in one block: v's own count can go
// to the use instead. Released v was owned, so it lives to the release either
// way; nothing may read v between the use and the release, when the use may
// already have dropped the count v now hands it.
fn cancelCountPairs() {
    countUses()
    var cancelled = false
    for block in 0..blockInstructions.len() {
        let instructions = blockInstructions[block]
        for releaseIndex in 0..instructions.len() {
            let release = instructions[releaseIndex]
            if valueDead[release] or not isRuntimeCallTo(release, "runtimeReleaseReference") { continue }
            let value = resolveValue(irOperands[release][0])
            if cancelsRetainedCopy(instructions, releaseIndex, value) {
                cancelled = true
                continue
            }
            var retainIndex = releaseIndex - 1
            var lastUseIndex = 0 - 1
            var blocked = false
            while retainIndex >= 0 {
                let instruction = instructions[retainIndex]
                if not valueDead[instruction] and isRuntimeCallTo(instruction, "runtimeRetainReference") and resolveValue(irOperands[instruction][0]) == value and valueForward[instruction] == instruction { break }
                if not valueDead[instruction] and usesValue(instruction, value) {
                    if isRuntimeCallTo(instruction, "runtimeReleaseReference") { blocked = true }
                    if lastUseIndex < 0 { lastUseIndex = retainIndex }
                }
                retainIndex -= 1
            }
            if blocked or retainIndex < 0 { continue }
            let retain = instructions[retainIndex]
            // the retained copy's one use, if any, sits between the pair and after every read of v
            var retainUseIndex = 0 - 1
            for i in (retainIndex + 1)..releaseIndex {
                if not valueDead[instructions[i]] and usesValue(instructions[i], retain) { retainUseIndex = i }
            }
            if irUseCounts[retain] > 1 { continue }
            if irUseCounts[retain] == 1 and (retainUseIndex < 0 or retainUseIndex < lastUseIndex) { continue }
            valueForward[retain] = value
            valueDead[release] = true
            cancelled = true
        }
    }
    if cancelled { rewriteOperands() }
}

// release(retain(v)) in one block with no freeing call between and every use of the
// copy inside the pair: nothing can free v meanwhile, so v may go borrowed
fn cancelsRetainedCopy(instructions: [int], releaseIndex: int, retain: int) -> bool {
    if valueDead[retain] or not isRuntimeCallTo(retain, "runtimeRetainReference") or valueForward[retain] != retain { return false }
    var usesInside = 1
    var index = releaseIndex - 1
    while index >= 0 {
        let instruction = instructions[index]
        if instruction == retain { break }
        if not valueDead[instruction] {
            if irOpcodes[instruction] == irCall and irCallMayFree(instruction) { return false }
            if usesValue(instruction, retain) { usesInside += 1 }
        }
        index -= 1
    }
    if index < 0 or usesInside != irUseCounts[retain] { return false }
    valueForward[retain] = resolveValue(irOperands[retain][0])
    valueDead[instructions[releaseIndex]] = true
    return true
}

fn eliminateDeadCode() {
    countUses()
    var worklist: [int] = []
    for block in 0..blockInstructions.len() {
        for instruction in blockInstructions[block] {
            if irUseCounts[instruction] == 0 and isPureOpcode(irOpcodes[instruction]) { worklist.push(instruction) }
        }
    }
    while worklist.len() > 0 {
        let value = worklist.pop()
        if valueDead[value] { continue }
        valueDead[value] = true
        for operand in irOperands[value] {
            irUseCounts[operand] -= 1
            if irUseCounts[operand] == 0 and isPureOpcode(irOpcodes[operand]) and not valueDead[operand] { worklist.push(operand) }
        }
    }
    rewriteOperands()
}

// Borrowed-reference rules (see the contract at the top): a phi is unpinned if
// any input is, and no unpinned reference may be handed to a callee.
fn checkBorrows() {
    var changed = true
    while changed {
        changed = false
        for block in 0..blockInstructions.len() {
            for instruction in blockInstructions[block] {
                if irOpcodes[instruction] != irPhi or irBorrowed[instruction] { continue }
                for operand in irOperands[instruction] {
                    if irBorrowed[operand] {
                        irBorrowed[instruction] = true
                        changed = true
                    }
                }
            }
        }
    }
    for block in 0..blockInstructions.len() {
        for instruction in blockInstructions[block] {
            if irOpcodes[instruction] != irCall { continue }
            let operands = irOperands[instruction]
            for i in 0..operands.len() {
                // a callee that never frees cannot drop what a borrowed argument leans on
                if ((irReferenceArguments[instruction] >> i) & 1) == 1 and irBorrowed[operands[i]] and irCallMayFree(instruction) { optimizerBail("unpinned reference passed to a call") }
            }
        }
    }
}

// an edge from a block with several successors to one with several
// predecessors gets a block of its own, so phi moves have a place to go
fn splitCriticalEdges() {
    let originalCount = blockInstructions.len()
    for block in 0..originalCount {
        if not blockReachable[block] or blockSuccessors[block].len() < 2 { continue }
        for successorIndex in 0..blockSuccessors[block].len() {
            let successor = blockSuccessors[block][successorIndex]
            if blockPredecessors[successor].len() < 2 { continue }
            let middle = newBlock()
            blockReachable.push(true)
            blockSealed[middle] = true
            blockLoopDepth[middle] = blockLoopDepth[successor]
            var noOperands: [int] = []
            let jump = addInstruction(middle, irJump, classInteger, noOperands, 0)
            blockTerminated[middle] = true
            blockSuccessors[middle].push(successor)
            blockPredecessors[middle].push(block)
            blockSuccessors[block][successorIndex] = middle
            let predecessors = blockPredecessors[successor]
            var replaced = false
            for i in 0..predecessors.len() {
                if not replaced and predecessors[i] == block {
                    predecessors[i] = middle
                    replaced = true
                }
            }
        }
    }
}

// ================= block order, liveness, intervals =================
var blockOrder: [int] = []
var blockOrderIndex: [int] = []            // block -> position in blockOrder, -1 = unreachable
var blockStartPositions: [int] = []
var blockEndPositions: [int] = []
var instructionPositions: [int] = []
var callPositions: [int] = []
var scratchClobberPositions: [int] = []   // instructions that use r11 as scratch
var freeingCallPositions: [int] = []      // calls that may release memory a borrowed reference points into
var liveIn: [[int]] = []
var liveOut: [[int]] = []
var liveWordCount = 0

// reverse postorder; a branch's first successor is laid out right after it
fn computeBlockOrder() {
    let blockCount = blockInstructions.len()
    var visited: [bool] = []
    for i in 0..blockCount { visited.push(false) }
    var postorder: [int] = []
    var stackBlocks: [int] = [0]
    var stackNext: [int] = [0]
    visited[0] = true
    while stackBlocks.len() > 0 {
        let top = stackBlocks.len() - 1
        let block = stackBlocks[top]
        let successors = blockSuccessors[block]
        let next = stackNext[top]
        if next < successors.len() {
            stackNext[top] = next + 1
            let successor = successors[successors.len() - 1 - next]     // last successor first: RPO puts the first right after
            if not visited[successor] {
                visited[successor] = true
                stackBlocks.push(successor)
                stackNext.push(0)
            }
        } else {
            postorder.push(block)
            let poppedBlock = stackBlocks.pop()
            let poppedNext = stackNext.pop()
        }
    }
    var order: [int] = []
    var index = postorder.len() - 1
    while index >= 0 {
        order.push(postorder[index])
        index -= 1
    }
    blockOrder = order
    var orderIndex: [int] = []
    for i in 0..blockCount { orderIndex.push(0 - 1) }
    for i in 0..order.len() { orderIndex[order[i]] = i }
    blockOrderIndex = orderIndex
}

fn bitSet(set: [int], value: int) { set[value / 64] = set[value / 64] | (1 << (value % 64)) }
fn bitTest(set: [int], value: int) -> bool { return ((set[value / 64] >> (value % 64)) & 1) == 1 }
fn emptyBitSet() -> [int] {
    var set: [int] = []
    for i in 0..liveWordCount { set.push(0) }
    return set
}

fn predecessorIndex(block: int, predecessor: int) -> int {
    let predecessors = blockPredecessors[block]
    for i in 0..predecessors.len() {
        if predecessors[i] == predecessor { return i }
    }
    return 0 - 1
}

fn computeLiveness() {
    liveWordCount = (irOpcodes.len() + 63) / 64
    let blockCount = blockInstructions.len()
    var useSets: [[int]] = []
    var defineSets: [[int]] = []
    var noIn: [[int]] = []
    liveIn = noIn
    var noOut: [[int]] = []
    liveOut = noOut
    for block in 0..blockCount {
        var uses = emptyBitSet()
        var defines = emptyBitSet()
        for instruction in blockInstructions[block] {
            if irOpcodes[instruction] != irPhi {
                for operand in irOperands[instruction] {
                    if not bitTest(defines, operand) { bitSet(uses, operand) }
                }
            }
            bitSet(defines, instruction)
        }
        useSets.push(uses)
        defineSets.push(defines)
        liveIn.push(emptyBitSet())
        liveOut.push(emptyBitSet())
    }
    var changed = true
    while changed {
        changed = false
        var orderPosition = blockOrder.len() - 1
        while orderPosition >= 0 {
            let block = blockOrder[orderPosition]
            orderPosition -= 1
            var out = emptyBitSet()
            for successor in blockSuccessors[block] {
                let successorIn = liveIn[successor]
                for word in 0..liveWordCount { out[word] = out[word] | successorIn[word] }
                let edgeIndex = predecessorIndex(successor, block)
                for instruction in blockInstructions[successor] {
                    if irOpcodes[instruction] == irPhi { bitSet(out, irOperands[instruction][edgeIndex]) }
                }
            }
            let uses = useSets[block]
            let defines = defineSets[block]
            let oldIn = liveIn[block]
            var newIn = emptyBitSet()
            for word in 0..liveWordCount {
                newIn[word] = uses[word] | (out[word] & (~defines[word]))
                if newIn[word] != oldIn[word] { changed = true }
            }
            liveIn[block] = newIn
            liveOut[block] = out
        }
    }
}

// Positions: a block occupies [start, end]; its instructions sit at start+2,
// start+4, ... and the phi moves into its successor at `end`. Live ranges are
// half-open lists of [from, to): an operand's range stops AT the instruction
// reading it, so the result may take the same register.
var rangeStarts: [[int]] = []
var rangeEnds: [[int]] = []
var groupParent: [int] = []                // coalesced phi webs share one location

fn numberPositions() {
    let valueCount = irOpcodes.len()
    var positions: [int] = []
    for value in 0..valueCount { positions.push(0 - 1) }
    instructionPositions = positions
    var blockStarts: [int] = []
    var blockEnds: [int] = []
    for block in 0..blockInstructions.len() {
        blockStarts.push(0)
        blockEnds.push(0)
    }
    var noCalls: [int] = []
    callPositions = noCalls
    var noFreeingCalls: [int] = []
    freeingCallPositions = noFreeingCalls
    var noClobbers: [int] = []
    scratchClobberPositions = noClobbers
    var position = 0
    for block in blockOrder {
        blockStarts[block] = position
        position += 2
        for instruction in blockInstructions[block] {
            if irOpcodes[instruction] == irPhi or irOpcodes[instruction] == irParameter { instructionPositions[instruction] = blockStarts[block] }
            else {
                instructionPositions[instruction] = position
                if irOpcodes[instruction] == irCall and not isInlineRetain(instruction) { callPositions.push(position) }
                if irOpcodes[instruction] == irDivideByInvariant or irOpcodes[instruction] == irModuloByInvariant { scratchClobberPositions.push(position) }
                if irOpcodes[instruction] == irCall and irCallMayFree(instruction) { freeingCallPositions.push(position) }
                position += 2
            }
        }
        blockEnds[block] = position
        position += 2
    }
    blockStartPositions = blockStarts
    blockEndPositions = blockEnds
}

fn addRange(value: int, from: int, to: int) {
    if to <= from { return }
    rangeStarts[value].push(from)
    rangeEnds[value].push(to)
}

// sort a value's ranges and merge the ones that touch or overlap
fn normalizeRanges(value: int) {
    let starts = rangeStarts[value]
    let ends = rangeEnds[value]
    let count = starts.len()
    if count < 2 { return }
    for i in 1..count {                        // insertion sort: lists are short
        var j = i
        while j > 0 and starts[j - 1] > starts[j] {
            let swappedStart = starts[j]
            starts[j] = starts[j - 1]
            starts[j - 1] = swappedStart
            let swappedEnd = ends[j]
            ends[j] = ends[j - 1]
            ends[j - 1] = swappedEnd
            j -= 1
        }
    }
    var mergedStarts: [int] = [starts[0]]
    var mergedEnds: [int] = [ends[0]]
    for i in 1..count {
        let last = mergedEnds.len() - 1
        if starts[i] <= mergedEnds[last] {
            if ends[i] > mergedEnds[last] { mergedEnds[last] = ends[i] }
        } else {
            mergedStarts.push(starts[i])
            mergedEnds.push(ends[i])
        }
    }
    rangeStarts[value] = mergedStarts
    rangeEnds[value] = mergedEnds
}

fn buildLiveRanges() {
    numberPositions()
    let valueCount = irOpcodes.len()
    var noStarts: [[int]] = []
    rangeStarts = noStarts
    var noEnds: [[int]] = []
    rangeEnds = noEnds
    var parents: [int] = []
    var blockRangeStart: [int] = []
    var blockRangeEnd: [int] = []
    for value in 0..valueCount {
        var startList: [int] = []
        rangeStarts.push(startList)
        var endList: [int] = []
        rangeEnds.push(endList)
        parents.push(value)
        blockRangeStart.push(0 - 1)
        blockRangeEnd.push(0)
    }
    groupParent = parents
    for block in blockOrder {
        let blockStart = blockStartPositions[block]
        let blockEnd = blockEndPositions[block]
        var touched: [int] = []
        // live past the block end: whatever a successor needs on entry. Phi
        // inputs are only read by the moves AT the end, which comes next.
        var outSet = emptyBitSet()
        for successor in blockSuccessors[block] {
            let successorIn = liveIn[successor]
            for word in 0..liveWordCount { outSet[word] = outSet[word] | successorIn[word] }
        }
        for word in 0..liveWordCount {
            if outSet[word] == 0 { continue }
            for bit in 0..64 {
                if ((outSet[word] >> bit) & 1) == 1 {
                    let value = word * 64 + bit
                    blockRangeStart[value] = blockStart
                    blockRangeEnd[value] = blockEnd + 1
                    touched.push(value)
                }
            }
        }
        for successor in blockSuccessors[block] {
            let edgeIndex = predecessorIndex(successor, block)
            for instruction in blockInstructions[successor] {
                if irOpcodes[instruction] != irPhi { continue }
                let operand = irOperands[instruction][edgeIndex]
                if blockRangeStart[operand] < 0 {
                    blockRangeStart[operand] = blockStart
                    blockRangeEnd[operand] = blockEnd
                    touched.push(operand)
                } else if blockRangeEnd[operand] < blockEnd { blockRangeEnd[operand] = blockEnd }
            }
        }
        let instructions = blockInstructions[block]
        var index = instructions.len() - 1
        while index >= 0 {
            let instruction = instructions[index]
            index -= 1
            let position = instructionPositions[instruction]
            if irOpcodes[instruction] == irPhi or irOpcodes[instruction] == irParameter {
                if blockRangeStart[instruction] >= 0 { blockRangeStart[instruction] = blockStart }
                continue
            }
            if blockRangeStart[instruction] >= 0 { blockRangeStart[instruction] = position }      // the definition
            for operand in irOperands[instruction] {
                if blockRangeStart[operand] < 0 {
                    blockRangeStart[operand] = blockStart
                    blockRangeEnd[operand] = position
                    touched.push(operand)
                } else if blockRangeEnd[operand] < position { blockRangeEnd[operand] = position }
            }
        }
        for value in touched {
            if blockRangeStart[value] >= 0 {
                addRange(value, blockRangeStart[value], blockRangeEnd[value])
                blockRangeStart[value] = 0 - 1
            }
        }
    }
    // a phi's register is written by the moves at the end of each predecessor
    for block in blockOrder {
        for instruction in blockInstructions[block] {
            if irOpcodes[instruction] != irPhi { continue }
            for predecessor in blockPredecessors[block] { addRange(instruction, blockEndPositions[predecessor], blockEndPositions[predecessor] + 1) }
        }
    }
    for value in 0..valueCount { normalizeRanges(value) }
}

fn groupOf(value: int) -> int {
    var current = value
    while groupParent[current] != current { current = groupParent[current] }
    return current
}

fn rangesIntersect(first: int, second: int) -> bool {
    let firstStarts = rangeStarts[first]
    let firstEnds = rangeEnds[first]
    let secondStarts = rangeStarts[second]
    let secondEnds = rangeEnds[second]
    var i = 0
    var j = 0
    while i < firstStarts.len() and j < secondStarts.len() {
        if firstStarts[i] < secondEnds[j] and secondStarts[j] < firstEnds[i] { return true }
        if firstEnds[i] <= secondEnds[j] { i += 1 } else { j += 1 }
    }
    return false
}

fn rangesCover(value: int, position: int) -> bool {
    let starts = rangeStarts[value]
    let ends = rangeEnds[value]
    for i in 0..starts.len() {
        if starts[i] <= position and position < ends[i] { return true }
    }
    return false
}

fn lastRangeEnd(value: int) -> int {
    let ends = rangeEnds[value]
    if ends.len() == 0 { return 0 - 1 }
    return ends[ends.len() - 1]
}

// `positions` ascend (they are pushed in block order): one binary search per range
fn crossesAnyPosition(value: int, positions: [int]) -> bool {
    let starts = rangeStarts[value]
    let ends = rangeEnds[value]
    for i in 0..starts.len() {
        let next = firstPositionAbove(positions, starts[i])
        if next < positions.len() and positions[next] < ends[i] { return true }
    }
    return false
}

// live across or read at one of `positions` (a value defined there is written last)
fn liveAtAnyPosition(value: int, positions: [int]) -> bool {
    let starts = rangeStarts[value]
    let ends = rangeEnds[value]
    for i in 0..starts.len() {
        let next = firstPositionAbove(positions, starts[i])
        if next < positions.len() and positions[next] <= ends[i] { return true }
    }
    return false
}

// --opt-dump: every live instruction by block, `*` marking borrowed values
fn dumpIr(focus: int) {
    print("ir: borrow check fails on v{focus}")
    for block in blockOrder {
        print("  b{block} (preds {blockPredecessors[block]}, succs {blockSuccessors[block]}):")
        for instruction in blockInstructions[block] {
            if valueDead[instruction] { continue }
            var operands = ""
            for operand in irOperands[instruction] { operands = operands + " v{resolveValue(operand)}" }
            var mark = ""
            if irBorrowed[instruction] { mark = "*" }
            var callee = ""
            if irOpcodes[instruction] == irCall and irImmediates[instruction] >= 0 and irImmediates[instruction] < functionDefinitions.len() { callee = " " + functionDefinitions[irImmediates[instruction]].name }
            if irOpcodes[instruction] == irCall and irCallMayFree(instruction) { callee = callee + "!" }
            print("    v{instruction}{mark} = op{irOpcodes[instruction]}{callee}{operands} #{irImmediates[instruction]} @{instructionPositions[instruction]}")
        }
    }
}

// What holds a borrowed value's count, down its load chain: -2 for a holder
// no release in this region can drop (a global, a parameter, the parent
// frame, static data), -1 when unknown, else the owned value itself.
fn borrowRoot(value: int) -> int {
    var current = resolveValue(value)
    for step in 0..32 {
        let opcode = irOpcodes[current]
        if opcode == irLoadGlobal or opcode == irParameter or opcode == irLoadFrame or opcode == irDataAddress { return 0 - 2 }
        if opcode == irLoad or opcode == irLoadIndexed or opcode == irListData {
            current = resolveValue(irOperands[current][0])
        } else {
            if irBorrowed[current] { return 0 - 1 }            // a phi of loans, a call's borrowed result
            return current
        }
    }
    return 0 - 1
}

// A release drops one count, freeing only what no other holder keeps: a
// borrowed value crosses one safely unless it releases the value's own root.
fn survivesCrossedCalls(value: int) -> bool {
    let root = borrowRoot(value)
    if root == 0 - 1 { return false }
    for block in 0..blockInstructions.len() {
        for instruction in blockInstructions[block] {
            if irOpcodes[instruction] != irCall or valueDead[instruction] or not irCallMayFree(instruction) { continue }
            let single: [int] = [instructionPositions[instruction]]
            if not crossesAnyPosition(value, single) { continue }
            // runtimeAppendString frees at most its left operand, as a release would
            if not isRuntimeCallTo(instruction, "runtimeReleaseReference") and not isRuntimeCallTo(instruction, "runtimeAppendString") { return false }
            if root >= 0 and resolveValue(irOperands[instruction][0]) == root { return false }
        }
    }
    return true
}

fn describeBorrowed(value: int) -> str {
    var text = ""
    if irOpcodes[value] == irLoadGlobal and irImmediates[value] < globalNames.len() { text = ", global {globalNames[irImmediates[value]]}" }
    if not optimizerReport { return text }
    for block in 0..blockInstructions.len() {
        for instruction in blockInstructions[block] {
            if irOpcodes[instruction] != irCall or not irCallMayFree(instruction) or valueDead[instruction] { continue }
            let single: [int] = [instructionPositions[instruction]]
            if crossesAnyPosition(value, single) {
                var callee = "indirect"
                if irImmediates[instruction] >= 0 and irImmediates[instruction] != indirectStackCall { callee = functionDefinitions[irImmediates[instruction]].name }
                return text + ", across {callee}"
            }
        }
    }
    return text
}

fn firstPositionAbove(positions: [int], bound: int) -> int {
    var low = 0
    var high = positions.len()
    while low < high {
        let middle = (low + high) / 2
        if positions[middle] <= bound { low = middle + 1 } else { high = middle }
    }
    return low
}

fn isAllocatable(value: int) -> bool {
    let opcode = irOpcodes[value]
    if not producesValue(opcode) or isImmediateConstant(value) or opcode == irFloatConstant { return false }
    return rangeStarts[value].len() > 0
}

// Phi coalescing: a phi and an input whose live ranges never overlap can share
// one location, and the move between them disappears. For a loop counter that
// is the increment and the phi of the loop header.
fn coalescePhis() {
    for block in blockOrder {
        for instruction in blockInstructions[block] {
            if irOpcodes[instruction] != irPhi or not isAllocatable(instruction) { continue }
            for operand in irOperands[instruction] {
                if not isAllocatable(operand) or irClasses[operand] != irClasses[instruction] { continue }
                let phiGroup = groupOf(instruction)
                let operandGroup = groupOf(operand)
                if phiGroup == operandGroup or rangesIntersect(phiGroup, operandGroup) { continue }
                groupParent[operandGroup] = phiGroup
                for i in 0..rangeStarts[operandGroup].len() { addRange(phiGroup, rangeStarts[operandGroup][i], rangeEnds[operandGroup][i]) }
                normalizeRanges(phiGroup)
                if irBorrowed[operandGroup] { irBorrowed[phiGroup] = true }
            }
        }
    }
}

fn isTwoAddressOpcode(opcode: int) -> bool {
    if opcode == irAdd or opcode == irSubtract or opcode == irMultiply or opcode == irBitAnd or opcode == irBitOr or opcode == irBitXor { return true }
    if opcode == irShiftLeft or opcode == irShiftRight or opcode == irNegate { return true }
    return opcode == irFloatAdd or opcode == irFloatSubtract or opcode == irFloatMultiply or opcode == irFloatDivide or opcode == irFloatMinimum or opcode == irFloatMaximum
}

// ================= register allocation (linear scan) =================
// rax rcx rdx and xmm0 xmm1 are scratch for the emitter and never allocated.
// r11 is allocated last: the invariant division uses it as scratch, so no
// value live at one may take it (see scratchClobberPositions).
let integerRegisterNames = ["r8", "r9", "r10", "rbx", "rsi", "rdi", "r12", "r13", "r14", "r15", "r11"]
let integerRegisterCalleeSaved = [false, false, false, true, true, true, true, true, true, true, false]
let scratchIntegerRegister = 10
let floatRegisterNames = ["xmm2", "xmm3", "xmm4", "xmm5", "xmm6", "xmm7", "xmm8", "xmm9", "xmm10", "xmm11", "xmm12", "xmm13", "xmm14", "xmm15"]
let floatRegisterCalleeSaved = [false, false, false, false, true, true, true, true, true, true, true, true, true, true]

var valueRegisters: [int] = []             // index into the class's register list, -1 = none
var valueSpillSlots: [int] = []
var spillSlotCount = 0
var integerRegisterUsed: [bool] = []
var floatRegisterUsed: [bool] = []

// a register this group would like: the one its two-address inputs or phi inputs already hold
fn registerHint(group: int, members: [int]) -> int {
    for member in members {
        let opcode = irOpcodes[member]
        if isTwoAddressOpcode(opcode) or opcode == irPhi or opcode == irCopy {
            for operand in irOperands[member] {
                let operandGroup = groupOf(operand)
                if operandGroup != group and valueRegisters[operandGroup] >= 0 and irClasses[operandGroup] == irClasses[group] { return valueRegisters[operandGroup] }
                if opcode != irPhi { break }        // two-address: only the first operand
            }
        }
    }
    return 0 - 1
}

// what keeping a group in memory would cost: its reads and writes, weighted
// 8x per loop level they sit in
var groupSpillCosts: [int] = []

fn loopWeight(block: int) -> int {
    var depth = blockLoopDepth[block]
    if depth > 6 { depth = 6 }
    return 1 << (3 * depth)
}

fn computeSpillCosts() {
    var costs: [int] = []
    for value in 0..irOpcodes.len() { costs.push(0) }
    for block in blockOrder {
        let weight = loopWeight(block)
        for instruction in blockInstructions[block] {
            if isAllocatable(instruction) { costs[groupOf(instruction)] += weight }
            if irOpcodes[instruction] == irPhi {
                let predecessors = blockPredecessors[block]
                for i in 0..predecessors.len() {
                    let operand = irOperands[instruction][i]
                    if isAllocatable(operand) { costs[groupOf(operand)] += loopWeight(predecessors[i]) }
                }
            } else {
                for operand in irOperands[instruction] {
                    if isAllocatable(operand) { costs[groupOf(operand)] += weight }
                }
            }
        }
    }
    groupSpillCosts = costs
}

// what keeping a group in memory costs per position it is live: a short temp
// between two instructions is worth more of a register than a long-lived
// value read now and then
fn spillWeight(group: int) -> int {
    var length = 0
    let starts = rangeStarts[group]
    let ends = rangeEnds[group]
    for i in 0..starts.len() { length += ends[i] - starts[i] }
    return groupSpillCosts[group] * 4096 / (length + 16)
}

// Linear scan over live ranges with holes (Wimmer & Franz), without splitting:
// a group keeps one register or one stack slot for its whole life.
fn allocateRegisters() {
    let valueCount = irOpcodes.len()
    var registers: [int] = []
    var spills: [int] = []
    for value in 0..valueCount {
        registers.push(0 - 1)
        spills.push(0 - 1)
    }
    valueRegisters = registers
    valueSpillSlots = spills
    spillSlotCount = 0
    var integerUsed: [bool] = []
    for i in 0..integerRegisterNames.len() { integerUsed.push(false) }
    integerRegisterUsed = integerUsed
    var floatUsed: [bool] = []
    for i in 0..floatRegisterNames.len() { floatUsed.push(false) }
    floatRegisterUsed = floatUsed
    coalescePhis()
    computeSpillCosts()
    var groupMembers: [[int]] = []
    for value in 0..valueCount {
        var members: [int] = []
        groupMembers.push(members)
    }
    var sortKeys: [int] = []
    for value in 0..valueCount {
        if not isAllocatable(value) { continue }
        let group = groupOf(value)
        groupMembers[group].push(value)
        if group == value { sortKeys.push(rangeStarts[value][0] * 1048576 + value) }
    }
    sortKeys.sort()
    var active: [int] = []
    var inactive: [int] = []
    for key in sortKeys {
        let current = key % 1048576
        let position = rangeStarts[current][0]
        var nextActive: [int] = []
        var nextInactive: [int] = []
        for other in active {
            if lastRangeEnd(other) <= position { continue }
            if rangesCover(other, position) { nextActive.push(other) } else { nextInactive.push(other) }
        }
        for other in inactive {
            if lastRangeEnd(other) <= position { continue }
            if rangesCover(other, position) { nextActive.push(other) } else { nextInactive.push(other) }
        }
        active = nextActive
        inactive = nextInactive
        let valueClass = irClasses[current]
        var registerCount = integerRegisterNames.len()
        if valueClass == classFloat { registerCount = floatRegisterNames.len() }
        let needsCalleeSaved = crossesAnyPosition(current, callPositions)
        if irBorrowed[current] and crossesAnyPosition(current, freeingCallPositions) and not survivesCrossedCalls(current) {
            if optimizerDump { dumpIr(current) }
            optimizerBail("unpinned reference live across a call (opcode {irOpcodes[current]}{describeBorrowed(current)})")
        }
        var blocked: [bool] = []
        for i in 0..registerCount { blocked.push(needsCalleeSaved and not registerIsCalleeSaved(valueClass, i)) }
        if valueClass != classFloat and scratchClobberPositions.len() > 0 and liveAtAnyPosition(current, scratchClobberPositions) { blocked[scratchIntegerRegister] = true }
        for other in active {
            if irClasses[other] == valueClass and valueRegisters[other] >= 0 { blocked[valueRegisters[other]] = true }
        }
        for other in inactive {
            if irClasses[other] == valueClass and valueRegisters[other] >= 0 and rangesIntersect(other, current) { blocked[valueRegisters[other]] = true }
        }
        var chosen = registerHint(current, groupMembers[current])
        if chosen >= 0 and blocked[chosen] { chosen = 0 - 1 }
        for i in 0..registerCount {
            if chosen < 0 and not blocked[i] { chosen = i }
        }
        if chosen < 0 {
            // evict the active group that is cheapest to keep in memory, if it is
            // cheaper than this one and nothing inactive in its register overlaps
            var victim = 0 - 1
            for other in active {
                if irClasses[other] != valueClass or valueRegisters[other] < 0 { continue }
                let candidate = valueRegisters[other]
                if needsCalleeSaved and not registerIsCalleeSaved(valueClass, candidate) { continue }
                var free = true
                for waiting in inactive {
                    if irClasses[waiting] == valueClass and valueRegisters[waiting] == candidate and rangesIntersect(waiting, current) { free = false }
                }
                if free and (victim < 0 or spillWeight(other) < spillWeight(victim)) { victim = other }
            }
            if victim >= 0 and spillWeight(victim) < spillWeight(current) {
                chosen = valueRegisters[victim]
                valueRegisters[victim] = 0 - 1
                valueSpillSlots[victim] = spillSlotCount
                spillSlotCount += 1
            } else {
                valueSpillSlots[current] = spillSlotCount
                spillSlotCount += 1
            }
        }
        if chosen >= 0 {
            valueRegisters[current] = chosen
            if valueClass == classFloat { floatRegisterUsed[chosen] = true } else { integerRegisterUsed[chosen] = true }
            active.push(current)
        }
    }
    // every member of a group lives where its group does
    for value in 0..valueCount {
        if not isAllocatable(value) { continue }
        let group = groupOf(value)
        valueRegisters[value] = valueRegisters[group]
        valueSpillSlots[value] = valueSpillSlots[group]
    }
}

fn blockInLoop(block: int, members: [bool]) -> bool {
    if block < members.len() { return members[block] }
    // an edge block split after the loops were found: inside when both ends are
    for predecessor in blockPredecessors[block] {
        if not blockInLoop(predecessor, members) { return false }
    }
    for successor in blockSuccessors[block] {
        if not blockInLoop(successor, members) { return false }
    }
    return true
}

fn promoteSpilledLoopValues() {
    let blockCount = blockInstructions.len()
    var noGroups: [[int]] = []
    blockPromotedGroups = noGroups
    var noRegisters: [[int]] = []
    blockPromotedRegisters = noRegisters
    var noLoadGroups: [[int]] = []
    preheaderLoadGroups = noLoadGroups
    var noLoadRegisters: [[int]] = []
    preheaderLoadRegisters = noLoadRegisters
    for block in 0..blockCount {
        var groups: [int] = []
        blockPromotedGroups.push(groups)
        var registers: [int] = []
        blockPromotedRegisters.push(registers)
        var loadGroups: [int] = []
        preheaderLoadGroups.push(loadGroups)
        var loadRegisters: [int] = []
        preheaderLoadRegisters.push(loadRegisters)
    }
    var order: [int] = []
    for i in 0..loopHeaders.len() { order.push(loopSize(i) * 65536 + i) }
    order.sort()
    for key in order {
        let loopIndex = key % 65536
        let preheader = loopPreheaders[loopIndex]
        if preheader < 0 or preheader >= blockCount { continue }
        let members = loopBlockSets[loopIndex]
        var loopBlocks: [int] = []
        for block in blockOrder {
            if blockInLoop(block, members) { loopBlocks.push(block) }
        }
        var hasCall = false
        var clobbersScratch = false
        for block in loopBlocks {
            for instruction in blockInstructions[block] {
                if irOpcodes[instruction] == irCall { hasCall = true }
                if irOpcodes[instruction] == irDivideByInvariant or irOpcodes[instruction] == irModuloByInvariant { clobbersScratch = true }
            }
        }
        // spilled integer groups read in the loop, by weight
        var candidateGroups: [int] = []
        var candidateUses: [int] = []
        for block in loopBlocks {
            for instruction in blockInstructions[block] {
                for operand in irOperands[instruction] {
                    if not isAllocatable(operand) or irClasses[operand] != classInteger { continue }
                    let group = groupOf(operand)
                    if valueRegisters[group] >= 0 or valueSpillSlots[group] < 0 { continue }
                    var found = 0 - 1
                    for i in 0..candidateGroups.len() {
                        if candidateGroups[i] == group { found = i }
                    }
                    if found < 0 {
                        candidateGroups.push(group)
                        candidateUses.push(1)
                    } else { candidateUses[found] += 1 }
                }
            }
        }
        if candidateGroups.len() == 0 { continue }
        // written anywhere in the loop (a member defined there, or an exit's phi fed from there): not a candidate
        var writtenInLoop: [bool] = []
        for i in 0..candidateGroups.len() { writtenInLoop.push(false) }
        var definedHere: [int] = []
        for block in loopBlocks {
            for instruction in blockInstructions[block] { definedHere.push(instruction) }
            for successor in blockSuccessors[block] {
                if blockInLoop(successor, members) { continue }
                for instruction in blockInstructions[successor] {
                    if irOpcodes[instruction] == irPhi { definedHere.push(instruction) }
                }
            }
        }
        for value in definedHere {
            if not isAllocatable(value) { continue }
            let group = groupOf(value)
            for i in 0..candidateGroups.len() {
                if candidateGroups[i] == group { writtenInLoop[i] = true }
            }
        }
        // registers nothing uses anywhere in the loop: no value live into a
        // loop block or defined in one holds them
        var free: [bool] = []
        for register in 0..integerRegisterNames.len() { free.push((not hasCall or integerRegisterCalleeSaved[register]) and not (clobbersScratch and register == scratchIntegerRegister)) }
        var occupants: [int] = []
        for block in loopBlocks {
            for instruction in blockInstructions[block] { occupants.push(instruction) }
            let words = liveIn[block]
            for word in 0..words.len() {
                var remainingBits = words[word]
                var bit = 0
                while remainingBits != 0 {
                    if (remainingBits & 1) != 0 { occupants.push(word * 64 + bit) }
                    remainingBits = (remainingBits >> 1) & 9223372036854775807        // logical: the sign bit must not refill
                    bit += 1
                }
            }
        }
        for value in occupants {
            if not isAllocatable(value) or irClasses[value] == classFloat { continue }
            let register = valueRegisters[groupOf(value)]
            if register >= 0 { free[register] = false }
        }
        for block in loopBlocks {
            for register in blockPromotedRegisters[block] { free[register] = false }
        }
        // the heaviest readers take the free registers
        var remaining = true
        while remaining {
            var best = 0 - 1
            for i in 0..candidateGroups.len() {
                if not writtenInLoop[i] and candidateUses[i] > 0 and (best < 0 or candidateUses[i] > candidateUses[best]) { best = i }
            }
            var register = 0 - 1
            for candidate in 0..free.len() {
                if register < 0 and free[candidate] { register = candidate }
            }
            if best < 0 or register < 0 {
                remaining = false
                continue
            }
            free[register] = false
            candidateUses[best] = 0
            integerRegisterUsed[register] = true            // a callee-saved one gets saved by the prologue
            for block in loopBlocks {
                blockPromotedGroups[block].push(candidateGroups[best])
                blockPromotedRegisters[block].push(register)
            }
            preheaderLoadGroups[preheader].push(candidateGroups[best])
            preheaderLoadRegisters[preheader].push(register)
        }
    }
}

fn registerIsCalleeSaved(valueClass: int, index: int) -> bool {
    if valueClass == classFloat { return floatRegisterCalleeSaved[index] }
    return integerRegisterCalleeSaved[index]
}

// ================= x86 emission =================
var optimizerLines: [str] = []
var optimizerColdLines: [str] = []
var blockLabels: [int] = []
var outgoingAreaSize = 0
var savedIntegerRegisters: [int] = []
var savedFloatRegisters: [int] = []
var currentOrderPosition = 0

fn emitOptimized(text: str) { optimizerLines.push("  " + text + "\n") }
fn emitCold(text: str) { optimizerColdLines.push("  " + text + "\n") }

fn spillOffset(slot: int) -> int { return outgoingAreaSize + 8 * slot }

fn fitsImmediate(value: int) -> bool { return value >= 0 - 2147483648 and value <= 2147483647 }

// an int constant used as an instruction's immediate: it needs no register
fn isImmediateConstant(value: int) -> bool { return irOpcodes[value] == irConstant and fitsImmediate(irImmediates[value]) }

// where a value lives: a register name, a stack slot, an immediate, a
// constant-pool slot, or "" (never read)
fn locationOf(value: int) -> str {
    if isImmediateConstant(value) { return "{irImmediates[value]}" }
    if emittingBlock >= 0 and emittingBlock < blockPromotedGroups.len() and valueRegisters[value] < 0 and blockPromotedGroups[emittingBlock].len() > 0 {
        let group = groupOf(value)
        let promoted = blockPromotedGroups[emittingBlock]
        for i in 0..promoted.len() {
            if promoted[i] == group { return integerRegisterNames[blockPromotedRegisters[emittingBlock][i]] }
        }
    }
    if irOpcodes[value] == irFloatConstant { return "qword ptr " + floatConstantLabel(irImmediates[value]) }
    if valueRegisters[value] >= 0 {
        if irClasses[value] == classFloat { return floatRegisterNames[valueRegisters[value]] }
        return integerRegisterNames[valueRegisters[value]]
    }
    if valueSpillSlots[value] >= 0 { return "qword ptr [rsp + {spillOffset(valueSpillSlots[value])}]" }
    return ""
}

fn isRegisterLocation(location: str) -> bool { return location != "" and (location.byte(0) == 114 or location.byte(0) == 120) }   // rax.. r15, xmm..
fn isImmediateLocation(location: str) -> bool { return location != "" and (location.byte(0) == 45 or isDigitByte(location.byte(0))) }

// the value in a GPR: its own register, or loaded into scratch
fn integerIn(value: int, scratch: str) -> str {
    let location = locationOf(value)
    if isRegisterLocation(location) { return location }
    emitOptimized("mov {scratch}, {location}")
    return scratch
}

fn floatIn(value: int, scratch: str) -> str {
    let location = locationOf(value)
    if isRegisterLocation(location) { return location }
    emitOptimized("movsd {scratch}, {location}")
    return scratch
}

// register the result is computed into: its own, or scratch if it lives in memory
fn resultRegister(value: int, scratch: str) -> str {
    let location = locationOf(value)
    if isRegisterLocation(location) { return location }
    return scratch
}

fn finishResult(value: int, register: str) {
    let location = locationOf(value)
    if location == "" or location == register { return }
    if irClasses[value] == classFloat { emitOptimized("movsd {location}, {register}") }
    else { emitOptimized("mov {location}, {register}") }
}

fn moveFloat(destination: str, source: str) {
    if destination == source { return }
    if isRegisterLocation(destination) and isRegisterLocation(source) { emitOptimized("movapd {destination}, {source}") }
    else { emitOptimized("movsd {destination}, {source}") }
}

fn memoryAt(base: str, offset: int) -> str {
    if offset == 0 { return "[{base}]" }
    if offset < 0 { return "[{base} - {0 - offset}]" }
    return "[{base} + {offset}]"
}

fn moveImmediate(register: str, immediate: int) {
    if immediate >= 0 - 2147483648 and immediate <= 2147483647 { emitOptimized("mov {register}, {immediate}") }
    else { emitOptimized("movabs {register}, {immediate}") }
}

fn floatConstantLabel(valueBits: int) -> str {
    for i in 0..floatConstants.len() {
        if floatConstants[i] == valueBits { return "[rip + __fc{i}]" }
    }
    floatConstants.push(valueBits)
    return "[rip + __fc{floatConstants.len() - 1}]"
}

fn conditionSuffix(condition: int) -> str {
    if condition == conditionEqual { return "e" }
    if condition == conditionNotEqual { return "ne" }
    if condition == conditionLess { return "l" }
    if condition == conditionLessOrEqual { return "le" }
    if condition == conditionGreater { return "g" }
    if condition == conditionBelowOrEqual { return "be" }
    if condition == conditionAbove { return "a" }
    if condition == conditionBelow { return "b" }
    if condition == conditionAboveOrEqual { return "ae" }
    return "ge"
}

fn invertCondition(condition: int) -> int {
    if condition == conditionEqual { return conditionNotEqual }
    if condition == conditionNotEqual { return conditionEqual }
    if condition == conditionLess { return conditionGreaterOrEqual }
    if condition == conditionLessOrEqual { return conditionGreater }
    if condition == conditionGreater { return conditionLessOrEqual }
    if condition == conditionBelowOrEqual { return conditionAbove }
    if condition == conditionAbove { return conditionBelowOrEqual }
    if condition == conditionBelow { return conditionAboveOrEqual }
    if condition == conditionAboveOrEqual { return conditionBelow }
    return conditionLess
}

fn nextBlockInOrder() -> int {
    if currentOrderPosition + 1 < blockOrder.len() { return blockOrder[currentOrderPosition + 1] }
    return 0 - 1
}

// the label a jump to `block` uses: past any blocks that only jump on
fn blockLabelText(block: int) -> str { return ".L{blockLabels[jumpDestination(block)]}" }

// where a jump to `block` really lands: past blocks holding nothing but a jump
// whose phi moves are all no-ops (the allocator put both ends in one place)
fn jumpDestination(block: int) -> int {
    var current = block
    var steps = 0
    while steps < 8 {
        let instructions = blockInstructions[current]
        if instructions.len() != 1 or irOpcodes[instructions[0]] != irJump { return current }
        if current < preheaderLoadGroups.len() and preheaderLoadGroups[current].len() > 0 { return current }
        let successor = blockSuccessors[current][0]
        if successor == current { return current }
        let edgeIndex = predecessorIndex(successor, current)
        for instruction in blockInstructions[successor] {
            if irOpcodes[instruction] == irPhi and locationOf(irOperands[instruction][edgeIndex]) != locationOf(instruction) { return current }
        }
        current = successor
        steps += 1
    }
    return current
}

fn jumpUnlessNext(target: int) {
    let block = jumpDestination(target)
    if block != nextBlockInOrder() { emitOptimized("jmp {blockLabelText(block)}") }
}

// jump to trueBlock when `trueSuffix` holds, else falseBlock, falling through where possible
fn conditionalJump(trueSuffix: str, falseSuffix: str, trueTarget: int, falseTarget: int) {
    let trueBlock = jumpDestination(trueTarget)
    let falseBlock = jumpDestination(falseTarget)
    if trueBlock == nextBlockInOrder() { emitOptimized("j{falseSuffix} {blockLabelText(falseBlock)}") }
    else {
        emitOptimized("j{trueSuffix} {blockLabelText(trueBlock)}")
        jumpUnlessNext(falseBlock)
    }
}

// ---- parallel moves (phis at block ends, call arguments, parameters) ----
var moveSources: [str] = []
var moveDestinations: [str] = []

fn clearMoves() {
    var noSources: [str] = []
    moveSources = noSources
    var noDestinations: [str] = []
    moveDestinations = noDestinations
}

fn addMove(source: str, destination: str) {
    if source == destination or destination == "" { return }
    moveSources.push(source)
    moveDestinations.push(destination)
}

fn isFloatRegister(location: str) -> bool { return location.len() > 3 and location.byte(0) == 120 }   // "xmm"

// one copy of 64 bits between any two of: GPR, xmm register, stack slot
fn emitOneMove(source: str, destination: str) {
    let sourceIsFloat = isFloatRegister(source)
    let destinationIsFloat = isFloatRegister(destination)
    if isImmediateLocation(source) and not isRegisterLocation(destination) {
        if destination.byte(0) == 91 { emitOptimized("mov qword ptr {destination}, {source}") }      // a bare [address]
        else { emitOptimized("mov {destination}, {source}") }
    } else if not isRegisterLocation(source) and not isRegisterLocation(destination) {
        emitOptimized("movsd xmm1, {source}")            // r11 may be allocated; xmm1 never is
        emitOptimized("movsd {destination}, xmm1")
    } else if sourceIsFloat and destinationIsFloat {
        emitOptimized("movapd {destination}, {source}")
    } else if sourceIsFloat or destinationIsFloat {
        if isRegisterLocation(source) and isRegisterLocation(destination) { emitOptimized("movq {destination}, {source}") }
        else { emitOptimized("movsd {destination}, {source}") }
    } else {
        emitOptimized("mov {destination}, {source}")
    }
}

fn emitParallelMoves() {
    var pending: [bool] = []
    for i in 0..moveSources.len() { pending.push(true) }
    var remaining = moveSources.len()
    while remaining > 0 {
        var progressed = false
        for i in 0..moveSources.len() {
            if not pending[i] { continue }
            var blocked = false
            for j in 0..moveSources.len() {
                if pending[j] and j != i and moveSources[j] == moveDestinations[i] { blocked = true }
            }
            if not blocked {
                emitOneMove(moveSources[i], moveDestinations[i])
                pending[i] = false
                remaining -= 1
                progressed = true
            }
        }
        if not progressed {
            // a cycle: park one destination's current value in scratch
            var first = 0
            while not pending[first] { first += 1 }
            let parked = moveDestinations[first]
            var scratch = "rax"
            if isFloatRegister(parked) { scratch = "xmm0" }
            emitOneMove(parked, scratch)
            for j in 0..moveSources.len() {
                if pending[j] and moveSources[j] == parked { moveSources[j] = scratch }
            }
        }
    }
    clearMoves()
}

// the phi moves on the edge from `block` into its single successor
fn emitPhiMoves(block: int) {
    if blockSuccessors[block].len() != 1 { return }
    let successor = blockSuccessors[block][0]
    let edgeIndex = predecessorIndex(successor, block)
    clearMoves()
    for instruction in blockInstructions[successor] {
        if irOpcodes[instruction] != irPhi { continue }
        addMove(locationOf(irOperands[instruction][edgeIndex]), locationOf(instruction))
    }
    emitParallelMoves()
}

fn emitColdPanic(stringIndex: int) -> int {
    let label = allocateLabel()
    optimizerColdLines.push(".L{label}:\n")
    emitCold("lea rcx, [rip + __s{stringIndex}]")
    emitCold("and rsp, -16")
    emitCold("sub rsp, 32")
    emitCold("call runtimePanicWithString")
    return label
}

// cmp, or test when the right side is zero (same flags for every condition we use)
fn compareWith(left: str, right: int) {
    if isImmediateConstant(right) and irImmediates[right] == 0 { emitOptimized("test {left}, {left}") }
    else { emitOptimized("cmp {left}, {locationOf(right)}") }
}

fn emitIntegerBinary(value: int, mnemonic: str, commutative: bool) {
    let first = locationOf(irOperands[value][0])
    let second = locationOf(irOperands[value][1])
    let target = resultRegister(value, "rax")
    // into another register: lea does the copy and the add in one
    if (mnemonic == "add" or mnemonic == "sub") and target != first and target != second and isRegisterLocation(first) {
        let constant = irOperands[value][1]
        if isImmediateConstant(constant) {
            var displacement = irImmediates[constant]
            if mnemonic == "sub" { displacement = 0 - displacement }
            if displacement > 0 - 2147483648 {
                emitOptimized("lea {target}, {memoryAt(first, displacement)}")
                finishResult(value, target)
                return
            }
        }
        if mnemonic == "add" and isRegisterLocation(second) {
            emitOptimized("lea {target}, [{first} + {second}]")
            finishResult(value, target)
            return
        }
    }
    if target == second and target != first {
        if commutative { emitOptimized("{mnemonic} {target}, {first}") }
        else {
            emitOptimized("mov rax, {first}")
            emitOptimized("{mnemonic} rax, {second}")
            emitOptimized("mov {target}, rax")
        }
    } else {
        if target != first { emitOptimized("mov {target}, {first}") }
        emitOptimized("{mnemonic} {target}, {second}")
    }
    finishResult(value, target)
}

// float loads read straight by the next instruction as its memory operand
var foldedFloatLoads: [bool] = []

fn isFloatBinaryOpcode(opcode: int) -> bool {
    return opcode == irFloatAdd or opcode == irFloatSubtract or opcode == irFloatMultiply or opcode == irFloatDivide or opcode == irFloatMinimum or opcode == irFloatMaximum
}

// a single-use float load whose only reader comes right after it, as the
// second operand (or either, when the operation commutes)
fn canFoldFloatLoad(load: int, reader: int) -> bool {
    if irOpcodes[load] != irFloatLoad or irUseCounts[load] != 1 or not isFloatBinaryOpcode(irOpcodes[reader]) { return false }
    let operands = irOperands[reader]
    if operands[0] == operands[1] { return false }
    if operands[1] == load { return true }
    return operands[0] == load and (irOpcodes[reader] == irFloatAdd or irOpcodes[reader] == irFloatMultiply)
}

fn foldedLoadOperand(load: int) -> str {
    let base = integerIn(irOperands[load][0], "rcx")
    return "qword ptr {memoryAt(base, irImmediates[load])}"
}

fn emitFloatBinary(value: int, mnemonic: str, commutative: bool) {
    var firstValue = irOperands[value][0]
    var secondValue = irOperands[value][1]
    if foldedFloatLoads[firstValue] {
        firstValue = irOperands[value][1]
        secondValue = irOperands[value][0]
    }
    if foldedFloatLoads[secondValue] {
        let target = resultRegister(value, "xmm0")
        let memory = foldedLoadOperand(secondValue)
        moveFloat(target, locationOf(firstValue))
        emitOptimized("{mnemonic} {target}, {memory}")
        finishResult(value, target)
        return
    }
    let first = locationOf(irOperands[value][0])
    let second = locationOf(irOperands[value][1])
    let target = resultRegister(value, "xmm0")
    if target == second and target != first {
        if commutative { emitOptimized("{mnemonic} {target}, {first}") }
        else {
            moveFloat("xmm0", first)
            emitOptimized("{mnemonic} xmm0, {second}")
            moveFloat(target, "xmm0")
        }
    } else {
        moveFloat(target, first)
        emitOptimized("{mnemonic} {target}, {second}")
    }
    finishResult(value, target)
}

fn emitSetFromFlags(value: int, suffix: str) {
    emitOptimized("set{suffix} al")
    emitOptimized("movzx eax, al")
    finishResult(value, "rax")
}

fn emitFloatCompareValue(value: int) {
    let condition = irImmediates[value]
    let first = irOperands[value][0]
    let second = irOperands[value][1]
    if condition == conditionEqual or condition == conditionNotEqual {
        let left = floatIn(first, "xmm0")
        let right = floatIn(second, "xmm1")
        emitOptimized("ucomisd {left}, {right}")
        if condition == conditionEqual {
            emitOptimized("setnp al")
            emitOptimized("sete cl")
            emitOptimized("and al, cl")
        } else {
            emitOptimized("setp al")
            emitOptimized("setne cl")
            emitOptimized("or al, cl")
        }
        emitOptimized("movzx eax, al")
        finishResult(value, "rax")
        return
    }
    // a < b is b > a: comisd's "above" is false on NaN, as the baseline's
    if condition == conditionGreater or condition == conditionGreaterOrEqual {
        let left = floatIn(first, "xmm0")
        emitOptimized("comisd {left}, {locationOf(second)}")
    } else {
        let right = floatIn(second, "xmm0")
        emitOptimized("comisd {right}, {locationOf(first)}")
    }
    if condition == conditionGreater or condition == conditionLess { emitSetFromFlags(value, "a") }
    else { emitSetFromFlags(value, "ae") }
}

// stack slots a call's arguments take in the outgoing area
fn outgoingSlotsOfCall(instruction: int) -> int {
    let argumentCount = irOperands[instruction].len()
    if irImmediates[instruction] < 0 { return max(argumentCount, 4) }       // Win64: shadow space + stack arguments
    if irImmediates[instruction] == indirectStackCall { return argumentCount - 1 }
    if functionIsRegisterCall(irImmediates[instruction]) { return 0 }
    return argumentCount
}

fn emitCallInstruction(value: int) {
    let functionIndex = irImmediates[value]
    let operands = irOperands[value]
    if functionIndex < 0 {
        for i in 4..operands.len() {
            let argument = integerIn(operands[i], "rax")
            emitOptimized("mov qword ptr [rsp + {8 * i}], {argument}")
        }
        let argumentRegisters = ["rcx", "rdx", "r8", "r9"]
        clearMoves()
        for i in 0..min(operands.len(), 4) { addMove(locationOf(operands[i]), argumentRegisters[i]) }
        emitParallelMoves()
        emitOptimized("call {regionSymbols[0 - 1 - functionIndex]}")
        finishResult(value, "rax")
        return
    }
    if functionIndex == indirectStackCall {
        let stackCount = operands.len() - 1
        for i in 1..operands.len() {
            let argument = integerIn(operands[i], "rax")
            emitOptimized("mov qword ptr [rsp + {8 * (stackCount - i)}], {argument}")
        }
        emitOptimized("mov rax, {locationOf(operands[0])}")
        emitOptimized("call rax")
        finishResult(value, "rax")
        return
    }
    if functionIsRegisterCall(functionIndex) {
        let argumentRegisters = ["rcx", "rdx", "r8", "r9"]
        clearMoves()
        for i in 0..operands.len() { addMove(locationOf(operands[i]), argumentRegisters[i]) }
        emitParallelMoves()
    } else {
        for i in 0..operands.len() {
            let argument = integerIn(operands[i], "rax")
            emitOptimized("mov qword ptr [rsp + {8 * (operands.len() - 1 - i)}], {argument}")
        }
    }
    if functionIsRegisterCall(functionIndex) and functionDefinitions[functionIndex].name == "runtimeFillWords" {
        // (address, value, count) in rcx, rdx, r8: rep stosq, within a call's clobbers
        emitOptimized("push rdi")
        emitOptimized("mov rdi, rcx")
        emitOptimized("mov rax, rdx")
        emitOptimized("mov rcx, r8")
        emitOptimized(".byte 243,72,171")
        emitOptimized("pop rdi")
    } else {
        emitOptimized("call {functionCodeLabel(functionDefinitions[functionIndex].label)}")
    }
    finishResult(value, "rax")
}

fn emitInstructionFor(value: int) {
    let opcode = irOpcodes[value]
    let operands = irOperands[value]
    let immediate = irImmediates[value]
    if opcode == irPhi or opcode == irParameter { return }
    if opcode == irConstant {
        if isImmediateConstant(value) { return }          // folded into its users
        let target = resultRegister(value, "rax")
        moveImmediate(target, immediate)
        finishResult(value, target)
        return
    }
    if opcode == irFloatConstant { return }            // read from the constant pool by its users
    if opcode == irSymbolAddress {
        let target = resultRegister(value, "rax")
        emitOptimized("lea {target}, [rip + {regionSymbols[immediate]}]")
        finishResult(value, target)
        return
    }
    if opcode == irDataAddress {
        let target = resultRegister(value, "rax")
        emitOptimized("lea {target}, [rip + __s{immediate}]")
        finishResult(value, target)
        return
    }
    if opcode == irCopy {
        if irClasses[value] == classFloat {
            let target = resultRegister(value, "xmm0")
            moveFloat(target, locationOf(operands[0]))
            finishResult(value, target)
        } else {
            let target = resultRegister(value, "rax")
            if target != locationOf(operands[0]) { emitOptimized("mov {target}, {locationOf(operands[0])}") }
            finishResult(value, target)
        }
        return
    }
    if opcode == irAdd {
        emitIntegerBinary(value, "add", true)
        return
    }
    if opcode == irSubtract {
        emitIntegerBinary(value, "sub", false)
        return
    }
    if opcode == irMultiply {
        var first = operands[0]
        var second = operands[1]
        if isImmediateConstant(first) {
            first = operands[1]
            second = operands[0]
        }
        if isImmediateConstant(second) {
            let factor = irImmediates[second]
            var source = locationOf(first)
            if isImmediateLocation(source) {
                emitOptimized("mov rax, {source}")
                source = "rax"
            }
            let target = resultRegister(value, "rax")
            emitOptimized("imul {target}, {source}, {factor}")
            finishResult(value, target)
            return
        }
        emitIntegerBinary(value, "imul", true)
        return
    }
    if opcode == irBitAnd {
        emitIntegerBinary(value, "and", true)
        return
    }
    if opcode == irBitOr {
        emitIntegerBinary(value, "or", true)
        return
    }
    if opcode == irBitXor {
        emitIntegerBinary(value, "xor", true)
        return
    }
    if (opcode == irShiftLeft or opcode == irShiftRight) and isImmediateConstant(operands[1]) {
        let target = resultRegister(value, "rax")
        if target != locationOf(operands[0]) { emitOptimized("mov {target}, {locationOf(operands[0])}") }
        let count = irImmediates[operands[1]] & 63
        if opcode == irShiftLeft { emitOptimized("shl {target}, {count}") } else { emitOptimized("sar {target}, {count}") }
        finishResult(value, target)
        return
    }
    if opcode == irShiftLeft or opcode == irShiftRight {
        emitOptimized("mov rcx, {locationOf(operands[1])}")
        let target = resultRegister(value, "rax")
        if target != locationOf(operands[0]) { emitOptimized("mov {target}, {locationOf(operands[0])}") }
        if opcode == irShiftLeft { emitOptimized("shl {target}, cl") } else { emitOptimized("sar {target}, cl") }
        finishResult(value, target)
        return
    }
    if opcode == irDividePowerOfTwo or opcode == irModuloPowerOfTwo {
        // bias negative dividends by 2^k - 1 so the arithmetic shift truncates toward zero
        emitOptimized("mov rax, {locationOf(operands[0])}")
        emitOptimized("mov rcx, rax")
        emitOptimized("sar rcx, 63")
        emitOptimized("shr rcx, {64 - immediate}")
        emitOptimized("add rcx, rax")
        if opcode == irDividePowerOfTwo {
            emitOptimized("sar rcx, {immediate}")
            finishResult(value, "rcx")
        } else {
            emitOptimized("and rcx, {0 - (1 << immediate)}")
            emitOptimized("sub rax, rcx")
            finishResult(value, "rax")
        }
        return
    }
    if opcode == irDivide or opcode == irModulo {
        let divisor = integerIn(operands[1], "rcx")
        emitOptimized("mov rax, {locationOf(operands[0])}")
        emitOptimized("cqo")
        emitOptimized("idiv {divisor}")
        if opcode == irDivide { finishResult(value, "rax") }
        else { finishResult(value, "rdx") }
        return
    }
    if opcode == irNegate {
        let target = resultRegister(value, "rax")
        if target != locationOf(operands[0]) { emitOptimized("mov {target}, {locationOf(operands[0])}") }
        emitOptimized("neg {target}")
        finishResult(value, target)
        return
    }
    if opcode == irCompare {
        let left = integerIn(operands[0], "rax")
        compareWith(left, operands[1])
        emitSetFromFlags(value, conditionSuffix(immediate))
        return
    }
    if opcode == irIntegerMinimum or opcode == irIntegerMaximum {
        let skipLabel = allocateLabel()
        emitOptimized("mov rax, {locationOf(operands[0])}")
        emitOptimized("cmp rax, {locationOf(operands[1])}")
        if opcode == irIntegerMinimum { emitOptimized("jle .L{skipLabel}") } else { emitOptimized("jge .L{skipLabel}") }
        emitOptimized("mov rax, {locationOf(operands[1])}")
        optimizerLines.push(".L{skipLabel}:\n")
        finishResult(value, "rax")
        return
    }
    if opcode == irIntegerAbsolute {
        emitOptimized("mov rax, {locationOf(operands[0])}")
        emitOptimized("mov rcx, rax")
        emitOptimized("sar rcx, 63")
        emitOptimized("xor rax, rcx")
        emitOptimized("sub rax, rcx")
        finishResult(value, "rax")
        return
    }
    if opcode == irFloatAdd {
        emitFloatBinary(value, "addsd", true)
        return
    }
    if opcode == irFloatSubtract {
        emitFloatBinary(value, "subsd", false)
        return
    }
    if opcode == irFloatMultiply {
        emitFloatBinary(value, "mulsd", true)
        return
    }
    if opcode == irFloatDivide {
        emitFloatBinary(value, "divsd", false)
        return
    }
    if opcode == irFloatMinimum {
        emitFloatBinary(value, "minsd", false)
        return
    }
    if opcode == irFloatMaximum {
        emitFloatBinary(value, "maxsd", false)
        return
    }
    if opcode == irFloatNegate or opcode == irFloatAbsolute {
        let source = floatIn(operands[0], "xmm0")
        emitOptimized("movq rax, {source}")
        if opcode == irFloatNegate {
            emitOptimized("movabs rcx, {1 << 63}")
            emitOptimized("xor rax, rcx")
        } else {
            emitOptimized("movabs rcx, 9223372036854775807")
            emitOptimized("and rax, rcx")
        }
        let target = resultRegister(value, "xmm0")
        emitOptimized("movq {target}, rax")
        finishResult(value, target)
        return
    }
    if opcode == irFloatSquareRoot {
        let source = floatIn(operands[0], "xmm0")
        let target = resultRegister(value, "xmm0")
        emitOptimized("sqrtsd {target}, {source}")
        finishResult(value, target)
        return
    }
    if opcode == irFloatCompare {
        emitFloatCompareValue(value)
        return
    }
    if opcode == irIntegerToFloat {
        let source = integerIn(operands[0], "rax")
        let target = resultRegister(value, "xmm0")
        emitOptimized("cvtsi2sd {target}, {source}")
        finishResult(value, target)
        return
    }
    if opcode == irFloatToInteger {
        let source = floatIn(operands[0], "xmm0")
        let target = resultRegister(value, "rax")
        emitOptimized("cvttsd2si {target}, {source}")
        finishResult(value, target)
        return
    }
    if opcode == irFloatFromBits {
        let target = resultRegister(value, "xmm0")
        let source = integerIn(operands[0], "rax")
        emitOptimized("movq {target}, {source}")
        finishResult(value, target)
        return
    }
    if opcode == irBitsFromFloat {
        let source = locationOf(operands[0])
        let target = resultRegister(value, "rax")
        if isRegisterLocation(source) { emitOptimized("movq {target}, {source}") }
        else { emitOptimized("mov {target}, {source}") }
        finishResult(value, target)
        return
    }
    if opcode == irLoad or opcode == irFloatLoad or opcode == irLoadFrame or opcode == irFloatLoadFrame {
        let base = integerIn(operands[0], "rcx")
        if opcode == irFloatLoad or opcode == irFloatLoadFrame {
            let target = resultRegister(value, "xmm0")
            emitOptimized("movsd {target}, {memoryAt(base, immediate)}")
            finishResult(value, target)
        } else {
            let target = resultRegister(value, "rax")
            emitOptimized("mov {target}, {memoryAt(base, immediate)}")
            finishResult(value, target)
        }
        return
    }
    if opcode >= irLoadRaw64 and opcode <= irLoadRaw8 {
        var base = integerIn(operands[0], "rcx")
        if operands.len() > 1 {
            let index = integerIn(operands[1], "rdx")
            base = "{base} + {index}"
        }
        let target = resultRegister(value, "rax")
        let address = memoryAt(base, immediate)
        if opcode == irLoadRaw64 { emitOptimized("mov {target}, {address}") }
        else if opcode == irLoadRaw32 {
            emitOptimized("mov eax, dword ptr {address}")     // writing eax zero-extends
            finishResult(value, "rax")
            return
        }
        else if opcode == irLoadRaw16 { emitOptimized("movzx {target}, word ptr {address}") }
        else { emitOptimized("movzx {target}, byte ptr {address}") }
        finishResult(value, target)
        return
    }
    if opcode >= irStoreRaw64 and opcode <= irStoreRaw8 {
        var base = integerIn(operands[0], "rcx")
        if operands.len() > 2 {
            let index = integerIn(operands[2], "rdx")
            base = "{base} + {index}"
        }
        let address = memoryAt(base, immediate)
        if opcode == irStoreRaw64 {
            if isImmediateConstant(operands[1]) {
                emitOptimized("mov qword ptr {address}, {irImmediates[operands[1]]}")
                return
            }
            let stored = integerIn(operands[1], "rax")
            emitOptimized("mov {address}, {stored}")
            return
        }
        emitOptimized("mov rax, {locationOf(operands[1])}")
        if opcode == irStoreRaw32 { emitOptimized("mov {address}, eax") } else { emitOptimized("mov {address}, al") }
        return
    }
    if opcode == irLoadByte {
        let base = integerIn(operands[0], "rcx")
        let index = integerIn(operands[1], "rdx")
        let target = resultRegister(value, "rax")
        emitOptimized("movzx {target}, byte ptr [{base} + {index} + 8]")
        finishResult(value, target)
        return
    }
    if opcode == irLoadIndexed or opcode == irFloatLoadIndexed {
        let base = integerIn(operands[0], "rcx")
        let index = integerIn(operands[1], "rdx")
        var address = "[{base} + {index}*8]"
        if immediate != 0 { address = "[{base} + {index}*8 + {immediate}]" }
        if opcode == irFloatLoadIndexed {
            let target = resultRegister(value, "xmm0")
            emitOptimized("movsd {target}, {address}")
            finishResult(value, target)
        } else {
            let target = resultRegister(value, "rax")
            emitOptimized("mov {target}, {address}")
            finishResult(value, target)
        }
        return
    }
    if opcode == irStore or opcode == irStoreFrame {
        let base = integerIn(operands[0], "rcx")
        if isImmediateConstant(operands[1]) {
            emitOptimized("mov qword ptr {memoryAt(base, immediate)}, {irImmediates[operands[1]]}")
            return
        }
        let stored = integerIn(operands[1], "rax")
        emitOptimized("mov {memoryAt(base, immediate)}, {stored}")
        return
    }
    if opcode == irFloatStore or opcode == irFloatStoreFrame {
        let base = integerIn(operands[0], "rcx")
        let stored = floatIn(operands[1], "xmm0")
        emitOptimized("movsd {memoryAt(base, immediate)}, {stored}")
        return
    }
    if opcode == irStoreIndexed or opcode == irFloatStoreIndexed {
        let base = integerIn(operands[0], "rcx")
        let index = integerIn(operands[1], "rdx")
        var address = "[{base} + {index}*8]"
        if immediate != 0 { address = "[{base} + {index}*8 + {immediate}]" }
        if opcode == irFloatStoreIndexed {
            let stored = floatIn(operands[2], "xmm0")
            emitOptimized("movsd {address}, {stored}")
        } else if isImmediateConstant(operands[2]) {
            emitOptimized("mov qword ptr {address}, {irImmediates[operands[2]]}")
        } else {
            let stored = integerIn(operands[2], "rax")
            emitOptimized("mov {address}, {stored}")
        }
        return
    }
    if opcode == irLoadGlobal or opcode == irFloatLoadGlobal {
        let address = "[rip + __zephyr_globals + {8 * immediate}]"
        if opcode == irFloatLoadGlobal {
            let target = resultRegister(value, "xmm0")
            emitOptimized("movsd {target}, {address}")
            finishResult(value, target)
        } else {
            let target = resultRegister(value, "rax")
            emitOptimized("mov {target}, {address}")
            finishResult(value, target)
        }
        return
    }
    if opcode == irStoreGlobal {
        let stored = integerIn(operands[0], "rax")
        emitOptimized("mov [rip + __zephyr_globals + {8 * immediate}], {stored}")
        return
    }
    if opcode == irFloatStoreGlobal {
        let stored = floatIn(operands[0], "xmm0")
        emitOptimized("movsd [rip + __zephyr_globals + {8 * immediate}], {stored}")
        return
    }
    if opcode == irBoundsCheck {                  // unsigned: a negative index fails too
        let index = integerIn(operands[1], "rdx")
        emitOptimized("cmp {index}, {locationOf(operands[0])}")
        emitOptimized("jae .L{emitColdPanic(immediate)}")
        return
    }
    if opcode == irListLength or opcode == irListData {
        let base = integerIn(operands[0], "rcx")
        let target = resultRegister(value, "rax")
        if opcode == irListLength { emitOptimized("mov {target}, [{base}]") } else { emitOptimized("mov {target}, [{base} + 16]") }
        finishResult(value, target)
        return
    }
    if opcode == irReciprocal {
        let doneLabel = allocateLabel()
        emitOptimized("mov rcx, {locationOf(operands[0])}")
        emitOptimized("xor eax, eax")
        emitOptimized("test rcx, rcx")
        emitOptimized("jle .L{doneLabel}")
        emitOptimized("mov rax, -1")
        emitOptimized("xor edx, edx")
        emitOptimized("div rcx")
        optimizerLines.push(".L{doneLabel}:\n")
        finishResult(value, "rax")
        return
    }
    if opcode == irDivideByInvariant or opcode == irModuloByInvariant {
        // q0 = mulhi(n, M) is q or q - 1 for any n >= 0; one correction makes it
        // exact. n < 0 or M == 0 (a divisor <= 0) take the plain idiv.
        let slowLabel = allocateLabel()
        let validLabel = allocateLabel()
        let doneLabel = allocateLabel()
        let dividend = locationOf(operands[0])
        let divisor = locationOf(operands[1])
        emitOptimized("mov rax, {dividend}")
        emitOptimized("mov rcx, {locationOf(operands[2])}")
        emitOptimized("test rcx, rcx")
        emitOptimized("je .L{slowLabel}")
        emitOptimized("test rax, rax")
        emitOptimized("js .L{slowLabel}")
        emitOptimized("mov r11, rax")
        emitOptimized("mul rcx")
        emitOptimized("mov rax, rdx")
        emitOptimized("mov rcx, {divisor}")
        emitOptimized("imul rdx, rcx")
        emitOptimized("sub r11, rdx")
        emitOptimized("cmp r11, rcx")
        emitOptimized("jb .L{validLabel}")
        emitOptimized("add rax, 1")
        emitOptimized("sub r11, rcx")
        optimizerLines.push(".L{validLabel}:\n")
        if opcode == irModuloByInvariant { emitOptimized("mov rax, r11") }
        emitOptimized("jmp .L{doneLabel}")
        optimizerLines.push(".L{slowLabel}:\n")
        emitOptimized("mov rcx, {divisor}")
        emitOptimized("cqo")
        emitOptimized("idiv rcx")
        if opcode == irModuloByInvariant { emitOptimized("mov rax, rdx") }
        optimizerLines.push(".L{doneLabel}:\n")
        finishResult(value, "rax")
        return
    }
    if opcode == irDivideByConstant or opcode == irModuloByConstant {
        let divisor = immediate
        let halfUnsignedMaximum = 9223372036854775807     // (2^64-1)/d without unsigned ints: 2^64-1 = 2a+1
        let magic = 2 * (halfUnsignedMaximum / divisor) + (2 * (halfUnsignedMaximum % divisor) + 1) / divisor
        let slowLabel = allocateLabel()
        let validLabel = allocateLabel()
        let doneLabel = allocateLabel()
        emitOptimized("mov rax, {locationOf(operands[0])}")
        emitOptimized("test rax, rax")
        emitOptimized("js .L{slowLabel}")
        emitOptimized("mov rcx, rax")
        emitOptimized("movabs rdx, {magic}")
        emitOptimized("mul rdx")
        emitOptimized("imul rax, rdx, {divisor}")
        emitOptimized("sub rcx, rax")
        emitOptimized("mov rax, rdx")
        emitOptimized("cmp rcx, {divisor}")
        emitOptimized("jb .L{validLabel}")
        emitOptimized("add rax, 1")
        emitOptimized("sub rcx, {divisor}")
        optimizerLines.push(".L{validLabel}:\n")
        if opcode == irModuloByConstant { emitOptimized("mov rax, rcx") }
        emitOptimized("jmp .L{doneLabel}")
        optimizerLines.push(".L{slowLabel}:\n")
        emitOptimized("mov rcx, {divisor}")
        emitOptimized("cqo")
        emitOptimized("idiv rcx")
        if opcode == irModuloByConstant { emitOptimized("mov rax, rdx") }
        optimizerLines.push(".L{doneLabel}:\n")
        finishResult(value, "rax")
        return
    }
    if opcode == irZeroCheck {
        let divisor = integerIn(operands[0], "rax")
        emitOptimized("test {divisor}, {divisor}")
        emitOptimized("je .L{emitColdPanic(immediate)}")
        return
    }
    if opcode == irCall and isInlineRetain(value) {
        // runtimeRetainReference in place: count only what lives in the heap
        let skipLabel = allocateLabel()
        let target = resultRegister(value, "rax")
        emitOptimized("mov {target}, {locationOf(operands[0])}")
        emitOptimized("cmp {target}, qword ptr [rip + __zephyr_globals + {8 * heapBaseGlobalIndex}]")
        emitOptimized("jb .L{skipLabel}")
        emitOptimized("cmp {target}, qword ptr [rip + __zephyr_globals + {8 * heapBumpGlobalIndex}]")
        emitOptimized("jae .L{skipLabel}")
        emitOptimized("inc qword ptr [{target} - 24]")
        optimizerLines.push(".L{skipLabel}:\n")
        finishResult(value, target)
        return
    }
    if opcode == irCall and heapBumpGlobalIndex >= 0 and heapBaseGlobalIndex >= 0 and isRuntimeCallTo(value, "runtimeReleaseReference") {
        // the common case, another holder remains, in place; the call only frees
        let callLabel = allocateLabel()
        let doneLabel = allocateLabel()
        emitOptimized("mov rax, {locationOf(operands[0])}")
        emitOptimized("cmp rax, qword ptr [rip + __zephyr_globals + {8 * heapBaseGlobalIndex}]")
        emitOptimized("jb .L{doneLabel}")
        emitOptimized("cmp rax, qword ptr [rip + __zephyr_globals + {8 * heapBumpGlobalIndex}]")
        emitOptimized("jae .L{doneLabel}")
        emitOptimized("cmp qword ptr [rax - 24], 1")
        emitOptimized("jle .L{callLabel}")
        emitOptimized("sub qword ptr [rax - 24], 1")
        emitOptimized("jmp .L{doneLabel}")
        optimizerLines.push(".L{callLabel}:\n")
        emitCallInstruction(value)
        optimizerLines.push(".L{doneLabel}:\n")
        return
    }
    if opcode == irCall {
        emitCallInstruction(value)
        return
    }
    optimizerBail("cannot emit opcode {opcode}")
}

fn emitTerminator(block: int, value: int) {
    let opcode = irOpcodes[value]
    let operands = irOperands[value]
    let successors = blockSuccessors[block]
    if opcode == irJump {
        emitPhiMoves(block)
        if block < preheaderLoadGroups.len() {
            for i in 0..preheaderLoadGroups[block].len() {
                emitOptimized("mov {integerRegisterNames[preheaderLoadRegisters[block][i]]}, qword ptr [rsp + {spillOffset(valueSpillSlots[preheaderLoadGroups[block][i]])}]")
            }
        }
        let destination = jumpDestination(successors[0])
        if canRepeatBranch(block, destination) {
            // a back edge to a header that only tests: test here, no jump back
            let instructions = blockInstructions[destination]
            emitTerminator(destination, instructions[instructions.len() - 1])
            return
        }
        jumpUnlessNext(successors[0])
        return
    }
    if opcode == irBranch {
        let condition = integerIn(operands[0], "rax")
        emitOptimized("test {condition}, {condition}")
        conditionalJump("ne", "e", successors[0], successors[1])
        return
    }
    if opcode == irBranchCompare {
        let condition = irImmediates[value]
        let left = integerIn(operands[0], "rax")
        compareWith(left, operands[1])
        conditionalJump(conditionSuffix(condition), conditionSuffix(invertCondition(condition)), successors[0], successors[1])
        return
    }
    if opcode == irBranchFloatCompare {
        let condition = irImmediates[value]
        let trueBlock = successors[0]
        let falseBlock = successors[1]
        if condition == conditionEqual or condition == conditionNotEqual {
            let left = floatIn(operands[0], "xmm0")
            let right = floatIn(operands[1], "xmm1")
            emitOptimized("ucomisd {left}, {right}")
            if condition == conditionEqual {
                emitOptimized("jp {blockLabelText(falseBlock)}")
                conditionalJump("e", "ne", trueBlock, falseBlock)
            } else {
                emitOptimized("jp {blockLabelText(trueBlock)}")
                conditionalJump("ne", "e", trueBlock, falseBlock)
            }
            return
        }
        if condition == conditionGreater or condition == conditionGreaterOrEqual {
            let left = floatIn(operands[0], "xmm0")
            emitOptimized("comisd {left}, {locationOf(operands[1])}")
        } else {
            let right = floatIn(operands[1], "xmm0")
            emitOptimized("comisd {right}, {locationOf(operands[0])}")
        }
        if condition == conditionGreater or condition == conditionLess { conditionalJump("a", "be", trueBlock, falseBlock) }
        else { conditionalJump("ae", "b", trueBlock, falseBlock) }
        return
    }
    if opcode == irReturn {
        if operands.len() > 0 {
            let result = locationOf(operands[0])
            if result != "rax" { emitOptimized("mov rax, {result}") }
        }
        emitEpilogue()
        return
    }
    if opcode == irUnreachable {
        emitOptimized("lea rcx, [rip + __s{irImmediates[value]}]")
        emitOptimized("and rsp, -16")
        emitOptimized("sub rsp, 32")
        emitOptimized("call runtimePanicWithString")
        return
    }
    if opcode == irPanicAt {
        emitOptimized("mov rdx, {locationOf(operands[0])}")
        emitOptimized("lea rcx, [rip + __s{irImmediates[value]}]")
        emitOptimized("and rsp, -16")
        emitOptimized("sub rsp, 32")
        emitOptimized("call runtimePanicAt")
        return
    }
    optimizerBail("cannot emit terminator {opcode}")
}

// may `block` end with `header`'s branch in place of jumping back to it: the
// header holds only phis (already moved) and a compare, and both blocks see
// the same promoted registers
fn canRepeatBranch(block: int, header: int) -> bool {
    let instructions = blockInstructions[header]
    if instructions.len() == 0 or header == block { return false }
    let terminator = instructions[instructions.len() - 1]
    if irOpcodes[terminator] != irBranchCompare and irOpcodes[terminator] != irBranch { return false }
    for i in 0..instructions.len() - 1 {
        if irOpcodes[instructions[i]] != irPhi { return false }
    }
    var headerPosition = 0 - 1
    for position in 0..blockOrder.len() {
        if blockOrder[position] == header { headerPosition = position }
    }
    if headerPosition < 0 or headerPosition >= currentOrderPosition { return false }        // backward jumps only
    if block >= blockPromotedGroups.len() or header >= blockPromotedGroups.len() { return block >= blockPromotedGroups.len() and header >= blockPromotedGroups.len() }
    let blockGroups = blockPromotedGroups[block]
    let headerGroups = blockPromotedGroups[header]
    if blockGroups.len() != headerGroups.len() { return false }
    for i in 0..blockGroups.len() {
        if blockGroups[i] != headerGroups[i] or blockPromotedRegisters[block][i] != blockPromotedRegisters[header][i] { return false }
    }
    return true
}

fn saveAreaOffset(index: int) -> int { return outgoingAreaSize + 8 * spillSlotCount + 8 * index }

fn emitEpilogue() {
    var index = 0
    for register in savedIntegerRegisters {
        emitOptimized("mov {integerRegisterNames[register]}, [rsp + {saveAreaOffset(index)}]")
        index += 1
    }
    for register in savedFloatRegisters {
        emitOptimized("movsd {floatRegisterNames[register]}, [rsp + {saveAreaOffset(index)}]")
        index += 1
    }
    emitOptimized("mov rsp, rbp")
    emitOptimized("pop rbp")
    emitOptimized("ret")
}

// frame: [rsp] outgoing stack arguments | spill slots | callee-saved registers
fn emitRegionCode(label: str, parameterCount: int, registerCall: bool) {
    emittingBlock = 0 - 1
    var noLines: [str] = []
    optimizerLines = noLines
    var noColdLines: [str] = []
    optimizerColdLines = noColdLines
    var maximumStackArguments = 0
    for block in blockOrder {
        for instruction in blockInstructions[block] {
            if irOpcodes[instruction] == irCall { maximumStackArguments = max(maximumStackArguments, outgoingSlotsOfCall(instruction)) }
        }
    }
    outgoingAreaSize = 8 * maximumStackArguments
    var noSavedIntegers: [int] = []
    savedIntegerRegisters = noSavedIntegers
    var noSavedFloats: [int] = []
    savedFloatRegisters = noSavedFloats
    for i in 0..integerRegisterNames.len() {
        if integerRegisterUsed[i] and integerRegisterCalleeSaved[i] { savedIntegerRegisters.push(i) }
    }
    for i in 0..floatRegisterNames.len() {
        if floatRegisterUsed[i] and floatRegisterCalleeSaved[i] { savedFloatRegisters.push(i) }
    }
    var frameSize = outgoingAreaSize + 8 * spillSlotCount + 8 * (savedIntegerRegisters.len() + savedFloatRegisters.len())
    frameSize = (frameSize + 15) / 16 * 16
    var noLabels: [int] = []
    blockLabels = noLabels
    for block in 0..blockInstructions.len() { blockLabels.push(allocateLabel()) }
    optimizerLines.push(label + ":\n")
    emitOptimized("push rbp")
    emitOptimized("mov rbp, rsp")
    emitOptimized("and rsp, -16")
    if frameSize > 0 { emitOptimized("sub rsp, {frameSize}") }
    var index = 0
    for register in savedIntegerRegisters {
        emitOptimized("mov [rsp + {saveAreaOffset(index)}], {integerRegisterNames[register]}")
        index += 1
    }
    for register in savedFloatRegisters {
        emitOptimized("movsd [rsp + {saveAreaOffset(index)}], {floatRegisterNames[register]}")
        index += 1
    }
    // parameters into their allocated homes, as one parallel move
    clearMoves()
    for instruction in blockInstructions[0] {
        if irOpcodes[instruction] != irParameter { continue }
        let parameterIndex = irImmediates[instruction]
        var source = "rcx"
        if regionIsFunction {
            let argumentRegisters = ["rcx", "rdx", "r8", "r9"]
            if registerCall { source = argumentRegisters[parameterIndex] }
            else if parameterIndex == parameterCount { source = "qword ptr [rbp + {16 + 8 * parameterCount}]" }     // a closure's env
            else { source = "qword ptr [rbp + {16 + 8 * (parameterCount - 1 - parameterIndex)}]" }
        }
        addMove(source, locationOf(instruction))
    }
    emitParallelMoves()
    countUses()
    var noFolds: [bool] = []
    foldedFloatLoads = noFolds
    for value in 0..irOpcodes.len() { foldedFloatLoads.push(false) }
    // blocks that only jump on are never entered: every jump goes past them
    var emittedOrder: [int] = []
    for orderPosition in 0..blockOrder.len() {
        let block = blockOrder[orderPosition]
        if orderPosition == 0 or jumpDestination(block) == block { emittedOrder.push(block) }
    }
    blockOrder = emittedOrder
    for orderPosition in 0..blockOrder.len() {
        currentOrderPosition = orderPosition
        let block = blockOrder[orderPosition]
        emittingBlock = block
        for header in loopHeaders {
            if header == block { optimizerLines.push(".balign 16\n") }     // a loop's back edges land on a fetch-block boundary
        }
        optimizerLines.push(".L{blockLabels[block]}:\n")
        let instructions = blockInstructions[block]
        for position in 0..instructions.len() {
            let instruction = instructions[position]
            if position + 1 < instructions.len() and canFoldFloatLoad(instruction, instructions[position + 1]) {
                foldedFloatLoads[instruction] = true
                continue
            }
            if isTerminatorOpcode(irOpcodes[instruction]) { emitTerminator(block, instruction) }
            else { emitInstructionFor(instruction) }
        }
    }
    emittingBlock = 0 - 1
    for line in optimizerColdLines { optimizerLines.push(line) }
    optimizerLines.push("\n")
}

// ================= constant folding and simplification =================

fn isConstantValue(value: int) -> bool { return irOpcodes[value] == irConstant }

fn becomeConstant(value: int, constant: int) {
    irOpcodes[value] = irConstant
    irClasses[value] = classInteger
    var noOperands: [int] = []
    irOperands[value] = noOperands
    irImmediates[value] = constant
}

fn becomeFloatConstant(value: int, constantBits: int) {
    irOpcodes[value] = irFloatConstant
    irClasses[value] = classFloat
    var noOperands: [int] = []
    irOperands[value] = noOperands
    irImmediates[value] = constantBits
}

fn powerOfTwoExponent(value: int) -> int {
    if value <= 0 or (value & (value - 1)) != 0 { return 0 - 1 }
    var exponent = 0
    while (1 << exponent) != value { exponent += 1 }
    return exponent
}

fn compareConstants(left: int, right: int, condition: int) -> bool {
    if condition >= conditionBelowOrEqual {
        // unsigned: flip the sign bits, then compare signed
        let signBit = 0 - 9223372036854775807 - 1
        var signed = conditionLessOrEqual
        if condition == conditionAbove { signed = conditionGreater }
        else if condition == conditionBelow { signed = conditionLess }
        else if condition == conditionAboveOrEqual { signed = conditionGreaterOrEqual }
        return compareConstants(left ^ signBit, right ^ signBit, signed)
    }
    if condition == conditionEqual { return left == right }
    if condition == conditionNotEqual { return left != right }
    if condition == conditionLess { return left < right }
    if condition == conditionLessOrEqual { return left <= right }
    if condition == conditionGreater { return left > right }
    return left >= right
}

// remove the edge block -> successor (one occurrence), with its phi operands
fn removeEdge(block: int, successor: int) {
    var successors: [int] = []
    var removedSuccessor = false
    for next in blockSuccessors[block] {
        if next == successor and not removedSuccessor { removedSuccessor = true }
        else { successors.push(next) }
    }
    blockSuccessors[block] = successors
    let edgeIndex = predecessorIndex(successor, block)
    if edgeIndex < 0 { return }
    var predecessors: [int] = []
    for i in 0..blockPredecessors[successor].len() {
        if i != edgeIndex { predecessors.push(blockPredecessors[successor][i]) }
    }
    blockPredecessors[successor] = predecessors
    for instruction in blockInstructions[successor] {
        if irOpcodes[instruction] != irPhi { continue }
        var operands: [int] = []
        for i in 0..irOperands[instruction].len() {
            if i != edgeIndex { operands.push(irOperands[instruction][i]) }
        }
        irOperands[instruction] = operands
    }
}

fn blockHasPhis(block: int) -> bool {
    for instruction in blockInstructions[block] {
        if irOpcodes[instruction] == irPhi { return true }
    }
    return false
}

// A block that only jumps to a block nobody else reaches absorbs it.
fn mergeStraightBlocks() {
    for block in 0..blockInstructions.len() {
        var merging = true
        while merging {
            merging = false
            let instructions = blockInstructions[block]
            if instructions.len() == 0 or blockSuccessors[block].len() != 1 { continue }
            let terminator = instructions[instructions.len() - 1]
            let successor = blockSuccessors[block][0]
            if irOpcodes[terminator] != irJump or successor == block or successor == 0 { continue }
            if blockPredecessors[successor].len() != 1 or blockHasPhis(successor) { continue }
            var merged: [int] = []
            for i in 0..(instructions.len() - 1) { merged.push(instructions[i]) }
            for moved in blockInstructions[successor] {
                merged.push(moved)
                irBlockOf[moved] = block
            }
            blockInstructions[block] = merged
            blockSuccessors[block] = blockSuccessors[successor]
            for next in blockSuccessors[successor] {
                let edgeIndex = predecessorIndex(next, successor)
                blockPredecessors[next][edgeIndex] = block
            }
            var noInstructions: [int] = []
            blockInstructions[successor] = noInstructions
            var noSuccessors: [int] = []
            blockSuccessors[successor] = noSuccessors
            var noPredecessors: [int] = []
            blockPredecessors[successor] = noPredecessors
            merging = true
        }
    }
}

// Jump threading. A block holding only a phi and a branch on it (what a
// boolean-valued inline or && / || leaves): a predecessor that feeds it a
// constant jumps straight to the side it picks, and one that feeds it a
// compare it just made branches on that compare itself.
fn threadBranches() -> bool {
    countUses()
    var changed = false
    for block in 0..blockInstructions.len() {
        let instructions = blockInstructions[block]
        if instructions.len() != 2 { continue }
        let phi = instructions[0]
        let terminator = instructions[1]
        if irOpcodes[phi] != irPhi or irOpcodes[terminator] != irBranch or irUseCounts[phi] != 1 { continue }
        if resolveValue(irOperands[terminator][0]) != phi { continue }
        let successors = blockSuccessors[block]
        if successors[0] == successors[1] or blockHasPhis(successors[0]) or blockHasPhis(successors[1]) { continue }
        var index = blockPredecessors[block].len() - 1
        while index >= 0 {
            let predecessor = blockPredecessors[block][index]
            let incoming = resolveValue(irOperands[phi][index])
            let predecessorInstructions = blockInstructions[predecessor]
            let predecessorTerminator = predecessorInstructions[predecessorInstructions.len() - 1]
            let incomingOpcode = irOpcodes[incoming]
            if predecessor != block and blockSuccessors[predecessor].len() == 1 and irOpcodes[predecessorTerminator] == irJump {
                if isConstantValue(incoming) {
                    var target = successors[1]
                    if irImmediates[incoming] != 0 { target = successors[0] }
                    removeEdge(predecessor, block)
                    addEdge(predecessor, target)
                    changed = true
                } else if (incomingOpcode == irCompare or incomingOpcode == irFloatCompare) and irBlockOf[incoming] == predecessor and irUseCounts[incoming] == 1 {
                    removeEdge(predecessor, block)
                    irOpcodes[predecessorTerminator] = irBranchCompare
                    if incomingOpcode == irFloatCompare { irOpcodes[predecessorTerminator] = irBranchFloatCompare }
                    irOperands[predecessorTerminator] = irOperands[incoming]
                    irImmediates[predecessorTerminator] = irImmediates[incoming]
                    addEdge(predecessor, successors[0])
                    addEdge(predecessor, successors[1])
                    changed = true
                }
            }
            index -= 1
        }
    }
    return changed
}

// a branch whose outcome is known becomes a jump
fn foldBranch(block: int, terminator: int, taken: bool) {
    let successors = blockSuccessors[block]
    var kept = successors[1]
    var dropped = successors[0]
    if taken {
        kept = successors[0]
        dropped = successors[1]
    }
    removeEdge(block, dropped)
    irOpcodes[terminator] = irJump
    var noOperands: [int] = []
    irOperands[terminator] = noOperands
}

// Returns true if anything changed. Values are rewritten in place, so every
// user keeps pointing at the same value number.
// a < b as b > a: the mirror of a condition, for swapped operands
fn mirroredCondition(condition: int) -> int {
    if condition == conditionLess { return conditionGreater }
    if condition == conditionLessOrEqual { return conditionGreaterOrEqual }
    if condition == conditionBelowOrEqual { return conditionAboveOrEqual }
    if condition == conditionAboveOrEqual { return conditionBelowOrEqual }
    if condition == conditionBelow { return conditionAbove }
    if condition == conditionAbove { return conditionBelow }
    if condition == conditionGreater { return conditionLess }
    if condition == conditionGreaterOrEqual { return conditionLessOrEqual }
    return condition
}

fn foldInstruction(block: int, value: int) -> bool {
    let opcode = irOpcodes[value]
    let operands = irOperands[value]
    if operands.len() == 0 { return false }
    if (opcode == irCompare or opcode == irBranchCompare) and isConstantValue(resolveValue(operands[0])) and not isConstantValue(resolveValue(operands[1])) {
        irOperands[value] = [operands[1], operands[0]]
        irImmediates[value] = mirroredCondition(irImmediates[value])
        return true
    }
    let first = resolveValue(operands[0])
    var second = 0 - 1
    if operands.len() > 1 { second = resolveValue(operands[1]) }
    let firstConstant = isConstantValue(first)
    let secondConstant = second >= 0 and isConstantValue(second)
    let firstValue = irImmediates[first]
    var secondValue = 0
    if second >= 0 { secondValue = irImmediates[second] }
    if (opcode == irCompare or opcode == irBranchCompare) and first == second and irClasses[first] == classInteger {
        let holds = compareConstants(0, 0, irImmediates[value])       // x against itself
        if opcode == irBranchCompare { foldBranch(block, value, holds) }
        else if holds { becomeConstant(value, 1) }
        else { becomeConstant(value, 0) }
        return true
    }
    if firstConstant and secondConstant {
        if opcode == irBranchCompare {
            foldBranch(block, value, compareConstants(firstValue, secondValue, irImmediates[value]))
            return true
        }
        var known = true
        var result = 0
        if opcode == irAdd { result = firstValue + secondValue }
        else if opcode == irSubtract { result = firstValue - secondValue }
        else if opcode == irMultiply { result = firstValue * secondValue }
        else if opcode == irBitAnd { result = firstValue & secondValue }
        else if opcode == irBitOr { result = firstValue | secondValue }
        else if opcode == irBitXor { result = firstValue ^ secondValue }
        else if opcode == irShiftLeft { result = firstValue << (secondValue & 63) }
        else if opcode == irShiftRight { result = firstValue >> (secondValue & 63) }
        else if opcode == irDivide and secondValue != 0 and secondValue != 0 - 1 { result = firstValue / secondValue }
        else if opcode == irModulo and secondValue != 0 and secondValue != 0 - 1 { result = firstValue % secondValue }
        else if opcode == irIntegerMinimum { result = min(firstValue, secondValue) }
        else if opcode == irIntegerMaximum { result = max(firstValue, secondValue) }
        else if opcode == irCompare {
            if compareConstants(firstValue, secondValue, irImmediates[value]) { result = 1 }
        }
        else { known = false }
        if known {
            becomeConstant(value, result)
            return true
        }
    }
    if firstConstant and operands.len() == 1 {
        if opcode == irBranch {
            foldBranch(block, value, firstValue != 0)
            return true
        }
        if opcode == irZeroCheck and firstValue != 0 {
            valueDead[value] = true
            return true
        }
        if opcode == irNegate {
            becomeConstant(value, 0 - firstValue)
            return true
        }
        if opcode == irIntegerAbsolute {
            becomeConstant(value, abs(firstValue))
            return true
        }
        if opcode == irFloatFromBits {
            becomeFloatConstant(value, firstValue)
            return true
        }
        if opcode == irIntegerToFloat {
            becomeFloatConstant(value, bits(firstValue as float))
            return true
        }
    }
    if opcode == irBitsFromFloat and irOpcodes[first] == irFloatConstant {
        becomeConstant(value, irImmediates[first])
        return true
    }
    // identities: the result is one of the operands, or a cheaper operation
    if secondConstant and not firstConstant {
        if secondValue == 0 and (opcode == irAdd or opcode == irSubtract or opcode == irBitOr or opcode == irBitXor or opcode == irShiftLeft or opcode == irShiftRight) {
            valueForward[value] = first
            return true
        }
        if secondValue == 1 and (opcode == irMultiply or opcode == irDivide) {
            valueForward[value] = first
            return true
        }
        if secondValue == 0 and (opcode == irMultiply or opcode == irBitAnd) {
            becomeConstant(value, 0)
            return true
        }
        let exponent = powerOfTwoExponent(secondValue)
        if opcode == irMultiply and exponent > 0 {
            irOpcodes[value] = irShiftLeft
            irOperands[value] = [first, entryConstant(exponent)]
            return true
        }
        if opcode == irDivide and exponent > 0 {
            irOpcodes[value] = irDividePowerOfTwo
            irOperands[value] = [first]
            irImmediates[value] = exponent
            return true
        }
        if opcode == irModulo and exponent > 0 and exponent < 32 {
            irOpcodes[value] = irModuloPowerOfTwo
            irOperands[value] = [first]
            irImmediates[value] = exponent
            return true
        }
        if (opcode == irDivide or opcode == irModulo) and exponent < 0 and secondValue > 1 and secondValue < 2147483648 {
            if opcode == irDivide { irOpcodes[value] = irDivideByConstant } else { irOpcodes[value] = irModuloByConstant }
            irOperands[value] = [first]
            irImmediates[value] = secondValue
            return true
        }
        // x % 2^k == 0 is x & (2^k - 1) == 0, when nothing else reads the remainder
        if (opcode == irCompare or opcode == irBranchCompare) and secondValue == 0 and irOpcodes[first] == irModuloPowerOfTwo and irUseCounts[first] == 1 {
            let condition = irImmediates[value]
            if condition == conditionEqual or condition == conditionNotEqual {
                let mask = (1 << irImmediates[first]) - 1
                irOpcodes[first] = irBitAnd
                irOperands[first] = [irOperands[first][0], entryConstant(mask)]
                irImmediates[first] = 0
                return true
            }
        }
    }
    if firstConstant and not secondConstant and second >= 0 {
        if firstValue == 0 and (opcode == irAdd or opcode == irBitOr or opcode == irBitXor) {
            valueForward[value] = second
            return true
        }
        if firstValue == 1 and opcode == irMultiply {
            valueForward[value] = second
            return true
        }
    }
    return false
}

// a fresh constant in the entry block, which dominates every use
// an instruction made by a pass after lowering: it needs its forwarding entries too
fn addLateInstruction(block: int, opcode: int, valueClass: int, operands: [int], immediate: int) -> int {
    let created = addInstruction(block, opcode, valueClass, operands, immediate)
    valueForward.push(created)
    valueDead.push(false)
    return created
}

fn entryConstant(constant: int) -> int {
    var noOperands: [int] = []
    let created = addInstruction(0, irConstant, classInteger, noOperands, constant)
    valueForward.push(created)
    valueDead.push(false)
    return created
}

fn foldIrConstants() {
    var changed = true
    var rounds = 0
    var anyBranchFolded = false
    while changed and rounds < 8 {
        changed = false
        rounds += 1
        countUses()
        for block in 0..blockInstructions.len() {
            for instruction in blockInstructions[block] {
                if valueDead[instruction] or valueForward[instruction] != instruction { continue }
                let wasTerminator = isTerminatorOpcode(irOpcodes[instruction])
                if foldInstruction(block, instruction) {
                    changed = true
                    if wasTerminator { anyBranchFolded = true }
                }
            }
        }
        rewriteOperands()
    }
    if anyBranchFolded {
        removeUnreachableBlocks()
        removeTrivialPhis()
    }
}

// ================= dominators, loops, value numbering, code motion =================
var immediateDominators: [int] = []
var dominatorPreorder: [int] = []          // block -> preorder number in the dominator tree
var dominatorSubtreeEnd: [int] = []        // block -> one past the last preorder number of its subtree
var dominatorTreeOrder: [int] = []         // blocks in dominator-tree preorder

fn intersectDominators(first: int, second: int) -> int {
    var left = first
    var right = second
    while left != right {
        while blockOrderIndex[left] > blockOrderIndex[right] { left = immediateDominators[left] }
        while blockOrderIndex[right] > blockOrderIndex[left] { right = immediateDominators[right] }
    }
    return left
}

// Cooper, Harvey and Kennedy: iterate to the fixpoint over reverse postorder
fn computeDominators() {
    let blockCount = blockInstructions.len()
    var dominators: [int] = []
    for i in 0..blockCount { dominators.push(0 - 1) }
    immediateDominators = dominators
    immediateDominators[0] = 0
    var changed = true
    while changed {
        changed = false
        for orderPosition in 1..blockOrder.len() {
            let block = blockOrder[orderPosition]
            var newDominator = 0 - 1
            for predecessor in blockPredecessors[block] {
                if immediateDominators[predecessor] < 0 { continue }
                if newDominator < 0 { newDominator = predecessor }
                else { newDominator = intersectDominators(predecessor, newDominator) }
            }
            if newDominator != immediateDominators[block] {
                immediateDominators[block] = newDominator
                changed = true
            }
        }
    }
    var children: [[int]] = []
    for i in 0..blockCount {
        var noChildren: [int] = []
        children.push(noChildren)
    }
    for block in blockOrder {
        if block != 0 { children[immediateDominators[block]].push(block) }
    }
    var preorder: [int] = []
    var subtreeEnd: [int] = []
    for i in 0..blockCount {
        preorder.push(0 - 1)
        subtreeEnd.push(0 - 1)
    }
    var order: [int] = []
    var stackBlocks: [int] = [0]
    var stackNext: [int] = [0]
    preorder[0] = 0
    order.push(0)
    while stackBlocks.len() > 0 {
        let top = stackBlocks.len() - 1
        let block = stackBlocks[top]
        if stackNext[top] < children[block].len() {
            let child = children[block][stackNext[top]]
            stackNext[top] = stackNext[top] + 1
            preorder[child] = order.len()
            order.push(child)
            stackBlocks.push(child)
            stackNext.push(0)
        } else {
            subtreeEnd[block] = order.len()
            let poppedBlock = stackBlocks.pop()
            let poppedNext = stackNext.pop()
        }
    }
    dominatorPreorder = preorder
    dominatorSubtreeEnd = subtreeEnd
    dominatorTreeOrder = order
}

fn blockDominates(dominator: int, block: int) -> bool {
    return dominatorPreorder[dominator] <= dominatorPreorder[block] and dominatorPreorder[block] < dominatorSubtreeEnd[dominator]
}

// facts about memory the region can change, for which loads may be reused or moved
var regionClobbersMemory = false
var storedFieldOffsets: [int] = []

fn scanMemoryEffects() {
    regionClobbersMemory = false
    var noOffsets: [int] = []
    storedFieldOffsets = noOffsets
    for block in blockOrder {
        for instruction in blockInstructions[block] {
            let opcode = irOpcodes[instruction]
            if (opcode == irCall and not callKeepsHeapIntact(instruction)) or opcode == irStoreRaw64 or opcode == irStoreRaw32 or opcode == irStoreRaw8 { regionClobbersMemory = true }
            if opcode == irStore or opcode == irFloatStore { storedFieldOffsets.push(irImmediates[instruction]) }
        }
    }
}

fn fieldOffsetStored(offset: int) -> bool {
    for stored in storedFieldOffsets {
        if stored == offset { return true }
    }
    return false
}

// Pure, cannot trap, and reads nothing the region may change: may be computed
// once for all equal copies, and moved to wherever its operands exist.
fn isMovable(value: int) -> bool {
    let opcode = irOpcodes[value]
    if opcode == irListLength and irImmediates[value] == 1 { return true }
    if opcode == irListLength or opcode == irListData { return not regionClobbersMemory }
    if opcode == irLoad or opcode == irFloatLoad { return not regionClobbersMemory and not fieldOffsetStored(irImmediates[value]) }
    if opcode == irConstant or opcode == irFloatConstant or opcode == irDataAddress or opcode == irSymbolAddress or opcode == irReciprocal { return true }
    if opcode >= irAdd and opcode <= irFloatAbsolute { return opcode != irDivide and opcode != irModulo }
    if opcode == irIntegerToFloat or opcode == irFloatToInteger or opcode == irFloatFromBits or opcode == irBitsFromFloat { return true }
    if opcode == irIntegerMinimum or opcode == irIntegerMaximum or opcode == irIntegerAbsolute { return true }
    return opcode == irDividePowerOfTwo or opcode == irModuloPowerOfTwo or opcode == irDivideByConstant or opcode == irModuloByConstant
}

fn isCommutativeOpcode(opcode: int) -> bool {
    return opcode == irAdd or opcode == irMultiply or opcode == irBitAnd or opcode == irBitOr or opcode == irBitXor or opcode == irFloatAdd or opcode == irFloatMultiply or opcode == irIntegerMinimum or opcode == irIntegerMaximum
}

// a load that is valid until memory changes: reusable within one memory epoch
fn isMemoryLoad(value: int) -> bool {
    let opcode = irOpcodes[value]
    return opcode == irListLength or opcode == irListData or opcode == irLoad or opcode == irFloatLoad or opcode == irLoadGlobal or opcode == irFloatLoadGlobal
}

fn changesMemory(value: int) -> bool {
    let opcode = irOpcodes[value]
    if opcode == irCall { return not callKeepsHeapIntact(value) }
    return opcode == irStoreRaw64 or opcode == irStoreRaw32 or opcode == irStoreRaw8 or opcode == irStore or opcode == irFloatStore or opcode == irStoreIndexed or opcode == irFloatStoreIndexed
}

// global value numbering over the dominator tree: an expression computed in a
// dominating block is reused instead of computed again. Loads the region may
// invalidate are reused only within a memory epoch: a run of instructions with
// no store or freeing call, carried into a block from its only predecessor.
fn numberValues() {
    var known: [str: int] = [:]
    var blockExitEpochs: [int] = []
    var blockExitGlobalEpochs: [int] = []           // globals: any call may write them (the runtime's own too)
    var blockExitShapeEpochs: [int] = []            // list lengths and data arrays: only calls and raw stores change them
    for block in 0..blockInstructions.len() {
        blockExitEpochs.push(0 - 1)
        blockExitGlobalEpochs.push(0 - 1)
        blockExitShapeEpochs.push(0 - 1)
    }
    var epochCount = 0
    for block in dominatorTreeOrder {
        var epoch = 0 - 1
        var globalEpoch = 0 - 1
        var shapeEpoch = 0 - 1
        if blockPredecessors[block].len() == 1 {
            epoch = blockExitEpochs[blockPredecessors[block][0]]
            globalEpoch = blockExitGlobalEpochs[blockPredecessors[block][0]]
            shapeEpoch = blockExitShapeEpochs[blockPredecessors[block][0]]
        }
        if shapeEpoch < 0 {
            epochCount += 1
            shapeEpoch = epochCount
        }
        if epoch < 0 {
            epochCount += 1
            epoch = epochCount
        }
        if globalEpoch < 0 {
            epochCount += 1
            globalEpoch = epochCount
        }
        for instruction in blockInstructions[block] {
            if valueDead[instruction] { continue }
            if irOpcodes[instruction] == irCall or changesMemory(instruction) {
                epochCount += 1
                globalEpoch = epochCount
            }
            let changedOpcode = irOpcodes[instruction]
            if (changedOpcode == irCall and changesMemory(instruction)) or changedOpcode == irStoreRaw64 or changedOpcode == irStoreRaw32 or changedOpcode == irStoreRaw8 {
                epochCount += 1
                shapeEpoch = epochCount
            }
            if changesMemory(instruction) {
                epochCount += 1
                epoch = epochCount
                continue
            }
            let storeOpcode = irOpcodes[instruction]
            if storeOpcode == irStoreGlobal or storeOpcode == irFloatStoreGlobal {
                // a later load of this global in the epoch reads what was stored
                var loadOpcode = irLoadGlobal
                var loadClass = classInteger
                if storeOpcode == irFloatStoreGlobal {
                    loadOpcode = irFloatLoadGlobal
                    loadClass = classFloat
                }
                known["m{globalEpoch}:{loadOpcode}:{loadClass}:{irImmediates[instruction]}"] = resolveValue(irOperands[instruction][0])
                continue
            }
            let movable = isMovable(instruction)
            let stringByte = irOpcodes[instruction] == irLoadByte              // strings never change: one key everywhere, but never hoisted
            if not movable and not stringByte and not isMemoryLoad(instruction) { continue }
            let operands = irOperands[instruction]
            var key = "{irOpcodes[instruction]}:{irClasses[instruction]}:{irImmediates[instruction]}"
            if stringByte { key = "s:" + key }
            else if not movable {
                if irOpcodes[instruction] == irLoadGlobal or irOpcodes[instruction] == irFloatLoadGlobal { key = "m{globalEpoch}:" + key }
                else if irOpcodes[instruction] == irListLength or irOpcodes[instruction] == irListData { key = "l{shapeEpoch}:" + key }
                else { key = "m{epoch}:" + key }
            }
            if operands.len() == 2 and isCommutativeOpcode(irOpcodes[instruction]) and resolveValue(operands[0]) > resolveValue(operands[1]) {
                key = key + ":{resolveValue(operands[1])}:{resolveValue(operands[0])}"
            } else {
                for operand in operands { key = key + ":{resolveValue(operand)}" }
            }
            if known.has(key) {
                let earlier = known[key]
                if blockDominates(irBlockOf[earlier], block) {
                    valueForward[instruction] = earlier
                    continue
                }
            }
            known[key] = instruction
        }
        blockExitEpochs[block] = epoch
        blockExitGlobalEpochs[block] = globalEpoch
        blockExitShapeEpochs[block] = shapeEpoch
    }
    rewriteOperands()
}


// natural loops of the back edges; a loop whose header has one outside
// predecessor ending in a plain jump gets that block as its preheader
fn findLoops() {
    var noHeaders: [int] = []
    loopHeaders = noHeaders
    var noSets: [[bool]] = []
    loopBlockSets = noSets
    var noPreheaders: [int] = []
    loopPreheaders = noPreheaders
    let blockCount = blockInstructions.len()
    for block in blockOrder {
        for header in blockSuccessors[block] {
            if not blockDominates(header, block) { continue }
            var loopIndex = 0 - 1
            for i in 0..loopHeaders.len() {
                if loopHeaders[i] == header { loopIndex = i }
            }
            if loopIndex < 0 {
                loopIndex = loopHeaders.len()
                loopHeaders.push(header)
                var members: [bool] = []
                for i in 0..blockCount { members.push(false) }
                members[header] = true
                loopBlockSets.push(members)
            }
            let members = loopBlockSets[loopIndex]
            var worklist: [int] = [block]
            while worklist.len() > 0 {
                let member = worklist.pop()
                if members[member] { continue }
                members[member] = true
                for predecessor in blockPredecessors[member] { worklist.push(predecessor) }
            }
        }
    }
    for i in 0..loopHeaders.len() {
        var outside = 0 - 1
        var outsideCount = 0
        for predecessor in blockPredecessors[loopHeaders[i]] {
            if not loopBlockSets[i][predecessor] {
                outside = predecessor
                outsideCount += 1
            }
        }
        if outsideCount != 1 or blockSuccessors[outside].len() != 1 { outside = 0 - 1 }
        loopPreheaders.push(outside)
    }
}

fn loopSize(loopIndex: int) -> int {
    var size = 0
    for member in loopBlockSets[loopIndex] {
        if member { size += 1 }
    }
    return size
}

// move an instruction to the end of another block (ahead of its terminator)
fn moveInstruction(value: int, toBlock: int) {
    let fromBlock = irBlockOf[value]
    var kept: [int] = []
    for instruction in blockInstructions[fromBlock] {
        if instruction != value { kept.push(instruction) }
    }
    blockInstructions[fromBlock] = kept
    let instructions = blockInstructions[toBlock]
    let terminator = instructions.pop()
    instructions.push(value)
    instructions.push(terminator)
    irBlockOf[value] = toBlock
}

// Loop-invariant code motion, innermost loops first: a movable instruction
// whose operands are all defined outside the loop moves to the preheader.
// Division by an invariant divisor gets its reciprocal computed there too.
fn hoistLoopInvariants() {
    var order: [int] = []
    for i in 0..loopHeaders.len() { order.push(loopSize(i) * 65536 + i) }
    order.sort()
    for key in order {
        let loopIndex = key % 65536
        let preheader = loopPreheaders[loopIndex]
        if preheader < 0 { continue }
        let members = loopBlockSets[loopIndex]
        // what the loop itself may change: a load it cannot change is invariant in it
        var loopFreesOrResizes = false
        var loopStoresElements = false
        var loopFieldOffsets: [int] = []
        for block in blockOrder {
            if not members[block] { continue }
            for instruction in blockInstructions[block] {
                let opcode = irOpcodes[instruction]
                if (opcode == irCall and not callKeepsHeapIntact(instruction)) or opcode == irStoreRaw64 or opcode == irStoreRaw32 or opcode == irStoreRaw8 { loopFreesOrResizes = true }
                if opcode == irStoreIndexed or opcode == irFloatStoreIndexed { loopStoresElements = true }
                if opcode == irStore or opcode == irFloatStore { loopFieldOffsets.push(irImmediates[instruction]) }
            }
        }
        var moved = true
        while moved {
            moved = false
            for block in blockOrder {
                if not members[block] { continue }
                var candidates: [int] = []
                for instruction in blockInstructions[block] { candidates.push(instruction) }
                for instruction in candidates {
                    var movable = isMovable(instruction)
                    let opcode = irOpcodes[instruction]
                    if not movable and not loopFreesOrResizes {
                        if opcode == irListLength or opcode == irListData { movable = true }
                        if (opcode == irLoad or opcode == irFloatLoad) and not loopStoresElements {
                            movable = true
                            for offset in loopFieldOffsets {
                                if offset == irImmediates[instruction] { movable = false }
                            }
                        }
                    }
                    if not movable { continue }
                    var invariant = true
                    for operand in irOperands[instruction] {
                        if members[irBlockOf[operand]] { invariant = false }
                    }
                    if invariant {
                        moveInstruction(instruction, preheader)
                        moved = true
                    }
                }
            }
        }
        var divisors: [int] = []
        var reciprocals: [int] = []
        for block in blockOrder {
            if not members[block] { continue }
            for instruction in blockInstructions[block] {
                let opcode = irOpcodes[instruction]
                if opcode != irDivide and opcode != irModulo { continue }
                let divisor = irOperands[instruction][1]
                if members[irBlockOf[divisor]] or isConstantValue(divisor) { continue }
                var reciprocal = 0 - 1
                for i in 0..divisors.len() {
                    if divisors[i] == divisor { reciprocal = reciprocals[i] }
                }
                if reciprocal < 0 {
                    reciprocal = addInstruction(preheader, irReciprocal, classInteger, [divisor], 0)
                    divisors.push(divisor)
                    reciprocals.push(reciprocal)
                }
                if opcode == irDivide { irOpcodes[instruction] = irDivideByInvariant } else { irOpcodes[instruction] = irModuloByInvariant }
                irOperands[instruction] = [irOperands[instruction][0], divisor, reciprocal]
            }
        }
    }
}

// how many CFG loops hold a block (findLoops' sets)
fn cfgLoopDepth(block: int) -> int {
    var depth = 0
    for members in loopBlockSets {
        if block < members.len() and members[block] { depth += 1 }
    }
    return depth
}

fn isSinkable(value: int) -> bool {
    let opcode = irOpcodes[value]
    if opcode == irPhi or opcode == irParameter or opcode == irConstant or opcode == irFloatConstant { return false }
    if not isPureOpcode(opcode) { return false }
    if opcode == irLoadGlobal or opcode == irFloatLoadGlobal { return not regionGlobalsInMemory }     // memory changes only at the write-back
    // a string's bytes never change, but the string can be freed: sunk past
    // the release of a temporary one, the load would read a free-list link
    if opcode == irListLength and irImmediates[value] == 1 and regionClobbersMemory { return false }
    return isMovable(value)
}

// Code sinking: a pure value moves down to the lowest block dominating all its
// uses (a phi's use sits in its predecessor), never into a deeper loop, so a
// path that does not need it does not compute it.
fn sinkInstructions() {
    var useBlocks: [[int]] = []
    for value in 0..irOpcodes.len() {
        var noUses: [int] = []
        useBlocks.push(noUses)
    }
    for block in blockOrder {
        for instruction in blockInstructions[block] {
            let operands = irOperands[instruction]
            for i in 0..operands.len() {
                var useBlock = block
                if irOpcodes[instruction] == irPhi { useBlock = blockPredecessors[block][i] }
                useBlocks[resolveValue(operands[i])].push(useBlock)
            }
        }
    }
    var reverseOrder: [int] = []
    var orderIndex = blockOrder.len() - 1
    while orderIndex >= 0 {
        reverseOrder.push(blockOrder[orderIndex])
        orderIndex -= 1
    }
    for block in reverseOrder {
        let instructions = blockInstructions[block]
        var index = instructions.len() - 1
        while index >= 0 {
            let value = instructions[index]
            index -= 1
            if valueDead[value] or not isSinkable(value) or useBlocks[value].len() == 0 { continue }
            var target = useBlocks[value][0]
            for useBlock in useBlocks[value] { target = intersectDominators(target, useBlock) }
            if target == block or cfgLoopDepth(target) > cfgLoopDepth(block) { continue }
            // out of this block, in at the head of the target (after its phis)
            var kept: [int] = []
            for instruction in blockInstructions[block] {
                if instruction != value { kept.push(instruction) }
            }
            blockInstructions[block] = kept
            let targetInstructions = blockInstructions[target]
            var placed: [int] = []
            var inserted = false
            for instruction in targetInstructions {
                if not inserted and irOpcodes[instruction] != irPhi {
                    placed.push(value)
                    inserted = true
                }
                placed.push(instruction)
            }
            blockInstructions[target] = placed
            irBlockOf[value] = target
            // its operands are now used from the target
            for operand in irOperands[value] {
                let operandUses = useBlocks[resolveValue(operand)]
                var moved = false
                for i in 0..operandUses.len() {
                    if not moved and operandUses[i] == block {
                        operandUses[i] = target
                        moved = true
                    }
                }
            }
        }
    }
}

fn optimizeLoops() {
    computeBlockOrder()
    computeDominators()
    scanMemoryEffects()
    numberValues()
    findLoops()
    hoistLoopInvariants()
    resetForwarding()
    numberValues()                         // hoisting lands equal loads side by side in one preheader
    eliminateBoundsChecks()
    resetForwarding()
    sinkInstructions()
}

// ---- bounds-check elimination ----
var knownNonNegative: [bool] = []

// which integer values can never be negative: an optimistic fixpoint (loop
// phis start out assumed non-negative, then lose it if an input disagrees).
// Additions of non-negative values are taken not to wrap: an index grows by
// small steps and cannot reach 2^63.
fn computeNonNegative() {
    var assumed: [bool] = []
    for value in 0..irOpcodes.len() { assumed.push(true) }
    knownNonNegative = assumed
    var changed = true
    while changed {
        changed = false
        for block in blockOrder {
            for instruction in blockInstructions[block] {
                let before = knownNonNegative[instruction]
                let after = derivesNonNegative(instruction)
                if before != after {
                    knownNonNegative[instruction] = after
                    changed = true
                }
            }
        }
    }
}

fn operandNonNegative(value: int) -> bool {
    let resolved = resolveValue(value)
    if irOpcodes[resolved] == irConstant { return irImmediates[resolved] >= 0 }
    return knownNonNegative[resolved]
}

fn derivesNonNegative(value: int) -> bool {
    let opcode = irOpcodes[value]
    let operands = irOperands[value]
    if irClasses[value] != classInteger { return false }
    if opcode == irConstant { return irImmediates[value] >= 0 }
    if opcode == irListLength or opcode == irLoadByte or opcode == irLoadRaw8 or opcode == irLoadRaw16 or opcode == irLoadRaw32 or opcode == irCompare or opcode == irFloatCompare { return true }
    if opcode == irPhi {
        for operand in operands {
            if resolveValue(operand) != value and not operandNonNegative(operand) { return false }
        }
        return true
    }
    if opcode == irAdd or opcode == irIntegerMinimum { return operandNonNegative(operands[0]) and operandNonNegative(operands[1]) }
    if opcode == irBitAnd or opcode == irIntegerMaximum { return operandNonNegative(operands[0]) or operandNonNegative(operands[1]) }
    if opcode == irShiftRight or opcode == irModulo or opcode == irModuloPowerOfTwo or opcode == irModuloByConstant or opcode == irModuloByInvariant { return operandNonNegative(operands[0]) }
    if opcode == irDividePowerOfTwo or opcode == irDivideByConstant { return operandNonNegative(operands[0]) }
    return false
}

// does the edge into `block` (its only predecessor branching to it) prove index < length?
fn edgeProvesInBounds(block: int, index: int, length: int) -> bool {
    if blockPredecessors[block].len() != 1 { return false }
    let predecessor = blockPredecessors[block][0]
    let successors = blockSuccessors[predecessor]
    if successors.len() != 2 or successors[0] == successors[1] { return false }
    let instructions = blockInstructions[predecessor]
    let terminator = instructions[instructions.len() - 1]
    if irOpcodes[terminator] != irBranchCompare { return false }
    var condition = irImmediates[terminator]
    if successors[1] == block { condition = invertCondition(condition) }
    let left = resolveValue(irOperands[terminator][0])
    let right = resolveValue(irOperands[terminator][1])
    if left == index and boundNotAbove(right, length, 0) and condition == conditionLess { return true }
    return boundNotAbove(left, length, 0) and right == index and condition == conditionGreater
}

// bound <= length for certain: length itself, or a min() one of whose inputs is
fn boundNotAbove(bound: int, length: int, depth: int) -> bool {
    if bound == length { return true }
    if depth > 3 or irOpcodes[bound] != irIntegerMinimum { return false }
    return boundNotAbove(resolveValue(irOperands[bound][0]), length, depth + 1) or boundNotAbove(resolveValue(irOperands[bound][1]), length, depth + 1)
}

// A bounds check whose index is never negative and sits under a branch that
// proved index < length (same values) cannot fail.
// A check of the same index against the same length that dominates it passed
// already (blocks run in reverse postorder: a dominator's checks come first).
fn eliminateBoundsChecks() {
    computeNonNegative()
    var checkedBlocks: [int: [int]] = [:]           // length/index pair -> blocks with a kept check of it
    for block in blockOrder {
        var kept: [int] = []
        for instruction in blockInstructions[block] {
            if irOpcodes[instruction] == irBoundsCheck {
                if boundsCheckProven(block, instruction) { continue }
                let pairKey = resolveValue(irOperands[instruction][0]) * 4194304 + resolveValue(irOperands[instruction][1])
                if checkedBlocks.has(pairKey) {
                    if checkDominates(checkedBlocks[pairKey], block) { continue }
                    checkedBlocks[pairKey].push(block)
                } else {
                    checkedBlocks[pairKey] = [block]
                }
            }
            // a non-negative dividend needs no sign fix-up: a mask or a shift
            let opcode = irOpcodes[instruction]
            if (opcode == irModuloPowerOfTwo or opcode == irDividePowerOfTwo) and operandNonNegative(irOperands[instruction][0]) {
                let exponent = irImmediates[instruction]
                if opcode == irModuloPowerOfTwo {
                    irOpcodes[instruction] = irBitAnd
                    irOperands[instruction] = [irOperands[instruction][0], entryConstant((1 << exponent) - 1)]
                } else {
                    irOpcodes[instruction] = irShiftRight
                    irOperands[instruction] = [irOperands[instruction][0], entryConstant(exponent)]
                }
                irImmediates[instruction] = 0
            }
            kept.push(instruction)
        }
        blockInstructions[block] = kept
    }
}

// is one of these blocks the given block or a dominator of it?
fn checkDominates(checkBlocks: [int], block: int) -> bool {
    var current = block
    var depth = 0
    while depth < 64 {
        for checkBlock in checkBlocks {
            if checkBlock == current { return true }
        }
        if current == 0 { return false }
        current = immediateDominators[current]
        depth += 1
    }
    return false
}

fn boundsCheckProven(block: int, check: int) -> bool {
    let length = resolveValue(irOperands[check][0])
    let index = resolveValue(irOperands[check][1])
    if not operandNonNegative(index) { return false }
    var current = block
    while current != 0 {
        if edgeProvesInBounds(current, index, length) { return true }
        current = immediateDominators[current]
    }
    return false
}

// load64(a + b + c) and store64(...): the add becomes the addressing mode,
// [a + b + c]. A raw load then carries an index operand, a raw store a third one.
fn foldAddressArithmetic() {
    for block in 0..blockInstructions.len() {
        for instruction in blockInstructions[block] {
            let opcode = irOpcodes[instruction]
            var indexPosition = 0 - 1
            if opcode >= irLoadRaw64 and opcode <= irLoadRaw8 and irOperands[instruction].len() == 1 { indexPosition = 1 }
            if opcode >= irStoreRaw64 and opcode <= irStoreRaw8 and irOperands[instruction].len() == 2 { indexPosition = 2 }
            if indexPosition < 0 { continue }
            let address = resolveValue(irOperands[instruction][0])
            if irOpcodes[address] != irAdd or valueDead[address] { continue }
            let first = resolveValue(irOperands[address][0])
            let second = resolveValue(irOperands[address][1])
            if isImmediateConstant(second) or isImmediateConstant(first) {
                var constant = second
                var base = first
                if isImmediateConstant(first) {
                    constant = first
                    base = second
                }
                if isImmediateConstant(base) { continue }
                let displacement = irImmediates[instruction] + irImmediates[constant]
                if displacement < 0 - 1073741824 or displacement > 1073741824 { continue }
                irOperands[instruction][0] = base
                irImmediates[instruction] = displacement
                continue
            }
            if irClasses[first] != classInteger or irClasses[second] != classInteger { continue }
            irOperands[instruction][0] = first
            irOperands[instruction].push(second)
        }
    }
}

fn listContains(values: [int], wanted: int) -> bool {
    for value in values {
        if value == wanted { return true }
    }
    return false
}

// Scalar replacement: a struct of plain fields that never leaves the region
// (only its own fields are read and written, and it is counted and released)
// needs no memory. Its field loads become the values stored at creation, and
// the allocation, the stores and the count traffic go away.
fn replaceScalarAggregates() {
    var users: [[int]] = []
    for value in 0..irOpcodes.len() {
        var noUsers: [int] = []
        users.push(noUsers)
    }
    for block in 0..blockInstructions.len() {
        for instruction in blockInstructions[block] {
            if valueDead[instruction] { continue }
            for operand in irOperands[instruction] { users[operand].push(instruction) }
        }
    }
    var replaced = false
    for block in 0..blockInstructions.len() {
        let instructions = blockInstructions[block]
        for allocationIndex in 0..instructions.len() {
            let allocation = instructions[allocationIndex]
            if valueDead[allocation] or not irScalarCandidates[allocation] { continue }
            // the allocation and its retained aliases, and everything that reads them
            var aliases: [int] = [allocation]
            var fieldOffsets: [int] = []
            var fieldValues: [int] = []
            var loads: [int] = []
            var countCalls: [int] = []
            var assignments: [int] = []               // runtimeAssignReference(address, the struct): rebuilt there
            var escapes = false
            var aliasIndex = 0
            while aliasIndex < aliases.len() and not escapes {
                let alias = aliases[aliasIndex]
                aliasIndex += 1
                for user in users[alias] {
                    let opcode = irOpcodes[user]
                    let operands = irOperands[user]
                    if (opcode == irStore or opcode == irFloatStore) and operands[0] == alias and operands[1] != alias and listContains(instructions, user) {
                        for offset in fieldOffsets {
                            if offset == irImmediates[user] { escapes = true }         // written twice
                        }
                        fieldOffsets.push(irImmediates[user])
                        fieldValues.push(operands[1])
                        countCalls.push(user)
                    } else if (opcode == irLoad or opcode == irFloatLoad) and operands[0] == alias {
                        loads.push(user)
                    } else if isRuntimeCallTo(user, "runtimeReleaseReference") and operands.len() == 1 {
                        countCalls.push(user)
                    } else if isRuntimeCallTo(user, "runtimeRetainReference") and operands.len() == 1 {
                        countCalls.push(user)
                        aliases.push(user)
                    } else if isRuntimeCallTo(user, "runtimeAssignReference") and operands[1] == alias and operands[0] != alias {
                        assignments.push(user)
                    } else {
                        escapes = true
                    }
                }
            }
            if escapes { continue }
            // every load reads a stored field, of its class, after the stores
            var lastStorePosition = 0 - 1
            for position in allocationIndex..instructions.len() {
                for stored in countCalls {
                    if instructions[position] == stored and (irOpcodes[stored] == irStore or irOpcodes[stored] == irFloatStore) { lastStorePosition = position }
                }
            }
            var forwardedValues: [int] = []
            for load in loads {
                var found = 0 - 1
                for i in 0..fieldOffsets.len() {
                    if fieldOffsets[i] == irImmediates[load] and irClasses[fieldValues[i]] == irClasses[load] { found = fieldValues[i] }
                }
                if found < 0 { escapes = true }
                for position in 0..(lastStorePosition + 1) {
                    if instructions[position] == load { escapes = true }
                }
                forwardedValues.push(found)
            }
            // rebuilt at most once, with every field known. The count ops go with the rest:
            // a correct program ends each path with the struct held by the slot (count 1)
            // or by nothing, which the rebuilt allocation reproduces
            if assignments.len() > 1 or (assignments.len() == 1 and fieldOffsets.len() * 8 != irImmediates[irOperands[allocation][0]]) { escapes = true }
            if escapes { continue }
            for i in 0..loads.len() { valueForward[loads[i]] = forwardedValues[i] }
            for assignment in assignments { materializeBefore(assignment, allocation, fieldOffsets, fieldValues) }
            for dead in countCalls { valueDead[dead] = true }
            for alias in aliases { valueDead[alias] = true }
            replaced = true
        }
    }
    if replaced { rewriteOperands() }
}

// rebuild a dissolved struct where it escapes: a fresh allocation and its
// field stores right before `user`, which then takes it instead
fn materializeBefore(user: int, allocation: int, fieldOffsets: [int], fieldValues: [int]) {
    var block = 0 - 1
    for candidate in 0..blockInstructions.len() {
        if block < 0 and listContains(blockInstructions[candidate], user) { block = candidate }
    }
    let noDescriptor = entryConstant(0)
    let object = addLateInstruction(block, irCall, classInteger, [irOperands[allocation][0], noDescriptor], irImmediates[allocation])
    irReferenceArguments[object] = 0
    var inserted: [int] = [object]
    for i in 0..fieldOffsets.len() {
        var opcode = irStore
        if irClasses[fieldValues[i]] == classFloat { opcode = irFloatStore }
        inserted.push(addLateInstruction(block, opcode, irClasses[fieldValues[i]], [object, fieldValues[i]], fieldOffsets[i]))
    }
    // addInstruction appended them; move them in front of the user
    var reordered: [int] = []
    for instruction in blockInstructions[block] {
        if listContains(inserted, instruction) { continue }
        if instruction == user {
            for newInstruction in inserted { reordered.push(newInstruction) }
        }
        reordered.push(instruction)
    }
    blockInstructions[block] = reordered
    irOperands[user][1] = object
}

// run every pass after lowering; false (with optimizerBailReason) if any gives up
fn compileRegion(label: str, parameterCount: int, registerCall: bool) -> bool {
    for block in 0..blockInstructions.len() {
        if not blockSealed[block] { optimizerBail("internal: unsealed block") }
    }
    if irOpcodes.len() > regionValueLimit { optimizerBail("region too large ({irOpcodes.len()} values)") }
    if optimizerBailed { return false }
    resetForwarding()
    removeUnreachableBlocks()
    removeTrivialPhis()
    foldIrConstants()
    var threadingRounds = 0
    mergeStraightBlocks()
    while threadingRounds < 4 and threadBranches() {
        removeUnreachableBlocks()
        removeTrivialPhis()
        foldIrConstants()
        mergeStraightBlocks()
        threadingRounds += 1
    }
    eliminateDeadCode()
    cancelCountPairs()
    replaceScalarAggregates()
    optimizeLoops()
    foldAddressArithmetic()
    eliminateDeadCode()
    checkBorrows()
    if optimizerBailed { return false }
    splitCriticalEdges()
    resetForwarding()
    computeBlockOrder()
    computeLiveness()
    buildLiveRanges()
    allocateRegisters()
    promoteSpilledLoopValues()
    if optimizerBailed { return false }
    emitRegionCode(label, parameterCount, registerCall)
    return not optimizerBailed
}

// ================= driving the tier from the baseline generator =================
var optimizedRegionCount = 0

fn optimizerNote(text: str) {
    if optimizerReport { print("opt: " + text) }
}

// whole function: replaces generateFunctionBody when every statement lowers
fn tryOptimizeFunction(functionIndex: int) -> bool {
    let functionDefinition = functionDefinitions[functionIndex]
    if functionDefinition.name == "runtimeCollectGarbage" { return false }
    if containsBaselineVectorCandidate(functionDefinition.body) {
        optimizerNote("function {functionDefinition.name}: baseline (holds an AVX2 kernel loop)")
        return false
    }
    let label = functionCodeLabel(functionDefinition.label)
    inliningEnabled = true
    let hasPreInlineBody = functionIndex < preInlineBodies.len() and preInlineBodies[functionIndex].nodeKind != nodeNone
    var compiled = false
    if hasPreInlineBody {                  // the optimizer's own inliner first: it budgets what it expands
        lowerPreInlineBody = true
        compiled = lowerFunctionRegion(functionIndex) and compileRegion(label, functionDefinition.parameterNames.len(), functionIsRegisterCall(functionIndex))
        lowerPreInlineBody = false
    }
    if not compiled { compiled = lowerFunctionRegion(functionIndex) and compileRegion(label, functionDefinition.parameterNames.len(), functionIsRegisterCall(functionIndex)) }
    if not compiled and inlinedCallCount > 0 {
        optimizerNote("function {functionDefinition.name}: retry without inlining ({optimizerBailReason})")
        inliningEnabled = false
        compiled = lowerFunctionRegion(functionIndex) and compileRegion(label, functionDefinition.parameterNames.len(), functionIsRegisterCall(functionIndex))
        inliningEnabled = true
    }
    // too big once the front end inlined into it: its body from before that,
    // left to the optimizer's own budgeted inliner
    if not compiled and textStartsWith(optimizerBailReason, "region too large") and functionIndex < preInlineBodies.len() and preInlineBodies[functionIndex].nodeKind != nodeNone {
        optimizerNote("function {functionDefinition.name}: retry on the body before inlining ({optimizerBailReason})")
        lowerPreInlineBody = true
        compiled = lowerFunctionRegion(functionIndex) and compileRegion(label, functionDefinition.parameterNames.len(), functionIsRegisterCall(functionIndex))
        if not compiled and inlinedCallCount > 0 {
            inliningEnabled = false
            compiled = lowerFunctionRegion(functionIndex) and compileRegion(label, functionDefinition.parameterNames.len(), functionIsRegisterCall(functionIndex))
            inliningEnabled = true
        }
        lowerPreInlineBody = false
    }
    if not compiled {
        optimizerNote("function {functionDefinition.name}: baseline ({optimizerBailReason})")
        return false
    }
    optimizerNote("function {functionDefinition.name}: optimized, {spillSlotCount} spills, {irOpcodes.len()} values")
    for line in optimizerLines { assemblyLines.push(line) }
    return true
}

fn isLoopStatement(statement: Node) -> bool {
    return statement.nodeKind == nodeWhile or statement.nodeKind == nodeRangeLoop or statement.nodeKind == nodeIterableLoop
}

// A range loop the baseline may turn into an AVX2 kernel (tryFill, tryReduce,
// tryScaledVectorAddition all want a one-assignment body): leave it to them.
// The same shape checks tryReduce and tryScaledVectorAddition make before
// they commit to emitting their kernel.
fn baselineVectorCandidate(statement: Node) -> bool {
    if statement.nodeKind != nodeRangeLoop { return false }
    let body = statement.children[2]
    if body.children.len() != 1 or body.children[0].nodeKind != nodeAssign { return false }
    let loopSlot = statement.slot
    let assignment = body.children[0]
    let target = assignment.children[0]
    let value = assignment.children[1]
    // fill (L[i] = leaf) lowers here as a plain store loop: not worth a baseline function
    if value.nodeKind != nodeBinary or value.operator != tokenPlus or not expressionEquals(value.children[0], target) { return false }
    let product = value.children[1]
    if product.nodeKind != nodeBinary or product.operator != tokenStar { return false }
    // reduction: acc = acc + L[i] * i (either order)
    if target.nodeKind == nodeIdentifier and typeKinds[target.typeIndex] == kindInteger {
        var element = product.children[0]
        var factor = product.children[1]
        if product.children[1].nodeKind == nodeIndex {
            element = product.children[1]
            factor = product.children[0]
        }
        if element.nodeKind != nodeIndex or factor.nodeKind != nodeIdentifier { return false }
        if factor.auxiliary != identifierKindLocal or factor.slot != loopSlot { return false }
        if element.children[0].nodeKind != nodeIdentifier or typeKinds[element.typeIndex] != kindInteger { return false }
        let elementIndex = element.children[1]
        return elementIndex.nodeKind == nodeIdentifier and elementIndex.auxiliary == identifierKindLocal and elementIndex.slot == loopSlot
    }
    // AXPY: C[a + j] += S * B[b + j] over two distinct int lists
    if target.nodeKind != nodeIndex or target.children[0].nodeKind != nodeIdentifier or typeKinds[target.typeIndex] != kindInteger { return false }
    if scaledVectorInvariantIndex(target.children[1], loopSlot) < 0 { return false }
    var scalarFactor = product.children[0]
    var sourceElement = product.children[1]
    if product.children[0].nodeKind == nodeIndex and product.children[1].nodeKind != nodeIndex {
        scalarFactor = product.children[1]
        sourceElement = product.children[0]
    }
    if sourceElement.nodeKind != nodeIndex or sourceElement.children[0].nodeKind != nodeIdentifier or typeKinds[sourceElement.typeIndex] != kindInteger { return false }
    if scaledVectorInvariantIndex(sourceElement.children[1], loopSlot) < 0 or usesLocal(scalarFactor, loopSlot) { return false }
    let targetList = target.children[0]
    let sourceList = sourceElement.children[0]
    return not (targetList.auxiliary == sourceList.auxiliary and targetList.slot == sourceList.slot)
}

fn containsBaselineVectorCandidate(node: Node) -> bool {
    if baselineVectorCandidate(node) { return true }
    for child in node.children {
        if containsBaselineVectorCandidate(child) { return true }
    }
    return false
}

fn excludeSlots(node: Node) {
    let kind = node.nodeKind
    if kind == nodeIdentifier {
        if node.auxiliary == identifierKindLocal and node.slot < excludedLocalSlots.len() { excludedLocalSlots[node.slot] = true }
        if node.auxiliary == identifierKindParameter and node.slot < excludedParameterSlots.len() { excludedParameterSlots[node.slot] = true }
    }
    if kind == nodeDeclaration and node.auxiliary == identifierKindLocal and node.slot < excludedLocalSlots.len() { excludedLocalSlots[node.slot] = true }
    if kind == nodeRangeLoop or kind == nodeIterableLoop or kind == nodeInline {
        if node.slot < excludedLocalSlots.len() { excludedLocalSlots[node.slot] = true }
    }
    for child in node.children { excludeSlots(child) }
}

// outline the outermost loops that lower; descend into the ones that do not
fn outlineLoops(statements: [Node], slotCount: int, parameterCount: int, registerCall: bool, functionName: str) {
    for statement in statements {
        if isLoopStatement(statement) and not containsBaselineVectorCandidate(statement) {
            let regionLabel = "zopt_region{optimizedRegionCount}"
            inliningEnabled = true
            var compiled = lowerLoopRegion(statement, slotCount, parameterCount, registerCall) and compileRegion(regionLabel, 0, false)
            if not compiled and inlinedCallCount > 0 {
                inliningEnabled = false
                compiled = lowerLoopRegion(statement, slotCount, parameterCount, registerCall) and compileRegion(regionLabel, 0, false)
                inliningEnabled = true
            }
            if compiled {
                optimizerNote("loop at {functionName}:{statement.line}: optimized, {spillSlotCount} spills, {irOpcodes.len()} values")
                for line in optimizerLines { pendingRegionLines.push(line) }
                var original = makeNode(statement.nodeKind, statement.line)
                original.operator = statement.operator
                original.name = statement.name
                original.integerValue = statement.integerValue
                original.floatValue = statement.floatValue
                original.children = statement.children
                original.typeIndex = statement.typeIndex
                original.slot = statement.slot
                original.auxiliary = statement.auxiliary
                original.referenceIndex = statement.referenceIndex
                original.isMutable = statement.isMutable
                original.file = statement.file
                statement.nodeKind = nodeOutlinedLoop
                statement.children = [original]
                statement.integerValue = optimizedRegionCount
                optimizedRegionCount += 1
                excludeSlots(original)
                continue
            }
            optimizerNote("loop at {functionName}:{statement.line}: baseline ({optimizerBailReason})")
        }
        if statement.nodeKind == nodeIf {
            outlineLoops(statement.children[1].children, slotCount, parameterCount, registerCall, functionName)
            if statement.children[2].nodeKind != nodeNone { outlineLoops(statement.children[2].children, slotCount, parameterCount, registerCall, functionName) }
        } else if statement.nodeKind == nodeWhile {
            outlineLoops(statement.children[1].children, slotCount, parameterCount, registerCall, functionName)
        } else if statement.nodeKind == nodeRangeLoop {
            outlineLoops(statement.children[2].children, slotCount, parameterCount, registerCall, functionName)
        } else if statement.nodeKind == nodeIterableLoop {
            outlineLoops(statement.children[1].children, slotCount, parameterCount, registerCall, functionName)
        } else if statement.nodeKind == nodeInline {
            outlineLoops(statement.children, slotCount, parameterCount, registerCall, functionName)
        }
    }
}

// called at the top of generateFunctionBody
fn prepareOptimizedLoops(label: str, statements: [Node], slotCount: int, parameterCount: int, registerCall: bool) {
    clearBooleans(excludedLocalSlots)
    clearBooleans(excludedParameterSlots)
    if not optimizerEnabled or debugEnabled { return }
    for i in 0..slotCount { excludedLocalSlots.push(false) }
    for i in 0..parameterCount { excludedParameterSlots.push(false) }
    outlineLoops(statements, slotCount, parameterCount, registerCall, label)
}
